{
  "schema_version": "1.0",
  "encounter_id": "02238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.84,
      "duration_seconds": 3.32,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.4,
      "end_seconds": 9.18,
      "duration_seconds": 4.78,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.97,
      "end_seconds": 27.85,
      "duration_seconds": 16.88,
      "text": "So, I've been getting puffed climbing stairs, doctor. I just want to get back to normal, really. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.93,
      "end_seconds": 32.18,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.36,
      "end_seconds": 41.52,
      "duration_seconds": 2.16,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.96,
      "end_seconds": 78.35,
      "duration_seconds": 17.39,
      "text": "Okay: blood pressure 110 over 79, saturation 99 percent, heart rate 75, height 181 centimetres, BMI works out to 26.6, respiratory rate 18, temperature 36.9, weight 87 kilos. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.1,
      "end_seconds": 90.0,
      "duration_seconds": 9.9,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.51,
      "end_seconds": 96.56,
      "duration_seconds": 5.05,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.8,
      "end_seconds": 118.11,
      "duration_seconds": 20.31,
      "text": "Hmm, a eight out of ten, I suppose. Honestly, once or twice a day. I'd rather know what's going on than keep guessing. I've been putting this off for weeks. I've, I've also been feeling unfit, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.94,
      "end_seconds": 125.75,
      "duration_seconds": 5.81,
      "text": "Have you been getting puffed climbing stairs at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.59,
      "end_seconds": 136.48,
      "duration_seconds": 9.89,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.29,
      "end_seconds": 139.86,
      "duration_seconds": 2.57,
      "text": "Alright, any fainting, wheeze or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.52,
      "end_seconds": 144.84,
      "duration_seconds": 4.32,
      "text": "I mean, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.46,
      "end_seconds": 147.79,
      "duration_seconds": 2.33,
      "text": "Any sign of chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.11,
      "end_seconds": 151.64,
      "duration_seconds": 2.53,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 157.11,
      "duration_seconds": 3.52,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.54,
      "end_seconds": 160.88,
      "duration_seconds": 2.34,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.3,
      "end_seconds": 164.29,
      "duration_seconds": 1.99,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 171.86,
      "duration_seconds": 5.48,
      "text": "Uh, you know, no, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.03,
      "end_seconds": 191.49,
      "duration_seconds": 2.46,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.55,
      "end_seconds": 200.93,
      "duration_seconds": 7.38,
      "text": "Well, just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.87,
      "end_seconds": 212.64,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 216.27,
      "duration_seconds": 1.79,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.11,
      "end_seconds": 219.1,
      "duration_seconds": 1.99,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.87,
      "end_seconds": 227.42,
      "duration_seconds": 6.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.66,
      "end_seconds": 230.71,
      "duration_seconds": 2.05,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.35,
      "end_seconds": 235.5,
      "duration_seconds": 4.15,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.5,
      "end_seconds": 239.93,
      "duration_seconds": 2.43,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.89,
      "end_seconds": 249.29,
      "duration_seconds": 5.4,
      "text": "Valsartan. I take it once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.83,
      "end_seconds": 252.86,
      "duration_seconds": 2.03,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.1,
      "end_seconds": 255.88,
      "duration_seconds": 1.78,
      "text": "It's 80 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.11,
      "end_seconds": 259.14,
      "duration_seconds": 2.03,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.39,
      "end_seconds": 262.71,
      "duration_seconds": 2.32,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.38,
      "end_seconds": 268.1,
      "duration_seconds": 4.72,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.9,
      "end_seconds": 271.23,
      "duration_seconds": 2.33,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.06,
      "end_seconds": 274.88,
      "duration_seconds": 1.82,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.27,
      "end_seconds": 280.06,
      "duration_seconds": 2.79,
      "text": "Alright, may I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.75,
      "end_seconds": 281.94,
      "duration_seconds": 1.19,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.94,
      "end_seconds": 286.08,
      "duration_seconds": 2.14,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.36,
      "end_seconds": 304.63,
      "duration_seconds": 6.27,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.09,
      "end_seconds": 314.56,
      "duration_seconds": 7.47,
      "text": "All finished, thank you. Right, here's what I'm thinking. My working impression is breathlessness from low fitness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.46,
      "end_seconds": 321.24,
      "duration_seconds": 4.78,
      "text": "I mean, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.69,
      "end_seconds": 330.92,
      "duration_seconds": 8.23,
      "text": "Nothing I've seen today points to an emergency. It looks like breathlessness from low fitness, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.1,
      "end_seconds": 353.81,
      "duration_seconds": 15.71,
      "text": "We should do a peak flow for exertional cough. Build up to thirty minutes of brisk walking five days a week. We'll catch up in eight weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.13,
      "end_seconds": 358.78,
      "duration_seconds": 3.65,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.33,
      "end_seconds": 361.51,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}