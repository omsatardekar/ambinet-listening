{
  "schema_version": "1.0",
  "encounter_id": "02245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.93,
      "duration_seconds": 3.31,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.85,
      "end_seconds": 8.82,
      "duration_seconds": 3.97,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.9,
      "end_seconds": 21.41,
      "duration_seconds": 6.51,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.73,
      "end_seconds": 28.56,
      "duration_seconds": 5.83,
      "text": "Um, so... pain that comes in waves. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.68,
      "end_seconds": 30.87,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.1,
      "end_seconds": 35.19,
      "duration_seconds": 3.09,
      "text": "about three days, give or take"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.69,
      "end_seconds": 43.01,
      "duration_seconds": 3.32,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.06,
      "end_seconds": 51.35,
      "duration_seconds": 4.29,
      "text": "okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.76,
      "end_seconds": 54.81,
      "duration_seconds": 2.05,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.06,
      "end_seconds": 59.42,
      "duration_seconds": 4.36,
      "text": "Hm, okay. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.98,
      "end_seconds": 62.87,
      "duration_seconds": 1.89,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 66.75,
      "duration_seconds": 2.6,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.39,
      "end_seconds": 75.42,
      "duration_seconds": 7.03,
      "text": "it usually comes with sudden severe pain on the right side of my pelvis"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.47,
      "end_seconds": 83.12,
      "duration_seconds": 2.65,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.08,
      "end_seconds": 87.21,
      "duration_seconds": 2.13,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.21,
      "end_seconds": 103.99,
      "duration_seconds": 4.78,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.78,
      "end_seconds": 116.43,
      "duration_seconds": 11.65,
      "text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.25,
      "end_seconds": 122.46,
      "duration_seconds": 4.21,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 124.45,
      "end_seconds": 128.23,
      "duration_seconds": 3.78,
      "text": "It's Seretide inhaler, twice a day, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.7,
      "end_seconds": 132.71,
      "duration_seconds": 3.01,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.41,
      "end_seconds": 136.64,
      "duration_seconds": 2.23,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 152.86,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.04,
      "end_seconds": 156.61,
      "duration_seconds": 2.57,
      "text": "Asthma, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.18,
      "end_seconds": 163.05,
      "duration_seconds": 4.87,
      "text": "alright, asthma, that matches what I have here nothing like fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.09,
      "end_seconds": 166.5,
      "duration_seconds": 1.41,
      "text": "no. No fever"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.0,
      "end_seconds": 173.15,
      "duration_seconds": 6.15,
      "text": "right, right let me check a few things any discharge, missed period or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.16,
      "end_seconds": 176.19,
      "duration_seconds": 2.03,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.72,
      "end_seconds": 180.7,
      "duration_seconds": 3.98,
      "text": "Okay, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.18,
      "end_seconds": 183.55,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 190.77,
      "duration_seconds": 2.47,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.05,
      "end_seconds": 195.39,
      "duration_seconds": 3.34,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.22,
      "end_seconds": 202.18,
      "duration_seconds": 3.96,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.99,
      "end_seconds": 205.06,
      "duration_seconds": 1.07,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.92,
      "end_seconds": 208.0,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.57,
      "end_seconds": 222.43,
      "duration_seconds": 5.86,
      "text": "You are in severe pain with a a tender mass low on the right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.72,
      "end_seconds": 224.42,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 236.05,
      "duration_seconds": 8.52,
      "text": "That's the examination finished. Right, here's what I'm thinking. I think we're dealing with possible ovarian torsion at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.45,
      "end_seconds": 277.08,
      "duration_seconds": 28.63,
      "text": "An urgent pelvic ultrasound is what I'd like next, for possible torsion i'll request a pregnancy test, it'll help with pelvic pain you need an emergency scan and probably surgery today make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest if the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.06,
      "end_seconds": 280.52,
      "duration_seconds": 1.46,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.53,
      "end_seconds": 288.98,
      "duration_seconds": 7.45,
      "text": "I'll want another look straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.77,
      "end_seconds": 294.96,
      "duration_seconds": 5.19,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.06,
      "end_seconds": 303.19,
      "duration_seconds": 6.13,
      "text": "yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.16,
      "end_seconds": 306.15,
      "duration_seconds": 1.99,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.24,
      "end_seconds": 308.57,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
