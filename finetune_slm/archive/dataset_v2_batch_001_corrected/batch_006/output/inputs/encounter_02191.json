{
  "schema_version": "1.0",
  "encounter_id": "02191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 5.69,
      "duration_seconds": 4.57,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 12.65,
      "duration_seconds": 3.13,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.84,
      "end_seconds": 19.24,
      "duration_seconds": 3.4,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.1,
      "end_seconds": 23.51,
      "duration_seconds": 3.41,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.02,
      "end_seconds": 31.3,
      "duration_seconds": 7.28,
      "text": "I've been dealing with severe pain. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.9,
      "end_seconds": 36.08,
      "duration_seconds": 3.18,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.8,
      "end_seconds": 40.0,
      "duration_seconds": 3.2,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.75,
      "end_seconds": 49.83,
      "duration_seconds": 8.08,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.79,
      "end_seconds": 55.01,
      "duration_seconds": 4.22,
      "text": "It's moderate, honestly. I'd say every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.57,
      "end_seconds": 62.77,
      "duration_seconds": 7.2,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 62.87,
      "end_seconds": 68.8,
      "duration_seconds": 5.93,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.59,
      "end_seconds": 77.44,
      "duration_seconds": 6.85,
      "text": "I was getting to that! I've also had a high fever and shivers, since yesterday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.07,
      "end_seconds": 83.15,
      "duration_seconds": 5.08,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.84,
      "end_seconds": 92.8,
      "duration_seconds": 8.96,
      "text": "I'd say a few times a day. And I've been feeling very unwell as well, for five days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 99.37,
      "duration_seconds": 4.54,
      "text": "Has there been rapidly spreading redness on the thigh too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 102.04,
      "duration_seconds": 1.03,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.78,
      "end_seconds": 108.12,
      "duration_seconds": 4.34,
      "text": "Have you had any diarrhoea, recent cut or cough?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.17,
      "end_seconds": 115.03,
      "duration_seconds": 4.86,
      "text": "No diarrhoea, recent cut or cough, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.3,
      "end_seconds": 120.16,
      "duration_seconds": 3.86,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.05,
      "end_seconds": 123.58,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.69,
      "end_seconds": 127.34,
      "duration_seconds": 2.65,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.56,
      "end_seconds": 131.04,
      "duration_seconds": 2.48,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.97,
      "end_seconds": 135.98,
      "duration_seconds": 4.01,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.63,
      "end_seconds": 139.39,
      "duration_seconds": 2.76,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.93,
      "end_seconds": 144.07,
      "duration_seconds": 4.14,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.72,
      "end_seconds": 150.18,
      "duration_seconds": 4.46,
      "text": "Yes, diabetes. I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.02,
      "end_seconds": 152.38,
      "duration_seconds": 1.36,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.33,
      "end_seconds": 160.44,
      "duration_seconds": 6.11,
      "text": "Okay, I can see diabetes and arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.91,
      "end_seconds": 172.04,
      "duration_seconds": 3.13,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.86,
      "end_seconds": 182.67,
      "duration_seconds": 8.81,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.21,
      "end_seconds": 185.97,
      "duration_seconds": 2.76,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.02,
      "end_seconds": 199.71,
      "duration_seconds": 12.69,
      "text": "For my sugar, I believe. My husband sets them out for me, I just take what I'm given. Naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.71,
      "end_seconds": 206.06,
      "duration_seconds": 5.35,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.1,
      "end_seconds": 213.06,
      "duration_seconds": 5.96,
      "text": "I had Glycomet at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.6,
      "end_seconds": 219.2,
      "duration_seconds": 4.6,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.0,
      "end_seconds": 229.01,
      "duration_seconds": 9.01,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.96,
      "end_seconds": 232.29,
      "duration_seconds": 1.33,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.66,
      "end_seconds": 237.45,
      "duration_seconds": 3.79,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 241.66,
      "duration_seconds": 2.28,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.3,
      "end_seconds": 244.64,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.25,
      "end_seconds": 247.49,
      "duration_seconds": 2.24,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.48,
      "end_seconds": 252.62,
      "duration_seconds": 4.14,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 258.1,
      "end_seconds": 265.15,
      "duration_seconds": 7.05,
      "text": "Here are the numbers, doctor. Temp 36.7 degrees, blood pressure 94 over 64, heart rate 98."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.08,
      "end_seconds": 266.78,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.98,
      "end_seconds": 270.73,
      "duration_seconds": 2.75,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 273.57,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.3,
      "end_seconds": 290.18,
      "duration_seconds": 6.88,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.68,
      "end_seconds": 305.62,
      "duration_seconds": 12.94,
      "text": "Okay, that's enough for me. So, based on the history and the examination, the most likely explanation is a possible necrotising soft tissue infection. Another possibility is severe cellulitis."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.58,
      "end_seconds": 309.81,
      "duration_seconds": 3.23,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.55,
      "end_seconds": 332.17,
      "duration_seconds": 21.62,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible necrotising soft tissue infection, but I'd like to confirm. Let me just check I've got this right. You've had severe pain for six months, moderate, and no recent cut or cough."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.0,
      "end_seconds": 334.54,
      "duration_seconds": 1.54,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.89,
      "end_seconds": 360.95,
      "duration_seconds": 9.06,
      "text": "We should do an urgent surgical review for possible necrotising infection. I'd like to arrange urgent blood tests for possible necrotising infection."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.98,
      "end_seconds": 365.58,
      "duration_seconds": 2.6,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.55,
      "end_seconds": 371.4,
      "duration_seconds": 4.85,
      "text": "You need emergency surgery and intravenous antibiotics, we are going now."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.88,
      "end_seconds": 387.83,
      "duration_seconds": 15.95,
      "text": "Sure. I'd like you to see the surgical team as well, and I'll write the referral. Do get help quickly if the symptoms get worse. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.26,
      "end_seconds": 392.26,
      "duration_seconds": 3.0,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.42,
      "end_seconds": 394.59,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}