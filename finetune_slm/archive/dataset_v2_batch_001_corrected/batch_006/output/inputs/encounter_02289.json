{
  "schema_version": "1.0",
  "encounter_id": "02289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 2.93,
      "duration_seconds": 2.28,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.99,
      "end_seconds": 8.83,
      "duration_seconds": 4.84,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.29,
      "end_seconds": 14.15,
      "duration_seconds": 3.86,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.13,
      "end_seconds": 21.33,
      "duration_seconds": 6.2,
      "text": "Well, I've been having severe pain in the lower leg after a fracture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.15,
      "end_seconds": 25.12,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.05,
      "end_seconds": 36.25,
      "duration_seconds": 10.2,
      "text": "Ten days, I think... sorry, three days, I got that wrong i didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 40.23,
      "duration_seconds": 2.33,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.01,
      "end_seconds": 48.57,
      "duration_seconds": 2.56,
      "text": "it happens all the time"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.47,
      "end_seconds": 53.49,
      "duration_seconds": 4.02,
      "text": "What about tingling in the foot, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.41,
      "end_seconds": 57.3,
      "duration_seconds": 2.89,
      "text": "Hmm, yes, that started yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.07,
      "end_seconds": 63.16,
      "duration_seconds": 3.09,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.01,
      "end_seconds": 66.35,
      "duration_seconds": 2.34,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.62,
      "end_seconds": 67.56,
      "duration_seconds": 0.94,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 71.99,
      "duration_seconds": 4.05,
      "text": "hm, okay. Has there been a tight swollen leg too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.92,
      "end_seconds": 75.6,
      "duration_seconds": 1.68,
      "text": "yeah, that too"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.4,
      "end_seconds": 95.06,
      "duration_seconds": 3.66,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.19,
      "end_seconds": 110.16,
      "duration_seconds": 2.97,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.43,
      "end_seconds": 136.04,
      "duration_seconds": 8.61,
      "text": "Okay: BP is 119 over 72, pulse 68, temperature 36.5. And respiratory rate 17, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.99,
      "end_seconds": 141.7,
      "duration_seconds": 2.71,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.7,
      "end_seconds": 145.41,
      "duration_seconds": 1.71,
      "text": "so, breathe out slowly"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.12,
      "end_seconds": 168.29,
      "duration_seconds": 6.17,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.54,
      "end_seconds": 174.52,
      "duration_seconds": 2.98,
      "text": "All finished, thank you. Any chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 178.72,
      "duration_seconds": 3.03,
      "text": "I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 183.67,
      "duration_seconds": 2.44,
      "text": "any wound infection or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.58,
      "end_seconds": 189.51,
      "duration_seconds": 3.93,
      "text": "No wound infection or fever, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.48,
      "end_seconds": 194.12,
      "duration_seconds": 2.64,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 199.04,
      "duration_seconds": 3.77,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.72,
      "end_seconds": 202.13,
      "duration_seconds": 2.41,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.12,
      "end_seconds": 205.7,
      "duration_seconds": 1.58,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.64,
      "end_seconds": 209.23,
      "duration_seconds": 2.59,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.08,
      "end_seconds": 225.58,
      "duration_seconds": 14.5,
      "text": "Iron tablets, once a day for my blood count sorry, what was I saying, I take sertraline, 50 milligrams, once a day i take strong painkillers, not working"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 229.9,
      "duration_seconds": 2.82,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.46,
      "end_seconds": 233.25,
      "duration_seconds": 1.79,
      "text": "for about a year"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 238.31,
      "duration_seconds": 4.06,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.14,
      "end_seconds": 242.24,
      "duration_seconds": 3.1,
      "text": "I mean, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.22,
      "end_seconds": 248.48,
      "duration_seconds": 4.26,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.44,
      "end_seconds": 254.66,
      "duration_seconds": 4.22,
      "text": "I have low haemoglobin, for nearly five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.35,
      "end_seconds": 257.79,
      "duration_seconds": 1.44,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.25,
      "end_seconds": 263.49,
      "duration_seconds": 4.24,
      "text": "ah, I've had depression for about a year now"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.63,
      "end_seconds": 269.91,
      "duration_seconds": 5.28,
      "text": "right, right. Okay, I can see depression in your file as well"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.61,
      "end_seconds": 291.72,
      "duration_seconds": 3.11,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.37,
      "end_seconds": 299.9,
      "duration_seconds": 6.53,
      "text": "Mm, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.94,
      "end_seconds": 307.3,
      "duration_seconds": 5.36,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.94,
      "end_seconds": 312.37,
      "duration_seconds": 3.43,
      "text": "Yes, wheat. I get itchy skin."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.89,
      "end_seconds": 313.78,
      "duration_seconds": 0.89,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.68,
      "end_seconds": 322.72,
      "duration_seconds": 4.04,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.44,
      "end_seconds": 325.15,
      "duration_seconds": 1.71,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.04,
      "end_seconds": 328.33,
      "duration_seconds": 2.29,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.6,
      "end_seconds": 332.89,
      "duration_seconds": 3.29,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.54,
      "end_seconds": 338.15,
      "duration_seconds": 3.61,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.72,
      "end_seconds": 344.95,
      "duration_seconds": 6.23,
      "text": "Having listened and examined, my working impression is possible compartment syndrome needing urgent surgery."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.87,
      "end_seconds": 350.38,
      "duration_seconds": 4.51,
      "text": "Uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.17,
      "end_seconds": 374.27,
      "duration_seconds": 23.1,
      "text": "It's reasonable to be concerned, but right now possible compartment syndrome needing urgent surgery is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had severe pain in the lower leg after a fracture for three days, and no chest pain or wound infection."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.88,
      "end_seconds": 375.58,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.59,
      "end_seconds": 399.77,
      "duration_seconds": 6.18,
      "text": "I'll request measuring the pressure in the leg, it'll help with possible compartment syndrome"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 401.44,
      "end_seconds": 403.11,
      "duration_seconds": 1.67,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.54,
      "end_seconds": 418.96,
      "duration_seconds": 14.42,
      "text": "If the symptoms get worse, that's the point to come in urgently. Please come and see me straight away. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.42,
      "end_seconds": 424.63,
      "duration_seconds": 4.21,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.79,
      "end_seconds": 430.13,
      "duration_seconds": 4.34,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.8,
      "end_seconds": 434.88,
      "duration_seconds": 3.08,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.39,
      "end_seconds": 436.58,
      "duration_seconds": 1.19,
      "text": "goodbye for now"
    }
  ]
}