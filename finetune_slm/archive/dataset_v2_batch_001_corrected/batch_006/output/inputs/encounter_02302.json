{
  "schema_version": "1.0",
  "encounter_id": "02302",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.38,
      "end_seconds": 6.16,
      "duration_seconds": 4.78,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.14,
      "end_seconds": 11.88,
      "duration_seconds": 3.74,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.93,
      "end_seconds": 27.35,
      "duration_seconds": 13.42,
      "text": "Hmm, hello, doctor. I'm here with them in case I can help. We came because of vomiting large amounts of fresh blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 29.07,
      "end_seconds": 35.91,
      "duration_seconds": 6.84,
      "text": "Here are the numbers, doctor. Pulse 110, oxygen saturation is 99 percent, blood pressure 97 over 61."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.41,
      "end_seconds": 43.8,
      "duration_seconds": 5.39,
      "text": "Good, thank you. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.39,
      "end_seconds": 50.25,
      "duration_seconds": 5.86,
      "text": "Two months, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.14,
      "end_seconds": 58.9,
      "duration_seconds": 2.76,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.85,
      "end_seconds": 61.4,
      "duration_seconds": 1.55,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.16,
      "end_seconds": 68.48,
      "duration_seconds": 6.32,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 68.58,
      "end_seconds": 74.61,
      "duration_seconds": 6.03,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.31,
      "end_seconds": 79.93,
      "duration_seconds": 4.62,
      "text": "Later, thanks. Please go on. Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.22,
      "end_seconds": 97.82,
      "duration_seconds": 16.6,
      "text": "Um, uh, yeah. About a month, I'd say. With feeling faint, I'd say severe. Honestly, a couple of times a week. Yeah, there's a swollen tummy as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.73,
      "end_seconds": 103.16,
      "duration_seconds": 3.43,
      "text": "So, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.3,
      "end_seconds": 106.12,
      "duration_seconds": 1.82,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 106.71,
      "end_seconds": 108.94,
      "duration_seconds": 2.23,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.89,
      "end_seconds": 123.55,
      "duration_seconds": 3.66,
      "text": "Okay, and what about chest pain or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 128.72,
      "duration_seconds": 4.33,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.82,
      "end_seconds": 132.18,
      "duration_seconds": 2.36,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.48,
      "end_seconds": 138.83,
      "duration_seconds": 2.35,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.48,
      "end_seconds": 143.92,
      "duration_seconds": 3.44,
      "text": "Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.95,
      "end_seconds": 157.22,
      "duration_seconds": 10.27,
      "text": "Erm, um, I have acid reflux, for about ten years. I have gout, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.5,
      "end_seconds": 159.2,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.99,
      "end_seconds": 167.21,
      "duration_seconds": 7.22,
      "text": "Migraines, for about a year. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.27,
      "end_seconds": 176.2,
      "duration_seconds": 7.93,
      "text": "Alright, acid reflux and gout, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.24,
      "end_seconds": 181.24,
      "duration_seconds": 3.0,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 183.08,
      "end_seconds": 190.04,
      "duration_seconds": 6.96,
      "text": "Hold on, doctor, I think she reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.75,
      "end_seconds": 195.68,
      "duration_seconds": 4.93,
      "text": "Actually, you know, really? I don't think so."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.68,
      "end_seconds": 202.5,
      "duration_seconds": 5.82,
      "text": "Okay, I'll note both of those. What do you do during the day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.24,
      "end_seconds": 208.12,
      "duration_seconds": 3.88,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.94,
      "end_seconds": 229.94,
      "duration_seconds": 3.0,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.98,
      "end_seconds": 237.44,
      "duration_seconds": 6.46,
      "text": "Yeah, I'm on lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 238.92,
      "end_seconds": 250.86,
      "duration_seconds": 11.94,
      "text": "I mean, doctor, I think the last prescription for the lansoprazole was 15 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 254.87,
      "duration_seconds": 3.0,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.41,
      "end_seconds": 263.58,
      "duration_seconds": 8.17,
      "text": "So, not with me. I'll bring it next time. I'm on allopurinol, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.02,
      "end_seconds": 267.43,
      "duration_seconds": 2.41,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.34,
      "end_seconds": 274.75,
      "duration_seconds": 5.41,
      "text": "100 milligrams. Propranolol. I take it twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.65,
      "end_seconds": 278.69,
      "duration_seconds": 2.04,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.4,
      "end_seconds": 288.52,
      "duration_seconds": 9.12,
      "text": "40 milligrams, I think that's what's on the box. Alcohol every day. I take it daily."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.96,
      "end_seconds": 295.58,
      "duration_seconds": 3.62,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 296.42,
      "end_seconds": 299.27,
      "duration_seconds": 2.85,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.13,
      "end_seconds": 302.72,
      "duration_seconds": 2.59,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.52,
      "end_seconds": 309.81,
      "duration_seconds": 6.29,
      "text": "Sorry, what was I saying, just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.24,
      "end_seconds": 315.5,
      "duration_seconds": 4.26,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.43,
      "end_seconds": 318.51,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.97,
      "end_seconds": 333.62,
      "duration_seconds": 7.65,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.52,
      "end_seconds": 353.55,
      "duration_seconds": 16.03,
      "text": "So, that's the examination finished. So, based on the history and the examination, I'd lean towards a bleed from enlarged veins in the gullet in liver disease. A bleeding ulcer is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.47,
      "end_seconds": 358.17,
      "duration_seconds": 3.7,
      "text": "Let me think, will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.19,
      "end_seconds": 375.17,
      "duration_seconds": 14.98,
      "text": "I can't promise yet, but most people with a bleed from enlarged veins in the gullet in liver disease do well once it's treated properly. I'll request an urgent endoscopy, it'll help with variceal bleed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 375.69,
      "end_seconds": 378.45,
      "duration_seconds": 2.76,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.48,
      "end_seconds": 381.54,
      "duration_seconds": 1.06,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.97,
      "end_seconds": 389.88,
      "duration_seconds": 4.91,
      "text": "I'll request urgent blood tests, it'll help with major bleed."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 391.48,
      "end_seconds": 394.82,
      "duration_seconds": 3.34,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.74,
      "end_seconds": 428.57,
      "duration_seconds": 31.83,
      "text": "What I'm giving you is terlipressin, 2 milligrams, now, single dose. That's for variceal bleeding. The pharmacy will go through the details again when you pick it up. You are going straight to resus, I am starting two drips. We'll refer you to the emergency team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.51,
      "end_seconds": 435.02,
      "duration_seconds": 5.51,
      "text": "Let's review you straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.22,
      "end_seconds": 440.27,
      "duration_seconds": 4.05,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}