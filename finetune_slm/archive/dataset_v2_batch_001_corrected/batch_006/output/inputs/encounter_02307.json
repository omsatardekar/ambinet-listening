{
  "schema_version": "1.0",
  "encounter_id": "02307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 2.38,
      "duration_seconds": 1.69,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.05,
      "end_seconds": 6.9,
      "duration_seconds": 3.85,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.71,
      "end_seconds": 11.48,
      "duration_seconds": 3.77,
      "text": "well, I've been having a swollen tummy"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.32,
      "end_seconds": 15.06,
      "duration_seconds": 2.74,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.91,
      "end_seconds": 24.56,
      "duration_seconds": 7.65,
      "text": "Um, it's been two weeks now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.93,
      "end_seconds": 29.43,
      "duration_seconds": 4.5,
      "text": "Yes, carry on. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.7,
      "end_seconds": 37.2,
      "duration_seconds": 6.5,
      "text": "A seven out of ten, I suppose. I've been feeling faint too, since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.17,
      "end_seconds": 50.65,
      "duration_seconds": 2.48,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.77,
      "end_seconds": 59.79,
      "duration_seconds": 2.02,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.94,
      "end_seconds": 86.26,
      "duration_seconds": 7.32,
      "text": "Okay: temperature 37.1, saturation 98 percent. And BP is 101 over 59, heart rate 108."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.47,
      "end_seconds": 91.11,
      "duration_seconds": 3.64,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.05,
      "end_seconds": 105.09,
      "duration_seconds": 1.04,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.36,
      "end_seconds": 109.81,
      "duration_seconds": 3.45,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.79,
      "end_seconds": 129.7,
      "duration_seconds": 6.91,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.91,
      "end_seconds": 136.77,
      "duration_seconds": 1.86,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.95,
      "end_seconds": 156.16,
      "duration_seconds": 3.21,
      "text": "Did you get chest pain or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.26,
      "end_seconds": 161.24,
      "duration_seconds": 2.98,
      "text": "No, no chest pain or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.59,
      "end_seconds": 165.09,
      "duration_seconds": 3.5,
      "text": "I follow any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.57,
      "end_seconds": 168.36,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 185.08,
      "duration_seconds": 3.55,
      "text": "right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.36,
      "end_seconds": 189.21,
      "duration_seconds": 2.85,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 195.26,
      "duration_seconds": 4.18,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.92,
      "end_seconds": 204.71,
      "duration_seconds": 7.79,
      "text": "I was told I'm allergic to amoxicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 214.41,
      "duration_seconds": 3.84,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.96,
      "end_seconds": 217.04,
      "duration_seconds": 2.08,
      "text": "Alcohol every day, daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.71,
      "end_seconds": 221.61,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.52,
      "end_seconds": 224.33,
      "duration_seconds": 1.81,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.45,
      "end_seconds": 227.35,
      "duration_seconds": 1.9,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.33,
      "end_seconds": 231.22,
      "duration_seconds": 2.89,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.93,
      "end_seconds": 233.14,
      "duration_seconds": 1.21,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.37,
      "end_seconds": 237.87,
      "duration_seconds": 3.5,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.61,
      "end_seconds": 240.58,
      "duration_seconds": 1.97,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.32,
      "end_seconds": 243.74,
      "duration_seconds": 2.42,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.35,
      "end_seconds": 248.52,
      "duration_seconds": 3.17,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.27,
      "end_seconds": 253.48,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.16,
      "end_seconds": 255.34,
      "duration_seconds": 1.18,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.22,
      "end_seconds": 259.64,
      "duration_seconds": 3.42,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.72,
      "end_seconds": 269.27,
      "duration_seconds": 7.55,
      "text": "Okay, thinking it through, it points towards a bleed from enlarged veins in the gullet in liver disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.96,
      "end_seconds": 274.33,
      "duration_seconds": 3.37,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 300.61,
      "duration_seconds": 25.7,
      "text": "It's reasonable to to be concerned, but right now a bleed from enlarged veins in the gullet in liver disease is my leading thought, not anything worse. We should do urgent blood tests for major bleed. I'd like you to take terlipressin, 2 milligrams, now, single dose. It's for variceal bleeding. You are going straight to resus, I am starting two drips."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.58,
      "end_seconds": 317.71,
      "duration_seconds": 16.13,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look straight away. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.4,
      "end_seconds": 322.68,
      "duration_seconds": 3.28,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}