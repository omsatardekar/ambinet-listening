{
  "schema_version": "1.0",
  "encounter_id": "02255",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 6.05,
      "duration_seconds": 5.47,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.74,
      "end_seconds": 10.84,
      "duration_seconds": 4.1,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.52,
      "end_seconds": 19.12,
      "duration_seconds": 6.6,
      "text": "Okay, so hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 23.2,
      "duration_seconds": 3.32,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.86,
      "end_seconds": 32.58,
      "duration_seconds": 5.72,
      "text": "I, I wanted to get tingling in the foot looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.36,
      "end_seconds": 40.02,
      "duration_seconds": 3.66,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.44,
      "end_seconds": 53.14,
      "duration_seconds": 2.7,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.73,
      "end_seconds": 70.2,
      "duration_seconds": 7.47,
      "text": "Okay: temperature 36.7, pulse is 82 beats a minute, BP is 108 over 73."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.15,
      "end_seconds": 73.67,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.67,
      "end_seconds": 78.79,
      "duration_seconds": 4.12,
      "text": "We'll go over that shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 92.94,
      "duration_seconds": 12.21,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.65,
      "end_seconds": 97.45,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.0,
      "end_seconds": 100.56,
      "duration_seconds": 1.56,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.21,
      "end_seconds": 104.23,
      "duration_seconds": 3.02,
      "text": "Have you had pain out of proportion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.75,
      "end_seconds": 108.85,
      "duration_seconds": 3.1,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.64,
      "end_seconds": 130.72,
      "duration_seconds": 4.08,
      "text": "Have you noticed wound infection, fever or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.96,
      "end_seconds": 139.19,
      "duration_seconds": 7.23,
      "text": "Oh, um, no wound infection, fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.63,
      "end_seconds": 145.78,
      "duration_seconds": 6.15,
      "text": "Right, right. Alright, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.99,
      "end_seconds": 150.33,
      "duration_seconds": 3.34,
      "text": "No, uh, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.5,
      "end_seconds": 158.38,
      "duration_seconds": 2.88,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.82,
      "end_seconds": 174.61,
      "duration_seconds": 14.79,
      "text": "My husband and I live above the shop. I'm a bus driver, so I sit for long hours. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.98,
      "end_seconds": 179.46,
      "duration_seconds": 3.48,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 180.06,
      "end_seconds": 191.53,
      "duration_seconds": 11.47,
      "text": "It's Foracort inhaler, twice a day for my asthma, doctor. Let me think, he takes strong painkillers, not working."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.19,
      "end_seconds": 196.98,
      "duration_seconds": 4.79,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.62,
      "end_seconds": 202.72,
      "duration_seconds": 5.1,
      "text": "Actually, I'm allergic to cat fur, I get sneezing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 206.42,
      "duration_seconds": 2.75,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 213.01,
      "duration_seconds": 4.99,
      "text": "Right, you know, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.38,
      "end_seconds": 231.79,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.32,
      "end_seconds": 234.03,
      "duration_seconds": 1.71,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.09,
      "end_seconds": 242.17,
      "duration_seconds": 7.08,
      "text": "Tell me about any past illnesses or ongoing conditions. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.59,
      "end_seconds": 248.04,
      "duration_seconds": 4.45,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.56,
      "end_seconds": 252.73,
      "duration_seconds": 3.17,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.79,
      "end_seconds": 255.07,
      "duration_seconds": 1.28,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.03,
      "end_seconds": 271.08,
      "duration_seconds": 7.05,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.36,
      "end_seconds": 275.3,
      "duration_seconds": 1.94,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.2,
      "end_seconds": 323.06,
      "duration_seconds": 28.86,
      "text": "I'm going to order measuring the pressure in the leg, for possible compartment syndrome. Remove the cast now, you are going to theatre for a decompression. I'd like you to see the orthopaedic team as well, and I'll write the referral. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.56,
      "end_seconds": 326.18,
      "duration_seconds": 1.62,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.08,
      "end_seconds": 337.46,
      "duration_seconds": 10.38,
      "text": "Book a review straight away. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.49,
      "end_seconds": 344.35,
      "duration_seconds": 4.86,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.4,
      "end_seconds": 351.69,
      "duration_seconds": 5.29,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.74,
      "end_seconds": 358.59,
      "duration_seconds": 4.85,
      "text": "Um, great, thank you for your help."
    }
  ]
}