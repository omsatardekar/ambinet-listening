{
  "schema_version": "1.0",
  "encounter_id": "02372",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.29,
      "duration_seconds": 4.26,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 11.51,
      "duration_seconds": 5.18,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.4,
      "end_seconds": 16.77,
      "duration_seconds": 3.37,
      "text": "I'm here because of being very breathless"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.73,
      "end_seconds": 24.47,
      "duration_seconds": 6.74,
      "text": "how long has this been bothering you? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.75,
      "end_seconds": 30.57,
      "duration_seconds": 4.82,
      "text": "Around two days... no wait, it's more like five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.67,
      "end_seconds": 40.57,
      "duration_seconds": 4.9,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.53,
      "end_seconds": 56.29,
      "duration_seconds": 14.76,
      "text": "I notice it more with lying flat. Mild, really. My sister suggested writing things down, but I forgot. Oh, I've also had a pounding heart, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.06,
      "end_seconds": 61.09,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.97,
      "end_seconds": 66.21,
      "duration_seconds": 3.24,
      "text": "actually, it feels moderate to me"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.93,
      "end_seconds": 68.84,
      "duration_seconds": 0.91,
      "text": "Any wheeze?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.68,
      "end_seconds": 72.87,
      "duration_seconds": 3.19,
      "text": "not that I've noticed no wheeze"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.64,
      "end_seconds": 77.76,
      "duration_seconds": 3.12,
      "text": "And what about calf pain or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.25,
      "end_seconds": 86.13,
      "duration_seconds": 2.88,
      "text": "No, no calf pain or fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.63,
      "end_seconds": 89.61,
      "duration_seconds": 2.98,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.04,
      "end_seconds": 92.97,
      "duration_seconds": 1.93,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.11,
      "end_seconds": 103.75,
      "duration_seconds": 4.64,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.39,
      "end_seconds": 114.57,
      "duration_seconds": 10.18,
      "text": "Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day. My partner and our baby"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.16,
      "end_seconds": 130.01,
      "duration_seconds": 2.85,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.77,
      "end_seconds": 135.19,
      "duration_seconds": 3.42,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.31,
      "end_seconds": 149.7,
      "duration_seconds": 2.39,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.0,
      "end_seconds": 155.41,
      "duration_seconds": 2.41,
      "text": "no I'm not on anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 163.36,
      "duration_seconds": 3.56,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 168.45,
      "duration_seconds": 3.09,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.09,
      "end_seconds": 173.38,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 177.08,
      "duration_seconds": 2.75,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.16,
      "end_seconds": 191.96,
      "duration_seconds": 2.8,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.28,
      "end_seconds": 206.71,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.19,
      "end_seconds": 227.55,
      "duration_seconds": 7.36,
      "text": "okay: temp 36.9 degrees, respiratory rate 22, heart rate 86, BP is 132 over 87."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.38,
      "end_seconds": 232.12,
      "duration_seconds": 2.74,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 236.22,
      "duration_seconds": 2.8,
      "text": "Right tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.84,
      "end_seconds": 254.01,
      "duration_seconds": 7.17,
      "text": "there are crackles all the way up both lungs and you are breathing very fast"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.33,
      "end_seconds": 266.58,
      "duration_seconds": 8.25,
      "text": "Okay that's enough for me. From what you've told me and what I found this looks most like acute pulmonary oedema."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.38,
      "end_seconds": 271.2,
      "duration_seconds": 2.82,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.37,
      "end_seconds": 281.17,
      "duration_seconds": 8.8,
      "text": "Nothing I've seen today points to an emergency. It looks like acute pulmonary oedema but I'd like to confirm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.49,
      "end_seconds": 308.62,
      "duration_seconds": 10.13,
      "text": "I think an ECG makes sense here for pulmonary oedema. You'll be taking furosemide 40 milligrams once now single dose. It's for fluid on the lungs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.25,
      "end_seconds": 311.42,
      "duration_seconds": 1.17,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.93,
      "end_seconds": 324.48,
      "duration_seconds": 12.55,
      "text": "Sit upright, I am giving oxygen and a water tablet injection now. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.67,
      "end_seconds": 327.12,
      "duration_seconds": 1.45,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.73,
      "end_seconds": 335.58,
      "duration_seconds": 6.85,
      "text": "I'll want another look straight away anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.09,
      "end_seconds": 338.23,
      "duration_seconds": 2.14,
      "text": "thank you that's helpful"
    }
  ]
}