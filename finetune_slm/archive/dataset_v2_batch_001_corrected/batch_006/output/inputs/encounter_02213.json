{
  "schema_version": "1.0",
  "encounter_id": "02213",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.92,
      "duration_seconds": 4.21,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 11.1,
      "duration_seconds": 4.29,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.77,
      "end_seconds": 18.51,
      "duration_seconds": 6.74,
      "text": "I've been coughing up pink frothy sputum, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.53,
      "end_seconds": 25.12,
      "duration_seconds": 5.59,
      "text": "since when exactly? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.92,
      "end_seconds": 41.68,
      "duration_seconds": 10.76,
      "text": "I've had it for about a week. I've never really been one for hospitals. My family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.75,
      "end_seconds": 48.06,
      "duration_seconds": 4.31,
      "text": "Right, how much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 51.89,
      "duration_seconds": 2.83,
      "text": "it feels severe to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.76,
      "end_seconds": 56.57,
      "duration_seconds": 2.81,
      "text": "okay, how frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.35,
      "end_seconds": 59.41,
      "duration_seconds": 2.06,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.96,
      "end_seconds": 63.58,
      "duration_seconds": 3.62,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.99,
      "end_seconds": 68.9,
      "duration_seconds": 3.91,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.84,
      "end_seconds": 82.74,
      "duration_seconds": 4.9,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.18,
      "end_seconds": 85.97,
      "duration_seconds": 1.79,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.7,
      "end_seconds": 88.73,
      "duration_seconds": 2.03,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 95.26,
      "duration_seconds": 4.44,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.07,
      "end_seconds": 103.03,
      "duration_seconds": 2.96,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.63,
      "end_seconds": 108.26,
      "duration_seconds": 3.63,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.31,
      "end_seconds": 112.18,
      "duration_seconds": 2.87,
      "text": "alright, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.87,
      "end_seconds": 116.14,
      "duration_seconds": 3.27,
      "text": "Actually no nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.18,
      "end_seconds": 129.69,
      "duration_seconds": 3.51,
      "text": "Have you had any fever or calf pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.0,
      "end_seconds": 135.46,
      "duration_seconds": 2.46,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.31,
      "end_seconds": 138.37,
      "duration_seconds": 2.06,
      "text": "Have you had any wheeze?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.01,
      "end_seconds": 141.35,
      "duration_seconds": 1.34,
      "text": "Definitely no wheeze."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.06,
      "end_seconds": 145.11,
      "duration_seconds": 2.05,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.69,
      "end_seconds": 148.59,
      "duration_seconds": 1.9,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.68,
      "end_seconds": 152.83,
      "duration_seconds": 3.15,
      "text": "okay, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.66,
      "end_seconds": 155.24,
      "duration_seconds": 1.58,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.84,
      "end_seconds": 161.14,
      "duration_seconds": 4.3,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.29,
      "end_seconds": 175.42,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.42,
      "end_seconds": 196.8,
      "duration_seconds": 9.38,
      "text": "okay: blood pressure 126 over 86, temp 37.5 degrees. And SpO2 90 percent on room air, pulse 99."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.52,
      "end_seconds": 200.81,
      "duration_seconds": 2.29,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.29,
      "end_seconds": 212.31,
      "duration_seconds": 1.02,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.31,
      "end_seconds": 215.28,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.53,
      "end_seconds": 228.83,
      "duration_seconds": 6.3,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.42,
      "end_seconds": 238.18,
      "duration_seconds": 6.76,
      "text": "You can sit up now. Putting it all together, this looks most like acute pulmonary oedema."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.21,
      "end_seconds": 276.67,
      "duration_seconds": 28.46,
      "text": "I'd like to arrange an ECG for pulmonary oedema. I'd like to arrange blood tests for pulmonary oedema. Let's use furosemide, 40 milligrams, once now, single dose. It's for fluid on the lungs. Sit upright, I am giving oxygen and a water tablet injection now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.75,
      "end_seconds": 294.59,
      "duration_seconds": 16.84,
      "text": "A chest X-ray is something we might do if this doesn't improve in a month please don't wait if the symptoms get worse that's when to be seen urgently please come and see me straight away"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.57,
      "end_seconds": 300.07,
      "duration_seconds": 3.5,
      "text": "Actually uh okay I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.11,
      "end_seconds": 305.99,
      "duration_seconds": 4.88,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.67,
      "end_seconds": 309.84,
      "duration_seconds": 2.17,
      "text": "alright thanks take care"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.75,
      "end_seconds": 312.95,
      "duration_seconds": 1.2,
      "text": "all the best"
    }
  ]
}