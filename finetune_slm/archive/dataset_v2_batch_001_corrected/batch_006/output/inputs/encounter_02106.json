{
  "schema_version": "1.0",
  "encounter_id": "02106",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.76,
      "duration_seconds": 4.0,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.75,
      "end_seconds": 10.49,
      "duration_seconds": 4.74,
      "text": "Alright, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 16.32,
      "duration_seconds": 4.8,
      "text": "I'm here because of a bump on the head."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.41,
      "end_seconds": 20.1,
      "duration_seconds": 2.69,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.13,
      "end_seconds": 28.51,
      "duration_seconds": 3.38,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.85,
      "end_seconds": 32.79,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.11,
      "end_seconds": 39.57,
      "duration_seconds": 5.46,
      "text": "It's been one week now. I've also had crying straight away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.59,
      "end_seconds": 44.69,
      "duration_seconds": 3.1,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 49.33,
      "duration_seconds": 2.99,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.34,
      "end_seconds": 57.47,
      "duration_seconds": 7.13,
      "text": "Have you had a bump on the head before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.5,
      "end_seconds": 64.19,
      "duration_seconds": 5.69,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.82,
      "end_seconds": 82.66,
      "duration_seconds": 1.84,
      "text": "Any vomiting or fit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.6,
      "end_seconds": 88.58,
      "duration_seconds": 3.98,
      "text": "Mm, no, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.72,
      "end_seconds": 93.6,
      "duration_seconds": 3.88,
      "text": "And what about drowsiness or loss of consciousness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.53,
      "end_seconds": 99.95,
      "duration_seconds": 4.42,
      "text": "No drowsiness or loss of consciousness, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.35,
      "end_seconds": 104.23,
      "duration_seconds": 2.88,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.38,
      "end_seconds": 106.43,
      "duration_seconds": 1.05,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 108.31,
      "duration_seconds": 1.25,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.92,
      "end_seconds": 113.83,
      "duration_seconds": 3.91,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.8,
      "end_seconds": 118.07,
      "duration_seconds": 3.27,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.78,
      "end_seconds": 122.55,
      "duration_seconds": 3.77,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 126.26,
      "duration_seconds": 1.87,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.42,
      "end_seconds": 129.66,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.23,
      "end_seconds": 150.04,
      "duration_seconds": 2.81,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.51,
      "end_seconds": 153.77,
      "duration_seconds": 2.26,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 156.91,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.46,
      "end_seconds": 160.3,
      "duration_seconds": 2.84,
      "text": "Yes, I'm allergic to plasters."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.98,
      "end_seconds": 163.56,
      "duration_seconds": 2.58,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.34,
      "end_seconds": 166.89,
      "duration_seconds": 1.55,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.25,
      "end_seconds": 172.17,
      "duration_seconds": 3.92,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 184.25,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 212.88,
      "duration_seconds": 7.26,
      "text": "Okay: heart rate 85, blood pressure 128 over 70, respiratory rate 16, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.21,
      "end_seconds": 218.81,
      "duration_seconds": 3.6,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.53,
      "end_seconds": 223.64,
      "duration_seconds": 3.11,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 242.84,
      "duration_seconds": 7.84,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.35,
      "end_seconds": 245.05,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 264.74,
      "duration_seconds": 14.34,
      "text": "You can sit up now. Stop me if I've got anything wrong. You've had a bump on the head for one week, and no loss of consciousness or vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.67,
      "end_seconds": 269.37,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.51,
      "end_seconds": 288.06,
      "duration_seconds": 5.55,
      "text": "Watch him for the next twenty-four hours and give paracetamol if he is sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.39,
      "end_seconds": 308.55,
      "duration_seconds": 20.16,
      "text": "Mm-hmm. If he vomits repeatedly, becomes drowsy or has a fit, or you feel really unwell, please come to the emergency department. I'd like to see you again if any vomiting or drowsiness. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.08,
      "end_seconds": 314.24,
      "duration_seconds": 4.16,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}