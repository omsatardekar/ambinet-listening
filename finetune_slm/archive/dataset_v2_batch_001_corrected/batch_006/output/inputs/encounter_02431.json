  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 5.45,
      "duration_seconds": 4.69,
      "text": "good morning, grab a seat. Alright, what's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.45,
      "end_seconds": 12.11,
      "duration_seconds": 5.66,
      "text": "I'm here because of cramping in my calves when I walk."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.2,
      "end_seconds": 16.4,
      "duration_seconds": 3.2,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.35,
      "end_seconds": 21.57,
      "duration_seconds": 3.22,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.91,
      "end_seconds": 26.99,
      "duration_seconds": 5.08,
      "text": "okay, go on rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.05,
      "end_seconds": 39.8,
      "duration_seconds": 10.75,
      "text": "pretty mild, if I'm being honest oh, and a slow-healing toe sore that's been about the same, six months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.82,
      "end_seconds": 44.59,
      "duration_seconds": 2.77,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.41,
      "end_seconds": 56.43,
      "duration_seconds": 2.02,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.26,
      "end_seconds": 79.58,
      "duration_seconds": 5.32,
      "text": "okay: heart rate 67, respiratory rate 18, blood pressure 117 over 78."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.49,
      "end_seconds": 86.11,
      "duration_seconds": 3.62,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.36,
      "end_seconds": 90.19,
      "duration_seconds": 2.83,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.15,
      "end_seconds": 114.86,
      "duration_seconds": 6.71,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.65,
      "end_seconds": 120.64,
      "duration_seconds": 0.99,
      "text": "of course"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.03,
      "end_seconds": 126.0,
      "duration_seconds": 1.97,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.35,
      "end_seconds": 141.35,
      "duration_seconds": 2.0,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.61,
      "end_seconds": 145.35,
      "duration_seconds": 2.74,
      "text": "Nope, um, no fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.74,
      "end_seconds": 153.81,
      "duration_seconds": 5.07,
      "text": "any pain at rest, chest pain or back pain at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 156.87,
      "duration_seconds": 2.35,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.82,
      "end_seconds": 160.34,
      "duration_seconds": 2.52,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.03,
      "end_seconds": 163.26,
      "duration_seconds": 2.23,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.08,
      "end_seconds": 169.48,
      "duration_seconds": 2.4,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.94,
      "end_seconds": 173.67,
      "duration_seconds": 2.73,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.4,
      "end_seconds": 190.61,
      "duration_seconds": 3.21,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.54,
      "end_seconds": 198.14,
      "duration_seconds": 6.6,
      "text": "Glycomet i take it 500 milligrams, twice a day for my sugar"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.22,
      "end_seconds": 201.48,
      "duration_seconds": 2.26,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.16,
      "end_seconds": 208.43,
      "duration_seconds": 5.27,
      "text": "yes, diabetes. I'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.58,
      "end_seconds": 210.94,
      "duration_seconds": 1.36,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.89,
      "end_seconds": 215.25,
      "duration_seconds": 2.36,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.96,
      "end_seconds": 218.34,
      "duration_seconds": 1.38,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.37,
      "end_seconds": 225.83,
      "duration_seconds": 5.46,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.86,
      "end_seconds": 230.26,
      "duration_seconds": 2.4,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.89,
      "end_seconds": 235.22,
      "duration_seconds": 4.33,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 238.71,
      "duration_seconds": 2.02,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.82,
      "end_seconds": 245.17,
      "duration_seconds": 5.35,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.66,
      "end_seconds": 248.04,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.61,
      "end_seconds": 252.87,
      "duration_seconds": 3.26,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.0,
      "end_seconds": 260.15,
      "duration_seconds": 3.15,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.48,
      "end_seconds": 263.84,
      "duration_seconds": 2.36,
      "text": "my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.6,
      "end_seconds": 287.66,
      "duration_seconds": 5.06,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.61,
      "end_seconds": 291.74,
      "duration_seconds": 3.13,
      "text": "yes, milk i get stomach cramps"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.46,
      "end_seconds": 323.59,
      "duration_seconds": 19.13,
      "text": "An ultrasound of the leg arteries is what I'd like next, for claudication the treatment will be clopidogrel, 75 milligrams, once a day, long term it's for arterial disease it's a commonly used medicine and most people tolerate it well"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.64,
      "end_seconds": 327.9,
      "duration_seconds": 2.26,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.5,
      "end_seconds": 346.85,
      "duration_seconds": 18.35,
      "text": "Stop smoking and walk until the pain starts, then rest, and repeat daily. I think the vascular clinic should see you too. We'll catch up in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.37,
      "end_seconds": 351.52,
      "duration_seconds": 4.15,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}