{
  "schema_version": "1.0",
  "encounter_id": "02090",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 6.08,
      "duration_seconds": 5.5,
      "text": "Hello, good to see you. Please sit. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.14,
      "end_seconds": 9.69,
      "duration_seconds": 2.55,
      "text": "Only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.81,
      "end_seconds": 15.64,
      "duration_seconds": 1.83,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.46,
      "end_seconds": 25.51,
      "duration_seconds": 7.05,
      "text": "Honestly, it's rapidly spreading redness on the thigh, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.45,
      "end_seconds": 33.52,
      "duration_seconds": 6.07,
      "text": "How long has this been bothering you? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.44,
      "end_seconds": 44.82,
      "duration_seconds": 9.38,
      "text": "It's, It's been ten days now. There's severe pain as well. About severe pain, I'd call it severe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.73,
      "end_seconds": 63.03,
      "duration_seconds": 3.3,
      "text": "Have you noticed cough, diarrhoea or recent cut?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.58,
      "end_seconds": 66.96,
      "duration_seconds": 3.38,
      "text": "No, no cough, diarrhoea or recent cut."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 72.12,
      "duration_seconds": 4.32,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.96,
      "end_seconds": 79.15,
      "duration_seconds": 2.19,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.43,
      "end_seconds": 84.4,
      "duration_seconds": 3.97,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.58,
      "end_seconds": 87.3,
      "duration_seconds": 1.72,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.6,
      "end_seconds": 92.04,
      "duration_seconds": 3.44,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.66,
      "end_seconds": 107.49,
      "duration_seconds": 14.83,
      "text": "I have diabetes, for about a year. I've been reading about it online and it worried me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.5,
      "end_seconds": 114.76,
      "duration_seconds": 6.26,
      "text": "Alright, yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.19,
      "end_seconds": 132.84,
      "duration_seconds": 2.65,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.59,
      "end_seconds": 136.15,
      "duration_seconds": 1.56,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.15,
      "end_seconds": 142.79,
      "duration_seconds": 4.64,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.06,
      "end_seconds": 146.32,
      "duration_seconds": 2.26,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.53,
      "end_seconds": 150.18,
      "duration_seconds": 2.65,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.99,
      "end_seconds": 158.24,
      "duration_seconds": 3.25,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.76,
      "end_seconds": 163.01,
      "duration_seconds": 4.25,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.66,
      "end_seconds": 170.14,
      "duration_seconds": 6.48,
      "text": "Um, it's gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.32,
      "end_seconds": 183.71,
      "duration_seconds": 1.39,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.83,
      "end_seconds": 187.75,
      "duration_seconds": 2.92,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.17,
      "end_seconds": 191.0,
      "duration_seconds": 1.83,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.77,
      "end_seconds": 194.48,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.21,
      "end_seconds": 200.03,
      "duration_seconds": 3.82,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.6,
      "end_seconds": 205.35,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.0,
      "end_seconds": 207.85,
      "duration_seconds": 1.85,
      "text": "Alright, are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.44,
      "end_seconds": 211.19,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.98,
      "end_seconds": 216.28,
      "duration_seconds": 3.3,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.29,
      "end_seconds": 226.54,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 255.08,
      "duration_seconds": 8.92,
      "text": "Okay: saturation 98 percent, BP is 96 over 56. And temp 37.1 degrees, pulse is 112 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.74,
      "end_seconds": 260.89,
      "duration_seconds": 4.15,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.11,
      "end_seconds": 265.64,
      "duration_seconds": 3.53,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.53,
      "end_seconds": 289.58,
      "duration_seconds": 7.05,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.5,
      "end_seconds": 296.7,
      "duration_seconds": 2.2,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.55,
      "end_seconds": 339.8,
      "duration_seconds": 32.25,
      "text": "So, based on the history and the examination, it fits best with a possible necrotising soft tissue infection. Let's book an urgent surgical review to look into possible necrotising infection. That will help us see what's going on underneath and decide the next step. You need emergency surgery and intravenous antibiotics, we are going now. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.59,
      "end_seconds": 342.66,
      "duration_seconds": 1.07,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.51,
      "end_seconds": 348.96,
      "duration_seconds": 4.45,
      "text": "So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.86,
      "end_seconds": 354.53,
      "duration_seconds": 3.67,
      "text": "Let me think, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.44,
      "end_seconds": 357.85,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}