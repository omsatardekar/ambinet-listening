{
  "schema_version": "1.0",
  "encounter_id": "02102",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.02,
      "duration_seconds": 3.3,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 9.29,
      "duration_seconds": 4.01,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.24,
      "end_seconds": 17.26,
      "duration_seconds": 6.02,
      "text": "I'm here because of severe pain in the lower leg after a fracture."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.81,
      "end_seconds": 19.99,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.88,
      "end_seconds": 25.14,
      "duration_seconds": 3.26,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.43,
      "end_seconds": 31.02,
      "duration_seconds": 4.59,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.17,
      "end_seconds": 38.67,
      "duration_seconds": 6.5,
      "text": "I'd say all the time. Yes, passive movement. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.73,
      "end_seconds": 43.93,
      "duration_seconds": 3.2,
      "text": "Any tingling in the foot as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.02,
      "end_seconds": 54.73,
      "duration_seconds": 8.71,
      "text": "Yes, you know, actually. As for tingling in the foot, about a six out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.0,
      "end_seconds": 69.33,
      "duration_seconds": 2.33,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.6,
      "end_seconds": 82.93,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.43,
      "end_seconds": 111.34,
      "duration_seconds": 7.91,
      "text": "Okay: oxygen saturation is 99 percent, temperature 36.7, pressure 119 over 78, heart rate 79."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.04,
      "end_seconds": 115.48,
      "duration_seconds": 3.44,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.94,
      "end_seconds": 121.85,
      "duration_seconds": 2.91,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.37,
      "end_seconds": 129.14,
      "duration_seconds": 4.77,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.13,
      "end_seconds": 133.78,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.14,
      "end_seconds": 150.05,
      "duration_seconds": 6.91,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.81,
      "end_seconds": 159.0,
      "duration_seconds": 6.19,
      "text": "All finished, thank you. Okay, and what about chest pain, wound infection or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.15,
      "end_seconds": 165.69,
      "duration_seconds": 5.54,
      "text": "No chest pain, wound infection or fever, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.95,
      "end_seconds": 168.95,
      "duration_seconds": 2.0,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 172.56,
      "duration_seconds": 2.38,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 176.48,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.45,
      "end_seconds": 181.66,
      "duration_seconds": 3.21,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.19,
      "end_seconds": 194.2,
      "duration_seconds": 4.01,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.4,
      "end_seconds": 202.59,
      "duration_seconds": 3.19,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.26,
      "end_seconds": 207.48,
      "duration_seconds": 4.22,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.36,
      "end_seconds": 221.1,
      "duration_seconds": 11.74,
      "text": "No, I share a house with my brother. I hardly move around during the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.9,
      "end_seconds": 227.56,
      "duration_seconds": 4.66,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.57,
      "end_seconds": 231.36,
      "duration_seconds": 2.79,
      "text": "It's strong painkillers, not working."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.35,
      "end_seconds": 245.3,
      "duration_seconds": 3.95,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.58,
      "end_seconds": 255.35,
      "duration_seconds": 8.77,
      "text": "Oh, yes, plasters. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.89,
      "end_seconds": 276.18,
      "duration_seconds": 3.29,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.71,
      "end_seconds": 280.49,
      "duration_seconds": 2.78,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.3,
      "end_seconds": 310.81,
      "duration_seconds": 28.51,
      "text": "Having listened and examined, this looks most like possible compartment syndrome needing urgent surgery. That's my thinking for now, and it may change as we learn more. I'm going to order measuring the pressure in the leg, for possible compartment syndrome. Remove the cast now, you are going to theatre for a decompression. I'm going to send a referral to the orthopaedic team. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.65,
      "end_seconds": 313.85,
      "duration_seconds": 2.2,
      "text": "Thank you, that's helpful."
    }
  ]
}