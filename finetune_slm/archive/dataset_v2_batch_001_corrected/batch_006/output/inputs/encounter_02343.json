{
  "schema_version": "1.0",
  "encounter_id": "02343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 3.4,
      "duration_seconds": 2.54,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.1,
      "end_seconds": 7.47,
      "duration_seconds": 3.37,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 10.92,
      "duration_seconds": 1.4,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.12,
      "end_seconds": 17.49,
      "duration_seconds": 5.37,
      "text": "I wanted to get a back that has got shorter looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.24,
      "end_seconds": 23.19,
      "duration_seconds": 1.95,
      "text": "Right, since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.07,
      "end_seconds": 26.4,
      "duration_seconds": 2.33,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.01,
      "end_seconds": 31.77,
      "duration_seconds": 3.76,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.13,
      "end_seconds": 37.54,
      "duration_seconds": 4.41,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.38,
      "end_seconds": 42.33,
      "duration_seconds": 3.95,
      "text": "Has there been a wrist broken in a slip too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.29,
      "end_seconds": 46.21,
      "duration_seconds": 1.92,
      "text": "Yes, for four weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.0,
      "end_seconds": 48.29,
      "duration_seconds": 1.29,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.37,
      "end_seconds": 53.07,
      "duration_seconds": 3.7,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.75,
      "end_seconds": 57.61,
      "duration_seconds": 2.86,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.11,
      "end_seconds": 61.45,
      "duration_seconds": 3.34,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.17,
      "end_seconds": 65.28,
      "duration_seconds": 3.11,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.75,
      "end_seconds": 70.66,
      "duration_seconds": 3.91,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.4,
      "end_seconds": 75.92,
      "duration_seconds": 3.52,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 79.99,
      "duration_seconds": 3.32,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.73,
      "end_seconds": 83.26,
      "duration_seconds": 2.53,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.99,
      "end_seconds": 86.35,
      "duration_seconds": 2.36,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.83,
      "end_seconds": 106.88,
      "duration_seconds": 2.05,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.53,
      "end_seconds": 113.03,
      "duration_seconds": 4.5,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.49,
      "end_seconds": 119.95,
      "duration_seconds": 5.46,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.56,
      "end_seconds": 122.16,
      "duration_seconds": 1.6,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.08,
      "end_seconds": 128.73,
      "duration_seconds": 5.65,
      "text": "Have you had any numbness, fever, weight loss or bladder problems?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.36,
      "end_seconds": 132.8,
      "duration_seconds": 3.44,
      "text": "Well, no, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.35,
      "end_seconds": 137.68,
      "duration_seconds": 3.33,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.71,
      "end_seconds": 142.8,
      "duration_seconds": 3.09,
      "text": "Oh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 151.09,
      "end_seconds": 163.07,
      "duration_seconds": 11.98,
      "text": "Okay, so the vitals from earlier. Respiratory rate 16, heart rate 82, temp 36.8 degrees. Pressure 117 over 71, height 182 centimetres, weight 73 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 166.27,
      "duration_seconds": 1.49,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.4,
      "end_seconds": 171.98,
      "duration_seconds": 3.58,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.76,
      "end_seconds": 176.16,
      "duration_seconds": 2.4,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.62,
      "end_seconds": 190.29,
      "duration_seconds": 6.67,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.74,
      "end_seconds": 202.49,
      "duration_seconds": 8.75,
      "text": "all finished, thank you. Having listened and examined, I think we're dealing with osteoporosis with a fragility fracture at this stage"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.32,
      "end_seconds": 207.79,
      "duration_seconds": 3.47,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.62,
      "end_seconds": 226.92,
      "duration_seconds": 13.3,
      "text": "I understand the worry. At the moment I'd say it's osteoporosis with a fragility fracture, and we'll know more once the a bone density scan is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.4,
      "end_seconds": 276.21,
      "duration_seconds": 30.81,
      "text": "I want a bone density scan done, that's for osteoporosis. That will help us see what's going on underneath and decide the next step. What I'm giving you is alendronic acid, 70 milligrams, once a week, long term. It's for bone strengthening. Take the tablet with a full glass of water, and stay upright for thirty minutes. Do get help quickly if the symptoms get worse. We'll catch up in three months."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.28,
      "end_seconds": 286.46,
      "duration_seconds": 8.18,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.38,
      "end_seconds": 297.42,
      "duration_seconds": 10.04,
      "text": "So, I take the alendronic acid, 70 milligrams, once a week and come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.09,
      "end_seconds": 302.91,
      "duration_seconds": 3.82,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.35,
      "end_seconds": 306.4,
      "duration_seconds": 2.05,
      "text": "thank you, doctor, goodbye"
    }
  ]
}