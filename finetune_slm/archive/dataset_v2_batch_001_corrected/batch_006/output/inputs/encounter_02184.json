{
  "schema_version": "1.0",
  "encounter_id": "02184",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.79,
      "duration_seconds": 4.2,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 11.38,
      "duration_seconds": 5.06,
      "text": "So, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.18,
      "end_seconds": 21.23,
      "duration_seconds": 5.05,
      "text": "I wanted to get a swollen tummy looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.54,
      "end_seconds": 25.26,
      "duration_seconds": 2.72,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.99,
      "end_seconds": 31.1,
      "duration_seconds": 5.11,
      "text": "Um, I'm on lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.86,
      "end_seconds": 34.6,
      "duration_seconds": 1.74,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.21,
      "end_seconds": 54.35,
      "duration_seconds": 19.14,
      "text": "For about a month. I'm on escitalopram, 10 milligrams, once a day. Alcohol every day. I take it daily. My sister suggested writing things down, but I forgot. I was on pantoprazole before. I stopped taking it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 57.59,
      "duration_seconds": 1.61,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.54,
      "end_seconds": 63.79,
      "duration_seconds": 4.25,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.47,
      "end_seconds": 68.22,
      "duration_seconds": 2.75,
      "text": "Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.94,
      "end_seconds": 80.75,
      "duration_seconds": 6.81,
      "text": "Um, you know, it usually comes with vomiting large amounts of fresh blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.53,
      "end_seconds": 83.71,
      "duration_seconds": 2.18,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.64,
      "end_seconds": 90.93,
      "duration_seconds": 6.29,
      "text": "Yes, actually. Um, as for feeling faint, it's all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.95,
      "end_seconds": 99.3,
      "duration_seconds": 6.35,
      "text": "Have you had a swollen tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.52,
      "end_seconds": 108.58,
      "duration_seconds": 8.06,
      "text": "Ah, you know, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.18,
      "end_seconds": 112.86,
      "duration_seconds": 2.68,
      "text": "Okay, any fever or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.39,
      "end_seconds": 116.71,
      "duration_seconds": 3.32,
      "text": "Actually, no, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 120.42,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.27,
      "end_seconds": 123.06,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.63,
      "end_seconds": 128.83,
      "duration_seconds": 4.2,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.78,
      "end_seconds": 135.28,
      "duration_seconds": 4.5,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 139.9,
      "duration_seconds": 3.47,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.32,
      "end_seconds": 143.79,
      "duration_seconds": 2.47,
      "text": "Erm, no allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 149.48,
      "duration_seconds": 3.81,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.68,
      "end_seconds": 153.1,
      "duration_seconds": 2.42,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.94,
      "end_seconds": 159.01,
      "duration_seconds": 4.07,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.07,
      "end_seconds": 164.13,
      "duration_seconds": 3.06,
      "text": "Right, I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.12,
      "end_seconds": 166.82,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.53,
      "end_seconds": 173.89,
      "duration_seconds": 2.36,
      "text": "Anxiety, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.36,
      "end_seconds": 183.87,
      "duration_seconds": 8.51,
      "text": "Alright, acid reflux, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.59,
      "end_seconds": 198.66,
      "duration_seconds": 11.07,
      "text": "I grab fast food at lunch most days. My husband and I live above the shop. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.0,
      "end_seconds": 209.22,
      "duration_seconds": 2.22,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.01,
      "end_seconds": 215.58,
      "duration_seconds": 5.57,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 234.47,
      "duration_seconds": 2.1,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.79,
      "end_seconds": 245.48,
      "duration_seconds": 2.69,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.25,
      "end_seconds": 270.69,
      "duration_seconds": 8.44,
      "text": "Okay: pressure 99 over 65, temp 36.9 degrees, pulse 95. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.38,
      "end_seconds": 273.51,
      "duration_seconds": 2.13,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 277.6,
      "duration_seconds": 2.14,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.91,
      "end_seconds": 282.8,
      "duration_seconds": 3.89,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.86,
      "end_seconds": 285.57,
      "duration_seconds": 1.71,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.39,
      "end_seconds": 299.46,
      "duration_seconds": 6.07,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.09,
      "end_seconds": 306.03,
      "duration_seconds": 1.94,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.71,
      "end_seconds": 337.2,
      "duration_seconds": 12.49,
      "text": "So where does that leave us? This is probably a bleed from enlarged veins in the gullet in liver disease. A bleeding ulcer is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.2,
      "end_seconds": 342.34,
      "duration_seconds": 3.14,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.74,
      "end_seconds": 365.62,
      "duration_seconds": 18.88,
      "text": "Nothing I've seen today points to an emergency. It looks like a bleed from enlarged veins in the gullet in liver disease, but I'd like to confirm. I'm sending you for an urgent endoscopy because of variceal bleed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.54,
      "end_seconds": 369.66,
      "duration_seconds": 2.12,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.36,
      "end_seconds": 398.73,
      "duration_seconds": 28.37,
      "text": "For this, terlipressin, 2 milligrams, now, single dose. It's for variceal bleeding. You are going straight to resus, I am starting two drips. I'd like you to see the emergency team as well, and I'll write the referral. Come back or go to emergency straight away if the symptoms get worse. I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.24,
      "end_seconds": 403.13,
      "duration_seconds": 2.89,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.86,
      "end_seconds": 405.61,
      "duration_seconds": 1.75,
      "text": "Okay, take care now."
    }
  ]
}