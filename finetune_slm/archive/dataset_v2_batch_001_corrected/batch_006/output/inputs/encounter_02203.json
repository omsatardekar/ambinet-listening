{
  "schema_version": "1.0",
  "encounter_id": "02203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.34,
      "duration_seconds": 5.61,
      "text": "Hello, you know, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.07,
      "end_seconds": 12.45,
      "duration_seconds": 4.38,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 26.02,
      "duration_seconds": 12.48,
      "text": "Sorry, you know, what was I saying, so the thing is, I've got cramping in my calves when I walk."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 30.87,
      "duration_seconds": 3.62,
      "text": "Okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.18,
      "end_seconds": 41.44,
      "duration_seconds": 9.26,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 50.53,
      "duration_seconds": 7.94,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 59.17,
      "duration_seconds": 7.68,
      "text": "Stopping helps a bit. It feels moderate to me. It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.46,
      "end_seconds": 65.72,
      "duration_seconds": 2.26,
      "text": "Any cold feet as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.55,
      "end_seconds": 70.75,
      "duration_seconds": 4.2,
      "text": "Um, you know, yes, for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.04,
      "end_seconds": 71.74,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.51,
      "end_seconds": 80.82,
      "duration_seconds": 5.31,
      "text": "I've, I've also had hair loss on my shins."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.76,
      "end_seconds": 86.06,
      "duration_seconds": 3.3,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.12,
      "end_seconds": 94.27,
      "duration_seconds": 2.15,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.61,
      "end_seconds": 122.77,
      "duration_seconds": 9.16,
      "text": "Okay: pulse 75, SpO2 99 percent on room air, temp 36.8 degrees. And BP is 121 over 70."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.79,
      "end_seconds": 128.29,
      "duration_seconds": 3.5,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.44,
      "end_seconds": 131.41,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.12,
      "end_seconds": 146.25,
      "duration_seconds": 6.13,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.96,
      "end_seconds": 152.97,
      "duration_seconds": 3.01,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.6,
      "end_seconds": 167.27,
      "duration_seconds": 5.67,
      "text": "Let me check a few things. Any pain at rest, fever or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.91,
      "end_seconds": 173.65,
      "duration_seconds": 4.74,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.58,
      "end_seconds": 176.42,
      "duration_seconds": 1.84,
      "text": "Nothing like back pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.14,
      "end_seconds": 179.25,
      "duration_seconds": 2.11,
      "text": "Definitely no back pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.86,
      "end_seconds": 182.7,
      "duration_seconds": 2.84,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.88,
      "end_seconds": 186.58,
      "duration_seconds": 2.7,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.44,
      "end_seconds": 190.98,
      "duration_seconds": 2.54,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.05,
      "end_seconds": 194.95,
      "duration_seconds": 2.9,
      "text": "Hmm, no problems with breathing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.96,
      "end_seconds": 199.55,
      "duration_seconds": 2.59,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.67,
      "end_seconds": 217.92,
      "duration_seconds": 17.25,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol. Though honestly, some days I forget to take it. I had atorvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.12,
      "end_seconds": 220.32,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.69,
      "end_seconds": 225.32,
      "duration_seconds": 3.63,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.25,
      "end_seconds": 228.16,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.92,
      "end_seconds": 232.88,
      "duration_seconds": 3.96,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.95,
      "end_seconds": 237.4,
      "duration_seconds": 2.45,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.14,
      "end_seconds": 243.64,
      "duration_seconds": 4.5,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.39,
      "end_seconds": 247.75,
      "duration_seconds": 3.36,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.59,
      "end_seconds": 254.29,
      "duration_seconds": 3.7,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.05,
      "end_seconds": 259.57,
      "duration_seconds": 3.52,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.66,
      "end_seconds": 265.27,
      "duration_seconds": 3.61,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.37,
      "end_seconds": 274.57,
      "duration_seconds": 4.2,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.17,
      "end_seconds": 282.78,
      "duration_seconds": 4.61,
      "text": "I'm, I'm allergic to tramadol, I get vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.27,
      "end_seconds": 285.45,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.23,
      "end_seconds": 289.12,
      "duration_seconds": 2.89,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.9,
      "end_seconds": 294.26,
      "duration_seconds": 4.36,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 298.17,
      "duration_seconds": 2.01,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 318.31,
      "duration_seconds": 13.74,
      "text": "Yes. Yes, high cholesterol is known to us, good to have that clear. Okay, thinking it through, it points towards peripheral arterial disease. Another possibility is a nerve problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.72,
      "end_seconds": 342.95,
      "duration_seconds": 9.23,
      "text": "Stop smoking and walk until the pain starts, then rest, and repeat daily. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.77,
      "end_seconds": 348.05,
      "duration_seconds": 3.28,
      "text": "So, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.56,
      "end_seconds": 350.75,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}