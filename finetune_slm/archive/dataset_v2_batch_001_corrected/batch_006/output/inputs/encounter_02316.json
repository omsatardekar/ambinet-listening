{
  "schema_version": "1.0",
  "encounter_id": "02316",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 6.1,
      "duration_seconds": 5.01,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 11.47,
      "duration_seconds": 4.64,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.85,
      "end_seconds": 15.82,
      "duration_seconds": 2.97,
      "text": "I've been getting puffed climbing stairs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.54,
      "end_seconds": 20.79,
      "duration_seconds": 3.25,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.12,
      "end_seconds": 31.46,
      "duration_seconds": 2.34,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.46,
      "end_seconds": 50.8,
      "duration_seconds": 9.34,
      "text": "Okay: pulse is 69 beats a minute, respiratory rate 18. And BP is 115 over 68, saturation 99 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.57,
      "end_seconds": 54.05,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.24,
      "end_seconds": 59.87,
      "duration_seconds": 4.63,
      "text": "Don't worry, we'll discuss it in a second. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.76,
      "end_seconds": 63.61,
      "duration_seconds": 2.85,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.86,
      "end_seconds": 73.52,
      "duration_seconds": 8.66,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.46,
      "end_seconds": 85.7,
      "duration_seconds": 10.24,
      "text": "I'd say every other day. It's moderate, honestly. Oh, um, and a bit of a cough with exercise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.25,
      "end_seconds": 98.75,
      "duration_seconds": 4.5,
      "text": "Have you had any wheeze, chest pain, palpitations or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.72,
      "end_seconds": 106.5,
      "duration_seconds": 5.78,
      "text": "No wheeze, chest pain, palpitations or fainting, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 111.26,
      "duration_seconds": 2.75,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.92,
      "end_seconds": 114.39,
      "duration_seconds": 1.47,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.02,
      "end_seconds": 118.84,
      "duration_seconds": 2.82,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.41,
      "end_seconds": 126.87,
      "duration_seconds": 2.46,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.76,
      "end_seconds": 130.96,
      "duration_seconds": 3.2,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 142.1,
      "duration_seconds": 10.19,
      "text": "I've had depression for about a year now. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.1,
      "end_seconds": 147.54,
      "duration_seconds": 3.44,
      "text": "Okay, go on. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.77,
      "end_seconds": 157.1,
      "duration_seconds": 5.33,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.12,
      "end_seconds": 160.5,
      "duration_seconds": 2.38,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.24,
      "end_seconds": 164.48,
      "duration_seconds": 2.24,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 168.06,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.64,
      "end_seconds": 172.4,
      "duration_seconds": 3.76,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.36,
      "end_seconds": 175.33,
      "duration_seconds": 1.97,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.96,
      "end_seconds": 179.27,
      "duration_seconds": 3.31,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.11,
      "end_seconds": 182.23,
      "duration_seconds": 2.12,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.48,
      "end_seconds": 187.37,
      "duration_seconds": 3.89,
      "text": "I'm on fluoxetine, every morning for my mood."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.27,
      "end_seconds": 190.55,
      "duration_seconds": 2.28,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.36,
      "end_seconds": 192.89,
      "duration_seconds": 1.53,
      "text": "It's 20 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.84,
      "end_seconds": 203.45,
      "duration_seconds": 2.61,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.15,
      "end_seconds": 209.61,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.23,
      "end_seconds": 214.48,
      "duration_seconds": 3.25,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.07,
      "end_seconds": 222.77,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.51,
      "end_seconds": 225.84,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.28,
      "end_seconds": 249.58,
      "duration_seconds": 6.3,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.77,
      "end_seconds": 262.24,
      "duration_seconds": 9.47,
      "text": "Right, you can sit up now. So where does that leave us? This looks most like breathlessness from low fitness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.05,
      "end_seconds": 295.13,
      "duration_seconds": 25.08,
      "text": "I'm going to order a peak flow, for exertional cough. Build up to thirty minutes of brisk walking five days a week. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Book a review in eight weeks. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.61,
      "end_seconds": 300.0,
      "duration_seconds": 3.39,
      "text": "Oh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.83,
      "end_seconds": 302.2,
      "duration_seconds": 1.37,
      "text": "Take care now."
    }
  ]
}