{
  "schema_version": "1.0",
  "encounter_id": "02496",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.74,
      "duration_seconds": 4.62,
      "text": "Let me think, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 10.36,
      "duration_seconds": 3.66,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.22,
      "end_seconds": 19.18,
      "duration_seconds": 6.96,
      "text": "Okay, so doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.79,
      "end_seconds": 27.58,
      "duration_seconds": 7.79,
      "text": "yeah, um, I wanted to get my face drooping on the right looked at"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.09,
      "end_seconds": 32.28,
      "duration_seconds": 3.19,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.73,
      "end_seconds": 38.66,
      "duration_seconds": 4.93,
      "text": "Tiotropium inhaler i take it it once a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.8,
      "end_seconds": 45.79,
      "duration_seconds": 1.99,
      "text": "alright, is that long-standing?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.86,
      "end_seconds": 54.36,
      "duration_seconds": 6.5,
      "text": "About nearly five years. I'm on pantoprazole, 40 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.72,
      "end_seconds": 63.01,
      "duration_seconds": 4.29,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.08,
      "end_seconds": 69.3,
      "duration_seconds": 4.22,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.37,
      "end_seconds": 73.16,
      "duration_seconds": 2.79,
      "text": "Has there been a funny taste too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.07,
      "end_seconds": 84.5,
      "duration_seconds": 10.43,
      "text": "Okay, so yes, for four weeks. I had not being able to close my eye before. That's settled now, though."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.62,
      "end_seconds": 100.37,
      "duration_seconds": 7.75,
      "text": "Okay, have you had any headache, weakness in the arm or leg, rash in the ear or slurred speech?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.73,
      "end_seconds": 111.68,
      "duration_seconds": 9.95,
      "text": "No, no headache, weakness in the arm or leg, rash in the ear or slurred speech."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.43,
      "end_seconds": 115.66,
      "duration_seconds": 2.23,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.06,
      "end_seconds": 118.89,
      "duration_seconds": 1.83,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.26,
      "end_seconds": 138.14,
      "duration_seconds": 5.88,
      "text": "Right, what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.4,
      "end_seconds": 142.21,
      "duration_seconds": 2.81,
      "text": "COPD, for about a year."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.04,
      "end_seconds": 145.11,
      "duration_seconds": 1.07,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.96,
      "end_seconds": 152.27,
      "duration_seconds": 5.31,
      "text": "I've had acid reflux for about a year now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.94,
      "end_seconds": 162.68,
      "duration_seconds": 9.74,
      "text": "Okay, I can see acid reflux in your file as well. What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.68,
      "end_seconds": 167.3,
      "duration_seconds": 3.62,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.04,
      "end_seconds": 170.24,
      "duration_seconds": 2.2,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.32,
      "end_seconds": 176.15,
      "duration_seconds": 4.83,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.01,
      "end_seconds": 180.93,
      "duration_seconds": 2.92,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.54,
      "end_seconds": 188.94,
      "duration_seconds": 7.4,
      "text": "I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.64,
      "end_seconds": 194.38,
      "duration_seconds": 4.74,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.8,
      "end_seconds": 206.54,
      "duration_seconds": 10.74,
      "text": "I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.33,
      "end_seconds": 211.22,
      "duration_seconds": 2.89,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.05,
      "end_seconds": 225.23,
      "duration_seconds": 2.18,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 253.35,
      "duration_seconds": 17.83,
      "text": "okay: respiratory rate 17, BMI works out to 17.1, BP is 125 over 72. And pulse is 77 beats a minute, height 176 centimetres, temperature is 37.0 degrees, weight 53 kilos, saturation 99 percent"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.24,
      "end_seconds": 258.56,
      "duration_seconds": 3.32,
      "text": "Oh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.65,
      "end_seconds": 262.64,
      "duration_seconds": 1.99,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 269.02,
      "duration_seconds": 4.22,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.13,
      "end_seconds": 271.53,
      "duration_seconds": 1.4,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.76,
      "end_seconds": 293.89,
      "duration_seconds": 9.13,
      "text": "the whole right side of the face is weak, including the forehead, and the left side is normal"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.22,
      "end_seconds": 307.51,
      "duration_seconds": 8.29,
      "text": "all finished, thank you. So where does that leave us? It points towards Bell's palsy. A stroke is still possible"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.35,
      "end_seconds": 347.69,
      "duration_seconds": 28.34,
      "text": "I'm prescribing prednisolone, 50 milligrams, once a day, ten days. That's for Bell's palsy. The pharmacy will go through the details again when you pick it up. Use eye drops and tape the eye shut at night to protect it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.47,
      "end_seconds": 352.27,
      "duration_seconds": 3.8,
      "text": "I, I know what to watch for"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.83,
      "end_seconds": 364.53,
      "duration_seconds": 10.7,
      "text": "Keep an eye out, and if you get weakness in an arm or leg, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.79,
      "end_seconds": 371.58,
      "duration_seconds": 3.79,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.41,
      "end_seconds": 376.27,
      "duration_seconds": 2.86,
      "text": "See me again in one week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.0,
      "end_seconds": 382.49,
      "duration_seconds": 4.49,
      "text": "Um, you know, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.4,
      "end_seconds": 390.39,
      "duration_seconds": 5.99,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.95,
      "end_seconds": 402.84,
      "duration_seconds": 9.89,
      "text": "So, I take the prednisolone, 50 milligrams, once a day and come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.93,
      "end_seconds": 410.63,
      "duration_seconds": 5.7,
      "text": "yes, exactly right is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.55,
      "end_seconds": 414.59,
      "duration_seconds": 3.04,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}