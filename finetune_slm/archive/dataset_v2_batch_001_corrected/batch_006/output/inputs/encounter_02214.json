  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.8,
      "duration_seconds": 3.42,
      "text": "hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.48,
      "end_seconds": 10.95,
      "duration_seconds": 4.47,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.12,
      "end_seconds": 20.25,
      "duration_seconds": 6.13,
      "text": "so the thing is, I've got a shaky feeling in my hands"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.12,
      "end_seconds": 24.32,
      "duration_seconds": 2.2,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.75,
      "end_seconds": 29.35,
      "duration_seconds": 3.6,
      "text": "it happens a few times a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 33.13,
      "duration_seconds": 3.53,
      "text": "mm okay have you had butterflies in your stomach?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.0,
      "end_seconds": 39.93,
      "duration_seconds": 4.93,
      "text": "Yeah. Two months, I'd say. And sweaty palms, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.15,
      "end_seconds": 47.39,
      "duration_seconds": 6.24,
      "text": "Have you had a shaky feeling in your hands before or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.0,
      "end_seconds": 53.54,
      "duration_seconds": 4.54,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.86,
      "end_seconds": 72.18,
      "duration_seconds": 2.32,
      "text": "any palpitations or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.61,
      "end_seconds": 76.34,
      "duration_seconds": 2.73,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.13,
      "end_seconds": 80.55,
      "duration_seconds": 2.42,
      "text": "did you get fainting or weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.36,
      "end_seconds": 84.84,
      "duration_seconds": 3.48,
      "text": "no fainting or weakness, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.9,
      "end_seconds": 93.15,
      "duration_seconds": 3.25,
      "text": "okay, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.16,
      "end_seconds": 99.67,
      "duration_seconds": 4.51,
      "text": "my heart's been fine as far as I know"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.42,
      "end_seconds": 118.97,
      "duration_seconds": 4.55,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.07,
      "end_seconds": 123.95,
      "duration_seconds": 1.88,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.2,
      "end_seconds": 127.13,
      "duration_seconds": 1.93,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.96,
      "end_seconds": 132.32,
      "duration_seconds": 4.36,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.12,
      "end_seconds": 136.88,
      "duration_seconds": 2.76,
      "text": "anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.18,
      "end_seconds": 141.81,
      "duration_seconds": 3.63,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.63,
      "end_seconds": 150.25,
      "duration_seconds": 4.62,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.25,
      "end_seconds": 155.53,
      "duration_seconds": 4.28,
      "text": "Oh it's simvastatin 20 milligrams maybe at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.7,
      "end_seconds": 159.55,
      "duration_seconds": 2.85,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.61,
      "end_seconds": 165.56,
      "duration_seconds": 3.95,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.6,
      "end_seconds": 170.59,
      "duration_seconds": 3.99,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.38,
      "end_seconds": 174.14,
      "duration_seconds": 2.76,
      "text": "High cholesterol for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.22,
      "end_seconds": 176.41,
      "duration_seconds": 1.19,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.37,
      "end_seconds": 180.14,
      "duration_seconds": 2.77,
      "text": "I have high blood pressure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.16,
      "end_seconds": 188.5,
      "duration_seconds": 7.34,
      "text": "understood right, so high cholesterol is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.5,
      "end_seconds": 206.75,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.97,
      "end_seconds": 218.34,
      "duration_seconds": 2.37,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.47,
      "end_seconds": 242.68,
      "duration_seconds": 9.21,
      "text": "okay: blood pressure 114 over 81, weight 65 kilos, saturation 99 percent, temperature is 36.6 degrees, height 157 centimetres, pulse 81."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.71,
      "end_seconds": 246.33,
      "duration_seconds": 1.62,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.14,
      "end_seconds": 249.08,
      "duration_seconds": 1.94,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.76,
      "end_seconds": 253.79,
      "duration_seconds": 3.03,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.31,
      "end_seconds": 256.42,
      "duration_seconds": 1.11,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.06,
      "end_seconds": 260.48,
      "duration_seconds": 2.42,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.17,
      "end_seconds": 281.94,
      "duration_seconds": 5.77,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.76,
      "end_seconds": 299.63,
      "duration_seconds": 14.87,
      "text": "That's all I needed to check. Right here's what I'm thinking. I don't have a clear answer today: an anxiety or caffeine-related tremor is possible and so is an overactive thyroid."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.23,
      "end_seconds": 302.26,
      "duration_seconds": 2.03,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.85,
      "end_seconds": 319.45,
      "duration_seconds": 16.6,
      "text": "Nothing I've seen today points to an emergency. It looks like an anxiety or caffeine-related tremor, but I'd like to confirm. Just to be sure I understood. You've had a shaky feeling in your hands, and no palpitations or fainting."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.26,
      "end_seconds": 324.11,
      "duration_seconds": 2.85,
      "text": "yes, um, you've got it"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.32,
      "end_seconds": 346.91,
      "duration_seconds": 21.59,
      "text": "A thyroid test is what I'd like next, for tremor i'd rather check than guess, and this is the quickest way to know more cut down caffeine and try slow breathing when it starts and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.66,
      "end_seconds": 350.09,
      "duration_seconds": 1.43,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.94,
      "end_seconds": 358.53,
      "duration_seconds": 6.59,
      "text": "Book a review in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.2,
      "end_seconds": 361.55,
      "duration_seconds": 2.35,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.55,
      "end_seconds": 364.76,
      "duration_seconds": 1.21,
      "text": "goodbye for now"
    }
  ]
