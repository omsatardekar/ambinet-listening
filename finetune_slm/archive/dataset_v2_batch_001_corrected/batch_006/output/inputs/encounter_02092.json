{
  "schema_version": "1.0",
  "encounter_id": "02092",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 6.18,
      "duration_seconds": 5.33,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.69,
      "end_seconds": 8.8,
      "duration_seconds": 1.11,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.5,
      "end_seconds": 12.47,
      "duration_seconds": 2.97,
      "text": "So, what's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 17.5,
      "duration_seconds": 3.75,
      "text": "It's a back that has got shorter, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.08,
      "end_seconds": 24.47,
      "duration_seconds": 3.39,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.21,
      "end_seconds": 29.12,
      "duration_seconds": 2.91,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.53,
      "end_seconds": 33.43,
      "duration_seconds": 3.9,
      "text": "I follow. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.93,
      "end_seconds": 43.93,
      "duration_seconds": 10.0,
      "text": "About a five out of ten. I've, I've also had a dull ache in my back, for two days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.02,
      "end_seconds": 47.44,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.17,
      "end_seconds": 51.72,
      "duration_seconds": 2.55,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.85,
      "end_seconds": 70.93,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.07,
      "end_seconds": 84.6,
      "duration_seconds": 12.53,
      "text": "I hardly move around during the day. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.35,
      "end_seconds": 101.0,
      "duration_seconds": 4.65,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.52,
      "end_seconds": 105.5,
      "duration_seconds": 2.98,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.35,
      "end_seconds": 127.75,
      "duration_seconds": 4.4,
      "text": "A few quick ones: numbness, fever or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.28,
      "end_seconds": 134.37,
      "duration_seconds": 5.09,
      "text": "No numbness, fever or weight loss, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.75,
      "end_seconds": 137.73,
      "duration_seconds": 1.98,
      "text": "Any sign of bladder problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.77,
      "end_seconds": 142.03,
      "duration_seconds": 2.26,
      "text": "Definitely no bladder problems."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.85,
      "end_seconds": 146.42,
      "duration_seconds": 3.57,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 149.86,
      "duration_seconds": 0.95,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.08,
      "end_seconds": 163.63,
      "duration_seconds": 3.55,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.74,
      "end_seconds": 176.05,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.13,
      "end_seconds": 198.92,
      "duration_seconds": 11.79,
      "text": "Okay: temp 36.7 degrees, blood pressure 112 over 78. And pulse 84, height 159 centimetres, weight 52 kilos, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.13,
      "end_seconds": 202.3,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.26,
      "end_seconds": 207.22,
      "duration_seconds": 2.96,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.67,
      "end_seconds": 213.13,
      "duration_seconds": 4.46,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.89,
      "end_seconds": 216.89,
      "duration_seconds": 2.0,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.3,
      "end_seconds": 236.07,
      "duration_seconds": 6.77,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.32,
      "end_seconds": 251.8,
      "duration_seconds": 11.48,
      "text": "All finished, thank you. So, to recap quickly. You've had a back that has got shorter for four weeks, and no fever or weight loss."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.0,
      "end_seconds": 255.13,
      "duration_seconds": 2.13,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.72,
      "end_seconds": 287.04,
      "duration_seconds": 31.32,
      "text": "A bone density scan is what I'd like next, for osteoporosis. I'm sending you for blood tests because of osteoporosis. We'll begin with alendronic acid, 70 milligrams, once a week, long term. That should help with bone strengthening. Take the tablet with a full glass of water, and stay upright for thirty minutes. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.82,
      "end_seconds": 303.72,
      "duration_seconds": 15.9,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again in three months. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.47,
      "end_seconds": 307.44,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    }
  ]
}