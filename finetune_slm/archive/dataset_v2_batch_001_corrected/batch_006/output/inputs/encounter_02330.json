{
  "schema_version": "1.0",
  "encounter_id": "02330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 4.99,
      "duration_seconds": 4.38,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 10.29,
      "duration_seconds": 4.49,
      "text": "Okay, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.26,
      "end_seconds": 16.8,
      "duration_seconds": 4.54,
      "text": "well, I've been having a severe painful red eye"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.82,
      "end_seconds": 22.03,
      "duration_seconds": 3.21,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.6,
      "end_seconds": 32.3,
      "duration_seconds": 9.7,
      "text": "it's been two days, I'm fairly sure. I've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.2,
      "end_seconds": 39.22,
      "duration_seconds": 5.02,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.04,
      "end_seconds": 49.99,
      "duration_seconds": 8.95,
      "text": "mm, you know, I notice it more with dim light. A three out of ten, I suppose"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.83,
      "end_seconds": 57.19,
      "duration_seconds": 2.36,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.25,
      "end_seconds": 67.71,
      "duration_seconds": 6.46,
      "text": "When it starts I tend to get a headache as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 72.33,
      "duration_seconds": 3.23,
      "text": "so, how often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.25,
      "end_seconds": 77.18,
      "duration_seconds": 3.93,
      "text": "ah, it sort of comes and goes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.26,
      "end_seconds": 81.55,
      "duration_seconds": 3.29,
      "text": "Have you noticed contact lens, discharge or injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.31,
      "end_seconds": 91.13,
      "duration_seconds": 8.82,
      "text": "sorry, what was I saying, no contact lens, discharge or injury, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 97.89,
      "duration_seconds": 5.53,
      "text": "okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.92,
      "end_seconds": 101.91,
      "duration_seconds": 2.99,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.61,
      "end_seconds": 122.89,
      "duration_seconds": 3.28,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.34,
      "end_seconds": 129.32,
      "duration_seconds": 4.98,
      "text": "yes, I had a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.43,
      "end_seconds": 131.81,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.02,
      "end_seconds": 137.98,
      "duration_seconds": 4.96,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.55,
      "end_seconds": 142.27,
      "duration_seconds": 2.72,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.59,
      "end_seconds": 150.55,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.51,
      "end_seconds": 154.84,
      "duration_seconds": 2.33,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.61,
      "end_seconds": 161.11,
      "duration_seconds": 4.5,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.79,
      "end_seconds": 170.08,
      "duration_seconds": 4.29,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.47,
      "end_seconds": 175.79,
      "duration_seconds": 4.32,
      "text": "Apixaban, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.66,
      "end_seconds": 180.1,
      "duration_seconds": 2.44,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.2,
      "end_seconds": 188.37,
      "duration_seconds": 7.17,
      "text": "5 milligrams. Actually, I'm on metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.96,
      "end_seconds": 190.57,
      "duration_seconds": 1.61,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.29,
      "end_seconds": 193.9,
      "duration_seconds": 1.61,
      "text": "for two years"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.84,
      "end_seconds": 209.12,
      "duration_seconds": 3.28,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.1,
      "end_seconds": 214.71,
      "duration_seconds": 3.61,
      "text": "I, I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.44,
      "end_seconds": 216.5,
      "duration_seconds": 1.06,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.25,
      "end_seconds": 223.27,
      "duration_seconds": 2.02,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.4,
      "end_seconds": 237.62,
      "duration_seconds": 13.22,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.61,
      "end_seconds": 246.89,
      "duration_seconds": 8.28,
      "text": "Years back I got stomach pain from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.34,
      "end_seconds": 257.37,
      "duration_seconds": 9.03,
      "text": "Doctor, I've got the readings for you. Heart rate 85, saturation 98 percent, pressure 112 over 73. Temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.33,
      "end_seconds": 260.41,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.97,
      "end_seconds": 268.64,
      "duration_seconds": 5.67,
      "text": "alright, I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 271.85,
      "duration_seconds": 1.38,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 288.66,
      "duration_seconds": 7.03,
      "text": "the right eye is red, the pupil is fixed and mid-sized, and the eye feels rock hard"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.81,
      "end_seconds": 293.38,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.25,
      "end_seconds": 309.36,
      "duration_seconds": 7.11,
      "text": "From what you've told me and what I found, the most likely explanation is acute angle-closure glaucoma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.83,
      "end_seconds": 313.16,
      "duration_seconds": 2.33,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.94,
      "end_seconds": 340.31,
      "duration_seconds": 23.37,
      "text": "I understand the worry. At the moment I'd say it's acute angle-closure glaucoma, and we'll know more once the an urgent eye pressure check is back. Let's get an urgent eye pressure check, for acute glaucoma. I'm prescribing acetazolamide, 500 milligrams, now, single dose. It's for acute glaucoma."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 341.34,
      "end_seconds": 342.57,
      "duration_seconds": 1.23,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.6,
      "end_seconds": 349.47,
      "duration_seconds": 5.87,
      "text": "This is a sight-threatening emergency, I am sending you to the eye casualty now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.01,
      "end_seconds": 352.1,
      "duration_seconds": 2.09,
      "text": "sure come back straight away"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.18,
      "end_seconds": 356.39,
      "duration_seconds": 3.21,
      "text": "uh, good, I'll return then"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.31,
      "end_seconds": 359.71,
      "duration_seconds": 2.4,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.75,
      "end_seconds": 366.64,
      "duration_seconds": 4.89,
      "text": "Um, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.84,
      "end_seconds": 370.13,
      "duration_seconds": 2.29,
      "text": "Have a a good day."
    }
  ]
}