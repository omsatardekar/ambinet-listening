  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.5,
      "duration_seconds": 2.88,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.03,
      "end_seconds": 7.65,
      "duration_seconds": 3.62,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.6,
      "end_seconds": 16.39,
      "duration_seconds": 6.79,
      "text": "Mainly no symptoms. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.28,
      "end_seconds": 21.19,
      "duration_seconds": 2.91,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.81,
      "end_seconds": 23.83,
      "duration_seconds": 2.02,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.11,
      "end_seconds": 28.23,
      "duration_seconds": 3.12,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.97,
      "end_seconds": 33.31,
      "duration_seconds": 4.34,
      "text": "Uh, about a six out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.89,
      "end_seconds": 37.92,
      "duration_seconds": 3.03,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.9,
      "end_seconds": 53.92,
      "duration_seconds": 14.02,
      "text": "A high blood sugar on a routine test goes along with it, most of the time. The high blood sugar on a routine test? That's been for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.21,
      "end_seconds": 67.78,
      "duration_seconds": 4.57,
      "text": "Any thirst, blurred vision, frequent urination or weight loss at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.13,
      "end_seconds": 75.39,
      "duration_seconds": 6.26,
      "text": "No thirst, blurred vision, frequent urination or weight loss, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.77,
      "end_seconds": 80.65,
      "duration_seconds": 3.88,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.55,
      "end_seconds": 84.71,
      "duration_seconds": 2.16,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.25,
      "end_seconds": 88.14,
      "duration_seconds": 2.89,
      "text": "So, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.33,
      "end_seconds": 90.45,
      "duration_seconds": 1.12,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.02,
      "end_seconds": 95.16,
      "duration_seconds": 4.14,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.37,
      "end_seconds": 111.35,
      "duration_seconds": 14.98,
      "text": "No, I've never smoked in my life. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.81,
      "end_seconds": 116.82,
      "duration_seconds": 4.01,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.71,
      "end_seconds": 120.09,
      "duration_seconds": 2.38,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.92,
      "end_seconds": 125.73,
      "duration_seconds": 3.81,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.49,
      "end_seconds": 129.63,
      "duration_seconds": 3.14,
      "text": "Levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 134.45,
      "duration_seconds": 3.51,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.7,
      "end_seconds": 139.73,
      "duration_seconds": 4.03,
      "text": "Ah, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.34,
      "end_seconds": 142.56,
      "duration_seconds": 2.22,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 146.87,
      "duration_seconds": 3.45,
      "text": "I have epilepsy, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.1,
      "end_seconds": 151.06,
      "duration_seconds": 2.96,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 165.86,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.68,
      "end_seconds": 191.14,
      "duration_seconds": 12.46,
      "text": "Okay: pulse is 67 beats a minute, temperature is 36.5 degrees, BMI works out to 23.1, pressure 111 over 69, height 185 centimetres, weight 79 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.07,
      "end_seconds": 197.94,
      "duration_seconds": 3.87,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.11,
      "end_seconds": 213.57,
      "duration_seconds": 1.46,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.88,
      "end_seconds": 217.18,
      "duration_seconds": 2.3,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.34,
      "end_seconds": 232.16,
      "duration_seconds": 3.82,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.07,
      "end_seconds": 234.47,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.35,
      "end_seconds": 242.8,
      "duration_seconds": 2.45,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.77,
      "end_seconds": 254.68,
      "duration_seconds": 3.91,
      "text": "Having listened and examined, I'd lean towards prediabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.4,
      "end_seconds": 259.74,
      "duration_seconds": 3.34,
      "text": "Well, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.56,
      "end_seconds": 266.73,
      "duration_seconds": 6.17,
      "text": "I can't promise yet, but most people with prediabetes do well once it's treated properly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.03,
      "end_seconds": 302.3,
      "duration_seconds": 18.27,
      "text": "Let's get a repeat HbA1c, for prediabetes. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight. I'll also refer you to the diabetes prevention programme. Book a review in six months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.69,
      "end_seconds": 307.93,
      "duration_seconds": 4.24,
      "text": "Actually, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.04,
      "end_seconds": 310.36,
      "duration_seconds": 1.32,
      "text": "Look after yourself."
    }
  ]
