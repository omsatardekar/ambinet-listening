    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.85,
      "end_seconds": 312.63,
      "duration_seconds": 28.78,
      "text": "I'm sending you for urgent blood tests because of major bleed. Let's use terlipressin 2 milligrams now single dose. That's for variceal bleeding. You are going straight to resus I am starting two drips. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Please don't wait if the symptoms get worse. That's when to be seen urgently. Book a review straight away"
