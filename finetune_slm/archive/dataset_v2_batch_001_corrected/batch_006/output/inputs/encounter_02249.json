{
  "schema_version": "1.0",
  "encounter_id": "02249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 7.75,
      "duration_seconds": 6.63,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.75,
      "end_seconds": 14.18,
      "duration_seconds": 4.43,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.26,
      "end_seconds": 22.77,
      "duration_seconds": 5.51,
      "text": "So the thing is, I've got my face drooping on the right."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.56,
      "end_seconds": 27.7,
      "duration_seconds": 3.14,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.27,
      "end_seconds": 31.49,
      "duration_seconds": 3.22,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 35.25,
      "duration_seconds": 3.42,
      "text": "Understood. Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.75,
      "end_seconds": 40.7,
      "duration_seconds": 3.95,
      "text": "Uh, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 43.77,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.63,
      "end_seconds": 75.35,
      "duration_seconds": 29.72,
      "text": "Not being able to close my eye goes along with it, most of the time. As for not being able to close my eye, I honestly can't say when that began. It might have been last month or the month before. Well, you know, I've also had a funny taste, for about three months. Oh, and pain behind the ear."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 79.61,
      "duration_seconds": 2.86,
      "text": "Did you notice any slurred speech?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.59,
      "end_seconds": 84.32,
      "duration_seconds": 3.73,
      "text": "No, I haven't had any slurred speech."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.33,
      "end_seconds": 92.71,
      "duration_seconds": 6.38,
      "text": "Any headache, rash in the ear or weakness in the arm or leg at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.75,
      "end_seconds": 107.05,
      "duration_seconds": 9.3,
      "text": "I haven't had headache, rash in the ear or weakness in the arm or leg, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.1,
      "end_seconds": 112.06,
      "duration_seconds": 2.96,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 113.73,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.12,
      "end_seconds": 125.1,
      "duration_seconds": 3.98,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.94,
      "end_seconds": 131.66,
      "duration_seconds": 4.72,
      "text": "Metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 132.36,
      "end_seconds": 137.88,
      "duration_seconds": 5.52,
      "text": "Doctor, our chart from the last visit lists it as 25 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.42,
      "end_seconds": 142.24,
      "duration_seconds": 2.82,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.99,
      "end_seconds": 160.13,
      "duration_seconds": 14.14,
      "text": "I don't think I have it with me. I take tamsulosin, 0.4 milligrams, at night for the prostate. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 173.13,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.97,
      "end_seconds": 177.72,
      "duration_seconds": 3.75,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.61,
      "end_seconds": 180.32,
      "duration_seconds": 1.71,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.85,
      "end_seconds": 188.37,
      "duration_seconds": 4.52,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.26,
      "end_seconds": 193.92,
      "duration_seconds": 3.66,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.68,
      "end_seconds": 199.42,
      "duration_seconds": 3.74,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.33,
      "end_seconds": 201.99,
      "duration_seconds": 1.66,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.9,
      "end_seconds": 207.25,
      "duration_seconds": 3.35,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.32,
      "end_seconds": 211.18,
      "duration_seconds": 2.86,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.59,
      "end_seconds": 215.71,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.44,
      "end_seconds": 229.81,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.31,
      "end_seconds": 232.55,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.75,
      "end_seconds": 237.47,
      "duration_seconds": 3.72,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.43,
      "end_seconds": 244.19,
      "duration_seconds": 5.76,
      "text": "I've had heart failure, yes. An enlarged prostate, for five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.42,
      "end_seconds": 246.91,
      "duration_seconds": 1.49,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.86,
      "end_seconds": 252.89,
      "duration_seconds": 1.03,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 261.23,
      "duration_seconds": 6.41,
      "text": "Yes, an enlarged prostate and diabetes are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 262.28,
      "end_seconds": 274.13,
      "duration_seconds": 11.85,
      "text": "Doctor, I've got the readings for you. Saturation 99 percent, respiratory rate 16, temperature is 36.5 degrees, blood pressure 120 over 71, pulse 71."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.07,
      "end_seconds": 276.56,
      "duration_seconds": 1.49,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.35,
      "end_seconds": 280.51,
      "duration_seconds": 2.16,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.54,
      "end_seconds": 284.35,
      "duration_seconds": 1.81,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.6,
      "end_seconds": 288.01,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.4,
      "end_seconds": 309.4,
      "duration_seconds": 8.0,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.37,
      "end_seconds": 325.28,
      "duration_seconds": 9.91,
      "text": "Okay, that's enough for me. Having listened and examined, the most likely explanation is Bell's palsy. I'd also keep a stroke in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.22,
      "end_seconds": 327.66,
      "duration_seconds": 1.44,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.34,
      "end_seconds": 349.45,
      "duration_seconds": 19.11,
      "text": "I understand the worry. At the moment I'd say it's Bell's palsy, and we'll watch how it goes. Just to be sure I understood. You've had your face drooping on the right for three days, mild, and no slurred speech or rash in the ear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.97,
      "end_seconds": 356.95,
      "duration_seconds": 2.98,
      "text": "Uh, yes, you've got it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.56,
      "end_seconds": 379.39,
      "duration_seconds": 20.83,
      "text": "Use eye drops and tape the eye shut at night to protect it. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 381.26,
      "end_seconds": 384.5,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    }
  ]
}