{
  "schema_version": "1.0",
  "encounter_id": "02201",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 7.47,
      "duration_seconds": 6.38,
      "text": "Ah, you know, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 11.95,
      "duration_seconds": 3.62,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.12,
      "end_seconds": 21.75,
      "duration_seconds": 8.63,
      "text": "So, I've been getting out of breath, doctor. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.83,
      "end_seconds": 26.2,
      "duration_seconds": 3.37,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.71,
      "end_seconds": 34.04,
      "duration_seconds": 3.33,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.82,
      "end_seconds": 38.14,
      "duration_seconds": 3.32,
      "text": "right, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.0,
      "end_seconds": 47.8,
      "duration_seconds": 8.8,
      "text": "it happens every other day. Okay, so I've also had green phlegm lately, for six months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.65,
      "end_seconds": 54.58,
      "duration_seconds": 4.93,
      "text": "Have you been getting out of breath at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.53,
      "end_seconds": 63.34,
      "duration_seconds": 7.81,
      "text": "Yeah, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 74.29,
      "duration_seconds": 2.4,
      "text": "Any fever or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 79.95,
      "duration_seconds": 3.91,
      "text": "Yeah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.6,
      "end_seconds": 85.49,
      "duration_seconds": 3.89,
      "text": "alright, any chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.57,
      "end_seconds": 92.45,
      "duration_seconds": 5.88,
      "text": "I, I haven't had chest pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.22,
      "end_seconds": 97.53,
      "duration_seconds": 4.31,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.47,
      "end_seconds": 100.55,
      "duration_seconds": 2.08,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.12,
      "end_seconds": 105.82,
      "duration_seconds": 3.7,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.04,
      "end_seconds": 111.69,
      "duration_seconds": 4.65,
      "text": "Hmm, um, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.88,
      "end_seconds": 114.84,
      "duration_seconds": 1.96,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.7,
      "end_seconds": 119.58,
      "duration_seconds": 3.88,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.33,
      "end_seconds": 122.81,
      "duration_seconds": 2.48,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.42,
      "end_seconds": 128.22,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.91,
      "end_seconds": 143.87,
      "duration_seconds": 3.96,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.07,
      "end_seconds": 147.76,
      "duration_seconds": 2.69,
      "text": "Epilepsy, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.56,
      "end_seconds": 156.69,
      "duration_seconds": 8.13,
      "text": "Yes, epilepsy is known to us, good to have that clear. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.7,
      "end_seconds": 164.1,
      "duration_seconds": 4.4,
      "text": "I take levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.64,
      "end_seconds": 168.04,
      "duration_seconds": 3.4,
      "text": "I follow have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.61,
      "end_seconds": 174.13,
      "duration_seconds": 4.52,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.74,
      "end_seconds": 178.53,
      "duration_seconds": 3.79,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.15,
      "end_seconds": 189.1,
      "duration_seconds": 2.95,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 214.24,
      "duration_seconds": 10.81,
      "text": "okay: SpO2 98 percent on room air, pulse is 82 beats a minute, blood pressure 111 over 77, temperature is 36.9 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.73,
      "end_seconds": 217.81,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.4,
      "end_seconds": 220.84,
      "duration_seconds": 2.44,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.16,
      "end_seconds": 224.64,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.75,
      "end_seconds": 227.35,
      "duration_seconds": 1.6,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 230.63,
      "duration_seconds": 1.28,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 245.74,
      "duration_seconds": 6.41,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 264.52,
      "duration_seconds": 13.78,
      "text": "okay, that's enough for me putting it all together, it points towards a flare of bronchiectasis i want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.89,
      "end_seconds": 268.96,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.46,
      "end_seconds": 278.31,
      "duration_seconds": 7.85,
      "text": "I can't promise yet, but most people with a flare of bronchiectasis do well once it's treated properly"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.22,
      "end_seconds": 302.47,
      "duration_seconds": 7.25,
      "text": "I'll request a chest X-ray, it'll help with bronchiectasis flare. Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.52,
      "end_seconds": 307.2,
      "duration_seconds": 2.68,
      "text": "Yeah, that's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.88,
      "end_seconds": 315.62,
      "duration_seconds": 7.74,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.12,
      "end_seconds": 321.21,
      "duration_seconds": 5.09,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.44,
      "end_seconds": 326.53,
      "duration_seconds": 4.09,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.07,
      "end_seconds": 330.21,
      "duration_seconds": 3.14,
      "text": "no, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.87,
      "end_seconds": 332.79,
      "duration_seconds": 1.92,
      "text": "So, goodbye for now."
    }
  ]
}