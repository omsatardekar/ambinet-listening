{
  "schema_version": "1.0",
  "encounter_id": "02375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 2.84,
      "duration_seconds": 2.08,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.9,
      "end_seconds": 5.97,
      "duration_seconds": 1.07,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.8,
      "end_seconds": 10.77,
      "duration_seconds": 2.97,
      "text": "Okay, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.99,
      "end_seconds": 18.65,
      "duration_seconds": 6.66,
      "text": "Actually, doctor, it's sudden confusion over a day. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 21.09,
      "duration_seconds": 1.8,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.33,
      "end_seconds": 29.6,
      "duration_seconds": 7.27,
      "text": "About... well, six months. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.66,
      "end_seconds": 35.33,
      "duration_seconds": 3.67,
      "text": "Has there been not knowing where she is too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.91,
      "end_seconds": 39.98,
      "duration_seconds": 4.07,
      "text": "Yeah. About a month, uh, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.61,
      "end_seconds": 46.25,
      "duration_seconds": 4.64,
      "text": "And what about chest pain or weakness on one side?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.17,
      "end_seconds": 52.22,
      "duration_seconds": 5.05,
      "text": "No, no chest pain or weakness on one side."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.01,
      "end_seconds": 57.26,
      "duration_seconds": 3.25,
      "text": "And what about head injury or fall?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.23,
      "end_seconds": 61.11,
      "duration_seconds": 2.88,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.61,
      "end_seconds": 65.7,
      "duration_seconds": 3.09,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.78,
      "end_seconds": 70.25,
      "duration_seconds": 2.47,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.45,
      "end_seconds": 89.11,
      "duration_seconds": 2.66,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.94,
      "end_seconds": 93.11,
      "duration_seconds": 2.17,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.34,
      "end_seconds": 105.56,
      "duration_seconds": 3.22,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.96,
      "end_seconds": 112.67,
      "duration_seconds": 5.71,
      "text": "It's something called telm... telmisartan, 40 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.54,
      "end_seconds": 118.63,
      "duration_seconds": 4.09,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.23,
      "end_seconds": 121.55,
      "duration_seconds": 2.32,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.53,
      "end_seconds": 127.65,
      "duration_seconds": 5.12,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.58,
      "end_seconds": 132.9,
      "duration_seconds": 3.32,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.0,
      "end_seconds": 135.47,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.42,
      "end_seconds": 139.21,
      "duration_seconds": 1.79,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.26,
      "end_seconds": 146.27,
      "duration_seconds": 5.01,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.16,
      "end_seconds": 159.58,
      "duration_seconds": 12.42,
      "text": "I'm a bus driver, so I sit for long hours. I hardly move around during the day. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.07,
      "end_seconds": 168.52,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.42,
      "end_seconds": 184.06,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.68,
      "end_seconds": 206.51,
      "duration_seconds": 5.83,
      "text": "Okay: pulse 96, BP is 106 over 76, temperature is 39.1 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.64,
      "end_seconds": 211.62,
      "duration_seconds": 3.98,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.73,
      "end_seconds": 215.57,
      "duration_seconds": 2.84,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.2,
      "end_seconds": 237.46,
      "duration_seconds": 5.26,
      "text": "She is drowsy, hot, disoriented, and her blood pressure is low."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.44,
      "end_seconds": 245.22,
      "duration_seconds": 2.78,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 270.77,
      "duration_seconds": 17.46,
      "text": "Putting it all together, it fits best with delirium from an infection. Just to be sure I understood. You've had sudden confusion over a day for six months, and no fall or weakness on one side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.26,
      "end_seconds": 273.95,
      "duration_seconds": 1.69,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 287.79,
      "duration_seconds": 13.07,
      "text": "We should do a chest X-ray for fever and confusion. She needs to go to hospital today for fluids and antibiotics. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.56,
      "end_seconds": 291.18,
      "duration_seconds": 1.62,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.75,
      "end_seconds": 304.93,
      "duration_seconds": 12.18,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.45,
      "end_seconds": 307.55,
      "duration_seconds": 2.1,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.33,
      "end_seconds": 313.1,
      "duration_seconds": 4.77,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.92,
      "end_seconds": 320.9,
      "duration_seconds": 2.98,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.17,
      "end_seconds": 327.58,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}