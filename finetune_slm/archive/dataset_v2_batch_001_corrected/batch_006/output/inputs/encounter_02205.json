{
  "schema_version": "1.0",
  "encounter_id": "02205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.19,
      "end_seconds": 5.47,
      "duration_seconds": 4.28,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 9.4,
      "duration_seconds": 3.0,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 16.49,
      "duration_seconds": 5.77,
      "text": "Doctor, you know, it's constant worrying. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 22.03,
      "duration_seconds": 2.28,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.04,
      "end_seconds": 31.46,
      "duration_seconds": 8.42,
      "text": "I mean, I take something called esci... escitalopram, 10 milligrams, maybe, once a day for my mood"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.96,
      "end_seconds": 36.9,
      "duration_seconds": 3.94,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.27,
      "end_seconds": 42.92,
      "duration_seconds": 4.65,
      "text": "No, it's at home. Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.79,
      "end_seconds": 46.92,
      "duration_seconds": 3.13,
      "text": "How long has it it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.65,
      "end_seconds": 55.3,
      "duration_seconds": 3.65,
      "text": "It's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.72,
      "end_seconds": 64.01,
      "duration_seconds": 4.29,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 69.65,
      "duration_seconds": 4.49,
      "text": "Right, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.17,
      "end_seconds": 70.87,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 77.06,
      "duration_seconds": 5.75,
      "text": "I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 77.16,
      "end_seconds": 84.23,
      "duration_seconds": 7.07,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.14,
      "end_seconds": 90.84,
      "duration_seconds": 4.7,
      "text": "Later, thanks. Please go on. Has there been trouble sleeping too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.45,
      "end_seconds": 96.45,
      "duration_seconds": 5.0,
      "text": "sorry, what was I saying, yes, for one week"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.43,
      "end_seconds": 101.27,
      "duration_seconds": 2.84,
      "text": "Have you been feeling on edge?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 108.97,
      "duration_seconds": 4.66,
      "text": "uh, yes, about the same, about a week"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.01,
      "end_seconds": 115.44,
      "duration_seconds": 5.43,
      "text": "Have you had constant worrying before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 124.37,
      "duration_seconds": 7.6,
      "text": "I, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 125.0,
      "end_seconds": 127.16,
      "duration_seconds": 2.16,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.24,
      "end_seconds": 133.43,
      "duration_seconds": 4.19,
      "text": "Any drinking more, weight loss or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.65,
      "end_seconds": 149.72,
      "duration_seconds": 15.07,
      "text": "No, no drinking more, no weight loss, no thoughts of harming myself. I did have a tight chest at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.81,
      "end_seconds": 152.85,
      "duration_seconds": 2.04,
      "text": "Any chest pain on exertion?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.71,
      "end_seconds": 156.94,
      "duration_seconds": 3.23,
      "text": "definitely no chest pain on exertion"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.61,
      "end_seconds": 164.28,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.62,
      "end_seconds": 166.71,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.53,
      "end_seconds": 170.05,
      "duration_seconds": 2.52,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 174.48,
      "duration_seconds": 2.71,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.05,
      "end_seconds": 180.33,
      "duration_seconds": 5.28,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.39,
      "end_seconds": 187.84,
      "duration_seconds": 3.45,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.81,
      "end_seconds": 189.65,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.19,
      "end_seconds": 195.04,
      "duration_seconds": 3.85,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.5,
      "end_seconds": 199.14,
      "duration_seconds": 2.64,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.61,
      "end_seconds": 206.36,
      "duration_seconds": 3.75,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.12,
      "end_seconds": 221.44,
      "duration_seconds": 2.32,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.26,
      "end_seconds": 227.29,
      "duration_seconds": 5.03,
      "text": "I have depression. Yes, asthma. High cholesterol, for five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.46,
      "end_seconds": 238.4,
      "duration_seconds": 9.94,
      "text": "Right, so depression and asthma are already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.39,
      "end_seconds": 242.66,
      "duration_seconds": 2.27,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 243.53,
      "end_seconds": 254.0,
      "duration_seconds": 10.47,
      "text": "Here are the the numbers, doctor. Respiratory rate 15, SpO2 99 percent on room air, BP is 115 over 80, pulse 80."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.25,
      "end_seconds": 265.48,
      "duration_seconds": 10.23,
      "text": "Thanks. Let me tell you where I've got to. This is probably generalised anxiety. An overactive thyroid is also on my list."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.05,
      "end_seconds": 270.65,
      "duration_seconds": 3.6,
      "text": "Uh, is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.22,
      "end_seconds": 292.26,
      "duration_seconds": 21.04,
      "text": "I understand the worry. At the moment I'd say it's generalised anxiety, and we'll know more once the a thyroid test is back. Just to be sure I understood. You've had constant worrying for three weeks, and no thoughts of harming myself or chest pain on exertion."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.08,
      "end_seconds": 295.13,
      "duration_seconds": 2.05,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.63,
      "end_seconds": 307.01,
      "duration_seconds": 4.38,
      "text": "We should do a thyroid test for anxiety symptoms."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.94,
      "end_seconds": 311.73,
      "duration_seconds": 2.79,
      "text": "the earliest is Thursday, 3:30 pm"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.71,
      "end_seconds": 333.13,
      "duration_seconds": 19.42,
      "text": "Try slow breathing and regular exercise, and limit caffeine. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.21,
      "end_seconds": 341.19,
      "duration_seconds": 3.98,
      "text": "okay, that makes sense. Thanks for explaining"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.77,
      "end_seconds": 343.22,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}