{
  "schema_version": "1.0",
  "encounter_id": "02403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.64,
      "duration_seconds": 3.42,
      "text": "morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.83,
      "duration_seconds": 4.86,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.68,
      "end_seconds": 18.78,
      "duration_seconds": 6.1,
      "text": "I've been dealing with severe pain in the lower leg after a fracture"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 24.11,
      "duration_seconds": 3.39,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.05,
      "end_seconds": 28.86,
      "duration_seconds": 2.81,
      "text": "For two months I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 31.36,
      "duration_seconds": 1.76,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.32,
      "end_seconds": 36.26,
      "duration_seconds": 2.94,
      "text": "Passive movement definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.22,
      "end_seconds": 51.45,
      "duration_seconds": 3.23,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.14,
      "end_seconds": 65.71,
      "duration_seconds": 2.57,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.98,
      "end_seconds": 82.91,
      "duration_seconds": 7.93,
      "text": "Okay: respiratory rate 15, pulse 84. And BP is 120 over 81, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.2,
      "end_seconds": 86.2,
      "duration_seconds": 2.0,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.87,
      "end_seconds": 89.14,
      "duration_seconds": 1.27,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.26,
      "end_seconds": 106.69,
      "duration_seconds": 6.43,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.1,
      "end_seconds": 114.07,
      "duration_seconds": 2.97,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.18,
      "end_seconds": 128.37,
      "duration_seconds": 4.19,
      "text": "A few quick ones: wound infection, chest pain or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.03,
      "end_seconds": 131.7,
      "duration_seconds": 2.67,
      "text": "nope nothing like that that"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.72,
      "end_seconds": 135.8,
      "duration_seconds": 2.08,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.06,
      "end_seconds": 140.41,
      "duration_seconds": 3.35,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.32,
      "end_seconds": 163.3,
      "duration_seconds": 3.98,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.34,
      "end_seconds": 168.66,
      "duration_seconds": 3.32,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.54,
      "end_seconds": 188.35,
      "duration_seconds": 2.81,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.45,
      "end_seconds": 192.32,
      "duration_seconds": 2.87,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.07,
      "end_seconds": 195.81,
      "duration_seconds": 2.74,
      "text": "have you been to to theatre before?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.72,
      "end_seconds": 202.82,
      "duration_seconds": 6.1,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 209.14,
      "duration_seconds": 4.29,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.2,
      "end_seconds": 222.52,
      "duration_seconds": 11.32,
      "text": "I used to drink heavily but I stopped four years ago. Lots of rice, lentils and some fruit. I swim twice a week"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.44,
      "end_seconds": 228.44,
      "duration_seconds": 4.0,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.18,
      "end_seconds": 233.38,
      "duration_seconds": 4.2,
      "text": "Okay so so my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 236.72,
      "duration_seconds": 2.78,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.82,
      "end_seconds": 240.08,
      "duration_seconds": 2.26,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.85,
      "end_seconds": 261.36,
      "duration_seconds": 20.51,
      "text": "putting it all together I think we're dealing with possible compartment syndrome needing urgent surgery at this stage. I'm sending you for measuring the pressure in the leg because of possible compartment syndrome. The result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.03,
      "end_seconds": 265.81,
      "duration_seconds": 2.78,
      "text": "Mm, okay, I'll do it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.54,
      "end_seconds": 275.39,
      "duration_seconds": 8.85,
      "text": "remove the cast now, you are going to theatre for a decompression. I think the orthopaedic team should see you too"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.84,
      "end_seconds": 279.24,
      "duration_seconds": 2.4,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.25,
      "end_seconds": 295.51,
      "duration_seconds": 12.26,
      "text": "come back or go to emergency straight away if the symptoms get worse i'd like you back straight away is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.34,
      "end_seconds": 302.11,
      "duration_seconds": 2.77,
      "text": "I think I understand everything. Thanks."
    }
  ]
}