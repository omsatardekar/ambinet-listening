{
  "schema_version": "1.0",
  "encounter_id": "02111",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.07,
      "duration_seconds": 3.28,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.33,
      "end_seconds": 10.25,
      "duration_seconds": 4.92,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.76,
      "end_seconds": 17.73,
      "duration_seconds": 5.97,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.48,
      "end_seconds": 22.41,
      "duration_seconds": 3.93,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.44,
      "end_seconds": 30.9,
      "duration_seconds": 6.46,
      "text": "I'm here because of sudden severe pain on the right side of my pelvis."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.54,
      "end_seconds": 34.49,
      "duration_seconds": 2.95,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.97,
      "end_seconds": 44.34,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.88,
      "end_seconds": 66.71,
      "duration_seconds": 8.83,
      "text": "Okay: temperature is 36.9 degrees, pressure 120 over 72, heart rate 104. And oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.28,
      "end_seconds": 69.94,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.93,
      "end_seconds": 77.4,
      "duration_seconds": 6.47,
      "text": "They help me see the whole picture, more shortly. How long has it been like this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.96,
      "end_seconds": 82.35,
      "duration_seconds": 4.39,
      "text": "Let me think, about a week, give or take."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 84.76,
      "end_seconds": 89.08,
      "duration_seconds": 4.32,
      "text": "Um, hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.58,
      "end_seconds": 95.14,
      "duration_seconds": 4.56,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.36,
      "end_seconds": 99.6,
      "duration_seconds": 1.24,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 103.27,
      "duration_seconds": 2.31,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 108.14,
      "duration_seconds": 3.12,
      "text": "Yes, movement. That makes it worse."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.47,
      "end_seconds": 115.29,
      "duration_seconds": 5.82,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.81,
      "end_seconds": 119.48,
      "duration_seconds": 2.67,
      "text": "It's, It's on and off."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.01,
      "end_seconds": 129.27,
      "duration_seconds": 9.26,
      "text": "Let me think, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 129.37,
      "end_seconds": 134.22,
      "duration_seconds": 4.85,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.84,
      "end_seconds": 137.34,
      "duration_seconds": 2.5,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.21,
      "end_seconds": 143.29,
      "duration_seconds": 4.08,
      "text": "Has there been pain that comes in waves too?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.26,
      "end_seconds": 148.7,
      "duration_seconds": 3.44,
      "text": "Let me think, yes, for five days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.44,
      "end_seconds": 155.15,
      "duration_seconds": 5.71,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.22,
      "end_seconds": 159.03,
      "duration_seconds": 2.81,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.76,
      "end_seconds": 161.81,
      "duration_seconds": 2.05,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.72,
      "end_seconds": 165.1,
      "duration_seconds": 2.38,
      "text": "Yes, for ten days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.5,
      "end_seconds": 173.58,
      "duration_seconds": 3.08,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.92,
      "end_seconds": 182.8,
      "duration_seconds": 7.88,
      "text": "Well, um, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.02,
      "end_seconds": 189.06,
      "duration_seconds": 5.04,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.63,
      "end_seconds": 192.84,
      "duration_seconds": 3.21,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.94,
      "end_seconds": 197.67,
      "duration_seconds": 3.73,
      "text": "Did you get missed period, vaginal bleeding or fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.65,
      "end_seconds": 203.85,
      "duration_seconds": 5.2,
      "text": "No missed period, vaginal bleeding or fever, none of it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.44,
      "end_seconds": 205.91,
      "duration_seconds": 1.47,
      "text": "How about discharge?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.43,
      "end_seconds": 207.98,
      "duration_seconds": 1.55,
      "text": "Definitely no discharge."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.84,
      "end_seconds": 212.29,
      "duration_seconds": 3.45,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.62,
      "end_seconds": 215.68,
      "duration_seconds": 2.06,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.58,
      "end_seconds": 218.36,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.86,
      "end_seconds": 226.26,
      "duration_seconds": 3.4,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.79,
      "end_seconds": 228.98,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.13,
      "end_seconds": 237.32,
      "duration_seconds": 3.19,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.72,
      "end_seconds": 240.19,
      "duration_seconds": 1.47,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.73,
      "end_seconds": 243.59,
      "duration_seconds": 2.86,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.34,
      "end_seconds": 247.45,
      "duration_seconds": 2.11,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.38,
      "end_seconds": 255.29,
      "duration_seconds": 5.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.85,
      "end_seconds": 266.99,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.28,
      "end_seconds": 275.13,
      "duration_seconds": 3.85,
      "text": "Carvedilol, 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 276.02,
      "end_seconds": 283.74,
      "duration_seconds": 7.72,
      "text": "Mm, she is supposed to take it twice a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.52,
      "end_seconds": 290.51,
      "duration_seconds": 4.99,
      "text": "Actually, I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.08,
      "end_seconds": 303.25,
      "duration_seconds": 11.17,
      "text": "Sorry, what was I saying, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 307.97,
      "duration_seconds": 2.81,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.61,
      "end_seconds": 327.44,
      "duration_seconds": 15.83,
      "text": "Actually, for the anxiety, I believe. My wife sets them out for me, I just take what I'm given. I, I take propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.83,
      "end_seconds": 328.79,
      "duration_seconds": 0.96,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.8,
      "end_seconds": 334.41,
      "duration_seconds": 4.61,
      "text": "I used to take sumatriptan, but I stopped it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.45,
      "end_seconds": 338.62,
      "duration_seconds": 3.17,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.25,
      "end_seconds": 344.15,
      "duration_seconds": 4.9,
      "text": "My grandfather had a stroke. Ah, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.48,
      "end_seconds": 347.64,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.83,
      "end_seconds": 356.66,
      "duration_seconds": 7.83,
      "text": "I have heart failure, for about a year. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.4,
      "end_seconds": 359.31,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.4,
      "end_seconds": 363.09,
      "duration_seconds": 2.69,
      "text": "I have eczema. I've got anxiety."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.64,
      "end_seconds": 366.03,
      "duration_seconds": 1.39,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.86,
      "end_seconds": 368.48,
      "duration_seconds": 1.62,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.95,
      "end_seconds": 381.97,
      "duration_seconds": 8.02,
      "text": "Right, so heart failure and eczema are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.36,
      "end_seconds": 397.15,
      "duration_seconds": 6.79,
      "text": "Any allergies to tablets, food or anything in the environment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.7,
      "end_seconds": 406.04,
      "duration_seconds": 8.34,
      "text": "I'm allergic to tramadol, I get vomiting. I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.81,
      "end_seconds": 412.66,
      "duration_seconds": 4.85,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.35,
      "end_seconds": 416.31,
      "duration_seconds": 1.96,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.53,
      "end_seconds": 440.66,
      "duration_seconds": 6.13,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.93,
      "end_seconds": 461.8,
      "duration_seconds": 15.87,
      "text": "That's all I needed to check. Okay, so my impression is this: It's hard to say. Possible ovarian torsion is one possibility and a ruptured cyst another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 463.7,
      "end_seconds": 466.62,
      "duration_seconds": 2.92,
      "text": "Uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.54,
      "end_seconds": 494.06,
      "duration_seconds": 26.52,
      "text": "Nothing I've seen today points to an emergency. It looks like possible ovarian torsion, but I'd like to confirm. We should do an urgent pelvic ultrasound for possible torsion. We should do a pregnancy test for pelvic pain. You need an emergency scan and probably surgery today. I think the gynaecology team should see you too."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 495.83,
      "end_seconds": 497.59,
      "duration_seconds": 1.76,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 499.03,
      "end_seconds": 507.86,
      "duration_seconds": 8.83,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 508.94,
      "end_seconds": 512.07,
      "duration_seconds": 3.13,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 513.87,
      "end_seconds": 517.63,
      "duration_seconds": 3.76,
      "text": "So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 519.14,
      "end_seconds": 522.72,
      "duration_seconds": 3.58,
      "text": "Actually, no, that's all. Thanks a lot."
    }
  ]
}