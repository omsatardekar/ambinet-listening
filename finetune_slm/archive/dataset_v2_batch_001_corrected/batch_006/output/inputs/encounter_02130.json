{
  "schema_version": "1.0",
  "encounter_id": "02130",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 3.46,
      "duration_seconds": 2.46,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.38,
      "end_seconds": 9.19,
      "duration_seconds": 3.81,
      "text": "Um, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.12,
      "end_seconds": 12.56,
      "duration_seconds": 1.44,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.43,
      "end_seconds": 24.43,
      "duration_seconds": 7.0,
      "text": "Yeah, I've been coughing up pink frothy sputum, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.9,
      "end_seconds": 28.86,
      "duration_seconds": 2.96,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.14,
      "end_seconds": 33.97,
      "duration_seconds": 3.83,
      "text": "It's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.18,
      "end_seconds": 43.95,
      "duration_seconds": 9.77,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.85,
      "end_seconds": 48.76,
      "duration_seconds": 3.91,
      "text": "Mostly moderate. I'd say on and off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.05,
      "end_seconds": 53.46,
      "duration_seconds": 3.41,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.92,
      "end_seconds": 65.3,
      "duration_seconds": 2.38,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.13,
      "end_seconds": 82.91,
      "duration_seconds": 4.78,
      "text": "okay: pressure 135 over 85, pulse is 99 beats a minute"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.39,
      "end_seconds": 89.07,
      "duration_seconds": 3.68,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.07,
      "end_seconds": 91.3,
      "duration_seconds": 1.23,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.39,
      "end_seconds": 112.7,
      "duration_seconds": 6.31,
      "text": "There are crackles all the way up both lungs and and you are breathing very fast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.82,
      "end_seconds": 117.59,
      "duration_seconds": 1.77,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.77,
      "end_seconds": 132.82,
      "duration_seconds": 4.05,
      "text": "did you get calf pain, fever or wheeze?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.9,
      "end_seconds": 137.45,
      "duration_seconds": 3.55,
      "text": "No, you know, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.34,
      "end_seconds": 141.6,
      "duration_seconds": 3.26,
      "text": "okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.0,
      "end_seconds": 144.42,
      "duration_seconds": 1.42,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.93,
      "end_seconds": 148.58,
      "duration_seconds": 2.65,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.43,
      "end_seconds": 153.92,
      "duration_seconds": 3.49,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.87,
      "end_seconds": 175.97,
      "duration_seconds": 4.1,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.54,
      "end_seconds": 182.8,
      "duration_seconds": 4.26,
      "text": "I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.5,
      "end_seconds": 190.88,
      "duration_seconds": 7.38,
      "text": "mm, okay what do you take on a normal day? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.42,
      "end_seconds": 198.38,
      "duration_seconds": 5.96,
      "text": "Metoprolol. I take it 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.96,
      "end_seconds": 201.39,
      "duration_seconds": 1.43,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.24,
      "end_seconds": 207.29,
      "duration_seconds": 4.05,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.82,
      "end_seconds": 210.09,
      "duration_seconds": 1.27,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.68,
      "end_seconds": 215.13,
      "duration_seconds": 3.45,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.15,
      "end_seconds": 218.41,
      "duration_seconds": 1.26,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.99,
      "end_seconds": 222.69,
      "duration_seconds": 3.7,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.13,
      "end_seconds": 228.63,
      "duration_seconds": 4.5,
      "text": "alright, what does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.21,
      "end_seconds": 233.62,
      "duration_seconds": 3.41,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.97,
      "end_seconds": 248.58,
      "duration_seconds": 3.61,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.93,
      "end_seconds": 252.33,
      "duration_seconds": 2.4,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.21,
      "end_seconds": 287.68,
      "duration_seconds": 17.47,
      "text": "taking everything into account, this looks most like acute pulmonary oedema i think a chest X-ray makes sense here, for pulmonary oedema what I'm giving you is furosemide, 40 milligrams, once now, single dose it's for fluid on the lungs"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.49,
      "end_seconds": 290.28,
      "duration_seconds": 1.79,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.13,
      "end_seconds": 305.29,
      "duration_seconds": 14.16,
      "text": "Sit upright, I am giving oxygen and a water tablet injection now. I'd like you to see the emergency team as well, and I'll write the referral. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.68,
      "end_seconds": 309.75,
      "duration_seconds": 3.07,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.85,
      "end_seconds": 313.13,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
