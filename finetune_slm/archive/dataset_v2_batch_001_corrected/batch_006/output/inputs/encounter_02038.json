      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.77,
      "end_seconds": 28.44,
      "duration_seconds": 2.67,
      "text": "it's been five days now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.9,
      "end_seconds": 32.68,
      "duration_seconds": 3.78,
      "text": "understood how troublesome is it day to day?"
