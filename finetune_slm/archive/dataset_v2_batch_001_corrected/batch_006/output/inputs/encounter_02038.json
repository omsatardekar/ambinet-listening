      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.52,
      "end_seconds": 20.3,
      "duration_seconds": 5.78,
      "text": "I've been feeling sick, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.09,
      "end_seconds": 25.11,
      "duration_seconds": 2.02,
      "text": "okay, since when exactly?"
