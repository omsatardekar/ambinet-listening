{
  "schema_version": "1.0",
  "encounter_id": "02323",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.96,
      "end_seconds": 6.65,
      "duration_seconds": 5.69,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 11.96,
      "duration_seconds": 3.97,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.08,
      "end_seconds": 18.68,
      "duration_seconds": 5.6,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 21.9,
      "duration_seconds": 2.6,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.47,
      "end_seconds": 29.95,
      "duration_seconds": 4.48,
      "text": "Uh, she's been having itchy spots all over, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.03,
      "end_seconds": 35.44,
      "duration_seconds": 3.41,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.3,
      "end_seconds": 47.52,
      "duration_seconds": 11.22,
      "text": "Let me think, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.43,
      "end_seconds": 58.65,
      "duration_seconds": 9.22,
      "text": "Okay, give me more detail on it, whatever comes to mind. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.74,
      "end_seconds": 71.99,
      "duration_seconds": 11.25,
      "text": "I mean, mostly mild. Honestly, on and off. I get some relief from calamine. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.59,
      "end_seconds": 76.1,
      "duration_seconds": 2.51,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.51,
      "end_seconds": 81.22,
      "duration_seconds": 3.71,
      "text": "Oh, it usually comes with a mild temperature."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.97,
      "end_seconds": 85.61,
      "duration_seconds": 3.64,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.5,
      "end_seconds": 96.69,
      "duration_seconds": 10.19,
      "text": "It's mild, honestly. I've been feeling achy too. With feeling achy, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 100.05,
      "duration_seconds": 2.34,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.14,
      "end_seconds": 107.11,
      "duration_seconds": 5.97,
      "text": "Mm, I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 127.84,
      "duration_seconds": 4.2,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 129.1,
      "end_seconds": 138.78,
      "duration_seconds": 9.68,
      "text": "She is on lansoprazole, 30 milligrams, before breakfast, I give it to her. It's calamine lotion, when needed, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.0,
      "end_seconds": 148.69,
      "duration_seconds": 1.69,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.61,
      "end_seconds": 153.26,
      "duration_seconds": 3.65,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.91,
      "end_seconds": 156.59,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 161.29,
      "duration_seconds": 3.58,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.1,
      "end_seconds": 176.82,
      "duration_seconds": 4.72,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.31,
      "end_seconds": 182.48,
      "duration_seconds": 4.17,
      "text": "Erm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 185.45,
      "end_seconds": 194.08,
      "duration_seconds": 8.63,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.21,
      "end_seconds": 198.06,
      "duration_seconds": 2.85,
      "text": "Erm, really? I don't think so."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.8,
      "end_seconds": 206.28,
      "duration_seconds": 7.48,
      "text": "Okay, I'll note both of those. What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.66,
      "end_seconds": 216.09,
      "duration_seconds": 3.43,
      "text": "Mm, I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.72,
      "end_seconds": 227.77,
      "duration_seconds": 10.05,
      "text": "Mm-hmm. Right, so acid reflux is already on your record. We'll keep that in mind today. And what about stiff neck or being immunosuppressed?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.4,
      "end_seconds": 233.18,
      "duration_seconds": 4.78,
      "text": "No stiff neck or being immunosuppressed, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.11,
      "end_seconds": 237.98,
      "duration_seconds": 2.87,
      "text": "Any pregnancy or breathlessness at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.68,
      "end_seconds": 242.06,
      "duration_seconds": 2.38,
      "text": "No, no pregnancy or breathlessness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.45,
      "end_seconds": 245.77,
      "duration_seconds": 2.32,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.34,
      "end_seconds": 250.81,
      "duration_seconds": 3.47,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 251.35,
      "end_seconds": 260.4,
      "duration_seconds": 9.05,
      "text": "Okay, so the vitals from earlier. BP is 108 over 71, pulse is 67 beats a minute, saturation 97 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.35,
      "end_seconds": 262.9,
      "duration_seconds": 1.55,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.7,
      "end_seconds": 266.92,
      "duration_seconds": 2.22,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.31,
      "end_seconds": 269.49,
      "duration_seconds": 1.18,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.65,
      "end_seconds": 290.97,
      "duration_seconds": 5.32,
      "text": "There are crops of blisters and scabs in different stages on the trunk."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.54,
      "end_seconds": 313.93,
      "duration_seconds": 20.39,
      "text": "That's all I needed to check. So where does that leave us? This looks most like chickenpox. That's my thinking for now, and it may change as we learn more. I'd also keep shingles in mind. There's nothing new for me to start or arrange today. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.07,
      "end_seconds": 316.88,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}