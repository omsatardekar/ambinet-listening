{
  "schema_version": "1.0",
  "encounter_id": "02443",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 5.46,
      "duration_seconds": 4.88,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 10.38,
      "duration_seconds": 4.37,
      "text": "not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 16.31,
      "duration_seconds": 4.95,
      "text": "I'm here because of cramping in my calves when I walk"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.22,
      "end_seconds": 21.26,
      "duration_seconds": 3.04,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.12,
      "end_seconds": 29.14,
      "duration_seconds": 2.02,
      "text": "about... well, one week"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.94,
      "end_seconds": 35.89,
      "duration_seconds": 4.95,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.79,
      "end_seconds": 47.49,
      "duration_seconds": 10.7,
      "text": "It feels severe to me. It's every other day. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.46,
      "end_seconds": 52.53,
      "duration_seconds": 4.07,
      "text": "Have you had back pain, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.29,
      "end_seconds": 55.23,
      "duration_seconds": 1.94,
      "text": "Definitely no back pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.47,
      "end_seconds": 60.84,
      "duration_seconds": 4.37,
      "text": "and what about chest pain, pain at rest or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.79,
      "end_seconds": 68.91,
      "duration_seconds": 6.12,
      "text": "I haven't had chest pain, pain at rest or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.77,
      "end_seconds": 74.06,
      "duration_seconds": 3.29,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.05,
      "end_seconds": 76.1,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.76,
      "end_seconds": 86.99,
      "duration_seconds": 3.23,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.86,
      "end_seconds": 99.11,
      "duration_seconds": 11.25,
      "text": "I, I take simvastatin, 20 milligrams, at night for my cholesterol. I'm on gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.01,
      "end_seconds": 117.35,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.54,
      "end_seconds": 125.41,
      "duration_seconds": 6.87,
      "text": "Erm, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.02,
      "end_seconds": 138.39,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.99,
      "end_seconds": 157.81,
      "duration_seconds": 17.82,
      "text": "Hmm, I have high cholesterol, for two years. I've had diabetes, yes. Work has been very busy so I kept ignoring it. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.31,
      "end_seconds": 168.9,
      "duration_seconds": 9.59,
      "text": "Okay, I can see high cholesterol and diabetes in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.27,
      "end_seconds": 172.17,
      "duration_seconds": 1.9,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.52,
      "end_seconds": 175.45,
      "duration_seconds": 1.93,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.86,
      "end_seconds": 181.21,
      "duration_seconds": 4.35,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 183.94,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.41,
      "end_seconds": 189.36,
      "duration_seconds": 3.95,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.66,
      "end_seconds": 194.35,
      "duration_seconds": 3.69,
      "text": "I'll just record a a few vital signs"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.9,
      "end_seconds": 203.3,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.73,
      "end_seconds": 225.37,
      "duration_seconds": 8.64,
      "text": "okay: saturation 97 percent, blood pressure 109 over 73, temperature is 36.8 degrees and pulse is 75 beats a minute"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 233.17,
      "duration_seconds": 4.93,
      "text": "I'll examine you in a a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.39,
      "end_seconds": 235.71,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.38,
      "end_seconds": 251.74,
      "duration_seconds": 7.36,
      "text": "the pulses at the left foot are absent and the foot is cool and shiny"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.47,
      "end_seconds": 258.95,
      "duration_seconds": 2.48,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.03,
      "end_seconds": 277.09,
      "duration_seconds": 11.06,
      "text": "Let me tell you where I've got to. I don't have a clear answer today: peripheral arterial disease is possible, and so is a nerve problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.82,
      "end_seconds": 280.16,
      "duration_seconds": 1.34,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.28,
      "end_seconds": 295.64,
      "duration_seconds": 14.36,
      "text": "Nothing I've seen today points to an emergency. It looks like peripheral arterial disease, but I'd like to confirm. I'll request a cholesterol test, it'll help with arterial disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 296.32,
      "end_seconds": 300.81,
      "duration_seconds": 4.49,
      "text": "we have a slot Tuesday at 3:30 pm, if that works"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.82,
      "end_seconds": 303.78,
      "duration_seconds": 1.96,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.14,
      "end_seconds": 315.0,
      "duration_seconds": 9.86,
      "text": "I'd like you to take clopidogrel, 75 milligrams, once a day, long term. You take it by mouth. It's for arterial disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.01,
      "end_seconds": 318.77,
      "duration_seconds": 2.76,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.22,
      "end_seconds": 323.9,
      "duration_seconds": 3.68,
      "text": "I think the vascular clinic should see you too."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.5,
      "end_seconds": 326.2,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.27,
      "end_seconds": 340.64,
      "duration_seconds": 12.37,
      "text": "come back or go to emergency straight away if the symptoms get worse please come and see me in four weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.53,
      "end_seconds": 343.64,
      "duration_seconds": 2.11,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.64,
      "end_seconds": 347.0,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}