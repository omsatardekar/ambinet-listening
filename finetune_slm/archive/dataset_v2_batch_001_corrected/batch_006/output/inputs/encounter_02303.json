{
  "schema_version": "1.0",
  "encounter_id": "02303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 6.29,
      "duration_seconds": 5.31,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.65,
      "end_seconds": 12.03,
      "duration_seconds": 4.38,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.52,
      "end_seconds": 18.27,
      "duration_seconds": 4.75,
      "text": "So, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 22.75,
      "duration_seconds": 2.87,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.1,
      "end_seconds": 27.53,
      "duration_seconds": 3.43,
      "text": "We came because of not hearing very well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.11,
      "end_seconds": 33.41,
      "duration_seconds": 4.3,
      "text": "Alright, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.22,
      "end_seconds": 40.02,
      "duration_seconds": 4.8,
      "text": "It's Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.97,
      "end_seconds": 49.93,
      "duration_seconds": 7.96,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.25,
      "end_seconds": 57.6,
      "duration_seconds": 2.35,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.0,
      "end_seconds": 77.87,
      "duration_seconds": 15.87,
      "text": "For my acidity, I believe. My daughter sets them out for me, I just take what I'm given. Let me think, it's sertraline, 50 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.72,
      "end_seconds": 81.94,
      "duration_seconds": 3.22,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.34,
      "end_seconds": 86.45,
      "duration_seconds": 3.11,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.33,
      "end_seconds": 90.94,
      "duration_seconds": 3.61,
      "text": "Hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.82,
      "end_seconds": 95.88,
      "duration_seconds": 4.06,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.42,
      "end_seconds": 97.58,
      "duration_seconds": 1.16,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.72,
      "end_seconds": 101.57,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.91,
      "end_seconds": 103.99,
      "duration_seconds": 1.08,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.81,
      "end_seconds": 111.3,
      "duration_seconds": 6.49,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 111.4,
      "end_seconds": 118.02,
      "duration_seconds": 6.62,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.7,
      "end_seconds": 121.27,
      "duration_seconds": 2.57,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.04,
      "end_seconds": 129.82,
      "duration_seconds": 6.78,
      "text": "And, And there's a cold that won't go as well, one week now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.11,
      "end_seconds": 134.35,
      "duration_seconds": 3.24,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.85,
      "end_seconds": 140.96,
      "duration_seconds": 1.11,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.12,
      "end_seconds": 155.64,
      "duration_seconds": 2.52,
      "text": "Any dizziness, fever or discharge?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.31,
      "end_seconds": 170.99,
      "duration_seconds": 13.68,
      "text": "Um, no, no dizziness, no fever, no discharge. I was turning the television up at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.49,
      "end_seconds": 173.05,
      "duration_seconds": 1.56,
      "text": "What about ear pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.51,
      "end_seconds": 177.62,
      "duration_seconds": 3.11,
      "text": "Nope, um, no ear pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.88,
      "end_seconds": 182.15,
      "duration_seconds": 3.27,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.57,
      "end_seconds": 186.37,
      "duration_seconds": 2.8,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.07,
      "end_seconds": 191.27,
      "duration_seconds": 4.2,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.38,
      "end_seconds": 209.27,
      "duration_seconds": 16.89,
      "text": "I'll have a glass of wine with dinner. No, I've never smoked in my life. I drink a lot of tea and snack through the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.92,
      "end_seconds": 212.8,
      "duration_seconds": 2.88,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.64,
      "end_seconds": 216.21,
      "duration_seconds": 2.57,
      "text": "Actually, my son has asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.85,
      "end_seconds": 220.08,
      "duration_seconds": 2.23,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.19,
      "end_seconds": 229.29,
      "duration_seconds": 8.1,
      "text": "I have asthma, for nearly five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 231.84,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.39,
      "end_seconds": 242.77,
      "duration_seconds": 10.38,
      "text": "Well, I've had acid reflux, yes. My family kept telling me to get it checked. I have depression, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.52,
      "end_seconds": 252.05,
      "duration_seconds": 7.53,
      "text": "Yes, depression is known to us, good to have that clear. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.8,
      "end_seconds": 270.0,
      "duration_seconds": 16.2,
      "text": "Yes, I had a caesarean for my second baby, nine years ago. I kept putting it off, which I know isn't sensible. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.37,
      "end_seconds": 274.72,
      "duration_seconds": 3.35,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.75,
      "end_seconds": 278.92,
      "duration_seconds": 2.17,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 280.04,
      "end_seconds": 288.06,
      "duration_seconds": 8.02,
      "text": "Doctor, I've got the readings for you. BP is 121 over 76, heart rate 82, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.08,
      "end_seconds": 290.6,
      "duration_seconds": 1.52,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 306.28,
      "duration_seconds": 7.85,
      "text": "Let me tell you where I've got to. This looks most like glue ear. I can't rule out wax yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.09,
      "end_seconds": 311.43,
      "duration_seconds": 3.34,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.66,
      "end_seconds": 332.35,
      "duration_seconds": 19.69,
      "text": "I understand the worry. At the moment I'd say it's glue ear, and we'll watch how it goes. We will watch for three months, and sit him at the front of the class. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.52,
      "end_seconds": 336.52,
      "duration_seconds": 3.0,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.28,
      "end_seconds": 338.66,
      "duration_seconds": 1.38,
      "text": "See you soon."
    }
  ]
}