{
  "schema_version": "1.0",
  "encounter_id": "02053",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 6.9,
      "duration_seconds": 6.25,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.6,
      "end_seconds": 14.0,
      "duration_seconds": 5.4,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.56,
      "end_seconds": 22.91,
      "duration_seconds": 8.35,
      "text": "Honestly, you know, it's breathlessness months after the infection, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.79,
      "end_seconds": 26.83,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.68,
      "end_seconds": 31.33,
      "duration_seconds": 2.65,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.36,
      "end_seconds": 35.63,
      "duration_seconds": 3.27,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.96,
      "end_seconds": 48.86,
      "duration_seconds": 11.9,
      "text": "Ah, it's been like this since last weekend. I've been putting this off for weeks. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 54.77,
      "duration_seconds": 3.94,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.49,
      "end_seconds": 57.07,
      "duration_seconds": 1.58,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.0,
      "end_seconds": 61.43,
      "duration_seconds": 2.43,
      "text": "Any brain fog as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.67,
      "end_seconds": 66.9,
      "duration_seconds": 4.23,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.89,
      "end_seconds": 70.81,
      "duration_seconds": 2.92,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.48,
      "end_seconds": 77.26,
      "duration_seconds": 5.78,
      "text": "I mean, um, about a four out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 80.74,
      "duration_seconds": 2.62,
      "text": "Any leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.35,
      "end_seconds": 85.49,
      "duration_seconds": 3.14,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.01,
      "end_seconds": 92.29,
      "duration_seconds": 5.28,
      "text": "Let me check a few things. Any fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.01,
      "end_seconds": 98.98,
      "duration_seconds": 4.97,
      "text": "I haven't had fever or coughing up blood, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 105.11,
      "duration_seconds": 4.15,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.74,
      "end_seconds": 116.12,
      "duration_seconds": 6.38,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.33,
      "end_seconds": 118.8,
      "duration_seconds": 1.47,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.11,
      "end_seconds": 123.39,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.0,
      "end_seconds": 126.41,
      "duration_seconds": 1.41,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.22,
      "end_seconds": 136.35,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.05,
      "end_seconds": 142.02,
      "duration_seconds": 3.97,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.62,
      "end_seconds": 145.72,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 163.21,
      "duration_seconds": 2.54,
      "text": "Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.56,
      "end_seconds": 171.41,
      "duration_seconds": 6.85,
      "text": "Okay, so just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.46,
      "end_seconds": 177.02,
      "duration_seconds": 3.56,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.21,
      "end_seconds": 181.26,
      "duration_seconds": 3.05,
      "text": "Oh, I've had COPD, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.34,
      "end_seconds": 186.94,
      "duration_seconds": 3.6,
      "text": "Ah. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 194.2,
      "duration_seconds": 2.89,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 211.63,
      "duration_seconds": 5.27,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.16,
      "end_seconds": 216.84,
      "duration_seconds": 4.68,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 219.79,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.41,
      "end_seconds": 228.7,
      "duration_seconds": 2.29,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.55,
      "end_seconds": 257.97,
      "duration_seconds": 11.42,
      "text": "Okay: pressure 111 over 80, pulse is 64 beats a minute, respiratory rate 14, SpO2 97 percent on room air, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.41,
      "end_seconds": 264.53,
      "duration_seconds": 4.12,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.4,
      "end_seconds": 268.7,
      "duration_seconds": 2.3,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.46,
      "end_seconds": 287.1,
      "duration_seconds": 6.64,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.1,
      "end_seconds": 305.54,
      "duration_seconds": 14.44,
      "text": "Okay, that's enough for me. From what you've told me and what I found, it fits best with post-viral symptoms after COVID. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.79,
      "end_seconds": 310.59,
      "duration_seconds": 3.8,
      "text": "Ah, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.33,
      "end_seconds": 323.73,
      "duration_seconds": 8.4,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral symptoms after COVID, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.93,
      "end_seconds": 348.8,
      "duration_seconds": 12.87,
      "text": "I'm going to order blood tests, for post-viral fatigue. Pace your activity and increase it slowly each week. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.05,
      "end_seconds": 353.21,
      "duration_seconds": 3.16,
      "text": "I think I understand everything. Thanks."
    }
  ]
}