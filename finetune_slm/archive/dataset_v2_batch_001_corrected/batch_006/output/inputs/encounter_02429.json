{
  "schema_version": "1.0",
  "encounter_id": "02429",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 6.75,
      "duration_seconds": 5.44,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 11.96,
      "duration_seconds": 3.91,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.0,
      "end_seconds": 20.65,
      "duration_seconds": 6.65,
      "text": "Doctor, it's a fever for two weeks. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.97,
      "end_seconds": 24.48,
      "duration_seconds": 2.51,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.71,
      "end_seconds": 39.18,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.53,
      "end_seconds": 65.26,
      "duration_seconds": 8.73,
      "text": "Okay: temperature is 38.5 degrees, BP is 126 over 76, saturation 95 percent, heart rate 96."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.14,
      "end_seconds": 84.15,
      "duration_seconds": 5.01,
      "text": "Did it come on recently? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.94,
      "end_seconds": 87.18,
      "duration_seconds": 2.24,
      "text": "It's been five days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 94.05,
      "duration_seconds": 5.66,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.32,
      "end_seconds": 102.81,
      "duration_seconds": 7.49,
      "text": "I'd say once or twice a day. A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.78,
      "end_seconds": 123.18,
      "duration_seconds": 3.4,
      "text": "Okay, any cough or chest pain at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.21,
      "end_seconds": 127.14,
      "duration_seconds": 2.93,
      "text": "No, no cough or chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.98,
      "end_seconds": 134.48,
      "duration_seconds": 2.5,
      "text": "And weight loss, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.42,
      "end_seconds": 140.17,
      "duration_seconds": 4.75,
      "text": "No, um, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.36,
      "end_seconds": 143.58,
      "duration_seconds": 2.22,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.93,
      "end_seconds": 146.52,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.23,
      "end_seconds": 150.17,
      "duration_seconds": 1.94,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.49,
      "end_seconds": 157.56,
      "duration_seconds": 2.07,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.56,
      "end_seconds": 161.12,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.07,
      "end_seconds": 165.45,
      "duration_seconds": 2.38,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.89,
      "end_seconds": 168.16,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.32,
      "end_seconds": 172.61,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.96,
      "end_seconds": 177.37,
      "duration_seconds": 3.41,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.95,
      "end_seconds": 183.6,
      "duration_seconds": 4.65,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.14,
      "end_seconds": 203.02,
      "duration_seconds": 3.88,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.12,
      "end_seconds": 211.7,
      "duration_seconds": 6.58,
      "text": "I take warfarin, 3 milligrams, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.06,
      "end_seconds": 216.98,
      "duration_seconds": 3.92,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.97,
      "end_seconds": 228.05,
      "duration_seconds": 9.08,
      "text": "I've got an irregular heartbeat. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 232.12,
      "duration_seconds": 3.49,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.03,
      "end_seconds": 246.32,
      "duration_seconds": 9.29,
      "text": "Oh, yes, trimethoprim. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.17,
      "end_seconds": 250.65,
      "duration_seconds": 3.48,
      "text": "Alright, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.36,
      "end_seconds": 268.49,
      "duration_seconds": 16.13,
      "text": "Just a mole taken off my arm, a few years ago. A neighbour of mine said I should see someone about it. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.91,
      "end_seconds": 274.28,
      "duration_seconds": 4.37,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.17,
      "end_seconds": 277.9,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 303.53,
      "duration_seconds": 9.29,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.82,
      "end_seconds": 313.81,
      "duration_seconds": 7.99,
      "text": "All finished, thank you. So, based on the history and the examination, it points towards possible infective endocarditis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.17,
      "end_seconds": 317.89,
      "duration_seconds": 2.72,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.61,
      "end_seconds": 329.42,
      "duration_seconds": 9.81,
      "text": "I understand the worry. At the moment I'd say it's possible infective endocarditis, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.78,
      "end_seconds": 351.09,
      "duration_seconds": 11.31,
      "text": "I'd like to arrange blood tests for prolonged fever. You need admission today for blood cultures and a heart scan. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.71,
      "end_seconds": 354.39,
      "duration_seconds": 1.68,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.32,
      "end_seconds": 361.48,
      "duration_seconds": 5.16,
      "text": "I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.81,
      "end_seconds": 365.26,
      "duration_seconds": 2.45,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.95,
      "end_seconds": 367.22,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}