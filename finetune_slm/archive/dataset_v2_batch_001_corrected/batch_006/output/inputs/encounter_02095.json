{
  "schema_version": "1.0",
  "encounter_id": "02095",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 6.13,
      "duration_seconds": 5.57,
      "text": "Sorry, what was I saying, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.12,
      "duration_seconds": 3.88,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.65,
      "end_seconds": 16.8,
      "duration_seconds": 5.15,
      "text": "Well, I've been having a shaky feeling in my hands."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.4,
      "end_seconds": 20.16,
      "duration_seconds": 2.76,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.43,
      "end_seconds": 35.83,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 63.5,
      "duration_seconds": 8.48,
      "text": "Okay: temp 36.7 degrees, pressure 118 over 69. And saturation 97 percent, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.16,
      "end_seconds": 86.42,
      "duration_seconds": 8.26,
      "text": "When was the first time you noticed it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.87,
      "end_seconds": 91.96,
      "duration_seconds": 4.09,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.91,
      "end_seconds": 96.63,
      "duration_seconds": 2.72,
      "text": "Alright, what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.45,
      "end_seconds": 103.65,
      "duration_seconds": 5.2,
      "text": "Let me think, you know, I notice it more with caffeine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.3,
      "end_seconds": 108.01,
      "duration_seconds": 2.71,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.21,
      "end_seconds": 119.49,
      "duration_seconds": 10.28,
      "text": "Sweaty palms goes along with it, most of the time. The sweaty palms? That's been for four weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.91,
      "end_seconds": 122.96,
      "duration_seconds": 3.05,
      "text": "Mm, okay. Any fainting, weakness or palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.49,
      "end_seconds": 126.82,
      "duration_seconds": 3.33,
      "text": "Yeah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.03,
      "end_seconds": 132.09,
      "duration_seconds": 4.06,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.22,
      "end_seconds": 135.77,
      "duration_seconds": 2.55,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.86,
      "end_seconds": 138.9,
      "duration_seconds": 2.04,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.69,
      "end_seconds": 143.41,
      "duration_seconds": 2.72,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 147.22,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.69,
      "end_seconds": 151.98,
      "duration_seconds": 3.29,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.78,
      "end_seconds": 159.19,
      "duration_seconds": 5.41,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.12,
      "end_seconds": 172.7,
      "duration_seconds": 11.58,
      "text": "My partner and our baby. I work in accounts at a hospital. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 186.16,
      "duration_seconds": 4.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.08,
      "end_seconds": 191.52,
      "duration_seconds": 3.44,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 195.32,
      "duration_seconds": 2.72,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.14,
      "end_seconds": 201.84,
      "duration_seconds": 5.7,
      "text": "Uh, I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 210.84,
      "duration_seconds": 7.7,
      "text": "Okay, any health conditions I should have on record? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.25,
      "end_seconds": 213.91,
      "duration_seconds": 1.66,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.79,
      "end_seconds": 220.35,
      "duration_seconds": 4.56,
      "text": "Yes, COPD is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.5,
      "end_seconds": 226.82,
      "duration_seconds": 4.32,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.27,
      "end_seconds": 230.63,
      "duration_seconds": 2.36,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 248.63,
      "duration_seconds": 5.88,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.54,
      "end_seconds": 256.53,
      "duration_seconds": 1.99,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.13,
      "end_seconds": 298.83,
      "duration_seconds": 29.7,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at an anxiety or caffeine-related tremor or an overactive thyroid. I'd like to arrange a thyroid test for tremor. I'd rather check than guess, and this is the quickest way to know more. Cut down caffeine and try slow breathing when it starts. We'll catch up in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.66,
      "end_seconds": 303.29,
      "duration_seconds": 3.63,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.38,
      "end_seconds": 305.56,
      "duration_seconds": 1.18,
      "text": "Take care now."
    }
  ]
}