      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.19,
      "end_seconds": 285.36,
      "duration_seconds": 8.17,
      "text": "okay, so my impression is this: This looks most like possible carbon monoxide poisoning another possibility is a viral illness"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.39,
      "end_seconds": 292.21,
      "duration_seconds": 4.82,
      "text": "okay um so what are the odds it's serious?"
    },
