      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.12,
      "end_seconds": 266.61,
      "duration_seconds": 2.49,
      "text": "That's all I needed to check."
