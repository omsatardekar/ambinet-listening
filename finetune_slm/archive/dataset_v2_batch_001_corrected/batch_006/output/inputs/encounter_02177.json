      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.98,
      "end_seconds": 235.04,
      "duration_seconds": 9.06,
      "text": "okay: respiratory rate 17, heart rate 80. And And temperature 36.9, pressure 118 over 69, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.63,
      "end_seconds": 240.49,
      "duration_seconds": 2.86,
      "text": "Okay time for me to examine you."
