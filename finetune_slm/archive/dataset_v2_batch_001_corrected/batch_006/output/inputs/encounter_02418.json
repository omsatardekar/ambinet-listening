    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.52,
      "end_seconds": 136.21,
      "duration_seconds": 1.69,
      "text": "okay, breathe out slowly"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.5,
      "end_seconds": 153.06,
      "duration_seconds": 6.56,
      "text": "your chest is clear and your oxygen level is normal at rest and after walking"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.27,
      "end_seconds": 161.35,
      "duration_seconds": 3.08,
      "text": "Okay, that's all I needed to check."
