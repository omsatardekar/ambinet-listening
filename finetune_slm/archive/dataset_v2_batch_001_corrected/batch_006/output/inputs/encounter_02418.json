    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.59,
      "end_seconds": 74.81,
      "duration_seconds": 17.22,
      "text": "When it starts I tend to get a bit of a cough with exercise as well. Hmm, about bit of a cough with exercise, it just comes and goes. Yes, running. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.76,
      "end_seconds": 87.1,
      "duration_seconds": 3.34,
      "text": "I'll just record a few vital signs."
