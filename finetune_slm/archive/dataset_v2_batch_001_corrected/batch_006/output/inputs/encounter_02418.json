      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 338.02,
      "duration_seconds": 2.53,
      "text": "Right, good, I'll return then."
