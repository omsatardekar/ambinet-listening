      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 7.01,
      "duration_seconds": 5.89,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 12.91,
      "duration_seconds": 4.66,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.05,
      "end_seconds": 20.78,
      "duration_seconds": 6.73,
      "text": "Ah, I've been getting puffed climbing stairs, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.76,
      "end_seconds": 24.99,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.52,
      "end_seconds": 31.49,
      "duration_seconds": 5.97,
      "text": "I'd say ten days. Actually, uh, no, closer to five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.45,
      "end_seconds": 38.57,
      "duration_seconds": 3.12,
      "text": "Is it a lot or only a little?"
