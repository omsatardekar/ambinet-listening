    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.47,
      "end_seconds": 47.18,
      "duration_seconds": 2.71,
      "text": "how often do you get it?"
