      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.93,
      "end_seconds": 347.13,
      "duration_seconds": 5.2,
      "text": "Can you run through the plan with me quickly, just to be certain?"
