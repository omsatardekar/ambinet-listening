      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.66,
      "end_seconds": 183.72,
      "duration_seconds": 5.06,
      "text": "no, um, no wheeze, chest pain or fainting"
    },
    {
      "segment_id": "SEG0022",
