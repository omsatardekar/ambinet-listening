      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.02,
      "end_seconds": 306.44,
      "duration_seconds": 13.42,
      "text": "From what you've told me and what I found, I'd lean towards breathlessness from low fitness. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.19,
      "end_seconds": 333.61,
      "duration_seconds": 14.42,
      "text": "I'm sending you for a peak flow because of exertional cough build up to thirty minutes of brisk walking five days a week please come and see me in eight weeks"
    },
