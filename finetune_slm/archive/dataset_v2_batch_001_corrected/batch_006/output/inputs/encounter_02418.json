    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.5,
      "end_seconds": 43.28,
      "duration_seconds": 3.78,
      "text": "hmm, pretty moderate, if I'm being honest"
