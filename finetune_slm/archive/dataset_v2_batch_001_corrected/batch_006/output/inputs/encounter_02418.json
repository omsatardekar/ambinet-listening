    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.54,
      "end_seconds": 56.9,
      "duration_seconds": 3.36,
      "text": "So, have you noticed anything else alongside it?"
