    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.22,
      "end_seconds": 100.43,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.46,
      "end_seconds": 126.15,
      "duration_seconds": 9.69,
      "text": "Okay: respiratory rate 16, blood pressure 121 over 71, oxygen saturation is 99 percent, heart rate 67, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.65,
      "end_seconds": 131.14,
      "duration_seconds": 3.49,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 132.78,
      "duration_seconds": 0.7,
      "text": "Right."
