      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.01,
      "end_seconds": 355.1,
      "duration_seconds": 6.09,
      "text": "So, um, I come back in eight weeks. Is that right?"
