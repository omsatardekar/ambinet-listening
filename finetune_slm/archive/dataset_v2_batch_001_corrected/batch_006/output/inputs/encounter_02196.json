{
  "schema_version": "1.0",
  "encounter_id": "02196",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 6.7,
      "duration_seconds": 5.53,
      "text": "Yeah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.17,
      "duration_seconds": 3.8,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.48,
      "end_seconds": 17.62,
      "duration_seconds": 5.14,
      "text": "I've been dealing with sudden severe pain in the left testicle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.49,
      "end_seconds": 21.46,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.12,
      "end_seconds": 25.95,
      "duration_seconds": 3.83,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.89,
      "end_seconds": 29.88,
      "duration_seconds": 1.99,
      "text": "Have you had any discharge?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.38,
      "end_seconds": 33.19,
      "duration_seconds": 2.81,
      "text": "Right, I haven't noticed any discharge."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.68,
      "end_seconds": 39.08,
      "duration_seconds": 4.4,
      "text": "Have you had any injury, fever or burning when passing urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.96,
      "end_seconds": 44.02,
      "duration_seconds": 3.06,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.65,
      "end_seconds": 49.32,
      "duration_seconds": 4.67,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 56.7,
      "duration_seconds": 2.13,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.44,
      "end_seconds": 62.97,
      "duration_seconds": 4.53,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.98,
      "end_seconds": 67.81,
      "duration_seconds": 3.83,
      "text": "Ah, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.58,
      "end_seconds": 74.02,
      "duration_seconds": 4.44,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.06,
      "end_seconds": 79.58,
      "duration_seconds": 3.52,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.24,
      "end_seconds": 95.61,
      "duration_seconds": 2.37,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.22,
      "end_seconds": 102.95,
      "duration_seconds": 3.73,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.72,
      "end_seconds": 105.49,
      "duration_seconds": 1.77,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.91,
      "end_seconds": 111.14,
      "duration_seconds": 4.23,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.16,
      "end_seconds": 115.1,
      "duration_seconds": 2.94,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.73,
      "end_seconds": 119.2,
      "duration_seconds": 2.47,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.16,
      "end_seconds": 140.56,
      "duration_seconds": 2.4,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 150.67,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.0,
      "end_seconds": 182.38,
      "duration_seconds": 16.38,
      "text": "Okay: blood pressure 120 over 78, SpO2 98 percent on room air, temperature is 36.5 degrees, height 154 centimetres, respiratory rate 16, heart rate 80, BMI works out to 35.8, weight 85 kilos."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 185.57,
      "duration_seconds": 1.93,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.97,
      "end_seconds": 190.6,
      "duration_seconds": 3.63,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.79,
      "end_seconds": 196.3,
      "duration_seconds": 4.51,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.97,
      "end_seconds": 200.94,
      "duration_seconds": 2.97,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.69,
      "end_seconds": 219.19,
      "duration_seconds": 8.5,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.75,
      "end_seconds": 224.27,
      "duration_seconds": 2.52,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.54,
      "end_seconds": 243.33,
      "duration_seconds": 9.79,
      "text": "From what you've told me and what I found, I think we're dealing with testicular torsion needing emergency surgery at this stage."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.12,
      "end_seconds": 249.49,
      "duration_seconds": 3.37,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.19,
      "end_seconds": 264.58,
      "duration_seconds": 13.39,
      "text": "I understand the worry. At the moment I'd say it's testicular torsion needing emergency surgery, and we'll know more once the an urgent scrotal ultrasound is back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.89,
      "end_seconds": 286.21,
      "duration_seconds": 14.32,
      "text": "We should do an urgent scrotal ultrasound for testicular pain. I'd rather check than guess, and this is the quickest way to know more. Book a review straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.19,
      "end_seconds": 290.81,
      "duration_seconds": 2.62,
      "text": "I, I can manage that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.01,
      "end_seconds": 295.59,
      "duration_seconds": 3.58,
      "text": "Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.9,
      "end_seconds": 299.39,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.74,
      "end_seconds": 302.2,
      "duration_seconds": 1.46,
      "text": "Goodbye for now."
    }
  ]
}