{
  "schema_version": "1.0",
  "encounter_id": "02291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 6.25,
      "duration_seconds": 5.56,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.38,
      "end_seconds": 15.28,
      "duration_seconds": 4.9,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.88,
      "end_seconds": 20.56,
      "duration_seconds": 3.68,
      "text": "It's a severe painful red eye, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.27,
      "end_seconds": 29.79,
      "duration_seconds": 8.52,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.74,
      "end_seconds": 36.54,
      "duration_seconds": 5.8,
      "text": "It's severe, honestly. It's a couple of times a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.01,
      "end_seconds": 41.34,
      "duration_seconds": 2.33,
      "text": "Has there been a headache too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.6,
      "end_seconds": 54.65,
      "duration_seconds": 12.05,
      "text": "Yeah. Four weeks, uh, I'd say. Sorry, what was I saying, as for headache, about a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.86,
      "end_seconds": 58.02,
      "duration_seconds": 3.16,
      "text": "I follow. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.71,
      "end_seconds": 61.3,
      "duration_seconds": 1.59,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.19,
      "end_seconds": 63.43,
      "duration_seconds": 1.24,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.05,
      "end_seconds": 69.27,
      "duration_seconds": 4.22,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.03,
      "end_seconds": 73.2,
      "duration_seconds": 2.17,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.11,
      "end_seconds": 78.19,
      "duration_seconds": 4.08,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.89,
      "end_seconds": 100.29,
      "duration_seconds": 3.4,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.21,
      "end_seconds": 105.26,
      "duration_seconds": 4.05,
      "text": "Hmm, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 117.4,
      "duration_seconds": 3.9,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.16,
      "end_seconds": 123.09,
      "duration_seconds": 4.93,
      "text": "I'm allergic to milk, I get a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.59,
      "end_seconds": 128.86,
      "duration_seconds": 4.27,
      "text": "Okay, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.87,
      "end_seconds": 135.68,
      "duration_seconds": 4.81,
      "text": "I've had high cholesterol for five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.57,
      "end_seconds": 145.5,
      "duration_seconds": 7.93,
      "text": "Yes, high cholesterol is known to us, good to have that clear. Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.06,
      "end_seconds": 149.66,
      "duration_seconds": 2.6,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.09,
      "end_seconds": 154.86,
      "duration_seconds": 3.77,
      "text": "A few quick ones: contact lens, injury or discharge?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.9,
      "end_seconds": 159.72,
      "duration_seconds": 3.82,
      "text": "No, no contact lens, injury or discharge."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.36,
      "end_seconds": 165.25,
      "duration_seconds": 3.89,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.94,
      "end_seconds": 170.78,
      "duration_seconds": 4.84,
      "text": "Hmm, you know, no, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.29,
      "end_seconds": 174.64,
      "duration_seconds": 2.35,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.08,
      "end_seconds": 178.4,
      "duration_seconds": 2.32,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.42,
      "end_seconds": 182.85,
      "duration_seconds": 3.43,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.81,
      "end_seconds": 192.61,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.04,
      "end_seconds": 217.0,
      "duration_seconds": 7.96,
      "text": "Okay: SpO2 98 percent on room air, heart rate 70. And blood pressure 121 over 76, respiratory rate 16."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.26,
      "end_seconds": 219.78,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.71,
      "end_seconds": 223.28,
      "duration_seconds": 2.57,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.75,
      "end_seconds": 229.06,
      "duration_seconds": 4.31,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.56,
      "end_seconds": 232.86,
      "duration_seconds": 2.3,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.48,
      "end_seconds": 251.07,
      "duration_seconds": 7.59,
      "text": "The right eye is red, the pupil is fixed and mid-sized, and the eye feels rock hard."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.67,
      "end_seconds": 263.3,
      "duration_seconds": 6.63,
      "text": "Please sit back down. Having listened and examined, my working impression is acute angle-closure glaucoma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.49,
      "end_seconds": 267.53,
      "duration_seconds": 3.04,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.24,
      "end_seconds": 285.44,
      "duration_seconds": 17.2,
      "text": "I understand the worry. At the moment I'd say it's acute angle-closure glaucoma, and we'll watch how it goes. Just to be sure I understood. You've had a severe painful red eye, severe, and no contact lens or injury."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.79,
      "end_seconds": 288.64,
      "duration_seconds": 1.85,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.79,
      "end_seconds": 310.85,
      "duration_seconds": 6.06,
      "text": "For now, no new medicines or tests are needed. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.64,
      "end_seconds": 316.24,
      "duration_seconds": 3.6,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}