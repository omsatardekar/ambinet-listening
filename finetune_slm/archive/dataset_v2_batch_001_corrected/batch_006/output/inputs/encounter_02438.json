{
  "schema_version": "1.0",
  "encounter_id": "02438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 6.77,
      "duration_seconds": 5.83,
      "text": "Afternoon, thanks for coming in. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.82,
      "end_seconds": 13.36,
      "duration_seconds": 5.54,
      "text": "I wanted to get being breathless on stairs looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.06,
      "end_seconds": 18.05,
      "duration_seconds": 2.99,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.68,
      "end_seconds": 31.79,
      "duration_seconds": 13.11,
      "text": "Ah, probably six months. Yeah. I didn't want to make a fuss, you know. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.74,
      "end_seconds": 36.86,
      "duration_seconds": 4.12,
      "text": "Have you noticed weight loss, fainting or bleeding between periods?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.72,
      "end_seconds": 40.55,
      "duration_seconds": 2.83,
      "text": "Actually, nope, nothing like that."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.38,
      "end_seconds": 45.34,
      "duration_seconds": 2.96,
      "text": "Have you had pain, by any chance?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.84,
      "end_seconds": 50.29,
      "duration_seconds": 3.45,
      "text": "No, I haven't had any pain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.75,
      "end_seconds": 54.59,
      "duration_seconds": 2.84,
      "text": "Right, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.15,
      "end_seconds": 58.94,
      "duration_seconds": 2.79,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.86,
      "end_seconds": 63.31,
      "duration_seconds": 3.45,
      "text": "So, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.19,
      "end_seconds": 68.15,
      "duration_seconds": 2.96,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.39,
      "end_seconds": 73.5,
      "duration_seconds": 4.11,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.55,
      "end_seconds": 79.34,
      "duration_seconds": 3.79,
      "text": "Milk. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.6,
      "end_seconds": 95.05,
      "duration_seconds": 3.45,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.91,
      "end_seconds": 103.07,
      "duration_seconds": 6.16,
      "text": "I mean, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.64,
      "end_seconds": 117.25,
      "duration_seconds": 3.61,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.02,
      "end_seconds": 131.84,
      "duration_seconds": 13.82,
      "text": "I've never touched a cigarette. I swim twice a week. I'm a bus driver, so I sit for long hours. My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.31,
      "end_seconds": 154.28,
      "duration_seconds": 3.97,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.5,
      "end_seconds": 157.0,
      "duration_seconds": 1.5,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.8,
      "end_seconds": 161.4,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 172.05,
      "duration_seconds": 2.67,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 202.44,
      "duration_seconds": 8.81,
      "text": "Okay: respiratory rate 16, pressure 128 over 73, oxygen saturation is 98 percent, temperature is 37.0 degrees, pulse 118."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.9,
      "end_seconds": 209.17,
      "duration_seconds": 4.27,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.38,
      "end_seconds": 212.33,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.91,
      "end_seconds": 229.72,
      "duration_seconds": 4.81,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.52,
      "end_seconds": 235.03,
      "duration_seconds": 2.51,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.0,
      "end_seconds": 249.62,
      "duration_seconds": 5.62,
      "text": "Having listened and examined, I'd lean towards heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.41,
      "end_seconds": 253.34,
      "duration_seconds": 2.93,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.49,
      "end_seconds": 279.94,
      "duration_seconds": 20.45,
      "text": "It's reasonable to be concerned, but right now heavy periods with iron deficiency is my leading thought, not anything worse. I'd like to arrange a pelvic ultrasound for heavy periods. We'll begin with tranexamic acid, 1 gram, three times a day, during periods. That's for heavy periods."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.83,
      "end_seconds": 282.86,
      "duration_seconds": 2.03,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.84,
      "end_seconds": 296.23,
      "duration_seconds": 11.39,
      "text": "Keep a pad count diary. A short walk every day, even twenty minutes, will help more than you'd think. See me again after the results."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.13,
      "end_seconds": 298.83,
      "duration_seconds": 1.7,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.57,
      "end_seconds": 304.49,
      "duration_seconds": 4.92,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.0,
      "end_seconds": 310.04,
      "duration_seconds": 5.04,
      "text": "Right, um, great, thank you for your help."
    }
  ]
}