{
  "schema_version": "1.0",
  "encounter_id": "02383",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 6.8,
      "duration_seconds": 5.96,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.11,
      "end_seconds": 12.31,
      "duration_seconds": 4.2,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 23.55,
      "duration_seconds": 10.61,
      "text": "Honestly, it's itchy watery eyes, and my family pushed me to come. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.36,
      "end_seconds": 26.71,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.58,
      "end_seconds": 30.49,
      "duration_seconds": 2.91,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 34.45,
      "duration_seconds": 2.92,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.0,
      "end_seconds": 36.96,
      "duration_seconds": 1.96,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 40.63,
      "duration_seconds": 2.47,
      "text": "Okay, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.33,
      "end_seconds": 58.65,
      "duration_seconds": 17.32,
      "text": "Sneezing goes along with it, most of the time. So, you know, as for sneezing, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 62.7,
      "duration_seconds": 3.41,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.54,
      "end_seconds": 75.07,
      "duration_seconds": 11.53,
      "text": "A four out of ten, I suppose. A runny nose was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 94.78,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.95,
      "end_seconds": 105.39,
      "duration_seconds": 9.44,
      "text": "Diabetes, for nearly five years. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 114.82,
      "duration_seconds": 5.06,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 121.19,
      "duration_seconds": 4.58,
      "text": "Ah, you know, I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.01,
      "end_seconds": 130.02,
      "duration_seconds": 8.01,
      "text": "Alright, do you take any prescribed or over-the-counter medicines? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.46,
      "end_seconds": 140.37,
      "duration_seconds": 8.91,
      "text": "Sitagliptin, 100 milligrams, once a day. So, I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.95,
      "end_seconds": 141.83,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.7,
      "end_seconds": 147.92,
      "duration_seconds": 4.22,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.62,
      "end_seconds": 152.84,
      "duration_seconds": 1.22,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.76,
      "end_seconds": 158.3,
      "duration_seconds": 4.54,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.7,
      "end_seconds": 161.74,
      "duration_seconds": 2.04,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 165.7,
      "duration_seconds": 3.0,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.31,
      "end_seconds": 168.46,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.1,
      "end_seconds": 174.37,
      "duration_seconds": 4.27,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.79,
      "end_seconds": 177.97,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.72,
      "end_seconds": 185.09,
      "duration_seconds": 6.37,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.7,
      "end_seconds": 188.45,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.24,
      "end_seconds": 190.35,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.04,
      "end_seconds": 194.83,
      "duration_seconds": 2.79,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.07,
      "end_seconds": 200.23,
      "duration_seconds": 4.16,
      "text": "Mm, um, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.34,
      "end_seconds": 221.21,
      "duration_seconds": 4.87,
      "text": "Okay, have you noticed pain in the eye or light sensitivity?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.46,
      "end_seconds": 224.62,
      "duration_seconds": 2.16,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.26,
      "end_seconds": 230.7,
      "duration_seconds": 4.44,
      "text": "Have you had any contact lens or blurred vision?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.94,
      "end_seconds": 235.06,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.4,
      "end_seconds": 238.44,
      "duration_seconds": 2.04,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.57,
      "end_seconds": 241.39,
      "duration_seconds": 1.82,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 242.0,
      "end_seconds": 251.06,
      "duration_seconds": 9.06,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 99 percent, temperature is 36.8 degrees, pressure 113 over 78, heart rate 66."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.84,
      "end_seconds": 253.85,
      "duration_seconds": 1.01,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.89,
      "end_seconds": 257.85,
      "duration_seconds": 1.96,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.65,
      "end_seconds": 260.81,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.95,
      "end_seconds": 275.38,
      "duration_seconds": 5.43,
      "text": "Both eyes are pink with clear watery discharge and no sticky pus."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.67,
      "end_seconds": 283.06,
      "duration_seconds": 2.39,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.34,
      "end_seconds": 309.83,
      "duration_seconds": 11.49,
      "text": "Right, here's what I'm thinking. I'd lean towards allergic conjunctivitis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.52,
      "end_seconds": 312.66,
      "duration_seconds": 2.14,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.75,
      "end_seconds": 326.57,
      "duration_seconds": 12.82,
      "text": "Nothing I've seen today points to an emergency. It looks like allergic conjunctivitis. Avoid rubbing your eyes and keep windows closed on high-pollen days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.16,
      "end_seconds": 330.04,
      "duration_seconds": 1.88,
      "text": "That's clear, thanks."
    }
  ]
}