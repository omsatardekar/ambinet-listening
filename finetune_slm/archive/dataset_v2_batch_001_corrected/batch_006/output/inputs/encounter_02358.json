  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 3.55,
      "duration_seconds": 2.44,
      "text": "So, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.53,
      "end_seconds": 7.49,
      "duration_seconds": 2.96,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.96,
      "end_seconds": 11.38,
      "duration_seconds": 2.42,
      "text": "So, cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.42,
      "end_seconds": 18.0,
      "duration_seconds": 3.58,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.09,
      "end_seconds": 22.4,
      "duration_seconds": 2.31,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.95,
      "end_seconds": 29.57,
      "duration_seconds": 5.62,
      "text": "Honestly, it's brain fog, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.11,
      "end_seconds": 34.51,
      "duration_seconds": 3.4,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 38.51,
      "duration_seconds": 2.28,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.43,
      "end_seconds": 43.7,
      "duration_seconds": 3.27,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.61,
      "end_seconds": 46.72,
      "duration_seconds": 1.11,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.94,
      "end_seconds": 47.95,
      "duration_seconds": 1.01,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.0,
      "end_seconds": 65.71,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.57,
      "end_seconds": 71.8,
      "duration_seconds": 4.23,
      "text": "I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.82,
      "end_seconds": 76.73,
      "duration_seconds": 2.91,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.8,
      "end_seconds": 82.51,
      "duration_seconds": 4.71,
      "text": "Well, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.49,
      "end_seconds": 86.94,
      "duration_seconds": 2.45,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.6,
      "end_seconds": 99.48,
      "duration_seconds": 10.88,
      "text": "Lots of rice, lentils and some fruit. I work in accounts at a hospital. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.01,
      "end_seconds": 103.45,
      "duration_seconds": 3.44,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.45,
      "end_seconds": 110.52,
      "duration_seconds": 5.07,
      "text": "Carvedilol. I take it 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 111.91,
      "duration_seconds": 1.01,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.47,
      "end_seconds": 130.82,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.13,
      "end_seconds": 133.67,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.18,
      "end_seconds": 137.85,
      "duration_seconds": 3.67,
      "text": "Have you noticed leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.26,
      "end_seconds": 143.86,
      "duration_seconds": 4.6,
      "text": "No, no leg swelling or coughing up blood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 146.55,
      "duration_seconds": 2.15,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.57,
      "end_seconds": 149.3,
      "duration_seconds": 1.73,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.28,
      "end_seconds": 153.07,
      "duration_seconds": 2.79,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.04,
      "end_seconds": 161.18,
      "duration_seconds": 3.14,
      "text": "Erm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.66,
      "end_seconds": 178.07,
      "duration_seconds": 2.41,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.11,
      "end_seconds": 189.07,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.0,
      "end_seconds": 221.87,
      "duration_seconds": 12.87,
      "text": "Okay: pulse is 77 beats a minute, SpO2 99 percent on room air. And respiratory rate 17, temp 36.6 degrees, BP is 121 over 76."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 228.96,
      "duration_seconds": 4.33,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.4,
      "end_seconds": 232.85,
      "duration_seconds": 2.45,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.97,
      "end_seconds": 251.21,
      "duration_seconds": 6.24,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.55,
      "end_seconds": 256.54,
      "duration_seconds": 2.99,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.22,
      "end_seconds": 297.53,
      "duration_seconds": 24.31,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at post-viral symptoms after COVID or anaemia. I'm going to order a chest X-ray, for persistent breathlessness. Pace your activity and increase it slowly each week. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.63,
      "end_seconds": 300.16,
      "duration_seconds": 1.53,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.09,
      "end_seconds": 303.68,
      "duration_seconds": 2.59,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.64,
      "end_seconds": 307.87,
      "duration_seconds": 2.23,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 311.27,
      "duration_seconds": 2.46,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.67,
      "end_seconds": 315.61,
      "duration_seconds": 1.94,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.51,
      "end_seconds": 318.98,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
