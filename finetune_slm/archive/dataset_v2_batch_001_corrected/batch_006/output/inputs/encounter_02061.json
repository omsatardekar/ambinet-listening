{
  "schema_version": "1.0",
  "encounter_id": "02061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 3.77,
      "duration_seconds": 2.88,
      "text": "good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.87,
      "end_seconds": 7.46,
      "duration_seconds": 2.59,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.04,
      "end_seconds": 13.88,
      "duration_seconds": 4.84,
      "text": "Well, um, I've been having itchy watery eyes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.3,
      "end_seconds": 18.61,
      "duration_seconds": 3.31,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.68,
      "end_seconds": 25.05,
      "duration_seconds": 5.37,
      "text": "let me think, it's been three weeks, I'm fairly sure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.72,
      "end_seconds": 34.68,
      "duration_seconds": 7.96,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.08,
      "end_seconds": 46.55,
      "duration_seconds": 10.47,
      "text": "Pretty moderate, if I'm being honest. I get some relief from cold compress. I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 51.76,
      "duration_seconds": 3.14,
      "text": "What about sneezing, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.01,
      "end_seconds": 59.75,
      "duration_seconds": 3.74,
      "text": "yes, about the same, two days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.35,
      "end_seconds": 63.8,
      "duration_seconds": 2.45,
      "text": "Have you had a runny nose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.58,
      "end_seconds": 68.0,
      "duration_seconds": 2.42,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 74.48,
      "duration_seconds": 5.38,
      "text": "have you had itchy watery eyes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 82.39,
      "duration_seconds": 6.34,
      "text": "Yeah, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.86,
      "end_seconds": 89.54,
      "duration_seconds": 5.68,
      "text": "Okay, have you had any pain in the eye, light sensitivity or contact lens?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 94.72,
      "duration_seconds": 3.1,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.72,
      "end_seconds": 97.43,
      "duration_seconds": 1.71,
      "text": "Nothing like blurred vision?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.04,
      "end_seconds": 104.45,
      "duration_seconds": 2.41,
      "text": "No, no blurred vision."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.16,
      "end_seconds": 109.36,
      "duration_seconds": 3.2,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.47,
      "end_seconds": 113.13,
      "duration_seconds": 2.66,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.82,
      "end_seconds": 118.49,
      "duration_seconds": 4.67,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 129.47,
      "duration_seconds": 5.74,
      "text": "Well, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.44,
      "end_seconds": 138.05,
      "duration_seconds": 5.61,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.82,
      "end_seconds": 141.88,
      "duration_seconds": 3.06,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.56,
      "end_seconds": 161.14,
      "duration_seconds": 5.58,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.9,
      "end_seconds": 180.23,
      "duration_seconds": 17.33,
      "text": "Nothing, I'm teetotal. I drink a lot of tea and snack through the day. I hardly move around during the day. I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.1,
      "end_seconds": 184.01,
      "duration_seconds": 2.91,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.15,
      "end_seconds": 189.8,
      "duration_seconds": 4.65,
      "text": "Carbamazepine. I take it 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 191.6,
      "end_seconds": 196.92,
      "duration_seconds": 5.32,
      "text": "Doctor, our chart from the last visit lists it as 400 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.34,
      "end_seconds": 202.8,
      "duration_seconds": 4.46,
      "text": "alright, I see is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.42,
      "end_seconds": 217.34,
      "duration_seconds": 12.92,
      "text": "Sorry, uh, what was I saying, not with me. I'll bring it next time. Ah, it's sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.36,
      "end_seconds": 235.35,
      "duration_seconds": 3.99,
      "text": "Okay, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.84,
      "end_seconds": 241.56,
      "duration_seconds": 4.72,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.3,
      "end_seconds": 245.71,
      "duration_seconds": 2.41,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.46,
      "end_seconds": 251.72,
      "duration_seconds": 4.26,
      "text": "Oh, I have epilepsy, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.54,
      "end_seconds": 256.65,
      "duration_seconds": 1.11,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.22,
      "end_seconds": 259.71,
      "duration_seconds": 2.49,
      "text": "I, I have depression."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.57,
      "end_seconds": 264.73,
      "duration_seconds": 4.16,
      "text": "Right, is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.84,
      "end_seconds": 271.05,
      "duration_seconds": 5.21,
      "text": "well, my son has asthma my father had bowel cancer"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 276.27,
      "end_seconds": 290.48,
      "duration_seconds": 14.21,
      "text": "Okay, so the vitals from earlier. BMI works out to to 24.2, pulse 73, weight 62 kilos, height 160 centimetres, SpO2 97 percent on room air, pressure 111 over 73, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.15,
      "end_seconds": 292.69,
      "duration_seconds": 1.54,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 298.32,
      "duration_seconds": 3.39,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.58,
      "end_seconds": 300.8,
      "duration_seconds": 1.22,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.03,
      "end_seconds": 323.74,
      "duration_seconds": 4.71,
      "text": "Both eyes are pink with clear watery discharge and no sticky pus."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.24,
      "end_seconds": 331.84,
      "duration_seconds": 2.6,
      "text": "So, all finished, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.71,
      "end_seconds": 379.53,
      "duration_seconds": 28.82,
      "text": "Right, here's what I'm thinking. I'd lean towards allergic conjunctivitis. That's my thinking for now, and it may change as we learn more. I'd also keep infective conjunctivitis in mind. Avoid rubbing your eyes and keep windows closed on high-pollen days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.42,
      "end_seconds": 384.78,
      "duration_seconds": 4.36,
      "text": "good, um, thanks, I'll see you then"
    }
  ]
}