{
  "schema_version": "1.0",
  "encounter_id": "02419",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 6.35,
      "duration_seconds": 5.73,
      "text": "hi there, the chair's free, sit down. Have you been here before?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.6,
      "end_seconds": 11.13,
      "duration_seconds": 3.53,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.67,
      "end_seconds": 16.89,
      "duration_seconds": 2.22,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.52,
      "end_seconds": 27.76,
      "duration_seconds": 10.24,
      "text": "Mainly a lump in my left breast. There's a couple of other things, but that's the the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.58,
      "end_seconds": 32.65,
      "duration_seconds": 3.07,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.6,
      "end_seconds": 42.79,
      "duration_seconds": 9.19,
      "text": "I've had it for about a week. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.26,
      "end_seconds": 44.55,
      "duration_seconds": 1.29,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.81,
      "end_seconds": 53.83,
      "duration_seconds": 8.02,
      "text": "And slight tenderness as well, since Friday. With slight tenderness, before periods definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.27,
      "end_seconds": 59.68,
      "duration_seconds": 4.41,
      "text": "Has there been the lump being there for a month too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.47,
      "end_seconds": 66.77,
      "duration_seconds": 3.3,
      "text": "Actually, yes, for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 75.05,
      "duration_seconds": 7.25,
      "text": "Have you had a lump in your left breast before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.17,
      "end_seconds": 83.11,
      "duration_seconds": 6.94,
      "text": "a bit, a couple of years ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.71,
      "end_seconds": 86.47,
      "duration_seconds": 2.76,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.25,
      "end_seconds": 96.71,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.3,
      "end_seconds": 124.63,
      "duration_seconds": 7.33,
      "text": "okay: blood pressure 128 over 71, oxygen saturation is 99 percent. And pulse 83, temp 36.6 degrees"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.43,
      "end_seconds": 130.58,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.91,
      "end_seconds": 139.81,
      "duration_seconds": 0.9,
      "text": "of course"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.08,
      "end_seconds": 142.92,
      "duration_seconds": 1.84,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.47,
      "end_seconds": 167.74,
      "duration_seconds": 9.27,
      "text": "there is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.85,
      "end_seconds": 177.83,
      "duration_seconds": 7.98,
      "text": "You can sit up now. Did you get weight loss, skin dimpling, lump under the arm or nipple discharge?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.5,
      "end_seconds": 185.93,
      "duration_seconds": 7.43,
      "text": "I haven't had weight loss, skin dimpling, lump under the arm or nipple discharge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.21,
      "end_seconds": 189.57,
      "duration_seconds": 2.36,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.5,
      "end_seconds": 192.56,
      "duration_seconds": 1.06,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.26,
      "end_seconds": 196.63,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.86,
      "end_seconds": 200.13,
      "duration_seconds": 2.27,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 206.0,
      "duration_seconds": 5.13,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.91,
      "end_seconds": 211.8,
      "duration_seconds": 3.89,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 220.21,
      "duration_seconds": 7.73,
      "text": "do you have any medical conditions I should know about? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.09,
      "end_seconds": 223.72,
      "duration_seconds": 1.63,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.35,
      "end_seconds": 244.57,
      "duration_seconds": 4.22,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.37,
      "end_seconds": 261.96,
      "duration_seconds": 16.59,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. My husband and I live above the shop. I walk the dog every morning. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.46,
      "end_seconds": 266.17,
      "duration_seconds": 2.71,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.89,
      "end_seconds": 270.48,
      "duration_seconds": 3.59,
      "text": "Mm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 280.13,
      "duration_seconds": 8.32,
      "text": "Okay, so my impression is this: It points towards a breast lump needing triple assessment. Another possibility is a cyst."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.96,
      "end_seconds": 287.22,
      "duration_seconds": 3.26,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.83,
      "end_seconds": 295.21,
      "duration_seconds": 7.38,
      "text": "Nothing I've seen today points to an emergency. It looks like a breast lump needing triple assessment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 316.75,
      "duration_seconds": 10.64,
      "text": "This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. Let's plan a check after the clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.65,
      "end_seconds": 319.48,
      "duration_seconds": 1.83,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.01,
      "end_seconds": 324.72,
      "duration_seconds": 4.71,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.22,
      "end_seconds": 328.15,
      "duration_seconds": 2.93,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.29,
      "end_seconds": 330.62,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
