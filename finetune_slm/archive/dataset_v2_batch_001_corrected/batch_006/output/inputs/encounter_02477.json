{
  "schema_version": "1.0",
  "encounter_id": "02477",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.28,
      "duration_seconds": 3.64,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.88,
      "end_seconds": 8.62,
      "duration_seconds": 3.74,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.23,
      "end_seconds": 22.73,
      "duration_seconds": 13.5,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. Uh, it's a high temperature, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.04,
      "end_seconds": 25.9,
      "duration_seconds": 1.86,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.1,
      "end_seconds": 30.11,
      "duration_seconds": 3.01,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.26,
      "end_seconds": 36.79,
      "duration_seconds": 5.53,
      "text": "Okay, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.85,
      "end_seconds": 42.06,
      "duration_seconds": 4.21,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.08,
      "end_seconds": 45.99,
      "duration_seconds": 2.91,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.64,
      "end_seconds": 52.22,
      "duration_seconds": 5.58,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.3,
      "end_seconds": 55.59,
      "duration_seconds": 2.29,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.38,
      "end_seconds": 76.31,
      "duration_seconds": 19.93,
      "text": "When it starts I tend to get a very fast heartbeat as well. Hmm, um, the very fast heartbeat? That's been for six months. I did have agitation at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.63,
      "end_seconds": 80.6,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.49,
      "end_seconds": 93.89,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.59,
      "end_seconds": 116.07,
      "duration_seconds": 10.48,
      "text": "Okay: heart rate 103, BP is 126 over 80, temperature is 38.9 degrees. And SpO2 95 percent on room air."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.91,
      "end_seconds": 123.04,
      "duration_seconds": 2.13,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.87,
      "end_seconds": 127.04,
      "duration_seconds": 2.17,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.71,
      "end_seconds": 133.3,
      "duration_seconds": 4.59,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.49,
      "end_seconds": 135.66,
      "duration_seconds": 1.17,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.38,
      "end_seconds": 159.99,
      "duration_seconds": 7.61,
      "text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.84,
      "end_seconds": 164.48,
      "duration_seconds": 1.64,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.39,
      "end_seconds": 186.02,
      "duration_seconds": 3.63,
      "text": "And what about chest pain or recent infection?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.96,
      "end_seconds": 190.57,
      "duration_seconds": 3.61,
      "text": "No, no chest pain or recent infection."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.51,
      "end_seconds": 196.87,
      "duration_seconds": 4.36,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.95,
      "end_seconds": 199.62,
      "duration_seconds": 1.67,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.61,
      "end_seconds": 212.03,
      "duration_seconds": 2.42,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.22,
      "end_seconds": 218.27,
      "duration_seconds": 5.05,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.07,
      "end_seconds": 221.81,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.14,
      "end_seconds": 227.22,
      "duration_seconds": 4.08,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.98,
      "end_seconds": 230.84,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.21,
      "end_seconds": 236.14,
      "duration_seconds": 3.93,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.73,
      "end_seconds": 238.8,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.18,
      "end_seconds": 249.23,
      "duration_seconds": 9.05,
      "text": "Hmm, you know, I've had heart disease for two years now. I have eczema."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 257.77,
      "duration_seconds": 6.51,
      "text": "Yes, heart disease and eczema are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.85,
      "end_seconds": 277.36,
      "duration_seconds": 3.51,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.82,
      "end_seconds": 291.03,
      "duration_seconds": 10.21,
      "text": "It's metoprolol, 50 milligrams, twice a day. Hydrocortisone cream. I take it when needed. Aspirin I don't take anymore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.9,
      "end_seconds": 296.01,
      "duration_seconds": 3.11,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.86,
      "end_seconds": 301.62,
      "duration_seconds": 4.76,
      "text": "Sorry, what was I saying, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.78,
      "end_seconds": 305.7,
      "duration_seconds": 2.92,
      "text": "Okay, any surgery in the past?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.58,
      "end_seconds": 312.07,
      "duration_seconds": 4.49,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.44,
      "end_seconds": 318.59,
      "duration_seconds": 5.15,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.84,
      "end_seconds": 326.27,
      "duration_seconds": 6.43,
      "text": "Okay, you know, so I don't think I have any, no."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.01,
      "end_seconds": 337.18,
      "duration_seconds": 10.17,
      "text": "Having listened and examined, my working impression is a thyroid storm. It could also be sepsis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.4,
      "end_seconds": 342.91,
      "duration_seconds": 4.51,
      "text": "Actually, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.65,
      "end_seconds": 370.11,
      "duration_seconds": 25.46,
      "text": "I understand the worry. At the moment I'd say it's a thyroid storm, and we'll know more once the an ECG is back. Let's book an ECG to look into fast heart rhythm. This is an emergency, you will be treated in high dependency. Please come and see me straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.77,
      "end_seconds": 375.49,
      "duration_seconds": 3.72,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.21,
      "end_seconds": 378.68,
      "duration_seconds": 1.47,
      "text": "All the best."
    }
  ]
}