    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.48,
      "end_seconds": 184.59,
      "duration_seconds": 4.11,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.01,
      "end_seconds": 191.02,
      "duration_seconds": 5.01,
      "text": "I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.46,
      "end_seconds": 203.24,
      "duration_seconds": 2.78,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.62,
      "end_seconds": 217.59,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.4,
      "end_seconds": 239.85,
      "duration_seconds": 8.45,
      "text": "okay: SpO2 98 percent on room air, pulse is 78 beats a a minute, BP is 126 over 82."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.04,
      "end_seconds": 242.47,
      "duration_seconds": 1.43,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.41,
      "end_seconds": 245.72,
      "duration_seconds": 2.31,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.0,
      "end_seconds": 252.61,
      "duration_seconds": 4.61,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.26,
      "end_seconds": 254.17,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.75,
      "end_seconds": 257.68,
      "duration_seconds": 1.93,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.22,
      "end_seconds": 279.7,
      "duration_seconds": 4.48,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.64,
      "end_seconds": 286.29,
      "duration_seconds": 1.65,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.89,
      "end_seconds": 307.21,
      "duration_seconds": 12.32,
      "text": "okay, thinking it through, the most likely explanation is a a possible stomach ulcer from anti-inflammatory tablets. Let's book a blood count to look into dyspepsia"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.21,
      "end_seconds": 311.27,
      "duration_seconds": 3.06,
      "text": "The earliest is Tuesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.84,
      "end_seconds": 313.7,
      "duration_seconds": 1.86,
      "text": "okay I'll be there"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.27,
      "end_seconds": 330.1,
      "duration_seconds": 14.83,
      "text": "We'll begin with omeprazole 20 milligrams once a day eight weeks. That should help with stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.7,
      "end_seconds": 334.3,
      "duration_seconds": 3.6,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.1,
      "end_seconds": 337.56,
      "duration_seconds": 2.46,
      "text": "That's all from me. Any questions?"
    },
