      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.52,
      "end_seconds": 38.65,
      "duration_seconds": 1.13,
      "text": "mostly moderate"
    },
    {
      "segment_id": "SEG0008",
