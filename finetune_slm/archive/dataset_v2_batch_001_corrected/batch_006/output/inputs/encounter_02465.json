      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.36,
      "end_seconds": 162.85,
      "duration_seconds": 5.49,
      "text": "I'm on diclofenac, 50 milligrams, when needed for the joint pain"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.88,
      "end_seconds": 169.52,
      "duration_seconds": 5.64,
      "text": "Are you allergic to anything? Any allergies to to medicines or foods?"
