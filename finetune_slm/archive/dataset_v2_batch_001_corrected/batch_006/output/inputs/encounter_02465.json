      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.97,
      "end_seconds": 84.57,
      "duration_seconds": 3.6,
      "text": "um, no, none that I've noticed"
