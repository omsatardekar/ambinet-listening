    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.4,
      "end_seconds": 105.98,
      "duration_seconds": 1.58,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.85,
      "end_seconds": 110.12,
      "duration_seconds": 2.27,
      "text": "My partner and our baby"
