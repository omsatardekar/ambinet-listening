      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.21,
      "end_seconds": 88.68,
      "duration_seconds": 3.47,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.78,
      "end_seconds": 91.9,
      "duration_seconds": 2.12,
      "text": "no that's been fine"
