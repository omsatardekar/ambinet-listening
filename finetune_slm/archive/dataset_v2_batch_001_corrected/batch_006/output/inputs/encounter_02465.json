    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.79,
      "end_seconds": 176.19,
      "duration_seconds": 1.4,
      "text": "any previous surgeries?"
