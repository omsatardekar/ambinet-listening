      "start_seconds": 1.19,
      "end_seconds": 5.89,
      "duration_seconds": 4.7,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 10.63,
      "duration_seconds": 3.77,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 22.56,
      "duration_seconds": 7.96,
      "text": "It's pain at night mostly. I thought it would sort itself out but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.16,
      "end_seconds": 26.88,
      "duration_seconds": 3.72,
      "text": "Right, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.29,
      "end_seconds": 31.47,
      "duration_seconds": 3.18,
      "text": "it's been like this since this morning"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 36.39,
      "duration_seconds": 3.29,
      "text": "how troublesome is it day to day?"
    },
