    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.19,
      "end_seconds": 155.37,
      "duration_seconds": 3.18,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
