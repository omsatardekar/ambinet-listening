    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.08,
      "end_seconds": 61.37,
      "duration_seconds": 7.29,
      "text": "Indigestion goes along with it, most of the the time. As for Indigestion, mostly moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.68,
      "end_seconds": 64.09,
      "duration_seconds": 2.41,
      "text": "sure how about vomiting blood?"
