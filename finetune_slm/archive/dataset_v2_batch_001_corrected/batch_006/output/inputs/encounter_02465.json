    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.0,
      "end_seconds": 131.11,
      "duration_seconds": 3.11,
      "text": "Has anyone in your family had anything serious?"
