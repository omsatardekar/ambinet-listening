{
  "schema_version": "1.0",
  "encounter_id": "02179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 5.1,
      "duration_seconds": 3.9,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.99,
      "end_seconds": 12.11,
      "duration_seconds": 1.12,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.93,
      "end_seconds": 15.35,
      "duration_seconds": 2.42,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.19,
      "end_seconds": 30.05,
      "duration_seconds": 12.86,
      "text": "Um, doctor, it's spots on my forehead and chin. It's getting on my nerves now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.83,
      "end_seconds": 34.03,
      "duration_seconds": 3.2,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.8,
      "end_seconds": 39.63,
      "duration_seconds": 3.83,
      "text": "It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.47,
      "end_seconds": 42.68,
      "duration_seconds": 1.21,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.63,
      "end_seconds": 52.72,
      "duration_seconds": 9.09,
      "text": "For about a year. Actually, I'm on spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.39,
      "end_seconds": 56.59,
      "duration_seconds": 2.2,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.46,
      "end_seconds": 59.44,
      "duration_seconds": 1.98,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.09,
      "end_seconds": 62.83,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.41,
      "end_seconds": 66.9,
      "duration_seconds": 2.49,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.61,
      "end_seconds": 70.8,
      "duration_seconds": 3.19,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.28,
      "end_seconds": 73.4,
      "duration_seconds": 1.12,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.48,
      "end_seconds": 79.27,
      "duration_seconds": 3.79,
      "text": "What about oily skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.79,
      "end_seconds": 84.04,
      "duration_seconds": 3.25,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.75,
      "end_seconds": 96.69,
      "duration_seconds": 2.94,
      "text": "Any painful cysts or low mood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.57,
      "end_seconds": 102.65,
      "duration_seconds": 5.08,
      "text": "Yeah, no, no painful cysts or low mood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 107.1,
      "duration_seconds": 2.83,
      "text": "Any scarring or irregular periods at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.87,
      "end_seconds": 113.07,
      "duration_seconds": 4.2,
      "text": "No scarring or irregular periods, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.77,
      "end_seconds": 119.3,
      "duration_seconds": 4.53,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.56,
      "end_seconds": 123.23,
      "duration_seconds": 2.67,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.81,
      "end_seconds": 130.44,
      "duration_seconds": 3.63,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.18,
      "end_seconds": 134.44,
      "duration_seconds": 2.26,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.45,
      "end_seconds": 140.52,
      "duration_seconds": 4.07,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.19,
      "end_seconds": 146.17,
      "duration_seconds": 4.98,
      "text": "I have an irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.1,
      "end_seconds": 153.94,
      "duration_seconds": 2.84,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.47,
      "end_seconds": 165.89,
      "duration_seconds": 11.42,
      "text": "Heart failure, for about ten years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.47,
      "end_seconds": 178.44,
      "duration_seconds": 1.97,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.44,
      "end_seconds": 183.04,
      "duration_seconds": 2.6,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.75,
      "end_seconds": 186.71,
      "duration_seconds": 1.96,
      "text": "Alright, are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.39,
      "end_seconds": 191.54,
      "duration_seconds": 3.15,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.63,
      "end_seconds": 195.26,
      "duration_seconds": 2.63,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.62,
      "end_seconds": 204.0,
      "duration_seconds": 7.38,
      "text": "Well, I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.66,
      "end_seconds": 209.31,
      "duration_seconds": 4.65,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.53,
      "end_seconds": 213.74,
      "duration_seconds": 3.21,
      "text": "I mean, no allergies at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.59,
      "end_seconds": 218.22,
      "duration_seconds": 2.63,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.12,
      "end_seconds": 228.38,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 259.82,
      "duration_seconds": 11.06,
      "text": "Okay: respiratory rate 18, pulse is 70 beats a minute, SpO2 97 percent on room air, BP is 120 over 69, temp 37.0 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.34,
      "end_seconds": 266.43,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.97,
      "end_seconds": 269.31,
      "duration_seconds": 2.34,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.28,
      "end_seconds": 276.76,
      "duration_seconds": 4.48,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.55,
      "end_seconds": 281.46,
      "duration_seconds": 2.91,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 305.21,
      "duration_seconds": 5.92,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.46,
      "end_seconds": 312.85,
      "duration_seconds": 2.39,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.57,
      "end_seconds": 331.45,
      "duration_seconds": 7.88,
      "text": "I'd like you to take benzoyl peroxide gel, 5%, once a day, eight weeks. That's for acne."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.1,
      "end_seconds": 338.88,
      "duration_seconds": 1.78,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.48,
      "end_seconds": 353.89,
      "duration_seconds": 13.41,
      "text": "Wash gently twice a day and don't squeeze the spots. Come back or go to emergency straight away if the symptoms get worse. Please come and see me in eight weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 355.76,
      "end_seconds": 359.66,
      "duration_seconds": 3.9,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.03,
      "end_seconds": 363.4,
      "duration_seconds": 2.37,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.03,
      "end_seconds": 368.43,
      "duration_seconds": 4.4,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.45,
      "end_seconds": 374.31,
      "duration_seconds": 3.86,
      "text": "Oh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.35,
      "end_seconds": 377.8,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}