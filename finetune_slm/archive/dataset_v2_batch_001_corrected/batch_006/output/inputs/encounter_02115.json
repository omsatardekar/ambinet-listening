{
  "schema_version": "1.0",
  "encounter_id": "02115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.19,
      "duration_seconds": 4.97,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 11.05,
      "duration_seconds": 3.77,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 19.08,
      "duration_seconds": 6.95,
      "text": "Mainly very heavy periods. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.84,
      "end_seconds": 24.26,
      "duration_seconds": 3.42,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.98,
      "end_seconds": 29.63,
      "duration_seconds": 3.65,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.97,
      "end_seconds": 34.49,
      "duration_seconds": 3.52,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.51,
      "end_seconds": 38.93,
      "duration_seconds": 2.42,
      "text": "Double protection helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.67,
      "end_seconds": 42.64,
      "duration_seconds": 1.97,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.65,
      "end_seconds": 52.17,
      "duration_seconds": 8.52,
      "text": "Dizziness goes along with it, most of the time. The dizziness? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.39,
      "end_seconds": 57.21,
      "duration_seconds": 3.82,
      "text": "And what about weight loss, fainting or pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.92,
      "end_seconds": 62.19,
      "duration_seconds": 3.27,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.38,
      "end_seconds": 68.2,
      "duration_seconds": 3.82,
      "text": "Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.53,
      "end_seconds": 71.07,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.12,
      "end_seconds": 90.78,
      "duration_seconds": 2.66,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.57,
      "end_seconds": 95.32,
      "duration_seconds": 3.75,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 99.31,
      "duration_seconds": 2.73,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.96,
      "end_seconds": 106.68,
      "duration_seconds": 5.72,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.6,
      "end_seconds": 112.7,
      "duration_seconds": 4.1,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.28,
      "end_seconds": 115.48,
      "duration_seconds": 1.2,
      "text": "Yes, kiwi."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.23,
      "end_seconds": 117.55,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 121.77,
      "duration_seconds": 2.32,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.67,
      "end_seconds": 144.74,
      "duration_seconds": 4.07,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.51,
      "end_seconds": 149.77,
      "duration_seconds": 3.26,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.19,
      "end_seconds": 158.16,
      "duration_seconds": 2.97,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.69,
      "end_seconds": 162.51,
      "duration_seconds": 2.82,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.14,
      "end_seconds": 176.92,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.36,
      "end_seconds": 188.78,
      "duration_seconds": 2.42,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 207.95,
      "duration_seconds": 6.35,
      "text": "Okay: pressure 129 over 88, saturation 96 percent. And heart rate 120, respiratory rate 19."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.8,
      "end_seconds": 213.81,
      "duration_seconds": 4.01,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.78,
      "end_seconds": 217.18,
      "duration_seconds": 2.4,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.77,
      "end_seconds": 232.54,
      "duration_seconds": 5.77,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.92,
      "end_seconds": 246.15,
      "duration_seconds": 10.23,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, it fits best with heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.57,
      "end_seconds": 249.68,
      "duration_seconds": 2.11,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.81,
      "end_seconds": 259.26,
      "duration_seconds": 8.45,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.77,
      "end_seconds": 289.78,
      "duration_seconds": 14.01,
      "text": "A ferritin level is what I'd like next, for heavy periods. I'm going to put you on tranexamic acid, 1 gram, three times a day, during periods. It's for heavy periods."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.36,
      "end_seconds": 293.15,
      "duration_seconds": 1.79,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.83,
      "end_seconds": 310.35,
      "duration_seconds": 15.52,
      "text": "Keep a pad count diary. A blood count is something we might do if this doesn't improve in two weeks. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.27,
      "end_seconds": 314.17,
      "duration_seconds": 1.9,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.88,
      "end_seconds": 322.4,
      "duration_seconds": 6.52,
      "text": "Book a review after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.21,
      "end_seconds": 325.4,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.1,
      "end_seconds": 328.66,
      "duration_seconds": 2.56,
      "text": "Alright, have a good day."
    }
  ]
}