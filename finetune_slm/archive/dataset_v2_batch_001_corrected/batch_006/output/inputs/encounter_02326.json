{
  "schema_version": "1.0",
  "encounter_id": "02326",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.79,
      "duration_seconds": 3.95,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.99,
      "end_seconds": 13.65,
      "duration_seconds": 4.66,
      "text": "So, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.42,
      "end_seconds": 22.63,
      "duration_seconds": 7.21,
      "text": "Honestly, it's electric shock pains in my cheek, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.23,
      "end_seconds": 26.15,
      "duration_seconds": 2.92,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.92,
      "end_seconds": 30.35,
      "duration_seconds": 3.43,
      "text": "Erm, it's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.67,
      "end_seconds": 38.35,
      "duration_seconds": 3.68,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.57,
      "end_seconds": 50.21,
      "duration_seconds": 10.64,
      "text": "I'd call it severe. Oh, and pain lasting seconds. Oh, as for pain lasting seconds, honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.91,
      "end_seconds": 69.34,
      "duration_seconds": 3.43,
      "text": "Have you had hearing loss, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.54,
      "end_seconds": 72.86,
      "duration_seconds": 2.32,
      "text": "No hearing loss, thankfully."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 77.37,
      "duration_seconds": 3.06,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.53,
      "end_seconds": 80.11,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.06,
      "end_seconds": 84.98,
      "duration_seconds": 2.92,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.76,
      "end_seconds": 88.98,
      "duration_seconds": 3.22,
      "text": "Um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.77,
      "end_seconds": 104.45,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.43,
      "end_seconds": 108.2,
      "duration_seconds": 2.77,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.43,
      "end_seconds": 111.65,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.2,
      "end_seconds": 117.48,
      "duration_seconds": 4.28,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.25,
      "end_seconds": 123.0,
      "duration_seconds": 3.75,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.8,
      "end_seconds": 128.11,
      "duration_seconds": 3.31,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.75,
      "end_seconds": 148.58,
      "duration_seconds": 3.83,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.33,
      "end_seconds": 153.49,
      "duration_seconds": 3.16,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.79,
      "end_seconds": 162.47,
      "duration_seconds": 7.68,
      "text": "What conditions have you been treated for in the past? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.87,
      "end_seconds": 174.8,
      "duration_seconds": 10.93,
      "text": "Uh, I have high cholesterol. I told my wife I'd come today. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.95,
      "end_seconds": 178.33,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.36,
      "end_seconds": 183.79,
      "duration_seconds": 4.43,
      "text": "Rosuvastatin. I take it 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.31,
      "end_seconds": 196.19,
      "duration_seconds": 4.88,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.81,
      "end_seconds": 209.21,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.97,
      "end_seconds": 243.43,
      "duration_seconds": 13.46,
      "text": "Okay: BMI works out to 16.9, temperature 36.7, height 185 centimetres. And blood pressure 128 over 81, pulse 85, oxygen saturation is 99 percent, weight 58 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.44,
      "end_seconds": 247.03,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 250.27,
      "duration_seconds": 2.64,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.67,
      "end_seconds": 256.37,
      "duration_seconds": 3.7,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.24,
      "end_seconds": 258.82,
      "duration_seconds": 1.58,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 262.9,
      "duration_seconds": 2.31,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.93,
      "end_seconds": 278.89,
      "duration_seconds": 5.96,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.83,
      "end_seconds": 312.26,
      "duration_seconds": 28.43,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. The most likely explanation is trigeminal neuralgia. I want an MRI scan of the head done, that's for facial pain. Let's use carbamazepine, 100 milligrams, twice a day, titrate. That should help with nerve pain. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.51,
      "end_seconds": 319.27,
      "duration_seconds": 6.76,
      "text": "Mm-hmm. I'll also refer you to the neurology clinic. Come back in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.56,
      "end_seconds": 327.23,
      "duration_seconds": 1.67,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.21,
      "end_seconds": 333.83,
      "duration_seconds": 4.62,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.93,
      "end_seconds": 337.42,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}