{
  "schema_version": "1.0",
  "encounter_id": "02487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 7.19,
      "duration_seconds": 6.09,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 12.22,
      "duration_seconds": 3.78,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.9,
      "end_seconds": 19.69,
      "duration_seconds": 5.79,
      "text": "It's sudden severe pain on the right side of my pelvis, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.44,
      "end_seconds": 23.67,
      "duration_seconds": 2.23,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.3,
      "end_seconds": 36.07,
      "duration_seconds": 10.77,
      "text": "It's been about three months, I'm fairly sure. Oh, and pain that comes in waves. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.36,
      "end_seconds": 37.13,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.33,
      "end_seconds": 45.85,
      "duration_seconds": 3.52,
      "text": "And I've been feeling faint as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.69,
      "end_seconds": 52.24,
      "duration_seconds": 4.55,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.32,
      "end_seconds": 58.35,
      "duration_seconds": 5.03,
      "text": "It's mild, honestly. It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.2,
      "end_seconds": 67.42,
      "duration_seconds": 8.22,
      "text": "Have you had sudden severe pain on the right side of your pelvis before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.6,
      "end_seconds": 76.2,
      "duration_seconds": 7.6,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.25,
      "end_seconds": 79.99,
      "duration_seconds": 2.74,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.19,
      "end_seconds": 94.84,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.62,
      "end_seconds": 115.12,
      "duration_seconds": 9.5,
      "text": "Okay: SpO2 96 percent on room air, BP is 126 over 70. And respiratory rate 16, heart rate 110."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.85,
      "end_seconds": 118.24,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.35,
      "end_seconds": 121.89,
      "duration_seconds": 2.54,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.03,
      "end_seconds": 126.28,
      "duration_seconds": 3.25,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.73,
      "end_seconds": 129.85,
      "duration_seconds": 2.12,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.47,
      "end_seconds": 145.07,
      "duration_seconds": 5.6,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.21,
      "end_seconds": 151.31,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 166.44,
      "duration_seconds": 2.7,
      "text": "Any discharge, fever or vaginal bleeding?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.24,
      "end_seconds": 170.72,
      "duration_seconds": 2.48,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.33,
      "end_seconds": 174.55,
      "duration_seconds": 2.22,
      "text": "Any sign of missed period?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.11,
      "end_seconds": 179.73,
      "duration_seconds": 3.62,
      "text": "Not that I've noticed, no missed period."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.5,
      "end_seconds": 183.86,
      "duration_seconds": 3.36,
      "text": "Alright, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.34,
      "end_seconds": 186.24,
      "duration_seconds": 0.9,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.54,
      "end_seconds": 189.72,
      "duration_seconds": 2.18,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.01,
      "end_seconds": 194.1,
      "duration_seconds": 3.09,
      "text": "Hmm, no problems with breathing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.27,
      "end_seconds": 202.88,
      "duration_seconds": 3.61,
      "text": "Right, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.84,
      "end_seconds": 212.88,
      "duration_seconds": 8.04,
      "text": "I mean, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.34,
      "end_seconds": 223.28,
      "duration_seconds": 2.94,
      "text": "Right, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.06,
      "end_seconds": 226.71,
      "duration_seconds": 2.65,
      "text": "Yeah, I've had eczema, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.33,
      "end_seconds": 236.43,
      "duration_seconds": 9.1,
      "text": "Yes, eczema is known to us, good to have that clear. Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.84,
      "end_seconds": 240.79,
      "duration_seconds": 2.95,
      "text": "Yes, naproxen. I get a rash."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.08,
      "end_seconds": 256.88,
      "duration_seconds": 4.8,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.74,
      "end_seconds": 270.07,
      "duration_seconds": 11.33,
      "text": "I'm vegetarian and have been for years. I work in accounts at a hospital. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.39,
      "end_seconds": 273.35,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.98,
      "end_seconds": 283.61,
      "duration_seconds": 9.63,
      "text": "Ah, I'm on hydrocortisone cream, when needed. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.28,
      "end_seconds": 289.08,
      "duration_seconds": 4.8,
      "text": "I'm going to order a pregnancy test, for pelvic pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.14,
      "end_seconds": 292.2,
      "duration_seconds": 1.06,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.63,
      "end_seconds": 319.51,
      "duration_seconds": 25.88,
      "text": "I'm going to order an urgent pelvic ultrasound, for possible torsion. You need an emergency scan and probably surgery today. A short walk every day, even twenty minutes, will help more than you'd think. I'm going to send a referral to the gynaecology team. Do get help quickly if the symptoms get worse. See me again straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.01,
      "end_seconds": 323.18,
      "duration_seconds": 2.17,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.13,
      "end_seconds": 326.96,
      "duration_seconds": 2.83,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.41,
      "end_seconds": 331.49,
      "duration_seconds": 3.08,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}