{
  "schema_version": "1.0",
  "encounter_id": "02190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 2.92,
      "duration_seconds": 1.63,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.85,
      "end_seconds": 5.92,
      "duration_seconds": 1.07,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.73,
      "end_seconds": 9.98,
      "duration_seconds": 3.25,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.45,
      "end_seconds": 16.39,
      "duration_seconds": 4.94,
      "text": "Good, that'll be useful. Pull up a chair. What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.46,
      "end_seconds": 21.51,
      "duration_seconds": 3.05,
      "text": "We came because of very heavy periods."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.18,
      "end_seconds": 24.65,
      "duration_seconds": 2.47,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.85,
      "end_seconds": 29.75,
      "duration_seconds": 3.9,
      "text": "It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 30.26,
      "end_seconds": 37.28,
      "duration_seconds": 7.02,
      "text": "It's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.1,
      "end_seconds": 41.53,
      "duration_seconds": 3.43,
      "text": "Fluoxetine, every morning for my mood."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.08,
      "end_seconds": 44.18,
      "duration_seconds": 2.1,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.72,
      "end_seconds": 45.66,
      "duration_seconds": 0.94,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.36,
      "end_seconds": 51.0,
      "duration_seconds": 3.64,
      "text": "Alright, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.94,
      "end_seconds": 55.92,
      "duration_seconds": 2.98,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.66,
      "end_seconds": 61.43,
      "duration_seconds": 1.77,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.18,
      "end_seconds": 68.31,
      "duration_seconds": 6.13,
      "text": "Um, you know, I get some relief from double protection."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.91,
      "end_seconds": 72.06,
      "duration_seconds": 2.15,
      "text": "Have you been feeling exhausted?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.96,
      "end_seconds": 76.4,
      "duration_seconds": 2.44,
      "text": "Yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.95,
      "end_seconds": 81.24,
      "duration_seconds": 3.29,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 101.81,
      "duration_seconds": 15.68,
      "text": "Maybe a three out of ten on a bad day. As for dizziness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.77,
      "end_seconds": 113.17,
      "duration_seconds": 10.4,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.32,
      "end_seconds": 122.79,
      "duration_seconds": 8.47,
      "text": "It's worse with standing. It just comes and goes. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 124.24,
      "end_seconds": 126.54,
      "duration_seconds": 2.3,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.44,
      "end_seconds": 140.69,
      "duration_seconds": 3.25,
      "text": "Have you noticed pain, weight loss or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.42,
      "end_seconds": 144.6,
      "duration_seconds": 2.18,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.29,
      "end_seconds": 147.91,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 154.67,
      "duration_seconds": 2.72,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.5,
      "end_seconds": 159.28,
      "duration_seconds": 3.78,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.0,
      "end_seconds": 162.94,
      "duration_seconds": 2.94,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 166.85,
      "duration_seconds": 2.07,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.74,
      "end_seconds": 171.56,
      "duration_seconds": 3.82,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.31,
      "end_seconds": 175.05,
      "duration_seconds": 2.74,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.87,
      "end_seconds": 180.22,
      "duration_seconds": 4.35,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.67,
      "end_seconds": 185.33,
      "duration_seconds": 3.66,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.54,
      "end_seconds": 191.18,
      "duration_seconds": 4.64,
      "text": "I have anxiety, for five years. Yes, depression."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.09,
      "end_seconds": 196.14,
      "duration_seconds": 3.05,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.83,
      "end_seconds": 202.92,
      "duration_seconds": 5.09,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 207.98,
      "duration_seconds": 4.04,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.99,
      "end_seconds": 212.54,
      "duration_seconds": 2.55,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 220.93,
      "end_seconds": 229.63,
      "duration_seconds": 8.7,
      "text": "Doctor, I've got the readings for you. SpO2 98 percent on room air, pulse is 115 beats a minute, pressure 114 over 73."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.49,
      "end_seconds": 231.44,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.07,
      "end_seconds": 236.17,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.25,
      "end_seconds": 239.88,
      "duration_seconds": 1.63,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.86,
      "end_seconds": 245.29,
      "duration_seconds": 3.43,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.77,
      "end_seconds": 262.47,
      "duration_seconds": 5.7,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.04,
      "end_seconds": 276.79,
      "duration_seconds": 9.75,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: This is probably heavy periods with iron deficiency. Another possibility is fibroids."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.72,
      "end_seconds": 280.17,
      "duration_seconds": 1.45,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.17,
      "end_seconds": 316.25,
      "duration_seconds": 35.08,
      "text": "I can't promise yet, but most people with heavy periods with iron deficiency do well once it's treated properly. I'm going to order a blood count, for heavy periods. I'm going to order a pelvic ultrasound, for heavy periods. I'm prescribing ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. It's for iron deficiency. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.11,
      "end_seconds": 340.77,
      "duration_seconds": 22.66,
      "text": "I'd like you to take tranexamic acid, 1 gram, three times a day, during periods. You take it by mouth. That should help with heavy periods. Keep a pad count diary. One warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.53,
      "end_seconds": 345.56,
      "duration_seconds": 3.03,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}