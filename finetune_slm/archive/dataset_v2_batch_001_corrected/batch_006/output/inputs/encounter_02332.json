{
  "schema_version": "1.0",
  "encounter_id": "02332",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.21,
      "duration_seconds": 3.46,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 12.98,
      "duration_seconds": 4.23,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.24,
      "end_seconds": 22.3,
      "duration_seconds": 8.06,
      "text": "Well, I've been having heavy bleeding. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.86,
      "end_seconds": 26.71,
      "duration_seconds": 2.85,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.78,
      "end_seconds": 32.11,
      "duration_seconds": 3.33,
      "text": "Well, for three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.49,
      "end_seconds": 43.83,
      "duration_seconds": 3.34,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.02,
      "end_seconds": 58.65,
      "duration_seconds": 13.63,
      "text": "I'm vegetarian and have been for years. No, I share a house with my brother. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 62.62,
      "duration_seconds": 3.16,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.72,
      "end_seconds": 67.96,
      "duration_seconds": 2.24,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.62,
      "end_seconds": 76.93,
      "duration_seconds": 4.31,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.45,
      "end_seconds": 82.11,
      "duration_seconds": 3.66,
      "text": "I'm allergic to walnuts, I get hives."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.25,
      "end_seconds": 102.96,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.42,
      "end_seconds": 107.43,
      "duration_seconds": 3.01,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 123.34,
      "duration_seconds": 3.0,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 126.13,
      "duration_seconds": 1.17,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.58,
      "end_seconds": 131.44,
      "duration_seconds": 3.86,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.39,
      "end_seconds": 135.42,
      "duration_seconds": 3.03,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.25,
      "end_seconds": 141.71,
      "duration_seconds": 4.46,
      "text": "Any loss of consciousness, head injury or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.38,
      "end_seconds": 148.63,
      "duration_seconds": 4.25,
      "text": "Well, you know, none of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.32,
      "end_seconds": 154.21,
      "duration_seconds": 4.89,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.07,
      "end_seconds": 160.01,
      "duration_seconds": 3.94,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 163.07,
      "duration_seconds": 2.4,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.14,
      "end_seconds": 176.83,
      "duration_seconds": 2.69,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.29,
      "end_seconds": 198.29,
      "duration_seconds": 9.0,
      "text": "Okay: pressure 115 over 77, respiratory rate 20, SpO2 99 percent on room air, temperature is 36.5 degrees, pulse 123."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.46,
      "end_seconds": 204.54,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.88,
      "end_seconds": 214.23,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.23,
      "end_seconds": 218.58,
      "duration_seconds": 3.35,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.36,
      "end_seconds": 239.42,
      "duration_seconds": 6.06,
      "text": "There is a wound with bone visible and the foot is cool with no pulse."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.65,
      "end_seconds": 251.47,
      "duration_seconds": 8.82,
      "text": "You can sit up now. Right, here's what I'm thinking. My working impression is an open fracture with a compromised blood supply."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.32,
      "end_seconds": 254.38,
      "duration_seconds": 2.06,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.69,
      "end_seconds": 293.75,
      "duration_seconds": 38.06,
      "text": "I can't promise yet, but most people with an open fracture with a compromised blood supply do well once it's treated properly. I'm going to order an urgent X-ray, for open fracture. I'm prescribing co-amoxiclav, 1.2 grams, now, single dose. That's for open fracture. Keep still, I am splinting the leg and sending you to theatre now. Cut down on salt and fried food for now, it really does make a difference. See me again straight away."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.64,
      "end_seconds": 298.87,
      "duration_seconds": 3.23,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.93,
      "end_seconds": 303.96,
      "duration_seconds": 3.03,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.86,
      "end_seconds": 307.25,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}