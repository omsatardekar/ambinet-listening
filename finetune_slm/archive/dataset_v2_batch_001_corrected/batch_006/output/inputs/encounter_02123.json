{
  "schema_version": "1.0",
  "encounter_id": "02123",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 4.38,
      "duration_seconds": 3.83,
      "text": "So, hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.12,
      "end_seconds": 13.12,
      "duration_seconds": 8.0,
      "text": "Good afternoon, um, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.64,
      "end_seconds": 19.16,
      "duration_seconds": 4.52,
      "text": "Absolutely, come and sit beside them. What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.2,
      "end_seconds": 28.85,
      "duration_seconds": 6.65,
      "text": "It's heavy bleeding, mostly. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.49,
      "end_seconds": 33.3,
      "duration_seconds": 2.81,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.96,
      "end_seconds": 39.89,
      "duration_seconds": 5.93,
      "text": "Sorry, what was I saying, for about three months, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.02,
      "end_seconds": 42.9,
      "duration_seconds": 1.88,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.56,
      "end_seconds": 54.94,
      "duration_seconds": 10.38,
      "text": "Uh, pressure helps a bit. Oh, and severe pain. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.77,
      "end_seconds": 61.39,
      "duration_seconds": 5.62,
      "text": "Is it it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.28,
      "end_seconds": 65.07,
      "duration_seconds": 2.79,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.76,
      "end_seconds": 70.65,
      "duration_seconds": 4.89,
      "text": "So, any a bone sticking out of your lower leg as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.61,
      "end_seconds": 74.1,
      "duration_seconds": 2.49,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.09,
      "end_seconds": 78.41,
      "duration_seconds": 3.32,
      "text": "any numbness in the foot as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.39,
      "end_seconds": 81.51,
      "duration_seconds": 1.12,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.92,
      "end_seconds": 85.21,
      "duration_seconds": 2.29,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.69,
      "end_seconds": 90.68,
      "duration_seconds": 3.99,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.45,
      "end_seconds": 106.83,
      "duration_seconds": 3.38,
      "text": "alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.38,
      "end_seconds": 113.25,
      "duration_seconds": 4.87,
      "text": "I've had heart failure for two years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.21,
      "end_seconds": 115.77,
      "duration_seconds": 1.56,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.51,
      "end_seconds": 119.39,
      "duration_seconds": 2.88,
      "text": "COPD, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.18,
      "end_seconds": 130.92,
      "duration_seconds": 10.74,
      "text": "Right, yes, heart failure and COPD are known to us, good to have that clear. Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 145.48,
      "duration_seconds": 12.79,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.5,
      "end_seconds": 153.02,
      "duration_seconds": 5.52,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.56,
      "end_seconds": 156.55,
      "duration_seconds": 2.99,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.7,
      "end_seconds": 161.62,
      "duration_seconds": 3.92,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.27,
      "end_seconds": 166.19,
      "duration_seconds": 2.92,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.59,
      "end_seconds": 178.09,
      "duration_seconds": 2.5,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.08,
      "end_seconds": 184.25,
      "duration_seconds": 5.17,
      "text": "Metoprolol. I take it 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.9,
      "end_seconds": 188.78,
      "duration_seconds": 3.88,
      "text": "Alright, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.42,
      "end_seconds": 192.51,
      "duration_seconds": 2.09,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.89,
      "end_seconds": 199.13,
      "duration_seconds": 5.24,
      "text": "Have you noticed head injury, chest pain or loss of consciousness?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.22,
      "end_seconds": 203.35,
      "duration_seconds": 2.13,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 208.59,
      "duration_seconds": 4.65,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.6,
      "end_seconds": 212.36,
      "duration_seconds": 2.76,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 216.77,
      "duration_seconds": 2.45,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.62,
      "end_seconds": 219.25,
      "duration_seconds": 1.63,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.76,
      "end_seconds": 222.88,
      "duration_seconds": 3.12,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.57,
      "end_seconds": 236.2,
      "duration_seconds": 2.63,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.01,
      "end_seconds": 259.26,
      "duration_seconds": 11.25,
      "text": "Okay: oxygen saturation is 98 percent, pulse is 111 beats a minute, blood pressure 121 over 85. And temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.66,
      "end_seconds": 265.34,
      "duration_seconds": 4.68,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 278.36,
      "end_seconds": 280.09,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.38,
      "end_seconds": 284.31,
      "duration_seconds": 2.93,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.3,
      "end_seconds": 301.6,
      "duration_seconds": 6.3,
      "text": "There is a wound with bone visible and the foot is cool with no pulse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.01,
      "end_seconds": 319.8,
      "duration_seconds": 12.79,
      "text": "all finished, thank you let me tell you where I've got to it points towards an open fracture with a compromised blood supply i can't rule out a vascular injury yet"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.6,
      "end_seconds": 326.03,
      "duration_seconds": 3.43,
      "text": "I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.46,
      "end_seconds": 345.45,
      "duration_seconds": 17.99,
      "text": "It's reasonable to be concerned, but right now an open fracture with a compromised blood supply is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had heavy bleeding for about three months, and no head injury or chest pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 346.01,
      "end_seconds": 348.38,
      "duration_seconds": 2.37,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.46,
      "end_seconds": 364.22,
      "duration_seconds": 13.76,
      "text": "An urgent X-ray is what I'd like next, for open fracture. I want blood tests done, that's for pre-operative. You'll be taking co-amoxiclav, 1.2 grams, now, single dose. That's for open fracture."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 365.17,
      "end_seconds": 369.14,
      "duration_seconds": 3.97,
      "text": "should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.47,
      "end_seconds": 397.91,
      "duration_seconds": 25.44,
      "text": "Keep still, I am splinting the leg and sending you to theatre now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.04,
      "end_seconds": 399.74,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.47,
      "end_seconds": 403.92,
      "duration_seconds": 2.45,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.94,
      "end_seconds": 408.48,
      "duration_seconds": 3.54,
      "text": "no, that's all. Thanks a lot"
    }
  ]
}