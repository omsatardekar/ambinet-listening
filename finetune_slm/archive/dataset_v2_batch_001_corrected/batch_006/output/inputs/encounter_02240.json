{
  "schema_version": "1.0",
  "encounter_id": "02240",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 2.82,
      "duration_seconds": 2.2,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.06,
      "end_seconds": 5.21,
      "duration_seconds": 1.15,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 7.7,
      "duration_seconds": 1.97,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.61,
      "end_seconds": 14.25,
      "duration_seconds": 5.64,
      "text": "Yeah, it's constipation then loose stools. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.35,
      "end_seconds": 16.94,
      "duration_seconds": 1.59,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.29,
      "end_seconds": 19.81,
      "duration_seconds": 1.52,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.35,
      "end_seconds": 22.68,
      "duration_seconds": 2.33,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.05,
      "end_seconds": 25.13,
      "duration_seconds": 1.08,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.58,
      "end_seconds": 29.6,
      "duration_seconds": 3.02,
      "text": "Has there been a low fever too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.36,
      "end_seconds": 34.3,
      "duration_seconds": 2.94,
      "text": "Yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.98,
      "end_seconds": 39.9,
      "duration_seconds": 4.92,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.29,
      "end_seconds": 43.27,
      "duration_seconds": 1.98,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.31,
      "end_seconds": 47.28,
      "duration_seconds": 1.97,
      "text": "Have you been feeling bloated?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.18,
      "end_seconds": 49.92,
      "duration_seconds": 1.74,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.1,
      "end_seconds": 55.55,
      "duration_seconds": 4.45,
      "text": "Any blood in the stool, vomiting or urinary symptoms?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.04,
      "end_seconds": 63.99,
      "duration_seconds": 6.95,
      "text": "No blood in the stool, vomiting or urinary symptoms, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 66.91,
      "duration_seconds": 1.87,
      "text": "What about weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.86,
      "end_seconds": 70.54,
      "duration_seconds": 2.68,
      "text": "I haven't noticed any weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.33,
      "end_seconds": 74.12,
      "duration_seconds": 2.79,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.81,
      "end_seconds": 76.28,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.86,
      "end_seconds": 80.08,
      "duration_seconds": 3.22,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.73,
      "end_seconds": 84.13,
      "duration_seconds": 2.4,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.89,
      "end_seconds": 87.33,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.34,
      "end_seconds": 97.93,
      "duration_seconds": 4.59,
      "text": "I have acid reflux, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.83,
      "end_seconds": 104.69,
      "duration_seconds": 5.86,
      "text": "Mm, okay. Yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.58,
      "end_seconds": 114.53,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.39,
      "end_seconds": 118.88,
      "duration_seconds": 3.49,
      "text": "It's lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.59,
      "end_seconds": 124.41,
      "duration_seconds": 3.82,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.29,
      "end_seconds": 127.89,
      "duration_seconds": 1.6,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.17,
      "end_seconds": 131.46,
      "duration_seconds": 2.29,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.03,
      "end_seconds": 140.03,
      "duration_seconds": 7.0,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.46,
      "end_seconds": 143.41,
      "duration_seconds": 1.95,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.85,
      "end_seconds": 146.35,
      "duration_seconds": 1.5,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.25,
      "end_seconds": 149.6,
      "duration_seconds": 1.35,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.67,
      "end_seconds": 154.61,
      "duration_seconds": 2.94,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 158.54,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.24,
      "end_seconds": 163.98,
      "duration_seconds": 3.74,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.67,
      "end_seconds": 167.71,
      "duration_seconds": 3.04,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.8,
      "end_seconds": 174.17,
      "duration_seconds": 4.37,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.75,
      "end_seconds": 188.53,
      "duration_seconds": 2.78,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 200.31,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.8,
      "end_seconds": 217.27,
      "duration_seconds": 7.47,
      "text": "Okay: pulse is 95 beats a minute, blood pressure 112 over 69, temp 38.7 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.79,
      "end_seconds": 220.16,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.07,
      "end_seconds": 223.06,
      "duration_seconds": 1.99,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.24,
      "end_seconds": 228.12,
      "duration_seconds": 2.88,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.07,
      "end_seconds": 232.91,
      "duration_seconds": 2.84,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 254.4,
      "duration_seconds": 5.18,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 266.05,
      "duration_seconds": 8.21,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, this is probably acute diverticulitis."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.79,
      "end_seconds": 270.73,
      "duration_seconds": 2.94,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.6,
      "end_seconds": 281.36,
      "duration_seconds": 8.76,
      "text": "Nothing I've seen today points to an emergency. It looks like acute diverticulitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.66,
      "end_seconds": 297.16,
      "duration_seconds": 3.5,
      "text": "Let's get blood tests, for abdominal pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 298.98,
      "end_seconds": 301.62,
      "duration_seconds": 2.64,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.27,
      "end_seconds": 304.27,
      "duration_seconds": 1.0,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.65,
      "end_seconds": 333.72,
      "duration_seconds": 28.07,
      "text": "Let's book a CT scan to look into left iliac fossa pain. It's a routine test and it'll give us a much clearer picture. We'll begin with co-amoxiclav, 625 milligrams, three times a day, five days. You take it by mouth. That's for diverticulitis. Drink plenty and start with a light diet. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.62,
      "end_seconds": 336.95,
      "duration_seconds": 2.33,
      "text": "Thank you, that's helpful."
    }
  ]
}