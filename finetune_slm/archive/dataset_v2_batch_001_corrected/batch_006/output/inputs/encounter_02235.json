{
  "schema_version": "1.0",
  "encounter_id": "02235",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.9,
      "duration_seconds": 3.64,
      "text": "Right, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.96,
      "end_seconds": 10.54,
      "duration_seconds": 4.58,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.17,
      "end_seconds": 17.9,
      "duration_seconds": 3.73,
      "text": "doctor, uh, thank you for seeing us"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.51,
      "end_seconds": 22.51,
      "duration_seconds": 4.0,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.21,
      "end_seconds": 31.55,
      "duration_seconds": 8.34,
      "text": "Mm, it's a back that has got shorter. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.24,
      "end_seconds": 35.69,
      "duration_seconds": 3.45,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.5,
      "end_seconds": 45.18,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.01,
      "end_seconds": 63.51,
      "duration_seconds": 8.5,
      "text": "Okay: BP is 122 over 75, height 152 centimetres, weight 66 kilos, respiratory rate 15, pulse 81, saturation 99 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.36,
      "end_seconds": 81.58,
      "duration_seconds": 1.22,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.98,
      "end_seconds": 90.5,
      "duration_seconds": 7.52,
      "text": "So, you know, about... well, one week. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 95.43,
      "duration_seconds": 4.45,
      "text": "right, right how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.14,
      "end_seconds": 98.98,
      "duration_seconds": 1.84,
      "text": "I'd call it severe"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.74,
      "end_seconds": 104.31,
      "duration_seconds": 3.57,
      "text": "any a wrist broken in a slip as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.06,
      "end_seconds": 118.4,
      "duration_seconds": 13.34,
      "text": "Mm, uh, yes, about the same, one week. A dull ache in my back was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.02,
      "end_seconds": 124.05,
      "duration_seconds": 5.03,
      "text": "Have you had any bladder problems, fever, weight loss or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.61,
      "end_seconds": 132.45,
      "duration_seconds": 3.84,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.02,
      "end_seconds": 138.03,
      "duration_seconds": 5.01,
      "text": "Hm, okay. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.93,
      "end_seconds": 141.32,
      "duration_seconds": 2.39,
      "text": "no, nothing like that that"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.92,
      "end_seconds": 146.62,
      "duration_seconds": 3.7,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.18,
      "end_seconds": 149.2,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.65,
      "end_seconds": 159.18,
      "duration_seconds": 2.53,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 162.16,
      "duration_seconds": 1.1,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.16,
      "end_seconds": 167.06,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.88,
      "end_seconds": 172.22,
      "duration_seconds": 3.34,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.11,
      "end_seconds": 177.14,
      "duration_seconds": 3.03,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.84,
      "end_seconds": 197.11,
      "duration_seconds": 19.27,
      "text": "Yes, you know, I had my appendix taken out, when I was in my twenties. I'm not great at remembering details, so bear with me. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.09,
      "end_seconds": 201.42,
      "duration_seconds": 3.33,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.2,
      "end_seconds": 206.84,
      "duration_seconds": 4.64,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.82,
      "end_seconds": 210.68,
      "duration_seconds": 1.86,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.77,
      "end_seconds": 214.12,
      "duration_seconds": 2.35,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.77,
      "end_seconds": 219.61,
      "duration_seconds": 4.84,
      "text": "Alright, what does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.37,
      "end_seconds": 224.19,
      "duration_seconds": 3.82,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.9,
      "end_seconds": 242.72,
      "duration_seconds": 3.82,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.43,
      "end_seconds": 247.03,
      "duration_seconds": 2.6,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.56,
      "end_seconds": 253.11,
      "duration_seconds": 4.55,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.78,
      "end_seconds": 256.8,
      "duration_seconds": 3.02,
      "text": "Yes, naproxen. I get a rash."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.35,
      "end_seconds": 263.82,
      "duration_seconds": 4.47,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.45,
      "end_seconds": 265.37,
      "duration_seconds": 0.92,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.16,
      "end_seconds": 269.49,
      "duration_seconds": 2.33,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 288.76,
      "duration_seconds": 7.3,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.75,
      "end_seconds": 317.73,
      "duration_seconds": 22.98,
      "text": "please sit back down. Okay, thinking it through, the most likely explanation is osteoporosis with a fragility fracture. I'm sending you for a bone density scan cos of osteoporosis. I'll request blood tests, it'll help with osteoporosis. I'm prescribing alendronic acid, 70 milligrams, once a week, long term. That's for bone strengthening"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.7,
      "end_seconds": 321.28,
      "duration_seconds": 1.58,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.17,
      "end_seconds": 334.15,
      "duration_seconds": 11.98,
      "text": "take the tablet with a full glass of water, and stay upright for thirty minutes please don't wait if the symptoms get worse that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.84,
      "end_seconds": 338.37,
      "duration_seconds": 3.53,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.24,
      "end_seconds": 342.66,
      "duration_seconds": 2.42,
      "text": "See me again in three months."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.49,
      "end_seconds": 348.19,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.83,
      "end_seconds": 352.25,
      "duration_seconds": 3.42,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.56,
      "end_seconds": 357.3,
      "duration_seconds": 3.74,
      "text": "Yeah, I think I understand everything. Thanks."
    }
  ]
}