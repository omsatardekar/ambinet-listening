{
  "schema_version": "1.0",
  "encounter_id": "02442",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 5.47,
      "duration_seconds": 4.15,
      "text": "Right, hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.41,
      "end_seconds": 10.03,
      "duration_seconds": 2.62,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.77,
      "end_seconds": 15.82,
      "duration_seconds": 5.05,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.9,
      "end_seconds": 24.43,
      "duration_seconds": 6.53,
      "text": "Right, that's fine, sit down. We'll go through it together. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.66,
      "end_seconds": 28.31,
      "duration_seconds": 2.65,
      "text": "Only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.31,
      "end_seconds": 31.07,
      "duration_seconds": 1.76,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 32.64,
      "end_seconds": 39.14,
      "duration_seconds": 6.5,
      "text": "Doctor, it's electric shock pains in my cheek. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.01,
      "end_seconds": 42.77,
      "duration_seconds": 1.76,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.06,
      "end_seconds": 47.93,
      "duration_seconds": 3.87,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.37,
      "end_seconds": 55.04,
      "duration_seconds": 4.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.99,
      "end_seconds": 60.48,
      "duration_seconds": 3.49,
      "text": "It's worse with chewing. It's moderate, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.66,
      "end_seconds": 64.79,
      "duration_seconds": 3.13,
      "text": "Has there been pain lasting seconds too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 67.55,
      "duration_seconds": 1.06,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.31,
      "end_seconds": 71.71,
      "duration_seconds": 2.4,
      "text": "Has there been any hearing loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 75.69,
      "duration_seconds": 2.5,
      "text": "No, none, no hearing loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.74,
      "duration_seconds": 3.06,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.09,
      "end_seconds": 85.46,
      "duration_seconds": 1.37,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.0,
      "end_seconds": 89.71,
      "duration_seconds": 3.71,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.99,
      "end_seconds": 97.84,
      "duration_seconds": 4.85,
      "text": "Sorry, what was I saying, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.8,
      "end_seconds": 101.03,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.87,
      "end_seconds": 106.28,
      "duration_seconds": 4.41,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 109.92,
      "duration_seconds": 1.79,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.61,
      "end_seconds": 114.33,
      "duration_seconds": 2.72,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.18,
      "end_seconds": 119.38,
      "duration_seconds": 3.2,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 123.71,
      "duration_seconds": 3.14,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.26,
      "end_seconds": 126.27,
      "duration_seconds": 2.01,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.58,
      "end_seconds": 129.98,
      "duration_seconds": 2.4,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.97,
      "end_seconds": 137.15,
      "duration_seconds": 5.18,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 141.98,
      "duration_seconds": 2.76,
      "text": "Yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.49,
      "end_seconds": 161.61,
      "duration_seconds": 2.12,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.19,
      "end_seconds": 170.2,
      "duration_seconds": 3.01,
      "text": "Heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.91,
      "end_seconds": 175.74,
      "duration_seconds": 3.83,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 176.77,
      "end_seconds": 183.56,
      "duration_seconds": 6.79,
      "text": "He is on clopidogrel, 75 milligrams, once a day, I give it to him."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.59,
      "end_seconds": 187.34,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.12,
      "end_seconds": 189.16,
      "duration_seconds": 1.04,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.73,
      "end_seconds": 203.66,
      "duration_seconds": 2.93,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.46,
      "end_seconds": 214.7,
      "duration_seconds": 3.24,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.66,
      "end_seconds": 243.38,
      "duration_seconds": 10.72,
      "text": "Okay: heart rate 79, saturation 98 percent, height 158 centimetres, weight 81 kilos, BMI works out to 32.4, BP is 127 over 73."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.14,
      "end_seconds": 245.54,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 250.0,
      "duration_seconds": 3.05,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.35,
      "end_seconds": 255.19,
      "duration_seconds": 3.84,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.0,
      "end_seconds": 257.23,
      "duration_seconds": 1.23,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.35,
      "end_seconds": 273.83,
      "duration_seconds": 5.48,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.29,
      "end_seconds": 278.63,
      "duration_seconds": 2.34,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.76,
      "end_seconds": 323.53,
      "duration_seconds": 28.77,
      "text": "Right, here's what I'm thinking. It fits best with trigeminal neuralgia. I can't rule out a dental problem yet. An MRI scan of the head is what I'd like next, for facial pain. I'd like you to take carbamazepine, 100 milligrams, twice a day, titrate. That's for nerve pain. It's a commonly used medicine and most people tolerate it well. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.3,
      "end_seconds": 336.4,
      "duration_seconds": 8.1,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.39,
      "end_seconds": 342.84,
      "duration_seconds": 4.45,
      "text": "Um, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.07,
      "end_seconds": 351.13,
      "duration_seconds": 7.06,
      "text": "Let's review you in four weeks. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.98,
      "end_seconds": 354.58,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.46,
      "end_seconds": 356.82,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}