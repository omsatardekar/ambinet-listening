{
  "schema_version": "1.0",
  "encounter_id": "02020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 6.64,
      "duration_seconds": 5.89,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.77,
      "duration_seconds": 4.44,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 20.7,
      "duration_seconds": 7.88,
      "text": "mainly severe pain there's a couple of other things, uh, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 25.87,
      "duration_seconds": 4.03,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.78,
      "end_seconds": 34.11,
      "duration_seconds": 6.33,
      "text": "I, I'd give it a eight, um, out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.86,
      "end_seconds": 37.44,
      "duration_seconds": 2.58,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.26,
      "end_seconds": 45.39,
      "duration_seconds": 7.13,
      "text": "It usually comes with a bone sticking out of my lower leg."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 52.04,
      "duration_seconds": 5.06,
      "text": "and what about chest pain, head injury or loss of consciousness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.66,
      "end_seconds": 56.92,
      "duration_seconds": 4.26,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.58,
      "end_seconds": 60.07,
      "duration_seconds": 2.49,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.18,
      "end_seconds": 62.19,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.99,
      "end_seconds": 67.24,
      "duration_seconds": 4.25,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.9,
      "end_seconds": 73.96,
      "duration_seconds": 3.06,
      "text": "Thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.56,
      "end_seconds": 83.82,
      "duration_seconds": 9.26,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.75,
      "end_seconds": 96.97,
      "duration_seconds": 12.22,
      "text": "No, I share a house with my brother. I work in accounts at a hospital. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.42,
      "end_seconds": 104.86,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.63,
      "end_seconds": 110.74,
      "duration_seconds": 4.11,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.18,
      "end_seconds": 128.43,
      "duration_seconds": 3.25,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.31,
      "end_seconds": 140.21,
      "duration_seconds": 10.9,
      "text": "Alendronate, 70 milligrams, once a week for my bones. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.28,
      "end_seconds": 145.61,
      "duration_seconds": 3.33,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.2,
      "end_seconds": 161.24,
      "duration_seconds": 2.04,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.17,
      "end_seconds": 189.25,
      "duration_seconds": 9.08,
      "text": "Okay: heart rate 122, oxygen saturation is 98 percent. And respiratory rate 20, blood pressure 120 over 81."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.28,
      "end_seconds": 194.38,
      "duration_seconds": 3.1,
      "text": "Actually, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.94,
      "end_seconds": 197.35,
      "duration_seconds": 2.41,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.07,
      "end_seconds": 203.61,
      "duration_seconds": 4.54,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.2,
      "end_seconds": 206.39,
      "duration_seconds": 1.19,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.22,
      "end_seconds": 210.4,
      "duration_seconds": 3.18,
      "text": "Right, take a deep breath for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.58,
      "end_seconds": 228.15,
      "duration_seconds": 6.57,
      "text": "there is a wound with bone visible and the foot is cool with no pulse"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.99,
      "end_seconds": 232.68,
      "duration_seconds": 1.69,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.69,
      "end_seconds": 257.82,
      "duration_seconds": 12.13,
      "text": "From what you've told me and what I found, the most likely explanation is an open fracture with a compromised blood supply. A vascular injury is still possible."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.05,
      "end_seconds": 281.74,
      "duration_seconds": 8.69,
      "text": "Blood tests is what I'd like next, for pre-operative. An urgent X-ray is what I'd like next, for open fracture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.03,
      "end_seconds": 285.25,
      "duration_seconds": 2.22,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.91,
      "end_seconds": 294.5,
      "duration_seconds": 7.59,
      "text": "We'll begin with co-amoxiclav, 1.2 grams, now, single dose. That should help with open fracture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.79,
      "end_seconds": 298.69,
      "duration_seconds": 2.9,
      "text": "how soon will it work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.66,
      "end_seconds": 320.88,
      "duration_seconds": 20.22,
      "text": "Keep still, I am splinting the leg and sending you to theatre now. I'll also refer you to the orthopaedic team. Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.51,
      "end_seconds": 325.85,
      "duration_seconds": 4.34,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.04,
      "end_seconds": 332.41,
      "duration_seconds": 1.37,
      "text": "Look after yourself."
    }
  ]
}