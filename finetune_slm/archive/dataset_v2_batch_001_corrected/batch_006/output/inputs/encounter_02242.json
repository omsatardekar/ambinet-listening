{
  "schema_version": "1.0",
  "encounter_id": "02242",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.05,
      "duration_seconds": 2.42,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.14,
      "end_seconds": 9.29,
      "duration_seconds": 1.15,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.7,
      "end_seconds": 21.4,
      "duration_seconds": 6.7,
      "text": "Okay, so good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.23,
      "end_seconds": 28.38,
      "duration_seconds": 5.15,
      "text": "Please do. Extra information is always welcome. Cold out there today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.36,
      "end_seconds": 36.87,
      "duration_seconds": 7.51,
      "text": "Sorry, uh, what was I saying, freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.81,
      "end_seconds": 41.2,
      "duration_seconds": 3.39,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.15,
      "end_seconds": 45.27,
      "duration_seconds": 3.12,
      "text": "It's very heavy periods, mostly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 49.68,
      "duration_seconds": 3.52,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.4,
      "end_seconds": 56.13,
      "duration_seconds": 4.73,
      "text": "Hmm, you know, around three weeks, I think."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 57.82,
      "end_seconds": 62.74,
      "duration_seconds": 4.92,
      "text": "Erm, hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 69.18,
      "duration_seconds": 4.72,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.99,
      "end_seconds": 73.28,
      "duration_seconds": 2.29,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.97,
      "end_seconds": 75.6,
      "duration_seconds": 1.63,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.43,
      "end_seconds": 80.15,
      "duration_seconds": 3.72,
      "text": "It settles a little with double protection."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 83.5,
      "duration_seconds": 1.64,
      "text": "Any dizziness as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.05,
      "end_seconds": 104.53,
      "duration_seconds": 20.48,
      "text": "Mm, yes. About dizziness, about a three out of ten. Standing definitely sets it off. And I've been feeling exhausted as well, for three days. Being breathless on stairs was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.66,
      "end_seconds": 110.02,
      "duration_seconds": 4.36,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.67,
      "end_seconds": 123.18,
      "duration_seconds": 2.51,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.79,
      "end_seconds": 153.71,
      "duration_seconds": 8.92,
      "text": "Okay: blood pressure 132 over 81, pulse 116, temperature is 36.8 degrees. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.28,
      "end_seconds": 159.45,
      "duration_seconds": 4.17,
      "text": "Erm, you know, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.75,
      "end_seconds": 164.58,
      "duration_seconds": 3.83,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.17,
      "end_seconds": 171.15,
      "duration_seconds": 3.98,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.02,
      "end_seconds": 187.2,
      "duration_seconds": 1.18,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.52,
      "end_seconds": 189.9,
      "duration_seconds": 1.38,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.66,
      "end_seconds": 204.03,
      "duration_seconds": 5.37,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.89,
      "end_seconds": 213.75,
      "duration_seconds": 5.86,
      "text": "That's the examination finished. And what about pain, fainting or weight loss?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.71,
      "end_seconds": 221.02,
      "duration_seconds": 5.31,
      "text": "I mean, no, no pain, fainting or weight loss."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 225.5,
      "duration_seconds": 2.5,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.55,
      "end_seconds": 230.93,
      "duration_seconds": 3.38,
      "text": "Right, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.79,
      "end_seconds": 240.58,
      "duration_seconds": 3.79,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.14,
      "end_seconds": 252.2,
      "duration_seconds": 10.06,
      "text": "Yeah, um, yes, trimethoprim, it gives me a rash. Erm, I'm allergic to kiwi, I get hives."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.08,
      "end_seconds": 255.53,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.56,
      "end_seconds": 260.08,
      "duration_seconds": 3.52,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 262.53,
      "duration_seconds": 1.94,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.16,
      "end_seconds": 268.11,
      "duration_seconds": 3.95,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.48,
      "end_seconds": 271.93,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.47,
      "end_seconds": 276.03,
      "duration_seconds": 3.56,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.52,
      "end_seconds": 282.45,
      "duration_seconds": 2.93,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.43,
      "end_seconds": 289.93,
      "duration_seconds": 5.5,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.32,
      "end_seconds": 294.34,
      "duration_seconds": 3.02,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.05,
      "end_seconds": 303.85,
      "duration_seconds": 7.8,
      "text": "Right, yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.64,
      "end_seconds": 310.45,
      "duration_seconds": 4.81,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.45,
      "end_seconds": 316.32,
      "duration_seconds": 4.87,
      "text": "I have epilepsy. Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.15,
      "end_seconds": 325.77,
      "duration_seconds": 8.62,
      "text": "Okay, I can see epilepsy in your file as well. Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 327.23,
      "end_seconds": 339.27,
      "duration_seconds": 12.04,
      "text": "Okay, um, so it's lamotrigine, 100 milligrams, twice a day for the fits, doctor. It's aspirin, 75 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.27,
      "end_seconds": 364.3,
      "duration_seconds": 8.03,
      "text": "Having listened and examined, it fits best with heavy periods with iron deficiency. We shouldn't forget fibroids."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.07,
      "end_seconds": 370.16,
      "duration_seconds": 4.09,
      "text": "So, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.64,
      "end_seconds": 380.19,
      "duration_seconds": 8.55,
      "text": "It's reasonable to be concerned, but right now heavy periods with iron deficiency is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.79,
      "end_seconds": 418.15,
      "duration_seconds": 26.36,
      "text": "A blood count is what I'd like next, for heavy periods. Let's book a pelvic ultrasound to look into heavy periods. We'll begin with tranexamic acid, 1 gram, three times a day, during periods. You take it by mouth. It's for heavy periods. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 419.83,
      "end_seconds": 426.84,
      "duration_seconds": 7.01,
      "text": "Sorry, what was I saying, should I take that with food?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 427.74,
      "end_seconds": 439.38,
      "duration_seconds": 11.64,
      "text": "I'm prescribing ferrous sulfate, 200 milligrams, once a day, three months. That's for iron deficiency. Keep a pad count diary. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.19,
      "end_seconds": 444.47,
      "duration_seconds": 4.28,
      "text": "I mean, I think I understand everything. Thanks."
    }
  ]
}