{
  "schema_version": "1.0",
  "encounter_id": "02301",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 2.89,
      "duration_seconds": 2.08,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.53,
      "end_seconds": 8.38,
      "duration_seconds": 3.85,
      "text": "I mean afternoon is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.48,
      "end_seconds": 14.58,
      "duration_seconds": 2.1,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.46,
      "end_seconds": 21.79,
      "duration_seconds": 6.33,
      "text": "um so... attacks of spinning lasting hours. That's why I came"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.68,
      "end_seconds": 25.8,
      "duration_seconds": 2.12,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.82,
      "end_seconds": 29.5,
      "duration_seconds": 2.68,
      "text": "it's bisoprolol, once a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.2,
      "end_seconds": 32.16,
      "duration_seconds": 1.96,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.91,
      "end_seconds": 41.76,
      "duration_seconds": 7.85,
      "text": "2.5 milligrams. I'm on Tiotropium inhaler, once a day for my chest"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.97,
      "end_seconds": 46.26,
      "duration_seconds": 3.29,
      "text": "what's the timeline when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.16,
      "end_seconds": 51.23,
      "duration_seconds": 3.07,
      "text": "For two weeks, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.69,
      "end_seconds": 55.12,
      "duration_seconds": 2.43,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.73,
      "end_seconds": 60.34,
      "duration_seconds": 4.61,
      "text": "Oh, I get some relief from lying still."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.12,
      "end_seconds": 64.51,
      "duration_seconds": 2.39,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.65,
      "end_seconds": 70.08,
      "duration_seconds": 2.43,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.16,
      "end_seconds": 73.88,
      "duration_seconds": 2.72,
      "text": "Any hearing getting worse as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.67,
      "end_seconds": 76.8,
      "duration_seconds": 1.13,
      "text": "mm, yes"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.1,
      "end_seconds": 97.72,
      "duration_seconds": 4.62,
      "text": "have you noticed double vision, weakness, ear discharge or headache?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.8,
      "end_seconds": 103.08,
      "duration_seconds": 4.28,
      "text": "no, uh, none of those at all"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 107.77,
      "duration_seconds": 3.98,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.67,
      "end_seconds": 114.72,
      "duration_seconds": 5.05,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.56,
      "end_seconds": 119.14,
      "duration_seconds": 2.58,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.52,
      "end_seconds": 125.55,
      "duration_seconds": 5.03,
      "text": "Yeah, um, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.86,
      "end_seconds": 130.79,
      "duration_seconds": 3.93,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.27,
      "end_seconds": 136.64,
      "duration_seconds": 4.37,
      "text": "no, I'm not allergic to to anything"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.41,
      "end_seconds": 140.09,
      "duration_seconds": 2.68,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.87,
      "end_seconds": 145.46,
      "duration_seconds": 4.59,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.29,
      "end_seconds": 157.73,
      "duration_seconds": 3.44,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.88,
      "end_seconds": 162.42,
      "duration_seconds": 3.54,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.99,
      "end_seconds": 167.07,
      "duration_seconds": 3.08,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.04,
      "end_seconds": 173.06,
      "duration_seconds": 4.02,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.46,
      "end_seconds": 176.8,
      "duration_seconds": 2.34,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.4,
      "end_seconds": 184.66,
      "duration_seconds": 6.26,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.35,
      "end_seconds": 188.36,
      "duration_seconds": 3.01,
      "text": "Right do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.89,
      "end_seconds": 196.61,
      "duration_seconds": 3.72,
      "text": "yes, an irregular heartbeat i have COPD"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.3,
      "end_seconds": 207.86,
      "duration_seconds": 10.56,
      "text": "Mm-hmm. Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.57,
      "end_seconds": 221.57,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 245.18,
      "duration_seconds": 10.18,
      "text": "okay: pulse 77, SpO2 98 percent on room air and respiratory rate 14, BP is 113 over 81, temp 36.6 degrees"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.03,
      "end_seconds": 249.24,
      "duration_seconds": 2.21,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 252.99,
      "duration_seconds": 2.62,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 257.16,
      "duration_seconds": 2.52,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.84,
      "end_seconds": 261.3,
      "duration_seconds": 2.46,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.67,
      "end_seconds": 274.59,
      "duration_seconds": 5.92,
      "text": "The ear drums look normal and the hearing is reduced on the left."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.15,
      "end_seconds": 282.02,
      "duration_seconds": 1.87,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.12,
      "end_seconds": 294.76,
      "duration_seconds": 5.64,
      "text": "let me tell you where I've got to. It points towards Meniere's disease"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.38,
      "end_seconds": 299.36,
      "duration_seconds": 2.98,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 318.88,
      "duration_seconds": 18.64,
      "text": "I understand the worry. At the moment I'd say it's Meniere's disease and we'll watch how it goes. Let me just check I've got this right. You've had attacks of spinning lasting hours for two weeks and no ear discharge or headache"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.95,
      "end_seconds": 321.41,
      "duration_seconds": 1.46,
      "text": "yes that's right"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.91,
      "end_seconds": 327.56,
      "duration_seconds": 5.65,
      "text": "Cut down on salt and caffeine. We'll catch up in six weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.81,
      "end_seconds": 331.48,
      "duration_seconds": 2.67,
      "text": "Mm alright I'll be back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.47,
      "end_seconds": 335.24,
      "duration_seconds": 2.77,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.18,
      "end_seconds": 341.44,
      "duration_seconds": 4.26,
      "text": "Okay, so I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.46,
      "end_seconds": 343.75,
      "duration_seconds": 1.29,
      "text": "All the best."
    }
  ]
}