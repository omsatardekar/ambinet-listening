{
  "schema_version": "1.0",
  "encounter_id": "02025",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.83,
      "duration_seconds": 3.76,
      "text": "morning, doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 14.15,
      "duration_seconds": 4.22,
      "text": "Of course leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.01,
      "end_seconds": 22.9,
      "duration_seconds": 7.89,
      "text": "Hello, uh, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 27.83,
      "duration_seconds": 3.12,
      "text": "okay, absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.29,
      "end_seconds": 34.95,
      "duration_seconds": 5.66,
      "text": "I'm here because of a knee that gave way playing football."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.99,
      "end_seconds": 38.27,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.65,
      "end_seconds": 49.83,
      "duration_seconds": 3.18,
      "text": "okay, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.92,
      "end_seconds": 70.9,
      "duration_seconds": 10.98,
      "text": "Okay: temp 36.7 degrees, blood pressure 127 over 71, pulse is 83 beats a minute. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.49,
      "end_seconds": 80.73,
      "duration_seconds": 9.24,
      "text": "right about... well two weeks. A neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.43,
      "end_seconds": 90.52,
      "duration_seconds": 9.09,
      "text": "can you describe it a a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.17,
      "end_seconds": 97.67,
      "duration_seconds": 6.5,
      "text": "It feels moderate to me. Yes, twisting. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.56,
      "end_seconds": 100.61,
      "duration_seconds": 2.05,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.13,
      "end_seconds": 108.87,
      "duration_seconds": 7.74,
      "text": "A pop at the time goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.17,
      "end_seconds": 116.98,
      "duration_seconds": 2.81,
      "text": "And what about locked knee or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.7,
      "end_seconds": 120.89,
      "duration_seconds": 3.19,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.67,
      "end_seconds": 125.85,
      "duration_seconds": 3.18,
      "text": "And what about fever or calf pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.95,
      "end_seconds": 131.26,
      "duration_seconds": 4.31,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 135.36,
      "duration_seconds": 2.06,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.58,
      "end_seconds": 138.48,
      "duration_seconds": 1.9,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.12,
      "end_seconds": 142.9,
      "duration_seconds": 2.78,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.78,
      "end_seconds": 149.43,
      "duration_seconds": 5.65,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.94,
      "end_seconds": 154.95,
      "duration_seconds": 5.01,
      "text": "right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 159.9,
      "duration_seconds": 3.6,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.46,
      "end_seconds": 165.22,
      "duration_seconds": 1.76,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.95,
      "end_seconds": 170.06,
      "duration_seconds": 4.11,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.47,
      "end_seconds": 180.29,
      "duration_seconds": 4.82,
      "text": "alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.99,
      "end_seconds": 189.75,
      "duration_seconds": 7.76,
      "text": "so, I take escitalopram, 10 milligrams, once a day for my mood"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.19,
      "end_seconds": 191.42,
      "duration_seconds": 1.23,
      "text": "okay go on"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.63,
      "end_seconds": 196.49,
      "duration_seconds": 3.86,
      "text": "So, it's ibuprofen, 400 milligrams, with food."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.85,
      "end_seconds": 197.55,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.96,
      "end_seconds": 217.06,
      "duration_seconds": 3.1,
      "text": "so, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.46,
      "end_seconds": 224.52,
      "duration_seconds": 6.06,
      "text": "uh, um, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.06,
      "end_seconds": 228.18,
      "duration_seconds": 2.12,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.86,
      "end_seconds": 233.27,
      "duration_seconds": 4.41,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.64,
      "end_seconds": 237.84,
      "duration_seconds": 3.2,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.42,
      "end_seconds": 241.08,
      "duration_seconds": 2.66,
      "text": "Depression for about a year"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.94,
      "end_seconds": 249.33,
      "duration_seconds": 6.39,
      "text": "right, so depression is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.98,
      "end_seconds": 255.92,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.76,
      "end_seconds": 258.87,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 278.17,
      "duration_seconds": 7.49,
      "text": "the knee is swollen and when I pull the shin forwards it moves more than the other side"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.61,
      "end_seconds": 285.07,
      "duration_seconds": 2.46,
      "text": "okay that's enough for me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.26,
      "end_seconds": 300.5,
      "duration_seconds": 7.24,
      "text": "Having listened and examined I think we're dealing with a likely anterior cruciate ligament tear at this stage."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.04,
      "end_seconds": 305.69,
      "duration_seconds": 3.65,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.71,
      "end_seconds": 338.26,
      "duration_seconds": 30.55,
      "text": "nothing I've seen today points to an emergency. It looks like a likely anterior cruciate ligament tear but I'd like to confirm. We should do an MRI of the knee for knee injury. Let's get an X-ray of the knee for knee injury. Rest ice and elevation and use crutches until the scan. I think the sports injury clinic should see you too. Come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.92,
      "end_seconds": 346.2,
      "duration_seconds": 7.28,
      "text": "I'd like you back after the scan. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.99,
      "end_seconds": 353.23,
      "duration_seconds": 6.24,
      "text": "so, I come back after the scan is that that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.46,
      "end_seconds": 358.33,
      "duration_seconds": 3.87,
      "text": "yes, exactly right does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.76,
      "end_seconds": 362.64,
      "duration_seconds": 2.88,
      "text": "yeah alright thanks take care"
    }
  ]
}