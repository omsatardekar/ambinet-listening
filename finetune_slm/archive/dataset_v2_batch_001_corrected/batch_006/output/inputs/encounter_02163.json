{
  "schema_version": "1.0",
  "encounter_id": "02163",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.11,
      "duration_seconds": 3.44,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 9.93,
      "duration_seconds": 4.1,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.58,
      "end_seconds": 18.61,
      "duration_seconds": 7.03,
      "text": "Hmm, honestly, it's constipation then loose stools, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.77,
      "end_seconds": 22.91,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.62,
      "end_seconds": 34.2,
      "duration_seconds": 9.58,
      "text": "It's been ten days, I'm fairly sure. There was pain in the lower left tummy, yes, but that went away."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.24,
      "end_seconds": 43.12,
      "duration_seconds": 6.88,
      "text": "Have you had constipation then loose stools before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.22,
      "end_seconds": 56.66,
      "duration_seconds": 8.44,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.42,
      "end_seconds": 62.56,
      "duration_seconds": 4.14,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.69,
      "end_seconds": 71.57,
      "duration_seconds": 2.88,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.19,
      "end_seconds": 96.54,
      "duration_seconds": 5.35,
      "text": "Okay: pulse 104, pressure 105 over 67, temperature is 38.6 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.65,
      "end_seconds": 120.83,
      "duration_seconds": 7.18,
      "text": "Let me check a few things. Any blood in the stool, vomiting, weight loss or urinary symptoms?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.47,
      "end_seconds": 125.29,
      "duration_seconds": 2.82,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 133.9,
      "duration_seconds": 2.95,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.55,
      "end_seconds": 137.86,
      "duration_seconds": 3.31,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 141.25,
      "duration_seconds": 1.74,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.94,
      "end_seconds": 145.16,
      "duration_seconds": 2.22,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 151.14,
      "duration_seconds": 5.3,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.23,
      "end_seconds": 156.52,
      "duration_seconds": 4.29,
      "text": "I'm on metformin, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.5,
      "end_seconds": 161.4,
      "duration_seconds": 2.9,
      "text": "So, how much do you take?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 174.0,
      "duration_seconds": 11.75,
      "text": "500 milligrams. Carvedilol. I take it 6.25 milligrams, twice a day. I, I was on metoprolol before. I stopped taking it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.2,
      "end_seconds": 178.84,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.55,
      "end_seconds": 182.93,
      "duration_seconds": 3.38,
      "text": "Amoxicillin. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.38,
      "end_seconds": 187.26,
      "duration_seconds": 2.88,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.61,
      "end_seconds": 208.41,
      "duration_seconds": 16.8,
      "text": "I only drink at family occasions. I smoke roughly a pack every two days. My husband and I live above the shop. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.2,
      "end_seconds": 224.56,
      "duration_seconds": 3.36,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.06,
      "end_seconds": 233.48,
      "duration_seconds": 7.42,
      "text": "Oh, I have diabetes, for nearly five years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.48,
      "end_seconds": 236.43,
      "duration_seconds": 0.95,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.95,
      "end_seconds": 241.32,
      "duration_seconds": 4.37,
      "text": "I have heart failure, for about ten years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.55,
      "end_seconds": 248.71,
      "duration_seconds": 6.16,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.24,
      "end_seconds": 269.64,
      "duration_seconds": 9.4,
      "text": "So, based on your history, I think we're dealing with acute diverticulitis at this stage. I can't rule out a bowel tumour yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.21,
      "end_seconds": 272.21,
      "duration_seconds": 2.0,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.95,
      "end_seconds": 303.37,
      "duration_seconds": 29.42,
      "text": "I understand the worry. At the moment I'd say it's acute diverticulitis, and we'll know more once the blood tests is back. I'm going to order blood tests, for abdominal pain. It's a routine test and it'll give us a much clearer picture. Drink plenty and start with a light diet. If you smoke, this is a good moment to think about stopping, and we can help you with that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.5,
      "end_seconds": 308.06,
      "duration_seconds": 3.56,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.78,
      "end_seconds": 313.44,
      "duration_seconds": 4.66,
      "text": "Great, you know, thank you for your help."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.49,
      "end_seconds": 317.29,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}