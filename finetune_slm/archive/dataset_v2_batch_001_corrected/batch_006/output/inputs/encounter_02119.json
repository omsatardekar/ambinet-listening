{
  "schema_version": "1.0",
  "encounter_id": "02119",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.48,
      "duration_seconds": 3.72,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.78,
      "end_seconds": 10.14,
      "duration_seconds": 4.36,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.08,
      "end_seconds": 16.05,
      "duration_seconds": 3.97,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.17,
      "end_seconds": 25.81,
      "duration_seconds": 8.64,
      "text": "Yeah, it's a chronic cough with lots of phlegm. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.65,
      "end_seconds": 29.68,
      "duration_seconds": 3.03,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.63,
      "end_seconds": 36.55,
      "duration_seconds": 2.92,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.23,
      "end_seconds": 45.01,
      "duration_seconds": 4.78,
      "text": "It was closer to two weeks, you know, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.62,
      "end_seconds": 49.66,
      "duration_seconds": 4.04,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.77,
      "end_seconds": 51.85,
      "duration_seconds": 1.08,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.27,
      "end_seconds": 62.39,
      "duration_seconds": 9.12,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.57,
      "end_seconds": 81.89,
      "duration_seconds": 16.32,
      "text": "It's worse with mornings. A A seven out of ten, I suppose. I'd say once or twice a day. I was getting out of breath at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.53,
      "end_seconds": 97.55,
      "duration_seconds": 4.02,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.35,
      "end_seconds": 107.29,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 131.38,
      "duration_seconds": 10.36,
      "text": "Okay: temperature is 36.7 degrees, SpO2 98 percent on room air. And respiratory rate 18, pulse 77, pressure 112 over 80."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.26,
      "end_seconds": 134.95,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.83,
      "end_seconds": 139.84,
      "duration_seconds": 4.01,
      "text": "Alright, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 144.87,
      "duration_seconds": 3.57,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 147.93,
      "duration_seconds": 1.56,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 161.6,
      "duration_seconds": 5.56,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.65,
      "end_seconds": 165.48,
      "duration_seconds": 1.83,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.28,
      "end_seconds": 183.82,
      "duration_seconds": 3.54,
      "text": "have you noticed coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.34,
      "end_seconds": 189.53,
      "duration_seconds": 5.19,
      "text": "Erm, no coughing up blood or fever, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 198.29,
      "duration_seconds": 3.94,
      "text": "Okay, have you noticed chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.11,
      "end_seconds": 204.51,
      "duration_seconds": 4.4,
      "text": "No chest pain or weight loss, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.88,
      "end_seconds": 209.7,
      "duration_seconds": 3.82,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.41,
      "end_seconds": 213.46,
      "duration_seconds": 2.05,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.28,
      "end_seconds": 218.75,
      "duration_seconds": 3.47,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.61,
      "end_seconds": 223.87,
      "duration_seconds": 3.26,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 241.81,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.12,
      "end_seconds": 247.94,
      "duration_seconds": 4.82,
      "text": "It's thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.67,
      "end_seconds": 251.11,
      "duration_seconds": 2.44,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.83,
      "end_seconds": 253.43,
      "duration_seconds": 1.6,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.21,
      "end_seconds": 258.3,
      "duration_seconds": 3.09,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.08,
      "end_seconds": 265.59,
      "duration_seconds": 5.51,
      "text": "just a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.74,
      "end_seconds": 269.62,
      "duration_seconds": 2.88,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.51,
      "end_seconds": 274.45,
      "duration_seconds": 2.94,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.09,
      "end_seconds": 281.71,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.7,
      "end_seconds": 285.98,
      "duration_seconds": 3.28,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.14,
      "end_seconds": 289.87,
      "duration_seconds": 2.73,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.91,
      "end_seconds": 296.62,
      "duration_seconds": 4.71,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.17,
      "end_seconds": 306.59,
      "duration_seconds": 6.42,
      "text": "Do you have any chronic illnesses? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.58,
      "end_seconds": 311.46,
      "duration_seconds": 2.88,
      "text": "I've had an underactive thyroid, yes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.5,
      "end_seconds": 315.27,
      "duration_seconds": 2.77,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.33,
      "end_seconds": 319.29,
      "duration_seconds": 1.96,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.82,
      "end_seconds": 327.2,
      "duration_seconds": 6.38,
      "text": "let me tell you where I've got to this looks most like a flare of bronchiectasis"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.04,
      "end_seconds": 331.24,
      "duration_seconds": 3.2,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.95,
      "end_seconds": 348.63,
      "duration_seconds": 16.68,
      "text": "It's reasonable to be concerned, but right now a flare of bronchiectasis is my leading thought, not anything worse. I'm going to order a chest X-ray, for bronchiectasis flare. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.92,
      "end_seconds": 352.17,
      "duration_seconds": 2.25,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}