{
  "schema_version": "1.0",
  "encounter_id": "02423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.83,
      "duration_seconds": 4.0,
      "text": "Morning, um, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.68,
      "end_seconds": 10.21,
      "duration_seconds": 4.53,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.4,
      "end_seconds": 17.19,
      "duration_seconds": 5.79,
      "text": "Well, I've been having a back that has got shorter."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.05,
      "end_seconds": 21.96,
      "duration_seconds": 3.91,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.69,
      "end_seconds": 30.13,
      "duration_seconds": 7.44,
      "text": "It's been going on for ten days. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.02,
      "end_seconds": 35.18,
      "duration_seconds": 3.16,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.76,
      "end_seconds": 51.88,
      "duration_seconds": 15.12,
      "text": "Maybe a six out of ten on a bad day. Oh, uh, there was a dull ache in my back, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.81,
      "end_seconds": 55.04,
      "duration_seconds": 1.23,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.99,
      "end_seconds": 61.52,
      "duration_seconds": 4.53,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.65,
      "end_seconds": 64.62,
      "duration_seconds": 1.97,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.35,
      "end_seconds": 70.02,
      "duration_seconds": 3.67,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.2,
      "end_seconds": 72.89,
      "duration_seconds": 1.69,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.69,
      "end_seconds": 76.27,
      "duration_seconds": 2.58,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.81,
      "end_seconds": 79.27,
      "duration_seconds": 2.46,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.82,
      "end_seconds": 83.87,
      "duration_seconds": 4.05,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.5,
      "end_seconds": 98.71,
      "duration_seconds": 3.21,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.48,
      "end_seconds": 103.69,
      "duration_seconds": 4.21,
      "text": "It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.77,
      "end_seconds": 109.5,
      "duration_seconds": 2.73,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.99,
      "end_seconds": 118.13,
      "duration_seconds": 7.14,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.86,
      "end_seconds": 122.71,
      "duration_seconds": 3.85,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.9,
      "end_seconds": 127.57,
      "duration_seconds": 3.67,
      "text": "Amoxicillin. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.67,
      "end_seconds": 132.76,
      "duration_seconds": 4.09,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.68,
      "end_seconds": 139.07,
      "duration_seconds": 5.39,
      "text": "Mm, I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.66,
      "end_seconds": 142.62,
      "duration_seconds": 1.96,
      "text": "Any sign of numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.59,
      "end_seconds": 150.62,
      "duration_seconds": 6.03,
      "text": "Sorry, what was I saying, no, I haven't had any numbness."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.13,
      "end_seconds": 155.88,
      "duration_seconds": 4.75,
      "text": "Okay, a few quick ones: bladder problems, fever or weight loss?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.74,
      "end_seconds": 165.1,
      "duration_seconds": 4.36,
      "text": "No, you know, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.04,
      "end_seconds": 169.39,
      "duration_seconds": 2.35,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.76,
      "end_seconds": 172.63,
      "duration_seconds": 1.87,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.69,
      "end_seconds": 176.03,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.77,
      "end_seconds": 178.9,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.36,
      "end_seconds": 183.84,
      "duration_seconds": 3.48,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.22,
      "end_seconds": 194.0,
      "duration_seconds": 2.78,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.29,
      "end_seconds": 224.13,
      "duration_seconds": 10.84,
      "text": "Okay: respiratory rate 15, BP is 109 over 78, SpO2 97 percent on room air. And temperature 36.8, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.04,
      "end_seconds": 227.73,
      "duration_seconds": 2.69,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.46,
      "end_seconds": 232.84,
      "duration_seconds": 4.38,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.24,
      "end_seconds": 238.65,
      "duration_seconds": 4.41,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.88,
      "end_seconds": 242.31,
      "duration_seconds": 2.43,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.82,
      "end_seconds": 263.19,
      "duration_seconds": 6.37,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.19,
      "end_seconds": 266.83,
      "duration_seconds": 1.64,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.38,
      "end_seconds": 288.1,
      "duration_seconds": 10.72,
      "text": "Putting it all together, I'm honestly not certain yet. It could be osteoporosis with a fragility fracture, or it might be vitamin D deficiency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.83,
      "end_seconds": 334.22,
      "duration_seconds": 28.39,
      "text": "I think a bone density scan makes sense here, for osteoporosis. I think blood tests makes sense here, for osteoporosis. Take the tablet with a full glass of water, and stay upright for thirty minutes. Cut down on salt and fried food for now, it really does make a difference. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.5,
      "end_seconds": 337.35,
      "duration_seconds": 1.85,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.48,
      "end_seconds": 352.42,
      "duration_seconds": 9.94,
      "text": "I'd like to see you again in three months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.38,
      "end_seconds": 357.7,
      "duration_seconds": 4.32,
      "text": "Yeah, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.51,
      "end_seconds": 360.35,
      "duration_seconds": 1.84,
      "text": "So, all the best."
    }
  ]
}