{
  "schema_version": "1.0",
  "encounter_id": "02287",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.85,
      "duration_seconds": 3.09,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.17,
      "end_seconds": 9.22,
      "duration_seconds": 1.05,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.35,
      "end_seconds": 11.6,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.22,
      "end_seconds": 22.35,
      "duration_seconds": 9.13,
      "text": "So the thing is, I've got a headache. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 30.36,
      "duration_seconds": 1.96,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.41,
      "end_seconds": 34.09,
      "duration_seconds": 1.68,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.77,
      "end_seconds": 38.84,
      "duration_seconds": 4.07,
      "text": "So, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.22,
      "end_seconds": 41.29,
      "duration_seconds": 1.07,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.38,
      "end_seconds": 46.14,
      "duration_seconds": 2.76,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.49,
      "end_seconds": 56.29,
      "duration_seconds": 8.8,
      "text": "Being drowsy goes along with it, most of the time well, as for Being drowsy, mostly mild"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.44,
      "end_seconds": 75.6,
      "duration_seconds": 4.16,
      "text": "have you had any rash, chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.92,
      "end_seconds": 82.66,
      "duration_seconds": 2.74,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.71,
      "end_seconds": 86.58,
      "duration_seconds": 2.87,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.37,
      "end_seconds": 90.54,
      "duration_seconds": 2.17,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.12,
      "end_seconds": 94.46,
      "duration_seconds": 2.34,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.36,
      "end_seconds": 96.83,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.57,
      "end_seconds": 102.78,
      "duration_seconds": 4.21,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.47,
      "end_seconds": 106.39,
      "duration_seconds": 2.92,
      "text": "I'm on hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.13,
      "end_seconds": 126.79,
      "duration_seconds": 3.66,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.69,
      "end_seconds": 136.53,
      "duration_seconds": 7.84,
      "text": "I have eczema, for nearly five years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.71,
      "end_seconds": 139.48,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.55,
      "end_seconds": 142.8,
      "duration_seconds": 2.25,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.42,
      "end_seconds": 148.38,
      "duration_seconds": 1.96,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.38,
      "end_seconds": 153.12,
      "duration_seconds": 3.74,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 166.85,
      "duration_seconds": 3.51,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.71,
      "end_seconds": 171.3,
      "duration_seconds": 3.59,
      "text": "well, no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.4,
      "end_seconds": 176.23,
      "duration_seconds": 3.83,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.11,
      "end_seconds": 191.05,
      "duration_seconds": 2.94,
      "text": "right, sit still for a moment.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.91,
      "end_seconds": 206.73,
      "duration_seconds": 5.82,
      "text": "Okay: BP is 112 over 70, temperature is 36.8 degrees, pulse 77."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.02,
      "end_seconds": 212.78,
      "duration_seconds": 3.76,
      "text": "Okay, time for me to to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.4,
      "end_seconds": 215.39,
      "duration_seconds": 0.99,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.69,
      "end_seconds": 218.04,
      "duration_seconds": 1.35,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.16,
      "end_seconds": 234.32,
      "duration_seconds": 8.16,
      "text": "Your lips are pink but the whole household feels unwell, and the oxygen reading looks normal but cannot be trusted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.96,
      "end_seconds": 239.71,
      "duration_seconds": 2.75,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.74,
      "end_seconds": 251.71,
      "duration_seconds": 4.97,
      "text": "Putting it all together, this looks most like possible carbon monoxide poisoning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.35,
      "end_seconds": 255.92,
      "duration_seconds": 2.57,
      "text": "Well, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.77,
      "end_seconds": 295.08,
      "duration_seconds": 33.31,
      "text": "I understand the worry. At the moment I'd say it's possible carbon monoxide poisoning, and and we'll know more once the a carboxyhaemoglobin blood test is back. I'll request a carboxyhaemoglobin blood test, it'll help with possible carbon monoxide poisoning. I'd rather check than guess, and this is the quickest way to know more. Let's use high-flow oxygen, 15 litres per minute, continuous, until reviewed. That should help with carbon monoxide poisoning."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.9,
      "end_seconds": 305.2,
      "duration_seconds": 9.3,
      "text": "Leave the house now, don't use the boiler, and call the gas emergency number. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.81,
      "end_seconds": 309.56,
      "duration_seconds": 2.75,
      "text": "Yes, uh, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.5,
      "end_seconds": 315.19,
      "duration_seconds": 4.69,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 317.61,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    }
  ]
}