{
  "schema_version": "1.0",
  "encounter_id": "02360",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.85,
      "duration_seconds": 4.33,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 13.83,
      "duration_seconds": 3.81,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.53,
      "end_seconds": 22.23,
      "duration_seconds": 6.7,
      "text": "Doctor, it's a bump on the head. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.64,
      "end_seconds": 31.61,
      "duration_seconds": 7.97,
      "text": "So, can you tell me when it first started? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.79,
      "end_seconds": 36.02,
      "duration_seconds": 3.23,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.2,
      "end_seconds": 54.7,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.71,
      "end_seconds": 58.01,
      "duration_seconds": 2.3,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.01,
      "end_seconds": 63.23,
      "duration_seconds": 3.22,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.72,
      "end_seconds": 70.82,
      "duration_seconds": 6.1,
      "text": "Yes, COPD. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.33,
      "end_seconds": 82.57,
      "duration_seconds": 3.24,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.56,
      "end_seconds": 87.66,
      "duration_seconds": 4.1,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.62,
      "end_seconds": 91.64,
      "duration_seconds": 2.02,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.61,
      "end_seconds": 97.48,
      "duration_seconds": 3.87,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.18,
      "end_seconds": 101.22,
      "duration_seconds": 3.04,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.23,
      "end_seconds": 105.56,
      "duration_seconds": 3.33,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.37,
      "end_seconds": 110.91,
      "duration_seconds": 3.54,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.51,
      "end_seconds": 118.81,
      "duration_seconds": 7.3,
      "text": "Tiotropium inhaler. I take it once a day. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.55,
      "end_seconds": 128.67,
      "duration_seconds": 5.12,
      "text": "Alright, have you noticed drowsiness, vomiting or loss of consciousness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.57,
      "end_seconds": 139.65,
      "duration_seconds": 5.08,
      "text": "No drowsiness, vomiting or loss of consciousness, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.5,
      "end_seconds": 146.86,
      "duration_seconds": 4.36,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.96,
      "end_seconds": 151.29,
      "duration_seconds": 2.33,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.95,
      "end_seconds": 156.32,
      "duration_seconds": 3.37,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.38,
      "end_seconds": 159.45,
      "duration_seconds": 2.07,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 170.0,
      "duration_seconds": 3.37,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.63,
      "end_seconds": 185.72,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.96,
      "end_seconds": 212.0,
      "duration_seconds": 10.04,
      "text": "Okay: temp 36.8 degrees, pulse is 85 beats a minute, SpO2 99 percent on room air, blood pressure 127 over 81."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.78,
      "end_seconds": 217.51,
      "duration_seconds": 2.73,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 219.84,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.05,
      "end_seconds": 240.45,
      "duration_seconds": 7.4,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.65,
      "end_seconds": 244.22,
      "duration_seconds": 1.57,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.7,
      "end_seconds": 271.87,
      "duration_seconds": 10.17,
      "text": "Right, here's what I'm thinking. I think we're dealing with a minor head bump with no worrying signs at this stage."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.27,
      "end_seconds": 276.18,
      "duration_seconds": 2.91,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.11,
      "end_seconds": 297.05,
      "duration_seconds": 18.94,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor head bump with no worrying signs. Watch him for the next twenty-four hours and give paracetamol if he is sore. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.43,
      "end_seconds": 300.68,
      "duration_seconds": 2.25,
      "text": "Thank you, that's helpful."
    }
  ]
}