{
  "schema_version": "1.0",
  "encounter_id": "02136",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 5.41,
      "duration_seconds": 4.48,
      "text": "Morning, come on through. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.36,
      "end_seconds": 12.07,
      "duration_seconds": 5.71,
      "text": "Mainly I've been getting out of breath. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.81,
      "end_seconds": 17.22,
      "duration_seconds": 3.41,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.18,
      "end_seconds": 30.51,
      "duration_seconds": 12.33,
      "text": "Sorry, what was I saying, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.26,
      "end_seconds": 36.03,
      "duration_seconds": 3.77,
      "text": "Right, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.27,
      "end_seconds": 42.02,
      "duration_seconds": 3.75,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.32,
      "end_seconds": 45.82,
      "duration_seconds": 2.5,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.66,
      "end_seconds": 64.85,
      "duration_seconds": 18.19,
      "text": "I'd say a few times a day. And tiredness as well, since yesterday. And a chronic cough with lots of phlegm, too. With chronic cough with lots of phlegm, it's mild, honestly. I notice it more with mornings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.43,
      "end_seconds": 83.24,
      "duration_seconds": 7.81,
      "text": "Let me check a few things. Any chest pain, weight loss, fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 90.52,
      "duration_seconds": 6.54,
      "text": "No, no chest pain, weight loss, fever or coughing up blood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.4,
      "end_seconds": 94.93,
      "duration_seconds": 3.53,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.24,
      "end_seconds": 98.49,
      "duration_seconds": 2.25,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 101.78,
      "duration_seconds": 2.51,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.57,
      "end_seconds": 103.52,
      "duration_seconds": 0.95,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.93,
      "end_seconds": 118.68,
      "duration_seconds": 2.75,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.88,
      "end_seconds": 123.53,
      "duration_seconds": 3.65,
      "text": "I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.3,
      "end_seconds": 127.12,
      "duration_seconds": 1.82,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.62,
      "end_seconds": 131.03,
      "duration_seconds": 2.41,
      "text": "Migraines, for about ten years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.7,
      "end_seconds": 135.68,
      "duration_seconds": 3.98,
      "text": "Alright, low haemoglobin, that matches what I have here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.44,
      "end_seconds": 153.85,
      "duration_seconds": 3.41,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.69,
      "end_seconds": 160.75,
      "duration_seconds": 5.06,
      "text": "It's iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.06,
      "end_seconds": 162.11,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.05,
      "end_seconds": 169.93,
      "duration_seconds": 2.88,
      "text": "I'm on propranolol, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.83,
      "end_seconds": 177.25,
      "duration_seconds": 2.42,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.01,
      "end_seconds": 178.97,
      "duration_seconds": 0.96,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.57,
      "end_seconds": 185.14,
      "duration_seconds": 4.57,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.95,
      "end_seconds": 192.62,
      "duration_seconds": 5.67,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.35,
      "end_seconds": 195.81,
      "duration_seconds": 2.46,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.44,
      "end_seconds": 206.89,
      "duration_seconds": 10.45,
      "text": "I mean, just a bunion operation, six years ago. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.95,
      "end_seconds": 214.11,
      "duration_seconds": 5.16,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.1,
      "end_seconds": 228.45,
      "duration_seconds": 13.35,
      "text": "I've never touched a cigarette. Lots of rice, lentils and some fruit. My husband and I live above the shop. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.39,
      "end_seconds": 233.99,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.62,
      "end_seconds": 250.53,
      "duration_seconds": 2.91,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.76,
      "end_seconds": 277.75,
      "duration_seconds": 8.99,
      "text": "Okay: temperature 36.7, blood pressure 125 over 79, heart rate 64, SpO2 98 percent on room air, respiratory rate 14."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.35,
      "end_seconds": 280.88,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.62,
      "end_seconds": 284.5,
      "duration_seconds": 2.88,
      "text": "So, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 288.47,
      "duration_seconds": 2.38,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.83,
      "end_seconds": 291.07,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.14,
      "end_seconds": 315.44,
      "duration_seconds": 6.3,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.18,
      "end_seconds": 333.8,
      "duration_seconds": 15.62,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. I think we're dealing with a flare of bronchiectasis at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.16,
      "end_seconds": 341.83,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.64,
      "end_seconds": 361.04,
      "duration_seconds": 17.4,
      "text": "I can't promise yet, but most people with a flare of bronchiectasis do well once it's treated properly. Let's book a chest X-ray to look into bronchiectasis flare. I'm sending you for a sputum culture because of purulent sputum."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.1,
      "end_seconds": 363.5,
      "duration_seconds": 1.4,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.11,
      "end_seconds": 394.03,
      "duration_seconds": 28.92,
      "text": "I'm going to put you on clarithromycin, 500 milligrams, twice a day, fourteen days. That's for bronchiectasis flare. It's a commonly used medicine and most people tolerate it well. Keep up your airway clearance exercises twice a day. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.01,
      "end_seconds": 402.08,
      "duration_seconds": 4.07,
      "text": "So, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.47,
      "end_seconds": 405.14,
      "duration_seconds": 1.67,
      "text": "Okay, look after yourself."
    }
  ]
}