{
  "schema_version": "1.0",
  "encounter_id": "02466",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 8.66,
      "duration_seconds": 7.81,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 15.86,
      "duration_seconds": 5.93,
      "text": "Alright, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.62,
      "end_seconds": 24.35,
      "duration_seconds": 7.73,
      "text": "thank you for fitting us in, doctor we came because of breathlessness months after the infection"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.3,
      "end_seconds": 34.59,
      "duration_seconds": 9.29,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.62,
      "end_seconds": 41.14,
      "duration_seconds": 4.52,
      "text": "It happens every other day. It feels mild to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.03,
      "end_seconds": 49.79,
      "duration_seconds": 7.76,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 49.89,
      "end_seconds": 57.07,
      "duration_seconds": 7.18,
      "text": "Oh, uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.95,
      "end_seconds": 61.19,
      "duration_seconds": 2.24,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.82,
      "end_seconds": 64.5,
      "duration_seconds": 2.68,
      "text": "Okay, have you had extreme tiredness?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.1,
      "end_seconds": 66.25,
      "duration_seconds": 1.15,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.2,
      "end_seconds": 79.41,
      "duration_seconds": 12.21,
      "text": "Doctor, I've got the the readings for you. Temperature is 36.6 degrees, pulse 65, saturation 98 percent, respiratory rate 14, blood pressure 111 over 74."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.01,
      "end_seconds": 81.97,
      "duration_seconds": 0.96,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.52,
      "end_seconds": 86.12,
      "duration_seconds": 2.6,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.29,
      "end_seconds": 88.57,
      "duration_seconds": 1.28,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.29,
      "end_seconds": 112.85,
      "duration_seconds": 5.56,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.67,
      "end_seconds": 118.0,
      "duration_seconds": 2.33,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.86,
      "end_seconds": 139.64,
      "duration_seconds": 5.78,
      "text": "Have you had any chest pain, leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.47,
      "end_seconds": 155.8,
      "duration_seconds": 14.33,
      "text": "no, no chest pain, no leg swelling, no coughing up blood i did have a racing heart on standing at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.24,
      "end_seconds": 159.04,
      "duration_seconds": 1.8,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.06,
      "end_seconds": 161.79,
      "duration_seconds": 1.73,
      "text": "No fever, thankfully."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 163.15,
      "end_seconds": 167.81,
      "duration_seconds": 4.66,
      "text": "actually, doctor, I did notice fever. She doesn't always say"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.96,
      "end_seconds": 174.8,
      "duration_seconds": 5.84,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.37,
      "end_seconds": 185.26,
      "duration_seconds": 8.89,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.17,
      "end_seconds": 187.24,
      "duration_seconds": 1.07,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.71,
      "end_seconds": 193.19,
      "duration_seconds": 4.48,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.11,
      "end_seconds": 198.29,
      "duration_seconds": 1.18,
      "text": "Yes, nickel."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.95,
      "end_seconds": 202.31,
      "duration_seconds": 2.36,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.7,
      "end_seconds": 208.39,
      "duration_seconds": 4.69,
      "text": "Iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.21,
      "end_seconds": 216.1,
      "duration_seconds": 5.89,
      "text": "that's what's prescribed, but I'm not sure she takes it every day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.61,
      "end_seconds": 223.44,
      "duration_seconds": 5.83,
      "text": "I take something called esci... escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.99,
      "end_seconds": 227.84,
      "duration_seconds": 2.85,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.44,
      "end_seconds": 242.07,
      "duration_seconds": 12.63,
      "text": "Well, not with me. I'll bring it next time. I'm on hydrocortisone cream, when needed. I was on sertraline before. I stopped taking it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.85,
      "end_seconds": 244.14,
      "duration_seconds": 1.29,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.93,
      "end_seconds": 248.75,
      "duration_seconds": 2.82,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.27,
      "end_seconds": 252.3,
      "duration_seconds": 2.03,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.25,
      "end_seconds": 258.78,
      "duration_seconds": 4.53,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.22,
      "end_seconds": 263.4,
      "duration_seconds": 3.18,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 264.75,
      "end_seconds": 267.66,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.22,
      "end_seconds": 271.51,
      "duration_seconds": 3.29,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 273.46,
      "end_seconds": 292.35,
      "duration_seconds": 18.89,
      "text": "I have low haemoglobin, for nearly five years. I have depression. I have eczema, for about a year. It's the not knowing that gets to me. Anxiety, for two years. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.31,
      "end_seconds": 303.28,
      "duration_seconds": 9.97,
      "text": "Yes, eczema and anxiety are known to us, good to have that clear. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.16,
      "end_seconds": 309.78,
      "duration_seconds": 4.62,
      "text": "My father had bowel cancer. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.94,
      "end_seconds": 331.89,
      "duration_seconds": 12.95,
      "text": "Pace your activity and increase it slowly each week. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.32,
      "end_seconds": 334.87,
      "duration_seconds": 1.55,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.68,
      "end_seconds": 344.81,
      "duration_seconds": 8.13,
      "text": "If the symptoms get worse, that's the point to come in urgently. We'll catch up in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.69,
      "end_seconds": 349.0,
      "duration_seconds": 3.31,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.01,
      "end_seconds": 353.65,
      "duration_seconds": 2.64,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.14,
      "end_seconds": 364.14,
      "duration_seconds": 5.0,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.34,
      "end_seconds": 368.07,
      "duration_seconds": 1.73,
      "text": "okay, all the best"
    }
  ]
}