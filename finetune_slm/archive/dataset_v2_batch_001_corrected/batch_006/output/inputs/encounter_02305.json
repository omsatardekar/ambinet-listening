{
  "schema_version": "1.0",
  "encounter_id": "02305",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 3.24,
      "duration_seconds": 2.07,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.4,
      "end_seconds": 7.48,
      "duration_seconds": 3.08,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.13,
      "end_seconds": 9.96,
      "duration_seconds": 1.83,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.45,
      "end_seconds": 15.48,
      "duration_seconds": 4.03,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.79,
      "end_seconds": 19.87,
      "duration_seconds": 3.08,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.25,
      "end_seconds": 29.77,
      "duration_seconds": 4.52,
      "text": "I've been dealing with pain in the lower left tummy."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 33.59,
      "duration_seconds": 3.24,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.18,
      "end_seconds": 38.64,
      "duration_seconds": 3.46,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 41.4,
      "duration_seconds": 2.42,
      "text": "Sure. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.11,
      "end_seconds": 53.6,
      "duration_seconds": 10.49,
      "text": "It usually comes with a low fever. The low fever? That's been for five days. And I've been feeling bloated as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.93,
      "end_seconds": 60.87,
      "duration_seconds": 5.94,
      "text": "Have you had any urinary symptoms, weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.87,
      "end_seconds": 64.82,
      "duration_seconds": 2.95,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.6,
      "end_seconds": 67.78,
      "duration_seconds": 2.18,
      "text": "Did you notice any vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.87,
      "end_seconds": 72.42,
      "duration_seconds": 2.55,
      "text": "I haven't noticed any vomiting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.38,
      "end_seconds": 76.02,
      "duration_seconds": 1.64,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.36,
      "end_seconds": 78.43,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.85,
      "end_seconds": 90.04,
      "duration_seconds": 3.19,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 97.68,
      "duration_seconds": 6.1,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.76,
      "end_seconds": 105.26,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.47,
      "end_seconds": 113.64,
      "duration_seconds": 3.17,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.17,
      "end_seconds": 119.23,
      "duration_seconds": 4.06,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.05,
      "end_seconds": 131.07,
      "duration_seconds": 10.02,
      "text": "I've never touched a cigarette. No, I share a house with my brother. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.94,
      "end_seconds": 136.79,
      "duration_seconds": 3.85,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.89,
      "end_seconds": 142.01,
      "duration_seconds": 4.12,
      "text": "I'm on Thyronorm, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.39,
      "end_seconds": 146.1,
      "duration_seconds": 2.71,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.02,
      "end_seconds": 149.02,
      "duration_seconds": 1.0,
      "text": "50 micrograms."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.22,
      "end_seconds": 152.82,
      "duration_seconds": 2.6,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.78,
      "end_seconds": 159.88,
      "duration_seconds": 2.1,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.25,
      "end_seconds": 175.5,
      "duration_seconds": 3.25,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.5,
      "end_seconds": 179.88,
      "duration_seconds": 2.38,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.46,
      "end_seconds": 190.0,
      "duration_seconds": 4.54,
      "text": "Mm, okay. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 201.31,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.51,
      "end_seconds": 225.11,
      "duration_seconds": 6.6,
      "text": "Okay: pulse 98, respiratory rate 20. And pressure 114 over 70, temperature is 38.5 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.02,
      "end_seconds": 230.26,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.19,
      "end_seconds": 233.6,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.7,
      "end_seconds": 247.6,
      "duration_seconds": 5.9,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.74,
      "end_seconds": 259.74,
      "duration_seconds": 8.0,
      "text": "All finished, thank you. Putting it all together, I'd lean towards acute diverticulitis. We shouldn't forget a bowel tumour."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.95,
      "end_seconds": 264.29,
      "duration_seconds": 3.34,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.47,
      "end_seconds": 288.77,
      "duration_seconds": 23.3,
      "text": "I understand the worry. At the moment I'd say it's acute diverticulitis, and we'll know more once the a CT scan is back. Let me just check I've got this right. You've had pain in the lower left tummy, since last weekend, and no urinary symptoms or weight loss."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.03,
      "end_seconds": 294.75,
      "duration_seconds": 1.72,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.36,
      "end_seconds": 313.56,
      "duration_seconds": 5.2,
      "text": "I'm going to order a CT scan, for left iliac fossa pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.61,
      "end_seconds": 316.24,
      "duration_seconds": 1.63,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.83,
      "end_seconds": 325.1,
      "duration_seconds": 8.27,
      "text": "What I'm giving you is co-amoxiclav, 625 milligrams, three times a day, five days. That should help with diverticulitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.81,
      "end_seconds": 329.31,
      "duration_seconds": 2.5,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.0,
      "end_seconds": 340.29,
      "duration_seconds": 10.29,
      "text": "Drink plenty and start with a light diet. See me again in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.1,
      "end_seconds": 343.89,
      "duration_seconds": 2.79,
      "text": "I think I understand everything. Thanks."
    }
  ]
}