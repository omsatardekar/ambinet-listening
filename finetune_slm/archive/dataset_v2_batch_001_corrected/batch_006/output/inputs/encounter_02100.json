{
  "schema_version": "1.0",
  "encounter_id": "02100",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.81,
      "duration_seconds": 4.46,
      "text": "Actually, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.89,
      "end_seconds": 12.05,
      "duration_seconds": 4.16,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.84,
      "end_seconds": 21.39,
      "duration_seconds": 7.55,
      "text": "Honestly, it's vomiting large amounts of fresh blood, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.4,
      "end_seconds": 23.58,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.55,
      "end_seconds": 28.07,
      "duration_seconds": 2.52,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.08,
      "end_seconds": 32.56,
      "duration_seconds": 2.48,
      "text": "Has there been being confused too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.19,
      "end_seconds": 37.65,
      "duration_seconds": 1.46,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 41.3,
      "duration_seconds": 2.56,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.35,
      "end_seconds": 54.24,
      "duration_seconds": 2.89,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 77.64,
      "duration_seconds": 8.88,
      "text": "Okay: heart rate 97, respiratory rate 16, SpO2 99 percent on room air, BP is 103 over 57."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.46,
      "end_seconds": 79.87,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 85.49,
      "duration_seconds": 3.63,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.93,
      "end_seconds": 91.73,
      "duration_seconds": 4.8,
      "text": "Right, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.08,
      "end_seconds": 94.68,
      "duration_seconds": 1.6,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.03,
      "end_seconds": 98.95,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.35,
      "end_seconds": 119.09,
      "duration_seconds": 6.74,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 126.52,
      "duration_seconds": 2.33,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.61,
      "end_seconds": 142.85,
      "duration_seconds": 3.24,
      "text": "And what about chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.89,
      "end_seconds": 148.87,
      "duration_seconds": 3.98,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.42,
      "end_seconds": 154.0,
      "duration_seconds": 3.58,
      "text": "Alright, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.96,
      "end_seconds": 157.89,
      "duration_seconds": 2.93,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.73,
      "end_seconds": 162.23,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.21,
      "end_seconds": 164.87,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.63,
      "end_seconds": 168.49,
      "duration_seconds": 2.86,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.51,
      "end_seconds": 174.13,
      "duration_seconds": 3.62,
      "text": "I've had anxiety for nearly five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.23,
      "end_seconds": 175.93,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.32,
      "end_seconds": 197.73,
      "duration_seconds": 4.41,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.9,
      "end_seconds": 202.05,
      "duration_seconds": 3.15,
      "text": "Escitalopram. I take it once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.68,
      "end_seconds": 206.0,
      "duration_seconds": 2.32,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.67,
      "end_seconds": 213.09,
      "duration_seconds": 5.42,
      "text": "It's 10 milligrams. Alcohol every day. I take it daily."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.55,
      "end_seconds": 225.74,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.35,
      "end_seconds": 229.22,
      "duration_seconds": 2.87,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.13,
      "end_seconds": 232.35,
      "duration_seconds": 1.22,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.41,
      "end_seconds": 237.76,
      "duration_seconds": 3.35,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.58,
      "end_seconds": 244.49,
      "duration_seconds": 3.91,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.25,
      "end_seconds": 247.3,
      "duration_seconds": 2.05,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.07,
      "end_seconds": 251.04,
      "duration_seconds": 2.97,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.83,
      "end_seconds": 254.66,
      "duration_seconds": 2.83,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.8,
      "end_seconds": 294.24,
      "duration_seconds": 31.44,
      "text": "So where does that leave us? This is probably a bleed from enlarged veins in the gullet in liver disease. We should do an urgent endoscopy for variceal bleed. For this, terlipressin, 2 milligrams, now, single dose. That's for variceal bleeding. You are going straight to resus, I am starting two drips. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 305.3,
      "duration_seconds": 9.09,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.9,
      "end_seconds": 308.66,
      "duration_seconds": 2.76,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.58,
      "end_seconds": 313.07,
      "duration_seconds": 2.49,
      "text": "Okay, have a good day."
    }
  ]
}