{
  "schema_version": "1.0",
  "encounter_id": "02072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 6.01,
      "duration_seconds": 5.42,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.06,
      "end_seconds": 9.75,
      "duration_seconds": 2.69,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.44,
      "end_seconds": 13.78,
      "duration_seconds": 2.34,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.77,
      "end_seconds": 21.62,
      "duration_seconds": 6.85,
      "text": "Honestly, it's not listening at school, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.37,
      "end_seconds": 25.77,
      "duration_seconds": 3.4,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.83,
      "end_seconds": 29.31,
      "duration_seconds": 1.48,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 47.29,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.0,
      "end_seconds": 59.0,
      "duration_seconds": 10.0,
      "text": "Yesterday, it came on out of nowhere. And there's a cold that won't go as well, about a month now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.88,
      "end_seconds": 64.64,
      "duration_seconds": 3.76,
      "text": "Have you noticed discharge, fever or ear pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.91,
      "end_seconds": 68.83,
      "duration_seconds": 2.92,
      "text": "Hmm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.42,
      "end_seconds": 72.11,
      "duration_seconds": 2.69,
      "text": "Right, has there been any dizziness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.1,
      "end_seconds": 78.63,
      "duration_seconds": 5.53,
      "text": "Sorry, what was I saying, not at all, no dizziness."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.32,
      "end_seconds": 84.3,
      "duration_seconds": 3.98,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.33,
      "end_seconds": 91.0,
      "duration_seconds": 4.67,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 96.95,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.85,
      "end_seconds": 99.8,
      "duration_seconds": 1.95,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.49,
      "end_seconds": 118.37,
      "duration_seconds": 2.88,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 123.28,
      "duration_seconds": 3.83,
      "text": "No, um, I've never been operated on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.47,
      "end_seconds": 129.74,
      "duration_seconds": 1.27,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.82,
      "end_seconds": 135.24,
      "duration_seconds": 4.42,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.82,
      "end_seconds": 139.67,
      "duration_seconds": 2.85,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.6,
      "end_seconds": 143.9,
      "duration_seconds": 3.3,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.33,
      "end_seconds": 147.8,
      "duration_seconds": 2.47,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.05,
      "end_seconds": 152.52,
      "duration_seconds": 3.47,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.25,
      "end_seconds": 156.08,
      "duration_seconds": 2.83,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 161.79,
      "duration_seconds": 3.95,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.55,
      "end_seconds": 166.01,
      "duration_seconds": 3.46,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.35,
      "end_seconds": 174.81,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.39,
      "end_seconds": 202.98,
      "duration_seconds": 12.59,
      "text": "Okay: temp 36.5 degrees, pulse is 85 beats a minute, blood pressure 123 over 78. And SpO2 97 percent on room air, respiratory rate 14."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.23,
      "end_seconds": 209.64,
      "duration_seconds": 4.41,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.0,
      "end_seconds": 229.12,
      "duration_seconds": 1.12,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.83,
      "end_seconds": 232.12,
      "duration_seconds": 1.29,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.72,
      "end_seconds": 248.33,
      "duration_seconds": 4.61,
      "text": "Both ear drums look dull and retracted with fluid behind them."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.03,
      "end_seconds": 256.58,
      "duration_seconds": 2.55,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.82,
      "end_seconds": 286.78,
      "duration_seconds": 15.96,
      "text": "Putting it all together, this looks most like glue ear. I want to be honest that this is an impression, not a final answer. I'd like to arrange a hearing test for reduced hearing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 287.52,
      "end_seconds": 290.02,
      "duration_seconds": 2.5,
      "text": "The earliest is Wednesday, 9 am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.31,
      "end_seconds": 313.64,
      "duration_seconds": 22.33,
      "text": "We will watch for three months, and sit him at the front of the class. Please take the tablets with food so they don't upset your stomach. If the symptoms get worse, that's the point to come in urgently. Book a review in three months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.85,
      "end_seconds": 318.75,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.64,
      "end_seconds": 321.23,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}