{
  "schema_version": "1.0",
  "encounter_id": "02135",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.66,
      "duration_seconds": 3.81,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 10.37,
      "duration_seconds": 4.8,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 15.74,
      "duration_seconds": 4.22,
      "text": "It's electric shock pains in my cheek, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.46,
      "end_seconds": 24.36,
      "duration_seconds": 3.9,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.79,
      "end_seconds": 33.59,
      "duration_seconds": 7.8,
      "text": "Probably one week. Yeah. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.36,
      "end_seconds": 42.16,
      "duration_seconds": 3.8,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 45.75,
      "duration_seconds": 2.43,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.33,
      "end_seconds": 64.7,
      "duration_seconds": 2.37,
      "text": "Has there been any hearing loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.68,
      "end_seconds": 68.75,
      "duration_seconds": 2.07,
      "text": "Definitely no hearing loss."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.87,
      "end_seconds": 72.15,
      "duration_seconds": 2.28,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.73,
      "end_seconds": 73.74,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.8,
      "end_seconds": 79.73,
      "duration_seconds": 3.93,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.88,
      "end_seconds": 83.73,
      "duration_seconds": 2.85,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.7,
      "end_seconds": 87.23,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.94,
      "end_seconds": 92.69,
      "duration_seconds": 3.75,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 97.05,
      "duration_seconds": 2.58,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.03,
      "end_seconds": 102.74,
      "duration_seconds": 3.71,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 120.59,
      "duration_seconds": 3.3,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.53,
      "end_seconds": 124.27,
      "duration_seconds": 1.74,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.77,
      "end_seconds": 144.1,
      "duration_seconds": 3.33,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.73,
      "end_seconds": 146.53,
      "duration_seconds": 1.8,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.56,
      "end_seconds": 149.81,
      "duration_seconds": 2.25,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.74,
      "end_seconds": 152.5,
      "duration_seconds": 1.76,
      "text": "Paracetamol, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.13,
      "end_seconds": 155.6,
      "duration_seconds": 2.47,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.56,
      "end_seconds": 158.68,
      "duration_seconds": 1.12,
      "text": "1 gram."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.29,
      "end_seconds": 164.12,
      "duration_seconds": 4.83,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.16,
      "end_seconds": 168.33,
      "duration_seconds": 3.17,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.38,
      "end_seconds": 172.27,
      "duration_seconds": 2.89,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.92,
      "end_seconds": 184.74,
      "duration_seconds": 2.82,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.89,
      "end_seconds": 206.63,
      "duration_seconds": 7.74,
      "text": "Okay: temperature 36.6, saturation 99 percent, pulse is 77 beats a minute, blood pressure 127 over 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.98,
      "end_seconds": 209.53,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.53,
      "end_seconds": 214.34,
      "duration_seconds": 3.81,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 219.0,
      "duration_seconds": 3.63,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.33,
      "end_seconds": 222.02,
      "duration_seconds": 1.69,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.64,
      "end_seconds": 237.01,
      "duration_seconds": 6.37,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.66,
      "end_seconds": 242.79,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.54,
      "end_seconds": 258.35,
      "duration_seconds": 4.81,
      "text": "Taking everything into account, the most likely explanation is trigeminal neuralgia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.03,
      "end_seconds": 263.28,
      "duration_seconds": 3.25,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.0,
      "end_seconds": 290.77,
      "duration_seconds": 26.77,
      "text": "I understand the worry. At the moment I'd say it's trigeminal neuralgia, and we'll know more once the an MRI scan of the head is back. I'm sending you for an MRI scan of the head because of facial pain. The treatment will be carbamazepine, 100 milligrams, twice a day, titrate. That should help with nerve pain. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 305.05,
      "duration_seconds": 13.05,
      "text": "Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Let's get you seen by the neurology clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.38,
      "end_seconds": 309.15,
      "duration_seconds": 2.77,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 317.11,
      "duration_seconds": 7.19,
      "text": "I'll want another look in four weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.7,
      "end_seconds": 321.83,
      "duration_seconds": 4.13,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}