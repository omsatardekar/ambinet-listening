{
  "schema_version": "1.0",
  "encounter_id": "02352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 8.97,
      "duration_seconds": 7.79,
      "text": "sorry, uh, what was I saying, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.91,
      "end_seconds": 18.78,
      "duration_seconds": 4.87,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.55,
      "end_seconds": 25.75,
      "duration_seconds": 5.2,
      "text": "I, I wanted to get a high temperature looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.83,
      "end_seconds": 31.33,
      "duration_seconds": 3.5,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.55,
      "end_seconds": 46.21,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.04,
      "end_seconds": 82.95,
      "duration_seconds": 14.91,
      "text": "okay: weight 53 kilos, saturation 95 percent, height 176 centimetres. And BMI works out to 17.1, heart rate 90, temperature is 38.7 degrees, BP is 122 over 76, respiratory rate 19."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.38,
      "end_seconds": 101.86,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.35,
      "end_seconds": 105.74,
      "duration_seconds": 2.39,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.29,
      "end_seconds": 110.47,
      "duration_seconds": 3.18,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.1,
      "end_seconds": 112.66,
      "duration_seconds": 1.56,
      "text": "it's mild, honestly"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.46,
      "end_seconds": 115.37,
      "duration_seconds": 1.91,
      "text": "Have you had agitation?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.14,
      "end_seconds": 118.61,
      "duration_seconds": 2.47,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.2,
      "end_seconds": 123.38,
      "duration_seconds": 4.18,
      "text": "so, have you noticed recent infection or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.92,
      "end_seconds": 128.42,
      "duration_seconds": 3.5,
      "text": "No, no recent infection or chest pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 132.66,
      "duration_seconds": 2.36,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.72,
      "end_seconds": 137.27,
      "duration_seconds": 2.55,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.08,
      "end_seconds": 140.04,
      "duration_seconds": 1.96,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 144.16,
      "duration_seconds": 3.38,
      "text": "oh, no, I'm not on anything"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.21,
      "end_seconds": 158.95,
      "duration_seconds": 3.74,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 166.43,
      "duration_seconds": 2.72,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.34,
      "end_seconds": 169.88,
      "duration_seconds": 2.54,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.72,
      "end_seconds": 174.22,
      "duration_seconds": 3.5,
      "text": "Yes, cat fur, it gives me wheezing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.22,
      "end_seconds": 179.1,
      "duration_seconds": 3.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.6,
      "end_seconds": 183.5,
      "duration_seconds": 3.9,
      "text": "Let me think, no, nothing at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.2,
      "end_seconds": 195.96,
      "duration_seconds": 1.76,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.98,
      "end_seconds": 200.63,
      "duration_seconds": 2.65,
      "text": "yeah, no, not at all"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 203.99,
      "duration_seconds": 1.61,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.06,
      "end_seconds": 208.87,
      "duration_seconds": 3.81,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.43,
      "end_seconds": 211.39,
      "duration_seconds": 0.96,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.07,
      "end_seconds": 215.58,
      "duration_seconds": 3.51,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.56,
      "end_seconds": 219.51,
      "duration_seconds": 1.95,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.02,
      "end_seconds": 225.02,
      "duration_seconds": 4.0,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.56,
      "end_seconds": 228.26,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.71,
      "end_seconds": 233.5,
      "duration_seconds": 3.79,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.35,
      "end_seconds": 237.23,
      "duration_seconds": 2.88,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.94,
      "end_seconds": 244.48,
      "duration_seconds": 5.54,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.52,
      "end_seconds": 250.67,
      "duration_seconds": 4.15,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.04,
      "end_seconds": 255.13,
      "duration_seconds": 3.09,
      "text": "Take a a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 273.9,
      "duration_seconds": 6.44,
      "text": "you are hot, shaking, and your pulse is over one hundred and forty and irregular"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.06,
      "end_seconds": 280.35,
      "duration_seconds": 2.29,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.85,
      "end_seconds": 305.15,
      "duration_seconds": 13.3,
      "text": "Okay, thinking it through, it's hard to say. A thyroid storm is one possibility and and sepsis another, and I'd rather not commit yet. Let's get an ECG, for fast heart rhythm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.68,
      "end_seconds": 308.29,
      "duration_seconds": 1.61,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.82,
      "end_seconds": 332.18,
      "duration_seconds": 22.36,
      "text": "I'm prescribing propranolol, 1 milligrams, now, single dose. That's for thyroid storm. This is an emergency, you will be treated in high dependency. Let's get you seen by the emergency team, I'll arrange the letter. See me again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.23,
      "end_seconds": 338.55,
      "duration_seconds": 4.32,
      "text": "Uh, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.39,
      "end_seconds": 341.75,
      "duration_seconds": 2.36,
      "text": "Right, have a good day."
    }
  ]
}