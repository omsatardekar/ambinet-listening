{
  "schema_version": "1.0",
  "encounter_id": "02170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 3.64,
      "duration_seconds": 3.07,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 8.76,
      "duration_seconds": 3.7,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.08,
      "end_seconds": 20.32,
      "duration_seconds": 7.24,
      "text": "Hmm, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.74,
      "end_seconds": 24.87,
      "duration_seconds": 3.13,
      "text": "Absolutely, come and and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.91,
      "end_seconds": 34.87,
      "duration_seconds": 7.96,
      "text": "sorry, what was I saying, doctor, it's been sweating that's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 35.53,
      "end_seconds": 44.0,
      "duration_seconds": 8.47,
      "text": "Here are the numbers doctor. BP is 118 over 76 saturation 93 percent pulse 84. Respiratory rate 23 temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.6,
      "end_seconds": 45.91,
      "duration_seconds": 1.31,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.77,
      "end_seconds": 64.7,
      "duration_seconds": 1.93,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.88,
      "end_seconds": 70.95,
      "duration_seconds": 5.07,
      "text": "Hmm, it's been going on for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.39,
      "end_seconds": 75.15,
      "duration_seconds": 2.76,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 77.29,
      "duration_seconds": 1.03,
      "text": "mostly severe"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.7,
      "end_seconds": 84.53,
      "duration_seconds": 6.83,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 84.63,
      "end_seconds": 90.51,
      "duration_seconds": 5.88,
      "text": "Sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 94.68,
      "duration_seconds": 2.32,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.34,
      "end_seconds": 99.93,
      "duration_seconds": 3.59,
      "text": "There's a pounding heart as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.62,
      "end_seconds": 104.23,
      "duration_seconds": 3.61,
      "text": "Have you been sweating at any time before this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.58,
      "end_seconds": 111.64,
      "duration_seconds": 6.06,
      "text": "I had a similar thing about six months ago it went away"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.17,
      "end_seconds": 117.47,
      "duration_seconds": 4.3,
      "text": "have you had any wheeze calf pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 132.84,
      "duration_seconds": 13.39,
      "text": "no, you know, no wheeze, no calf pain, no fever. I did have being very breathless at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.25,
      "end_seconds": 138.54,
      "duration_seconds": 4.29,
      "text": "Right, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.68,
      "end_seconds": 147.0,
      "duration_seconds": 2.32,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.53,
      "end_seconds": 153.49,
      "duration_seconds": 1.96,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.11,
      "end_seconds": 156.1,
      "duration_seconds": 0.99,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.96,
      "end_seconds": 160.37,
      "duration_seconds": 2.41,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.27,
      "end_seconds": 172.0,
      "duration_seconds": 9.73,
      "text": "High blood pressure for about ten years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.27,
      "end_seconds": 174.57,
      "duration_seconds": 1.3,
      "text": "Okay go on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.82,
      "end_seconds": 187.58,
      "duration_seconds": 11.76,
      "text": "yes, heart failure i've had anxiety for about a year now it's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.4,
      "end_seconds": 202.02,
      "duration_seconds": 12.62,
      "text": "right, so high blood pressure and heart failure are already on your record we'll keep that in mind today right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.85,
      "end_seconds": 210.37,
      "duration_seconds": 3.52,
      "text": "My mother had a a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.1,
      "end_seconds": 233.14,
      "duration_seconds": 5.04,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.58,
      "end_seconds": 239.35,
      "duration_seconds": 4.77,
      "text": "I mean, no, not that I know of"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.22,
      "end_seconds": 243.78,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.8,
      "end_seconds": 249.55,
      "duration_seconds": 4.75,
      "text": "I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.99,
      "end_seconds": 252.75,
      "duration_seconds": 1.76,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.05,
      "end_seconds": 261.17,
      "duration_seconds": 7.12,
      "text": "About about a year. Furosemide, 40 milligrams, maybe, every morning for the fluid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.02,
      "end_seconds": 266.11,
      "duration_seconds": 3.09,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.19,
      "end_seconds": 276.95,
      "duration_seconds": 9.76,
      "text": "Sorry what was I saying no it's at home. Escitalopram. I take it 10 milligrams once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.99,
      "end_seconds": 281.21,
      "duration_seconds": 3.22,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.86,
      "end_seconds": 286.39,
      "duration_seconds": 3.53,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.96,
      "end_seconds": 289.16,
      "duration_seconds": 2.2,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.37,
      "end_seconds": 299.09,
      "duration_seconds": 4.72,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.86,
      "end_seconds": 306.04,
      "duration_seconds": 4.18,
      "text": "alright, over here please and and I'll take a look"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.07,
      "end_seconds": 308.89,
      "duration_seconds": 1.82,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.14,
      "end_seconds": 324.29,
      "duration_seconds": 6.15,
      "text": "there are crackles all the way up both lungs and you are breathing very fast"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.59,
      "end_seconds": 345.17,
      "duration_seconds": 15.58,
      "text": "please sit back down so, based on the history and and the examination, I think we're dealing with acute pulmonary oedema at this stage it could also be a severe chest infection, so we'll keep that open"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 346.44,
      "end_seconds": 352.59,
      "duration_seconds": 6.15,
      "text": "doctor I did an ECG before they came in the result's on your screen"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.01,
      "end_seconds": 372.88,
      "duration_seconds": 18.87,
      "text": "okay, I'll take a look at that we should do blood tests for pulmonary oedema sit upright, I am giving oxygen and a water tablet injection now and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.64,
      "end_seconds": 374.68,
      "duration_seconds": 1.04,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.58,
      "end_seconds": 383.38,
      "duration_seconds": 4.8,
      "text": "see me again straight away does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.24,
      "end_seconds": 387.94,
      "duration_seconds": 3.7,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.84,
      "end_seconds": 392.2,
      "duration_seconds": 2.36,
      "text": "okay have a good day"
    }
  ]
}