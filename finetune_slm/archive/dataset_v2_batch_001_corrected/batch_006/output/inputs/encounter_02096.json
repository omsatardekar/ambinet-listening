{
  "schema_version": "1.0",
  "encounter_id": "02096",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 2.65,
      "duration_seconds": 2.1,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.43,
      "end_seconds": 8.52,
      "duration_seconds": 5.09,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.39,
      "end_seconds": 16.55,
      "duration_seconds": 6.16,
      "text": "Of course, please stay. It's helpful to have you here. What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.3,
      "end_seconds": 21.31,
      "duration_seconds": 4.01,
      "text": "It's pain in my back and hips, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.85,
      "end_seconds": 26.69,
      "duration_seconds": 2.84,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.14,
      "end_seconds": 31.61,
      "duration_seconds": 3.47,
      "text": "It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.87,
      "end_seconds": 47.16,
      "duration_seconds": 10.29,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 58.63,
      "duration_seconds": 10.9,
      "text": "Mm, it's worse with moving. Pretty mild, if I'm being honest. I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.33,
      "end_seconds": 67.33,
      "duration_seconds": 8.0,
      "text": "Actually, um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 67.43,
      "end_seconds": 74.26,
      "duration_seconds": 6.83,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.75,
      "end_seconds": 78.24,
      "duration_seconds": 2.49,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.18,
      "end_seconds": 82.91,
      "duration_seconds": 2.73,
      "text": "I've also been feeling sick."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.5,
      "end_seconds": 86.3,
      "duration_seconds": 2.8,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.32,
      "end_seconds": 91.48,
      "duration_seconds": 4.16,
      "text": "Ah, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 92.36,
      "end_seconds": 94.3,
      "duration_seconds": 1.94,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 98.46,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.9,
      "end_seconds": 104.43,
      "duration_seconds": 4.53,
      "text": "Hmm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.48,
      "end_seconds": 111.78,
      "duration_seconds": 5.3,
      "text": "Right, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.33,
      "end_seconds": 123.48,
      "duration_seconds": 11.15,
      "text": "Omeprazole, 20 milligrams, once a day. Losartan. I take it 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 125.04,
      "end_seconds": 134.99,
      "duration_seconds": 9.95,
      "text": "Yeah, it's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.06,
      "end_seconds": 145.01,
      "duration_seconds": 7.95,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.95,
      "end_seconds": 150.49,
      "duration_seconds": 2.54,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.3,
      "end_seconds": 167.81,
      "duration_seconds": 12.51,
      "text": "So, you know, for my heart, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.03,
      "end_seconds": 172.14,
      "duration_seconds": 3.11,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.23,
      "end_seconds": 184.11,
      "duration_seconds": 7.88,
      "text": "My son has asthma. Let me think, uh, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.88,
      "end_seconds": 188.49,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.29,
      "end_seconds": 200.2,
      "duration_seconds": 10.91,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.02,
      "end_seconds": 206.23,
      "duration_seconds": 4.21,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.77,
      "end_seconds": 221.12,
      "duration_seconds": 13.35,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.14,
      "end_seconds": 225.95,
      "duration_seconds": 2.81,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.49,
      "end_seconds": 230.45,
      "duration_seconds": 2.96,
      "text": "I, I have acid reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.64,
      "end_seconds": 234.39,
      "duration_seconds": 2.75,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.58,
      "end_seconds": 242.14,
      "duration_seconds": 6.56,
      "text": "I, I have high blood pressure. Heart failure, for nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.93,
      "end_seconds": 248.9,
      "duration_seconds": 4.97,
      "text": "Alright, high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 271.36,
      "duration_seconds": 3.9,
      "text": "And what about bleeding or shortness of breath?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.22,
      "end_seconds": 285.14,
      "duration_seconds": 12.92,
      "text": "No, no bleeding, no shortness of breath. I did have being very tired at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.12,
      "end_seconds": 290.91,
      "duration_seconds": 4.79,
      "text": "Let me check a few things. Any vomiting or confusion?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.65,
      "end_seconds": 297.78,
      "duration_seconds": 5.13,
      "text": "Yeah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.04,
      "end_seconds": 301.53,
      "duration_seconds": 2.49,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.3,
      "end_seconds": 303.31,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.73,
      "end_seconds": 306.12,
      "duration_seconds": 1.39,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.12,
      "end_seconds": 309.94,
      "duration_seconds": 2.82,
      "text": "Erm, no, that's all normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 311.61,
      "end_seconds": 320.72,
      "duration_seconds": 9.11,
      "text": "Doctor, I've got the readings for you. Pulse is 85 beats a minute, SpO2 97 percent on room air, pressure 121 over 81."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.76,
      "end_seconds": 323.08,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.77,
      "end_seconds": 329.06,
      "duration_seconds": 4.29,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.34,
      "end_seconds": 333.24,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.13,
      "end_seconds": 355.11,
      "duration_seconds": 3.98,
      "text": "Your tummy is soft and you look comfortable and thin."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.12,
      "end_seconds": 369.56,
      "duration_seconds": 11.44,
      "text": "Okay, that's all I needed to check. Taking everything into account, the most likely explanation is cancer pain needing better control. Another possibility is opioid-induced constipation."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 370.52,
      "end_seconds": 374.15,
      "duration_seconds": 3.63,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.24,
      "end_seconds": 385.34,
      "duration_seconds": 10.1,
      "text": "I understand the worry. At the moment I'd say it's cancer pain needing better control, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.68,
      "end_seconds": 410.5,
      "duration_seconds": 6.82,
      "text": "Take the long-acting tablet regularly and the liquid for breakthrough pain. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.02,
      "end_seconds": 418.13,
      "duration_seconds": 3.11,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.79,
      "end_seconds": 421.04,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}