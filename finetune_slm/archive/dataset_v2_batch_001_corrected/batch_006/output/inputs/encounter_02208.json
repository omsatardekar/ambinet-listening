{
  "schema_version": "1.0",
  "encounter_id": "02208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 2.7,
      "duration_seconds": 1.88,
      "text": "morning, come on through"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.72,
      "end_seconds": 8.53,
      "duration_seconds": 3.81,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.63,
      "end_seconds": 14.49,
      "duration_seconds": 1.86,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.12,
      "end_seconds": 21.26,
      "duration_seconds": 6.14,
      "text": "I wanted to get a back that has got shorter looked at"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.21,
      "end_seconds": 27.03,
      "duration_seconds": 2.82,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.08,
      "end_seconds": 41.32,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.48,
      "end_seconds": 75.25,
      "duration_seconds": 12.77,
      "text": "Okay: BP is 126 over 74, pulse is 71 beats a a minute, oxygen saturation is 99 percent, weight 71 kilos, respiratory rate 14, height 172 centimetres."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.23,
      "end_seconds": 78.9,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.54,
      "end_seconds": 91.86,
      "duration_seconds": 11.32,
      "text": "So, they help me see the whole picture, more shortly. Can you tell me when it first started? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.1,
      "end_seconds": 98.96,
      "duration_seconds": 4.86,
      "text": "So, it's been like this since last weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.41,
      "end_seconds": 103.25,
      "duration_seconds": 2.84,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.96,
      "end_seconds": 108.0,
      "duration_seconds": 4.04,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.36,
      "end_seconds": 111.32,
      "duration_seconds": 1.96,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.98,
      "end_seconds": 121.55,
      "duration_seconds": 8.57,
      "text": "When it starts I tend to get a wrist broken in a slip as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.87,
      "end_seconds": 122.57,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.94,
      "end_seconds": 140.22,
      "duration_seconds": 5.28,
      "text": "Let me check a few things. Any numbness or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.8,
      "end_seconds": 146.28,
      "duration_seconds": 4.48,
      "text": "I haven't had numbness or weight loss, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.24,
      "end_seconds": 152.95,
      "duration_seconds": 3.71,
      "text": "have you had any fever or bladder problems?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.65,
      "end_seconds": 158.95,
      "duration_seconds": 4.3,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.75,
      "end_seconds": 165.16,
      "duration_seconds": 4.41,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.27,
      "end_seconds": 167.83,
      "duration_seconds": 1.56,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.98,
      "end_seconds": 171.17,
      "duration_seconds": 2.19,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 174.69,
      "duration_seconds": 2.38,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 180.58,
      "duration_seconds": 2.08,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.15,
      "end_seconds": 186.58,
      "duration_seconds": 5.43,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.03,
      "end_seconds": 189.95,
      "duration_seconds": 1.92,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.77,
      "end_seconds": 193.58,
      "duration_seconds": 2.81,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.39,
      "end_seconds": 197.01,
      "duration_seconds": 2.62,
      "text": "So, do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.1,
      "end_seconds": 203.73,
      "duration_seconds": 4.63,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.19,
      "end_seconds": 207.16,
      "duration_seconds": 1.97,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.68,
      "end_seconds": 212.6,
      "duration_seconds": 4.92,
      "text": "I had my tonsils removed as a teenager"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.82,
      "end_seconds": 216.64,
      "duration_seconds": 2.82,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.18,
      "end_seconds": 224.07,
      "duration_seconds": 5.89,
      "text": "Yeah, it's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.34,
      "end_seconds": 225.44,
      "duration_seconds": 1.1,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.08,
      "end_seconds": 246.99,
      "duration_seconds": 2.91,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.27,
      "end_seconds": 251.06,
      "duration_seconds": 2.79,
      "text": "I, I have thin bones"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.79,
      "end_seconds": 257.48,
      "duration_seconds": 4.69,
      "text": "Alright, thin bones, that matches what I have here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.51,
      "end_seconds": 262.36,
      "duration_seconds": 3.85,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.35,
      "end_seconds": 265.37,
      "duration_seconds": 2.02,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.23,
      "end_seconds": 282.81,
      "duration_seconds": 7.58,
      "text": "there is a curve in the upper back and you are three centimetres shorter than before"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.91,
      "end_seconds": 304.22,
      "duration_seconds": 16.31,
      "text": "thank you, you can get dressed. So, based on the history and the examination, I don't have a clear answer today: osteoporosis with a fragility fracture is possible, and so is vitamin D deficiency"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.43,
      "end_seconds": 308.6,
      "duration_seconds": 3.17,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.67,
      "end_seconds": 323.87,
      "duration_seconds": 14.2,
      "text": "I can't promise yet, but most people with osteoporosis with a fragility fracture do well once it's treated properly i'll request a bone density scan, it'll help with osteoporosis"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 325.04,
      "end_seconds": 330.1,
      "duration_seconds": 5.06,
      "text": "We have a slot Friday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.01,
      "end_seconds": 334.29,
      "duration_seconds": 3.28,
      "text": "Okay, um, I'll be there."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.17,
      "end_seconds": 344.1,
      "duration_seconds": 8.93,
      "text": "Take the tablet with a full glass of water, and stay upright for thirty minutes. Let's plan a check in three months."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.69,
      "end_seconds": 346.74,
      "duration_seconds": 2.05,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.6,
      "end_seconds": 351.48,
      "duration_seconds": 3.88,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.53,
      "end_seconds": 355.74,
      "duration_seconds": 2.21,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}