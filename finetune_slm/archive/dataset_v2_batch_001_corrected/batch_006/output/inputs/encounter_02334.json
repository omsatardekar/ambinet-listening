{
  "schema_version": "1.0",
  "encounter_id": "02334",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 2.99,
      "duration_seconds": 2.12,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.77,
      "end_seconds": 7.29,
      "duration_seconds": 2.52,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 9.89,
      "duration_seconds": 1.84,
      "text": "Right, what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.76,
      "end_seconds": 17.56,
      "duration_seconds": 2.8,
      "text": "Well, I've been having constant worrying."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.84,
      "end_seconds": 22.14,
      "duration_seconds": 3.3,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.39,
      "end_seconds": 29.67,
      "duration_seconds": 3.28,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.35,
      "end_seconds": 34.5,
      "duration_seconds": 3.15,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.43,
      "end_seconds": 39.04,
      "duration_seconds": 2.61,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.61,
      "end_seconds": 45.45,
      "duration_seconds": 5.84,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.55,
      "end_seconds": 52.04,
      "duration_seconds": 6.49,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.55,
      "end_seconds": 54.81,
      "duration_seconds": 2.26,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.99,
      "end_seconds": 64.91,
      "duration_seconds": 4.92,
      "text": "I've had a tight chest too, for two months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.85,
      "end_seconds": 76.45,
      "duration_seconds": 9.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.05,
      "end_seconds": 81.76,
      "duration_seconds": 3.71,
      "text": "I'd say severe. Honestly, every other day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 83.13,
      "end_seconds": 85.7,
      "duration_seconds": 2.57,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.41,
      "end_seconds": 99.31,
      "duration_seconds": 4.9,
      "text": "Did you get chest pain on exertion or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.85,
      "end_seconds": 113.4,
      "duration_seconds": 12.55,
      "text": "No, um, no chest pain on exertion, no weight loss. I did have trouble sleeping at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 120.7,
      "duration_seconds": 5.55,
      "text": "So, have you noticed thoughts of harming myself or drinking more?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.01,
      "end_seconds": 124.92,
      "duration_seconds": 2.91,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.56,
      "end_seconds": 127.52,
      "duration_seconds": 1.96,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.47,
      "end_seconds": 131.53,
      "duration_seconds": 2.06,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.11,
      "end_seconds": 135.96,
      "duration_seconds": 2.85,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.55,
      "end_seconds": 138.32,
      "duration_seconds": 1.77,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 141.61,
      "duration_seconds": 2.35,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.06,
      "end_seconds": 146.57,
      "duration_seconds": 3.51,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.14,
      "end_seconds": 149.57,
      "duration_seconds": 2.43,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.07,
      "end_seconds": 155.68,
      "duration_seconds": 4.61,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.49,
      "end_seconds": 160.38,
      "duration_seconds": 3.89,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.47,
      "end_seconds": 168.19,
      "duration_seconds": 6.72,
      "text": "I've had an irregular heartbeat for two years now. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.95,
      "end_seconds": 185.19,
      "duration_seconds": 15.24,
      "text": "Mm, okay. Yes, acid reflux is known to us, good to have that clear. Any allergies to tablets, food or anything in the environment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.05,
      "end_seconds": 189.0,
      "duration_seconds": 1.95,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.02,
      "end_seconds": 193.73,
      "duration_seconds": 3.71,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.96,
      "end_seconds": 202.5,
      "duration_seconds": 7.54,
      "text": "I take bisoprolol, 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 203.09,
      "end_seconds": 207.54,
      "duration_seconds": 4.45,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.02,
      "end_seconds": 211.89,
      "duration_seconds": 2.87,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.02,
      "end_seconds": 224.52,
      "duration_seconds": 11.5,
      "text": "Not with me. I'll bring it next time. Hmm, it's something called lans... lansoprazole, 30 milligrams, maybe, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.96,
      "end_seconds": 230.7,
      "duration_seconds": 4.74,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.31,
      "end_seconds": 233.33,
      "duration_seconds": 2.02,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.06,
      "end_seconds": 236.53,
      "duration_seconds": 2.47,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.61,
      "end_seconds": 243.31,
      "duration_seconds": 4.7,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 244.11,
      "end_seconds": 252.4,
      "duration_seconds": 8.29,
      "text": "Doctor, I've got the readings for you. Temp 36.5 degrees, pulse 69, oxygen saturation is 99 percent. Pressure 109 over 71."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.82,
      "end_seconds": 255.24,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.16,
      "end_seconds": 260.71,
      "duration_seconds": 3.55,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.21,
      "end_seconds": 264.6,
      "duration_seconds": 2.39,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.91,
      "end_seconds": 279.42,
      "duration_seconds": 5.51,
      "text": "Your heart sounds are normal and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.45,
      "end_seconds": 285.16,
      "duration_seconds": 1.71,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.32,
      "end_seconds": 309.03,
      "duration_seconds": 8.71,
      "text": "Taking everything into account, my working impression is generalised anxiety. I'd also keep an overactive thyroid in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.57,
      "end_seconds": 311.14,
      "duration_seconds": 1.57,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.04,
      "end_seconds": 325.12,
      "duration_seconds": 13.08,
      "text": "Nothing I've seen today points to an emergency. It looks like generalised anxiety, but I'd like to confirm. I'd like to arrange a thyroid test for anxiety symptoms."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 326.22,
      "end_seconds": 329.92,
      "duration_seconds": 3.7,
      "text": "I can book that for Thursday at 3:30 pm."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.68,
      "end_seconds": 331.71,
      "duration_seconds": 1.03,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.85,
      "end_seconds": 340.51,
      "duration_seconds": 7.66,
      "text": "I'll start you on sertraline, 50 milligrams, once a day, long term. It's for anxiety."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.4,
      "end_seconds": 344.09,
      "duration_seconds": 1.69,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.49,
      "end_seconds": 357.67,
      "duration_seconds": 12.18,
      "text": "Try slow breathing and regular exercise, and limit caffeine. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.39,
      "end_seconds": 361.39,
      "duration_seconds": 3.0,
      "text": "Thank you, you know, that's clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.99,
      "end_seconds": 369.33,
      "duration_seconds": 6.34,
      "text": "See me again in four weeks. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.19,
      "end_seconds": 373.32,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.34,
      "end_seconds": 377.11,
      "duration_seconds": 1.77,
      "text": "Have a good day."
    }
  ]
}