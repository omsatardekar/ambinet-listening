{
  "schema_version": "1.0",
  "encounter_id": "02181",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.24,
      "duration_seconds": 3.36,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 9.72,
      "duration_seconds": 4.66,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 18.2,
      "duration_seconds": 6.87,
      "text": "um, so... vomiting large amounts of fresh blood that's why I came"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.37,
      "end_seconds": 27.63,
      "duration_seconds": 3.26,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.11,
      "end_seconds": 31.7,
      "duration_seconds": 2.59,
      "text": "for ten days, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.95,
      "end_seconds": 36.33,
      "duration_seconds": 3.38,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.51,
      "end_seconds": 43.4,
      "duration_seconds": 5.89,
      "text": "Maybe a three out of ten on a a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.07,
      "end_seconds": 49.57,
      "duration_seconds": 4.5,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.29,
      "end_seconds": 54.99,
      "duration_seconds": 3.7,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.03,
      "end_seconds": 59.72,
      "duration_seconds": 3.69,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.68,
      "end_seconds": 67.07,
      "duration_seconds": 5.39,
      "text": "it's thyroxine, 75 micrograms, every morning it's alcohol every day, daily"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.87,
      "end_seconds": 87.23,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.2,
      "end_seconds": 95.05,
      "duration_seconds": 2.85,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.58,
      "end_seconds": 102.0,
      "duration_seconds": 3.42,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.78,
      "end_seconds": 106.6,
      "duration_seconds": 2.82,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.39,
      "end_seconds": 110.58,
      "duration_seconds": 2.19,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.32,
      "end_seconds": 116.71,
      "duration_seconds": 5.39,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 121.8,
      "duration_seconds": 3.0,
      "text": "Right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.15,
      "end_seconds": 129.93,
      "duration_seconds": 3.78,
      "text": "An underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.35,
      "end_seconds": 139.54,
      "duration_seconds": 8.19,
      "text": "I follow. Right, so an underactive thyroid is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.46,
      "end_seconds": 157.35,
      "duration_seconds": 3.89,
      "text": "a few quick ones: fever or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.88,
      "end_seconds": 161.67,
      "duration_seconds": 3.79,
      "text": "No fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.63,
      "end_seconds": 165.6,
      "duration_seconds": 1.97,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.31,
      "end_seconds": 167.71,
      "duration_seconds": 1.4,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 186.54,
      "duration_seconds": 2.94,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.35,
      "end_seconds": 195.5,
      "duration_seconds": 2.15,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.98,
      "end_seconds": 211.47,
      "duration_seconds": 6.49,
      "text": "okay: oxygen saturation is 96 percent, BP is 104 over 61, pulse 94."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.75,
      "end_seconds": 216.4,
      "duration_seconds": 1.65,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.18,
      "end_seconds": 219.62,
      "duration_seconds": 2.44,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.16,
      "end_seconds": 225.97,
      "duration_seconds": 4.81,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.27,
      "end_seconds": 228.91,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.42,
      "end_seconds": 231.65,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.96,
      "end_seconds": 256.57,
      "duration_seconds": 7.61,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.17,
      "end_seconds": 279.21,
      "duration_seconds": 20.04,
      "text": "Alright, please sit back down. Let me tell you where I've got to. This looks most like a bleed from enlarged veins in the gullet in liver disease. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.64,
      "end_seconds": 307.28,
      "duration_seconds": 16.64,
      "text": "I'd like to arrange urgent blood tests for major bleed. What I'm giving you is terlipressin, 2 milligrams, now, single dose. That's for variceal bleeding. You are going straight to resus, I am starting two drips"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.69,
      "end_seconds": 315.52,
      "duration_seconds": 7.83,
      "text": "Hm, okay. I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.71,
      "end_seconds": 318.37,
      "duration_seconds": 1.66,
      "text": "that's clear, thanks"
    }
  ]
}