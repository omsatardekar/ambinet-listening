{
  "schema_version": "1.0",
  "encounter_id": "02107",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 8.06,
      "duration_seconds": 7.16,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.84,
      "end_seconds": 13.04,
      "duration_seconds": 4.2,
      "text": "thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.58,
      "end_seconds": 19.14,
      "duration_seconds": 5.56,
      "text": "well, I've been having vomiting large amounts of fresh blood"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.53,
      "end_seconds": 27.96,
      "duration_seconds": 7.43,
      "text": "Okay, so the vitals from earlier. Heart rate 101, BP is 97 over 63, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.73,
      "end_seconds": 35.37,
      "duration_seconds": 5.64,
      "text": "Alright, good, thank you. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.51,
      "end_seconds": 46.64,
      "duration_seconds": 10.13,
      "text": "Around five days... no wait, it's more like ten days. And I've been feeling faint as well, since last weekend."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.63,
      "end_seconds": 58.63,
      "duration_seconds": 10.0,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.17,
      "end_seconds": 67.44,
      "duration_seconds": 7.27,
      "text": "Pretty mild, if I'm being honest. I get some relief from lying down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.59,
      "end_seconds": 70.69,
      "duration_seconds": 2.1,
      "text": "any being confused as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.47,
      "end_seconds": 75.08,
      "duration_seconds": 2.61,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 84.37,
      "duration_seconds": 5.15,
      "text": "let me check a few things. Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.5,
      "end_seconds": 87.65,
      "duration_seconds": 2.15,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.49,
      "end_seconds": 90.98,
      "duration_seconds": 2.49,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.42,
      "end_seconds": 99.72,
      "duration_seconds": 2.3,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 104.91,
      "duration_seconds": 3.95,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 108.47,
      "duration_seconds": 2.01,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.28,
      "end_seconds": 112.0,
      "duration_seconds": 2.72,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.33,
      "end_seconds": 123.62,
      "duration_seconds": 6.29,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.72,
      "end_seconds": 136.51,
      "duration_seconds": 3.79,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.82,
      "end_seconds": 142.54,
      "duration_seconds": 4.72,
      "text": "it's naproxen, twice a day for the knee pain"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.12,
      "end_seconds": 146.49,
      "duration_seconds": 2.37,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.07,
      "end_seconds": 164.5,
      "duration_seconds": 14.43,
      "text": "250 milligrams, I think that's what's on the box. Fluoxetine. I take it 20 milligrams, every morning for my mood. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.24,
      "end_seconds": 169.04,
      "duration_seconds": 2.8,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.36,
      "end_seconds": 175.9,
      "duration_seconds": 5.54,
      "text": "For about a year. Alcohol every day. I take it daily."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.55,
      "end_seconds": 179.33,
      "duration_seconds": 2.78,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.41,
      "end_seconds": 183.34,
      "duration_seconds": 1.93,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.86,
      "end_seconds": 188.96,
      "duration_seconds": 5.1,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.77,
      "end_seconds": 198.11,
      "duration_seconds": 4.34,
      "text": "I'm allergic to grass pollen, I get sneezing"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.86,
      "end_seconds": 200.06,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.72,
      "end_seconds": 203.83,
      "duration_seconds": 3.11,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.5,
      "end_seconds": 205.68,
      "duration_seconds": 1.18,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.75,
      "end_seconds": 211.98,
      "duration_seconds": 4.23,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.58,
      "end_seconds": 215.91,
      "duration_seconds": 2.33,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.43,
      "end_seconds": 220.39,
      "duration_seconds": 3.96,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.97,
      "end_seconds": 225.5,
      "duration_seconds": 3.53,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.52,
      "end_seconds": 230.45,
      "duration_seconds": 3.93,
      "text": "yes, arthritis in my knees i've got depression"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.13,
      "end_seconds": 237.91,
      "duration_seconds": 6.78,
      "text": "Understood. Okay, I can see arthritis in your knees and depression in your file as well."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.5,
      "end_seconds": 244.74,
      "duration_seconds": 4.24,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.8,
      "end_seconds": 247.92,
      "duration_seconds": 1.12,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.76,
      "end_seconds": 250.97,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.96,
      "end_seconds": 272.41,
      "duration_seconds": 6.45,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 279.94,
      "duration_seconds": 1.78,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.74,
      "end_seconds": 306.86,
      "duration_seconds": 14.12,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at a bleed from enlarged veins in the gullet in liver disease or a bleeding ulcer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.74,
      "end_seconds": 310.64,
      "duration_seconds": 1.9,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.22,
      "end_seconds": 325.76,
      "duration_seconds": 13.54,
      "text": "I understand the worry. At the the moment I'd say it's a bleed from enlarged veins in the gullet in liver disease, and we'll know more once the an urgent endoscopy is back"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.41,
      "end_seconds": 340.1,
      "duration_seconds": 3.69,
      "text": "we should do an urgent endoscopy for variceal bleed"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 342.09,
      "end_seconds": 343.11,
      "duration_seconds": 1.02,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.33,
      "end_seconds": 350.09,
      "duration_seconds": 5.76,
      "text": "I'm prescribing terlipressin, 2 milligrams, now, single dose. That's for variceal bleeding."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.68,
      "end_seconds": 354.52,
      "duration_seconds": 2.84,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.6,
      "end_seconds": 371.4,
      "duration_seconds": 15.8,
      "text": "You are going straight to to resus, I am starting two drips. I think the emergency team should see you too. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 376.53,
      "end_seconds": 378.27,
      "duration_seconds": 1.74,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.41,
      "end_seconds": 390.45,
      "duration_seconds": 7.04,
      "text": "let's plan a check straight away before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 391.66,
      "end_seconds": 399.43,
      "duration_seconds": 7.77,
      "text": "so, I take the terlipressin, 2 milligrams, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.54,
      "end_seconds": 406.74,
      "duration_seconds": 6.2,
      "text": "Yes, exactly right. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 408.24,
      "end_seconds": 412.16,
      "duration_seconds": 3.92,
      "text": "Well, I think I understand everything. Thanks."
    }
  ]
}