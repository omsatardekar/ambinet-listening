{
  "schema_version": "1.0",
  "encounter_id": "02185",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.78,
      "duration_seconds": 4.67,
      "text": "Right, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.31,
      "end_seconds": 15.52,
      "duration_seconds": 5.21,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.57,
      "end_seconds": 25.59,
      "duration_seconds": 8.02,
      "text": "Um so... severe pain. That's why I came. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.2,
      "end_seconds": 30.49,
      "duration_seconds": 3.29,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.35,
      "end_seconds": 33.58,
      "duration_seconds": 2.23,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.3,
      "end_seconds": 38.69,
      "duration_seconds": 3.39,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.47,
      "end_seconds": 44.93,
      "duration_seconds": 5.46,
      "text": "Severe, really i've been feeling very unwell too, for three weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.33,
      "end_seconds": 50.71,
      "duration_seconds": 5.38,
      "text": "Yes, carry on. Did you get diarrhoea, cough or recent cut?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.05,
      "end_seconds": 57.36,
      "duration_seconds": 5.31,
      "text": "yeah, no diarrhoea, cough or recent cut, none of it it"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 62.26,
      "duration_seconds": 2.8,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.16,
      "end_seconds": 65.12,
      "duration_seconds": 0.96,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.07,
      "end_seconds": 70.97,
      "duration_seconds": 4.9,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.66,
      "end_seconds": 77.42,
      "duration_seconds": 5.76,
      "text": "not currently, but as a youngster diclofenac gave me wheezing"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.2,
      "end_seconds": 81.19,
      "duration_seconds": 2.99,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.82,
      "end_seconds": 83.75,
      "duration_seconds": 1.93,
      "text": "no, uh, none"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.06,
      "end_seconds": 99.74,
      "duration_seconds": 4.68,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 102.78,
      "duration_seconds": 1.49,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.9,
      "end_seconds": 122.29,
      "duration_seconds": 2.39,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.28,
      "end_seconds": 138.64,
      "duration_seconds": 14.36,
      "text": "I quit smoking around ten years ago. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.26,
      "end_seconds": 141.89,
      "duration_seconds": 2.63,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.64,
      "end_seconds": 158.03,
      "duration_seconds": 2.39,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.21,
      "end_seconds": 187.07,
      "duration_seconds": 8.86,
      "text": "Okay: respiratory rate 18, blood pressure 97 over 57, temperature is 37.0 degrees. And heart rate 107."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.05,
      "end_seconds": 190.11,
      "duration_seconds": 2.06,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.41,
      "end_seconds": 196.83,
      "duration_seconds": 3.42,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.95,
      "end_seconds": 200.28,
      "duration_seconds": 2.33,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.7,
      "end_seconds": 203.04,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.98,
      "end_seconds": 227.98,
      "duration_seconds": 7.0,
      "text": "the skin is dusky with blisters there is a crackling feeling under it and you are hypotensive"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.64,
      "end_seconds": 233.99,
      "duration_seconds": 2.35,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.58,
      "end_seconds": 259.99,
      "duration_seconds": 7.41,
      "text": "so based on the history and the examination it points towards a possible necrotising soft tissue infection"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.51,
      "end_seconds": 264.85,
      "duration_seconds": 3.34,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.63,
      "end_seconds": 275.6,
      "duration_seconds": 8.97,
      "text": "I can't promise yet but most people with a possible necrotising soft tissue infection do well once it's treated properly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.15,
      "end_seconds": 314.51,
      "duration_seconds": 20.36,
      "text": "I'll request an urgent surgical review, it'll help with possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now. If it hasn't settled next month, we'd think about urgent blood tests, but not now. Do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.12,
      "end_seconds": 318.4,
      "duration_seconds": 2.28,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.94,
      "end_seconds": 325.18,
      "duration_seconds": 5.24,
      "text": "come back straight away anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.05,
      "end_seconds": 330.27,
      "duration_seconds": 3.22,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.16,
      "end_seconds": 332.35,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}