{
  "schema_version": "1.0",
  "encounter_id": "02132",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 7.12,
      "duration_seconds": 5.86,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 13.16,
      "duration_seconds": 4.83,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.68,
      "end_seconds": 25.6,
      "duration_seconds": 10.92,
      "text": "Hello, doctor, I came in with them, if that's okay. Well, doctor, it's sudden confusion over a day. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.41,
      "end_seconds": 27.7,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.65,
      "end_seconds": 32.81,
      "duration_seconds": 3.16,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.9,
      "end_seconds": 37.57,
      "duration_seconds": 3.67,
      "text": "Has there been seeing things that aren't there too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.33,
      "end_seconds": 47.84,
      "duration_seconds": 9.51,
      "text": "Yes, for two weeks. Oh, and not knowing where she is. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 48.47,
      "end_seconds": 51.94,
      "duration_seconds": 3.47,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 56.51,
      "duration_seconds": 4.07,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.48,
      "end_seconds": 59.44,
      "duration_seconds": 1.96,
      "text": "No. No chest pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.78,
      "end_seconds": 66.27,
      "duration_seconds": 5.49,
      "text": "A few quick ones: weakness on one side, fall or head injury?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.44,
      "end_seconds": 83.9,
      "duration_seconds": 14.46,
      "text": "No, no weakness on one side, no fall, no head injury. I did have a fever at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.41,
      "end_seconds": 88.18,
      "duration_seconds": 3.77,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.89,
      "end_seconds": 91.32,
      "duration_seconds": 1.43,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.91,
      "end_seconds": 95.77,
      "duration_seconds": 2.86,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.63,
      "end_seconds": 102.37,
      "duration_seconds": 5.74,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.73,
      "end_seconds": 107.15,
      "duration_seconds": 3.42,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.73,
      "end_seconds": 116.29,
      "duration_seconds": 4.56,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.29,
      "end_seconds": 138.61,
      "duration_seconds": 4.32,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 145.39,
      "duration_seconds": 6.17,
      "text": "My mother had a stroke. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.1,
      "end_seconds": 151.68,
      "duration_seconds": 4.58,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.27,
      "end_seconds": 163.95,
      "duration_seconds": 11.68,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.49,
      "end_seconds": 171.89,
      "duration_seconds": 3.4,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.92,
      "end_seconds": 175.51,
      "duration_seconds": 2.59,
      "text": "Thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.77,
      "end_seconds": 185.83,
      "duration_seconds": 9.06,
      "text": "It's, It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.94,
      "end_seconds": 192.63,
      "duration_seconds": 2.69,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.05,
      "end_seconds": 202.39,
      "duration_seconds": 8.34,
      "text": "For my heart, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.22,
      "end_seconds": 207.54,
      "duration_seconds": 4.32,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.27,
      "end_seconds": 217.45,
      "duration_seconds": 4.18,
      "text": "I've, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.12,
      "end_seconds": 219.82,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.3,
      "end_seconds": 226.26,
      "duration_seconds": 4.96,
      "text": "I've had an underactive thyroid for five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.62,
      "end_seconds": 231.81,
      "duration_seconds": 1.19,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.99,
      "end_seconds": 237.59,
      "duration_seconds": 4.6,
      "text": "I've had heart failure for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.19,
      "end_seconds": 239.08,
      "duration_seconds": 0.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.03,
      "end_seconds": 248.75,
      "duration_seconds": 8.72,
      "text": "Right, so high blood pressure and an underactive thyroid are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 261.23,
      "end_seconds": 270.87,
      "duration_seconds": 9.64,
      "text": "Doctor, I've got the readings for you. Heart rate 97, blood pressure 104 over 66, temperature 38.4. SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.67,
      "end_seconds": 304.41,
      "duration_seconds": 31.74,
      "text": "Good, thank you. So, based on your history, this is probably delirium from an infection. That's my thinking for now, and it may change as we learn more. I'd also keep dehydration in mind. I'd also keep a stroke in mind. Let me just check I've got this right. You've had sudden confusion over a day for six months, and no weakness on one side or fall."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.56,
      "end_seconds": 306.26,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.87,
      "end_seconds": 324.13,
      "duration_seconds": 14.26,
      "text": "I'll request a chest X-ray, it'll help with fever and confusion. Let's get blood tests, for delirium. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.16,
      "end_seconds": 327.42,
      "duration_seconds": 1.26,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.34,
      "end_seconds": 360.59,
      "duration_seconds": 31.25,
      "text": "We should do a urine dipstick for acute confusion. That will help us see what's going on underneath and decide the next step. She needs to go to hospital today for fluids and antibiotics. I think the emergency team should see you too. Please don't wait if the symptoms get worse. That's when to be seen urgently. We'll catch up straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.1,
      "end_seconds": 366.22,
      "duration_seconds": 4.12,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.84,
      "end_seconds": 372.18,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}