{
  "schema_version": "1.0",
  "encounter_id": "02309",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 6.72,
      "duration_seconds": 5.35,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.4,
      "end_seconds": 12.04,
      "duration_seconds": 3.64,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.55,
      "end_seconds": 22.85,
      "duration_seconds": 9.3,
      "text": "Thank you for fitting us in, you know, doctor. Hmm, she's been having night sweats, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.58,
      "end_seconds": 28.95,
      "duration_seconds": 4.37,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.92,
      "end_seconds": 40.96,
      "duration_seconds": 10.04,
      "text": "Well, it's sodium valproate, 500 milligrams, twice a day, doctor. Uh, she takes alendronate, once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.34,
      "end_seconds": 44.42,
      "duration_seconds": 2.08,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.28,
      "end_seconds": 50.84,
      "duration_seconds": 4.56,
      "text": "70 milligrams. It's Asthalin inhaler, when needed, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.73,
      "end_seconds": 55.18,
      "duration_seconds": 3.45,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 57.12,
      "end_seconds": 65.98,
      "duration_seconds": 8.86,
      "text": "For two years. Oh, she is on escitalopram, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.24,
      "end_seconds": 69.61,
      "duration_seconds": 2.37,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 70.3,
      "end_seconds": 71.33,
      "duration_seconds": 1.03,
      "text": "10 milligrams."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.85,
      "end_seconds": 72.55,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.85,
      "end_seconds": 90.96,
      "duration_seconds": 3.11,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.76,
      "end_seconds": 95.71,
      "duration_seconds": 3.95,
      "text": "Yeah, about three days, give or take."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 96.65,
      "end_seconds": 101.08,
      "duration_seconds": 4.43,
      "text": "I mean, it was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.0,
      "end_seconds": 106.63,
      "duration_seconds": 4.63,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.65,
      "end_seconds": 111.82,
      "duration_seconds": 3.17,
      "text": "I suppose so, um, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.14,
      "end_seconds": 121.57,
      "duration_seconds": 3.43,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.9,
      "end_seconds": 130.41,
      "duration_seconds": 3.51,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.92,
      "end_seconds": 139.12,
      "duration_seconds": 8.2,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 139.22,
      "end_seconds": 144.43,
      "duration_seconds": 5.21,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.91,
      "end_seconds": 155.19,
      "duration_seconds": 9.28,
      "text": "Hmm, I was getting to that! Oh, and tiredness. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.8,
      "end_seconds": 160.6,
      "duration_seconds": 3.8,
      "text": "Has there been a fever for two weeks too?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.73,
      "end_seconds": 165.02,
      "duration_seconds": 1.29,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.49,
      "end_seconds": 170.04,
      "duration_seconds": 3.55,
      "text": "Have you had cough, by any chance?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.9,
      "end_seconds": 173.52,
      "duration_seconds": 1.62,
      "text": "No. No cough."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 175.14,
      "end_seconds": 181.1,
      "duration_seconds": 5.96,
      "text": "Actually, um, doctor, I did notice cough. She doesn't always say."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.77,
      "end_seconds": 189.43,
      "duration_seconds": 6.66,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.02,
      "end_seconds": 202.47,
      "duration_seconds": 8.45,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.45,
      "end_seconds": 217.87,
      "duration_seconds": 13.42,
      "text": "No, no chest pain, no weight loss. I did have small painful spots on my fingers at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.7,
      "end_seconds": 221.75,
      "duration_seconds": 2.05,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 227.61,
      "duration_seconds": 3.87,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.71,
      "end_seconds": 233.69,
      "duration_seconds": 3.98,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.07,
      "end_seconds": 238.57,
      "duration_seconds": 3.5,
      "text": "Uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 241.48,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.28,
      "end_seconds": 246.09,
      "duration_seconds": 3.81,
      "text": "I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.32,
      "end_seconds": 248.64,
      "duration_seconds": 1.32,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.87,
      "end_seconds": 257.98,
      "duration_seconds": 8.11,
      "text": "Yes, thin bones. I've, I've had asthma for two years now. Anxiety, for five years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.67,
      "end_seconds": 269.81,
      "duration_seconds": 10.14,
      "text": "Yes, carry on. Okay, I can see epilepsy and thin bones in your file as well. Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.9,
      "end_seconds": 276.1,
      "duration_seconds": 4.2,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.62,
      "end_seconds": 279.99,
      "duration_seconds": 2.37,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.65,
      "end_seconds": 285.0,
      "duration_seconds": 4.35,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.39,
      "end_seconds": 304.3,
      "duration_seconds": 3.91,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.02,
      "end_seconds": 309.34,
      "duration_seconds": 3.32,
      "text": "Mm, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.56,
      "end_seconds": 314.72,
      "duration_seconds": 4.16,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 316.62,
      "end_seconds": 320.29,
      "duration_seconds": 3.67,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.26,
      "end_seconds": 324.04,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.38,
      "end_seconds": 328.84,
      "duration_seconds": 3.46,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 330.24,
      "end_seconds": 346.78,
      "duration_seconds": 16.54,
      "text": "Doctor, I've got the readings for you. Pulse is 101 beats a minute, pressure 111 over 69, temperature 38.6, height 173 centimetres, respiratory rate 17, BMI works out to 25.7, weight 77 kilos."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.75,
      "end_seconds": 350.67,
      "duration_seconds": 1.92,
      "text": "Okay, good, thank you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.01,
      "end_seconds": 357.1,
      "duration_seconds": 4.09,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.52,
      "end_seconds": 360.41,
      "duration_seconds": 1.89,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.27,
      "end_seconds": 376.04,
      "duration_seconds": 7.77,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.66,
      "end_seconds": 397.21,
      "duration_seconds": 16.55,
      "text": "Good, you can sit up again. Taking everything into account, my working impression is possible infective endocarditis. I can't rule out a viral illness yet. So, to recap quickly. You've had night sweats, mild, and no chest pain or weight loss."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.54,
      "end_seconds": 400.22,
      "duration_seconds": 1.68,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.42,
      "end_seconds": 404.97,
      "duration_seconds": 3.55,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 406.76,
      "end_seconds": 417.24,
      "duration_seconds": 10.48,
      "text": "Um, I had an echocardiogram done at another clinic last month. I don't have the report with me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.46,
      "end_seconds": 422.08,
      "duration_seconds": 3.62,
      "text": "I'm going to order blood cultures, for possible endocarditis."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 423.09,
      "end_seconds": 425.23,
      "duration_seconds": 2.14,
      "text": "Right, uh, understood."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.07,
      "end_seconds": 450.91,
      "duration_seconds": 23.84,
      "text": "We should do blood tests for prolonged fever. That will help us see what's going on underneath and decide the next step. You need admission today for blood cultures and a heart scan. Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again straight away. Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 452.47,
      "end_seconds": 455.63,
      "duration_seconds": 3.16,
      "text": "So, thank you, doctor, goodbye."
    }
  ]
}