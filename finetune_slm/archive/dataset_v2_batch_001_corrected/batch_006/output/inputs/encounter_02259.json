{
  "schema_version": "1.0",
  "encounter_id": "02259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 4.11,
      "duration_seconds": 2.9,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 10.68,
      "duration_seconds": 4.84,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 24.66,
      "duration_seconds": 13.16,
      "text": "Um, so... not being able to close my eye. That's why I came. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.75,
      "end_seconds": 29.17,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.35,
      "end_seconds": 33.63,
      "duration_seconds": 3.28,
      "text": "It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.26,
      "end_seconds": 44.82,
      "duration_seconds": 2.56,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.17,
      "end_seconds": 60.21,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.14,
      "end_seconds": 87.31,
      "duration_seconds": 8.17,
      "text": "Okay: temperature is 36.6 degrees, SpO2 98 percent on room air, pulse 84, blood pressure 121 over 75."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 90.48,
      "duration_seconds": 2.12,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.65,
      "end_seconds": 94.72,
      "duration_seconds": 3.07,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 99.54,
      "duration_seconds": 3.53,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 103.43,
      "duration_seconds": 2.39,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.49,
      "end_seconds": 125.93,
      "duration_seconds": 7.44,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.58,
      "end_seconds": 141.39,
      "duration_seconds": 9.81,
      "text": "That's all I needed to check. Okay, any weakness in the arm or leg, headache, rash in the ear or slurred speech at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.14,
      "end_seconds": 150.76,
      "duration_seconds": 7.62,
      "text": "No, no weakness in the arm or leg, headache, rash in the ear or slurred speech."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.82,
      "end_seconds": 155.67,
      "duration_seconds": 3.85,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.47,
      "end_seconds": 159.33,
      "duration_seconds": 2.86,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.29,
      "end_seconds": 164.29,
      "duration_seconds": 4.0,
      "text": "Okay, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.84,
      "end_seconds": 171.13,
      "duration_seconds": 3.29,
      "text": "Uh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.99,
      "end_seconds": 192.6,
      "duration_seconds": 2.61,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.12,
      "end_seconds": 196.89,
      "duration_seconds": 3.77,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.78,
      "end_seconds": 199.99,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.25,
      "end_seconds": 207.37,
      "duration_seconds": 6.12,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.11,
      "end_seconds": 218.77,
      "duration_seconds": 3.66,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.41,
      "end_seconds": 223.09,
      "duration_seconds": 2.68,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.01,
      "end_seconds": 229.98,
      "duration_seconds": 5.97,
      "text": "I follow. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.02,
      "end_seconds": 234.3,
      "duration_seconds": 3.28,
      "text": "Well, I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.14,
      "end_seconds": 237.6,
      "duration_seconds": 2.46,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.62,
      "end_seconds": 248.6,
      "duration_seconds": 7.98,
      "text": "Hmm, I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.86,
      "end_seconds": 252.21,
      "duration_seconds": 2.35,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.24,
      "end_seconds": 258.3,
      "duration_seconds": 4.06,
      "text": "Uh, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.95,
      "end_seconds": 269.64,
      "duration_seconds": 9.69,
      "text": "Right, here's what I'm thinking. I'd lean towards Bell's palsy. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.37,
      "end_seconds": 273.48,
      "duration_seconds": 3.11,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.56,
      "end_seconds": 282.78,
      "duration_seconds": 7.22,
      "text": "I understand the worry. At the moment I'd say it's Bell's palsy, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.88,
      "end_seconds": 320.68,
      "duration_seconds": 24.8,
      "text": "I'd like you to take prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy. I'll put all of this in writing so you don't have to remember it. Use eye drops and tape the eye shut at night to protect it. Come back in one week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.02,
      "end_seconds": 326.03,
      "duration_seconds": 4.01,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}