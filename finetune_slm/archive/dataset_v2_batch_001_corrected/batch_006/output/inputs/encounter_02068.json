{
  "schema_version": "1.0",
  "encounter_id": "02068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 6.62,
      "duration_seconds": 6.06,
      "text": "Doctor? Hello, um, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.89,
      "end_seconds": 12.28,
      "duration_seconds": 4.39,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 20.87,
      "duration_seconds": 7.08,
      "text": "Doctor, it's my face drooping on the right. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 25.65,
      "duration_seconds": 2.86,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.62,
      "end_seconds": 41.13,
      "duration_seconds": 14.51,
      "text": "I take simvastatin, 20 milligrams, at night. Well, I do miss it now and then, to be fair. Ah, I take Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.82,
      "end_seconds": 44.79,
      "duration_seconds": 2.97,
      "text": "Right, when did you start it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.51,
      "end_seconds": 48.25,
      "duration_seconds": 1.74,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 49.32,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.85,
      "end_seconds": 67.28,
      "duration_seconds": 3.43,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.75,
      "end_seconds": 73.58,
      "duration_seconds": 4.83,
      "text": "It's, It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.31,
      "end_seconds": 78.16,
      "duration_seconds": 2.85,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.66,
      "end_seconds": 83.13,
      "duration_seconds": 3.47,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.47,
      "end_seconds": 88.69,
      "duration_seconds": 5.22,
      "text": "Ah. Has there been not being able to close your eye too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.69,
      "end_seconds": 101.37,
      "duration_seconds": 11.68,
      "text": "Yeah, uh, I've had that since last weekend. I had pain behind the ear before. That's settled now, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.63,
      "end_seconds": 112.7,
      "duration_seconds": 7.07,
      "text": "Any rash in the ear, weakness in the arm or leg, headache or slurred speech at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.69,
      "end_seconds": 117.84,
      "duration_seconds": 3.15,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.53,
      "end_seconds": 123.33,
      "duration_seconds": 3.8,
      "text": "So, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.24,
      "end_seconds": 126.33,
      "duration_seconds": 2.09,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.42,
      "end_seconds": 141.72,
      "duration_seconds": 4.3,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 144.52,
      "duration_seconds": 2.13,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.17,
      "end_seconds": 147.56,
      "duration_seconds": 1.39,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.92,
      "end_seconds": 152.71,
      "duration_seconds": 3.79,
      "text": "I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.18,
      "end_seconds": 160.35,
      "duration_seconds": 6.17,
      "text": "Alright, high cholesterol and asthma, that matches what I have here. So, any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.14,
      "end_seconds": 166.18,
      "duration_seconds": 4.04,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.99,
      "end_seconds": 169.65,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.19,
      "end_seconds": 176.31,
      "duration_seconds": 6.12,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.83,
      "end_seconds": 180.16,
      "duration_seconds": 2.33,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.15,
      "end_seconds": 188.42,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.41,
      "end_seconds": 192.02,
      "duration_seconds": 1.61,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.27,
      "end_seconds": 198.34,
      "duration_seconds": 5.07,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 205.22,
      "duration_seconds": 2.22,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.6,
      "end_seconds": 212.03,
      "duration_seconds": 5.43,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.83,
      "end_seconds": 225.51,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.5,
      "end_seconds": 231.88,
      "duration_seconds": 4.38,
      "text": "Yeah, no, not that I know of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.62,
      "end_seconds": 235.34,
      "duration_seconds": 2.72,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.52,
      "end_seconds": 240.0,
      "duration_seconds": 3.48,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 243.35,
      "duration_seconds": 2.67,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.31,
      "end_seconds": 257.87,
      "duration_seconds": 2.56,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.73,
      "end_seconds": 277.1,
      "duration_seconds": 6.37,
      "text": "Okay: pressure 110 over 71, pulse 75, respiratory rate 15, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.58,
      "end_seconds": 281.06,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.79,
      "end_seconds": 285.55,
      "duration_seconds": 2.76,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.25,
      "end_seconds": 304.27,
      "duration_seconds": 9.02,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.26,
      "end_seconds": 327.35,
      "duration_seconds": 18.09,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'd lean towards Bell's palsy. I'll start you on prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.93,
      "end_seconds": 331.56,
      "duration_seconds": 2.63,
      "text": "Mm, you know, alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.75,
      "end_seconds": 347.29,
      "duration_seconds": 14.54,
      "text": "Use eye drops and tape the eye shut at night to protect it. One warning sign to remember: you get weakness in an arm or leg. In that case don't wait. We'll catch up in one week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.93,
      "end_seconds": 351.84,
      "duration_seconds": 3.91,
      "text": "Uh, um, that's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.09,
      "end_seconds": 357.44,
      "duration_seconds": 4.35,
      "text": "Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.24,
      "end_seconds": 363.53,
      "duration_seconds": 5.29,
      "text": "Sorry, what was I saying, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.2,
      "end_seconds": 366.25,
      "duration_seconds": 2.05,
      "text": "Right, goodbye for now."
    }
  ]
}