{
  "schema_version": "1.0",
  "encounter_id": "02401",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 2.47,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.68,
      "end_seconds": 7.96,
      "duration_seconds": 4.28,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.89,
      "end_seconds": 18.08,
      "duration_seconds": 8.19,
      "text": "Hello, uh, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.62,
      "end_seconds": 27.69,
      "duration_seconds": 9.07,
      "text": "Mainly burning pain in the upper tummy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.86,
      "end_seconds": 31.17,
      "duration_seconds": 2.31,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.38,
      "end_seconds": 59.13,
      "duration_seconds": 23.75,
      "text": "Hmm, you know, it's been going on for three days. As for indigestion, I honestly can't say when that began. It might have been last month or the month before. I had pain at night before. That's settled now, uh, though."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.09,
      "end_seconds": 68.28,
      "duration_seconds": 7.19,
      "text": "Have you had burning pain in the upper tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.54,
      "end_seconds": 76.93,
      "duration_seconds": 7.39,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.44,
      "end_seconds": 80.16,
      "duration_seconds": 2.72,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.17,
      "end_seconds": 94.01,
      "duration_seconds": 11.84,
      "text": "I've had arthritis in my knees for two years now. Okay, so I've had high cholesterol, yes. I've got gout."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 96.97,
      "duration_seconds": 1.51,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.7,
      "end_seconds": 121.89,
      "duration_seconds": 24.19,
      "text": "I've, I've had eczema for about ten years now. It's the not knowing that gets to me. I've had an underactive thyroid, yes. I didn't want to make a fuss, you know. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.24,
      "end_seconds": 127.95,
      "duration_seconds": 4.71,
      "text": "Alright, gout and eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.98,
      "end_seconds": 147.21,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.05,
      "end_seconds": 156.2,
      "duration_seconds": 8.15,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain. I'm on febuxostat, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 163.93,
      "duration_seconds": 2.28,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 167.11,
      "duration_seconds": 2.44,
      "text": "It's, It's 80 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.81,
      "end_seconds": 177.48,
      "duration_seconds": 8.67,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.38,
      "end_seconds": 181.16,
      "duration_seconds": 2.78,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.79,
      "end_seconds": 202.2,
      "duration_seconds": 20.41,
      "text": "Oh, for my thyroid, I believe. My husband sets them out for me, I just take what I'm given. Uh, I'm on ibuprofen, 400 milligrams, three times a day. Before this I was on diclofenac; that's been stopped."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.04,
      "end_seconds": 208.5,
      "duration_seconds": 4.46,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.77,
      "end_seconds": 219.08,
      "duration_seconds": 9.31,
      "text": "Yes, nickel. I get a rash on my skin. Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.94,
      "end_seconds": 222.39,
      "duration_seconds": 1.45,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.63,
      "end_seconds": 227.05,
      "duration_seconds": 3.42,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.14,
      "end_seconds": 229.73,
      "duration_seconds": 1.59,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.6,
      "end_seconds": 234.45,
      "duration_seconds": 2.85,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.02,
      "end_seconds": 238.23,
      "duration_seconds": 3.21,
      "text": "And what about black stools or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.28,
      "end_seconds": 245.02,
      "duration_seconds": 4.74,
      "text": "No black stools or difficulty swallowing, none of it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.17,
      "end_seconds": 250.09,
      "duration_seconds": 3.92,
      "text": "Alright, and what about weight loss or vomiting blood?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.9,
      "end_seconds": 258.55,
      "duration_seconds": 4.65,
      "text": "I haven't had weight loss or vomiting blood, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.6,
      "end_seconds": 262.62,
      "duration_seconds": 3.02,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.56,
      "end_seconds": 269.29,
      "duration_seconds": 4.73,
      "text": "Let me think, uh, no, joints are fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.12,
      "end_seconds": 272.9,
      "duration_seconds": 2.78,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.56,
      "end_seconds": 285.38,
      "duration_seconds": 2.82,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.66,
      "end_seconds": 317.3,
      "duration_seconds": 11.64,
      "text": "Okay: temperature is 36.8 degrees, height 171 centimetres, heart rate 71. And weight 70 kilos, saturation 98 percent, pressure 118 over 81."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.34,
      "end_seconds": 324.18,
      "duration_seconds": 4.84,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.11,
      "end_seconds": 328.75,
      "duration_seconds": 2.64,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.9,
      "end_seconds": 342.21,
      "duration_seconds": 4.31,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.07,
      "end_seconds": 348.77,
      "duration_seconds": 2.7,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.68,
      "end_seconds": 379.3,
      "duration_seconds": 14.62,
      "text": "Let me tell you where I've got to. This is probably a possible stomach ulcer from anti-inflammatory tablets. We shouldn't forget reflux. We should do a stool test for helicobacter for dyspepsia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 380.11,
      "end_seconds": 384.18,
      "duration_seconds": 4.07,
      "text": "We have a slot Monday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.93,
      "end_seconds": 387.93,
      "duration_seconds": 3.0,
      "text": "Monday, that works for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.61,
      "end_seconds": 392.93,
      "duration_seconds": 3.32,
      "text": "Let's get a blood count, for dyspepsia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.85,
      "end_seconds": 397.02,
      "duration_seconds": 3.17,
      "text": "Yeah, do I need to prepare?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.77,
      "end_seconds": 405.05,
      "duration_seconds": 7.28,
      "text": "We'll begin with omeprazole, 20 milligrams, once a day, eight weeks. It's for stomach ulcer."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.07,
      "end_seconds": 408.69,
      "duration_seconds": 1.62,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.67,
      "end_seconds": 426.28,
      "duration_seconds": 12.61,
      "text": "Stop the ibuprofen and use paracetamol for the knee pain instead. Let's plan a check in six weeks. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.46,
      "end_seconds": 438.84,
      "duration_seconds": 11.38,
      "text": "So, I take the omeprazole, 20 milligrams, once a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.95,
      "end_seconds": 444.63,
      "duration_seconds": 4.68,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.48,
      "end_seconds": 448.77,
      "duration_seconds": 3.29,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.42,
      "end_seconds": 451.62,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}