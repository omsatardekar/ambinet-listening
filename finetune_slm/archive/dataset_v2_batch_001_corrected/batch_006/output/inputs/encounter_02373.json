{
  "schema_version": "1.0",
  "encounter_id": "02373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.24,
      "end_seconds": 6.2,
      "duration_seconds": 4.96,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 11.9,
      "duration_seconds": 5.02,
      "text": "Okay, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.98,
      "end_seconds": 17.56,
      "duration_seconds": 3.58,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.29,
      "end_seconds": 21.68,
      "duration_seconds": 3.39,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.0,
      "end_seconds": 28.13,
      "duration_seconds": 5.13,
      "text": "Doctor, it's a throbbing toothache. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.46,
      "end_seconds": 32.8,
      "duration_seconds": 3.34,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.85,
      "end_seconds": 37.2,
      "duration_seconds": 3.35,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.21,
      "end_seconds": 46.43,
      "duration_seconds": 6.22,
      "text": "I, I think it's been nearer about two months, you know, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.1,
      "end_seconds": 52.16,
      "duration_seconds": 4.06,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.05,
      "end_seconds": 55.94,
      "duration_seconds": 1.89,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.59,
      "end_seconds": 62.76,
      "duration_seconds": 5.17,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.71,
      "end_seconds": 85.98,
      "duration_seconds": 22.27,
      "text": "It's, It's worse with hot drinks. It's a couple of times a week. I get some relief from cold water. Mostly moderate. Oh, and a swollen cheek. I've also had a low temperature, for two days. I've also had a bad taste. About bad taste, mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 87.45,
      "end_seconds": 96.39,
      "duration_seconds": 8.94,
      "text": "Okay, so the vitals from earlier. Pulse 93, blood pressure 105 over 72, temperature is 39.4 degrees, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.19,
      "end_seconds": 97.89,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 103.89,
      "duration_seconds": 3.73,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.91,
      "end_seconds": 106.91,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 110.17,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.79,
      "end_seconds": 128.82,
      "duration_seconds": 6.03,
      "text": "The lower right molar is tender with swollen gum and the cheek is puffy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.59,
      "end_seconds": 141.42,
      "duration_seconds": 8.83,
      "text": "That's all I needed to check. Any noisy breathing, eye swelling, difficulty opening the mouth or difficulty swallowing at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.33,
      "end_seconds": 151.0,
      "duration_seconds": 7.67,
      "text": "No, no noisy breathing, eye swelling, difficulty opening the mouth or difficulty swallowing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.11,
      "end_seconds": 154.66,
      "duration_seconds": 2.55,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.12,
      "end_seconds": 158.74,
      "duration_seconds": 2.62,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.65,
      "end_seconds": 164.36,
      "duration_seconds": 3.71,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.83,
      "end_seconds": 171.14,
      "duration_seconds": 5.31,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 182.14,
      "duration_seconds": 5.05,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.76,
      "end_seconds": 187.99,
      "duration_seconds": 4.23,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.05,
      "end_seconds": 192.99,
      "duration_seconds": 2.94,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.14,
      "end_seconds": 205.74,
      "duration_seconds": 9.6,
      "text": "Erm, just an operation for a hernia, last spring. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.57,
      "end_seconds": 224.21,
      "duration_seconds": 6.64,
      "text": "Anything in your past medical history I should know? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.95,
      "end_seconds": 231.87,
      "duration_seconds": 5.92,
      "text": "I've had depression, yes. Let me think, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.34,
      "end_seconds": 239.06,
      "duration_seconds": 5.72,
      "text": "Mm, okay. Yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.81,
      "end_seconds": 255.04,
      "duration_seconds": 3.23,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.22,
      "end_seconds": 259.49,
      "duration_seconds": 3.27,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.43,
      "end_seconds": 262.67,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 264.22,
      "end_seconds": 267.21,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.71,
      "end_seconds": 281.96,
      "duration_seconds": 2.25,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.69,
      "end_seconds": 287.14,
      "duration_seconds": 3.45,
      "text": "Sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 288.21,
      "end_seconds": 297.54,
      "duration_seconds": 9.33,
      "text": "Doctor, you know, I think the last prescription for the sertraline was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.52,
      "end_seconds": 305.43,
      "duration_seconds": 5.91,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.08,
      "end_seconds": 332.6,
      "duration_seconds": 25.52,
      "text": "I, I don't think I have it with me. Escitalopram, 10 milligrams, once a day for the anxiety. I'm on paracetamol, 1 gram, when needed. I just want to get back to normal, really. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.0,
      "end_seconds": 343.66,
      "duration_seconds": 9.66,
      "text": "Okay, so my impression is this: It fits best with a dental abscess. A salivary gland infection is also on my list."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.75,
      "end_seconds": 349.6,
      "duration_seconds": 3.85,
      "text": "Oh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.49,
      "end_seconds": 388.04,
      "duration_seconds": 37.55,
      "text": "It's reasonable to be concerned, but right now a dental abscess is my leading thought, not anything worse. We should do a dental X-ray for dental abscess. I'll start you on amoxicillin, 500 milligrams, three times a day, five days. That's for dental abscess. See the dentist today, rinse with warm salt water. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.97,
      "end_seconds": 393.8,
      "duration_seconds": 3.83,
      "text": "I think the dentist should see you too."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.85,
      "end_seconds": 395.55,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.32,
      "end_seconds": 412.31,
      "duration_seconds": 14.99,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.71,
      "end_seconds": 414.78,
      "duration_seconds": 1.07,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.41,
      "end_seconds": 423.99,
      "duration_seconds": 8.58,
      "text": "Please come and see me in two days. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.57,
      "end_seconds": 437.35,
      "duration_seconds": 12.78,
      "text": "So, you know, I take the amoxicillin, 500 milligrams, three times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.89,
      "end_seconds": 445.94,
      "duration_seconds": 7.05,
      "text": "Alright, yes, exactly right. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 447.66,
      "end_seconds": 449.75,
      "duration_seconds": 2.09,
      "text": "Thank you, that's helpful."
    }
  ]
}