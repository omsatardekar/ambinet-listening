  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.64,
      "end_seconds": 8.25,
      "duration_seconds": 7.61,
      "text": "hello, take a seat, I'll be with you in a second. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.9,
      "end_seconds": 18.56,
      "duration_seconds": 8.66,
      "text": "um, so... a nosebleed that won't stop that's why I came i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.25,
      "end_seconds": 23.15,
      "duration_seconds": 2.9,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.31,
      "end_seconds": 27.56,
      "duration_seconds": 3.25,
      "text": "it's been going on for five days"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.49,
      "end_seconds": 39.01,
      "duration_seconds": 9.52,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.0,
      "end_seconds": 51.67,
      "duration_seconds": 11.67,
      "text": "It feels moderate to me. It's worse with blowing the nose. Well, um, and I've been feeling lightheaded as well, for three days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.43,
      "end_seconds": 57.41,
      "duration_seconds": 4.98,
      "text": "Okay, a few quick ones: easy bruising, chest pain or black stools?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.84,
      "end_seconds": 63.26,
      "duration_seconds": 4.42,
      "text": "no, no easy bruising, chest pain or black stools"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.75,
      "end_seconds": 67.18,
      "duration_seconds": 2.43,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.22,
      "end_seconds": 69.15,
      "duration_seconds": 0.93,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.08,
      "end_seconds": 77.19,
      "duration_seconds": 4.11,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.75,
      "end_seconds": 85.44,
      "duration_seconds": 2.69,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.98,
      "end_seconds": 91.66,
      "duration_seconds": 4.68,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.33,
      "end_seconds": 96.05,
      "duration_seconds": 3.72,
      "text": "No, not that that I know of."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.13,
      "end_seconds": 110.54,
      "duration_seconds": 4.41,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.08,
      "end_seconds": 115.97,
      "duration_seconds": 2.89,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.65,
      "end_seconds": 133.7,
      "duration_seconds": 3.05,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.64,
      "end_seconds": 135.77,
      "duration_seconds": 1.13,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.49,
      "end_seconds": 153.79,
      "duration_seconds": 1.3,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.62,
      "end_seconds": 161.2,
      "duration_seconds": 3.58,
      "text": "So, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.77,
      "end_seconds": 164.58,
      "duration_seconds": 2.81,
      "text": "Alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.66,
      "end_seconds": 171.29,
      "duration_seconds": 2.63,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.27,
      "end_seconds": 174.6,
      "duration_seconds": 2.33,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 180.2,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.51,
      "end_seconds": 185.16,
      "duration_seconds": 2.65,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.35,
      "end_seconds": 190.17,
      "duration_seconds": 3.82,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.65,
      "end_seconds": 205.46,
      "duration_seconds": 2.81,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 214.85,
      "duration_seconds": 2.37,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.74,
      "end_seconds": 235.94,
      "duration_seconds": 10.2,
      "text": "okay: temperature 36.5, blood pressure 119 over 73, pulse 67, SpO2 98 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.49,
      "end_seconds": 243.15,
      "duration_seconds": 4.66,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.51,
      "end_seconds": 245.91,
      "duration_seconds": 1.4,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 264.55,
      "duration_seconds": 8.84,
      "text": "There is a bleeding point on the front of the septum and the the nose has been dry."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.12,
      "end_seconds": 279.84,
      "duration_seconds": 12.72,
      "text": "good, you can sit up again okay, thinking it through, I can't pin this down yet we're looking at an anterior nosebleed on a blood thinner or a clotting problem"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.64,
      "end_seconds": 282.75,
      "duration_seconds": 2.11,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.36,
      "end_seconds": 300.57,
      "duration_seconds": 16.21,
      "text": "I understand the worry. At the moment I'd say it's an anterior nosebleed on a blood thinner, and we'll watch how it goes. Today I'm not changing anything. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.18,
      "end_seconds": 305.43,
      "duration_seconds": 3.25,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.25,
      "end_seconds": 307.5,
      "duration_seconds": 1.25,
      "text": "all the best"
    }
  ]
}