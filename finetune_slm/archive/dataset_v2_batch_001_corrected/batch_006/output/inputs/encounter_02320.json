{
  "schema_version": "1.0",
  "encounter_id": "02320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 5.27,
      "duration_seconds": 4.07,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 11.09,
      "duration_seconds": 4.24,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.36,
      "end_seconds": 18.85,
      "duration_seconds": 6.49,
      "text": "It's itchy watery eyes. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 24.1,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.04,
      "end_seconds": 28.01,
      "duration_seconds": 1.97,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.54,
      "end_seconds": 38.12,
      "duration_seconds": 9.58,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.21,
      "end_seconds": 66.22,
      "duration_seconds": 26.01,
      "text": "I, I'd give it a three, out of ten. I get some relief from cold compress. Sorry, I know I'm rambling a bit. Oh, you know, and a runny nose as well, since last night. About runny nose, mostly moderate. Let me think, I've also had sneezing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.34,
      "end_seconds": 72.75,
      "duration_seconds": 5.41,
      "text": "Have you had itchy watery eyes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.36,
      "end_seconds": 82.03,
      "duration_seconds": 8.67,
      "text": "Let me think, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 89.99,
      "duration_seconds": 6.33,
      "text": "Any pain in the eye, light sensitivity, contact lens or blurred vision at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.11,
      "end_seconds": 100.37,
      "duration_seconds": 9.26,
      "text": "No pain in the eye, light sensitivity, contact lens or blurred vision, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.08,
      "end_seconds": 105.15,
      "duration_seconds": 2.07,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 113.41,
      "duration_seconds": 4.04,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.46,
      "end_seconds": 118.61,
      "duration_seconds": 4.15,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.48,
      "end_seconds": 124.78,
      "duration_seconds": 4.3,
      "text": "Okay, so my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.29,
      "end_seconds": 128.78,
      "duration_seconds": 2.49,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.73,
      "end_seconds": 132.61,
      "duration_seconds": 1.88,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.82,
      "end_seconds": 137.67,
      "duration_seconds": 3.85,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.05,
      "end_seconds": 141.61,
      "duration_seconds": 2.56,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 151.58,
      "duration_seconds": 2.91,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.93,
      "end_seconds": 156.08,
      "duration_seconds": 3.15,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.37,
      "end_seconds": 163.98,
      "duration_seconds": 2.61,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.65,
      "end_seconds": 169.93,
      "duration_seconds": 4.28,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 189.66,
      "duration_seconds": 3.61,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.78,
      "end_seconds": 194.0,
      "duration_seconds": 3.22,
      "text": "No, you know, no conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.31,
      "end_seconds": 210.67,
      "duration_seconds": 3.36,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 226.12,
      "duration_seconds": 2.41,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.96,
      "end_seconds": 250.3,
      "duration_seconds": 7.34,
      "text": "Okay: pressure 114 over 79, heart rate 69, saturation 99 percent. And temperature 36.6."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.89,
      "end_seconds": 256.83,
      "duration_seconds": 4.94,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 259.74,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.57,
      "end_seconds": 283.31,
      "duration_seconds": 5.74,
      "text": "Both eyes are pink with clear watery discharge and no sticky pus."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.39,
      "end_seconds": 308.22,
      "duration_seconds": 22.83,
      "text": "Good, you can sit up again. So where does that leave us? I'm honestly not certain yet. It could be allergic conjunctivitis, or it might be infective conjunctivitis. Avoid rubbing your eyes and keep windows closed on high-pollen days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.89,
      "end_seconds": 311.39,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.24,
      "end_seconds": 313.41,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}