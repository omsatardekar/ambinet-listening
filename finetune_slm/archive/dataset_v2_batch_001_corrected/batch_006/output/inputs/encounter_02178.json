{
  "schema_version": "1.0",
  "encounter_id": "02178",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 4.35,
      "duration_seconds": 2.97,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 7.71,
      "duration_seconds": 2.38,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 11.37,
      "duration_seconds": 2.73,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.63,
      "end_seconds": 18.17,
      "duration_seconds": 5.54,
      "text": "Yeah, I've been dealing with attacks of spinning lasting hours."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.18,
      "end_seconds": 21.43,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.35,
      "end_seconds": 25.09,
      "duration_seconds": 2.74,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.62,
      "end_seconds": 29.77,
      "duration_seconds": 3.15,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.76,
      "end_seconds": 36.24,
      "duration_seconds": 4.48,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.52,
      "end_seconds": 41.49,
      "duration_seconds": 3.97,
      "text": "Has there been a full feeling in the ear too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.56,
      "end_seconds": 47.81,
      "duration_seconds": 2.25,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.16,
      "end_seconds": 67.79,
      "duration_seconds": 3.63,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.6,
      "end_seconds": 75.66,
      "duration_seconds": 3.06,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.49,
      "end_seconds": 80.05,
      "duration_seconds": 3.56,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.44,
      "end_seconds": 82.57,
      "duration_seconds": 1.13,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.75,
      "end_seconds": 93.69,
      "duration_seconds": 2.94,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.75,
      "end_seconds": 97.48,
      "duration_seconds": 2.73,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.9,
      "end_seconds": 102.75,
      "duration_seconds": 3.85,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.22,
      "end_seconds": 115.03,
      "duration_seconds": 10.81,
      "text": "I live with my elderly mother. I hardly move around during the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.58,
      "end_seconds": 119.15,
      "duration_seconds": 3.57,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.16,
      "end_seconds": 122.51,
      "duration_seconds": 2.35,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.58,
      "end_seconds": 127.47,
      "duration_seconds": 2.89,
      "text": "Any headache, ear discharge or double vision?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.36,
      "end_seconds": 135.29,
      "duration_seconds": 5.93,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.18,
      "end_seconds": 138.49,
      "duration_seconds": 2.31,
      "text": "And weakness, any of that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.65,
      "end_seconds": 141.38,
      "duration_seconds": 1.73,
      "text": "No weakness, thankfully."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.57,
      "end_seconds": 145.34,
      "duration_seconds": 2.77,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.14,
      "end_seconds": 148.69,
      "duration_seconds": 2.55,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 168.25,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.16,
      "end_seconds": 184.39,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.26,
      "end_seconds": 211.41,
      "duration_seconds": 6.15,
      "text": "Okay: pulse 65, temperature is 36.5 degrees, blood pressure 125 over 75."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 215.5,
      "duration_seconds": 2.46,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.83,
      "end_seconds": 230.85,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.65,
      "end_seconds": 234.78,
      "duration_seconds": 3.13,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.34,
      "end_seconds": 253.0,
      "duration_seconds": 5.66,
      "text": "The ear drums look normal and the hearing is reduced on the left."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.98,
      "end_seconds": 277.98,
      "duration_seconds": 22.0,
      "text": "That's the examination finished. So, based on the history and the examination, I think we're dealing with Meniere's disease at this stage. That's my thinking for now, and it may change as we learn more. I'll request a hearing test, it'll help with vertigo and hearing loss."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 279.23,
      "end_seconds": 283.32,
      "duration_seconds": 4.09,
      "text": "We have a slot Tuesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.41,
      "end_seconds": 293.05,
      "duration_seconds": 7.64,
      "text": "For this, betahistine, 16 milligrams, three times a day, long term. That should help with vertigo."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.44,
      "end_seconds": 296.22,
      "duration_seconds": 1.78,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.3,
      "end_seconds": 315.8,
      "duration_seconds": 14.5,
      "text": "Cut down on salt and caffeine. Don't skip meals, and try to eat smaller portions more often through the day. Let's get you seen by the ENT clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.69,
      "end_seconds": 320.09,
      "duration_seconds": 2.4,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.01,
      "end_seconds": 333.6,
      "duration_seconds": 11.59,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.2,
      "end_seconds": 338.51,
      "duration_seconds": 3.31,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.02,
      "end_seconds": 341.24,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}