{
  "schema_version": "1.0",
  "encounter_id": "02159",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 7.62,
      "duration_seconds": 6.85,
      "text": "Hello, take a seat, I'll be with you in a second. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.26,
      "end_seconds": 17.47,
      "duration_seconds": 6.21,
      "text": "Doctor, it's a bump on the head. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 18.01,
      "end_seconds": 25.78,
      "duration_seconds": 7.77,
      "text": "Okay, so the vitals from earlier. Pulse 70, pressure 109 over 73, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.71,
      "end_seconds": 29.04,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.34,
      "end_seconds": 47.82,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.95,
      "end_seconds": 60.84,
      "duration_seconds": 11.89,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.75,
      "end_seconds": 65.23,
      "duration_seconds": 2.48,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.03,
      "end_seconds": 72.61,
      "duration_seconds": 6.58,
      "text": "A little tearfulness afterwards goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.32,
      "end_seconds": 76.23,
      "duration_seconds": 2.91,
      "text": "Has there been crying straight away too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.96,
      "end_seconds": 80.52,
      "duration_seconds": 2.56,
      "text": "Yeah. Four weeks, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.74,
      "end_seconds": 82.92,
      "duration_seconds": 1.18,
      "text": "What about fit?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.17,
      "end_seconds": 85.79,
      "duration_seconds": 1.62,
      "text": "Nope, no fit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.08,
      "end_seconds": 93.59,
      "duration_seconds": 6.51,
      "text": "Let me check a few things. Any vomiting, drowsiness or loss of consciousness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.03,
      "end_seconds": 101.29,
      "duration_seconds": 4.26,
      "text": "No, no vomiting, drowsiness or loss of consciousness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.82,
      "end_seconds": 105.57,
      "duration_seconds": 2.75,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.29,
      "end_seconds": 109.38,
      "duration_seconds": 2.09,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.22,
      "end_seconds": 125.99,
      "duration_seconds": 4.77,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.32,
      "end_seconds": 138.73,
      "duration_seconds": 11.41,
      "text": "Uh, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 145.69,
      "duration_seconds": 5.18,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.44,
      "end_seconds": 150.34,
      "duration_seconds": 3.9,
      "text": "Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.58,
      "end_seconds": 154.85,
      "duration_seconds": 3.27,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.2,
      "end_seconds": 162.54,
      "duration_seconds": 6.34,
      "text": "For about a month. Ah, I'm on thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 163.61,
      "end_seconds": 168.99,
      "duration_seconds": 5.38,
      "text": "Doctor, our chart from the last visit lists it as 37.5 micrograms."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.7,
      "end_seconds": 174.13,
      "duration_seconds": 3.43,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.98,
      "end_seconds": 178.96,
      "duration_seconds": 2.98,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.95,
      "end_seconds": 181.31,
      "duration_seconds": 1.36,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.14,
      "end_seconds": 184.75,
      "duration_seconds": 1.61,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.54,
      "end_seconds": 187.52,
      "duration_seconds": 1.98,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.54,
      "end_seconds": 193.88,
      "duration_seconds": 4.34,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.18,
      "end_seconds": 197.95,
      "duration_seconds": 2.77,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.79,
      "end_seconds": 203.51,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.43,
      "end_seconds": 206.89,
      "duration_seconds": 2.46,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.77,
      "end_seconds": 212.59,
      "duration_seconds": 3.82,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.97,
      "end_seconds": 219.37,
      "duration_seconds": 3.4,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.37,
      "end_seconds": 227.35,
      "duration_seconds": 4.98,
      "text": "I mean, I have COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.36,
      "end_seconds": 229.84,
      "duration_seconds": 1.48,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.16,
      "end_seconds": 234.05,
      "duration_seconds": 2.89,
      "text": "An underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.03,
      "end_seconds": 247.13,
      "duration_seconds": 8.1,
      "text": "Yes. Okay, I can see an underactive thyroid in your file as well. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.99,
      "end_seconds": 254.86,
      "duration_seconds": 5.87,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.79,
      "end_seconds": 260.49,
      "duration_seconds": 4.7,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.48,
      "end_seconds": 266.51,
      "duration_seconds": 4.03,
      "text": "My brother has epilepsy. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 269.58,
      "duration_seconds": 1.94,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.38,
      "end_seconds": 272.64,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.59,
      "end_seconds": 293.45,
      "duration_seconds": 8.86,
      "text": "There is a small lump on the forehead, he is alert, and his pupils and movements are normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.08,
      "end_seconds": 301.51,
      "duration_seconds": 2.43,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.93,
      "end_seconds": 329.87,
      "duration_seconds": 9.94,
      "text": "From what you've told me and what I found, it points towards a minor head bump with no worrying signs."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.11,
      "end_seconds": 333.22,
      "duration_seconds": 2.11,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.72,
      "end_seconds": 356.39,
      "duration_seconds": 18.67,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor head bump with no worrying signs. Let me just check I've got this right. You've had a bump on the head, and no vomiting or loss of consciousness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.63,
      "end_seconds": 359.33,
      "duration_seconds": 1.7,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.19,
      "end_seconds": 388.19,
      "duration_seconds": 27.0,
      "text": "Watch him for the next twenty-four hours and give paracetamol if he is sore. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again if any vomiting or drowsiness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.22,
      "end_seconds": 392.39,
      "duration_seconds": 3.17,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.52,
      "end_seconds": 397.86,
      "duration_seconds": 4.34,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.1,
      "end_seconds": 402.4,
      "duration_seconds": 3.3,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.31,
      "end_seconds": 404.61,
      "duration_seconds": 1.3,
      "text": "Goodbye for now."
    }
  ]
}