{
  "schema_version": "1.0",
  "encounter_id": "02223",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.3,
      "duration_seconds": 4.36,
      "text": "Erm, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 11.48,
      "duration_seconds": 4.29,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.43,
      "end_seconds": 21.73,
      "duration_seconds": 8.3,
      "text": "Mainly a nosebleed that won't stop. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.09,
      "end_seconds": 27.2,
      "duration_seconds": 4.11,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.8,
      "end_seconds": 31.85,
      "duration_seconds": 4.05,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 36.93,
      "duration_seconds": 3.39,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.01,
      "end_seconds": 39.53,
      "duration_seconds": 1.52,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.11,
      "end_seconds": 40.94,
      "duration_seconds": 0.83,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.5,
      "end_seconds": 63.3,
      "duration_seconds": 20.8,
      "text": "As for blood down the back of my throat, I honestly can't say when that began. It might have been last month or the month before. Right, I've also been feeling lightheaded, for about two weeks. With feeling lightheaded, severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 68.44,
      "duration_seconds": 3.22,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.75,
      "end_seconds": 72.36,
      "duration_seconds": 2.61,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.23,
      "end_seconds": 74.99,
      "duration_seconds": 1.76,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 79.46,
      "duration_seconds": 3.42,
      "text": "I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.62,
      "end_seconds": 89.96,
      "duration_seconds": 9.34,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.11,
      "end_seconds": 93.04,
      "duration_seconds": 1.93,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.71,
      "end_seconds": 110.4,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.02,
      "end_seconds": 113.27,
      "duration_seconds": 2.25,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.07,
      "end_seconds": 120.42,
      "duration_seconds": 2.35,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.88,
      "end_seconds": 127.37,
      "duration_seconds": 3.49,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.28,
      "end_seconds": 134.4,
      "duration_seconds": 5.12,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.29,
      "end_seconds": 155.1,
      "duration_seconds": 19.81,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. My husband and I live above the shop. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.08,
      "end_seconds": 159.62,
      "duration_seconds": 3.54,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.34,
      "end_seconds": 171.89,
      "duration_seconds": 10.55,
      "text": "I'm on apixaban, 5 milligrams, twice a day. I had warfarin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.61,
      "end_seconds": 176.68,
      "duration_seconds": 4.07,
      "text": "Any chest pain, easy bruising or head injury?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.16,
      "end_seconds": 181.75,
      "duration_seconds": 3.59,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.87,
      "end_seconds": 186.19,
      "duration_seconds": 3.32,
      "text": "Right, did you notice any black stools?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.92,
      "end_seconds": 191.34,
      "duration_seconds": 3.42,
      "text": "Not that I've noticed, no black stools."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.33,
      "end_seconds": 195.41,
      "duration_seconds": 2.08,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.61,
      "end_seconds": 204.32,
      "duration_seconds": 3.71,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 206.7,
      "duration_seconds": 1.85,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.83,
      "end_seconds": 209.81,
      "duration_seconds": 1.98,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.92,
      "end_seconds": 220.11,
      "duration_seconds": 3.19,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.62,
      "end_seconds": 234.41,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 261.07,
      "duration_seconds": 11.32,
      "text": "Okay: SpO2 98 percent on room air, blood pressure 112 over 82, temperature is 36.6 degrees, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.35,
      "end_seconds": 266.31,
      "duration_seconds": 3.96,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.16,
      "end_seconds": 269.11,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.96,
      "end_seconds": 292.76,
      "duration_seconds": 6.8,
      "text": "There is a bleeding point on the front of the septum and the nose has been dry."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.94,
      "end_seconds": 317.12,
      "duration_seconds": 19.18,
      "text": "Good, you can sit up again. Okay, so my impression is this: This looks most like an anterior nosebleed on a blood thinner. The reason I say that is that your story and my examination fit together. A clotting problem is also on my list."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.64,
      "end_seconds": 321.54,
      "duration_seconds": 2.9,
      "text": "Oh, will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.61,
      "end_seconds": 332.84,
      "duration_seconds": 10.23,
      "text": "I can't promise yet, but most people with an anterior nosebleed on a blood thinner do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.62,
      "end_seconds": 351.56,
      "duration_seconds": 3.94,
      "text": "I'm sending you for a blood count because of epistaxis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 352.24,
      "end_seconds": 356.25,
      "duration_seconds": 4.01,
      "text": "I can book that for Wednesday at 11:30 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.76,
      "end_seconds": 365.87,
      "duration_seconds": 8.11,
      "text": "Lean forward and pinch the soft part of the nose for fifteen minutes; I will cauterise the point."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.44,
      "end_seconds": 369.71,
      "duration_seconds": 3.27,
      "text": "I follow. Come back in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.73,
      "end_seconds": 372.77,
      "duration_seconds": 2.04,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.94,
      "end_seconds": 380.23,
      "duration_seconds": 6.29,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.21,
      "end_seconds": 386.95,
      "duration_seconds": 4.74,
      "text": "So, I come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.03,
      "end_seconds": 394.06,
      "duration_seconds": 6.03,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.94,
      "end_seconds": 399.58,
      "duration_seconds": 3.64,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}