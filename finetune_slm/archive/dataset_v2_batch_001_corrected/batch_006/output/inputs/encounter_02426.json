{
  "schema_version": "1.0",
  "encounter_id": "02426",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 3.03,
      "duration_seconds": 2.08,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.38,
      "end_seconds": 7.41,
      "duration_seconds": 3.03,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.97,
      "end_seconds": 10.73,
      "duration_seconds": 2.76,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.95,
      "end_seconds": 19.29,
      "duration_seconds": 7.34,
      "text": "Good, that'll be useful. Pull up a chair. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.23,
      "end_seconds": 25.46,
      "duration_seconds": 4.23,
      "text": "Doctor, it's constant worrying. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.23,
      "end_seconds": 29.49,
      "duration_seconds": 3.26,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.66,
      "end_seconds": 33.34,
      "duration_seconds": 2.68,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 36.37,
      "end_seconds": 40.74,
      "duration_seconds": 4.37,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.26,
      "end_seconds": 47.23,
      "duration_seconds": 4.97,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.82,
      "end_seconds": 51.02,
      "duration_seconds": 2.2,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.39,
      "end_seconds": 56.46,
      "duration_seconds": 5.07,
      "text": "Yes, carry on. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.46,
      "end_seconds": 61.07,
      "duration_seconds": 3.61,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.66,
      "end_seconds": 69.63,
      "duration_seconds": 7.97,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 69.73,
      "end_seconds": 75.47,
      "duration_seconds": 5.74,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.04,
      "end_seconds": 89.8,
      "duration_seconds": 12.76,
      "text": "I was getting to that! I've also had a tight chest, for about three months. And I've been feeling on edge as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 91.32,
      "end_seconds": 93.3,
      "duration_seconds": 1.98,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.14,
      "end_seconds": 114.63,
      "duration_seconds": 8.49,
      "text": "Let me check a few things. Any thoughts of harming myself, chest pain on exertion, drinking more or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.71,
      "end_seconds": 132.23,
      "duration_seconds": 16.52,
      "text": "No, no thoughts of harming myself, no chest pain on exertion, no drinking more. I did have trouble sleeping at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.17,
      "end_seconds": 135.54,
      "duration_seconds": 2.37,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.07,
      "end_seconds": 138.88,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.94,
      "end_seconds": 143.01,
      "duration_seconds": 3.07,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.63,
      "end_seconds": 150.93,
      "duration_seconds": 2.3,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.02,
      "end_seconds": 153.98,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.66,
      "end_seconds": 162.65,
      "duration_seconds": 6.99,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.78,
      "end_seconds": 166.49,
      "duration_seconds": 2.71,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.76,
      "end_seconds": 182.38,
      "duration_seconds": 14.62,
      "text": "For my mood, I believe. My son sets them out for me, I just take what I'm given. I'm on something called prop... propranolol, 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.22,
      "end_seconds": 187.53,
      "duration_seconds": 4.31,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.37,
      "end_seconds": 190.73,
      "duration_seconds": 2.36,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 204.85,
      "duration_seconds": 3.06,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.59,
      "end_seconds": 207.46,
      "duration_seconds": 1.87,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 212.03,
      "end_seconds": 218.82,
      "duration_seconds": 6.79,
      "text": "Hold on, doctor, I think he reacted to tramadol once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.99,
      "end_seconds": 222.02,
      "duration_seconds": 2.03,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.6,
      "end_seconds": 229.02,
      "duration_seconds": 6.42,
      "text": "Okay, I'll note both of those. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.66,
      "end_seconds": 234.39,
      "duration_seconds": 4.73,
      "text": "My grandfather had a stroke. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.71,
      "end_seconds": 237.7,
      "duration_seconds": 1.99,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.97,
      "end_seconds": 244.21,
      "duration_seconds": 5.24,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 253.28,
      "duration_seconds": 3.14,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.31,
      "end_seconds": 262.77,
      "duration_seconds": 5.46,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.42,
      "end_seconds": 268.31,
      "duration_seconds": 3.89,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.1,
      "end_seconds": 272.87,
      "duration_seconds": 2.77,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.13,
      "end_seconds": 281.3,
      "duration_seconds": 7.17,
      "text": "Alright, tell me about any past illnesses or ongoing conditions. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.26,
      "end_seconds": 283.82,
      "duration_seconds": 1.56,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.8,
      "end_seconds": 285.5,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.24,
      "end_seconds": 289.45,
      "duration_seconds": 3.21,
      "text": "I have migraines. I've got acid reflux."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.55,
      "end_seconds": 293.29,
      "duration_seconds": 1.74,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.56,
      "end_seconds": 299.8,
      "duration_seconds": 5.24,
      "text": "Yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 303.28,
      "end_seconds": 311.99,
      "duration_seconds": 8.71,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 98 percent, blood pressure 127 over 71. Pulse 71, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.16,
      "end_seconds": 314.55,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.5,
      "end_seconds": 320.56,
      "duration_seconds": 4.06,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.6,
      "end_seconds": 324.03,
      "duration_seconds": 2.43,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.01,
      "end_seconds": 346.95,
      "duration_seconds": 4.94,
      "text": "Your heart sounds are normal and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.57,
      "end_seconds": 350.14,
      "duration_seconds": 1.57,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.72,
      "end_seconds": 380.54,
      "duration_seconds": 26.82,
      "text": "Good, you can sit up again. Taking everything into account, this is probably generalised anxiety. That's my thinking for now, and it may change as we learn more. I can't rule out an overactive thyroid yet. Let's book a thyroid test to look into anxiety symptoms. It's a routine test and it'll give us a much clearer picture. Try slow breathing and regular exercise, and limit caffeine."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.83,
      "end_seconds": 405.54,
      "duration_seconds": 19.71,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.82,
      "end_seconds": 410.12,
      "duration_seconds": 3.3,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.66,
      "end_seconds": 413.34,
      "duration_seconds": 1.68,
      "text": "Right, goodbye for now."
    }
  ]
}