{
  "schema_version": "1.0",
  "encounter_id": "02376",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 3.07,
      "duration_seconds": 1.89,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.98,
      "end_seconds": 7.44,
      "duration_seconds": 3.46,
      "text": "Right, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 11.15,
      "duration_seconds": 1.75,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.58,
      "end_seconds": 20.31,
      "duration_seconds": 7.73,
      "text": "Um, so... electric shock pains in my cheek. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.25,
      "end_seconds": 24.69,
      "duration_seconds": 2.44,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.82,
      "end_seconds": 33.86,
      "duration_seconds": 3.04,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.09,
      "end_seconds": 48.39,
      "duration_seconds": 5.3,
      "text": "Okay: pulse 72, pressure 128 over 81, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.06,
      "end_seconds": 69.99,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.91,
      "end_seconds": 79.66,
      "duration_seconds": 8.75,
      "text": "it's been going on for one week i kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.05,
      "end_seconds": 83.78,
      "duration_seconds": 2.73,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 86.78,
      "duration_seconds": 2.43,
      "text": "I, I'd say severe"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.21,
      "end_seconds": 93.1,
      "duration_seconds": 2.89,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.97,
      "end_seconds": 105.16,
      "duration_seconds": 7.19,
      "text": "Pain lasting seconds goes along with it, um, most of the time"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.17,
      "end_seconds": 109.67,
      "duration_seconds": 3.5,
      "text": "Has there been being afraid to eat too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.45,
      "end_seconds": 129.71,
      "duration_seconds": 16.26,
      "text": "Yes, uh, for about three months. With being afraid to eat, maybe a eight out of ten on a bad day. Well, the pain lasting seconds? That's been for three weeks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.8,
      "end_seconds": 133.75,
      "duration_seconds": 1.95,
      "text": "any sign of hearing loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.32,
      "end_seconds": 139.4,
      "duration_seconds": 4.08,
      "text": "Not that I've noticed, no hearing loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 143.65,
      "duration_seconds": 3.28,
      "text": "So, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.23,
      "end_seconds": 145.94,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.47,
      "end_seconds": 149.79,
      "duration_seconds": 2.32,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.17,
      "end_seconds": 157.24,
      "duration_seconds": 6.07,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.76,
      "end_seconds": 159.11,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.14,
      "end_seconds": 163.15,
      "duration_seconds": 3.01,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.96,
      "end_seconds": 165.4,
      "duration_seconds": 1.44,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 170.74,
      "duration_seconds": 4.22,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 175.61,
      "duration_seconds": 2.88,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.23,
      "end_seconds": 182.25,
      "duration_seconds": 5.02,
      "text": "So, um, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.14,
      "end_seconds": 204.86,
      "duration_seconds": 5.72,
      "text": "What about your medical history? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.46,
      "end_seconds": 209.69,
      "duration_seconds": 3.23,
      "text": "I've, I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.7,
      "end_seconds": 223.53,
      "duration_seconds": 11.83,
      "text": "Yes, carry on. Yes, heart failure is known to us, good to have that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.75,
      "end_seconds": 229.75,
      "duration_seconds": 5.0,
      "text": "Oh, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.35,
      "end_seconds": 234.73,
      "duration_seconds": 3.38,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.78,
      "end_seconds": 237.85,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.18,
      "end_seconds": 251.83,
      "duration_seconds": 5.65,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.35,
      "end_seconds": 273.95,
      "duration_seconds": 16.6,
      "text": "That's the examination finished. Okay, so my impression is this: The most likely explanation is trigeminal neuralgia. I want to be honest that this is an impression, not a final answer. We shouldn't forget a dental problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.18,
      "end_seconds": 288.2,
      "duration_seconds": 7.02,
      "text": "An MRI scan of the head is what I'd like next, for facial pain"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.2,
      "end_seconds": 292.89,
      "duration_seconds": 2.69,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.43,
      "end_seconds": 313.36,
      "duration_seconds": 18.93,
      "text": "We'll begin with carbamazepine, 100 milligrams, twice a day, titrate. That's for nerve pain. Avoid known triggers and eat soft foods when it flares. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.49,
      "end_seconds": 316.61,
      "duration_seconds": 2.12,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.64,
      "end_seconds": 324.28,
      "duration_seconds": 6.64,
      "text": "Let's plan a check in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.97,
      "end_seconds": 329.66,
      "duration_seconds": 3.69,
      "text": "Hmm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.93,
      "end_seconds": 332.8,
      "duration_seconds": 1.87,
      "text": "have a good day"
    }
  ]
}