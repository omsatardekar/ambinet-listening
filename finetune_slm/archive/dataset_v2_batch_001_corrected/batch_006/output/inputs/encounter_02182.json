{
  "schema_version": "1.0",
  "encounter_id": "02182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 7.2,
      "duration_seconds": 6.4,
      "text": "Hi, uh, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.99,
      "duration_seconds": 4.5,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.95,
      "end_seconds": 18.78,
      "duration_seconds": 4.83,
      "text": "Um, so... a headache. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.5,
      "end_seconds": 23.65,
      "duration_seconds": 3.15,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.91,
      "end_seconds": 28.09,
      "duration_seconds": 3.18,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.26,
      "end_seconds": 31.72,
      "duration_seconds": 2.46,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.71,
      "end_seconds": 37.53,
      "duration_seconds": 3.82,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 42.39,
      "duration_seconds": 3.45,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.47,
      "end_seconds": 54.23,
      "duration_seconds": 9.76,
      "text": "I mean, pretty severe, if I'm being honest. There was being drowsy, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.1,
      "end_seconds": 58.47,
      "duration_seconds": 3.37,
      "text": "Have you noticed chest pain, fever or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.04,
      "end_seconds": 61.35,
      "duration_seconds": 2.31,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.58,
      "end_seconds": 64.43,
      "duration_seconds": 2.85,
      "text": "Ah. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.26,
      "end_seconds": 67.84,
      "duration_seconds": 2.58,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.83,
      "end_seconds": 73.16,
      "duration_seconds": 4.33,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.91,
      "end_seconds": 85.21,
      "duration_seconds": 11.3,
      "text": "Oh, I take furosemide, 40 milligrams, every morning for the fluid. It's alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.67,
      "end_seconds": 97.04,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.38,
      "end_seconds": 103.78,
      "duration_seconds": 5.4,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.13,
      "end_seconds": 109.01,
      "duration_seconds": 3.88,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.22,
      "end_seconds": 117.91,
      "duration_seconds": 7.69,
      "text": "Not currently, uh, but as a youngster amoxicillin gave me a rash all over."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.48,
      "end_seconds": 133.06,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.49,
      "end_seconds": 149.26,
      "duration_seconds": 14.77,
      "text": "Yes, heart failure. I wasn't sure whether to come in at all, to be honest. I'm hoping you can tell me something definite. I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.12,
      "end_seconds": 157.8,
      "duration_seconds": 7.68,
      "text": "Yes, heart failure is known to us, good to have that clear. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.51,
      "end_seconds": 173.69,
      "duration_seconds": 15.18,
      "text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I'm a plumber, lots of bending and kneeling. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.45,
      "end_seconds": 177.4,
      "duration_seconds": 1.95,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.16,
      "end_seconds": 191.68,
      "duration_seconds": 2.52,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.73,
      "end_seconds": 223.53,
      "duration_seconds": 11.8,
      "text": "Okay: BP is 113 over 77, saturation 98 percent. And respiratory rate 14, pulse 70. From what you've told me, my working impression is possible carbon monoxide poisoning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.89,
      "end_seconds": 228.19,
      "duration_seconds": 3.3,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.18,
      "end_seconds": 238.94,
      "duration_seconds": 8.76,
      "text": "Nothing I've seen today points to an emergency. It looks like possible carbon monoxide poisoning, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.62,
      "end_seconds": 261.68,
      "duration_seconds": 6.06,
      "text": "A carboxyhaemoglobin blood test is what I'd like next, for possible carbon monoxide poisoning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.7,
      "end_seconds": 266.23,
      "duration_seconds": 2.53,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.11,
      "end_seconds": 283.88,
      "duration_seconds": 16.77,
      "text": "We'll begin with high-flow oxygen, 15 litres per minute, continuous, until reviewed. That's for carbon monoxide poisoning. Leave the house now, don't use the boiler, and call the gas emergency number. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.28,
      "end_seconds": 289.98,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.98,
      "end_seconds": 292.88,
      "duration_seconds": 1.9,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.7,
      "end_seconds": 298.52,
      "duration_seconds": 1.82,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 302.99,
      "duration_seconds": 3.26,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.82,
      "end_seconds": 308.65,
      "duration_seconds": 3.83,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.2,
      "end_seconds": 312.01,
      "duration_seconds": 1.81,
      "text": "So, take care now."
    }
  ]
}