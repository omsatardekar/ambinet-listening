{
  "schema_version": "1.0",
  "encounter_id": "02463",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 7.02,
      "duration_seconds": 5.7,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 12.75,
      "duration_seconds": 5.14,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.61,
      "end_seconds": 19.81,
      "duration_seconds": 5.2,
      "text": "Well, I've been having a knee that gave way playing football."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.9,
      "end_seconds": 24.82,
      "duration_seconds": 2.92,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.61,
      "end_seconds": 32.58,
      "duration_seconds": 5.97,
      "text": "I'd say about a week. Actually, no, closer to three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.44,
      "end_seconds": 36.6,
      "duration_seconds": 3.16,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.37,
      "end_seconds": 42.17,
      "duration_seconds": 3.8,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.96,
      "end_seconds": 57.72,
      "duration_seconds": 3.76,
      "text": "Did you get locked knee, calf pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.24,
      "end_seconds": 60.76,
      "duration_seconds": 2.52,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.07,
      "end_seconds": 64.44,
      "duration_seconds": 2.37,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.09,
      "end_seconds": 67.46,
      "duration_seconds": 2.37,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.95,
      "end_seconds": 72.88,
      "duration_seconds": 3.93,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.3,
      "end_seconds": 77.97,
      "duration_seconds": 3.67,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.86,
      "end_seconds": 85.57,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.15,
      "end_seconds": 88.19,
      "duration_seconds": 1.04,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.43,
      "end_seconds": 93.74,
      "duration_seconds": 4.31,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.44,
      "end_seconds": 98.99,
      "duration_seconds": 3.55,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.52,
      "end_seconds": 103.0,
      "duration_seconds": 2.48,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 105.79,
      "duration_seconds": 2.24,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.92,
      "end_seconds": 123.1,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.02,
      "end_seconds": 132.41,
      "duration_seconds": 7.39,
      "text": "Yes, heart failure. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 142.81,
      "duration_seconds": 2.3,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.78,
      "end_seconds": 155.5,
      "duration_seconds": 10.72,
      "text": "It's metoprolol, 50 milligrams, twice a day for my heart. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.35,
      "end_seconds": 159.28,
      "duration_seconds": 2.93,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.75,
      "end_seconds": 169.52,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.18,
      "end_seconds": 193.81,
      "duration_seconds": 5.63,
      "text": "okay: pulse 79, blood pressure 113 over 80, temperature is 36.7 degrees"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.86,
      "end_seconds": 199.24,
      "duration_seconds": 3.38,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.04,
      "end_seconds": 203.47,
      "duration_seconds": 2.43,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.37,
      "end_seconds": 223.79,
      "duration_seconds": 7.42,
      "text": "the knee is swollen and when I pull the shin forwards it moves more than the other side"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 235.02,
      "duration_seconds": 9.01,
      "text": "That's the examination finished. Having listened and examined, it it points towards a likely anterior cruciate ligament tear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.76,
      "end_seconds": 237.89,
      "duration_seconds": 2.13,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.65,
      "end_seconds": 259.34,
      "duration_seconds": 20.69,
      "text": "It's reasonable to be concerned, but right now a likely anterior cruciate ligament tear is my leading thought, not anything worse. Let me just check I've got this right. You've had a knee that gave way playing football for three weeks, and no fever or calf pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.79,
      "end_seconds": 262.26,
      "duration_seconds": 1.47,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.56,
      "end_seconds": 279.47,
      "duration_seconds": 5.91,
      "text": "I want an MRI of the knee done, that's for knee injury"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.42,
      "end_seconds": 283.75,
      "duration_seconds": 2.33,
      "text": "when would that take place?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.26,
      "end_seconds": 306.72,
      "duration_seconds": 21.46,
      "text": "Let's book an X-ray of the knee to look into knee injury. Rest, ice and elevation, and use crutches until the scan. I'll also refer you to the sports injury clinic. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.17,
      "end_seconds": 312.26,
      "duration_seconds": 4.09,
      "text": "Yes, uh, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.84,
      "end_seconds": 318.28,
      "duration_seconds": 5.44,
      "text": "I'll want another look after the scan. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.26,
      "end_seconds": 322.67,
      "duration_seconds": 2.41,
      "text": "Alright, thanks, take care."
    }
  ]
}