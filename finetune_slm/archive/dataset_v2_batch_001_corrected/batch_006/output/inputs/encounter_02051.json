{
  "schema_version": "1.0",
  "encounter_id": "02051",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 4.93,
      "duration_seconds": 4.06,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 11.79,
      "duration_seconds": 5.44,
      "text": "Alright, thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.68,
      "end_seconds": 19.98,
      "duration_seconds": 6.3,
      "text": "Right, it's constant worrying. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.68,
      "end_seconds": 23.91,
      "duration_seconds": 3.23,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.31,
      "end_seconds": 28.1,
      "duration_seconds": 2.79,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.05,
      "end_seconds": 33.19,
      "duration_seconds": 3.14,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.99,
      "end_seconds": 36.46,
      "duration_seconds": 1.47,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.13,
      "end_seconds": 41.04,
      "duration_seconds": 2.91,
      "text": "Have you been feeling on edge?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.68,
      "end_seconds": 57.28,
      "duration_seconds": 15.6,
      "text": "Sorry, what was I saying, yeah. Three weeks, I'd say. With feeling on edge, I'd give it a eight, out of ten. I had a tight chest before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.45,
      "end_seconds": 63.3,
      "duration_seconds": 4.85,
      "text": "A few quick ones: drinking more or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.2,
      "end_seconds": 70.45,
      "duration_seconds": 3.25,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.07,
      "end_seconds": 76.49,
      "duration_seconds": 4.42,
      "text": "Have you had any chest pain on exertion or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.19,
      "end_seconds": 80.93,
      "duration_seconds": 2.74,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.59,
      "end_seconds": 85.58,
      "duration_seconds": 2.99,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.9,
      "end_seconds": 89.38,
      "duration_seconds": 2.48,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.67,
      "end_seconds": 95.53,
      "duration_seconds": 2.86,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.77,
      "end_seconds": 99.15,
      "duration_seconds": 2.38,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.48,
      "end_seconds": 115.17,
      "duration_seconds": 4.69,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.87,
      "end_seconds": 119.69,
      "duration_seconds": 3.82,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.44,
      "end_seconds": 137.4,
      "duration_seconds": 2.96,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.0,
      "end_seconds": 142.46,
      "duration_seconds": 4.46,
      "text": "I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 144.08,
      "end_seconds": 149.0,
      "duration_seconds": 4.92,
      "text": "Doctor, our chart from the last visit lists it as 140 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.53,
      "end_seconds": 153.66,
      "duration_seconds": 4.13,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.68,
      "end_seconds": 166.35,
      "duration_seconds": 10.67,
      "text": "Sorry, what was I saying, no, I left it at home. I take Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.28,
      "end_seconds": 171.88,
      "duration_seconds": 4.6,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.78,
      "end_seconds": 179.74,
      "duration_seconds": 3.96,
      "text": "I have thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.73,
      "end_seconds": 183.72,
      "duration_seconds": 2.99,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.45,
      "end_seconds": 188.01,
      "duration_seconds": 2.56,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.84,
      "end_seconds": 199.96,
      "duration_seconds": 10.12,
      "text": "Okay, go on. Okay, I can see thin bones and an underactive thyroid in your file as well. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.56,
      "end_seconds": 210.22,
      "duration_seconds": 9.66,
      "text": "I live with my elderly mother. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 210.86,
      "end_seconds": 227.36,
      "duration_seconds": 16.5,
      "text": "Doctor, I've got the readings for you. BP is 114 over 74, BMI works out to 24.0, heart rate 84, SpO2 98 percent on room air, weight 71 kilos, height 172 centimetres, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.47,
      "end_seconds": 229.86,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.58,
      "end_seconds": 233.65,
      "duration_seconds": 2.07,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.55,
      "end_seconds": 239.02,
      "duration_seconds": 3.47,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.4,
      "end_seconds": 259.36,
      "duration_seconds": 4.96,
      "text": "Your heart sounds are normal and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.24,
      "end_seconds": 266.86,
      "duration_seconds": 2.62,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.52,
      "end_seconds": 291.12,
      "duration_seconds": 7.6,
      "text": "So where does that leave us? This looks most like generalised anxiety. We shouldn't forget an overactive thyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.2,
      "end_seconds": 294.12,
      "duration_seconds": 1.92,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.68,
      "end_seconds": 319.95,
      "duration_seconds": 25.27,
      "text": "I understand the worry. At the moment I'd say it's generalised anxiety, and we'll watch how it goes. I'm going to send a referral to the talking therapy service. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.01,
      "end_seconds": 324.11,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    }
  ]
}