{
  "schema_version": "1.0",
  "encounter_id": "02039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 5.34,
      "duration_seconds": 3.97,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 10.22,
      "duration_seconds": 4.0,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.22,
      "end_seconds": 22.65,
      "duration_seconds": 11.43,
      "text": "Right, mainly a red swollen foot. There's a couple of other things, but that's the main one. Well, I've also been feeling shivery."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.88,
      "end_seconds": 23.83,
      "duration_seconds": 0.95,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.74,
      "end_seconds": 37.14,
      "duration_seconds": 5.4,
      "text": "So, any pain in the foot, fever, tracking redness or black skin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.64,
      "end_seconds": 50.37,
      "duration_seconds": 7.73,
      "text": "No pain in the foot, fever, tracking redness or black skin, none of it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.68,
      "end_seconds": 54.66,
      "duration_seconds": 3.98,
      "text": "Right, right. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.62,
      "end_seconds": 59.63,
      "duration_seconds": 3.01,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.41,
      "end_seconds": 67.12,
      "duration_seconds": 3.71,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.14,
      "end_seconds": 75.56,
      "duration_seconds": 7.42,
      "text": "Sorry, what was I saying, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.18,
      "end_seconds": 93.0,
      "duration_seconds": 4.82,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.68,
      "end_seconds": 98.41,
      "duration_seconds": 3.73,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.28,
      "end_seconds": 100.63,
      "duration_seconds": 1.35,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.23,
      "end_seconds": 105.29,
      "duration_seconds": 1.06,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 114.68,
      "duration_seconds": 4.46,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.2,
      "end_seconds": 118.81,
      "duration_seconds": 3.61,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.09,
      "end_seconds": 124.19,
      "duration_seconds": 4.1,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.91,
      "end_seconds": 129.86,
      "duration_seconds": 3.95,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.11,
      "end_seconds": 137.38,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.11,
      "end_seconds": 143.78,
      "duration_seconds": 4.67,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.85,
      "end_seconds": 146.9,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.49,
      "end_seconds": 153.26,
      "duration_seconds": 2.77,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.28,
      "end_seconds": 172.2,
      "duration_seconds": 3.92,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.81,
      "end_seconds": 178.13,
      "duration_seconds": 4.32,
      "text": "I take metformin, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.72,
      "end_seconds": 186.14,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.27,
      "end_seconds": 193.42,
      "duration_seconds": 6.15,
      "text": "500 milligrams. I take fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.92,
      "end_seconds": 195.96,
      "duration_seconds": 2.04,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 197.23,
      "end_seconds": 204.78,
      "duration_seconds": 7.55,
      "text": "Here are the numbers, doctor. Respiratory rate 21, pulse 98, temp 38.2 degrees, BP is 120 over 71."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.33,
      "end_seconds": 206.29,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.49,
      "end_seconds": 212.91,
      "duration_seconds": 4.42,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.04,
      "end_seconds": 216.19,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.3,
      "end_seconds": 235.51,
      "duration_seconds": 6.21,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.06,
      "end_seconds": 255.51,
      "duration_seconds": 16.45,
      "text": "Okay, that's enough for me. So where does that leave us? This looks most like an infected diabetic foot ulcer. I want to be honest that this is an impression, not a final answer. I can't rule out osteomyelitis yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.78,
      "end_seconds": 261.66,
      "duration_seconds": 1.88,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.72,
      "end_seconds": 295.19,
      "duration_seconds": 31.47,
      "text": "I understand the worry. At the moment I'd say it's an infected diabetic foot ulcer, and we'll know more once the blood tests is back. Let's book blood tests to look into infected ulcer. I'm going to order a wound swab, for infected ulcer. The treatment will be co-amoxiclav, 625 milligrams, three times a day, seven days. That's for infected ulcer. Keep the weight off the foot and keep the dressing dry."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.14,
      "end_seconds": 318.13,
      "duration_seconds": 20.99,
      "text": "Please take the tablets with food so they don't upset your stomach. I'm going to send a referral to the diabetic foot clinic. We'll catch up in two days. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.82,
      "end_seconds": 331.37,
      "duration_seconds": 11.55,
      "text": "So, um, I take the co-amoxiclav, 625 milligrams, three times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.04,
      "end_seconds": 337.25,
      "duration_seconds": 4.21,
      "text": "So, yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.29,
      "end_seconds": 341.82,
      "duration_seconds": 3.53,
      "text": "Great, thank you for your help."
    }
  ]
}