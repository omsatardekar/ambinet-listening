{
  "schema_version": "1.0",
  "encounter_id": "02256",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.16,
      "duration_seconds": 2.9,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.79,
      "duration_seconds": 4.55,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.98,
      "end_seconds": 18.11,
      "duration_seconds": 6.13,
      "text": "So the thing is, I've got a lump in my left breast."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 22.62,
      "duration_seconds": 3.01,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.68,
      "end_seconds": 33.49,
      "duration_seconds": 9.81,
      "text": "Since yesterday, that's when it began. Well, there's the lump being there for a month as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.9,
      "end_seconds": 38.37,
      "duration_seconds": 3.47,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.29,
      "end_seconds": 50.8,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.09,
      "end_seconds": 76.25,
      "duration_seconds": 11.16,
      "text": "Okay: BP is 117 over 80, temperature is 36.6 degrees. And SpO2 97 percent on room air, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.36,
      "end_seconds": 81.52,
      "duration_seconds": 4.16,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.01,
      "end_seconds": 86.37,
      "duration_seconds": 3.36,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.46,
      "end_seconds": 104.88,
      "duration_seconds": 10.42,
      "text": "There is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.59,
      "end_seconds": 114.82,
      "duration_seconds": 7.23,
      "text": "That's all I needed to check. Any weight loss or lump under the arm at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.55,
      "end_seconds": 119.09,
      "duration_seconds": 2.54,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.6,
      "end_seconds": 122.88,
      "duration_seconds": 3.28,
      "text": "Yes. Any nipple discharge or skin dimpling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.64,
      "end_seconds": 126.12,
      "duration_seconds": 2.48,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 130.31,
      "duration_seconds": 3.38,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.24,
      "end_seconds": 133.14,
      "duration_seconds": 1.9,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.44,
      "end_seconds": 153.28,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.89,
      "end_seconds": 158.05,
      "duration_seconds": 4.16,
      "text": "It's alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.45,
      "end_seconds": 162.34,
      "duration_seconds": 2.89,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 167.08,
      "duration_seconds": 4.22,
      "text": "70 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.39,
      "end_seconds": 171.26,
      "duration_seconds": 2.87,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.45,
      "end_seconds": 176.08,
      "duration_seconds": 3.63,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.92,
      "end_seconds": 179.92,
      "duration_seconds": 2.0,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.62,
      "end_seconds": 185.92,
      "duration_seconds": 4.3,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.73,
      "end_seconds": 190.85,
      "duration_seconds": 4.12,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.81,
      "end_seconds": 196.54,
      "duration_seconds": 3.73,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.54,
      "end_seconds": 206.96,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.64,
      "end_seconds": 210.98,
      "duration_seconds": 2.34,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.09,
      "end_seconds": 229.71,
      "duration_seconds": 6.62,
      "text": "Anything in your past medical history I should know? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.38,
      "end_seconds": 238.16,
      "duration_seconds": 6.78,
      "text": "Yes, thin bones. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 241.01,
      "duration_seconds": 1.34,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.51,
      "end_seconds": 267.31,
      "duration_seconds": 10.8,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be a breast lump needing triple assessment, or it might be a cyst."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.06,
      "end_seconds": 271.97,
      "duration_seconds": 2.91,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.16,
      "end_seconds": 299.89,
      "duration_seconds": 26.73,
      "text": "Nothing I've seen today points to an emergency. It looks like a breast lump needing triple assessment, but I'd like to confirm. I'd like to arrange a needle biopsy for breast lump. This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. I think the breast clinic should see you too."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.15,
      "end_seconds": 301.85,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.22,
      "end_seconds": 306.87,
      "duration_seconds": 3.65,
      "text": "I'd like to see you again after the clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.61,
      "end_seconds": 311.67,
      "duration_seconds": 3.06,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.25,
      "end_seconds": 317.67,
      "duration_seconds": 4.42,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.33,
      "end_seconds": 322.47,
      "duration_seconds": 3.14,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}