{
  "schema_version": "1.0",
  "encounter_id": "02406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 4.51,
      "duration_seconds": 3.24,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 9.99,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 19.1,
      "duration_seconds": 5.92,
      "text": "Actually, I've been dealing with a bone sticking out of my lower leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.57,
      "end_seconds": 23.77,
      "duration_seconds": 3.2,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.9,
      "end_seconds": 32.47,
      "duration_seconds": 4.57,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.39,
      "end_seconds": 35.87,
      "duration_seconds": 2.48,
      "text": "Has there been heavy bleeding too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 39.0,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.53,
      "end_seconds": 43.07,
      "duration_seconds": 2.54,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.66,
      "end_seconds": 50.09,
      "duration_seconds": 3.43,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.99,
      "end_seconds": 55.59,
      "duration_seconds": 3.6,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.04,
      "end_seconds": 61.62,
      "duration_seconds": 1.58,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.46,
      "end_seconds": 65.38,
      "duration_seconds": 2.92,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.58,
      "end_seconds": 71.39,
      "duration_seconds": 4.81,
      "text": "Erm, you know, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.17,
      "end_seconds": 88.73,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.6,
      "end_seconds": 94.44,
      "duration_seconds": 3.84,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.09,
      "end_seconds": 97.84,
      "duration_seconds": 2.75,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 102.96,
      "duration_seconds": 3.9,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.09,
      "end_seconds": 106.9,
      "duration_seconds": 2.81,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.98,
      "end_seconds": 115.08,
      "duration_seconds": 5.1,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.77,
      "end_seconds": 118.85,
      "duration_seconds": 3.08,
      "text": "Any loss of consciousness or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 123.09,
      "duration_seconds": 3.1,
      "text": "Yeah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.08,
      "end_seconds": 126.73,
      "duration_seconds": 1.65,
      "text": "How about head injury?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.32,
      "end_seconds": 131.39,
      "duration_seconds": 4.07,
      "text": "Yeah, not at all, no head injury."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.47,
      "end_seconds": 137.45,
      "duration_seconds": 3.98,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.91,
      "end_seconds": 141.0,
      "duration_seconds": 2.09,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 159.75,
      "end_seconds": 171.11,
      "duration_seconds": 11.36,
      "text": "Here are the numbers, doctor. Pulse is 121 beats a minute, pressure 130 over 84. Respiratory rate 20, saturation 97 percent, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.98,
      "end_seconds": 174.3,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.33,
      "end_seconds": 179.72,
      "duration_seconds": 4.39,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.71,
      "end_seconds": 184.72,
      "duration_seconds": 3.01,
      "text": "Alright, I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.71,
      "end_seconds": 208.96,
      "duration_seconds": 6.25,
      "text": "There is a wound with bone visible and the foot is cool with no pulse."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.22,
      "end_seconds": 214.79,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.18,
      "end_seconds": 234.39,
      "duration_seconds": 7.21,
      "text": "Right, here's what I'm thinking. The most likely explanation is an open fracture with a compromised blood supply."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.01,
      "end_seconds": 238.28,
      "duration_seconds": 2.27,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.16,
      "end_seconds": 251.26,
      "duration_seconds": 12.1,
      "text": "I understand the worry. At the moment I'd say it's an open fracture with a compromised blood supply, and we'll know more once the an urgent X-ray is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.58,
      "end_seconds": 303.36,
      "duration_seconds": 35.78,
      "text": "An urgent X-ray is what I'd like next, for open fracture. That will help us see what's going on underneath and decide the next step. I'll start you on co-amoxiclav, 1.2 grams, now, single dose. That should help with open fracture. The pharmacy will go through the details again when you pick it up. Keep still, I am splinting the leg and sending you to theatre now. I'll also refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.43,
      "end_seconds": 316.17,
      "duration_seconds": 7.74,
      "text": "Book a review straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.84,
      "end_seconds": 319.03,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    }
  ]
}