{
  "schema_version": "1.0",
  "encounter_id": "02468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.94,
      "duration_seconds": 4.02,
      "text": "Hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 10.76,
      "duration_seconds": 4.85,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.61,
      "end_seconds": 18.56,
      "duration_seconds": 5.95,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 23.37,
      "duration_seconds": 4.07,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.19,
      "end_seconds": 30.63,
      "duration_seconds": 5.44,
      "text": "Um, so... not hearing very well. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.04,
      "end_seconds": 41.18,
      "duration_seconds": 4.14,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.86,
      "end_seconds": 53.47,
      "duration_seconds": 10.61,
      "text": "He takes hydrocortisone cream, when needed. He takes Asthalin inhaler, when needed. He takes escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.59,
      "end_seconds": 56.06,
      "duration_seconds": 1.47,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 60.28,
      "duration_seconds": 3.03,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 60.93,
      "end_seconds": 64.03,
      "duration_seconds": 3.1,
      "text": "Hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.14,
      "end_seconds": 70.14,
      "duration_seconds": 5.0,
      "text": "okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.65,
      "end_seconds": 73.8,
      "duration_seconds": 2.15,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.28,
      "end_seconds": 78.82,
      "duration_seconds": 3.54,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 81.11,
      "duration_seconds": 1.66,
      "text": "Moderate, I'd say"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.33,
      "end_seconds": 85.67,
      "duration_seconds": 3.34,
      "text": "Right, have you been turning the television up?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.57,
      "end_seconds": 90.32,
      "duration_seconds": 3.75,
      "text": "yes, about the same, about four days"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.22,
      "end_seconds": 94.49,
      "duration_seconds": 3.27,
      "text": "Has there been not listening at school too?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.48,
      "end_seconds": 97.66,
      "duration_seconds": 2.18,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.65,
      "end_seconds": 102.79,
      "duration_seconds": 3.14,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.32,
      "end_seconds": 107.66,
      "duration_seconds": 4.34,
      "text": "I, I'd give it a four, out of ten"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 116.39,
      "duration_seconds": 4.85,
      "text": "What about a cold that won't go, have you noticed that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.89,
      "end_seconds": 125.89,
      "duration_seconds": 8.0,
      "text": "Yeah. About a week, I'd say. As for cold that won't go, mostly mild."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.21,
      "end_seconds": 128.1,
      "duration_seconds": 0.89,
      "text": "any dizziness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.45,
      "end_seconds": 134.56,
      "duration_seconds": 4.11,
      "text": "Okay, so no, I haven't had any dizziness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.9,
      "end_seconds": 138.51,
      "duration_seconds": 2.61,
      "text": "Any ear pain, fever or discharge?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.42,
      "end_seconds": 145.22,
      "duration_seconds": 4.8,
      "text": "No ear pain, fever or discharge, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.78,
      "end_seconds": 151.64,
      "duration_seconds": 4.86,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.32,
      "end_seconds": 154.84,
      "duration_seconds": 2.52,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.25,
      "end_seconds": 160.21,
      "duration_seconds": 3.96,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 177.1,
      "duration_seconds": 15.96,
      "text": "Nothing, I'm teetotal. No, I've never smoked in my life. Lots of rice, lentils and some fruit. I walk the dog every morning. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.03,
      "end_seconds": 181.6,
      "duration_seconds": 2.57,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.25,
      "end_seconds": 189.02,
      "duration_seconds": 5.77,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.09,
      "end_seconds": 200.61,
      "duration_seconds": 2.52,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.66,
      "end_seconds": 206.46,
      "duration_seconds": 3.8,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 207.58,
      "end_seconds": 213.27,
      "duration_seconds": 5.69,
      "text": "I'm not sure that's right. I seem to recall a problem with amoxicillin"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.77,
      "end_seconds": 217.16,
      "duration_seconds": 3.39,
      "text": "Um, really? I don't think so."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.5,
      "end_seconds": 228.27,
      "duration_seconds": 7.77,
      "text": "alright, fair enough, I'll write down both versions anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.72,
      "end_seconds": 236.23,
      "duration_seconds": 6.51,
      "text": "I have eczema. I have asthma, for five years. I have anxiety."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.51,
      "end_seconds": 244.95,
      "duration_seconds": 4.44,
      "text": "Right, right. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 253.99,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.12,
      "end_seconds": 282.3,
      "duration_seconds": 8.18,
      "text": "Okay: oxygen saturation is 97 percent, temperature 36.6, blood pressure 124 over 75, pulse 70."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.04,
      "end_seconds": 287.17,
      "duration_seconds": 3.13,
      "text": "alright, shall I start the the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.14,
      "end_seconds": 291.17,
      "duration_seconds": 2.03,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.47,
      "end_seconds": 311.76,
      "duration_seconds": 4.29,
      "text": "both ear drums look dull and retracted with fluid behind them"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.75,
      "end_seconds": 317.99,
      "duration_seconds": 2.24,
      "text": "so, all finished, thank you"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.65,
      "end_seconds": 354.37,
      "duration_seconds": 17.72,
      "text": "Let's get a hearing test, for reduced hearing. We will watch for three months, and sit him at the front of the class. We'll catch up in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.7,
      "end_seconds": 363.14,
      "duration_seconds": 3.44,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.77,
      "end_seconds": 364.95,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}