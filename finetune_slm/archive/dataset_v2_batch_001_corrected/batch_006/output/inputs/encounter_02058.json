{
  "schema_version": "1.0",
  "encounter_id": "02058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.03,
      "end_seconds": 3.85,
      "duration_seconds": 2.82,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.33,
      "end_seconds": 9.4,
      "duration_seconds": 4.07,
      "text": "Uh, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.15,
      "end_seconds": 18.64,
      "duration_seconds": 7.49,
      "text": "good afternoon, you know, doctor. I look after them so I thought I'd come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 26.63,
      "duration_seconds": 6.91,
      "text": "Of course, please stay. It's helpful to have you here. What do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.35,
      "end_seconds": 34.0,
      "duration_seconds": 5.65,
      "text": "Uh, he's been having a weak urine stream, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.05,
      "end_seconds": 38.84,
      "duration_seconds": 2.79,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.81,
      "end_seconds": 45.19,
      "duration_seconds": 5.38,
      "text": "Sorry, what was I saying, for one week, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.47,
      "end_seconds": 53.95,
      "duration_seconds": 3.48,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.53,
      "end_seconds": 60.09,
      "duration_seconds": 2.56,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.36,
      "end_seconds": 61.41,
      "duration_seconds": 1.05,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.86,
      "end_seconds": 70.41,
      "duration_seconds": 8.55,
      "text": "I mean, I was just going to say that that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 70.51,
      "end_seconds": 76.47,
      "duration_seconds": 5.96,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 80.22,
      "duration_seconds": 2.18,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 90.85,
      "duration_seconds": 10.12,
      "text": "Ah, uh, and I've been getting up at night to pass urine as well, for about two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 94.59,
      "duration_seconds": 2.88,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.0,
      "end_seconds": 107.25,
      "duration_seconds": 11.25,
      "text": "Uh, you know, it feels moderate to me. I've also had a feeling of not emptying, since last weekend."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.12,
      "end_seconds": 114.44,
      "duration_seconds": 5.32,
      "text": "Any blood in the urine, burning on passing urine or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.23,
      "end_seconds": 121.5,
      "duration_seconds": 5.27,
      "text": "no, uh, I haven't had any of them"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.28,
      "end_seconds": 125.02,
      "duration_seconds": 2.74,
      "text": "Did you notice any back pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.9,
      "end_seconds": 130.12,
      "duration_seconds": 4.22,
      "text": "Right, no, I haven't had any back pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.71,
      "end_seconds": 136.62,
      "duration_seconds": 4.91,
      "text": "Right, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.31,
      "end_seconds": 141.81,
      "duration_seconds": 4.5,
      "text": "Mm, you know, no, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.87,
      "end_seconds": 149.21,
      "duration_seconds": 5.34,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 154.43,
      "duration_seconds": 4.08,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 155.06,
      "end_seconds": 163.78,
      "duration_seconds": 8.72,
      "text": "Actually, I remember he had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.6,
      "end_seconds": 168.32,
      "duration_seconds": 3.72,
      "text": "Ah, um, I don't remember that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.02,
      "end_seconds": 175.91,
      "duration_seconds": 6.89,
      "text": "Alright, fair enough, I'll write down both versions. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.7,
      "end_seconds": 182.84,
      "duration_seconds": 6.14,
      "text": "hmm, you know, I had my septum straightened in my thirties"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.24,
      "end_seconds": 200.15,
      "duration_seconds": 2.91,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.24,
      "end_seconds": 206.78,
      "duration_seconds": 5.54,
      "text": "My uncle has high cholesterol. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.66,
      "end_seconds": 225.43,
      "duration_seconds": 2.77,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.38,
      "end_seconds": 231.89,
      "duration_seconds": 4.51,
      "text": "I take aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 233.71,
      "end_seconds": 238.22,
      "duration_seconds": 4.51,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.56,
      "end_seconds": 243.12,
      "duration_seconds": 3.56,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.16,
      "end_seconds": 250.22,
      "duration_seconds": 5.06,
      "text": "I mean, no, I left it at home."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 259.13,
      "duration_seconds": 3.81,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.21,
      "end_seconds": 262.96,
      "duration_seconds": 1.75,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.91,
      "end_seconds": 264.84,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.63,
      "end_seconds": 270.57,
      "duration_seconds": 4.94,
      "text": "I've had heart disease for about ten years now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.24,
      "end_seconds": 273.57,
      "duration_seconds": 1.33,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.22,
      "end_seconds": 275.93,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.45,
      "end_seconds": 281.47,
      "duration_seconds": 4.02,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.21,
      "end_seconds": 284.32,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.66,
      "end_seconds": 289.68,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 291.31,
      "end_seconds": 300.05,
      "duration_seconds": 8.74,
      "text": "Doctor, I've got the readings for you. Temperature is 36.5 degrees, saturation 97 percent, BP is 127 over 82, heart rate 65."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.59,
      "end_seconds": 301.56,
      "duration_seconds": 0.97,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.86,
      "end_seconds": 308.4,
      "duration_seconds": 4.54,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.98,
      "end_seconds": 312.98,
      "duration_seconds": 3.0,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.82,
      "end_seconds": 332.9,
      "duration_seconds": 4.08,
      "text": "the prostate feels smooth and enlarged with no hard areas"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.01,
      "end_seconds": 347.21,
      "duration_seconds": 9.2,
      "text": "all finished, thank you putting it all together, it points towards benign prostate enlargement. Prostate cancer is also on my list"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.26,
      "end_seconds": 352.16,
      "duration_seconds": 3.9,
      "text": "Right, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.93,
      "end_seconds": 371.77,
      "duration_seconds": 18.84,
      "text": "it's reasonable to be concerned, but right now benign prostate enlargement is my leading thought, not anything worse. Let me repeat that back to make sure. You've had a weak urine stream for one week, moderate, and no weight loss or blood in the urine"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.7,
      "end_seconds": 375.79,
      "duration_seconds": 3.09,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 377.84,
      "end_seconds": 381.99,
      "duration_seconds": 4.15,
      "text": "I've already done a urine dipstick, it's ready for you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.03,
      "end_seconds": 391.05,
      "duration_seconds": 7.02,
      "text": "Thanks, I'll have a look. A PSA blood test is what I'd like next, for urinary symptoms."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.24,
      "end_seconds": 395.73,
      "duration_seconds": 1.49,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.61,
      "end_seconds": 405.45,
      "duration_seconds": 8.84,
      "text": "Let's book kidney function tests to look into urinary symptoms. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.81,
      "end_seconds": 408.58,
      "duration_seconds": 1.77,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.75,
      "end_seconds": 444.37,
      "duration_seconds": 34.62,
      "text": "I'll start you on tamsulosin, 400 micrograms, once a day after food, long term. You take it by mouth. That should help with urinary symptoms. Cut down on caffeine and fluids in the the evening. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. Come back after the results. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.25,
      "end_seconds": 449.44,
      "duration_seconds": 3.19,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 451.34,
      "end_seconds": 452.56,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}