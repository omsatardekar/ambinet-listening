{
  "schema_version": "1.0",
  "encounter_id": "02314",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 3.68,
      "duration_seconds": 3.09,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 9.49,
      "duration_seconds": 4.13,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.29,
      "end_seconds": 16.52,
      "duration_seconds": 6.23,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 22.15,
      "duration_seconds": 3.61,
      "text": "Alright, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 26.72,
      "duration_seconds": 3.86,
      "text": "I've been dealing with itchy spots all over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.28,
      "end_seconds": 30.07,
      "duration_seconds": 2.79,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.52,
      "end_seconds": 34.34,
      "duration_seconds": 2.82,
      "text": "About two weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.49,
      "end_seconds": 43.32,
      "duration_seconds": 3.83,
      "text": "Hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.36,
      "end_seconds": 48.7,
      "duration_seconds": 4.34,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.6,
      "end_seconds": 51.64,
      "duration_seconds": 2.04,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.18,
      "end_seconds": 56.53,
      "duration_seconds": 3.35,
      "text": "Alright, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.1,
      "end_seconds": 63.63,
      "duration_seconds": 5.53,
      "text": "Mild, really. And I've been feeling achy as well, since Monday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.44,
      "end_seconds": 68.04,
      "duration_seconds": 2.6,
      "text": "Any a mild temperature as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.95,
      "end_seconds": 72.57,
      "duration_seconds": 3.62,
      "text": "Yes, about the same, two months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.15,
      "end_seconds": 78.26,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.27,
      "end_seconds": 85.16,
      "duration_seconds": 4.89,
      "text": "It's mild, honestly. It's a few times a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.54,
      "end_seconds": 88.35,
      "duration_seconds": 1.81,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 93.23,
      "duration_seconds": 3.92,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.0,
      "end_seconds": 95.95,
      "duration_seconds": 1.95,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.58,
      "end_seconds": 99.52,
      "duration_seconds": 2.94,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.14,
      "end_seconds": 102.86,
      "duration_seconds": 1.72,
      "text": "So, what's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 110.76,
      "duration_seconds": 4.26,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.91,
      "end_seconds": 113.95,
      "duration_seconds": 2.04,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.76,
      "end_seconds": 117.11,
      "duration_seconds": 2.35,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.24,
      "end_seconds": 121.77,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.59,
      "end_seconds": 126.98,
      "duration_seconds": 3.39,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.29,
      "end_seconds": 146.02,
      "duration_seconds": 3.73,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.87,
      "end_seconds": 150.3,
      "duration_seconds": 3.43,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.71,
      "end_seconds": 168.06,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.37,
      "end_seconds": 172.67,
      "duration_seconds": 3.3,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.6,
      "end_seconds": 177.19,
      "duration_seconds": 3.59,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.64,
      "end_seconds": 186.92,
      "duration_seconds": 8.28,
      "text": "I have thin bones, for about a year. An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.52,
      "end_seconds": 196.12,
      "duration_seconds": 8.6,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.71,
      "end_seconds": 201.79,
      "duration_seconds": 4.08,
      "text": "Alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.15,
      "end_seconds": 208.32,
      "duration_seconds": 3.17,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.58,
      "end_seconds": 215.32,
      "duration_seconds": 5.74,
      "text": "No, it's at home. I'm on calamine lotion, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.9,
      "end_seconds": 218.2,
      "duration_seconds": 1.3,
      "text": "Any stiff neck?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.97,
      "end_seconds": 220.99,
      "duration_seconds": 2.02,
      "text": "No, no stiff neck."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.59,
      "end_seconds": 225.55,
      "duration_seconds": 2.96,
      "text": "Any pregnancy, breathlessness or being immunosuppressed?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.31,
      "end_seconds": 231.66,
      "duration_seconds": 4.35,
      "text": "No pregnancy, breathlessness or being immunosuppressed, none of it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.62,
      "end_seconds": 237.57,
      "duration_seconds": 3.95,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.53,
      "end_seconds": 242.92,
      "duration_seconds": 3.39,
      "text": "No, you know, nothing like that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.97,
      "end_seconds": 246.7,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.73,
      "end_seconds": 257.84,
      "duration_seconds": 2.11,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.77,
      "end_seconds": 281.81,
      "duration_seconds": 10.04,
      "text": "Okay: saturation 98 percent, temperature is 36.7 degrees. And pulse is 79 beats a minute, blood pressure 124 over 76."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.33,
      "end_seconds": 287.34,
      "duration_seconds": 4.01,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.97,
      "end_seconds": 290.24,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.48,
      "end_seconds": 307.65,
      "duration_seconds": 5.17,
      "text": "There are crops of blisters and scabs in different stages on the trunk."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.88,
      "end_seconds": 311.61,
      "duration_seconds": 1.73,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.81,
      "end_seconds": 325.49,
      "duration_seconds": 6.68,
      "text": "Okay, thinking it through, I'd lean towards chickenpox. I'd also keep shingles in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.77,
      "end_seconds": 330.12,
      "duration_seconds": 3.35,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.64,
      "end_seconds": 345.19,
      "duration_seconds": 13.55,
      "text": "Nothing I've seen today points to an emergency. It looks like chickenpox. Let me repeat that back to make sure. You've had itchy spots all over, mild, and no breathlessness or being immunosuppressed."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.33,
      "end_seconds": 349.68,
      "duration_seconds": 3.35,
      "text": "Hmm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.4,
      "end_seconds": 377.56,
      "duration_seconds": 27.16,
      "text": "Stay at home until all the spots have crusted and stay away from pregnant women. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if you become breathless or have chest pain. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.24,
      "end_seconds": 382.22,
      "duration_seconds": 2.98,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}