{
  "schema_version": "1.0",
  "encounter_id": "02308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 2.27,
      "duration_seconds": 1.6,
      "text": "evening. Let's get started"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.89,
      "end_seconds": 6.63,
      "duration_seconds": 2.74,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.7,
      "end_seconds": 9.98,
      "duration_seconds": 1.28,
      "text": "Was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.54,
      "end_seconds": 16.26,
      "duration_seconds": 5.72,
      "text": "Not great um I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 19.59,
      "duration_seconds": 2.48,
      "text": "how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.68,
      "end_seconds": 23.0,
      "duration_seconds": 2.32,
      "text": "I'm here because of agitation."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.86,
      "end_seconds": 26.25,
      "duration_seconds": 1.39,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.04,
      "end_seconds": 42.56,
      "duration_seconds": 14.52,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, um, I really can't pin it down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.24,
      "end_seconds": 49.86,
      "duration_seconds": 3.62,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.78,
      "end_seconds": 55.52,
      "duration_seconds": 3.74,
      "text": "I'd give it a four out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.09,
      "end_seconds": 56.93,
      "duration_seconds": 0.84,
      "text": "Right right."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.0,
      "end_seconds": 65.31,
      "duration_seconds": 6.31,
      "text": "oh, and vomiting and diarrhoea that's been about the same, two months"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.84,
      "end_seconds": 71.8,
      "duration_seconds": 5.96,
      "text": "Hm, okay. Have you had agitation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.12,
      "end_seconds": 80.49,
      "duration_seconds": 7.37,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.56,
      "end_seconds": 85.41,
      "duration_seconds": 2.85,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 100.82,
      "duration_seconds": 1.7,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.68,
      "end_seconds": 104.74,
      "duration_seconds": 2.06,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.75,
      "end_seconds": 123.45,
      "duration_seconds": 6.7,
      "text": "you are hot, shaking, and and your pulse is over one hundred and forty and irregular"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 129.92,
      "duration_seconds": 1.65,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.7,
      "end_seconds": 143.45,
      "duration_seconds": 3.75,
      "text": "have you had any chest pain or recent infection?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.95,
      "end_seconds": 147.26,
      "duration_seconds": 2.31,
      "text": "no none that I've noticed"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.7,
      "end_seconds": 150.89,
      "duration_seconds": 2.19,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.83,
      "end_seconds": 154.45,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.07,
      "end_seconds": 161.49,
      "duration_seconds": 3.42,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.59,
      "end_seconds": 163.58,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.01,
      "end_seconds": 171.2,
      "duration_seconds": 6.19,
      "text": "do you have any chronic illnesses? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.3,
      "end_seconds": 182.95,
      "duration_seconds": 9.65,
      "text": "I've had gout for two years now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.88,
      "end_seconds": 187.91,
      "duration_seconds": 4.03,
      "text": "Is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.47,
      "end_seconds": 191.34,
      "duration_seconds": 2.87,
      "text": "Well, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.0,
      "end_seconds": 194.67,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.2,
      "end_seconds": 198.43,
      "duration_seconds": 3.23,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.65,
      "end_seconds": 201.29,
      "duration_seconds": 1.64,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.82,
      "end_seconds": 207.81,
      "duration_seconds": 4.99,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.52,
      "end_seconds": 210.63,
      "duration_seconds": 2.11,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.99,
      "end_seconds": 214.9,
      "duration_seconds": 2.91,
      "text": "It's febuxostat, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.07,
      "end_seconds": 218.48,
      "duration_seconds": 2.41,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.2,
      "end_seconds": 223.24,
      "duration_seconds": 4.04,
      "text": "80 milligrams I think that's what's on the box."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.45,
      "end_seconds": 233.47,
      "duration_seconds": 9.02,
      "text": "From what you've told me and what I found it fits best with a thyroid storm. I can't rule out sepsis yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.41,
      "end_seconds": 238.26,
      "duration_seconds": 2.85,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 249.18,
      "duration_seconds": 9.33,
      "text": "I understand the worry at the moment I'd say it's a thyroid storm, and we'll know more once the an ECG is back"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.83,
      "end_seconds": 285.81,
      "duration_seconds": 25.98,
      "text": "We should do an ECG for fast heart rhythm. I'm going to order urgent blood tests, for thyroid storm. We'll begin with propranolol, 1 milligrams, now, single dose. That should help with thyroid storm. This is an emergency, you will be treated in high dependency. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.71,
      "end_seconds": 287.41,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.86,
      "end_seconds": 293.86,
      "duration_seconds": 5.0,
      "text": "See me again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.69,
      "end_seconds": 298.71,
      "duration_seconds": 3.02,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.49,
      "end_seconds": 300.69,
      "duration_seconds": 1.2,
      "text": "goodbye for now"
    }
  ]
}