{
  "schema_version": "1.0",
  "encounter_id": "02008",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 2.78,
      "duration_seconds": 1.52,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.34,
      "end_seconds": 8.05,
      "duration_seconds": 3.71,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.11,
      "end_seconds": 18.38,
      "duration_seconds": 8.27,
      "text": "Honestly, you know, it's not knowing where she is, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.95,
      "end_seconds": 22.19,
      "duration_seconds": 3.24,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.46,
      "end_seconds": 27.22,
      "duration_seconds": 3.76,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.98,
      "end_seconds": 32.58,
      "duration_seconds": 3.6,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.16,
      "end_seconds": 38.32,
      "duration_seconds": 5.16,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.34,
      "end_seconds": 42.03,
      "duration_seconds": 2.69,
      "text": "Has there been a fever too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.57,
      "end_seconds": 45.71,
      "duration_seconds": 2.14,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.55,
      "end_seconds": 47.48,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.9,
      "end_seconds": 52.27,
      "duration_seconds": 3.37,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.82,
      "end_seconds": 55.74,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.58,
      "end_seconds": 60.41,
      "duration_seconds": 3.83,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.33,
      "end_seconds": 63.4,
      "duration_seconds": 2.07,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.17,
      "end_seconds": 68.99,
      "duration_seconds": 3.82,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 70.9,
      "duration_seconds": 1.24,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.95,
      "end_seconds": 76.31,
      "duration_seconds": 3.36,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.8,
      "end_seconds": 96.57,
      "duration_seconds": 1.77,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 101.17,
      "duration_seconds": 3.19,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.67,
      "end_seconds": 122.72,
      "duration_seconds": 4.05,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.69,
      "end_seconds": 128.93,
      "duration_seconds": 2.24,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.45,
      "end_seconds": 132.19,
      "duration_seconds": 2.74,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 138.0,
      "duration_seconds": 3.76,
      "text": "Right, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.62,
      "end_seconds": 155.42,
      "duration_seconds": 3.8,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 160.72,
      "duration_seconds": 3.5,
      "text": "Yes, wheat, it gives me itchy skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.59,
      "end_seconds": 165.39,
      "duration_seconds": 3.8,
      "text": "Any chest pain, weakness on one side or fall?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.35,
      "end_seconds": 170.48,
      "duration_seconds": 3.13,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 175.3,
      "duration_seconds": 2.79,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.75,
      "end_seconds": 179.66,
      "duration_seconds": 2.91,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.67,
      "end_seconds": 184.63,
      "duration_seconds": 2.96,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.7,
      "end_seconds": 198.67,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.71,
      "end_seconds": 229.77,
      "duration_seconds": 14.06,
      "text": "Okay: height 184 centimetres, BMI works out to 21.6, temp 38.7 degrees, weight 73 kilos, respiratory rate 20, blood pressure 121 over 73, SpO2 98 percent on room air, pulse 88."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.24,
      "end_seconds": 232.81,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 237.57,
      "duration_seconds": 3.63,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.36,
      "end_seconds": 244.45,
      "duration_seconds": 4.09,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.67,
      "end_seconds": 247.15,
      "duration_seconds": 1.48,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 261.26,
      "duration_seconds": 5.39,
      "text": "She is drowsy, hot, disoriented, and her blood pressure is low."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.77,
      "end_seconds": 272.12,
      "duration_seconds": 6.35,
      "text": "All finished, thank you. Taking everything into account, I'd lean towards delirium from an infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.03,
      "end_seconds": 275.3,
      "duration_seconds": 2.27,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 288.49,
      "duration_seconds": 8.54,
      "text": "Nothing I've seen today points to an emergency. It looks like delirium from an infection, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.65,
      "end_seconds": 320.56,
      "duration_seconds": 24.91,
      "text": "Let's get a chest X-ray, for fever and confusion. A urine dipstick is what I'd like next, for acute confusion. She needs to go to hospital today for fluids and antibiotics. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.15,
      "end_seconds": 322.71,
      "duration_seconds": 1.56,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.84,
      "end_seconds": 326.99,
      "duration_seconds": 3.15,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.71,
      "end_seconds": 336.31,
      "duration_seconds": 3.6,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.56,
      "end_seconds": 340.43,
      "duration_seconds": 2.87,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.92,
      "end_seconds": 346.28,
      "duration_seconds": 2.36,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.04,
      "end_seconds": 348.63,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}