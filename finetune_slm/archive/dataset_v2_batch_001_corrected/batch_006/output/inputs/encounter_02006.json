      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.03,
      "end_seconds": 243.6,
      "duration_seconds": 5.57,
      "text": "the lower right molar is tender with swollen gum and the cheek is puffy"
