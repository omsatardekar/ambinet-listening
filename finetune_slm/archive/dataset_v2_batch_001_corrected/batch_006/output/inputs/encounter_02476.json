{
  "schema_version": "1.0",
  "encounter_id": "02476",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 5.13,
      "duration_seconds": 4.12,
      "text": "well, sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.68,
      "end_seconds": 9.95,
      "duration_seconds": 4.27,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.57,
      "end_seconds": 25.98,
      "duration_seconds": 14.41,
      "text": "Well, I've been having swelling within hours. I wasn't sure whether to come in at all, to be honest. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.69,
      "end_seconds": 29.56,
      "duration_seconds": 2.87,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.72,
      "end_seconds": 32.14,
      "duration_seconds": 1.42,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.58,
      "end_seconds": 35.55,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.61,
      "end_seconds": 51.77,
      "duration_seconds": 15.16,
      "text": "Not being able to straighten it fully goes along with it, most of the the time. Mm, there's a knee that gave way playing football as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.19,
      "end_seconds": 56.19,
      "duration_seconds": 3.0,
      "text": "Did you get calf pain or numbness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.16,
      "end_seconds": 60.05,
      "duration_seconds": 2.89,
      "text": "none of those, uh, no"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.46,
      "end_seconds": 64.96,
      "duration_seconds": 3.5,
      "text": "A few quick ones: fever or locked knee?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.59,
      "end_seconds": 69.43,
      "duration_seconds": 2.84,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.04,
      "end_seconds": 73.98,
      "duration_seconds": 3.94,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.67,
      "end_seconds": 78.0,
      "duration_seconds": 2.33,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.58,
      "end_seconds": 82.03,
      "duration_seconds": 3.45,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.74,
      "end_seconds": 89.52,
      "duration_seconds": 5.78,
      "text": "Ah, uh, I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.86,
      "end_seconds": 92.59,
      "duration_seconds": 1.73,
      "text": "So, any other things?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.46,
      "end_seconds": 97.86,
      "duration_seconds": 3.4,
      "text": "An underactive thyroid, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.17,
      "end_seconds": 112.92,
      "duration_seconds": 2.75,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.95,
      "end_seconds": 117.69,
      "duration_seconds": 2.74,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.35,
      "end_seconds": 123.17,
      "duration_seconds": 4.82,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.73,
      "end_seconds": 129.3,
      "duration_seconds": 4.57,
      "text": "Okay, so no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.7,
      "end_seconds": 133.11,
      "duration_seconds": 2.41,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.03,
      "end_seconds": 138.56,
      "duration_seconds": 4.53,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 142.31,
      "duration_seconds": 2.8,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.04,
      "end_seconds": 147.42,
      "duration_seconds": 3.38,
      "text": "It's gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.79,
      "end_seconds": 149.1,
      "duration_seconds": 1.31,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.12,
      "end_seconds": 159.97,
      "duration_seconds": 8.85,
      "text": "Thyroxine. I take it 75 micrograms, every morning for my thyroid. I take ibuprofen, 400 milligrams, with food."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.84,
      "end_seconds": 162.25,
      "duration_seconds": 1.41,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.12,
      "end_seconds": 168.52,
      "duration_seconds": 5.4,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.91,
      "end_seconds": 171.27,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.74,
      "end_seconds": 175.45,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.63,
      "end_seconds": 181.96,
      "duration_seconds": 2.33,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.52,
      "end_seconds": 191.77,
      "duration_seconds": 4.25,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.68,
      "end_seconds": 198.59,
      "duration_seconds": 4.91,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.98,
      "end_seconds": 212.8,
      "duration_seconds": 2.82,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.01,
      "end_seconds": 236.63,
      "duration_seconds": 8.62,
      "text": "Okay: blood pressure 121 over 73, respiratory rate 14, pulse 65. And And saturation 98 percent, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.51,
      "end_seconds": 241.76,
      "duration_seconds": 2.25,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.23,
      "end_seconds": 256.21,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.02,
      "end_seconds": 260.14,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.45,
      "end_seconds": 283.84,
      "duration_seconds": 7.39,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.0,
      "end_seconds": 291.8,
      "duration_seconds": 2.8,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.33,
      "end_seconds": 306.44,
      "duration_seconds": 6.11,
      "text": "okay, thinking it through, my working impression is a likely anterior cruciate ligament tear"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.06,
      "end_seconds": 314.61,
      "duration_seconds": 4.55,
      "text": "I'm, I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.82,
      "end_seconds": 332.17,
      "duration_seconds": 13.35,
      "text": "Nothing I've seen today points to an emergency. It It looks like a likely anterior cruciate ligament tear, but I'd like to confirm. Let's get an X-ray of the knee, for knee injury."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.34,
      "end_seconds": 339.79,
      "duration_seconds": 1.45,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.5,
      "end_seconds": 353.38,
      "duration_seconds": 11.88,
      "text": "Rest, ice and elevation, and use crutches until the scan. Please come and see me after the scan. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.11,
      "end_seconds": 357.23,
      "duration_seconds": 2.12,
      "text": "Alright, thanks, take care."
    }
  ]
}