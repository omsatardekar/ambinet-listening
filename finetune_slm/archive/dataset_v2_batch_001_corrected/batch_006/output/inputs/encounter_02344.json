{
  "schema_version": "1.0",
  "encounter_id": "02344",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.32,
      "duration_seconds": 4.2,
      "text": "Hmm, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 10.17,
      "duration_seconds": 4.14,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.18,
      "end_seconds": 16.53,
      "duration_seconds": 4.35,
      "text": "I'm here because of breathlessness months after the infection."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.39,
      "end_seconds": 21.22,
      "duration_seconds": 2.83,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.03,
      "end_seconds": 24.88,
      "duration_seconds": 2.85,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.65,
      "end_seconds": 31.16,
      "duration_seconds": 4.51,
      "text": "what about a racing heart on standing, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.23,
      "end_seconds": 38.69,
      "duration_seconds": 5.46,
      "text": "Yeah, that too. As for racing heart on standing, mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.66,
      "end_seconds": 41.03,
      "duration_seconds": 1.37,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.96,
      "end_seconds": 49.93,
      "duration_seconds": 3.97,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.32,
      "end_seconds": 52.5,
      "duration_seconds": 1.18,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.12,
      "end_seconds": 58.44,
      "duration_seconds": 5.32,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.5,
      "end_seconds": 61.2,
      "duration_seconds": 1.7,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.89,
      "end_seconds": 65.97,
      "duration_seconds": 4.08,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.81,
      "end_seconds": 69.95,
      "duration_seconds": 2.14,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.3,
      "end_seconds": 76.84,
      "duration_seconds": 5.54,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.95,
      "end_seconds": 79.9,
      "duration_seconds": 1.95,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.0,
      "end_seconds": 84.83,
      "duration_seconds": 3.83,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.85,
      "end_seconds": 100.81,
      "duration_seconds": 1.96,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.41,
      "end_seconds": 104.69,
      "duration_seconds": 2.28,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.66,
      "end_seconds": 107.57,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.61,
      "end_seconds": 114.85,
      "duration_seconds": 5.24,
      "text": "I've had an enlarged prostate for nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.2,
      "end_seconds": 116.98,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.09,
      "end_seconds": 120.61,
      "duration_seconds": 2.52,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.29,
      "end_seconds": 129.3,
      "duration_seconds": 8.01,
      "text": "Okay, I can see an enlarged prostate and and an underactive thyroid in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.66,
      "end_seconds": 149.64,
      "duration_seconds": 2.98,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.36,
      "end_seconds": 156.16,
      "duration_seconds": 3.8,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.38,
      "end_seconds": 159.9,
      "duration_seconds": 2.52,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.24,
      "end_seconds": 164.93,
      "duration_seconds": 3.69,
      "text": "It's Eltroxin, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.55,
      "end_seconds": 167.81,
      "duration_seconds": 2.26,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.89,
      "end_seconds": 173.89,
      "duration_seconds": 5.0,
      "text": "100 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.81,
      "end_seconds": 179.33,
      "duration_seconds": 4.52,
      "text": "let me check a few things any leg swelling or fever?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.84,
      "end_seconds": 183.19,
      "duration_seconds": 3.35,
      "text": "No, no leg swelling or fever."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 187.96,
      "duration_seconds": 4.13,
      "text": "did you get coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.93,
      "end_seconds": 195.54,
      "duration_seconds": 5.61,
      "text": "No coughing up blood or chest pain, none of it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.57,
      "end_seconds": 199.66,
      "duration_seconds": 2.09,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.62,
      "end_seconds": 205.91,
      "duration_seconds": 4.29,
      "text": "Actually, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.39,
      "end_seconds": 213.83,
      "duration_seconds": 2.44,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.84,
      "end_seconds": 223.89,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.06,
      "end_seconds": 241.64,
      "duration_seconds": 8.58,
      "text": "Okay: pressure 114 over 72, temperature 36.4, pulse 65. And saturation 99 percent, respiratory rate 15."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.71,
      "end_seconds": 244.19,
      "duration_seconds": 1.48,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.12,
      "end_seconds": 249.01,
      "duration_seconds": 2.89,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.91,
      "end_seconds": 255.38,
      "duration_seconds": 4.47,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.05,
      "end_seconds": 271.63,
      "duration_seconds": 2.58,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.1,
      "end_seconds": 275.41,
      "duration_seconds": 2.31,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.27,
      "end_seconds": 297.23,
      "duration_seconds": 5.96,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.88,
      "end_seconds": 314.09,
      "duration_seconds": 11.21,
      "text": "You can sit up now. Taking everything into account, it fits best with post-viral symptoms after COVID. It could also be anaemia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.55,
      "end_seconds": 317.7,
      "duration_seconds": 2.15,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.75,
      "end_seconds": 336.84,
      "duration_seconds": 17.09,
      "text": "It's reasonable to be concerned, but right now post-viral symptoms after COVID is my leading thought, not anything worse. We should do blood tests for post-viral fatigue. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 337.41,
      "end_seconds": 340.08,
      "duration_seconds": 2.67,
      "text": "The earliest is Monday, 9 am."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.75,
      "end_seconds": 342.65,
      "duration_seconds": 0.9,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.86,
      "end_seconds": 352.34,
      "duration_seconds": 8.48,
      "text": "I'm sending you for a chest X-ray because of persistent breathlessness pace your activity and increase it slowly each week"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.82,
      "end_seconds": 367.36,
      "duration_seconds": 14.54,
      "text": "yes, carry on. Let's get you seen by the post-COVID clinic, I'll arrange the letter. One warning sign to remember: the symptoms get worse. In that case don't wait. We'll catch up in six weeks"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.09,
      "end_seconds": 370.34,
      "duration_seconds": 2.25,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.1,
      "end_seconds": 376.65,
      "duration_seconds": 5.55,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.62,
      "end_seconds": 381.45,
      "duration_seconds": 2.83,
      "text": "Great, thank you for your help."
    }
  ]
}