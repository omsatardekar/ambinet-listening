{
  "schema_version": "1.0",
  "encounter_id": "02292",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.32,
      "end_seconds": 7.87,
      "duration_seconds": 6.55,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 13.11,
      "duration_seconds": 4.32,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.0,
      "end_seconds": 22.48,
      "duration_seconds": 7.48,
      "text": "Yeah, it's electric shock pains in my cheek. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.6,
      "end_seconds": 27.04,
      "duration_seconds": 3.44,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.12,
      "end_seconds": 38.28,
      "duration_seconds": 10.16,
      "text": "Actually, I take metoprolol, 50 milligrams, twice a day. I'm on rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 41.05,
      "duration_seconds": 2.11,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 46.41,
      "duration_seconds": 4.31,
      "text": "It's, It's been like this since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 57.48,
      "duration_seconds": 10.8,
      "text": "Yes, carry on. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.32,
      "end_seconds": 62.67,
      "duration_seconds": 3.35,
      "text": "It's all the time. It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.18,
      "end_seconds": 82.49,
      "duration_seconds": 1.31,
      "text": "Any hearing loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 86.26,
      "duration_seconds": 2.1,
      "text": "Definitely no hearing loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.39,
      "end_seconds": 89.42,
      "duration_seconds": 2.03,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.8,
      "end_seconds": 92.46,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 96.71,
      "duration_seconds": 2.42,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.88,
      "end_seconds": 100.68,
      "duration_seconds": 2.8,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.83,
      "end_seconds": 104.35,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.68,
      "end_seconds": 109.25,
      "duration_seconds": 3.57,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.2,
      "end_seconds": 112.51,
      "duration_seconds": 1.31,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.19,
      "end_seconds": 117.73,
      "duration_seconds": 3.54,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.28,
      "end_seconds": 135.0,
      "duration_seconds": 2.72,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.38,
      "end_seconds": 141.26,
      "duration_seconds": 4.88,
      "text": "I've got an irregular heartbeat. I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.32,
      "end_seconds": 149.67,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.76,
      "end_seconds": 151.79,
      "duration_seconds": 1.03,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.78,
      "end_seconds": 158.17,
      "duration_seconds": 4.39,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.48,
      "end_seconds": 163.19,
      "duration_seconds": 3.71,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 180.58,
      "end_seconds": 190.36,
      "duration_seconds": 9.78,
      "text": "Here are the numbers, doctor. Pulse 69, SpO2 98 percent on room air, pressure 111 over 72. Temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.17,
      "end_seconds": 192.87,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.12,
      "end_seconds": 199.61,
      "duration_seconds": 4.49,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.36,
      "end_seconds": 203.03,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.02,
      "end_seconds": 224.84,
      "duration_seconds": 6.82,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.18,
      "end_seconds": 238.0,
      "duration_seconds": 7.82,
      "text": "Please sit back down. Let me tell you where I've got to. It points towards trigeminal neuralgia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.09,
      "end_seconds": 242.21,
      "duration_seconds": 2.12,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 256.78,
      "duration_seconds": 13.66,
      "text": "It's reasonable to be concerned, but right now trigeminal neuralgia is my leading thought, not anything worse. Let's book an MRI scan of the head to look into facial pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.17,
      "end_seconds": 260.93,
      "duration_seconds": 2.76,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.64,
      "end_seconds": 300.79,
      "duration_seconds": 38.15,
      "text": "I'll start you on carbamazepine, 100 milligrams, twice a day, titrate. That's for nerve pain. Avoid known triggers and eat soft foods when it flares. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. The neurology clinic would be the right next step, I'll refer you. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 304.55,
      "duration_seconds": 2.39,
      "text": "See me again in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.57,
      "end_seconds": 309.33,
      "duration_seconds": 2.76,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.07,
      "end_seconds": 312.72,
      "duration_seconds": 2.65,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.71,
      "end_seconds": 318.15,
      "duration_seconds": 3.44,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.82,
      "end_seconds": 321.16,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}