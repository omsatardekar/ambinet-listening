{
  "schema_version": "1.0",
  "encounter_id": "02432",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.11,
      "duration_seconds": 2.49,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.89,
      "end_seconds": 9.09,
      "duration_seconds": 5.2,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.02,
      "end_seconds": 15.94,
      "duration_seconds": 4.92,
      "text": "It's, It's pain in my back and hips, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.41,
      "end_seconds": 19.94,
      "duration_seconds": 3.53,
      "text": "Understood. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.51,
      "end_seconds": 25.73,
      "duration_seconds": 5.22,
      "text": "Severe, really. Uh, I've also had constipation, since Friday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.61,
      "end_seconds": 28.71,
      "duration_seconds": 2.1,
      "text": "Alright, any vomiting or confusion?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.58,
      "end_seconds": 33.22,
      "duration_seconds": 3.64,
      "text": "No vomiting or confusion, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 44.09,
      "duration_seconds": 5.93,
      "text": "let me check a few things any bleeding or shortness of breath?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.06,
      "end_seconds": 50.65,
      "duration_seconds": 3.59,
      "text": "No, no bleeding or shortness of breath."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.15,
      "end_seconds": 53.56,
      "duration_seconds": 1.41,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.33,
      "end_seconds": 57.47,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.32,
      "end_seconds": 59.97,
      "duration_seconds": 1.65,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.45,
      "end_seconds": 62.37,
      "duration_seconds": 0.92,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.43,
      "end_seconds": 75.21,
      "duration_seconds": 2.78,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.86,
      "end_seconds": 85.63,
      "duration_seconds": 6.77,
      "text": "Well, I have acid reflux, for nearly five years. Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.5,
      "end_seconds": 94.32,
      "duration_seconds": 6.82,
      "text": "Alright, acid reflux and epilepsy, that matches what I have here. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.1,
      "end_seconds": 104.54,
      "duration_seconds": 8.44,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast. It's carbamazepine, 200 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 117.33,
      "duration_seconds": 2.18,
      "text": "alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.48,
      "end_seconds": 120.04,
      "duration_seconds": 1.56,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.76,
      "end_seconds": 122.54,
      "duration_seconds": 1.78,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.29,
      "end_seconds": 127.37,
      "duration_seconds": 4.08,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 133.53,
      "duration_seconds": 2.58,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.91,
      "end_seconds": 138.67,
      "duration_seconds": 3.76,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.69,
      "end_seconds": 141.91,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.79,
      "end_seconds": 146.41,
      "duration_seconds": 2.62,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.22,
      "end_seconds": 150.16,
      "duration_seconds": 2.94,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.24,
      "end_seconds": 156.02,
      "duration_seconds": 3.78,
      "text": "I had my tonsils removed as a teenager"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.83,
      "end_seconds": 159.84,
      "duration_seconds": 2.01,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.89,
      "end_seconds": 170.26,
      "duration_seconds": 2.37,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.37,
      "end_seconds": 197.71,
      "duration_seconds": 8.34,
      "text": "okay: temp 36.9 degrees, heart rate 77. And SpO2 99 percent on room air, pressure 118 over 75."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.8,
      "end_seconds": 200.29,
      "duration_seconds": 1.49,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.55,
      "end_seconds": 203.93,
      "duration_seconds": 2.38,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.2,
      "end_seconds": 207.47,
      "duration_seconds": 2.27,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.45,
      "end_seconds": 212.64,
      "duration_seconds": 3.19,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.97,
      "end_seconds": 234.47,
      "duration_seconds": 4.5,
      "text": "Your tummy is soft and you look comfortable and thin."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.36,
      "end_seconds": 251.57,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.36,
      "end_seconds": 272.83,
      "duration_seconds": 17.47,
      "text": "so, you can relax now. So where does that that leave us? This is probably cancer pain needing better control. For this, morphine sulfate modified-release, 20 milligrams, twice a day, long term. That's for cancer pain"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.26,
      "end_seconds": 276.04,
      "duration_seconds": 1.78,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.02,
      "end_seconds": 287.35,
      "duration_seconds": 9.33,
      "text": "What I'm giving you is senna, 15 milligrams, at night, long term. You take it by mouth. That should help with opioid-induced constipation."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.53,
      "end_seconds": 293.66,
      "duration_seconds": 5.13,
      "text": "Uh, can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.37,
      "end_seconds": 308.32,
      "duration_seconds": 12.95,
      "text": "Take the long-acting tablet regularly and the liquid for breakthrough pain. I'll also refer you to the palliative care team. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.12,
      "end_seconds": 311.67,
      "duration_seconds": 1.55,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.61,
      "end_seconds": 316.27,
      "duration_seconds": 2.66,
      "text": "Book a review in one week."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.17,
      "end_seconds": 322.85,
      "duration_seconds": 4.68,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.56,
      "end_seconds": 329.52,
      "duration_seconds": 4.96,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.6,
      "end_seconds": 333.46,
      "duration_seconds": 2.86,
      "text": "no, that's all. Thanks a lot"
    }
  ]
}