{
  "schema_version": "1.0",
  "encounter_id": "02312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.27,
      "duration_seconds": 3.74,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.82,
      "duration_seconds": 4.47,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.03,
      "end_seconds": 23.78,
      "duration_seconds": 9.75,
      "text": "So, I've been feeling full quickly, doctor. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.31,
      "end_seconds": 27.26,
      "duration_seconds": 1.95,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.25,
      "end_seconds": 35.16,
      "duration_seconds": 6.91,
      "text": "I, I'd say three weeks. Actually, no, closer to about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.74,
      "end_seconds": 43.17,
      "duration_seconds": 3.43,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.08,
      "end_seconds": 54.31,
      "duration_seconds": 5.23,
      "text": "It's mild, honestly. I've also had pain at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 76.98,
      "duration_seconds": 4.15,
      "text": "And what about vomiting blood, difficulty swallowing or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.89,
      "end_seconds": 87.03,
      "duration_seconds": 7.14,
      "text": "well, no vomiting blood, difficulty swallowing or weight loss, none of it"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 92.2,
      "duration_seconds": 1.61,
      "text": "How about black stools?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.16,
      "end_seconds": 96.75,
      "duration_seconds": 2.59,
      "text": "No, no black stools."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.94,
      "end_seconds": 103.31,
      "duration_seconds": 5.37,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 111.59,
      "duration_seconds": 3.27,
      "text": "um, no, nothing like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 126.59,
      "duration_seconds": 2.2,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.9,
      "end_seconds": 135.03,
      "duration_seconds": 7.13,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.95,
      "end_seconds": 139.0,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.6,
      "end_seconds": 144.46,
      "duration_seconds": 4.86,
      "text": "Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.35,
      "end_seconds": 165.58,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.51,
      "end_seconds": 174.7,
      "duration_seconds": 7.19,
      "text": "Naproxen, 250 milligrams, twice a day. Ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.26,
      "end_seconds": 179.94,
      "duration_seconds": 4.68,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.74,
      "end_seconds": 185.11,
      "duration_seconds": 4.37,
      "text": "I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.23,
      "end_seconds": 191.1,
      "duration_seconds": 4.87,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.17,
      "end_seconds": 204.9,
      "duration_seconds": 12.73,
      "text": "I swim twice a week. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 208.88,
      "duration_seconds": 2.68,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.99,
      "end_seconds": 219.77,
      "duration_seconds": 2.78,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.26,
      "end_seconds": 236.96,
      "duration_seconds": 4.7,
      "text": "Okay: pulse 73, temperature 36.4, blood pressure 124 over 71."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.52,
      "end_seconds": 240.19,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.5,
      "end_seconds": 244.0,
      "duration_seconds": 2.5,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.49,
      "end_seconds": 251.42,
      "duration_seconds": 4.93,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.08,
      "end_seconds": 254.19,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 257.37,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.02,
      "end_seconds": 272.56,
      "duration_seconds": 4.54,
      "text": "your upper tummy is tender in the middle with no guarding"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 307.47,
      "duration_seconds": 32.75,
      "text": "Good, you can sit up again. So, based on the history and the examination, it points towards a possible stomach ulcer from anti-inflammatory tablets. We shouldn't forget reflux. Let's get a stool test for helicobacter, for dyspepsia. The result will help us decide whether anything more is needed. What I'm giving you is omeprazole, 20 milligrams, once a day, eight weeks. It's for stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.95,
      "end_seconds": 311.14,
      "duration_seconds": 3.19,
      "text": "Mm-hmm. See me again in six weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.18,
      "end_seconds": 316.09,
      "duration_seconds": 2.91,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.87,
      "end_seconds": 319.22,
      "duration_seconds": 2.35,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.91,
      "end_seconds": 324.24,
      "duration_seconds": 4.33,
      "text": "Good, you know, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.83,
      "end_seconds": 326.15,
      "duration_seconds": 1.32,
      "text": "look after yourself"
    }
  ]
}