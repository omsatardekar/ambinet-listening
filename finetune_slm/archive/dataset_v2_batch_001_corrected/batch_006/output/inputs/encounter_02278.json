{
  "schema_version": "1.0",
  "encounter_id": "02278",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.03,
      "duration_seconds": 4.14,
      "text": "Hello, um, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 10.7,
      "duration_seconds": 3.89,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.8,
      "end_seconds": 20.4,
      "duration_seconds": 7.6,
      "text": "Mainly constipation then loose stools. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.21,
      "end_seconds": 26.13,
      "duration_seconds": 3.92,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 29.88,
      "duration_seconds": 1.65,
      "text": "Just since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.15,
      "end_seconds": 33.95,
      "duration_seconds": 2.8,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.96,
      "end_seconds": 38.3,
      "duration_seconds": 2.34,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 42.72,
      "duration_seconds": 2.47,
      "text": "Have you had a low fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.63,
      "end_seconds": 48.73,
      "duration_seconds": 2.1,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.81,
      "end_seconds": 54.44,
      "duration_seconds": 4.63,
      "text": "Have you noticed blood in the stool, vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.76,
      "end_seconds": 60.26,
      "duration_seconds": 2.5,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.97,
      "end_seconds": 62.75,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.33,
      "end_seconds": 67.08,
      "duration_seconds": 2.75,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.02,
      "end_seconds": 72.22,
      "duration_seconds": 4.2,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.95,
      "end_seconds": 74.91,
      "duration_seconds": 1.96,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.44,
      "end_seconds": 79.39,
      "duration_seconds": 2.95,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.42,
      "end_seconds": 82.46,
      "duration_seconds": 1.04,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.78,
      "end_seconds": 105.4,
      "duration_seconds": 4.62,
      "text": "Right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.94,
      "end_seconds": 109.65,
      "duration_seconds": 2.71,
      "text": "Ah, no, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.92,
      "end_seconds": 129.61,
      "duration_seconds": 3.69,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.15,
      "end_seconds": 134.27,
      "duration_seconds": 3.12,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.66,
      "end_seconds": 155.06,
      "duration_seconds": 4.4,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.07,
      "end_seconds": 160.52,
      "duration_seconds": 3.45,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.53,
      "end_seconds": 163.1,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.95,
      "end_seconds": 167.3,
      "duration_seconds": 2.35,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.87,
      "end_seconds": 183.44,
      "duration_seconds": 2.57,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.21,
      "end_seconds": 198.6,
      "duration_seconds": 2.39,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.18,
      "end_seconds": 227.0,
      "duration_seconds": 13.82,
      "text": "Okay: pressure 108 over 75, respiratory rate 18. And SpO2 98 percent on room air, temp 39.2 degrees, pulse 101, weight 75 kilos, height 176 centimetres."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.95,
      "end_seconds": 229.58,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.02,
      "end_seconds": 233.48,
      "duration_seconds": 2.46,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.51,
      "end_seconds": 237.97,
      "duration_seconds": 2.46,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.79,
      "end_seconds": 241.16,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.93,
      "end_seconds": 254.79,
      "duration_seconds": 4.86,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.27,
      "end_seconds": 265.47,
      "duration_seconds": 6.2,
      "text": "Good, you can sit up again. Having listened and examined, it points towards acute diverticulitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.31,
      "end_seconds": 267.99,
      "duration_seconds": 1.68,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.74,
      "end_seconds": 297.1,
      "duration_seconds": 26.36,
      "text": "I understand the worry. At the moment I'd say it's acute diverticulitis, and we'll know more once the blood tests is back. We should do blood tests for abdominal pain. That will help us see what's going on underneath and decide the next step. We'll begin with co-amoxiclav, 625 milligrams, three times a day, five days. That's for diverticulitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.73,
      "end_seconds": 300.2,
      "duration_seconds": 1.47,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.72,
      "end_seconds": 310.86,
      "duration_seconds": 10.14,
      "text": "Drink plenty and start with a light diet. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.29,
      "end_seconds": 314.22,
      "duration_seconds": 1.93,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.24,
      "end_seconds": 319.19,
      "duration_seconds": 2.95,
      "text": "Book a review in one week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.05,
      "end_seconds": 325.49,
      "duration_seconds": 4.44,
      "text": "Well, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 329.85,
      "duration_seconds": 2.58,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.4,
      "end_seconds": 333.0,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.36,
      "end_seconds": 335.55,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}