{
  "schema_version": "1.0",
  "encounter_id": "02189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 3.88,
      "duration_seconds": 2.55,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.38,
      "end_seconds": 10.84,
      "duration_seconds": 5.46,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.89,
      "end_seconds": 16.22,
      "duration_seconds": 3.33,
      "text": "okay, how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.28,
      "end_seconds": 20.89,
      "duration_seconds": 2.61,
      "text": "It's a throbbing toothache, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.38,
      "end_seconds": 25.74,
      "duration_seconds": 3.36,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.21,
      "end_seconds": 31.75,
      "duration_seconds": 4.54,
      "text": "Omeprazole 20 milligrams once a day for the reflux."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.5,
      "end_seconds": 35.91,
      "duration_seconds": 3.41,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 43.09,
      "duration_seconds": 5.36,
      "text": "Two months now i'm on paracetamol, 1 gram, when needed"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.93,
      "end_seconds": 47.04,
      "duration_seconds": 2.11,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.91,
      "end_seconds": 60.87,
      "duration_seconds": 12.96,
      "text": "About... well, one week. My neighbour said I should get it looked at. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.33,
      "end_seconds": 66.89,
      "duration_seconds": 4.56,
      "text": "okay give me more detail on it whatever comes to mind"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.92,
      "end_seconds": 94.1,
      "duration_seconds": 25.18,
      "text": "It sort of comes and goes. It's worse with hot drinks. Moderate, I'd say. I kept putting it off, which I know isn't sensible. A neighbour of mine said I should see someone about it. I've had a swollen cheek too, for about three months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.46,
      "end_seconds": 99.1,
      "duration_seconds": 4.64,
      "text": "mm, okay. What about a bad taste, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.87,
      "end_seconds": 103.19,
      "duration_seconds": 3.32,
      "text": "yeah. About a week, I'd say"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.84,
      "end_seconds": 107.64,
      "duration_seconds": 2.8,
      "text": "Has there been any eye swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.48,
      "end_seconds": 110.87,
      "duration_seconds": 2.39,
      "text": "nope, no eye swelling"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.84,
      "end_seconds": 119.1,
      "duration_seconds": 6.26,
      "text": "okay, have you had any noisy breathing, difficulty opening the mouth or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.16,
      "end_seconds": 123.86,
      "duration_seconds": 2.7,
      "text": "no not a single one"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.86,
      "end_seconds": 127.6,
      "duration_seconds": 2.74,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.55,
      "end_seconds": 130.5,
      "duration_seconds": 1.95,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.59,
      "end_seconds": 134.48,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.44,
      "end_seconds": 139.15,
      "duration_seconds": 2.71,
      "text": "No surgery, uh, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.95,
      "end_seconds": 154.63,
      "duration_seconds": 4.68,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.35,
      "end_seconds": 167.6,
      "duration_seconds": 11.25,
      "text": "I work in accounts at a hospital. I'm vegetarian and have been for years. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.25,
      "end_seconds": 173.55,
      "duration_seconds": 4.3,
      "text": "any inherited conditions that you know of in the the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.25,
      "end_seconds": 176.67,
      "duration_seconds": 2.42,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.7,
      "end_seconds": 180.1,
      "duration_seconds": 2.4,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.77,
      "end_seconds": 182.43,
      "duration_seconds": 1.66,
      "text": "yes, acid reflux"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.37,
      "end_seconds": 186.07,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 201.24,
      "duration_seconds": 2.23,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.17,
      "end_seconds": 211.02,
      "duration_seconds": 2.85,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.87,
      "end_seconds": 239.81,
      "duration_seconds": 6.94,
      "text": "Okay: temp 39.1 degrees blood pressure 123 over 77 pulse is 102 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.0,
      "end_seconds": 245.51,
      "duration_seconds": 3.51,
      "text": "could you come over to the couch please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.44,
      "end_seconds": 249.15,
      "duration_seconds": 1.71,
      "text": "Does that that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.97,
      "end_seconds": 266.76,
      "duration_seconds": 6.79,
      "text": "the lower right molar is tender with swollen gum and the cheek is puffy"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.03,
      "end_seconds": 274.48,
      "duration_seconds": 2.45,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.86,
      "end_seconds": 303.31,
      "duration_seconds": 11.45,
      "text": "stop me if I've got anything wrong you've had a throbbing toothache for one week, moderate, and no noisy breathing or difficulty opening the mouth"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.54,
      "end_seconds": 306.22,
      "duration_seconds": 1.68,
      "text": "that's it, yes"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.56,
      "end_seconds": 314.16,
      "duration_seconds": 3.6,
      "text": "we should do a dental X-ray for dental abscess"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.26,
      "end_seconds": 317.52,
      "duration_seconds": 2.26,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.6,
      "end_seconds": 342.95,
      "duration_seconds": 24.35,
      "text": "I'm prescribing amoxicillin 500 milligrams three times a day five days that's for dental abscess see the dentist today rinse with warm salt water i'll also refer you to the dentist do get help quickly if the symptoms get worse let's review you in two days that's all from me any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.71,
      "end_seconds": 348.45,
      "duration_seconds": 3.74,
      "text": "Okay that makes sense. Thanks for explaining."
    }
  ]
