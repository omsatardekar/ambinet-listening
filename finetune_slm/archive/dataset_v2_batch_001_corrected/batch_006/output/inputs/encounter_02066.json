  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 2.39,
      "duration_seconds": 1.64,
      "text": "Morning come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.2,
      "end_seconds": 5.52,
      "duration_seconds": 2.32,
      "text": "Afternoon is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 7.72,
      "duration_seconds": 1.56,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 15.84,
      "duration_seconds": 4.51,
      "text": "I'm here cos of hair loss on my shins"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 16.83,
      "end_seconds": 24.42,
      "duration_seconds": 7.59,
      "text": "okay, so the vitals from earlier temp 36.9 degrees, BP is 119 over 69. Pulse 70, respiratory rate 15."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.47,
      "end_seconds": 27.91,
      "duration_seconds": 1.44,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.73,
      "end_seconds": 43.04,
      "duration_seconds": 3.31,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.04,
      "end_seconds": 48.13,
      "duration_seconds": 4.09,
      "text": "it's been about two weeks, I'm fairly sure"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.64,
      "end_seconds": 51.68,
      "duration_seconds": 3.04,
      "text": "Have you had a slow-healing toe sore?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.06,
      "end_seconds": 63.63,
      "duration_seconds": 10.57,
      "text": "yeah that too. Cramping in my calves when I walk was there but it's gone away on its own"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.8,
      "end_seconds": 71.18,
      "duration_seconds": 6.38,
      "text": "have you had any pain at rest, back pain, chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.15,
      "end_seconds": 79.33,
      "duration_seconds": 6.18,
      "text": "no pain at rest, back pain, chest pain or fever, none of it"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.89,
      "end_seconds": 86.33,
      "duration_seconds": 5.44,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.98,
      "end_seconds": 91.05,
      "duration_seconds": 3.07,
      "text": "hmm, no, nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.8,
      "end_seconds": 94.7,
      "duration_seconds": 2.9,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.35,
      "end_seconds": 106.61,
      "duration_seconds": 11.26,
      "text": "I've had high cholesterol for nearly five years now it's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 109.27,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 112.74,
      "duration_seconds": 1.54,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.78,
      "end_seconds": 118.9,
      "duration_seconds": 5.12,
      "text": "I follow. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.46,
      "end_seconds": 122.03,
      "duration_seconds": 2.57,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.45,
      "end_seconds": 134.36,
      "duration_seconds": 4.91,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.36,
      "end_seconds": 140.38,
      "duration_seconds": 4.02,
      "text": "erm, I take rosuvastatin, 10 milligrams, at night"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 142.1,
      "end_seconds": 146.42,
      "duration_seconds": 4.32,
      "text": "Doctor our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.13,
      "end_seconds": 151.69,
      "duration_seconds": 3.56,
      "text": "hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 160.62,
      "duration_seconds": 4.14,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.15,
      "end_seconds": 177.83,
      "duration_seconds": 2.68,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.58,
      "end_seconds": 184.46,
      "duration_seconds": 4.88,
      "text": "Let me think, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.34,
      "end_seconds": 189.32,
      "duration_seconds": 3.98,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.32,
      "end_seconds": 196.22,
      "duration_seconds": 5.9,
      "text": "My aunt has rheumatoid arthritis. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.41,
      "end_seconds": 198.62,
      "duration_seconds": 1.21,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.78,
      "end_seconds": 203.07,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.02,
      "end_seconds": 205.63,
      "duration_seconds": 1.61,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.56,
      "end_seconds": 210.49,
      "duration_seconds": 3.93,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.05,
      "end_seconds": 215.83,
      "duration_seconds": 3.78,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.82,
      "end_seconds": 217.86,
      "duration_seconds": 1.04,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 220.78,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.37,
      "end_seconds": 245.24,
      "duration_seconds": 5.87,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.84,
      "end_seconds": 258.25,
      "duration_seconds": 10.41,
      "text": "all finished, thank you let me tell you where I've got to my working impression is peripheral arterial disease we shouldn't forget a nerve problem"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.86,
      "end_seconds": 262.69,
      "duration_seconds": 2.83,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.45,
      "end_seconds": 291.34,
      "duration_seconds": 24.89,
      "text": "Nothing I've seen today points to an emergency. It looks like peripheral arterial disease, but I'd like to confirm. I'd like to arrange an ultrasound of the leg arteries for claudication. I think an ankle-brachial index makes sense here, for claudication. We'll begin with clopidogrel, 75 milligrams, once a day, long term. That should help with arterial disease."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.46,
      "end_seconds": 294.02,
      "duration_seconds": 1.56,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.4,
      "end_seconds": 302.14,
      "duration_seconds": 3.74,
      "text": "I think the vascular clinic should see you too"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.09,
      "end_seconds": 306.48,
      "duration_seconds": 3.39,
      "text": "Sure you know where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.55,
      "end_seconds": 319.23,
      "duration_seconds": 8.68,
      "text": "and and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.85,
      "end_seconds": 322.89,
      "duration_seconds": 3.04,
      "text": "I know what to watch for"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.32,
      "end_seconds": 337.77,
      "duration_seconds": 13.45,
      "text": "I'm not ordering a cholesterol test today if things carry on next month, we'll consider it come back or go to emergency straight away if the symptoms get worse come back in four weeks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.59,
      "end_seconds": 341.33,
      "duration_seconds": 2.74,
      "text": "yes, um, that's manageable"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.94,
      "end_seconds": 347.3,
      "duration_seconds": 4.36,
      "text": "Right that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.08,
      "end_seconds": 352.3,
      "duration_seconds": 3.22,
      "text": "thank you, you know, that's helpful"
    }
  ]
}