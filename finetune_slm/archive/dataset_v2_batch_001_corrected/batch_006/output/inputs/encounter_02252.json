{
  "schema_version": "1.0",
  "encounter_id": "02252",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 3.3,
      "duration_seconds": 2.5,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.07,
      "end_seconds": 6.86,
      "duration_seconds": 2.79,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.44,
      "end_seconds": 12.33,
      "duration_seconds": 1.89,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.13,
      "end_seconds": 22.38,
      "duration_seconds": 8.25,
      "text": "Mainly a swollen tummy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.38,
      "end_seconds": 26.71,
      "duration_seconds": 3.33,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.77,
      "end_seconds": 39.39,
      "duration_seconds": 10.62,
      "text": "I take diclofenac, 50 milligrams, when needed. I'm on iron tablets, once a day. I take alcohol every day, daily."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 42.49,
      "duration_seconds": 2.45,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.48,
      "end_seconds": 45.58,
      "duration_seconds": 2.1,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.05,
      "end_seconds": 49.79,
      "duration_seconds": 2.74,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.5,
      "end_seconds": 53.41,
      "duration_seconds": 2.91,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.56,
      "end_seconds": 57.3,
      "duration_seconds": 2.74,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.65,
      "end_seconds": 62.43,
      "duration_seconds": 2.78,
      "text": "it feels severe to me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.26,
      "end_seconds": 65.42,
      "duration_seconds": 2.16,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.05,
      "end_seconds": 85.15,
      "duration_seconds": 19.1,
      "text": "Vomiting large amounts of fresh blood goes along with it, most of the time. Oh, and being confused. That's been about the same, about four days. About being confused, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.03,
      "end_seconds": 89.0,
      "duration_seconds": 2.97,
      "text": "Any chest pain or fever at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.92,
      "end_seconds": 95.54,
      "duration_seconds": 2.62,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 99.73,
      "duration_seconds": 3.71,
      "text": "Yes, carry on. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.49,
      "end_seconds": 103.13,
      "duration_seconds": 2.64,
      "text": "nothing there, you know, no"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.76,
      "end_seconds": 107.5,
      "duration_seconds": 3.74,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 111.43,
      "duration_seconds": 2.89,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.83,
      "end_seconds": 115.99,
      "duration_seconds": 3.16,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.69,
      "end_seconds": 122.48,
      "duration_seconds": 5.79,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.76,
      "end_seconds": 134.49,
      "duration_seconds": 2.73,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.57,
      "end_seconds": 138.31,
      "duration_seconds": 2.74,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.64,
      "end_seconds": 141.77,
      "duration_seconds": 2.13,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.38,
      "end_seconds": 148.03,
      "duration_seconds": 5.65,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.26,
      "end_seconds": 153.84,
      "duration_seconds": 4.58,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.38,
      "end_seconds": 160.64,
      "duration_seconds": 5.26,
      "text": "Arthritis in my knees, for five years. I have low haemoglobin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.53,
      "end_seconds": 171.35,
      "duration_seconds": 9.82,
      "text": "Yes, carry on. Alright, low haemoglobin, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.68,
      "end_seconds": 177.91,
      "duration_seconds": 5.23,
      "text": "yes, amoxicillin, it gives me a rash all over"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.52,
      "end_seconds": 182.76,
      "duration_seconds": 3.24,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.82,
      "end_seconds": 197.24,
      "duration_seconds": 2.42,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.7,
      "end_seconds": 224.82,
      "duration_seconds": 8.12,
      "text": "Okay: BP is 98 over 66, temp 36.5 degrees, pulse is 100 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.54,
      "end_seconds": 227.69,
      "duration_seconds": 2.15,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.66,
      "end_seconds": 232.61,
      "duration_seconds": 3.95,
      "text": "right, I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 238.88,
      "duration_seconds": 5.08,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.71,
      "end_seconds": 257.66,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.65,
      "end_seconds": 260.62,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.82,
      "end_seconds": 282.98,
      "duration_seconds": 6.16,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.9,
      "end_seconds": 299.54,
      "duration_seconds": 13.64,
      "text": "Okay, all finished, thank you. Having listened and examined, I can't pin this down yet. We're looking at a bleed from enlarged veins in the gullet in liver disease or a bleeding ulcer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.24,
      "end_seconds": 340.05,
      "duration_seconds": 29.81,
      "text": "I want urgent blood tests done, that's for major bleed. That will help us see what's going on underneath and decide the next step. For this, terlipressin, 2 milligrams, now, single dose. It's for variceal bleeding. You are going straight to resus, I am starting two drips. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.08,
      "end_seconds": 355.89,
      "duration_seconds": 14.81,
      "text": "Let's hold off on an urgent endoscopy for now, and if there's no change in two weeks we can revisit it. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.55,
      "end_seconds": 363.73,
      "duration_seconds": 6.18,
      "text": "so, I take the terlipressin, 2 milligrams, now is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.84,
      "end_seconds": 369.46,
      "duration_seconds": 4.62,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.94,
      "end_seconds": 377.23,
      "duration_seconds": 2.29,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}