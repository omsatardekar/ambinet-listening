{
  "schema_version": "1.0",
  "encounter_id": "02059",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 2.81,
      "duration_seconds": 1.75,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.82,
      "end_seconds": 8.73,
      "duration_seconds": 3.91,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.85,
      "end_seconds": 12.54,
      "duration_seconds": 2.69,
      "text": "I've been getting puffed climbing stairs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.33,
      "end_seconds": 18.01,
      "duration_seconds": 4.68,
      "text": "Did it come on recently? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.76,
      "end_seconds": 26.48,
      "duration_seconds": 7.72,
      "text": "it's been five days, I'm fairly sure i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.35,
      "end_seconds": 31.02,
      "duration_seconds": 2.67,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.82,
      "end_seconds": 34.04,
      "duration_seconds": 2.22,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.08,
      "end_seconds": 37.58,
      "duration_seconds": 2.5,
      "text": "Right, what brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.52,
      "end_seconds": 41.41,
      "duration_seconds": 2.89,
      "text": "I notice it more with stairs"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.92,
      "end_seconds": 45.64,
      "duration_seconds": 2.72,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.28,
      "end_seconds": 49.66,
      "duration_seconds": 3.38,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.63,
      "end_seconds": 58.43,
      "duration_seconds": 7.8,
      "text": "Are there any allergies I should be aware of? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.42,
      "end_seconds": 63.83,
      "duration_seconds": 3.41,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.47,
      "end_seconds": 80.26,
      "duration_seconds": 2.79,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.26,
      "end_seconds": 88.03,
      "duration_seconds": 2.77,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.6,
      "end_seconds": 99.19,
      "duration_seconds": 5.59,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.15,
      "end_seconds": 114.66,
      "duration_seconds": 13.51,
      "text": "I drink a lot of tea and snack through the day. I work in accounts at a hospital. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.91,
      "end_seconds": 126.57,
      "duration_seconds": 3.66,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.08,
      "end_seconds": 132.26,
      "duration_seconds": 5.18,
      "text": "Sorry, what was I saying, no, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.86,
      "end_seconds": 137.02,
      "duration_seconds": 4.16,
      "text": "a few quick ones: wheeze, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 142.57,
      "duration_seconds": 4.28,
      "text": "No wheeze, chest pain or fainting, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.72,
      "end_seconds": 146.08,
      "duration_seconds": 2.36,
      "text": "And palpitations, any of that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.19,
      "end_seconds": 150.02,
      "duration_seconds": 2.83,
      "text": "No, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.02,
      "end_seconds": 155.45,
      "duration_seconds": 3.43,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.19,
      "end_seconds": 159.22,
      "duration_seconds": 2.03,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.46,
      "end_seconds": 164.27,
      "duration_seconds": 3.81,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.84,
      "end_seconds": 167.37,
      "duration_seconds": 2.53,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.22,
      "end_seconds": 171.54,
      "duration_seconds": 3.32,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 186.22,
      "duration_seconds": 2.85,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.83,
      "end_seconds": 213.3,
      "duration_seconds": 10.47,
      "text": "okay: blood pressure 111 over 77, heart rate 64. And temperature 36.7, SpO2 97 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.5,
      "end_seconds": 217.35,
      "duration_seconds": 2.85,
      "text": "Okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.48,
      "end_seconds": 219.74,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.85,
      "end_seconds": 232.99,
      "duration_seconds": 6.14,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.03,
      "end_seconds": 237.88,
      "duration_seconds": 1.85,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.39,
      "end_seconds": 260.18,
      "duration_seconds": 5.79,
      "text": "okay, so my impression is this: I'd lean towards breathlessness from low fitness"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.07,
      "end_seconds": 262.93,
      "duration_seconds": 1.86,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.9,
      "end_seconds": 291.53,
      "duration_seconds": 27.63,
      "text": "I can't promise yet, but most people with breathlessness from low fitness do well once it's treated properly. I'll request a peak flow, it'll help with exertional cough. Build up to thirty minutes of brisk walking five days a week. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'll want another look in eight weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.87,
      "end_seconds": 296.87,
      "duration_seconds": 2.0,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.83,
      "end_seconds": 303.82,
      "duration_seconds": 5.99,
      "text": "How would you describe the plan, so we're on the the same page?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.48,
      "end_seconds": 309.89,
      "duration_seconds": 5.41,
      "text": "so, I come back in eight weeks is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.7,
      "end_seconds": 316.81,
      "duration_seconds": 6.11,
      "text": "yes, exactly right right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.71,
      "end_seconds": 321.71,
      "duration_seconds": 4.0,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}