{
  "schema_version": "1.0",
  "encounter_id": "02010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 5.9,
      "duration_seconds": 4.67,
      "text": "Okay, come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.95,
      "end_seconds": 9.74,
      "duration_seconds": 2.79,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.37,
      "end_seconds": 12.32,
      "duration_seconds": 1.95,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 17.79,
      "duration_seconds": 3.42,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 22.13,
      "duration_seconds": 2.9,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.82,
      "end_seconds": 26.14,
      "duration_seconds": 2.32,
      "text": "I've been feeling full quickly"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.06,
      "end_seconds": 32.13,
      "duration_seconds": 4.07,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 36.98,
      "duration_seconds": 3.84,
      "text": "It's ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.0,
      "end_seconds": 41.07,
      "duration_seconds": 2.07,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.19,
      "end_seconds": 46.01,
      "duration_seconds": 3.82,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.24,
      "end_seconds": 49.69,
      "duration_seconds": 3.45,
      "text": "yes. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 55.77,
      "duration_seconds": 4.28,
      "text": "I'd give it a five, out of ten"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.74,
      "end_seconds": 60.23,
      "duration_seconds": 2.49,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.44,
      "end_seconds": 69.27,
      "duration_seconds": 7.83,
      "text": "I mean, uh, it usually comes with indigestion. The indigestion? That's been for about four days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.84,
      "end_seconds": 77.32,
      "duration_seconds": 6.48,
      "text": "Have you had any weight loss, black stools, vomiting blood or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.39,
      "end_seconds": 81.95,
      "duration_seconds": 3.56,
      "text": "Mm, you know, none of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.69,
      "end_seconds": 86.45,
      "duration_seconds": 2.76,
      "text": "Right, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.96,
      "end_seconds": 88.64,
      "duration_seconds": 1.68,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.08,
      "end_seconds": 91.28,
      "duration_seconds": 1.2,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.89,
      "end_seconds": 93.89,
      "duration_seconds": 2.0,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.49,
      "end_seconds": 106.72,
      "duration_seconds": 4.23,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.66,
      "end_seconds": 114.55,
      "duration_seconds": 2.89,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.58,
      "end_seconds": 119.49,
      "duration_seconds": 3.91,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.44,
      "end_seconds": 125.41,
      "duration_seconds": 3.97,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.12,
      "end_seconds": 129.76,
      "duration_seconds": 2.64,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.39,
      "end_seconds": 134.42,
      "duration_seconds": 4.03,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 150.37,
      "duration_seconds": 4.0,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.27,
      "end_seconds": 155.16,
      "duration_seconds": 3.89,
      "text": "ah, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.58,
      "end_seconds": 171.9,
      "duration_seconds": 3.32,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.26,
      "end_seconds": 181.82,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.1,
      "end_seconds": 205.44,
      "duration_seconds": 8.34,
      "text": "Okay: height 162 centimetres, weight 62 kilos, pulse 75, pressure 120 over 75, respiratory rate 16."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.39,
      "end_seconds": 211.07,
      "duration_seconds": 3.68,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.89,
      "end_seconds": 213.95,
      "duration_seconds": 2.06,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.56,
      "end_seconds": 232.27,
      "duration_seconds": 4.71,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.23,
      "end_seconds": 238.66,
      "duration_seconds": 2.43,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.73,
      "end_seconds": 263.2,
      "duration_seconds": 6.47,
      "text": "Okay, thinking it through, it points towards a possible stomach ulcer from anti-inflammatory tablets."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.84,
      "end_seconds": 267.41,
      "duration_seconds": 3.57,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.33,
      "end_seconds": 302.04,
      "duration_seconds": 32.71,
      "text": "I understand the worry. At the moment I'd say it's a possible stomach ulcer from anti-inflammatory tablets, and and we'll know more once the a stool test for helicobacter is back. I think a stool test for helicobacter makes sense here, for dyspepsia. I'll start you on omeprazole, 20 milligrams, once a day, eight weeks. That's for stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead. See me again in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.38,
      "end_seconds": 307.27,
      "duration_seconds": 3.89,
      "text": "oh, uh, alright, I'll be back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.28,
      "end_seconds": 312.85,
      "duration_seconds": 3.57,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.11,
      "end_seconds": 318.87,
      "duration_seconds": 2.76,
      "text": "I think I understand everything. Thanks."
    }
  ]
}