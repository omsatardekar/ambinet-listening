{
  "schema_version": "1.0",
  "encounter_id": "02017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 7.74,
      "duration_seconds": 6.53,
      "text": "Hello doctor, um, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.18,
      "end_seconds": 12.84,
      "duration_seconds": 3.66,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.3,
      "end_seconds": 19.15,
      "duration_seconds": 4.85,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.31,
      "end_seconds": 22.8,
      "duration_seconds": 2.49,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 31.5,
      "duration_seconds": 6.89,
      "text": "so the thing is, I've got sudden severe pain in the left testicle"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.97,
      "end_seconds": 35.99,
      "duration_seconds": 3.02,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.76,
      "end_seconds": 46.12,
      "duration_seconds": 8.36,
      "text": "It's Tiotropium inhaler, once a day for my chest. It's glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 47.16,
      "end_seconds": 56.56,
      "duration_seconds": 9.4,
      "text": "Doctor, I think the last prescription for the glibenclamide was 2.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.62,
      "end_seconds": 63.97,
      "duration_seconds": 5.35,
      "text": "okay have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.4,
      "end_seconds": 73.24,
      "duration_seconds": 3.84,
      "text": "I don't think I have it with me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.23,
      "end_seconds": 77.18,
      "duration_seconds": 1.95,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.47,
      "end_seconds": 89.84,
      "duration_seconds": 11.37,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.29,
      "end_seconds": 93.33,
      "duration_seconds": 2.04,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.37,
      "end_seconds": 98.41,
      "duration_seconds": 3.04,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.95,
      "end_seconds": 106.77,
      "duration_seconds": 2.82,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.0,
      "end_seconds": 117.06,
      "duration_seconds": 9.06,
      "text": "A swollen scrotum goes along with it, most of the time. With swollen scrotum, I'd say severe."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.59,
      "end_seconds": 120.96,
      "duration_seconds": 2.37,
      "text": "have you been feeling sick?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.91,
      "end_seconds": 124.74,
      "duration_seconds": 2.83,
      "text": "Actually, yes, for five days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.89,
      "end_seconds": 130.94,
      "duration_seconds": 5.05,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.77,
      "end_seconds": 141.78,
      "duration_seconds": 10.01,
      "text": "It happens a few times a day. Hmm, I've also had pain going up to the tummy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.35,
      "end_seconds": 153.06,
      "duration_seconds": 3.71,
      "text": "And what about burning when passing urine or injury?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 156.56,
      "duration_seconds": 1.96,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.67,
      "end_seconds": 160.63,
      "duration_seconds": 2.96,
      "text": "And what about discharge or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.15,
      "end_seconds": 165.9,
      "duration_seconds": 4.75,
      "text": "Sorry, what was I saying, none of those, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.0,
      "end_seconds": 170.58,
      "duration_seconds": 3.58,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.16,
      "end_seconds": 174.06,
      "duration_seconds": 1.9,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.69,
      "end_seconds": 177.96,
      "duration_seconds": 2.27,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.64,
      "end_seconds": 179.61,
      "duration_seconds": 0.97,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.38,
      "end_seconds": 189.29,
      "duration_seconds": 7.91,
      "text": "Anything in your past medical history I should know? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.29,
      "end_seconds": 198.15,
      "duration_seconds": 3.86,
      "text": "I have COPD, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.0,
      "end_seconds": 200.7,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.63,
      "end_seconds": 204.89,
      "duration_seconds": 2.26,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.57,
      "end_seconds": 213.47,
      "duration_seconds": 6.9,
      "text": "sure. Okay, I can see COPD in your file as well. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.28,
      "end_seconds": 222.83,
      "duration_seconds": 7.55,
      "text": "yes, I had a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.73,
      "end_seconds": 235.13,
      "duration_seconds": 3.4,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.95,
      "end_seconds": 240.81,
      "duration_seconds": 3.86,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.42,
      "end_seconds": 245.39,
      "duration_seconds": 3.97,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.82,
      "end_seconds": 261.59,
      "duration_seconds": 14.77,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I walk the dog every morning. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 274.13,
      "duration_seconds": 3.66,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.56,
      "end_seconds": 279.2,
      "duration_seconds": 3.64,
      "text": "My son has asthma. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.07,
      "end_seconds": 284.76,
      "duration_seconds": 3.69,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.94,
      "end_seconds": 289.75,
      "duration_seconds": 3.81,
      "text": "Right, stay as you are for a a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.67,
      "end_seconds": 311.68,
      "duration_seconds": 7.01,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.97,
      "end_seconds": 315.52,
      "duration_seconds": 1.55,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.89,
      "end_seconds": 341.87,
      "duration_seconds": 23.98,
      "text": "that's all I needed to check okay, thinking it through, the most likely explanation is testicular torsion needing emergency surgery an epididymitis is still possible i'm going to send a referral to the urology team and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.74,
      "end_seconds": 345.38,
      "duration_seconds": 1.64,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.66,
      "end_seconds": 349.44,
      "duration_seconds": 2.78,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.73,
      "end_seconds": 356.32,
      "duration_seconds": 3.59,
      "text": "right, I'll do that thank you, doctor"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.0,
      "end_seconds": 358.3,
      "duration_seconds": 1.3,
      "text": "All the best."
    }
  ]
}