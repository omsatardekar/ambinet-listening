{
  "schema_version": "1.0",
  "encounter_id": "02109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 2.81,
      "duration_seconds": 1.93,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.86,
      "end_seconds": 4.97,
      "duration_seconds": 1.11,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 9.72,
      "duration_seconds": 3.29,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.24,
      "end_seconds": 16.54,
      "duration_seconds": 5.3,
      "text": "Um, so... a throbbing toothache. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.92,
      "end_seconds": 21.48,
      "duration_seconds": 3.56,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.43,
      "end_seconds": 26.08,
      "duration_seconds": 2.65,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.94,
      "end_seconds": 36.99,
      "duration_seconds": 9.05,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.15,
      "end_seconds": 46.2,
      "duration_seconds": 8.05,
      "text": "Let me think, yes, hot drinks. That makes it worse. It's once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.25,
      "end_seconds": 50.2,
      "duration_seconds": 2.95,
      "text": "Any a swollen cheek as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.91,
      "end_seconds": 59.37,
      "duration_seconds": 8.46,
      "text": "Yeah, um, I've had that since Monday. As for swollen cheek, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.28,
      "end_seconds": 65.0,
      "duration_seconds": 3.72,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.31,
      "end_seconds": 74.8,
      "duration_seconds": 8.49,
      "text": "Hydrocortisone cream. I take it when needed for the eczema. I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.11,
      "end_seconds": 78.61,
      "duration_seconds": 2.5,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.51,
      "end_seconds": 83.53,
      "duration_seconds": 4.02,
      "text": "Yes, milk, it gives me stomach cramps."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.05,
      "end_seconds": 86.8,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.78,
      "end_seconds": 91.45,
      "duration_seconds": 2.67,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.34,
      "end_seconds": 99.12,
      "duration_seconds": 3.78,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.92,
      "end_seconds": 103.26,
      "duration_seconds": 3.34,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.93,
      "end_seconds": 106.83,
      "duration_seconds": 2.9,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.72,
      "end_seconds": 112.81,
      "duration_seconds": 5.09,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.46,
      "end_seconds": 116.18,
      "duration_seconds": 2.72,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.57,
      "end_seconds": 119.12,
      "duration_seconds": 1.55,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.74,
      "end_seconds": 120.7,
      "duration_seconds": 0.96,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.85,
      "end_seconds": 145.21,
      "duration_seconds": 6.36,
      "text": "Have you noticed eye swelling, noisy breathing, difficulty opening the mouth or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.14,
      "end_seconds": 156.77,
      "duration_seconds": 9.63,
      "text": "Sorry, what was I saying, I haven't had eye swelling, noisy breathing, difficulty opening the mouth or difficulty swallowing, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.22,
      "end_seconds": 165.33,
      "duration_seconds": 3.11,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 169.08,
      "duration_seconds": 2.45,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.72,
      "end_seconds": 172.28,
      "duration_seconds": 1.56,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.02,
      "end_seconds": 174.99,
      "duration_seconds": 1.97,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.0,
      "end_seconds": 185.85,
      "duration_seconds": 3.85,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.04,
      "end_seconds": 196.42,
      "duration_seconds": 2.38,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.81,
      "end_seconds": 222.02,
      "duration_seconds": 10.21,
      "text": "Okay: oxygen saturation is 96 percent, temperature is 39.2 degrees. And pulse is 96 beats a minute, BP is 104 over 71."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.76,
      "end_seconds": 228.33,
      "duration_seconds": 3.57,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.93,
      "end_seconds": 233.18,
      "duration_seconds": 3.25,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.02,
      "end_seconds": 252.46,
      "duration_seconds": 5.44,
      "text": "The lower right molar is tender with swollen gum and the cheek is puffy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.51,
      "end_seconds": 256.57,
      "duration_seconds": 2.06,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.97,
      "end_seconds": 306.14,
      "duration_seconds": 31.17,
      "text": "Let me tell you where I've got to. I'd lean towards a dental abscess. We shouldn't forget a salivary gland infection. Let's book a dental X-ray to look into dental abscess. The result will help us decide whether anything more is needed. We'll begin with amoxicillin, 500 milligrams, three times a day, five days. That's for dental abscess. See the dentist today, rinse with warm salt water. The dentist would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.49,
      "end_seconds": 312.77,
      "duration_seconds": 2.28,
      "text": "Come back in two days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.32,
      "end_seconds": 316.94,
      "duration_seconds": 3.62,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.29,
      "end_seconds": 322.92,
      "duration_seconds": 4.63,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.09,
      "end_seconds": 327.09,
      "duration_seconds": 3.0,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}