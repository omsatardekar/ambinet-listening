{
  "schema_version": "1.0",
  "encounter_id": "02404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 8.26,
      "duration_seconds": 7.66,
      "text": "Hello doctor, uh, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.18,
      "end_seconds": 14.1,
      "duration_seconds": 3.92,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.47,
      "end_seconds": 21.81,
      "duration_seconds": 6.34,
      "text": "Um, so... a pop at the time. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 22.37,
      "end_seconds": 32.65,
      "duration_seconds": 10.28,
      "text": "Okay, so the vitals from earlier. Temp 36.9 degrees, pulse is 80 beats a minute, oxygen saturation is 98 percent. Pressure 122 over 70."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.53,
      "end_seconds": 38.21,
      "duration_seconds": 4.68,
      "text": "Okay, noted. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.29,
      "end_seconds": 42.69,
      "duration_seconds": 2.4,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.26,
      "end_seconds": 46.15,
      "duration_seconds": 2.89,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.48,
      "end_seconds": 53.08,
      "duration_seconds": 5.6,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.65,
      "end_seconds": 57.44,
      "duration_seconds": 2.79,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.57,
      "end_seconds": 68.38,
      "duration_seconds": 9.81,
      "text": "It usually comes with swelling within hours. The swelling within hours? That's been for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 72.0,
      "duration_seconds": 2.71,
      "text": "Have you had any locked knee?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.44,
      "end_seconds": 75.9,
      "duration_seconds": 2.46,
      "text": "Nope, no locked knee."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.19,
      "end_seconds": 81.65,
      "duration_seconds": 4.46,
      "text": "Have you had any fever, calf pain or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.47,
      "end_seconds": 86.2,
      "duration_seconds": 3.73,
      "text": "Ah, no, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.14,
      "end_seconds": 90.19,
      "duration_seconds": 2.05,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.1,
      "end_seconds": 94.19,
      "duration_seconds": 3.09,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.03,
      "end_seconds": 100.08,
      "duration_seconds": 4.05,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 103.84,
      "duration_seconds": 2.76,
      "text": "Oh, no weakness or anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.18,
      "end_seconds": 114.13,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.27,
      "end_seconds": 118.39,
      "duration_seconds": 3.12,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.9,
      "end_seconds": 121.67,
      "duration_seconds": 2.77,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.76,
      "end_seconds": 127.38,
      "duration_seconds": 3.62,
      "text": "Ibuprofen, 400 milligrams, maybe, with food."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.86,
      "end_seconds": 135.7,
      "duration_seconds": 4.84,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.57,
      "end_seconds": 140.98,
      "duration_seconds": 3.41,
      "text": "Hmm, no, it's at home."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 152.1,
      "duration_seconds": 2.93,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.37,
      "end_seconds": 161.86,
      "duration_seconds": 8.49,
      "text": "Right, uh, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.92,
      "end_seconds": 167.3,
      "duration_seconds": 4.38,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.52,
      "end_seconds": 171.71,
      "duration_seconds": 3.19,
      "text": "Thin bones, for two years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.6,
      "end_seconds": 173.3,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 184.44,
      "duration_seconds": 10.11,
      "text": "Let me think, I have high blood pressure. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.27,
      "end_seconds": 193.66,
      "duration_seconds": 7.39,
      "text": "Yes. Yes, thin bones and high blood pressure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.75,
      "end_seconds": 212.9,
      "duration_seconds": 4.15,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.87,
      "end_seconds": 231.64,
      "duration_seconds": 17.77,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I walk the dog every morning. I look after my grandchildren most days. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.49,
      "end_seconds": 239.9,
      "duration_seconds": 5.41,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.53,
      "end_seconds": 242.3,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.33,
      "end_seconds": 245.36,
      "duration_seconds": 2.03,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.17,
      "end_seconds": 269.63,
      "duration_seconds": 8.46,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.54,
      "end_seconds": 275.29,
      "duration_seconds": 1.75,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.84,
      "end_seconds": 299.12,
      "duration_seconds": 19.28,
      "text": "Thank you, you can get dressed. Okay, thinking it through, it's hard to say. A likely anterior cruciate ligament tear is one possibility and a meniscal tear another, and I'd rather not commit yet. I'm going to order an MRI of the knee, for knee injury."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.21,
      "end_seconds": 303.65,
      "duration_seconds": 2.44,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 315.57,
      "duration_seconds": 10.88,
      "text": "Let's get an X-ray of the knee, for knee injury. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.09,
      "end_seconds": 319.14,
      "duration_seconds": 3.05,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.91,
      "end_seconds": 333.93,
      "duration_seconds": 13.02,
      "text": "Rest, ice and elevation, and use crutches until the scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.24,
      "end_seconds": 337.82,
      "duration_seconds": 2.58,
      "text": "Yes, uh, will do."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.33,
      "end_seconds": 343.1,
      "duration_seconds": 4.77,
      "text": "Let's review you after the scan. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.12,
      "end_seconds": 353.76,
      "duration_seconds": 4.64,
      "text": "Um, uh, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.01,
      "end_seconds": 356.38,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}