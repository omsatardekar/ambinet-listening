{
  "schema_version": "1.0",
  "encounter_id": "02396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.22,
      "duration_seconds": 3.42,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.4,
      "end_seconds": 9.45,
      "duration_seconds": 4.05,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.53,
      "end_seconds": 17.59,
      "duration_seconds": 6.06,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.5,
      "end_seconds": 21.87,
      "duration_seconds": 3.37,
      "text": "So, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.47,
      "end_seconds": 32.62,
      "duration_seconds": 9.15,
      "text": "Mainly a shaky feeling in my hands. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.41,
      "end_seconds": 37.58,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.86,
      "end_seconds": 48.47,
      "duration_seconds": 9.61,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain. I take metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.1,
      "end_seconds": 53.04,
      "duration_seconds": 2.94,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.96,
      "end_seconds": 62.47,
      "duration_seconds": 7.51,
      "text": "So, no, it's at home. Before this I was on bisoprolol; that's been stopped."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.78,
      "end_seconds": 81.07,
      "duration_seconds": 3.29,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.65,
      "end_seconds": 84.59,
      "duration_seconds": 1.94,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.09,
      "end_seconds": 86.79,
      "duration_seconds": 1.7,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.31,
      "end_seconds": 90.62,
      "duration_seconds": 3.31,
      "text": "It, It settles a little with resting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.75,
      "end_seconds": 95.48,
      "duration_seconds": 3.73,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.44,
      "end_seconds": 99.69,
      "duration_seconds": 2.25,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.45,
      "end_seconds": 103.96,
      "duration_seconds": 2.51,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.81,
      "end_seconds": 107.57,
      "duration_seconds": 2.76,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.42,
      "end_seconds": 111.38,
      "duration_seconds": 1.96,
      "text": "Have you had sweaty palms?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.24,
      "end_seconds": 121.39,
      "duration_seconds": 9.15,
      "text": "Yes, actually. About sweaty palms, I'd give it a eight, out of ten. Oh, and butterflies in my stomach."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.73,
      "end_seconds": 126.76,
      "duration_seconds": 4.03,
      "text": "And what about weight loss, fainting, palpitations or weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.2,
      "end_seconds": 130.41,
      "duration_seconds": 2.21,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.29,
      "end_seconds": 135.64,
      "duration_seconds": 3.35,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.29,
      "end_seconds": 137.73,
      "duration_seconds": 1.44,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.96,
      "end_seconds": 141.49,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.02,
      "end_seconds": 145.32,
      "duration_seconds": 3.3,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.09,
      "end_seconds": 150.38,
      "duration_seconds": 3.29,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.36,
      "end_seconds": 154.86,
      "duration_seconds": 2.5,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 169.28,
      "duration_seconds": 5.44,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.12,
      "end_seconds": 181.94,
      "duration_seconds": 10.82,
      "text": "No, I share a house with my brother. Lots of rice, lentils and some fruit. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.93,
      "end_seconds": 186.59,
      "duration_seconds": 3.66,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.13,
      "end_seconds": 195.55,
      "duration_seconds": 7.42,
      "text": "I've had arthritis in my knees, yes. I have an irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 197.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.31,
      "end_seconds": 200.27,
      "duration_seconds": 1.96,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.21,
      "end_seconds": 208.84,
      "duration_seconds": 7.63,
      "text": "Okay, I can see heart failure in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.28,
      "end_seconds": 211.78,
      "duration_seconds": 1.5,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.77,
      "end_seconds": 216.63,
      "duration_seconds": 2.86,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 232.71,
      "duration_seconds": 2.86,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.74,
      "end_seconds": 255.17,
      "duration_seconds": 9.43,
      "text": "Okay: temperature 36.7, saturation 99 percent. And respiratory rate 18, pulse is 66 beats a minute, blood pressure 109 over 72."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.24,
      "end_seconds": 260.47,
      "duration_seconds": 4.23,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.49,
      "end_seconds": 263.99,
      "duration_seconds": 1.5,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.34,
      "end_seconds": 266.61,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.1,
      "end_seconds": 287.02,
      "duration_seconds": 5.92,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.26,
      "end_seconds": 291.22,
      "duration_seconds": 1.96,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.09,
      "end_seconds": 333.74,
      "duration_seconds": 34.65,
      "text": "So where does that leave us? This is probably an anxiety or caffeine-related tremor. I want to be honest that this is an impression, not a final answer. An overactive thyroid is still possible. Cut down caffeine and try slow breathing when it starts. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.03,
      "end_seconds": 338.88,
      "duration_seconds": 2.85,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.98,
      "end_seconds": 343.16,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    }
  ]
}