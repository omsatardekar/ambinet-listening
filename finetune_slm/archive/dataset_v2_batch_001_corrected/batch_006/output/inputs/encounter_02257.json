{
  "schema_version": "1.0",
  "encounter_id": "02257",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.72,
      "duration_seconds": 4.47,
      "text": "Hello, uh, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 10.36,
      "duration_seconds": 4.14,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.96,
      "end_seconds": 22.69,
      "duration_seconds": 11.73,
      "text": "Mm, uh, honestly, it's a knee that gave way playing football, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.63,
      "end_seconds": 28.7,
      "duration_seconds": 4.07,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 38.99,
      "duration_seconds": 2.55,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.21,
      "end_seconds": 64.53,
      "duration_seconds": 10.32,
      "text": "Okay: pulse is 86 beats a minute, blood pressure 118 over 74, saturation 98 percent. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.53,
      "end_seconds": 68.12,
      "duration_seconds": 2.59,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.45,
      "end_seconds": 73.4,
      "duration_seconds": 3.95,
      "text": "Okay, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.42,
      "end_seconds": 81.32,
      "duration_seconds": 5.9,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.14,
      "end_seconds": 88.87,
      "duration_seconds": 5.73,
      "text": "Okay, what about a pop at the time, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.41,
      "end_seconds": 93.85,
      "duration_seconds": 4.44,
      "text": "Yes, uh, about the same, three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.5,
      "end_seconds": 100.6,
      "duration_seconds": 6.1,
      "text": "Okay, what about not being able to straighten it fully, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.98,
      "end_seconds": 110.73,
      "duration_seconds": 8.75,
      "text": "Yes, for three days. Okay, so with not being able to straighten it fully, moderate, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.44,
      "end_seconds": 117.82,
      "duration_seconds": 5.38,
      "text": "A few quick ones: fever, locked knee, calf pain or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.34,
      "end_seconds": 122.08,
      "duration_seconds": 2.74,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 126.51,
      "duration_seconds": 2.87,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.58,
      "end_seconds": 128.61,
      "duration_seconds": 1.03,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.63,
      "end_seconds": 134.3,
      "duration_seconds": 3.67,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.95,
      "end_seconds": 140.21,
      "duration_seconds": 2.26,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.04,
      "end_seconds": 145.17,
      "duration_seconds": 3.13,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 150.63,
      "duration_seconds": 4.79,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.36,
      "end_seconds": 157.53,
      "duration_seconds": 5.17,
      "text": "Alright, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.29,
      "end_seconds": 160.75,
      "duration_seconds": 1.46,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.39,
      "end_seconds": 170.98,
      "duration_seconds": 8.59,
      "text": "Okay, go on. Right, so gout is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.89,
      "end_seconds": 188.28,
      "duration_seconds": 2.39,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.4,
      "end_seconds": 192.34,
      "duration_seconds": 2.94,
      "text": "I'm on ibuprofen, with food."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.14,
      "end_seconds": 195.14,
      "duration_seconds": 2.0,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.67,
      "end_seconds": 197.64,
      "duration_seconds": 0.97,
      "text": "400 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.22,
      "end_seconds": 199.29,
      "duration_seconds": 1.07,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 213.46,
      "duration_seconds": 3.13,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.49,
      "end_seconds": 237.59,
      "duration_seconds": 23.1,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I walk the dog every morning. I retired from the post office two years ago. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.34,
      "end_seconds": 243.47,
      "duration_seconds": 4.13,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.09,
      "end_seconds": 246.13,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 249.95,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.7,
      "end_seconds": 262.4,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.64,
      "end_seconds": 266.14,
      "duration_seconds": 2.5,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.26,
      "end_seconds": 288.8,
      "duration_seconds": 7.54,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.93,
      "end_seconds": 324.53,
      "duration_seconds": 32.6,
      "text": "That's the examination finished. Taking everything into account, I think we're dealing with a likely anterior cruciate ligament tear at this stage. I'd like to arrange an MRI of the knee for knee injury. It's a routine test and it'll give us a much clearer picture. Let's book an X-ray of the knee to look into knee injury. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.53,
      "end_seconds": 334.98,
      "duration_seconds": 8.45,
      "text": "Rest, ice and elevation, and use crutches until the scan. We'll refer you to the sports injury clinic."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.0,
      "end_seconds": 336.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.34,
      "end_seconds": 347.88,
      "duration_seconds": 10.54,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back after the scan."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.6,
      "end_seconds": 357.15,
      "duration_seconds": 7.55,
      "text": "Sorry, what was I saying, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.83,
      "end_seconds": 361.33,
      "duration_seconds": 2.5,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.49,
      "end_seconds": 367.81,
      "duration_seconds": 3.32,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.94,
      "end_seconds": 370.2,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}