{
  "schema_version": "1.0",
  "encounter_id": "02262",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.99,
      "duration_seconds": 4.44,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 11.09,
      "duration_seconds": 4.64,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 17.43,
      "duration_seconds": 5.76,
      "text": "It's extreme tiredness. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.52,
      "end_seconds": 22.05,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.74,
      "end_seconds": 34.09,
      "duration_seconds": 2.35,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 57.09,
      "duration_seconds": 11.32,
      "text": "Okay: temperature is 37.0 degrees, pulse 72, respiratory rate 15, pressure 121 over 79, oxygen saturation is 99 percent. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 70.44,
      "duration_seconds": 12.65,
      "text": "I've had it for four weeks. There's breathlessness months after the infection as well. I did have brain fog at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.32,
      "end_seconds": 76.63,
      "duration_seconds": 5.31,
      "text": "Have you had extreme tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.16,
      "end_seconds": 83.97,
      "duration_seconds": 5.81,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.51,
      "end_seconds": 89.19,
      "duration_seconds": 4.68,
      "text": "Any leg swelling, coughing up blood, fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.0,
      "end_seconds": 94.25,
      "duration_seconds": 3.25,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.3,
      "end_seconds": 97.27,
      "duration_seconds": 1.97,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.91,
      "end_seconds": 99.59,
      "duration_seconds": 1.68,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.72,
      "end_seconds": 104.11,
      "duration_seconds": 3.39,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.71,
      "end_seconds": 106.08,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.68,
      "end_seconds": 110.35,
      "duration_seconds": 2.67,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.68,
      "end_seconds": 117.24,
      "duration_seconds": 5.56,
      "text": "It's something called para... paracetamol, 650 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 123.42,
      "duration_seconds": 4.69,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.98,
      "end_seconds": 126.15,
      "duration_seconds": 2.17,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.59,
      "end_seconds": 131.55,
      "duration_seconds": 3.96,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.08,
      "end_seconds": 135.76,
      "duration_seconds": 2.68,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.33,
      "end_seconds": 143.28,
      "duration_seconds": 5.95,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.99,
      "end_seconds": 162.45,
      "duration_seconds": 2.46,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.06,
      "end_seconds": 166.69,
      "duration_seconds": 3.63,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.61,
      "end_seconds": 170.49,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.2,
      "end_seconds": 174.65,
      "duration_seconds": 2.45,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.21,
      "end_seconds": 184.11,
      "duration_seconds": 8.9,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.62,
      "end_seconds": 187.69,
      "duration_seconds": 3.07,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.92,
      "end_seconds": 193.19,
      "duration_seconds": 4.27,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.56,
      "end_seconds": 197.18,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.17,
      "end_seconds": 221.73,
      "duration_seconds": 5.56,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.69,
      "end_seconds": 224.92,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.92,
      "end_seconds": 232.02,
      "duration_seconds": 3.1,
      "text": "So, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.36,
      "end_seconds": 255.96,
      "duration_seconds": 11.6,
      "text": "From what you've told me and what I found, I'd lean towards post-viral symptoms after COVID. A thyroid problem is also on my list."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.67,
      "end_seconds": 258.75,
      "duration_seconds": 2.08,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 267.46,
      "duration_seconds": 6.66,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral symptoms after COVID."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.76,
      "end_seconds": 293.51,
      "duration_seconds": 18.75,
      "text": "Pace your activity and increase it slowly each week. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.21,
      "end_seconds": 297.6,
      "duration_seconds": 3.39,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.68,
      "end_seconds": 301.1,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}