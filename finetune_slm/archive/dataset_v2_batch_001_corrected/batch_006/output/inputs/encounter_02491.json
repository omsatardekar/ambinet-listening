{
  "schema_version": "1.0",
  "encounter_id": "02491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 10.7,
      "duration_seconds": 9.37,
      "text": "Let me think, you know, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.96,
      "end_seconds": 16.14,
      "duration_seconds": 4.18,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.07,
      "end_seconds": 23.61,
      "duration_seconds": 6.54,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.12,
      "end_seconds": 43.64,
      "duration_seconds": 14.52,
      "text": "Uh, uh, mainly yellow eyes. There's a couple of other things, but that's the main one. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.72,
      "end_seconds": 49.08,
      "duration_seconds": 3.36,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.22,
      "end_seconds": 60.51,
      "duration_seconds": 10.29,
      "text": "I've, I've had it for three weeks. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.55,
      "end_seconds": 64.43,
      "duration_seconds": 2.88,
      "text": "Has there been pale stools too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.32,
      "end_seconds": 70.41,
      "duration_seconds": 4.09,
      "text": "Yes, since Friday. And dark urine, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.07,
      "end_seconds": 73.42,
      "duration_seconds": 1.35,
      "text": "What about confusion?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.84,
      "end_seconds": 77.28,
      "duration_seconds": 2.44,
      "text": "I haven't noticed any confusion."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.37,
      "end_seconds": 83.48,
      "duration_seconds": 4.11,
      "text": "And what about itching, high fever or vomiting blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.42,
      "end_seconds": 88.16,
      "duration_seconds": 3.74,
      "text": "No, um, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.14,
      "end_seconds": 93.81,
      "duration_seconds": 3.67,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.11,
      "end_seconds": 97.69,
      "duration_seconds": 2.58,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.28,
      "end_seconds": 114.34,
      "duration_seconds": 4.06,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.06,
      "end_seconds": 125.82,
      "duration_seconds": 5.76,
      "text": "Sorry, what was I saying, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.62,
      "end_seconds": 131.3,
      "duration_seconds": 3.68,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.17,
      "end_seconds": 138.35,
      "duration_seconds": 2.18,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 143.36,
      "duration_seconds": 3.68,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 144.87,
      "end_seconds": 163.85,
      "duration_seconds": 18.98,
      "text": "Let me think, she is on bisoprolol, 2.5 milligrams, once a day for the heart rhythm, I give it to her. She is on allopurinol, 100 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.7,
      "end_seconds": 181.97,
      "duration_seconds": 3.27,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.44,
      "end_seconds": 190.48,
      "duration_seconds": 7.04,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 193.75,
      "duration_seconds": 2.46,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.78,
      "end_seconds": 211.16,
      "duration_seconds": 16.38,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. Lots of rice, lentils and some fruit. I hardly move around during the day. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.42,
      "end_seconds": 225.35,
      "duration_seconds": 2.93,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.15,
      "end_seconds": 234.72,
      "duration_seconds": 5.57,
      "text": "Right, I've had an irregular heartbeat for about a year now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.67,
      "end_seconds": 237.61,
      "duration_seconds": 0.94,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.67,
      "end_seconds": 241.09,
      "duration_seconds": 2.42,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.8,
      "end_seconds": 250.83,
      "duration_seconds": 8.03,
      "text": "Okay, I can see an irregular heartbeat and gout in your file as well. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.56,
      "end_seconds": 262.02,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.37,
      "end_seconds": 280.84,
      "duration_seconds": 8.47,
      "text": "Okay: temperature 36.9, blood pressure 114 over 75, pulse 65, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.78,
      "end_seconds": 286.66,
      "duration_seconds": 3.88,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.3,
      "end_seconds": 291.88,
      "duration_seconds": 3.58,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.15,
      "end_seconds": 296.18,
      "duration_seconds": 2.03,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.61,
      "end_seconds": 300.82,
      "duration_seconds": 3.21,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.64,
      "end_seconds": 315.85,
      "duration_seconds": 5.21,
      "text": "The whites of the eyes are yellow and the liver edge is tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.3,
      "end_seconds": 327.83,
      "duration_seconds": 8.53,
      "text": "You can sit up now. So where does that leave us? It points towards acute hepatitis, possibly hepatitis A after travel."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.39,
      "end_seconds": 334.81,
      "duration_seconds": 3.42,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.42,
      "end_seconds": 366.1,
      "duration_seconds": 30.68,
      "text": "It's reasonable to be concerned, but right now acute hepatitis, possibly hepatitis A after travel is my leading thought, not anything worse. I think a hepatitis screen makes sense here, for jaundice. Rest, avoid alcohol and wash your hands carefully, as it can spread. Please take the tablets with food so they don't upset your stomach. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.22,
      "end_seconds": 374.98,
      "duration_seconds": 7.76,
      "text": "I'll want another look in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.98,
      "end_seconds": 377.86,
      "duration_seconds": 1.88,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.0,
      "end_seconds": 380.2,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}