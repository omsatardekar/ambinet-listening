    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 325.32,
      "duration_seconds": 23.8,
      "text": "Okay, so my impression is this: My working impression is eczema with a bacterial skin infection. That's my thinking for now, and it may change as we learn more. I can't rule out herpes simplex eczema yet. I think a skin swab makes sense here, for infected eczema."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_6",
