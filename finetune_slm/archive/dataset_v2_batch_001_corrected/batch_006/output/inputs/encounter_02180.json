      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.14,
      "end_seconds": 277.07,
      "duration_seconds": 5.93,
      "text": "The eczema patches on the arms have yellow crusts and weeping areas"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.9,
      "end_seconds": 284.87,
      "duration_seconds": 1.97,
      "text": "You can sit up now."
