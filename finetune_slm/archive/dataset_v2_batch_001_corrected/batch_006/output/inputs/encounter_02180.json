      "role": "NURSE",
      "start_seconds": 233.52,
      "end_seconds": 244.98,
      "duration_seconds": 11.46,
      "text": "okay, so the vitals from earlier respiratory rate 17, pressure 113 over 68, heart rate 71, oxygen saturation is 97 percent, temperature is 36.9 degrees"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.94,
      "end_seconds": 251.28,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
