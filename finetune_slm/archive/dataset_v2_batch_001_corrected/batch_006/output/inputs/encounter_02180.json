      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.35,
      "end_seconds": 187.98,
      "duration_seconds": 5.63,
      "text": "tell me about your routine, work, habits, that sort of thing"
