      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.74,
      "end_seconds": 256.73,
      "duration_seconds": 3.99,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.58,
      "end_seconds": 259.86,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side"
