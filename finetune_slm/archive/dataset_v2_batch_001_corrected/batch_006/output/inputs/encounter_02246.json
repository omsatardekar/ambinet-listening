{
  "schema_version": "1.0",
  "encounter_id": "02246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.52,
      "end_seconds": 4.56,
      "duration_seconds": 4.04,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.39,
      "end_seconds": 9.2,
      "duration_seconds": 3.81,
      "text": "thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.77,
      "end_seconds": 18.01,
      "duration_seconds": 7.24,
      "text": "honestly it's itchy red patches that have gone crusty and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.02,
      "end_seconds": 21.85,
      "duration_seconds": 2.83,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.49,
      "end_seconds": 24.52,
      "duration_seconds": 2.03,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.0,
      "end_seconds": 28.07,
      "duration_seconds": 2.07,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.09,
      "end_seconds": 31.29,
      "duration_seconds": 2.2,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.05,
      "end_seconds": 36.63,
      "duration_seconds": 3.58,
      "text": "So is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.37,
      "end_seconds": 42.91,
      "duration_seconds": 4.54,
      "text": "I'd give it a a five, out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 46.89,
      "duration_seconds": 2.34,
      "text": "anything that that improves it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.97,
      "end_seconds": 49.94,
      "duration_seconds": 1.97,
      "text": "Emollient helps a bit"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 53.17,
      "duration_seconds": 2.34,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.68,
      "end_seconds": 58.78,
      "duration_seconds": 5.1,
      "text": "when it starts I tend to get being irritable as well"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.01,
      "end_seconds": 62.88,
      "duration_seconds": 2.87,
      "text": "Any scratching at night as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 66.97,
      "duration_seconds": 3.41,
      "text": "Yes, about the same, two months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.4,
      "end_seconds": 75.91,
      "duration_seconds": 8.51,
      "text": "yes carry on. Have you had itchy red patches that have gone crusty before or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.55,
      "end_seconds": 84.0,
      "duration_seconds": 7.45,
      "text": "yes something like this happened last winter and it went away on its own"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.75,
      "end_seconds": 97.82,
      "duration_seconds": 4.07,
      "text": "Have you had high fever, by any chance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.56,
      "end_seconds": 101.34,
      "duration_seconds": 2.78,
      "text": "I haven't noticed any high fever"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 106.53,
      "duration_seconds": 4.24,
      "text": "have you had any drowsiness, eating poorly or blisters?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.61,
      "end_seconds": 111.18,
      "duration_seconds": 3.57,
      "text": "No, no drowsiness, eating poorly or blisters."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.79,
      "end_seconds": 115.86,
      "duration_seconds": 3.07,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.01,
      "end_seconds": 118.4,
      "duration_seconds": 1.39,
      "text": "Nothing there no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.42,
      "end_seconds": 123.74,
      "duration_seconds": 4.32,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.03,
      "end_seconds": 127.35,
      "duration_seconds": 2.32,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.2,
      "end_seconds": 134.61,
      "duration_seconds": 2.41,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.34,
      "end_seconds": 137.98,
      "duration_seconds": 2.64,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.16,
      "end_seconds": 142.78,
      "duration_seconds": 3.62,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.76,
      "end_seconds": 147.24,
      "duration_seconds": 2.48,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.65,
      "end_seconds": 168.67,
      "duration_seconds": 4.02,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.25,
      "end_seconds": 172.42,
      "duration_seconds": 2.17,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.52,
      "end_seconds": 186.5,
      "duration_seconds": 4.98,
      "text": "tell me about your routine work habits that sort of thing"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.38,
      "end_seconds": 203.15,
      "duration_seconds": 14.77,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. I swim twice a week. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 204.64,
      "end_seconds": 210.62,
      "duration_seconds": 5.98,
      "text": "Doctor, I've got the the readings for you. Blood pressure 112 over 80, heart rate 65."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.4,
      "end_seconds": 212.32,
      "duration_seconds": 0.92,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.62,
      "end_seconds": 216.83,
      "duration_seconds": 3.21,
      "text": "now I'm gonna do a short physical check"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.64,
      "end_seconds": 218.71,
      "duration_seconds": 1.07,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.66,
      "end_seconds": 222.87,
      "duration_seconds": 2.21,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.24,
      "end_seconds": 245.42,
      "duration_seconds": 5.18,
      "text": "the eczema patches on the arms have yellow crusts and weeping areas"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 261.61,
      "duration_seconds": 12.39,
      "text": "That's the examination finished. Right, here's what I'm thinking. The most likely explanation is eczema with a bacterial skin infection. I can't rule out herpes simplex eczema yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.2,
      "end_seconds": 269.14,
      "duration_seconds": 2.94,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.22,
      "end_seconds": 305.34,
      "duration_seconds": 35.12,
      "text": "I understand the worry at the moment I'd say it's eczema with a bacterial skin infection, and we'll know more once the a skin swab is back. a skin swab is what I'd like next, for infected eczema it's a routine test and it'll give us a much clearer picture i'll start you on flucloxacillin, 250 milligrams, four times a day, seven days you take it by mouth it's for infected eczema"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.16,
      "end_seconds": 323.35,
      "duration_seconds": 16.19,
      "text": "keep the nails short and keep using the moisturiser. If you smoke, this is a good moment to think about stopping, and we can help you with that. If the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.94,
      "end_seconds": 329.26,
      "duration_seconds": 2.32,
      "text": "thank you, that's clear"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.17,
      "end_seconds": 334.48,
      "duration_seconds": 3.31,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.03,
      "end_seconds": 339.11,
      "duration_seconds": 3.08,
      "text": "That's clear, you know, thanks."
    }
  ]
}