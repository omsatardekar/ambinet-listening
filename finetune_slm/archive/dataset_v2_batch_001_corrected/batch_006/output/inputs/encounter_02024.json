      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.75,
      "end_seconds": 401.4,
      "duration_seconds": 17.65,
      "text": "keep the weight off the foot and keep the dressing dry please take the tablets with food so they don't upset your stomach and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
