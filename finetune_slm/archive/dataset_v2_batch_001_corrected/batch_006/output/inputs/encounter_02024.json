      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.85,
      "end_seconds": 376.95,
      "duration_seconds": 12.1,
      "text": "I'll request a wound swab, it'll help with infected ulcer we'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days that should help with infected ulcer"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.69,
      "end_seconds": 382.39,
      "duration_seconds": 3.7,
      "text": "can I collect it from my own pharmacy?"
