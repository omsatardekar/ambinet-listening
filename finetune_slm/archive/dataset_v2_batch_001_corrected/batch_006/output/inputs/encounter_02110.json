{
  "schema_version": "1.0",
  "encounter_id": "02110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 7.69,
      "duration_seconds": 6.64,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 12.15,
      "duration_seconds": 3.93,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.67,
      "end_seconds": 17.64,
      "duration_seconds": 4.97,
      "text": "It's sudden severe pain in the left testicle, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 19.95,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.97,
      "end_seconds": 31.55,
      "duration_seconds": 10.58,
      "text": "I've had it for about a week. I told my wife I'd come today. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.15,
      "end_seconds": 34.76,
      "duration_seconds": 2.61,
      "text": "Alright, I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.48,
      "end_seconds": 48.91,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.28,
      "end_seconds": 71.88,
      "duration_seconds": 7.6,
      "text": "Okay: temperature 36.9, saturation 97 percent, pulse is 77 beats a minute, pressure 108 over 80."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.88,
      "end_seconds": 77.22,
      "duration_seconds": 2.34,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 82.28,
      "duration_seconds": 4.28,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.69,
      "end_seconds": 87.66,
      "duration_seconds": 3.97,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.17,
      "end_seconds": 91.98,
      "duration_seconds": 2.81,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.64,
      "end_seconds": 111.35,
      "duration_seconds": 7.71,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.34,
      "end_seconds": 118.76,
      "duration_seconds": 2.42,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.18,
      "end_seconds": 140.16,
      "duration_seconds": 3.98,
      "text": "Have you had any discharge or burning when passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.29,
      "end_seconds": 145.69,
      "duration_seconds": 4.4,
      "text": "Okay, so no, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 150.53,
      "duration_seconds": 4.2,
      "text": "Let me check a few things. Any injury or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.73,
      "end_seconds": 155.52,
      "duration_seconds": 3.79,
      "text": "I haven't had injury or fever, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 160.21,
      "duration_seconds": 3.89,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.46,
      "end_seconds": 163.84,
      "duration_seconds": 2.38,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.22,
      "end_seconds": 180.57,
      "duration_seconds": 3.35,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.13,
      "end_seconds": 183.86,
      "duration_seconds": 1.73,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.82,
      "end_seconds": 191.14,
      "duration_seconds": 3.32,
      "text": "Okay, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.07,
      "end_seconds": 194.27,
      "duration_seconds": 1.2,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.74,
      "end_seconds": 207.42,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.92,
      "end_seconds": 212.08,
      "duration_seconds": 4.16,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.49,
      "end_seconds": 216.58,
      "duration_seconds": 3.09,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.48,
      "end_seconds": 221.9,
      "duration_seconds": 4.42,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.67,
      "end_seconds": 225.84,
      "duration_seconds": 3.17,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.4,
      "end_seconds": 234.09,
      "duration_seconds": 6.69,
      "text": "Okay, so just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 238.44,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.21,
      "end_seconds": 243.91,
      "duration_seconds": 3.7,
      "text": "Erythromycin. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.58,
      "end_seconds": 273.05,
      "duration_seconds": 12.47,
      "text": "So, based on the history and the examination, I'm honestly not certain yet. It could be testicular torsion needing emergency surgery, or it might be an epididymitis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.27,
      "end_seconds": 277.57,
      "duration_seconds": 3.3,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.25,
      "end_seconds": 303.04,
      "duration_seconds": 23.79,
      "text": "Nothing I've seen today points to an emergency. It looks like testicular torsion needing emergency surgery, but I'd like to confirm. We should do an urgent scrotal ultrasound for testicular pain. Do not eat or drink, you are going to theatre now. I'll also refer you to the urology team."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.7,
      "end_seconds": 305.34,
      "duration_seconds": 1.64,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.56,
      "end_seconds": 312.36,
      "duration_seconds": 5.8,
      "text": "I'll want another look straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.52,
      "end_seconds": 316.26,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.52,
      "end_seconds": 320.87,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}