{
  "schema_version": "1.0",
  "encounter_id": "02363",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 5.68,
      "duration_seconds": 4.38,
      "text": "right, come in, have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.82,
      "end_seconds": 10.96,
      "duration_seconds": 4.14,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.96,
      "end_seconds": 15.41,
      "duration_seconds": 2.45,
      "text": "how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 16.34,
      "end_seconds": 22.55,
      "duration_seconds": 6.21,
      "text": "we came because of severe pain in the lower leg after a fracture"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 24.35,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.65,
      "end_seconds": 40.14,
      "duration_seconds": 14.49,
      "text": "ever since... since last Tuesday, really. Oh, and tingling in the foot. Oh, and a tight swollen leg. That's been about the same, two days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.06,
      "end_seconds": 44.34,
      "duration_seconds": 3.28,
      "text": "how troublesome is it it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.69,
      "end_seconds": 51.88,
      "duration_seconds": 6.19,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.8,
      "end_seconds": 59.72,
      "duration_seconds": 5.92,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.24,
      "end_seconds": 64.14,
      "duration_seconds": 2.9,
      "text": "pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.59,
      "end_seconds": 68.45,
      "duration_seconds": 2.86,
      "text": "Any chest pain or wound infection?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.08,
      "end_seconds": 81.48,
      "duration_seconds": 11.4,
      "text": "No, no chest pain, no wound infection. I did have pain out of proportion at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.3,
      "end_seconds": 85.25,
      "duration_seconds": 1.95,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.8,
      "end_seconds": 87.15,
      "duration_seconds": 1.35,
      "text": "definitely no fever"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 92.51,
      "end_seconds": 97.88,
      "duration_seconds": 5.37,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.3,
      "end_seconds": 105.77,
      "duration_seconds": 6.47,
      "text": "right, no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.15,
      "end_seconds": 115.45,
      "duration_seconds": 8.3,
      "text": "alright, I'll note both what you've said and what you've noticed anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.26,
      "end_seconds": 120.59,
      "duration_seconds": 4.33,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.12,
      "end_seconds": 123.38,
      "duration_seconds": 2.26,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.47,
      "end_seconds": 125.42,
      "duration_seconds": 0.95,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.46,
      "end_seconds": 138.92,
      "duration_seconds": 3.46,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.02,
      "end_seconds": 141.11,
      "duration_seconds": 1.09,
      "text": "Yes, eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 149.13,
      "duration_seconds": 7.36,
      "text": "Yes, eczema is known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.44,
      "end_seconds": 155.25,
      "duration_seconds": 4.81,
      "text": "Hydrocortisone cream, when needed. I'm on strong painkillers, not working."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.14,
      "end_seconds": 161.2,
      "duration_seconds": 5.06,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.99,
      "end_seconds": 166.12,
      "duration_seconds": 3.13,
      "text": "no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.83,
      "end_seconds": 171.21,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.79,
      "end_seconds": 180.69,
      "duration_seconds": 3.9,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.42,
      "end_seconds": 184.24,
      "duration_seconds": 2.82,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.36,
      "end_seconds": 190.58,
      "duration_seconds": 5.22,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.21,
      "end_seconds": 195.37,
      "duration_seconds": 4.16,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.43,
      "end_seconds": 202.43,
      "duration_seconds": 5.0,
      "text": "My cousin has psoriasis. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 204.2,
      "end_seconds": 212.91,
      "duration_seconds": 8.71,
      "text": "Here are the numbers, doctor. Respiratory rate 15, oxygen saturation is 97 percent, BP is 125 over 82. Heart rate 69."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.42,
      "end_seconds": 215.12,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.07,
      "end_seconds": 222.72,
      "duration_seconds": 4.65,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.26,
      "end_seconds": 224.6,
      "duration_seconds": 1.34,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.75,
      "end_seconds": 228.01,
      "duration_seconds": 2.26,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.9,
      "end_seconds": 252.7,
      "duration_seconds": 6.8,
      "text": "The calf is tense and shiny, and stretching the toes makes the pain much worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.72,
      "end_seconds": 256.55,
      "duration_seconds": 1.83,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 296.8,
      "duration_seconds": 22.11,
      "text": "so where does that leave us? I don't have a clear answer today: possible compartment syndrome needing urgent surgery is possible, and so is a deep vein thrombosis. Just to be sure I understood. You've had severe pain in the lower leg after a fracture, since last Tuesday, and no wound infection or chest pain"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.51,
      "end_seconds": 300.25,
      "duration_seconds": 1.74,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.31,
      "end_seconds": 308.16,
      "duration_seconds": 6.85,
      "text": "I'm going to order measuring the pressure in the leg, for possible compartment syndrome"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.25,
      "end_seconds": 313.65,
      "duration_seconds": 3.4,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.17,
      "end_seconds": 328.5,
      "duration_seconds": 13.33,
      "text": "remove the cast now, you are going to theatre for a decompression see me again straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.84,
      "end_seconds": 332.28,
      "duration_seconds": 2.44,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.46,
      "end_seconds": 334.78,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}