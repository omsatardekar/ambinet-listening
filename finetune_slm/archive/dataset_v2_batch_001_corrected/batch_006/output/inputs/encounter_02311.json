{
  "schema_version": "1.0",
  "encounter_id": "02311",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 2.7,
      "duration_seconds": 1.46,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.8,
      "end_seconds": 8.43,
      "duration_seconds": 4.63,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.05,
      "end_seconds": 16.7,
      "duration_seconds": 7.65,
      "text": "Doctor, it's a chronic cough with lots of phlegm. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.09,
      "end_seconds": 20.98,
      "duration_seconds": 2.89,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.65,
      "end_seconds": 26.6,
      "duration_seconds": 3.95,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.52,
      "end_seconds": 30.66,
      "duration_seconds": 2.14,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.09,
      "end_seconds": 35.36,
      "duration_seconds": 3.27,
      "text": "Yes, mornings. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.23,
      "end_seconds": 39.39,
      "duration_seconds": 2.16,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 51.01,
      "duration_seconds": 10.21,
      "text": "Green phlegm lately goes along with it, most of the time. The green phlegm lately? That's been for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.62,
      "end_seconds": 56.02,
      "duration_seconds": 3.4,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.4,
      "end_seconds": 59.91,
      "duration_seconds": 2.51,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.67,
      "end_seconds": 64.63,
      "duration_seconds": 2.96,
      "text": "Have you been getting out of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.17,
      "end_seconds": 74.18,
      "duration_seconds": 9.01,
      "text": "Mm, yes. With getting out of breath, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.71,
      "end_seconds": 78.22,
      "duration_seconds": 3.51,
      "text": "Mm, okay. Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.78,
      "end_seconds": 81.86,
      "duration_seconds": 2.08,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.53,
      "end_seconds": 87.55,
      "duration_seconds": 4.02,
      "text": "Any coughing up blood, fever or weight loss at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 94.4,
      "duration_seconds": 5.09,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.91,
      "end_seconds": 99.77,
      "duration_seconds": 4.86,
      "text": "Mm, okay. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.67,
      "end_seconds": 103.82,
      "duration_seconds": 2.15,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.75,
      "end_seconds": 108.01,
      "duration_seconds": 2.26,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 110.82,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.48,
      "end_seconds": 114.89,
      "duration_seconds": 3.41,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.62,
      "end_seconds": 121.45,
      "duration_seconds": 4.83,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.22,
      "end_seconds": 124.93,
      "duration_seconds": 2.71,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 130.69,
      "duration_seconds": 3.95,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 134.74,
      "duration_seconds": 2.67,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.32,
      "end_seconds": 139.02,
      "duration_seconds": 3.7,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 141.11,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.18,
      "end_seconds": 146.39,
      "duration_seconds": 3.21,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.34,
      "end_seconds": 166.24,
      "duration_seconds": 3.9,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 183.12,
      "duration_seconds": 15.48,
      "text": "I've had high cholesterol for about ten years now. Well, um, I've had arthritis in my knees for two years now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.91,
      "end_seconds": 196.85,
      "duration_seconds": 12.94,
      "text": "Sure. Right, so high cholesterol and arthritis in your knees are already on your record. We'll keep that in mind today. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.0,
      "end_seconds": 204.02,
      "duration_seconds": 6.02,
      "text": "Not currently, but as a youngster naproxen gave me stomach pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.95,
      "end_seconds": 221.39,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 234.17,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.42,
      "end_seconds": 252.72,
      "duration_seconds": 8.3,
      "text": "Okay: respiratory rate 16, saturation 98 percent, blood pressure 112 over 76. And temp 36.7 degrees, pulse 66."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.34,
      "end_seconds": 256.04,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.15,
      "end_seconds": 259.33,
      "duration_seconds": 2.18,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.25,
      "end_seconds": 264.91,
      "duration_seconds": 3.66,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.23,
      "end_seconds": 268.4,
      "duration_seconds": 2.17,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.11,
      "end_seconds": 291.38,
      "duration_seconds": 6.27,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.94,
      "end_seconds": 306.58,
      "duration_seconds": 11.64,
      "text": "Thank you, you can get dressed. So where does that leave us? The most likely explanation is a flare of bronchiectasis. We shouldn't forget a chest infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.02,
      "end_seconds": 310.98,
      "duration_seconds": 2.96,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.73,
      "end_seconds": 320.64,
      "duration_seconds": 8.91,
      "text": "I can't promise yet, but most people with a flare of bronchiectasis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.14,
      "end_seconds": 343.46,
      "duration_seconds": 5.32,
      "text": "I'm sending you for a sputum culture because of purulent sputum."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 345.18,
      "end_seconds": 347.92,
      "duration_seconds": 2.74,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.68,
      "end_seconds": 371.56,
      "duration_seconds": 21.88,
      "text": "I'm sending you for a chest X-ray because of bronchiectasis flare. You'll be taking clarithromycin, 500 milligrams, twice a day, fourteen days. You take it by mouth. It's for bronchiectasis flare. Keep up your airway clearance exercises twice a day. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.61,
      "end_seconds": 375.19,
      "duration_seconds": 2.58,
      "text": "Yes, you know, will do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.09,
      "end_seconds": 380.45,
      "duration_seconds": 4.36,
      "text": "Alright, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.46,
      "end_seconds": 389.95,
      "duration_seconds": 7.49,
      "text": "So, I take the clarithromycin, 500 milligrams, twice a day. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.08,
      "end_seconds": 396.57,
      "duration_seconds": 5.49,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.76,
      "end_seconds": 400.72,
      "duration_seconds": 2.96,
      "text": "Erm, alright, thanks, take care."
    }
  ]
}