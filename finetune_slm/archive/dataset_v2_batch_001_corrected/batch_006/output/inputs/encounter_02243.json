{
  "schema_version": "1.0",
  "encounter_id": "02243",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.28,
      "duration_seconds": 4.46,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 10.81,
      "duration_seconds": 4.52,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.42,
      "end_seconds": 23.69,
      "duration_seconds": 12.27,
      "text": "mainly sudden severe pain on the right side of my pelvis there's a a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.33,
      "end_seconds": 28.54,
      "duration_seconds": 3.21,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.1,
      "end_seconds": 31.22,
      "duration_seconds": 2.12,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.8,
      "end_seconds": 33.81,
      "duration_seconds": 2.01,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.55,
      "end_seconds": 36.94,
      "duration_seconds": 2.39,
      "text": "It's worse with movement."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.1,
      "end_seconds": 40.92,
      "duration_seconds": 2.82,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.54,
      "end_seconds": 46.69,
      "duration_seconds": 5.15,
      "text": "Vomiting goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.64,
      "end_seconds": 50.77,
      "duration_seconds": 2.13,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.96,
      "end_seconds": 66.03,
      "duration_seconds": 14.07,
      "text": "yeah, I've had that since last night with feeling faint, I'd say on and off mm, the vomiting? That's been for ten days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.23,
      "end_seconds": 70.17,
      "duration_seconds": 2.94,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.69,
      "end_seconds": 75.31,
      "duration_seconds": 4.62,
      "text": "Um, I have acid reflux, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.67,
      "end_seconds": 83.01,
      "duration_seconds": 6.34,
      "text": "Right, right. Yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.72,
      "end_seconds": 100.81,
      "duration_seconds": 2.09,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.6,
      "end_seconds": 122.44,
      "duration_seconds": 17.84,
      "text": "I'm on omeprazole, 20 milligrams, once a day. I'm supposed to take it regularly, you know, but I don't always manage. I was on pantoprazole before. I stopped taking it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.16,
      "end_seconds": 131.16,
      "duration_seconds": 4.0,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 136.02,
      "duration_seconds": 4.2,
      "text": "Milk. I come out in... well, a rash"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.78,
      "end_seconds": 142.33,
      "duration_seconds": 4.55,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.03,
      "end_seconds": 156.21,
      "duration_seconds": 13.18,
      "text": "Not much, I mostly stay in these days. I look after my grandchildren most days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.94,
      "end_seconds": 162.03,
      "duration_seconds": 2.09,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.77,
      "end_seconds": 171.98,
      "duration_seconds": 5.21,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.78,
      "end_seconds": 192.01,
      "duration_seconds": 2.23,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.58,
      "end_seconds": 195.72,
      "duration_seconds": 3.14,
      "text": "So, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.35,
      "end_seconds": 200.87,
      "duration_seconds": 3.52,
      "text": "Any missed period, vaginal bleeding or discharge?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.38,
      "end_seconds": 203.97,
      "duration_seconds": 2.59,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.14,
      "end_seconds": 209.16,
      "duration_seconds": 4.02,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.15,
      "end_seconds": 216.11,
      "duration_seconds": 4.96,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.9,
      "end_seconds": 230.64,
      "duration_seconds": 2.74,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 239.35,
      "duration_seconds": 2.24,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.56,
      "end_seconds": 258.39,
      "duration_seconds": 9.83,
      "text": "Okay: respiratory rate 19, pulse is 121 beats a minute. And temp 37.1 degrees, blood pressure 136 over 71."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.33,
      "end_seconds": 266.61,
      "duration_seconds": 5.28,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.32,
      "end_seconds": 269.67,
      "duration_seconds": 1.35,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.94,
      "end_seconds": 293.15,
      "duration_seconds": 5.21,
      "text": "You are in severe pain with a tender mass low on the right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 313.92,
      "duration_seconds": 15.49,
      "text": "All finished, thank you. Let me tell you where I've got to. My working impression is possible ovarian torsion. We shouldn't forget a ruptured cyst. We should do a pregnancy test for pelvic pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 315.6,
      "end_seconds": 319.35,
      "duration_seconds": 3.75,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.92,
      "end_seconds": 333.11,
      "duration_seconds": 13.19,
      "text": "You need an emergency scan and probably surgery today. Please don't wait if the symptoms get worse. That's when to be seen urgently. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.97,
      "end_seconds": 339.02,
      "duration_seconds": 4.05,
      "text": "Let me think, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.68,
      "end_seconds": 342.02,
      "duration_seconds": 1.34,
      "text": "look after yourself"
    }
  ]
}