{
  "schema_version": "1.0",
  "encounter_id": "02285",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 3.1,
      "duration_seconds": 2.4,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.77,
      "end_seconds": 8.41,
      "duration_seconds": 4.64,
      "text": "erm, uh, good morning, doctor, thank you"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.54,
      "end_seconds": 18.11,
      "duration_seconds": 8.57,
      "text": "mm, you know, hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.65,
      "end_seconds": 25.61,
      "duration_seconds": 6.96,
      "text": "Of course, please stay. It's helpful to have you here. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.24,
      "end_seconds": 37.58,
      "duration_seconds": 10.34,
      "text": "Erm, um, honestly, it's a bone sticking out of my lower leg, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.09,
      "end_seconds": 41.44,
      "duration_seconds": 3.35,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.17,
      "end_seconds": 57.14,
      "duration_seconds": 13.97,
      "text": "I've, I've had it since Monday. My neighbour said I should get it looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.61,
      "end_seconds": 65.4,
      "duration_seconds": 7.79,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 65.5,
      "end_seconds": 70.82,
      "duration_seconds": 5.32,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.99,
      "end_seconds": 75.42,
      "duration_seconds": 3.43,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.58,
      "end_seconds": 81.15,
      "duration_seconds": 4.57,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.63,
      "end_seconds": 87.71,
      "duration_seconds": 5.08,
      "text": "I've, I've also had heavy bleeding, for four weeks"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.6,
      "end_seconds": 91.88,
      "duration_seconds": 3.28,
      "text": "any numbness in the foot as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.65,
      "end_seconds": 93.93,
      "duration_seconds": 1.28,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.37,
      "end_seconds": 102.22,
      "duration_seconds": 6.85,
      "text": "let me check a few things. Any loss of consciousness, head injury or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.28,
      "end_seconds": 117.59,
      "duration_seconds": 14.31,
      "text": "No, uh, no loss of consciousness, no head injury, no chest pain. I did have severe pain at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.26,
      "end_seconds": 125.16,
      "duration_seconds": 1.9,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.7,
      "end_seconds": 127.82,
      "duration_seconds": 2.12,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.26,
      "end_seconds": 132.18,
      "duration_seconds": 2.92,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.38,
      "end_seconds": 137.46,
      "duration_seconds": 4.08,
      "text": "Uh, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.32,
      "end_seconds": 145.96,
      "duration_seconds": 7.64,
      "text": "hold on, doctor, I think he reacted to amoxicillin once i'm not certain, though"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.64,
      "end_seconds": 151.02,
      "duration_seconds": 3.38,
      "text": "Erm, really? I don't think so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.69,
      "end_seconds": 157.55,
      "duration_seconds": 5.86,
      "text": "Okay, I'll note both of those. Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.03,
      "end_seconds": 164.52,
      "duration_seconds": 5.49,
      "text": "Mm, I've had an enlarged prostate for two years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.9,
      "end_seconds": 167.29,
      "duration_seconds": 1.39,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 185.87,
      "duration_seconds": 17.3,
      "text": "Anxiety, for nearly five years. Actually, um, I've had diabetes for about ten years now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 196.25,
      "duration_seconds": 9.7,
      "text": "Yes, an enlarged prostate and anxiety are known to us, good to have that clear. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.82,
      "end_seconds": 202.46,
      "duration_seconds": 5.64,
      "text": "So, my grandfather had a stroke. Erm, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 216.05,
      "duration_seconds": 2.73,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.78,
      "end_seconds": 222.81,
      "duration_seconds": 5.03,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.23,
      "end_seconds": 226.23,
      "duration_seconds": 2.0,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.04,
      "end_seconds": 235.44,
      "duration_seconds": 8.4,
      "text": "Actually, I'm on tamsulosin, 0.4 milligrams, maybe, at night for the prostate."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.44,
      "end_seconds": 239.98,
      "duration_seconds": 3.54,
      "text": "So, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.28,
      "end_seconds": 251.07,
      "duration_seconds": 9.79,
      "text": "So, not with me. I'll bring it next time. Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 252.35,
      "end_seconds": 259.6,
      "duration_seconds": 7.25,
      "text": "uh, that's what's prescribed, but I'm not sure he takes it every day"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.7,
      "end_seconds": 270.97,
      "duration_seconds": 9.27,
      "text": "Mm, it's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.95,
      "end_seconds": 274.97,
      "duration_seconds": 3.02,
      "text": "So, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.58,
      "end_seconds": 289.62,
      "duration_seconds": 13.04,
      "text": "Actually, for my sugar, I believe. My son sets them out for me, I just take what I'm given. Glibenclamide I don't take anymore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.43,
      "end_seconds": 293.24,
      "duration_seconds": 2.81,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.55,
      "end_seconds": 299.46,
      "duration_seconds": 4.91,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 301.06,
      "end_seconds": 310.59,
      "duration_seconds": 9.53,
      "text": "Doctor, I've got the the readings for you. Blood pressure 119 over 82, pulse is 110 beats a minute, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.78,
      "end_seconds": 312.74,
      "duration_seconds": 0.96,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.05,
      "end_seconds": 317.63,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.66,
      "end_seconds": 320.86,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.24,
      "end_seconds": 335.72,
      "duration_seconds": 6.48,
      "text": "There is a wound with bone visible and the foot is cool with no pulse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.71,
      "end_seconds": 340.88,
      "duration_seconds": 2.17,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.57,
      "end_seconds": 380.69,
      "duration_seconds": 32.12,
      "text": "I'm sending you for an urgent X-ray because of open fracture. I'll request blood tests, it'll help with pre-operative. The result will help us decide whether anything more is needed. Keep still, I am splinting the leg and sending you to theatre now. I'll also refer you to the orthopaedic team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.33,
      "end_seconds": 383.84,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.84,
      "end_seconds": 390.68,
      "duration_seconds": 4.84,
      "text": "Uh, um, I think I understand everything. Thanks."
    }
  ]
}