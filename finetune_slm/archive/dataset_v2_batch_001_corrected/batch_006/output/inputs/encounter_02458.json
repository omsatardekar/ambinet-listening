{
  "schema_version": "1.0",
  "encounter_id": "02458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 7.51,
      "duration_seconds": 6.74,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.1,
      "end_seconds": 12.74,
      "duration_seconds": 4.64,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.29,
      "end_seconds": 19.19,
      "duration_seconds": 4.9,
      "text": "I'm here because of my face drooping on the right."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.7,
      "end_seconds": 22.28,
      "duration_seconds": 1.58,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 31.94,
      "duration_seconds": 6.38,
      "text": "Uh, um, it's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.46,
      "end_seconds": 37.37,
      "duration_seconds": 3.91,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.01,
      "end_seconds": 47.52,
      "duration_seconds": 8.51,
      "text": "It's mild, honestly. I've also had not being able to close my eye, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.23,
      "end_seconds": 55.13,
      "duration_seconds": 6.9,
      "text": "Have you had your face drooping on the right before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.23,
      "end_seconds": 64.98,
      "duration_seconds": 8.75,
      "text": "Erm, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.07,
      "end_seconds": 90.19,
      "duration_seconds": 9.12,
      "text": "Let me check a few things. Any weakness in the arm or leg, rash in the ear, headache or slurred speech?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.92,
      "end_seconds": 102.9,
      "duration_seconds": 10.98,
      "text": "Hmm, uh, no, no weakness in the arm or leg, rash in the ear, headache or slurred speech."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.48,
      "end_seconds": 106.4,
      "duration_seconds": 2.92,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.99,
      "end_seconds": 108.54,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.09,
      "end_seconds": 114.37,
      "duration_seconds": 4.28,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.17,
      "end_seconds": 119.43,
      "duration_seconds": 4.26,
      "text": "Cat fur. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.64,
      "end_seconds": 123.27,
      "duration_seconds": 2.63,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.84,
      "end_seconds": 130.01,
      "duration_seconds": 5.17,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.56,
      "end_seconds": 135.49,
      "duration_seconds": 3.93,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.75,
      "end_seconds": 140.41,
      "duration_seconds": 3.66,
      "text": "Mm, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.44,
      "end_seconds": 147.25,
      "duration_seconds": 4.81,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.31,
      "end_seconds": 159.44,
      "duration_seconds": 10.13,
      "text": "Migraines, for about ten years. I, I have heart failure. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.02,
      "end_seconds": 168.14,
      "duration_seconds": 8.12,
      "text": "Yes, migraines is known to us, good to have that clear. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.48,
      "end_seconds": 179.45,
      "duration_seconds": 9.97,
      "text": "I take propranolol, 40 milligrams, twice a day. I, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.94,
      "end_seconds": 184.13,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.78,
      "end_seconds": 187.87,
      "duration_seconds": 3.09,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.05,
      "end_seconds": 190.43,
      "duration_seconds": 1.38,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.0,
      "end_seconds": 194.61,
      "duration_seconds": 3.61,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.51,
      "end_seconds": 197.77,
      "duration_seconds": 2.26,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.47,
      "end_seconds": 202.59,
      "duration_seconds": 4.12,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 206.02,
      "duration_seconds": 2.88,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.6,
      "end_seconds": 219.89,
      "duration_seconds": 2.29,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.14,
      "end_seconds": 245.53,
      "duration_seconds": 7.39,
      "text": "Okay: pulse 76, temperature 36.9, saturation 98 percent. And BP is 109 over 81."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 251.27,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.51,
      "end_seconds": 260.68,
      "duration_seconds": 1.17,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.53,
      "end_seconds": 264.88,
      "duration_seconds": 2.35,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.61,
      "end_seconds": 285.99,
      "duration_seconds": 8.38,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.0,
      "end_seconds": 297.74,
      "duration_seconds": 8.74,
      "text": "Thank you, you can get dressed. Taking everything into account, I think we're dealing with Bell's palsy at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.95,
      "end_seconds": 336.66,
      "duration_seconds": 29.71,
      "text": "I'll start you on prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy. Use eye drops and tape the eye shut at night to protect it. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll want another look in one week. So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.92,
      "end_seconds": 341.27,
      "duration_seconds": 3.35,
      "text": "Ah, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.78,
      "end_seconds": 343.98,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}