{
  "schema_version": "1.0",
  "encounter_id": "02462",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 3.46,
      "duration_seconds": 2.12,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.07,
      "end_seconds": 7.79,
      "duration_seconds": 2.72,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.62,
      "end_seconds": 13.08,
      "duration_seconds": 4.46,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.16,
      "end_seconds": 20.9,
      "duration_seconds": 5.74,
      "text": "Absolutely, come and sit beside them. Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.54,
      "end_seconds": 25.39,
      "duration_seconds": 2.85,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.88,
      "end_seconds": 29.78,
      "duration_seconds": 2.9,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.33,
      "end_seconds": 34.68,
      "duration_seconds": 4.35,
      "text": "It's pain in the lower left tummy, mostly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.26,
      "end_seconds": 40.16,
      "duration_seconds": 3.9,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 44.55,
      "duration_seconds": 3.39,
      "text": "I've had it for ten days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.08,
      "end_seconds": 47.89,
      "duration_seconds": 2.81,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.77,
      "end_seconds": 50.3,
      "duration_seconds": 1.53,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.82,
      "end_seconds": 53.9,
      "duration_seconds": 2.08,
      "text": "Have you been feeling bloated?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.08,
      "end_seconds": 67.24,
      "duration_seconds": 12.16,
      "text": "Yes, about the same, six months. As for feeling bloated, it feels severe to me. I've also had constipation then loose stools."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.27,
      "end_seconds": 74.53,
      "duration_seconds": 6.26,
      "text": "and what about weight loss, urinary symptoms, vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 82.56,
      "duration_seconds": 7.34,
      "text": "No weight loss, urinary symptoms, vomiting or blood in the stool, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.91,
      "end_seconds": 86.91,
      "duration_seconds": 3.0,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.68,
      "end_seconds": 94.49,
      "duration_seconds": 5.81,
      "text": "Sorry, what was I saying, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.9,
      "end_seconds": 98.82,
      "duration_seconds": 2.92,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.35,
      "end_seconds": 102.64,
      "duration_seconds": 2.29,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.21,
      "end_seconds": 121.71,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.53,
      "end_seconds": 124.86,
      "duration_seconds": 2.33,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.34,
      "end_seconds": 129.16,
      "duration_seconds": 2.82,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.85,
      "end_seconds": 135.06,
      "duration_seconds": 4.21,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.36,
      "end_seconds": 138.31,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.21,
      "end_seconds": 143.98,
      "duration_seconds": 3.77,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.62,
      "end_seconds": 147.73,
      "duration_seconds": 3.11,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.83,
      "end_seconds": 151.25,
      "duration_seconds": 2.42,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.0,
      "end_seconds": 156.33,
      "duration_seconds": 3.33,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.89,
      "end_seconds": 161.78,
      "duration_seconds": 4.89,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 162.36,
      "end_seconds": 172.66,
      "duration_seconds": 10.3,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.4,
      "end_seconds": 179.22,
      "duration_seconds": 4.82,
      "text": "right do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.05,
      "end_seconds": 185.39,
      "duration_seconds": 4.34,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.85,
      "end_seconds": 191.44,
      "duration_seconds": 4.59,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 197.55,
      "duration_seconds": 4.02,
      "text": "Eczema, for two years. Anxiety, for two years"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.04,
      "end_seconds": 203.19,
      "duration_seconds": 4.15,
      "text": "Alright, anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.0,
      "end_seconds": 209.11,
      "duration_seconds": 4.11,
      "text": "so, now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.48,
      "end_seconds": 228.52,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.74,
      "end_seconds": 232.08,
      "duration_seconds": 2.34,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.47,
      "end_seconds": 249.14,
      "duration_seconds": 4.67,
      "text": "it is tender in the lower left with no guarding or rigidity"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.73,
      "end_seconds": 253.96,
      "duration_seconds": 2.23,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.97,
      "end_seconds": 275.66,
      "duration_seconds": 7.69,
      "text": "Let me tell you where I've got to. This is probably acute diverticulitis. A bowel tumour is still possible."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.84,
      "end_seconds": 281.79,
      "duration_seconds": 4.95,
      "text": "Okay, so so what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.25,
      "end_seconds": 294.86,
      "duration_seconds": 11.61,
      "text": "I can't promise yet, but most people with acute diverticulitis do well once it's treated properly i want a CT scan done, that's for left iliac fossa pain"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.88,
      "end_seconds": 301.29,
      "duration_seconds": 2.41,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.24,
      "end_seconds": 332.14,
      "duration_seconds": 28.9,
      "text": "I want blood tests done, that's for abdominal pain. We'll begin with co-amoxiclav, 625 milligrams, three times a day, five days. That should help with diverticulitis. The pharmacy will go through the details again when you pick it up. Drink plenty and start with a light diet. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.68,
      "end_seconds": 355.04,
      "duration_seconds": 21.36,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.8,
      "end_seconds": 363.25,
      "duration_seconds": 7.45,
      "text": "So, I take the co-amoxiclav, 625 milligrams, three times a day. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.04,
      "end_seconds": 369.02,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.99,
      "end_seconds": 377.01,
      "duration_seconds": 3.02,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.93,
      "end_seconds": 380.35,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}