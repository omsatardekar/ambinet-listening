{
  "schema_version": "1.0",
  "encounter_id": "02355",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 6.48,
      "duration_seconds": 5.82,
      "text": "Hi, you know, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.73,
      "end_seconds": 12.28,
      "duration_seconds": 4.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.81,
      "end_seconds": 21.26,
      "duration_seconds": 7.45,
      "text": "Yeah, um, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.8,
      "end_seconds": 26.98,
      "duration_seconds": 4.18,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.99,
      "end_seconds": 34.86,
      "duration_seconds": 5.87,
      "text": "So, doctor, it's a very fast heartbeat. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.78,
      "end_seconds": 38.45,
      "duration_seconds": 2.67,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.97,
      "end_seconds": 54.36,
      "duration_seconds": 2.39,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.83,
      "end_seconds": 80.69,
      "duration_seconds": 14.86,
      "text": "Okay: saturation 98 percent, weight 64 kilos, BP is 110 over 72, height 179 centimetres, temperature is 38.4 degrees, BMI works out to 20.0, pulse is 106 beats a minute, respiratory rate 20."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 83.08,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 89.69,
      "duration_seconds": 5.29,
      "text": "Alright, we'll look at it together shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.01,
      "end_seconds": 98.82,
      "duration_seconds": 5.81,
      "text": "So, you know, it's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.96,
      "end_seconds": 106.84,
      "duration_seconds": 2.88,
      "text": "Have you had vomiting and diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.87,
      "end_seconds": 113.29,
      "duration_seconds": 4.42,
      "text": "Mm, yes. With vomiting and diarrhoea, mostly moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.83,
      "end_seconds": 117.52,
      "duration_seconds": 3.69,
      "text": "So, and what about recent infection or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.25,
      "end_seconds": 121.06,
      "duration_seconds": 2.81,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.79,
      "end_seconds": 125.52,
      "duration_seconds": 2.73,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.42,
      "end_seconds": 127.51,
      "duration_seconds": 1.09,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.43,
      "end_seconds": 133.44,
      "duration_seconds": 4.01,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.01,
      "end_seconds": 136.63,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.59,
      "end_seconds": 142.44,
      "duration_seconds": 4.85,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.86,
      "end_seconds": 158.77,
      "duration_seconds": 14.91,
      "text": "I used to drink heavily but I stopped four years ago. Lots of rice, lentils and some fruit. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.36,
      "end_seconds": 165.32,
      "duration_seconds": 4.96,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.0,
      "end_seconds": 169.74,
      "duration_seconds": 3.74,
      "text": "Well, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.48,
      "end_seconds": 189.23,
      "duration_seconds": 3.75,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.94,
      "end_seconds": 192.94,
      "duration_seconds": 3.0,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.43,
      "end_seconds": 198.27,
      "duration_seconds": 2.84,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.25,
      "end_seconds": 204.97,
      "duration_seconds": 5.72,
      "text": "Ah, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 209.15,
      "duration_seconds": 3.55,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.95,
      "end_seconds": 223.29,
      "duration_seconds": 12.34,
      "text": "Heart failure, for five years. I looked a few things up online, and that probably didn't help. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.99,
      "end_seconds": 233.29,
      "duration_seconds": 8.3,
      "text": "Hm, okay. Okay, I can see heart failure in your file as well. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 234.12,
      "end_seconds": 238.93,
      "duration_seconds": 4.81,
      "text": "He takes metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.22,
      "end_seconds": 240.79,
      "duration_seconds": 1.57,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.22,
      "end_seconds": 245.94,
      "duration_seconds": 3.72,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.08,
      "end_seconds": 249.03,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.76,
      "end_seconds": 264.8,
      "duration_seconds": 7.04,
      "text": "You are hot, shaking, and your pulse is over one hundred and forty and irregular."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.72,
      "end_seconds": 271.57,
      "duration_seconds": 1.85,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.41,
      "end_seconds": 296.4,
      "duration_seconds": 9.99,
      "text": "So, based on the history and the examination, I think we're dealing with a thyroid storm at this stage. I can't rule out sepsis yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.54,
      "end_seconds": 300.77,
      "duration_seconds": 3.23,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.77,
      "end_seconds": 308.78,
      "duration_seconds": 7.01,
      "text": "I can't promise yet, but most people with a thyroid storm do well once it's treated properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.3,
      "end_seconds": 342.5,
      "duration_seconds": 21.2,
      "text": "Urgent blood tests is what I'd like next, for thyroid storm. It's a routine test and it'll give us a much clearer picture. This is an emergency, you will be treated in high dependency. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.53,
      "end_seconds": 346.14,
      "duration_seconds": 1.61,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.88,
      "end_seconds": 354.61,
      "duration_seconds": 6.73,
      "text": "Do get help quickly if the symptoms get worse. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.48,
      "end_seconds": 361.29,
      "duration_seconds": 4.81,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.2,
      "end_seconds": 364.49,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}