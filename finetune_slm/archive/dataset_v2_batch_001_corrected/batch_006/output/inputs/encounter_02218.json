{
  "schema_version": "1.0",
  "encounter_id": "02218",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.38,
      "duration_seconds": 5.3,
      "text": "Uh, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.97,
      "end_seconds": 12.61,
      "duration_seconds": 4.64,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.4,
      "end_seconds": 20.04,
      "duration_seconds": 5.64,
      "text": "Yeah, it's tiredness. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 24.48,
      "duration_seconds": 2.83,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.99,
      "end_seconds": 29.75,
      "duration_seconds": 3.76,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.3,
      "end_seconds": 31.98,
      "duration_seconds": 1.68,
      "text": "I see, go ahead"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.66,
      "end_seconds": 55.35,
      "duration_seconds": 22.69,
      "text": "so, um, I've also had small painful spots on my fingers, for two weeks. As for small painful spots on my fingers, maybe a five out of ten on a bad day. I've also had night sweats, since yesterday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.64,
      "end_seconds": 59.87,
      "duration_seconds": 3.23,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.72,
      "end_seconds": 65.58,
      "duration_seconds": 3.86,
      "text": "well, about a four out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.31,
      "end_seconds": 69.09,
      "duration_seconds": 2.78,
      "text": "Did you get cough or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 73.61,
      "duration_seconds": 3.57,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.69,
      "end_seconds": 77.44,
      "duration_seconds": 1.75,
      "text": "How about chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.75,
      "end_seconds": 84.22,
      "duration_seconds": 2.47,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.95,
      "end_seconds": 88.48,
      "duration_seconds": 3.53,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.01,
      "end_seconds": 91.99,
      "duration_seconds": 2.98,
      "text": "Actually, no, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.27,
      "end_seconds": 99.93,
      "duration_seconds": 4.66,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.9,
      "end_seconds": 105.41,
      "duration_seconds": 4.51,
      "text": "Uh, you know, no, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 121.25,
      "duration_seconds": 3.96,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 127.21,
      "duration_seconds": 5.08,
      "text": "okay, so no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 149.78,
      "duration_seconds": 3.94,
      "text": "right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.68,
      "end_seconds": 154.99,
      "duration_seconds": 4.31,
      "text": "Metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.91,
      "end_seconds": 160.18,
      "duration_seconds": 4.27,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.19,
      "end_seconds": 165.7,
      "duration_seconds": 4.51,
      "text": "Oh, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.42,
      "end_seconds": 169.38,
      "duration_seconds": 2.96,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.35,
      "end_seconds": 177.98,
      "duration_seconds": 6.63,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.57,
      "end_seconds": 180.94,
      "duration_seconds": 1.37,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.6,
      "end_seconds": 183.24,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.94,
      "end_seconds": 187.0,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.73,
      "end_seconds": 193.86,
      "duration_seconds": 6.13,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.68,
      "end_seconds": 196.14,
      "duration_seconds": 1.46,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.61,
      "end_seconds": 202.24,
      "duration_seconds": 4.63,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.69,
      "end_seconds": 219.71,
      "duration_seconds": 5.02,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.45,
      "end_seconds": 222.94,
      "duration_seconds": 2.49,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.21,
      "end_seconds": 232.94,
      "duration_seconds": 8.73,
      "text": "Ah. Yes, high blood pressure is known to us, good to have that clear. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.94,
      "end_seconds": 245.4,
      "duration_seconds": 2.46,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.1,
      "end_seconds": 273.34,
      "duration_seconds": 16.24,
      "text": "okay: BMI works out to 37.3, temperature 39.1, height 151 centimetres, blood pressure 111 over 66, heart rate 102, weight 85 kilos, respiratory rate 20, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.98,
      "end_seconds": 276.65,
      "duration_seconds": 1.67,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.6,
      "end_seconds": 281.2,
      "duration_seconds": 2.6,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.53,
      "end_seconds": 286.54,
      "duration_seconds": 4.01,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.8,
      "end_seconds": 289.91,
      "duration_seconds": 2.11,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.09,
      "end_seconds": 310.0,
      "duration_seconds": 7.91,
      "text": "There is a a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.39,
      "end_seconds": 331.03,
      "duration_seconds": 18.64,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, I think we're dealing with possible infective endocarditis at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.92,
      "end_seconds": 333.88,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.62,
      "end_seconds": 352.66,
      "duration_seconds": 18.04,
      "text": "I understand the worry. At the moment I'd say it's possible infective endocarditis, and we'll know more once the blood cultures is back. I'm sending you for blood cultures because of possible endocarditis. I'm sending you for blood tests because of prolonged fever."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.23,
      "end_seconds": 355.78,
      "duration_seconds": 2.55,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.57,
      "end_seconds": 372.67,
      "duration_seconds": 16.1,
      "text": "You need admission today for blood cultures and a heart scan. I'm going to send a referral to the cardiology team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.16,
      "end_seconds": 375.94,
      "duration_seconds": 1.78,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.24,
      "end_seconds": 383.55,
      "duration_seconds": 6.31,
      "text": "Book a review straight away. Okay, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.48,
      "end_seconds": 390.61,
      "duration_seconds": 5.13,
      "text": "so, I come back straight away is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.56,
      "end_seconds": 396.48,
      "duration_seconds": 3.92,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.56,
      "end_seconds": 400.14,
      "duration_seconds": 2.58,
      "text": "Thank you, that's helpful."
    }
  ]
}