{
  "schema_version": "1.0",
  "encounter_id": "02244",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.07,
      "duration_seconds": 2.95,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.38,
      "end_seconds": 9.94,
      "duration_seconds": 4.56,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.89,
      "end_seconds": 19.76,
      "duration_seconds": 4.87,
      "text": "I'm here because of a fever for two weeks"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.59,
      "end_seconds": 23.0,
      "duration_seconds": 2.41,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.6,
      "end_seconds": 34.49,
      "duration_seconds": 2.89,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.5,
      "end_seconds": 57.04,
      "duration_seconds": 12.54,
      "text": "Okay: BP is 121 over 80, height 166 centimetres, temp 38.9 degrees, BMI works out to 21.4, weight 59 kilos, heart rate 100, respiratory rate 20."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.91,
      "end_seconds": 61.24,
      "duration_seconds": 2.33,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.87,
      "end_seconds": 67.55,
      "duration_seconds": 4.68,
      "text": "We'll go over that shortly. How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.73,
      "end_seconds": 70.94,
      "duration_seconds": 2.21,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.98,
      "end_seconds": 75.4,
      "duration_seconds": 2.42,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.03,
      "end_seconds": 91.15,
      "duration_seconds": 15.12,
      "text": "I'd say a few times a day i've also had tiredness, for five days there was small painful spots on my fingers, yes, but that went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.35,
      "end_seconds": 98.28,
      "duration_seconds": 5.93,
      "text": "Let me check a few things. Any cough, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.88,
      "end_seconds": 104.31,
      "duration_seconds": 4.43,
      "text": "No, no cough, chest pain or weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.96,
      "end_seconds": 108.78,
      "duration_seconds": 2.82,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 112.99,
      "duration_seconds": 2.38,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.72,
      "end_seconds": 115.1,
      "duration_seconds": 1.38,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.32,
      "end_seconds": 122.35,
      "duration_seconds": 2.03,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.76,
      "end_seconds": 129.6,
      "duration_seconds": 3.84,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.77,
      "end_seconds": 133.62,
      "duration_seconds": 1.85,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.5,
      "end_seconds": 139.12,
      "duration_seconds": 3.62,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.02,
      "end_seconds": 141.82,
      "duration_seconds": 1.8,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.48,
      "end_seconds": 143.52,
      "duration_seconds": 1.04,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.6,
      "end_seconds": 147.53,
      "duration_seconds": 1.93,
      "text": "I have heart disease"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.79,
      "end_seconds": 160.33,
      "duration_seconds": 11.54,
      "text": "I follow. Right, so high cholesterol is already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.27,
      "end_seconds": 171.17,
      "duration_seconds": 9.9,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 189.84,
      "duration_seconds": 1.17,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.64,
      "end_seconds": 193.35,
      "duration_seconds": 2.71,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.99,
      "end_seconds": 195.2,
      "duration_seconds": 1.21,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.87,
      "end_seconds": 200.31,
      "duration_seconds": 4.44,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.48,
      "end_seconds": 203.91,
      "duration_seconds": 2.43,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.33,
      "end_seconds": 208.86,
      "duration_seconds": 3.53,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 213.53,
      "duration_seconds": 2.89,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.16,
      "end_seconds": 218.12,
      "duration_seconds": 3.96,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.8,
      "end_seconds": 221.15,
      "duration_seconds": 2.35,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.01,
      "end_seconds": 229.88,
      "duration_seconds": 6.87,
      "text": "It's atorvastatin, 20 milligrams, at night. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.9,
      "end_seconds": 234.22,
      "duration_seconds": 3.32,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.82,
      "end_seconds": 237.88,
      "duration_seconds": 2.06,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 244.0,
      "duration_seconds": 4.15,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.82,
      "end_seconds": 246.68,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.38,
      "end_seconds": 271.19,
      "duration_seconds": 7.81,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.54,
      "end_seconds": 275.78,
      "duration_seconds": 2.24,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.29,
      "end_seconds": 303.57,
      "duration_seconds": 20.28,
      "text": "right, here's what I'm thinking i'm honestly not certain yet it could be possible infective endocarditis, or it might be a viral illness stop me if I've got anything wrong you've had a fever for two weeks for one week, and no chest pain or cough"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.33,
      "end_seconds": 306.85,
      "duration_seconds": 1.52,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.65,
      "end_seconds": 347.3,
      "duration_seconds": 23.65,
      "text": "I think blood tests makes sense here, for prolonged fever. I want an echocardiogram done, that's for new murmur. You need admission today for blood cultures and a heart scan. I think the cardiology team should see you too. I'd like you back straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.12,
      "end_seconds": 350.75,
      "duration_seconds": 1.63,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.63,
      "end_seconds": 355.96,
      "duration_seconds": 1.33,
      "text": "All the best."
    }
  ]
}