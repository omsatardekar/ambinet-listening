{
  "schema_version": "1.0",
  "encounter_id": "02251",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 5.12,
      "duration_seconds": 4.35,
      "text": "So, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.12,
      "end_seconds": 11.61,
      "duration_seconds": 4.49,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.5,
      "end_seconds": 22.71,
      "duration_seconds": 6.21,
      "text": "Mm, honestly, it's pain at night, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.79,
      "end_seconds": 31.58,
      "duration_seconds": 2.79,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.92,
      "end_seconds": 38.03,
      "duration_seconds": 5.11,
      "text": "Around about four days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.38,
      "end_seconds": 51.18,
      "duration_seconds": 11.8,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 56.12,
      "duration_seconds": 3.8,
      "text": "Hmm, it comes and goes. Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.09,
      "end_seconds": 61.25,
      "duration_seconds": 3.16,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.71,
      "end_seconds": 73.32,
      "duration_seconds": 2.61,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.25,
      "end_seconds": 93.5,
      "duration_seconds": 8.25,
      "text": "Okay: temperature is 36.9 degrees, oxygen saturation is 99 percent, BP is 120 over 70. And pulse 65."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.84,
      "end_seconds": 100.52,
      "duration_seconds": 4.68,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.07,
      "end_seconds": 109.63,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 113.21,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.6,
      "end_seconds": 127.99,
      "duration_seconds": 5.39,
      "text": "Your upper tummy is tender in the middle with no guarding."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.83,
      "end_seconds": 141.74,
      "duration_seconds": 8.91,
      "text": "Alright, all finished, thank you. Let me check a few things. Any black stools, vomiting blood or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.56,
      "end_seconds": 146.87,
      "duration_seconds": 3.31,
      "text": "Oh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.08,
      "end_seconds": 150.58,
      "duration_seconds": 3.5,
      "text": "Ah. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.02,
      "end_seconds": 154.3,
      "duration_seconds": 2.28,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.31,
      "end_seconds": 162.48,
      "duration_seconds": 3.17,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 166.15,
      "duration_seconds": 3.13,
      "text": "Well, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.89,
      "end_seconds": 182.67,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.41,
      "end_seconds": 186.67,
      "duration_seconds": 3.26,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.38,
      "end_seconds": 190.3,
      "duration_seconds": 1.92,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.92,
      "end_seconds": 196.63,
      "duration_seconds": 2.71,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.27,
      "end_seconds": 199.71,
      "duration_seconds": 2.44,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.97,
      "end_seconds": 203.25,
      "duration_seconds": 2.28,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.23,
      "end_seconds": 205.86,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.69,
      "end_seconds": 209.5,
      "duration_seconds": 2.81,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 216.25,
      "duration_seconds": 4.75,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.91,
      "end_seconds": 221.29,
      "duration_seconds": 3.38,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.88,
      "end_seconds": 242.67,
      "duration_seconds": 3.79,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.62,
      "end_seconds": 246.83,
      "duration_seconds": 3.21,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 265.56,
      "duration_seconds": 8.69,
      "text": "Right, here's what I'm thinking. I think we're dealing with a possible stomach ulcer from anti-inflammatory tablets at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.4,
      "end_seconds": 268.79,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.6,
      "end_seconds": 284.61,
      "duration_seconds": 14.01,
      "text": "It's reasonable to be concerned, but right now a possible stomach ulcer from anti-inflammatory tablets is my leading thought, not anything worse. I think a stool test for helicobacter makes sense here, for dyspepsia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.16,
      "end_seconds": 287.62,
      "duration_seconds": 1.46,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.58,
      "end_seconds": 313.54,
      "duration_seconds": 24.96,
      "text": "A blood count is what I'd like next, for dyspepsia. The treatment will be omeprazole, 20 milligrams, once a day, eight weeks. That should help with stomach ulcer. Stop the ibuprofen and use paracetamol for the knee pain instead. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back in six weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.05,
      "end_seconds": 319.75,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.0,
      "end_seconds": 324.34,
      "duration_seconds": 3.34,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.61,
      "end_seconds": 329.45,
      "duration_seconds": 3.84,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.05,
      "end_seconds": 331.22,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}