{
  "schema_version": "1.0",
  "encounter_id": "02498",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 2.2,
      "duration_seconds": 1.64,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.28,
      "end_seconds": 8.51,
      "duration_seconds": 4.23,
      "text": "Not at all please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.52,
      "end_seconds": 14.81,
      "duration_seconds": 4.29,
      "text": "Well, I've been having constipation then loose stools."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.74,
      "end_seconds": 18.47,
      "duration_seconds": 2.73,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.87,
      "end_seconds": 40.41,
      "duration_seconds": 20.54,
      "text": "Okay, so probably five days. Yeah. Work has been very busy so I kept ignoring it. And I've been feeling bloated as well, for about a week. About feeling bloated, I'd call it moderate."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.93,
      "end_seconds": 42.7,
      "duration_seconds": 1.77,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.22,
      "end_seconds": 49.26,
      "duration_seconds": 5.04,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.07,
      "end_seconds": 53.94,
      "duration_seconds": 3.87,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.67,
      "end_seconds": 58.92,
      "duration_seconds": 4.25,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.56,
      "end_seconds": 71.17,
      "duration_seconds": 4.61,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.08,
      "end_seconds": 77.33,
      "duration_seconds": 4.25,
      "text": "erm, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.17,
      "end_seconds": 80.97,
      "duration_seconds": 2.8,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.81,
      "end_seconds": 90.76,
      "duration_seconds": 5.95,
      "text": "I've had diabetes for two years now i have heart failure"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.1,
      "end_seconds": 95.91,
      "duration_seconds": 3.81,
      "text": "alright, heart failure, that matches what I have here"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 106.14,
      "duration_seconds": 2.86,
      "text": "any surgery in the the past?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.61,
      "end_seconds": 114.25,
      "duration_seconds": 6.64,
      "text": "so, yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.2,
      "end_seconds": 118.89,
      "duration_seconds": 2.69,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.2,
      "end_seconds": 135.23,
      "duration_seconds": 15.03,
      "text": "yeah, I'm on gliclazide, 80 milligrams, twice a day for my sugar. Carvedilol. I take it 6.25 milligrams, twice a day for my heart"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 137.52,
      "duration_seconds": 1.2,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.47,
      "end_seconds": 141.69,
      "duration_seconds": 2.22,
      "text": "for about a month"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.24,
      "end_seconds": 151.65,
      "duration_seconds": 4.41,
      "text": "Did you get urinary symptoms or blood in the stool?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.33,
      "end_seconds": 159.29,
      "duration_seconds": 6.96,
      "text": "yeah I haven't had urinary symptoms or blood in the stool no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.12,
      "end_seconds": 164.38,
      "duration_seconds": 3.26,
      "text": "did you get vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.67,
      "end_seconds": 170.83,
      "duration_seconds": 5.16,
      "text": "um I haven't had vomiting or weight loss no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 175.28,
      "duration_seconds": 4.25,
      "text": "I see, go ahead. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.03,
      "end_seconds": 181.2,
      "duration_seconds": 1.17,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.06,
      "end_seconds": 185.92,
      "duration_seconds": 2.86,
      "text": "Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.68,
      "end_seconds": 201.28,
      "duration_seconds": 2.6,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.06,
      "end_seconds": 224.36,
      "duration_seconds": 4.3,
      "text": "Okay: pressure 113 over 66, pulse 101, temperature 39.3."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.96,
      "end_seconds": 226.74,
      "duration_seconds": 1.78,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 231.3,
      "duration_seconds": 4.03,
      "text": "they help me see the whole picture more shortly"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.13,
      "end_seconds": 239.02,
      "duration_seconds": 4.89,
      "text": "I'll need to examine you for this, it it won't take long"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.99,
      "end_seconds": 244.29,
      "duration_seconds": 3.3,
      "text": "take a a deep breath for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.49,
      "end_seconds": 263.95,
      "duration_seconds": 5.46,
      "text": "it is tender in the lower left with no guarding or rigidity"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.84,
      "end_seconds": 285.13,
      "duration_seconds": 15.29,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. I'd lean towards acute diverticulitis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.44,
      "end_seconds": 313.12,
      "duration_seconds": 9.68,
      "text": "I want blood tests done, that's for abdominal pain. I'll request a CT scan, it'll help with left iliac fossa pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.04,
      "end_seconds": 316.21,
      "duration_seconds": 1.17,
      "text": "mm alright"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.1,
      "end_seconds": 342.09,
      "duration_seconds": 23.99,
      "text": "I'm going to put you on co-amoxiclav, 625 milligrams, three times a day, five days. That's for diverticulitis. Drink plenty and start with a light diet. Come back or go to emergency straight away if the symptoms get worse. I'd like you back in one week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.92,
      "end_seconds": 348.6,
      "duration_seconds": 4.68,
      "text": "Uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.66,
      "end_seconds": 352.04,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}