{
  "schema_version": "1.0",
  "encounter_id": "02134",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.54,
      "duration_seconds": 2.93,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.68,
      "end_seconds": 8.65,
      "duration_seconds": 3.97,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.23,
      "end_seconds": 17.78,
      "duration_seconds": 8.55,
      "text": "Hello, doctor. I'm here with them in case I can help. He's been having a very fast heartbeat, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 22.75,
      "duration_seconds": 3.03,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.32,
      "end_seconds": 28.08,
      "duration_seconds": 4.76,
      "text": "I'd say one week. Actually, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.94,
      "end_seconds": 33.32,
      "duration_seconds": 3.38,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.88,
      "end_seconds": 41.83,
      "duration_seconds": 6.95,
      "text": "Severe, really. There was a high temperature, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.81,
      "end_seconds": 60.71,
      "duration_seconds": 2.9,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.26,
      "end_seconds": 70.81,
      "duration_seconds": 2.55,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.08,
      "end_seconds": 94.46,
      "duration_seconds": 13.38,
      "text": "Okay: BMI works out to 26.3, temperature is 38.4 degrees, weight 89 kilos, height 184 centimetres, heart rate 98, blood pressure 110 over 78, saturation 98 percent."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 100.92,
      "duration_seconds": 3.97,
      "text": "Alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.79,
      "end_seconds": 104.35,
      "duration_seconds": 1.56,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.49,
      "end_seconds": 108.29,
      "duration_seconds": 2.8,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.08,
      "end_seconds": 130.65,
      "duration_seconds": 6.57,
      "text": "you are hot, shaking, and and your pulse is over one hundred and forty and irregular"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.63,
      "end_seconds": 143.14,
      "duration_seconds": 6.51,
      "text": "You can relax now. Right, any recent infection or chest pain at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.96,
      "end_seconds": 148.69,
      "duration_seconds": 3.73,
      "text": "no, no recent infection or chest pain"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.0,
      "end_seconds": 154.13,
      "duration_seconds": 4.13,
      "text": "Anything on the the skin I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.77,
      "end_seconds": 159.32,
      "duration_seconds": 4.55,
      "text": "Mm, uh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.35,
      "end_seconds": 164.21,
      "duration_seconds": 3.86,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 164.96,
      "end_seconds": 170.87,
      "duration_seconds": 5.91,
      "text": "Sorry, what was I saying, it's lansoprazole, 30 milligrams, before breakfast, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.29,
      "end_seconds": 176.92,
      "duration_seconds": 4.63,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.38,
      "end_seconds": 182.8,
      "duration_seconds": 1.42,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.46,
      "end_seconds": 185.82,
      "duration_seconds": 1.36,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 192.1,
      "duration_seconds": 4.26,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.12,
      "end_seconds": 198.98,
      "duration_seconds": 1.86,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.77,
      "end_seconds": 207.79,
      "duration_seconds": 4.02,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 213.17,
      "duration_seconds": 2.53,
      "text": "Okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.08,
      "end_seconds": 216.49,
      "duration_seconds": 2.41,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.22,
      "end_seconds": 220.04,
      "duration_seconds": 2.82,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.15,
      "end_seconds": 229.11,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.15,
      "end_seconds": 233.06,
      "duration_seconds": 2.91,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.98,
      "end_seconds": 238.57,
      "duration_seconds": 4.59,
      "text": "Right, I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.39,
      "end_seconds": 241.92,
      "duration_seconds": 2.53,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.7,
      "end_seconds": 248.74,
      "duration_seconds": 5.04,
      "text": "I've had acid reflux for about a year now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.0,
      "end_seconds": 255.25,
      "duration_seconds": 5.25,
      "text": "Okay, I can see acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.9,
      "end_seconds": 277.95,
      "duration_seconds": 8.05,
      "text": "so where does that leave us? My working impression is a thyroid storm another possibility is sepsis"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.02,
      "end_seconds": 283.58,
      "duration_seconds": 3.56,
      "text": "Well, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.56,
      "end_seconds": 297.16,
      "duration_seconds": 10.6,
      "text": "I understand the worry. At the moment I'd say it's a thyroid storm, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.68,
      "end_seconds": 312.61,
      "duration_seconds": 4.93,
      "text": "I'll request urgent blood tests, it'll help with thyroid storm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.53,
      "end_seconds": 316.32,
      "duration_seconds": 2.79,
      "text": "Mm, that's fine with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.02,
      "end_seconds": 344.17,
      "duration_seconds": 27.15,
      "text": "I'm going to put you on propranolol, 1 milligrams, now, single dose. It's for thyroid storm. The pharmacy will go through the details again when you pick it up. This is an emergency, you will be treated in high dependency. An ECG is something we might do if this doesn't improve in a month. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.12,
      "end_seconds": 347.37,
      "duration_seconds": 2.25,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.15,
      "end_seconds": 350.63,
      "duration_seconds": 1.48,
      "text": "Take care now."
    }
  ]
}