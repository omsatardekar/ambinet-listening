  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 4.99,
      "duration_seconds": 4.37,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.11,
      "end_seconds": 10.11,
      "duration_seconds": 4.0,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.99,
      "end_seconds": 16.97,
      "duration_seconds": 4.98,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 21.95,
      "duration_seconds": 3.17,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.82,
      "end_seconds": 25.99,
      "duration_seconds": 3.17,
      "text": "I'm here because of no symptoms."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.79,
      "end_seconds": 31.62,
      "duration_seconds": 3.83,
      "text": "Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 46.3,
      "duration_seconds": 13.06,
      "text": "Since last Tuesday, that's when it began. Sorry, I know I'm rambling a bit. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 51.1,
      "duration_seconds": 3.23,
      "text": "So, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.25,
      "end_seconds": 67.13,
      "duration_seconds": 14.88,
      "text": "When it starts I tend to get a new partner as well. As for new partner, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.54,
      "end_seconds": 74.28,
      "duration_seconds": 5.74,
      "text": "Have you had no symptoms before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 80.04,
      "duration_seconds": 5.11,
      "text": "Right, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.32,
      "end_seconds": 92.38,
      "duration_seconds": 3.06,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.25,
      "end_seconds": 102.39,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.49,
      "end_seconds": 129.85,
      "duration_seconds": 7.36,
      "text": "Okay: heart rate 73, temp 36.7 degrees, blood pressure 117 over 72, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.16,
      "end_seconds": 133.46,
      "duration_seconds": 2.3,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.31,
      "end_seconds": 135.9,
      "duration_seconds": 1.59,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.25,
      "end_seconds": 157.0,
      "duration_seconds": 2.75,
      "text": "There are no visible sores or discharge."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.7,
      "end_seconds": 172.6,
      "duration_seconds": 0.9,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.66,
      "end_seconds": 182.98,
      "duration_seconds": 7.32,
      "text": "Thank you, you can get dressed. A few quick ones: discharge, burning when passing urine or sores?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.43,
      "end_seconds": 190.39,
      "duration_seconds": 5.96,
      "text": "No discharge, burning when passing urine or sores, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 192.35,
      "duration_seconds": 1.29,
      "text": "How about rash?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.87,
      "end_seconds": 195.77,
      "duration_seconds": 2.9,
      "text": "Not that I've noticed, no rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.51,
      "end_seconds": 198.49,
      "duration_seconds": 1.98,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.59,
      "end_seconds": 201.77,
      "duration_seconds": 2.18,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.63,
      "end_seconds": 205.72,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.74,
      "end_seconds": 210.94,
      "duration_seconds": 4.2,
      "text": "Apixaban, 5 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.22,
      "end_seconds": 220.36,
      "duration_seconds": 4.14,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.24,
      "end_seconds": 224.21,
      "duration_seconds": 1.97,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.3,
      "end_seconds": 227.65,
      "duration_seconds": 2.35,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.27,
      "end_seconds": 235.94,
      "duration_seconds": 4.67,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.14,
      "end_seconds": 239.87,
      "duration_seconds": 2.73,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.73,
      "end_seconds": 244.05,
      "duration_seconds": 2.32,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.58,
      "end_seconds": 248.31,
      "duration_seconds": 2.73,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.26,
      "end_seconds": 262.21,
      "duration_seconds": 11.95,
      "text": "My husband and I live above the shop. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.84,
      "end_seconds": 269.93,
      "duration_seconds": 3.09,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.83,
      "end_seconds": 276.7,
      "duration_seconds": 3.87,
      "text": "I'm allergic to erythromycin, I get a rash."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.28,
      "end_seconds": 291.28,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.81,
      "end_seconds": 297.18,
      "duration_seconds": 5.37,
      "text": "I've, I've had an irregular heartbeat for about a year now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.15,
      "end_seconds": 328.05,
      "duration_seconds": 29.9,
      "text": "Okay, thinking it through, this looks most like a routine screen with no symptoms. I want a urine test for chlamydia and gonorrhoea done, that's for sexual health screen. I'm going to order blood tests for HIV and syphilis, for sexual health screen. Use condoms with new partners and we will text the results. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.52,
      "end_seconds": 335.57,
      "duration_seconds": 6.05,
      "text": "Sorry, what was I saying, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.61,
      "end_seconds": 345.66,
      "duration_seconds": 8.05,
      "text": "Book a review after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.4,
      "end_seconds": 349.62,
      "duration_seconds": 2.22,
      "text": "Alright, thanks, take care."
    }
  ]
}