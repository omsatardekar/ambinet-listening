      "role": "PATIENT",
      "start_seconds": 6.55,
      "end_seconds": 9.97,
      "duration_seconds": 3.42,
      "text": "Morning doctor sorry about the the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.14,
      "end_seconds": 13.09,
      "duration_seconds": 1.95,
      "text": "weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 20.36,
      "duration_seconds": 5.54,
      "text": "it it has. I got caught in the rain walking over"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.53,
      "end_seconds": 26.98,
      "duration_seconds": 2.45,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 41.72,
      "duration_seconds": 13.11,
      "text": "yeah, it's dark urine i don't know what's causing it i told my wife I'd come today i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 48.11,
      "duration_seconds": 2.34,
      "text": "did it come on recently?"
