    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.73,
      "end_seconds": 239.68,
      "duration_seconds": 9.95,
      "text": "Okay: heart rate 83 blood pressure 112 over 79 temp 37.0 degrees respiratory rate 18 SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.59,
      "end_seconds": 243.0,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 246.46,
      "duration_seconds": 2.7,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.32,
      "end_seconds": 250.75,
      "duration_seconds": 2.43,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 254.33,
      "duration_seconds": 2.72,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.54,
      "end_seconds": 270.77,
      "duration_seconds": 6.23,
      "text": "The whites of the eyes are yellow and the liver edge is tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.9,
      "end_seconds": 276.65,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
