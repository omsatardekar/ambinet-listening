      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.05,
      "end_seconds": 302.25,
      "duration_seconds": 7.2,
      "text": "I'm sending you for a hepatitis screen cos of jaundice i'll want another look in one week"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.95,
      "end_seconds": 306.54,
      "duration_seconds": 3.59,
      "text": "Um I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.95,
      "end_seconds": 310.58,
      "duration_seconds": 2.63,
      "text": "does all of that make sense?"
