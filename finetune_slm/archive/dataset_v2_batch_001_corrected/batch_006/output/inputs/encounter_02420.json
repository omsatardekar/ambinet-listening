    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.3,
      "end_seconds": 66.04,
      "duration_seconds": 1.74,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.44,
      "end_seconds": 68.34,
      "duration_seconds": 1.9,
      "text": "I see go ahead"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.89,
      "end_seconds": 85.71,
      "duration_seconds": 2.82,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.8,
      "end_seconds": 91.64,
      "duration_seconds": 3.84,
      "text": "No, not that that I know of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.35,
      "end_seconds": 97.54,
      "duration_seconds": 4.19,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.32,
      "end_seconds": 110.78,
      "duration_seconds": 12.46,
      "text": "I look after my grandchildren most days. I do a yoga class on Thursdays. I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 127.7,
      "duration_seconds": 3.21,
      "text": "right, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.38,
      "end_seconds": 131.04,
      "duration_seconds": 2.66,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 146.68,
      "duration_seconds": 4.47,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.74,
      "end_seconds": 151.81,
      "duration_seconds": 4.07,
      "text": "No, you know, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.51,
      "end_seconds": 156.35,
      "duration_seconds": 2.84,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.86,
      "end_seconds": 160.84,
      "duration_seconds": 3.98,
      "text": "Right, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.83,
      "end_seconds": 164.96,
      "duration_seconds": 3.13,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.82,
      "end_seconds": 167.93,
      "duration_seconds": 2.11,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.9,
      "end_seconds": 170.22,
      "duration_seconds": 1.32,
      "text": "nothing like itching?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.5,
      "end_seconds": 174.41,
      "duration_seconds": 2.91,
      "text": "no, I haven't had any itching"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.12,
      "end_seconds": 179.77,
      "duration_seconds": 4.65,
      "text": "a few quick ones: vomiting blood, high fever or confusion?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.72,
      "end_seconds": 183.49,
      "duration_seconds": 2.77,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.15,
      "end_seconds": 188.04,
      "duration_seconds": 3.89,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.99,
      "end_seconds": 191.38,
      "duration_seconds": 1.39,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.41,
      "end_seconds": 196.51,
      "duration_seconds": 3.1,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.26,
      "end_seconds": 213.01,
      "duration_seconds": 2.75,
      "text": "that's it, just a little longer.."
