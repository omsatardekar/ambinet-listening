      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.04,
      "end_seconds": 59.07,
      "duration_seconds": 9.03,
      "text": "Let me think it's been going on for one week. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.71,
      "end_seconds": 62.62,
      "duration_seconds": 2.91,
      "text": "Right, any yellow eyes as well?"
