{
  "schema_version": "1.0",
  "encounter_id": "02044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.65,
      "duration_seconds": 3.93,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 10.4,
      "duration_seconds": 4.08,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.85,
      "end_seconds": 15.67,
      "duration_seconds": 3.82,
      "text": "It's attacks of spinning lasting hours, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.76,
      "end_seconds": 21.24,
      "duration_seconds": 3.48,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.7,
      "end_seconds": 26.26,
      "duration_seconds": 3.56,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.37,
      "end_seconds": 31.7,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.21,
      "end_seconds": 37.18,
      "duration_seconds": 3.97,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.06,
      "end_seconds": 40.54,
      "duration_seconds": 2.48,
      "text": "So, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.49,
      "end_seconds": 42.96,
      "duration_seconds": 1.47,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.96,
      "end_seconds": 48.08,
      "duration_seconds": 3.12,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.14,
      "end_seconds": 52.51,
      "duration_seconds": 3.37,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.46,
      "end_seconds": 55.62,
      "duration_seconds": 2.16,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.32,
      "end_seconds": 61.34,
      "duration_seconds": 4.02,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.11,
      "end_seconds": 64.06,
      "duration_seconds": 1.95,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.64,
      "end_seconds": 70.24,
      "duration_seconds": 5.6,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.22,
      "end_seconds": 74.35,
      "duration_seconds": 3.13,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.89,
      "end_seconds": 79.09,
      "duration_seconds": 4.2,
      "text": "I'm on lisinopril, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.55,
      "end_seconds": 83.28,
      "duration_seconds": 3.73,
      "text": "Hm, okay. Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.79,
      "end_seconds": 87.8,
      "duration_seconds": 3.01,
      "text": "I've, I've got high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.09,
      "end_seconds": 105.49,
      "duration_seconds": 16.4,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.58,
      "end_seconds": 111.47,
      "duration_seconds": 3.89,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.41,
      "end_seconds": 124.91,
      "duration_seconds": 2.5,
      "text": "Have you noticed weakness or headache?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.03,
      "end_seconds": 128.43,
      "duration_seconds": 2.4,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.62,
      "end_seconds": 135.56,
      "duration_seconds": 3.94,
      "text": "Any double vision or ear discharge at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.33,
      "end_seconds": 145.37,
      "duration_seconds": 5.04,
      "text": "I haven't had double vision or ear discharge, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 148.67,
      "duration_seconds": 2.98,
      "text": "Ah. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.55,
      "end_seconds": 152.73,
      "duration_seconds": 2.18,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.73,
      "end_seconds": 168.5,
      "duration_seconds": 2.77,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.28,
      "end_seconds": 182.41,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.82,
      "end_seconds": 199.37,
      "duration_seconds": 7.55,
      "text": "Okay: temp 36.6 degrees, blood pressure 114 over 69, pulse 79, respiratory rate 18."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.63,
      "end_seconds": 204.29,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.99,
      "end_seconds": 207.34,
      "duration_seconds": 2.35,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.3,
      "end_seconds": 211.28,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.08,
      "end_seconds": 214.57,
      "duration_seconds": 1.49,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.95,
      "end_seconds": 218.08,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 233.52,
      "duration_seconds": 5.76,
      "text": "The ear drums look normal and the hearing is reduced on the left."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.29,
      "end_seconds": 239.99,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.88,
      "end_seconds": 253.13,
      "duration_seconds": 5.25,
      "text": "Okay, so my impression is this: I'd lean towards Meniere's disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.98,
      "end_seconds": 259.18,
      "duration_seconds": 3.2,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.74,
      "end_seconds": 279.9,
      "duration_seconds": 19.16,
      "text": "It's reasonable to be concerned, but right now Meniere's disease is my leading thought, not anything worse. Let me just check I've got this right. You've had attacks of spinning lasting hours for one week, and no double vision or headache."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.5,
      "end_seconds": 283.08,
      "duration_seconds": 1.58,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.8,
      "end_seconds": 303.99,
      "duration_seconds": 5.19,
      "text": "A hearing test is what I'd like next, for vertigo and hearing loss."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.86,
      "end_seconds": 307.46,
      "duration_seconds": 2.6,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.06,
      "end_seconds": 329.02,
      "duration_seconds": 20.96,
      "text": "We'll begin with betahistine, 16 milligrams, three times a day, long term. That should help with vertigo. Cut down on salt and caffeine. I think the ENT clinic should see you too. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.25,
      "end_seconds": 331.95,
      "duration_seconds": 1.7,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.88,
      "end_seconds": 336.79,
      "duration_seconds": 3.91,
      "text": "Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.74,
      "end_seconds": 338.44,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.69,
      "end_seconds": 342.52,
      "duration_seconds": 2.83,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.29,
      "end_seconds": 346.31,
      "duration_seconds": 2.02,
      "text": "Thank you, that's helpful."
    }
  ]
}