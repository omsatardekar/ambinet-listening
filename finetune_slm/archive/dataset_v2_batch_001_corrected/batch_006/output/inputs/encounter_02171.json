    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.34,
      "end_seconds": 27.17,
      "duration_seconds": 11.83,
      "text": "um, so... a lump in my left breast that's why I came my family kept telling me to get it checked"
    },
    {
