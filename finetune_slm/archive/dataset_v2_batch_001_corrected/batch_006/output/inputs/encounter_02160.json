      "role": "DOCTOR",
      "start_seconds": 125.41,
      "end_seconds": 127.53,
      "duration_seconds": 2.12,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 131.66,
      "duration_seconds": 2.74,
      "text": "Let's move on to the examination."
