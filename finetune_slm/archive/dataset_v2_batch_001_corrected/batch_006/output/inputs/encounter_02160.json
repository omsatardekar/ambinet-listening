      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.36,
      "end_seconds": 119.02,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
