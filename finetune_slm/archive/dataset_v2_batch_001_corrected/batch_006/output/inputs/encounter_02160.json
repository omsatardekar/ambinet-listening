    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.65,
      "end_seconds": 53.45,
      "duration_seconds": 9.8,
      "text": "Yeah. About three months, I'd say. I've, I've also had a dull ache in my back."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.58,
      "end_seconds": 57.35,
      "duration_seconds": 2.77,
      "text": "Is it constant or in episodes?"
