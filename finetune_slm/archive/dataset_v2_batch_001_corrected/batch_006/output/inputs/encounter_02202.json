{
  "schema_version": "1.0",
  "encounter_id": "02202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 4.12,
      "duration_seconds": 3.14,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 7.86,
      "end_seconds": 13.58,
      "duration_seconds": 5.72,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.09,
      "end_seconds": 15.54,
      "duration_seconds": 1.45,
      "text": "Was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.52,
      "end_seconds": 21.62,
      "duration_seconds": 5.1,
      "text": "Not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.35,
      "end_seconds": 25.81,
      "duration_seconds": 2.46,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 33.71,
      "duration_seconds": 7.21,
      "text": "Honestly, it's dribbling after passing urine, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.95,
      "end_seconds": 38.68,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.48,
      "end_seconds": 43.83,
      "duration_seconds": 3.35,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.9,
      "end_seconds": 47.29,
      "duration_seconds": 2.39,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.16,
      "end_seconds": 51.4,
      "duration_seconds": 2.24,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.54,
      "end_seconds": 55.4,
      "duration_seconds": 2.86,
      "text": "Any a weak urine stream as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.17,
      "end_seconds": 58.26,
      "duration_seconds": 2.09,
      "text": "Yes, for ten days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.88,
      "end_seconds": 81.28,
      "duration_seconds": 6.4,
      "text": "Let me check a few things. Any weight loss, burning on passing urine or back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.52,
      "end_seconds": 87.89,
      "duration_seconds": 5.37,
      "text": "No, no weight loss, burning on passing urine or back pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.88,
      "end_seconds": 92.38,
      "duration_seconds": 3.5,
      "text": "Did you notice any blood in the urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.95,
      "end_seconds": 98.27,
      "duration_seconds": 4.32,
      "text": "No, I haven't had any blood in the urine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.92,
      "end_seconds": 103.9,
      "duration_seconds": 3.98,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.64,
      "end_seconds": 108.2,
      "duration_seconds": 2.56,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.05,
      "end_seconds": 112.51,
      "duration_seconds": 2.46,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.29,
      "end_seconds": 116.29,
      "duration_seconds": 2.0,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.11,
      "end_seconds": 124.15,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.94,
      "end_seconds": 129.8,
      "duration_seconds": 4.86,
      "text": "I've got arthritis in my knees. I, I have eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.38,
      "end_seconds": 136.28,
      "duration_seconds": 5.9,
      "text": "Alright, arthritis in your knees and eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.07,
      "end_seconds": 154.0,
      "duration_seconds": 2.93,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.27,
      "end_seconds": 158.42,
      "duration_seconds": 3.15,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.98,
      "end_seconds": 161.38,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.43,
      "end_seconds": 167.75,
      "duration_seconds": 5.32,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.46,
      "end_seconds": 170.36,
      "duration_seconds": 1.9,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.38,
      "end_seconds": 175.28,
      "duration_seconds": 2.9,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.49,
      "end_seconds": 178.54,
      "duration_seconds": 2.05,
      "text": "So, and your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.87,
      "end_seconds": 183.51,
      "duration_seconds": 3.64,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.59,
      "end_seconds": 187.99,
      "duration_seconds": 2.4,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.6,
      "end_seconds": 191.83,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.3,
      "end_seconds": 195.26,
      "duration_seconds": 1.96,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.16,
      "end_seconds": 201.2,
      "duration_seconds": 4.04,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 207.54,
      "duration_seconds": 4.55,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.93,
      "end_seconds": 212.02,
      "duration_seconds": 3.09,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.6,
      "end_seconds": 215.88,
      "duration_seconds": 3.28,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 217.77,
      "end_seconds": 228.03,
      "duration_seconds": 10.26,
      "text": "It's diclofenac, 50 milligrams, when needed, doctor. He is on hydrocortisone cream, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 233.49,
      "duration_seconds": 5.25,
      "text": "I follow. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.36,
      "end_seconds": 242.79,
      "duration_seconds": 2.43,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.6,
      "end_seconds": 265.37,
      "duration_seconds": 8.77,
      "text": "Okay: temp 36.7 degrees, respiratory rate 14, heart rate 80, blood pressure 126 over 69, saturation 99 percent."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.61,
      "end_seconds": 268.88,
      "duration_seconds": 2.27,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.81,
      "end_seconds": 272.43,
      "duration_seconds": 2.62,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 294.85,
      "duration_seconds": 14.9,
      "text": "Okay, so my impression from what you've said is this: This looks most like benign prostate enlargement. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.89,
      "end_seconds": 297.91,
      "duration_seconds": 2.02,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.01,
      "end_seconds": 321.67,
      "duration_seconds": 22.66,
      "text": "I can't promise yet, but most people with benign prostate enlargement do well once it's treated properly. I want a urine dipstick done, that's for urinary symptoms. What I'm giving you is tamsulosin, 400 micrograms, once a day after food, long term. That should help with urinary symptoms."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.2,
      "end_seconds": 326.82,
      "duration_seconds": 3.62,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.9,
      "end_seconds": 334.74,
      "duration_seconds": 6.84,
      "text": "Cut down on caffeine and fluids in the evening. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.07,
      "end_seconds": 338.96,
      "duration_seconds": 2.89,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.94,
      "end_seconds": 345.25,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}