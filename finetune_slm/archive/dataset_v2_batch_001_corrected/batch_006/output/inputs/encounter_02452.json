{
  "schema_version": "1.0",
  "encounter_id": "02452",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 3.93,
      "duration_seconds": 3.16,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.27,
      "end_seconds": 8.96,
      "duration_seconds": 3.69,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.34,
      "end_seconds": 21.6,
      "duration_seconds": 11.26,
      "text": "Well, I've been having a high fever and shivers. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.21,
      "end_seconds": 26.01,
      "duration_seconds": 3.8,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.74,
      "end_seconds": 35.21,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.97,
      "end_seconds": 50.45,
      "duration_seconds": 5.48,
      "text": "Okay: pulse is 100 beats a minute, pressure 93 over 59."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 53.7,
      "duration_seconds": 1.38,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.99,
      "end_seconds": 58.91,
      "duration_seconds": 3.92,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.45,
      "end_seconds": 72.07,
      "duration_seconds": 3.62,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.23,
      "end_seconds": 81.67,
      "duration_seconds": 6.44,
      "text": "About two weeks, I think... sorry, about a week, I got that wrong."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.05,
      "end_seconds": 88.08,
      "duration_seconds": 5.03,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.06,
      "end_seconds": 90.97,
      "duration_seconds": 1.91,
      "text": "honestly, every other day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.45,
      "end_seconds": 96.43,
      "duration_seconds": 4.98,
      "text": "mm-hmm. Okay, have you had any recent cut or diarrhoea?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.01,
      "end_seconds": 99.43,
      "duration_seconds": 2.42,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.0,
      "end_seconds": 101.82,
      "duration_seconds": 0.82,
      "text": "Any cough?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.56,
      "end_seconds": 105.97,
      "duration_seconds": 3.41,
      "text": "not at all, uh, no cough"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.71,
      "end_seconds": 109.27,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.89,
      "end_seconds": 112.51,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.08,
      "end_seconds": 118.03,
      "duration_seconds": 4.95,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.57,
      "end_seconds": 120.59,
      "duration_seconds": 2.02,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.64,
      "end_seconds": 141.53,
      "duration_seconds": 2.89,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.92,
      "end_seconds": 145.65,
      "duration_seconds": 2.73,
      "text": "Diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 155.18,
      "duration_seconds": 7.98,
      "text": "Yes, carry on. Let's run through your medicines. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.51,
      "end_seconds": 158.9,
      "duration_seconds": 2.39,
      "text": "Gliclazide, twice a day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.87,
      "end_seconds": 162.86,
      "duration_seconds": 1.99,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.26,
      "end_seconds": 172.18,
      "duration_seconds": 4.92,
      "text": "80 milligrams, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.67,
      "end_seconds": 179.29,
      "duration_seconds": 5.62,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.99,
      "end_seconds": 192.91,
      "duration_seconds": 12.92,
      "text": "My husband and I live above the shop. I retired from the post office two years ago. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.93,
      "end_seconds": 198.72,
      "duration_seconds": 4.79,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.59,
      "end_seconds": 201.81,
      "duration_seconds": 2.22,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.73,
      "end_seconds": 226.71,
      "duration_seconds": 7.98,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.68,
      "end_seconds": 234.31,
      "duration_seconds": 1.63,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 252.57,
      "duration_seconds": 5.39,
      "text": "Having listened and examined, it points towards a possible necrotising soft tissue infection."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 285.06,
      "duration_seconds": 24.8,
      "text": "I think an urgent surgical review makes sense here, for possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Do get help quickly if the symptoms get worse. I'd like you back straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.63,
      "end_seconds": 289.94,
      "duration_seconds": 4.31,
      "text": "so, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.03,
      "end_seconds": 296.78,
      "duration_seconds": 4.75,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.79,
      "end_seconds": 301.2,
      "duration_seconds": 2.41,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.67,
      "end_seconds": 304.08,
      "duration_seconds": 1.41,
      "text": "take care now"
    }
  ]
}