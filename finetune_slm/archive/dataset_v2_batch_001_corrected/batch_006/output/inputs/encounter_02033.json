{
  "schema_version": "1.0",
  "encounter_id": "02033",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.21,
      "end_seconds": 6.93,
      "duration_seconds": 5.72,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.88,
      "end_seconds": 12.25,
      "duration_seconds": 4.37,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.94,
      "end_seconds": 18.81,
      "duration_seconds": 4.87,
      "text": "So the thing is, I've got very heavy periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.47,
      "end_seconds": 22.16,
      "duration_seconds": 1.69,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.33,
      "end_seconds": 27.14,
      "duration_seconds": 3.81,
      "text": "Yeah, it's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.6,
      "end_seconds": 32.04,
      "duration_seconds": 4.44,
      "text": "I follow. So, what do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.3,
      "end_seconds": 35.75,
      "duration_seconds": 2.45,
      "text": "Double protection helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 37.21,
      "end_seconds": 52.3,
      "duration_seconds": 15.09,
      "text": "Doctor, I've got the readings for you. BMI works out to 25.2, weight 80 kilos, height 178 centimetres, heart rate 105, pressure 120 over 76, temperature is 36.8 degrees, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.18,
      "end_seconds": 55.17,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.94,
      "end_seconds": 60.1,
      "duration_seconds": 2.16,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.74,
      "end_seconds": 62.3,
      "duration_seconds": 1.56,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.8,
      "end_seconds": 65.76,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.58,
      "end_seconds": 81.08,
      "duration_seconds": 5.5,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.42,
      "end_seconds": 90.54,
      "duration_seconds": 6.12,
      "text": "Right, that's the examination finished. And what about weight loss, pain or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 95.4,
      "duration_seconds": 3.79,
      "text": "No, no weight loss, pain or fainting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.93,
      "end_seconds": 99.21,
      "duration_seconds": 2.28,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.83,
      "end_seconds": 105.32,
      "duration_seconds": 1.49,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.33,
      "end_seconds": 118.94,
      "duration_seconds": 2.61,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.69,
      "end_seconds": 124.03,
      "duration_seconds": 3.34,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.48,
      "end_seconds": 130.55,
      "duration_seconds": 5.07,
      "text": "Alright, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.58,
      "end_seconds": 141.32,
      "duration_seconds": 8.74,
      "text": "It's metformin, 500 milligrams, twice a day. I'm on escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.57,
      "end_seconds": 159.95,
      "duration_seconds": 2.38,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.76,
      "end_seconds": 164.44,
      "duration_seconds": 2.68,
      "text": "Mm, no, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.37,
      "end_seconds": 180.38,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.75,
      "end_seconds": 186.3,
      "duration_seconds": 4.55,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.5,
      "end_seconds": 189.86,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.95,
      "end_seconds": 195.22,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.57,
      "end_seconds": 213.97,
      "duration_seconds": 2.4,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.09,
      "end_seconds": 237.55,
      "duration_seconds": 18.46,
      "text": "Well, I've had diabetes for five years now. I'd rather not end up on lots of tablets if I can avoid it. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.19,
      "end_seconds": 244.07,
      "duration_seconds": 2.88,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.69,
      "end_seconds": 256.25,
      "duration_seconds": 10.56,
      "text": "Depression, for two years. My family kept telling me to get it checked. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 263.16,
      "duration_seconds": 5.68,
      "text": "So where does that leave us? It points towards heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.03,
      "end_seconds": 266.96,
      "duration_seconds": 1.93,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.95,
      "end_seconds": 305.08,
      "duration_seconds": 36.13,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency, but I'd like to confirm. I'm sending you for a ferritin level because of heavy periods. That will help us see what's going on underneath and decide the next step. I'm going to put you on ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. That should help with iron deficiency. Keep a pad count diary."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.82,
      "end_seconds": 308.16,
      "duration_seconds": 2.34,
      "text": "We'll catch up after the results."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.81,
      "end_seconds": 311.61,
      "duration_seconds": 2.8,
      "text": "I, I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.24,
      "end_seconds": 314.93,
      "duration_seconds": 2.69,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 316.88,
      "end_seconds": 319.83,
      "duration_seconds": 2.95,
      "text": "Um, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.6,
      "end_seconds": 321.96,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
}