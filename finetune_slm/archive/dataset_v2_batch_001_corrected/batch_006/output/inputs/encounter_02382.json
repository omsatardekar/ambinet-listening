    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.73,
      "end_seconds": 162.11,
      "duration_seconds": 4.38,
      "text": "okay is there anything relevant on the family side?"
