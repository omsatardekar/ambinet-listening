      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.52,
      "end_seconds": 167.92,
      "duration_seconds": 4.4,
      "text": "Okay you know so my brother has epilepsy."
