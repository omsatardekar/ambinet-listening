      "text": "I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.55,
      "end_seconds": 184.0,
      "duration_seconds": 2.45,
      "text": "Let's move on to the examination."
