      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.65,
      "end_seconds": 203.17,
      "duration_seconds": 6.52,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.34,
      "end_seconds": 205.84,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
