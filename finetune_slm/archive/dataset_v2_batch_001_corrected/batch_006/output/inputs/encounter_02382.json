      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.11,
      "end_seconds": 211.69,
      "duration_seconds": 1.58,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.64,
      "end_seconds": 230.71,
      "duration_seconds": 10.07,
      "text": "having listened and examined, it points towards an infected diabetic foot ulcer. I wanna be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.8,
      "end_seconds": 239.17,
      "duration_seconds": 3.37,
      "text": "what are the odds it's serious?"
    },
