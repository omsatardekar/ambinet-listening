{
  "schema_version": "1.0",
  "encounter_id": "02398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.34,
      "duration_seconds": 3.14,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.72,
      "end_seconds": 12.87,
      "duration_seconds": 4.15,
      "text": "Alright, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.99,
      "end_seconds": 27.65,
      "duration_seconds": 11.66,
      "text": "I've, I've been dealing with a feeling of something stuck in my throat. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.31,
      "end_seconds": 31.27,
      "duration_seconds": 1.96,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.95,
      "end_seconds": 34.45,
      "duration_seconds": 1.5,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.09,
      "end_seconds": 38.9,
      "duration_seconds": 3.81,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.81,
      "end_seconds": 43.59,
      "duration_seconds": 2.78,
      "text": "It's been like this since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 47.85,
      "duration_seconds": 3.7,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.52,
      "end_seconds": 50.52,
      "duration_seconds": 1.0,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.21,
      "end_seconds": 56.66,
      "duration_seconds": 2.45,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.73,
      "end_seconds": 66.62,
      "duration_seconds": 7.89,
      "text": "When it starts I tend to get a sharp scratch when swallowing as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.04,
      "end_seconds": 73.46,
      "duration_seconds": 2.42,
      "text": "Any drooling or difficulty breathing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.27,
      "end_seconds": 77.36,
      "duration_seconds": 3.09,
      "text": "No, no drooling or difficulty breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 80.8,
      "duration_seconds": 2.43,
      "text": "Any blood or neck swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.76,
      "end_seconds": 86.17,
      "duration_seconds": 4.41,
      "text": "I haven't had blood or neck swelling, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.57,
      "end_seconds": 90.03,
      "duration_seconds": 2.46,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.13,
      "end_seconds": 96.08,
      "duration_seconds": 1.95,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.28,
      "end_seconds": 102.16,
      "duration_seconds": 2.88,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.24,
      "end_seconds": 110.7,
      "duration_seconds": 6.46,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.86,
      "end_seconds": 125.98,
      "duration_seconds": 4.12,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.78,
      "end_seconds": 134.14,
      "duration_seconds": 3.36,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.16,
      "end_seconds": 145.56,
      "duration_seconds": 4.4,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.25,
      "end_seconds": 148.39,
      "duration_seconds": 2.14,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.99,
      "end_seconds": 168.16,
      "duration_seconds": 2.17,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.33,
      "end_seconds": 176.06,
      "duration_seconds": 3.73,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.05,
      "end_seconds": 180.12,
      "duration_seconds": 3.07,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.02,
      "end_seconds": 183.89,
      "duration_seconds": 2.87,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.95,
      "end_seconds": 188.99,
      "duration_seconds": 3.04,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.8,
      "end_seconds": 200.03,
      "duration_seconds": 2.23,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.11,
      "end_seconds": 222.18,
      "duration_seconds": 6.07,
      "text": "Okay: SpO2 97 percent on room air, heart rate 64, BP is 114 over 70."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.93,
      "end_seconds": 228.79,
      "duration_seconds": 3.86,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.26,
      "end_seconds": 232.71,
      "duration_seconds": 2.45,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.61,
      "end_seconds": 254.76,
      "duration_seconds": 5.15,
      "text": "I can't see anything in the throat and the neck is not tender."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.42,
      "end_seconds": 262.31,
      "duration_seconds": 2.89,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.56,
      "end_seconds": 286.43,
      "duration_seconds": 12.87,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a possible fish bone scratch or lodged bone, or it might be a pharyngeal scratch."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.55,
      "end_seconds": 290.88,
      "duration_seconds": 3.33,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.74,
      "end_seconds": 314.63,
      "duration_seconds": 22.89,
      "text": "I can't promise yet, but most people with a possible fish bone scratch or lodged bone do well once it's treated properly. I'm going to order a neck X-ray, for foreign body sensation. The result will help us decide whether anything more is needed. I'll want another look if still stuck tomorrow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.37,
      "end_seconds": 319.22,
      "duration_seconds": 2.85,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.84,
      "end_seconds": 323.72,
      "duration_seconds": 2.88,
      "text": "Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.24,
      "end_seconds": 332.16,
      "duration_seconds": 3.92,
      "text": "No, you know, that's all. Thanks a lot."
    }
  ]
}