{
  "schema_version": "1.0",
  "encounter_id": "02471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.31,
      "duration_seconds": 5.11,
      "text": "Yeah, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.38,
      "end_seconds": 12.21,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.86,
      "end_seconds": 26.06,
      "duration_seconds": 12.2,
      "text": "Erm, doctor, it's attacks of spinning lasting hours. It's getting on my nerves now. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.01,
      "end_seconds": 31.84,
      "duration_seconds": 3.83,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.77,
      "end_seconds": 39.37,
      "duration_seconds": 6.6,
      "text": "Atorvastatin. I take it 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 44.17,
      "duration_seconds": 4.22,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.02,
      "end_seconds": 49.1,
      "duration_seconds": 4.08,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.11,
      "end_seconds": 52.13,
      "duration_seconds": 2.02,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.67,
      "end_seconds": 57.5,
      "duration_seconds": 4.83,
      "text": "I've, I've had it for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.59,
      "end_seconds": 61.45,
      "duration_seconds": 2.86,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.48,
      "end_seconds": 83.76,
      "duration_seconds": 16.28,
      "text": "Mm, a seven out of ten, I suppose. Well, there's ringing in the left ear as well. I've had a full feeling in the ear too, for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.47,
      "end_seconds": 92.91,
      "duration_seconds": 6.44,
      "text": "Have you had attacks of spinning lasting hours before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.0,
      "end_seconds": 101.08,
      "duration_seconds": 6.08,
      "text": "Right, I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.65,
      "end_seconds": 118.62,
      "duration_seconds": 4.97,
      "text": "Let me check a few things. Any headache or double vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.46,
      "end_seconds": 122.54,
      "duration_seconds": 2.08,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.2,
      "end_seconds": 128.02,
      "duration_seconds": 4.82,
      "text": "Let me check a few things. Any ear discharge or weakness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.69,
      "end_seconds": 134.8,
      "duration_seconds": 5.11,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.82,
      "end_seconds": 138.51,
      "duration_seconds": 2.69,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.44,
      "end_seconds": 142.3,
      "duration_seconds": 2.86,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 146.79,
      "duration_seconds": 3.61,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.97,
      "end_seconds": 150.54,
      "duration_seconds": 2.57,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.98,
      "end_seconds": 163.01,
      "duration_seconds": 4.03,
      "text": "alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.74,
      "end_seconds": 166.46,
      "duration_seconds": 2.72,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 170.91,
      "duration_seconds": 3.13,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.76,
      "end_seconds": 177.16,
      "duration_seconds": 4.4,
      "text": "I had an operation for a hernia last spring"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.9,
      "end_seconds": 182.05,
      "duration_seconds": 4.15,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.57,
      "end_seconds": 191.03,
      "duration_seconds": 8.46,
      "text": "I've had high cholesterol, yes my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.62,
      "end_seconds": 204.43,
      "duration_seconds": 12.81,
      "text": "right, so high cholesterol is already on your record we'll keep that in mind today tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.39,
      "end_seconds": 221.61,
      "duration_seconds": 15.22,
      "text": "I've never touched a cigarette. No, I share a house with my brother. I hardly move around during the day. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.65,
      "end_seconds": 226.09,
      "duration_seconds": 3.44,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.23,
      "end_seconds": 237.0,
      "duration_seconds": 2.77,
      "text": "right, sit still for a moment.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.89,
      "end_seconds": 259.54,
      "duration_seconds": 5.65,
      "text": "okay: BP is 116 over 75, temperature 36.5, pulse 67."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.82,
      "end_seconds": 262.42,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 266.36,
      "duration_seconds": 2.23,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.59,
      "end_seconds": 269.9,
      "duration_seconds": 2.31,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.45,
      "end_seconds": 273.95,
      "duration_seconds": 2.5,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.31,
      "end_seconds": 293.4,
      "duration_seconds": 5.09,
      "text": "the ear drums look normal and the hearing is reduced on the left"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.34,
      "end_seconds": 309.98,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.23,
      "end_seconds": 323.65,
      "duration_seconds": 8.42,
      "text": "thank you, you can get dressed. Having listened and examined, it fits best with Meniere's disease. Vestibular migraine is still possible"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.28,
      "end_seconds": 328.67,
      "duration_seconds": 3.39,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.58,
      "end_seconds": 357.84,
      "duration_seconds": 24.26,
      "text": "I understand the worry. At the moment I'd say it's Meniere's disease, and we'll know more once the a hearing test is back. I want a hearing test done, that's for vertigo and hearing loss. I'll start you on betahistine, 16 milligrams, three times a day, long term. That should help with vertigo. Cut down on salt and caffeine"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.97,
      "end_seconds": 381.92,
      "duration_seconds": 18.95,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.78,
      "end_seconds": 383.86,
      "duration_seconds": 1.08,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.66,
      "end_seconds": 390.01,
      "duration_seconds": 5.35,
      "text": "come back in six weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.11,
      "end_seconds": 395.91,
      "duration_seconds": 3.8,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.6,
      "end_seconds": 398.92,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}