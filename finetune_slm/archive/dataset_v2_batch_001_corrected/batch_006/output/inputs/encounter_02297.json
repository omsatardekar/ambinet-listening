    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.85,
      "end_seconds": 121.72,
      "duration_seconds": 3.87,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.52,
      "end_seconds": 127.15,
      "duration_seconds": 3.63,
      "text": "No, um, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.78,
      "end_seconds": 133.02,
      "duration_seconds": 4.24,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.83,
      "end_seconds": 135.91,
      "duration_seconds": 2.08,
      "text": "No, all normal there."
