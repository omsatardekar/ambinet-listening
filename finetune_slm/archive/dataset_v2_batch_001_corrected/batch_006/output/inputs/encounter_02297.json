    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.43,
      "end_seconds": 141.31,
      "duration_seconds": 3.88,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.47,
      "end_seconds": 149.32,
      "duration_seconds": 6.85,
      "text": "Gout, for about ten years i have thin bones, for about a year"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.04,
      "end_seconds": 162.98,
      "duration_seconds": 11.94,
      "text": "right, so gout and thin bones are already on your record we'll keep that in mind today tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.51,
      "end_seconds": 184.88,
      "duration_seconds": 20.37,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I do a yoga class on Thursdays. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 190.39,
      "duration_seconds": 4.89,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.88,
      "end_seconds": 196.25,
      "duration_seconds": 4.37,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.39,
      "end_seconds": 209.78,
      "duration_seconds": 3.39,
      "text": "which medicines do you take at the moment?"
