    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.39,
      "end_seconds": 216.0,
      "duration_seconds": 5.61,
      "text": "Febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 217.93,
      "end_seconds": 228.72,
      "duration_seconds": 10.79,
      "text": "actually, doctor, I think the last prescription for the febuxostat was 160 milligrams we changed it at the the last visit"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.4,
      "end_seconds": 234.28,
      "duration_seconds": 4.88,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.49,
      "end_seconds": 245.98,
      "duration_seconds": 10.49,
      "text": "Right, um, no, I left it at home. I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 251.09,
      "end_seconds": 261.01,
      "duration_seconds": 9.92,
      "text": "ah, you know, she is supposed to take it once a week, but I can't say she always does"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.25,
      "end_seconds": 266.09,
      "duration_seconds": 3.84,
      "text": "I'll just record a a few vital signs"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.49,
      "end_seconds": 280.48,
      "duration_seconds": 1.99,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.17,
      "end_seconds": 306.96,
      "duration_seconds": 8.79,
      "text": "Okay: height 154 centimetres, weight 78 kilos, pressure 117 over 73. And SpO2 97 percent on room air, pulse 78."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.5,
      "end_seconds": 310.85,
      "duration_seconds": 2.35,
      "text": "Is that that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.46,
      "end_seconds": 315.42,
      "duration_seconds": 3.96,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.92,
      "end_seconds": 320.8,
      "duration_seconds": 3.88,
      "text": "I'll examine you in a second make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.48,
      "end_seconds": 322.48,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.74,
      "end_seconds": 325.01,
      "duration_seconds": 1.27,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.31,
      "end_seconds": 338.37,
      "duration_seconds": 5.06,
      "text": "There are crops of blisters and scabs in different stages on the trunk."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.58,
      "end_seconds": 343.16,
      "duration_seconds": 2.58,
      "text": "thank you you can get dressed"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.44,
      "end_seconds": 367.88,
      "duration_seconds": 15.44,
      "text": "I'll start you on aciclovir, 800 milligrams, five times a day, seven days. That's for adult chickenpox. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.65,
      "end_seconds": 372.27,
      "duration_seconds": 3.62,
      "text": "I know what to to watch for."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.89,
      "end_seconds": 377.01,
      "duration_seconds": 3.12,
      "text": "let's review you if you become breathless"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.69,
      "end_seconds": 379.68,
      "duration_seconds": 1.99,
      "text": "Okay I'll arrange it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.47,
      "end_seconds": 383.64,
      "duration_seconds": 3.17,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.27,
      "end_seconds": 389.57,
      "duration_seconds": 3.3,
      "text": "No that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
