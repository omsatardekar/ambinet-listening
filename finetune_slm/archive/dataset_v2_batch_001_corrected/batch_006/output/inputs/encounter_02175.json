{
  "schema_version": "1.0",
  "encounter_id": "02175",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.44,
      "duration_seconds": 3.83,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 10.18,
      "duration_seconds": 3.78,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.01,
      "end_seconds": 18.64,
      "duration_seconds": 6.63,
      "text": "Doctor, it's an ulcer under the big toe. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.26,
      "end_seconds": 22.03,
      "duration_seconds": 2.77,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.87,
      "end_seconds": 30.1,
      "duration_seconds": 3.23,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.61,
      "end_seconds": 33.45,
      "duration_seconds": 2.84,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.39,
      "end_seconds": 37.27,
      "duration_seconds": 1.88,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.18,
      "end_seconds": 55.27,
      "duration_seconds": 2.09,
      "text": "any black skin or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.06,
      "end_seconds": 59.43,
      "duration_seconds": 3.37,
      "text": "No, no black skin or fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.81,
      "end_seconds": 65.58,
      "duration_seconds": 5.77,
      "text": "Yes, carry on. Any tracking redness or pain in the foot at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.77,
      "end_seconds": 70.27,
      "duration_seconds": 3.5,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.01,
      "end_seconds": 77.96,
      "duration_seconds": 4.95,
      "text": "Alright, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.62,
      "end_seconds": 82.35,
      "duration_seconds": 2.73,
      "text": "no, that side's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 96.41,
      "duration_seconds": 2.57,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.99,
      "end_seconds": 101.77,
      "duration_seconds": 3.78,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.19,
      "end_seconds": 105.13,
      "duration_seconds": 1.94,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.55,
      "end_seconds": 110.3,
      "duration_seconds": 3.75,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.21,
      "end_seconds": 115.24,
      "duration_seconds": 2.03,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.25,
      "end_seconds": 121.66,
      "duration_seconds": 5.41,
      "text": "I'm on gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.61,
      "end_seconds": 134.79,
      "duration_seconds": 4.18,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.89,
      "end_seconds": 144.43,
      "duration_seconds": 8.54,
      "text": "I had a reaction to tramadol when I was younger, feeling very drowsy, and I've avoided it since."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.99,
      "end_seconds": 148.43,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.47,
      "end_seconds": 151.75,
      "duration_seconds": 2.28,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.78,
      "end_seconds": 157.16,
      "duration_seconds": 3.38,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.68,
      "end_seconds": 160.89,
      "duration_seconds": 3.21,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.64,
      "end_seconds": 163.55,
      "duration_seconds": 1.91,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.33,
      "end_seconds": 167.53,
      "duration_seconds": 2.2,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.36,
      "end_seconds": 169.66,
      "duration_seconds": 1.3,
      "text": "okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.65,
      "end_seconds": 175.56,
      "duration_seconds": 3.91,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.75,
      "end_seconds": 185.19,
      "duration_seconds": 2.44,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.42,
      "end_seconds": 202.05,
      "duration_seconds": 7.63,
      "text": "okay: blood pressure 115 over 76, temperature is 39.0 degrees, pulse is 93 beats a minute"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.91,
      "end_seconds": 208.27,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.37,
      "end_seconds": 212.27,
      "duration_seconds": 2.9,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.98,
      "end_seconds": 216.62,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.34,
      "end_seconds": 218.4,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.59,
      "end_seconds": 221.35,
      "duration_seconds": 1.76,
      "text": "so, does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.32,
      "end_seconds": 241.87,
      "duration_seconds": 6.55,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.57,
      "end_seconds": 246.34,
      "duration_seconds": 1.77,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 293.98,
      "duration_seconds": 31.67,
      "text": "So, based on the history and the examination, I think we're dealing with an infected diabetic foot ulcer at this stage. I think an X-ray of the foot makes sense here, for possible osteomyelitis. For this, co-amoxiclav, 625 milligrams, three times a day, seven days. That's for infected ulcer. It's a commonly used medicine and most people tolerate it well. Keep the weight off the foot and keep the dressing dry."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.99,
      "end_seconds": 302.56,
      "duration_seconds": 5.57,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.15,
      "end_seconds": 305.26,
      "duration_seconds": 1.11,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.8,
      "end_seconds": 309.62,
      "duration_seconds": 3.82,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.61,
      "end_seconds": 313.66,
      "duration_seconds": 3.05,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.95,
      "end_seconds": 316.22,
      "duration_seconds": 1.27,
      "text": "Goodbye for now."
    }
  ]
}