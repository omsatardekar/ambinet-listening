{
  "schema_version": "1.0",
  "encounter_id": "02060",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 2.74,
      "duration_seconds": 1.99,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.73,
      "end_seconds": 6.74,
      "duration_seconds": 3.01,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.6,
      "end_seconds": 11.7,
      "duration_seconds": 3.1,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.78,
      "end_seconds": 21.72,
      "duration_seconds": 8.94,
      "text": "It's vomiting large amounts of fresh blood. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.98,
      "end_seconds": 27.95,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.63,
      "end_seconds": 32.96,
      "duration_seconds": 3.33,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 37.29,
      "duration_seconds": 3.47,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.59,
      "end_seconds": 45.74,
      "duration_seconds": 7.15,
      "text": "Severe, I'd say. I've also had a swollen tummy, for about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 49.85,
      "duration_seconds": 3.17,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.56,
      "end_seconds": 78.34,
      "duration_seconds": 27.78,
      "text": "Pretty moderate, if I'm being honest. As for being confused, I honestly can't say when that began. It might have been last month or the month before. As for being confused, I'd give it a seven, out of ten. And I've been feeling faint as well. About feeling faint, a five out of ten, I suppose. It's every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.71,
      "end_seconds": 94.95,
      "duration_seconds": 2.24,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 99.96,
      "duration_seconds": 3.9,
      "text": "I haven't had fever or chest pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.39,
      "end_seconds": 104.52,
      "duration_seconds": 3.13,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.36,
      "end_seconds": 109.97,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 117.91,
      "duration_seconds": 2.21,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.52,
      "end_seconds": 122.14,
      "duration_seconds": 2.62,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.69,
      "end_seconds": 140.43,
      "duration_seconds": 2.74,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.19,
      "end_seconds": 150.48,
      "duration_seconds": 5.29,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.09,
      "end_seconds": 155.28,
      "duration_seconds": 3.19,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.04,
      "end_seconds": 162.95,
      "duration_seconds": 5.91,
      "text": "Rosuvastatin. I take it 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 164.51,
      "end_seconds": 169.47,
      "duration_seconds": 4.96,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.98,
      "end_seconds": 174.24,
      "duration_seconds": 3.26,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.43,
      "end_seconds": 185.85,
      "duration_seconds": 8.42,
      "text": "I don't think I have it with me. I'm on Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.13,
      "end_seconds": 187.04,
      "duration_seconds": 0.91,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.12,
      "end_seconds": 192.32,
      "duration_seconds": 2.2,
      "text": "Alcohol every day, daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.14,
      "end_seconds": 200.92,
      "duration_seconds": 2.78,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.18,
      "end_seconds": 218.44,
      "duration_seconds": 12.26,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. My partner and our baby. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.67,
      "end_seconds": 224.12,
      "duration_seconds": 4.45,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.27,
      "end_seconds": 230.97,
      "duration_seconds": 2.7,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.77,
      "end_seconds": 235.99,
      "duration_seconds": 3.22,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.79,
      "end_seconds": 241.38,
      "duration_seconds": 4.59,
      "text": "My father has Parkinson's disease. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.34,
      "end_seconds": 245.7,
      "duration_seconds": 2.36,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.29,
      "end_seconds": 256.21,
      "duration_seconds": 9.92,
      "text": "Yes, high cholesterol. My neighbour said I should get it looked at. Low haemoglobin, for five years. I've got asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.21,
      "end_seconds": 263.34,
      "duration_seconds": 6.13,
      "text": "Yes. Alright, high cholesterol and low haemoglobin, that matches what I have here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 272.81,
      "end_seconds": 281.46,
      "duration_seconds": 8.65,
      "text": "Here are the numbers, doctor. Saturation 99 percent, temperature 36.4. BP is 98 over 65, heart rate 95, respiratory rate 19."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 284.14,
      "duration_seconds": 1.11,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.98,
      "end_seconds": 290.37,
      "duration_seconds": 4.39,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.52,
      "end_seconds": 294.94,
      "duration_seconds": 3.42,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.0,
      "end_seconds": 317.56,
      "duration_seconds": 6.56,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.91,
      "end_seconds": 319.82,
      "duration_seconds": 0.91,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.73,
      "end_seconds": 355.13,
      "duration_seconds": 29.4,
      "text": "That's the examination finished. Okay, so my impression is this: I think we're dealing with a bleed from enlarged veins in the gullet in liver disease at this stage. A bleeding ulcer is also on my list. Let's book an urgent endoscopy to look into variceal bleed. I'd like to arrange urgent blood tests for major bleed. What I'm giving you is terlipressin, 2 milligrams, now, single dose. It's for variceal bleeding."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.21,
      "end_seconds": 362.67,
      "duration_seconds": 5.46,
      "text": "You are going straight to resus, I am starting two drips."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.04,
      "end_seconds": 378.0,
      "duration_seconds": 14.96,
      "text": "Right, right. I'd like you to see the emergency team as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.57,
      "end_seconds": 383.12,
      "duration_seconds": 1.55,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.2,
      "end_seconds": 397.48,
      "duration_seconds": 13.28,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.05,
      "end_seconds": 403.29,
      "duration_seconds": 4.24,
      "text": "Good, um, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.19,
      "end_seconds": 410.53,
      "duration_seconds": 1.34,
      "text": "All the best."
    }
  ]
}