{
  "schema_version": "1.0",
  "encounter_id": "02325",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 4.5,
      "duration_seconds": 3.99,
      "text": "sorry I'm a little late, you know, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.57,
      "end_seconds": 12.92,
      "duration_seconds": 5.35,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.24,
      "end_seconds": 30.96,
      "duration_seconds": 16.72,
      "text": "I mean doctor I've come along because I know the history if it helps it's cramping in my calves when I walk doctor he didn't want to come but I insisted"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.62,
      "end_seconds": 36.6,
      "duration_seconds": 3.98,
      "text": "okay, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.5,
      "end_seconds": 41.7,
      "duration_seconds": 4.2,
      "text": "Okay, so it's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.3,
      "end_seconds": 46.78,
      "duration_seconds": 3.48,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.69,
      "end_seconds": 52.86,
      "duration_seconds": 5.17,
      "text": "a four out of ten, I suppose and cold feet, too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 56.73,
      "duration_seconds": 2.83,
      "text": "any a slow-healing toe sore as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.48,
      "end_seconds": 65.19,
      "duration_seconds": 6.71,
      "text": "Mm, yes. With slow-healing toe sore, about a five out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.25,
      "end_seconds": 73.53,
      "duration_seconds": 7.28,
      "text": "have you had cramping in your calves when you walk before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.06,
      "end_seconds": 79.77,
      "duration_seconds": 4.71,
      "text": "a bit last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.31,
      "end_seconds": 83.7,
      "duration_seconds": 2.39,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.8,
      "end_seconds": 89.47,
      "duration_seconds": 4.67,
      "text": "just two stents put in my heart three years ago"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.63,
      "end_seconds": 94.97,
      "duration_seconds": 4.34,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.87,
      "end_seconds": 100.88,
      "duration_seconds": 4.01,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.56,
      "end_seconds": 112.04,
      "duration_seconds": 2.48,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.99,
      "end_seconds": 119.55,
      "duration_seconds": 5.56,
      "text": "It's metformin, 500 milligrams, maybe, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.32,
      "end_seconds": 128.49,
      "duration_seconds": 4.17,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.07,
      "end_seconds": 136.26,
      "duration_seconds": 7.19,
      "text": "not with me i'll bring it next time. Atorvastatin, 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.12,
      "end_seconds": 140.84,
      "duration_seconds": 2.72,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.7,
      "end_seconds": 148.87,
      "duration_seconds": 7.17,
      "text": "for two months it's escitalopram, 10 milligrams, once a day for the anxiety"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 150.1,
      "end_seconds": 161.67,
      "duration_seconds": 11.57,
      "text": "sorry, what was I saying, it's meant to be once a day, though I don't see he take it every time"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 167.66,
      "duration_seconds": 4.49,
      "text": "I take clopidogrel, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.62,
      "end_seconds": 171.95,
      "duration_seconds": 3.33,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.87,
      "end_seconds": 175.79,
      "duration_seconds": 1.92,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.65,
      "end_seconds": 181.45,
      "duration_seconds": 3.8,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.92,
      "end_seconds": 187.71,
      "duration_seconds": 4.79,
      "text": "I've had diabetes, yes i've had high cholesterol, yes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.2,
      "end_seconds": 190.91,
      "duration_seconds": 1.71,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.33,
      "end_seconds": 196.56,
      "duration_seconds": 4.23,
      "text": "Yeah, I've had anxiety, yes. Yes, heart disease."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.13,
      "end_seconds": 201.69,
      "duration_seconds": 4.56,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.95,
      "end_seconds": 207.8,
      "duration_seconds": 4.85,
      "text": "My sister had breast cancer. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.36,
      "end_seconds": 209.79,
      "duration_seconds": 1.43,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.23,
      "end_seconds": 215.04,
      "duration_seconds": 3.81,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.5,
      "end_seconds": 218.26,
      "duration_seconds": 1.76,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.66,
      "end_seconds": 221.16,
      "duration_seconds": 1.5,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.66,
      "end_seconds": 224.27,
      "duration_seconds": 1.61,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.92,
      "end_seconds": 230.1,
      "duration_seconds": 4.18,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.44,
      "end_seconds": 233.35,
      "duration_seconds": 1.91,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 239.22,
      "duration_seconds": 3.77,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.29,
      "end_seconds": 241.53,
      "duration_seconds": 1.24,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.07,
      "end_seconds": 244.88,
      "duration_seconds": 2.81,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.66,
      "end_seconds": 260.66,
      "duration_seconds": 4.0,
      "text": "Have you noticed chest pain, pain at rest or fever?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.24,
      "end_seconds": 272.16,
      "duration_seconds": 5.92,
      "text": "I haven't had chest pain, pain at rest or fever, no."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.35,
      "end_seconds": 276.57,
      "duration_seconds": 3.22,
      "text": "have you had back pain by any chance?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.46,
      "end_seconds": 280.09,
      "duration_seconds": 2.63,
      "text": "No, none, no back pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.47,
      "end_seconds": 284.86,
      "duration_seconds": 3.39,
      "text": "anything with your nerves like weakness or numbness?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.34,
      "end_seconds": 288.2,
      "duration_seconds": 1.86,
      "text": "no nothing like that"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.81,
      "end_seconds": 299.71,
      "duration_seconds": 3.9,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.0,
      "end_seconds": 314.24,
      "duration_seconds": 2.24,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.35,
      "end_seconds": 334.48,
      "duration_seconds": 9.13,
      "text": "okay: SpO2 99 percent on room air, blood pressure 111 over 80, pulse 83, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.49,
      "end_seconds": 338.52,
      "duration_seconds": 2.03,
      "text": "is that alright doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.37,
      "end_seconds": 341.6,
      "duration_seconds": 2.23,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.38,
      "end_seconds": 350.41,
      "duration_seconds": 6.03,
      "text": "I'll need to examine you for this, it it won't take long."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.16,
      "end_seconds": 353.89,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.86,
      "end_seconds": 374.84,
      "duration_seconds": 6.98,
      "text": "the pulses at the left foot are absent and the foot is cool and shiny"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.61,
      "end_seconds": 403.0,
      "duration_seconds": 23.39,
      "text": "good you can sit up again so where does that leave us? My working impression is peripheral arterial disease i can't rule out a nerve problem yet and please bring the latest prescription or the medicine boxes to the the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.15,
      "end_seconds": 411.33,
      "duration_seconds": 7.18,
      "text": "mm, okay, I'll look out for that should I have an ankle-brachial index as well?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.08,
      "end_seconds": 424.83,
      "duration_seconds": 12.75,
      "text": "not right now, it wouldn't change what we do today. I don't need to add any tests or treatment at this point. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.63,
      "end_seconds": 431.52,
      "duration_seconds": 1.89,
      "text": "Alright thanks take care."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.25,
      "end_seconds": 433.53,
      "duration_seconds": 1.28,
      "text": "take care now"
    }
  ]
