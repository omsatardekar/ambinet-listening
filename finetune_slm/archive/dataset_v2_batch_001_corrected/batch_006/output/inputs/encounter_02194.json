  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 4.48,
      "duration_seconds": 3.91,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 9.88,
      "duration_seconds": 4.66,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.08,
      "end_seconds": 16.72,
      "duration_seconds": 5.64,
      "text": "Well, I've been having a lump in my left breast."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.3,
      "end_seconds": 20.09,
      "duration_seconds": 2.79,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.66,
      "end_seconds": 28.56,
      "duration_seconds": 6.9,
      "text": "Two days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.97,
      "end_seconds": 33.98,
      "duration_seconds": 2.01,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.75,
      "end_seconds": 41.74,
      "duration_seconds": 5.99,
      "text": "When it starts I tend to get slight tenderness as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.56,
      "end_seconds": 47.55,
      "duration_seconds": 4.99,
      "text": "So, any weight loss, nipple discharge or lump under the arm?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.71,
      "end_seconds": 52.31,
      "duration_seconds": 3.6,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.72,
      "end_seconds": 56.14,
      "duration_seconds": 2.42,
      "text": "have you had any skin dimpling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.28,
      "end_seconds": 59.4,
      "duration_seconds": 2.12,
      "text": "No. No skin dimpling."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.39,
      "end_seconds": 63.55,
      "duration_seconds": 2.16,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.06,
      "end_seconds": 65.04,
      "duration_seconds": 0.98,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.58,
      "end_seconds": 68.1,
      "duration_seconds": 2.52,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.42,
      "end_seconds": 72.89,
      "duration_seconds": 3.47,
      "text": "actually, no, that side's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.3,
      "end_seconds": 89.48,
      "duration_seconds": 2.18,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.58,
      "end_seconds": 96.06,
      "duration_seconds": 4.48,
      "text": "Thyronorm. I take it every morning for my thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.84,
      "end_seconds": 100.26,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 102.51,
      "duration_seconds": 1.22,
      "text": "50 micrograms."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.23,
      "end_seconds": 107.56,
      "duration_seconds": 3.33,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 115.97,
      "duration_seconds": 6.47,
      "text": "ah, uh, I have an underactive thyroid, for about ten years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 132.68,
      "duration_seconds": 2.88,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.31,
      "end_seconds": 140.7,
      "duration_seconds": 6.39,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.8,
      "end_seconds": 147.21,
      "duration_seconds": 4.41,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.98,
      "end_seconds": 153.31,
      "duration_seconds": 4.33,
      "text": "erm, I'm allergic to trimethoprim, I get itching"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.94,
      "end_seconds": 161.42,
      "duration_seconds": 4.48,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.6,
      "end_seconds": 183.24,
      "duration_seconds": 20.64,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. I'm vegetarian and have been for years. I'm a plumber, lots of bending and kneeling. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.62,
      "end_seconds": 200.5,
      "duration_seconds": 2.88,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.31,
      "end_seconds": 215.29,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.99,
      "end_seconds": 231.23,
      "duration_seconds": 6.24,
      "text": "Okay: saturation 97 percent, BP is 123 over 81, respiratory rate 18, pulse 75."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.2,
      "end_seconds": 238.03,
      "duration_seconds": 3.83,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.99,
      "end_seconds": 241.95,
      "duration_seconds": 1.96,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.05,
      "end_seconds": 262.47,
      "duration_seconds": 10.42,
      "text": "there is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.71,
      "end_seconds": 278.57,
      "duration_seconds": 10.86,
      "text": "Okay, that's enough for me. So, based on the history and the examination, I'd lean towards a breast lump needing triple assessment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.11,
      "end_seconds": 285.36,
      "duration_seconds": 5.25,
      "text": "okay, so so I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.87,
      "end_seconds": 315.7,
      "duration_seconds": 28.83,
      "text": "Nothing I've seen today points to an emergency. It looks like a breast lump needing triple assessment, but I'd like to confirm. I'd like to arrange a mammogram and ultrasound for breast lump. We should do a needle biopsy for breast lump. This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. I'd like you to see the breast clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.87,
      "end_seconds": 324.12,
      "duration_seconds": 7.25,
      "text": "Book a review after the clinic. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.75,
      "end_seconds": 329.21,
      "duration_seconds": 3.46,
      "text": "Thank you, um, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.93,
      "end_seconds": 331.41,
      "duration_seconds": 1.48,
      "text": "All the best."
    }
  ]
