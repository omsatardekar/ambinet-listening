{
  "schema_version": "1.0",
  "encounter_id": "02167",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 8.11,
      "duration_seconds": 7.17,
      "text": "So, hello, take a seat, I'll be with you in a second. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.69,
      "end_seconds": 25.33,
      "duration_seconds": 16.64,
      "text": "Erm, um, I wanted to get itchy spots all over looked at. I've been reading about it online and it worried me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.17,
      "end_seconds": 28.48,
      "duration_seconds": 2.31,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.34,
      "end_seconds": 40.51,
      "duration_seconds": 2.17,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.32,
      "end_seconds": 65.31,
      "duration_seconds": 12.99,
      "text": "Okay: blood pressure 109 over 71, temp 36.9 degrees, pulse is 67 beats a minute, saturation 97 percent. Right, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.85,
      "end_seconds": 71.93,
      "duration_seconds": 6.08,
      "text": "Two days, I think... sorry, about four days, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.95,
      "end_seconds": 76.82,
      "duration_seconds": 2.87,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.03,
      "end_seconds": 80.62,
      "duration_seconds": 2.59,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.87,
      "end_seconds": 83.56,
      "duration_seconds": 1.69,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.3,
      "end_seconds": 86.2,
      "duration_seconds": 1.9,
      "text": "Calamine helps a bit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.79,
      "end_seconds": 91.0,
      "duration_seconds": 3.21,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.88,
      "end_seconds": 96.45,
      "duration_seconds": 4.57,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.0,
      "end_seconds": 99.94,
      "duration_seconds": 1.94,
      "text": "Have you been feeling achy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.64,
      "end_seconds": 102.6,
      "duration_seconds": 1.96,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.94,
      "end_seconds": 110.19,
      "duration_seconds": 6.25,
      "text": "Let me check a few things. Any breathlessness, pregnancy, stiff neck or being immunosuppressed?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 116.96,
      "duration_seconds": 5.76,
      "text": "I haven't had breathlessness, pregnancy, stiff neck or being immunosuppressed, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 120.03,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.1,
      "end_seconds": 122.75,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 126.51,
      "duration_seconds": 3.05,
      "text": "Right, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.16,
      "end_seconds": 130.82,
      "duration_seconds": 2.66,
      "text": "Erm, no, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.44,
      "end_seconds": 136.56,
      "duration_seconds": 4.12,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.17,
      "end_seconds": 143.72,
      "duration_seconds": 5.55,
      "text": "Depression, for nearly five years. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.48,
      "end_seconds": 153.41,
      "duration_seconds": 7.93,
      "text": "Right, so depression is already on your record. We'll keep that in mind today. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.56,
      "end_seconds": 158.8,
      "duration_seconds": 4.24,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.95,
      "end_seconds": 167.05,
      "duration_seconds": 4.1,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.03,
      "end_seconds": 173.09,
      "duration_seconds": 4.06,
      "text": "Yes, walnuts, it gives me my lips swelling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.76,
      "end_seconds": 194.06,
      "duration_seconds": 3.3,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.99,
      "end_seconds": 202.68,
      "duration_seconds": 2.69,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.59,
      "end_seconds": 206.01,
      "duration_seconds": 1.42,
      "text": "Right, any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.43,
      "end_seconds": 214.19,
      "duration_seconds": 3.76,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.94,
      "end_seconds": 218.21,
      "duration_seconds": 3.27,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.93,
      "end_seconds": 223.41,
      "duration_seconds": 4.48,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.36,
      "end_seconds": 227.92,
      "duration_seconds": 2.56,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.06,
      "end_seconds": 232.7,
      "duration_seconds": 3.64,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.26,
      "end_seconds": 246.23,
      "duration_seconds": 3.97,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.03,
      "end_seconds": 249.42,
      "duration_seconds": 2.39,
      "text": "It's calamine lotion, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.6,
      "end_seconds": 255.97,
      "duration_seconds": 4.37,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.71,
      "end_seconds": 258.95,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.75,
      "end_seconds": 273.8,
      "duration_seconds": 5.05,
      "text": "There are crops of blisters and scabs in different stages on the trunk."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.99,
      "end_seconds": 278.73,
      "duration_seconds": 1.74,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.22,
      "end_seconds": 291.24,
      "duration_seconds": 5.02,
      "text": "So, based on the history and the examination, it points towards chickenpox."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.69,
      "end_seconds": 297.77,
      "duration_seconds": 5.08,
      "text": "Let me think, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.55,
      "end_seconds": 315.07,
      "duration_seconds": 16.52,
      "text": "Nothing I've seen today points to an emergency. It looks like chickenpox. Stay at home until all the spots have crusted and stay away from pregnant women. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.38,
      "end_seconds": 322.74,
      "duration_seconds": 3.36,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}