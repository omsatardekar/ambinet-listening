{
  "schema_version": "1.0",
  "encounter_id": "02269",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 3.24,
      "duration_seconds": 2.55,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.17,
      "end_seconds": 8.66,
      "duration_seconds": 3.49,
      "text": "hello, thanks for fitting me in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.21,
      "end_seconds": 12.12,
      "duration_seconds": 1.91,
      "text": "Alright, what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 23.41,
      "duration_seconds": 9.87,
      "text": "Mainly electric shock pains in my cheek. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.05,
      "end_seconds": 26.21,
      "duration_seconds": 2.16,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.89,
      "end_seconds": 31.35,
      "duration_seconds": 3.46,
      "text": "Since last night, that's when it began"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.85,
      "end_seconds": 43.4,
      "duration_seconds": 10.55,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.77,
      "end_seconds": 55.66,
      "duration_seconds": 7.89,
      "text": "I notice it more with touching the face and chewing. It feels severe to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.2,
      "end_seconds": 58.79,
      "duration_seconds": 1.59,
      "text": "Nothing like hearing loss?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.55,
      "end_seconds": 64.17,
      "duration_seconds": 3.62,
      "text": "Not that I've noticed, no hearing loss."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.11,
      "end_seconds": 68.22,
      "duration_seconds": 2.11,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.68,
      "end_seconds": 73.24,
      "duration_seconds": 3.56,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.81,
      "end_seconds": 91.1,
      "duration_seconds": 1.29,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.85,
      "end_seconds": 95.85,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.47,
      "end_seconds": 99.5,
      "duration_seconds": 3.03,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.01,
      "end_seconds": 104.18,
      "duration_seconds": 3.17,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.02,
      "end_seconds": 109.94,
      "duration_seconds": 3.92,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.98,
      "end_seconds": 114.55,
      "duration_seconds": 2.57,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.95,
      "end_seconds": 117.24,
      "duration_seconds": 1.29,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.01,
      "end_seconds": 122.78,
      "duration_seconds": 3.77,
      "text": "no, uh, I've never been operated on"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.39,
      "end_seconds": 145.19,
      "duration_seconds": 4.8,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.31,
      "end_seconds": 154.61,
      "duration_seconds": 8.3,
      "text": "years back I got a rash all over from amoxicillin, so I stay away from it now"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.99,
      "end_seconds": 159.27,
      "duration_seconds": 3.28,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.1,
      "end_seconds": 163.81,
      "duration_seconds": 2.71,
      "text": "Mm, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 168.71,
      "duration_seconds": 3.29,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.16,
      "end_seconds": 171.72,
      "duration_seconds": 1.56,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.31,
      "end_seconds": 175.97,
      "duration_seconds": 3.66,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.31,
      "end_seconds": 187.63,
      "duration_seconds": 2.32,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.2,
      "end_seconds": 211.27,
      "duration_seconds": 13.07,
      "text": "Okay: blood pressure 117 over 73, SpO2 99 percent on room air. And pulse 74, weight 66 kilos, BMI works out to 21.3, height 176 centimetres."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.9,
      "end_seconds": 217.52,
      "duration_seconds": 3.62,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 221.22,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.73,
      "end_seconds": 245.76,
      "duration_seconds": 6.03,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.72,
      "end_seconds": 254.12,
      "duration_seconds": 2.4,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.29,
      "end_seconds": 282.86,
      "duration_seconds": 12.57,
      "text": "Putting it all together, I think we're dealing with trigeminal neuralgia at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.39,
      "end_seconds": 286.1,
      "duration_seconds": 2.71,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.31,
      "end_seconds": 321.06,
      "duration_seconds": 30.75,
      "text": "It's reasonable to be concerned, but right now trigeminal neuralgia is my leading thought, not anything worse. I'll request an MRI scan of the head, it'll help with facial pain. That will help us see what's going on underneath and and decide the next step. You'll be taking carbamazepine, 100 milligrams, twice a day, titrate. That should help with nerve pain. Avoid known triggers and eat soft foods when it flares."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.28,
      "end_seconds": 333.03,
      "duration_seconds": 10.75,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.04,
      "end_seconds": 337.74,
      "duration_seconds": 2.7,
      "text": "I'll note it in my calendar"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.15,
      "end_seconds": 345.08,
      "duration_seconds": 3.93,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.21,
      "end_seconds": 350.37,
      "duration_seconds": 4.16,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}