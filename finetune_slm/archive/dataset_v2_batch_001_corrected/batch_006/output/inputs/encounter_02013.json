{
  "schema_version": "1.0",
  "encounter_id": "02013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 6.79,
      "duration_seconds": 6.26,
      "text": "Ah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 11.77,
      "duration_seconds": 4.01,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.36,
      "end_seconds": 16.67,
      "duration_seconds": 3.31,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.98,
      "end_seconds": 21.12,
      "duration_seconds": 3.14,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.47,
      "end_seconds": 28.32,
      "duration_seconds": 5.85,
      "text": "Um, you know, so... very heavy periods. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 32.02,
      "end_seconds": 42.62,
      "duration_seconds": 10.6,
      "text": "Doctor, I've got the readings for you. Pressure 113 over 79, pulse is 125 beats a minute. SpO2 99 percent on room air, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.79,
      "end_seconds": 48.0,
      "duration_seconds": 4.21,
      "text": "Okay, noted. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.32,
      "end_seconds": 75.05,
      "duration_seconds": 25.73,
      "text": "I've had it since Monday. Oh, and dizziness. Had that since Monday. With dizziness, it feels mild to me. Oh, and being breathless on stairs. That's been about the same, one week. Ah, uh, as for being breathless on stairs, it's mild, honestly. It's worse with stairs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.42,
      "end_seconds": 78.89,
      "duration_seconds": 2.47,
      "text": "Any fainting, weight loss or pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 82.8,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.44,
      "end_seconds": 86.47,
      "duration_seconds": 3.03,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.01,
      "end_seconds": 89.67,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.21,
      "end_seconds": 95.0,
      "duration_seconds": 3.79,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.65,
      "end_seconds": 99.44,
      "duration_seconds": 2.79,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.81,
      "end_seconds": 112.46,
      "duration_seconds": 4.65,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.08,
      "end_seconds": 125.51,
      "duration_seconds": 11.43,
      "text": "Not much, I mostly stay in these days. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.24,
      "end_seconds": 132.39,
      "duration_seconds": 5.15,
      "text": "So, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.19,
      "end_seconds": 139.84,
      "duration_seconds": 5.65,
      "text": "I take aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 141.71,
      "end_seconds": 152.2,
      "duration_seconds": 10.49,
      "text": "Doctor, um, I think the last prescription for the aspirin was 37.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.04,
      "end_seconds": 158.06,
      "duration_seconds": 4.02,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.65,
      "end_seconds": 163.92,
      "duration_seconds": 4.27,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.65,
      "end_seconds": 169.71,
      "duration_seconds": 4.06,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.62,
      "end_seconds": 185.7,
      "duration_seconds": 14.08,
      "text": "Um, yes, nickel. I've no idea what the reaction was, only that I'm not supposed to have it. I'm allergic to trimethoprim, I get a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.09,
      "end_seconds": 190.81,
      "duration_seconds": 3.72,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.76,
      "end_seconds": 196.6,
      "duration_seconds": 3.84,
      "text": "I've got heart disease. I have diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.19,
      "end_seconds": 202.95,
      "duration_seconds": 4.76,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.62,
      "end_seconds": 223.21,
      "duration_seconds": 12.59,
      "text": "Putting together what you've described, the most likely explanation is heavy periods with iron deficiency. It could also be fibroids, so we'll keep that open."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.9,
      "end_seconds": 249.47,
      "duration_seconds": 8.57,
      "text": "I want a blood count done, that's for heavy periods. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.67,
      "end_seconds": 257.76,
      "duration_seconds": 2.09,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.53,
      "end_seconds": 263.11,
      "duration_seconds": 4.58,
      "text": "I think a pelvic ultrasound makes sense here, for heavy periods."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.06,
      "end_seconds": 266.67,
      "duration_seconds": 1.61,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.61,
      "end_seconds": 300.63,
      "duration_seconds": 33.02,
      "text": "I'll request a ferritin level, it'll help with heavy periods. The treatment will be ferrous sulfate, 200 milligrams, once a day, three months. That should help with iron deficiency. Keep a pad count diary. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.26,
      "end_seconds": 305.63,
      "duration_seconds": 3.37,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.01,
      "end_seconds": 311.13,
      "duration_seconds": 4.12,
      "text": "I'd like to see you again after the results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.08,
      "end_seconds": 313.78,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.86,
      "end_seconds": 319.66,
      "duration_seconds": 3.8,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.41,
      "end_seconds": 324.83,
      "duration_seconds": 3.42,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.24,
      "end_seconds": 327.45,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}