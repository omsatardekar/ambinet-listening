{
  "schema_version": "1.0",
  "encounter_id": "02490",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 5.64,
      "duration_seconds": 4.98,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 11.64,
      "duration_seconds": 5.19,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.55,
      "end_seconds": 17.39,
      "duration_seconds": 4.84,
      "text": "I'm here because of pain in the lower left tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.51,
      "end_seconds": 21.9,
      "duration_seconds": 3.39,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.72,
      "end_seconds": 25.38,
      "duration_seconds": 2.66,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.05,
      "end_seconds": 29.33,
      "duration_seconds": 2.28,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.91,
      "end_seconds": 31.95,
      "duration_seconds": 2.04,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.66,
      "end_seconds": 35.43,
      "duration_seconds": 2.77,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.52,
      "end_seconds": 42.49,
      "duration_seconds": 4.97,
      "text": "Mostly severe. And, And I've been feeling bloated as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.68,
      "end_seconds": 46.51,
      "duration_seconds": 2.83,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.92,
      "end_seconds": 48.9,
      "duration_seconds": 0.98,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.8,
      "end_seconds": 71.89,
      "duration_seconds": 6.09,
      "text": "Have you had any vomiting, urinary symptoms, blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.68,
      "end_seconds": 80.99,
      "duration_seconds": 7.31,
      "text": "I, I haven't had vomiting, urinary symptoms, blood in the stool or weight loss, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.48,
      "end_seconds": 85.96,
      "duration_seconds": 3.48,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.68,
      "end_seconds": 89.8,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.66,
      "end_seconds": 94.08,
      "duration_seconds": 3.42,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.84,
      "end_seconds": 96.85,
      "duration_seconds": 2.01,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 119.79,
      "duration_seconds": 5.34,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.36,
      "end_seconds": 121.7,
      "duration_seconds": 1.34,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 138.55,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 148.21,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.57,
      "end_seconds": 151.69,
      "duration_seconds": 2.12,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.85,
      "end_seconds": 161.89,
      "duration_seconds": 5.04,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.99,
      "end_seconds": 165.28,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.13,
      "end_seconds": 171.24,
      "duration_seconds": 4.11,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.32,
      "end_seconds": 174.68,
      "duration_seconds": 2.36,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.79,
      "end_seconds": 176.84,
      "duration_seconds": 1.05,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.41,
      "end_seconds": 188.55,
      "duration_seconds": 2.14,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.83,
      "end_seconds": 201.65,
      "duration_seconds": 2.82,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.14,
      "end_seconds": 231.03,
      "duration_seconds": 7.89,
      "text": "Okay: temp 39.0 degrees, pulse 89, respiratory rate 20, blood pressure 126 over 68, saturation 95 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.91,
      "end_seconds": 236.9,
      "duration_seconds": 3.99,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.0,
      "end_seconds": 239.57,
      "duration_seconds": 1.57,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.61,
      "end_seconds": 252.98,
      "duration_seconds": 5.37,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.7,
      "end_seconds": 271.21,
      "duration_seconds": 13.51,
      "text": "Okay, that's enough for me. So, based on the history and the examination, this is probably acute diverticulitis. I'd like to arrange blood tests for abdominal pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 272.1,
      "end_seconds": 276.36,
      "duration_seconds": 4.26,
      "text": "I can book that for Tuesday at 11:30 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.15,
      "end_seconds": 279.07,
      "duration_seconds": 0.92,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.7,
      "end_seconds": 284.94,
      "duration_seconds": 5.24,
      "text": "I'd like to arrange a CT scan for left iliac fossa pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.48,
      "end_seconds": 288.06,
      "duration_seconds": 1.58,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.03,
      "end_seconds": 320.05,
      "duration_seconds": 30.02,
      "text": "I'll start you on co-amoxiclav, 625 milligrams, three times a day, five days. You take it by mouth. That's for diverticulitis. It's a commonly used medicine and most people tolerate it well. Drink plenty and start with a light diet. One warning sign to remember: the symptoms get worse. In that case don't wait. Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.67,
      "end_seconds": 322.41,
      "duration_seconds": 1.74,
      "text": "That's clear, thanks."
    }
  ]
}