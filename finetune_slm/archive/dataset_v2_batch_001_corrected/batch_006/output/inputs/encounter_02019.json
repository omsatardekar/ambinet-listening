  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.95,
      "duration_seconds": 4.0,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.98,
      "end_seconds": 10.05,
      "duration_seconds": 4.07,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 20.75,
      "duration_seconds": 8.85,
      "text": "I've been coughing up pink frothy sputum. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.6,
      "end_seconds": 24.33,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.32,
      "end_seconds": 47.31,
      "duration_seconds": 21.99,
      "text": "mm, uh, it's been one week, I'm fairly sure. I've, I've had a pounding heart too, for three weeks. And I've been sweating as well, since Friday. Hmm, about sweating, it's mild, honestly. It's on and off"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.09,
      "end_seconds": 54.24,
      "duration_seconds": 6.15,
      "text": "what do you take on a normal day? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.25,
      "end_seconds": 61.85,
      "duration_seconds": 6.6,
      "text": "Metoprolol, 50 milligrams, twice a day i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.5,
      "end_seconds": 64.68,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.11,
      "end_seconds": 67.76,
      "duration_seconds": 1.65,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.93,
      "end_seconds": 77.12,
      "duration_seconds": 2.19,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.14,
      "end_seconds": 82.91,
      "duration_seconds": 3.77,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.27,
      "end_seconds": 85.93,
      "duration_seconds": 1.66,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.07,
      "end_seconds": 91.19,
      "duration_seconds": 4.12,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.49,
      "end_seconds": 95.4,
      "duration_seconds": 2.91,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.84,
      "end_seconds": 100.48,
      "duration_seconds": 3.64,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.19,
      "end_seconds": 104.01,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.76,
      "end_seconds": 113.87,
      "duration_seconds": 8.11,
      "text": "Yes, heart failure. I looked a few things up online, and that that probably didn't help."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.1,
      "end_seconds": 123.3,
      "duration_seconds": 4.2,
      "text": "Understood. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.02,
      "end_seconds": 130.77,
      "duration_seconds": 3.75,
      "text": "Yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.81,
      "end_seconds": 152.91,
      "duration_seconds": 4.1,
      "text": "Alright, have you noticed fever, wheeze or calf pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.1,
      "end_seconds": 158.44,
      "duration_seconds": 4.34,
      "text": "I haven't had fever, wheeze or calf pain, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.03,
      "end_seconds": 163.02,
      "duration_seconds": 3.99,
      "text": "Understood. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.07,
      "end_seconds": 167.67,
      "duration_seconds": 3.6,
      "text": "Okay, so no, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.0,
      "end_seconds": 172.45,
      "duration_seconds": 3.45,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.33,
      "end_seconds": 174.45,
      "duration_seconds": 1.12,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.7,
      "end_seconds": 188.32,
      "duration_seconds": 2.62,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.79,
      "end_seconds": 198.67,
      "duration_seconds": 2.88,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.59,
      "end_seconds": 214.22,
      "duration_seconds": 3.63,
      "text": "okay: pulse 96, BP is 138 over 75."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.83,
      "end_seconds": 222.19,
      "duration_seconds": 5.36,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.84,
      "end_seconds": 225.2,
      "duration_seconds": 1.36,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.7,
      "end_seconds": 245.64,
      "duration_seconds": 5.94,
      "text": "There are crackles all the way up both lungs and you are breathing very fast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.25,
      "end_seconds": 259.81,
      "duration_seconds": 10.56,
      "text": "good, you can sit up again right, here's what I'm thinking the most likely explanation is acute pulmonary oedema a severe chest infection is still possible"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.54,
      "end_seconds": 262.78,
      "duration_seconds": 2.24,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.79,
      "end_seconds": 284.58,
      "duration_seconds": 20.79,
      "text": "Nothing I've seen today points to an emergency. It looks like acute pulmonary oedema, but I'd like to confirm. I'd like to arrange a chest X-ray for pulmonary oedema. That will help us see what's going on underneath and and decide the next step."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 286.0,
      "end_seconds": 289.57,
      "duration_seconds": 3.57,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.98,
      "end_seconds": 313.45,
      "duration_seconds": 22.47,
      "text": "I'd like to arrange blood tests for pulmonary oedema. That will help us see what's going on underneath and decide the next step. I'm prescribing furosemide, 40 milligrams, once now, single dose. That should help with fluid on the lungs. Sit upright, I am giving oxygen and a water tablet injection now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.8,
      "end_seconds": 318.97,
      "duration_seconds": 5.17,
      "text": "Okay, go on. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.8,
      "end_seconds": 321.5,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.54,
      "end_seconds": 335.01,
      "duration_seconds": 12.47,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Let's review you straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.65,
      "end_seconds": 339.73,
      "duration_seconds": 3.08,
      "text": "great, thank you for your help"
    }
  ]
}