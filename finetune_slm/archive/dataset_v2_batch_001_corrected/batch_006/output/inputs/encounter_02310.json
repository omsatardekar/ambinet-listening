{
  "schema_version": "1.0",
  "encounter_id": "02310",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.05,
      "duration_seconds": 3.94,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.6,
      "duration_seconds": 4.33,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.96,
      "end_seconds": 19.44,
      "duration_seconds": 7.48,
      "text": "I wanted to get a bone sticking out of my lower leg looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 23.81,
      "duration_seconds": 3.78,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 45.59,
      "duration_seconds": 21.24,
      "text": "Since Friday, that's when it began. I've also had numbness in the foot, since Monday. About numbness in the foot, it feels severe to me. As for heavy bleeding, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.0,
      "end_seconds": 61.96,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.86,
      "end_seconds": 73.97,
      "duration_seconds": 10.11,
      "text": "I take spironolactone, 25 milligrams, once a day for my heart. I'm on mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 77.14,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.35,
      "end_seconds": 94.35,
      "duration_seconds": 14.0,
      "text": "I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.11,
      "end_seconds": 98.03,
      "duration_seconds": 2.92,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.83,
      "end_seconds": 100.74,
      "duration_seconds": 1.91,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.49,
      "end_seconds": 103.92,
      "duration_seconds": 2.43,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.99,
      "end_seconds": 108.25,
      "duration_seconds": 3.26,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 112.65,
      "duration_seconds": 2.59,
      "text": "Right, what about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.67,
      "end_seconds": 118.46,
      "duration_seconds": 3.79,
      "text": "I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.41,
      "end_seconds": 121.16,
      "duration_seconds": 1.75,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.48,
      "end_seconds": 123.69,
      "duration_seconds": 1.21,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 125.66,
      "duration_seconds": 1.11,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.41,
      "end_seconds": 129.25,
      "duration_seconds": 1.84,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.71,
      "end_seconds": 143.9,
      "duration_seconds": 13.19,
      "text": "I see, go ahead. Right, so depression is already on your record. We'll keep that in mind today. Let me check a few things. Any head injury or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.47,
      "end_seconds": 148.15,
      "duration_seconds": 3.68,
      "text": "No, no head injury or chest pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.75,
      "end_seconds": 151.97,
      "duration_seconds": 3.22,
      "text": "Have you had any loss of consciousness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.87,
      "end_seconds": 159.7,
      "duration_seconds": 3.83,
      "text": "I haven't noticed any loss of consciousness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.77,
      "end_seconds": 163.38,
      "duration_seconds": 2.61,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.98,
      "end_seconds": 166.02,
      "duration_seconds": 2.04,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.65,
      "end_seconds": 170.58,
      "duration_seconds": 2.93,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.62,
      "end_seconds": 173.53,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.28,
      "end_seconds": 177.01,
      "duration_seconds": 2.73,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.18,
      "end_seconds": 190.85,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.78,
      "end_seconds": 223.76,
      "duration_seconds": 16.98,
      "text": "Okay: respiratory rate 16, BP is 119 over 85. And BMI works out to 26.6, weight 68 kilos, temperature is 37.1 degrees, saturation 96 percent, height 160 centimetres, heart rate 104."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.28,
      "end_seconds": 227.34,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.2,
      "end_seconds": 230.76,
      "duration_seconds": 1.56,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 249.42,
      "duration_seconds": 6.78,
      "text": "There is a wound with bone visible and the foot is cool with no pulse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 254.73,
      "duration_seconds": 2.86,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.58,
      "end_seconds": 275.31,
      "duration_seconds": 7.73,
      "text": "Let's get an urgent X-ray, for open fracture. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.23,
      "end_seconds": 279.58,
      "duration_seconds": 2.35,
      "text": "The earliest is Wednesday, 9 am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.24,
      "end_seconds": 304.44,
      "duration_seconds": 23.2,
      "text": "I'll request blood tests, it'll help with pre-operative what I'm giving you is co-amoxiclav, 1.2 grams, now, single dose that's for open fracture keep still, I am splinting the leg and sending you to theatre now i'd like to see you again straight away does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.25,
      "end_seconds": 312.29,
      "duration_seconds": 4.04,
      "text": "Oh, I think I understand everything. Thanks."
    }
  ]
}