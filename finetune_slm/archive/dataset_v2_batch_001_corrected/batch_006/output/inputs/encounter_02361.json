{
  "schema_version": "1.0",
  "encounter_id": "02361",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 4.18,
      "duration_seconds": 2.93,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.37,
      "end_seconds": 7.46,
      "duration_seconds": 2.09,
      "text": "Evening, you know, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.85,
      "end_seconds": 14.1,
      "duration_seconds": 5.25,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.6,
      "end_seconds": 21.78,
      "duration_seconds": 6.18,
      "text": "That's fine, sit down. We'll go through it together. Busy day out there?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.81,
      "end_seconds": 28.0,
      "duration_seconds": 4.19,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.74,
      "end_seconds": 32.16,
      "duration_seconds": 3.42,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 40.78,
      "duration_seconds": 7.64,
      "text": "Mainly no symptoms. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.73,
      "end_seconds": 45.46,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.52,
      "end_seconds": 49.53,
      "duration_seconds": 3.01,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.6,
      "end_seconds": 55.2,
      "duration_seconds": 4.6,
      "text": "Hmm, I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 60.92,
      "duration_seconds": 4.68,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.9,
      "end_seconds": 64.92,
      "duration_seconds": 2.02,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.0,
      "end_seconds": 71.63,
      "duration_seconds": 4.63,
      "text": "Alright, what about a new partner, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.15,
      "end_seconds": 74.71,
      "duration_seconds": 1.56,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.26,
      "end_seconds": 81.81,
      "duration_seconds": 5.55,
      "text": "Have you had no symptoms before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.09,
      "end_seconds": 87.8,
      "duration_seconds": 4.71,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.96,
      "end_seconds": 109.13,
      "duration_seconds": 5.17,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.58,
      "end_seconds": 114.6,
      "duration_seconds": 4.02,
      "text": "Yes, walnuts, it gives me my lips swelling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.32,
      "end_seconds": 121.38,
      "duration_seconds": 5.06,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.2,
      "end_seconds": 132.44,
      "duration_seconds": 5.24,
      "text": "I take spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.39,
      "end_seconds": 137.69,
      "duration_seconds": 3.3,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.65,
      "end_seconds": 150.42,
      "duration_seconds": 10.77,
      "text": "About six months. I'm on aspirin, 75 milligrams, once a day. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.34,
      "end_seconds": 153.6,
      "duration_seconds": 1.26,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.41,
      "end_seconds": 157.02,
      "duration_seconds": 1.61,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.81,
      "end_seconds": 159.87,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.3,
      "end_seconds": 166.51,
      "duration_seconds": 5.21,
      "text": "I've got heart failure. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.85,
      "end_seconds": 171.47,
      "duration_seconds": 1.62,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.81,
      "end_seconds": 177.31,
      "duration_seconds": 4.5,
      "text": "I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.29,
      "end_seconds": 181.16,
      "duration_seconds": 2.87,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.32,
      "end_seconds": 197.38,
      "duration_seconds": 10.06,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.34,
      "end_seconds": 208.94,
      "duration_seconds": 9.6,
      "text": "My husband and I live above the shop. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.62,
      "end_seconds": 212.99,
      "duration_seconds": 2.37,
      "text": "Have you had any discharge?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.54,
      "end_seconds": 218.76,
      "duration_seconds": 4.22,
      "text": "Not that I've noticed, uh, no discharge."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.78,
      "end_seconds": 224.59,
      "duration_seconds": 4.81,
      "text": "Have you had any rash, sores or burning when passing urine?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.23,
      "end_seconds": 228.36,
      "duration_seconds": 3.13,
      "text": "Oh, no, not a single one."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.89,
      "end_seconds": 233.05,
      "duration_seconds": 4.16,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.59,
      "end_seconds": 236.51,
      "duration_seconds": 1.92,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.39,
      "end_seconds": 244.52,
      "duration_seconds": 5.13,
      "text": "So, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.12,
      "end_seconds": 248.1,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.86,
      "end_seconds": 263.97,
      "duration_seconds": 3.11,
      "text": "There are no visible sores or discharge."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 271.37,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.33,
      "end_seconds": 322.21,
      "duration_seconds": 31.88,
      "text": "Right, here's what I'm thinking. I'd lean towards a routine screen with no symptoms. I'm sending you for blood tests for HIV and syphilis because of sexual health screen. I'll request a urine test for chlamydia and gonorrhoea, it'll help with sexual health screen. Use condoms with new partners and we will text the results. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.19,
      "end_seconds": 326.28,
      "duration_seconds": 2.09,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.59,
      "end_seconds": 336.15,
      "duration_seconds": 6.56,
      "text": "Please come and see me after the results. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.84,
      "end_seconds": 339.45,
      "duration_seconds": 2.61,
      "text": "Yeah, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.19,
      "end_seconds": 343.04,
      "duration_seconds": 1.85,
      "text": "Have a good day."
    }
  ]
}