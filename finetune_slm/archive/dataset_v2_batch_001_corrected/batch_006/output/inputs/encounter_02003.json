  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.19,
      "end_seconds": 6.86,
      "duration_seconds": 5.67,
      "text": "Doctor, I've brought them through. The The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.4,
      "end_seconds": 11.56,
      "duration_seconds": 3.16,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.09,
      "end_seconds": 18.0,
      "duration_seconds": 5.91,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 23.5,
      "duration_seconds": 4.72,
      "text": "of course, please stay. It's helpful to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.51,
      "end_seconds": 28.09,
      "duration_seconds": 3.58,
      "text": "it's a high fever and shivers, mostly"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.8,
      "end_seconds": 30.58,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.43,
      "end_seconds": 42.4,
      "duration_seconds": 10.97,
      "text": "Okay, so hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.59,
      "end_seconds": 45.77,
      "duration_seconds": 2.18,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.98,
      "end_seconds": 61.04,
      "duration_seconds": 14.06,
      "text": "when it starts I tend to get severe pain as well as for severe pain, it feels moderate to me i'd say every other day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.69,
      "end_seconds": 64.33,
      "duration_seconds": 2.64,
      "text": "Have you been feeling very unwell?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.17,
      "end_seconds": 79.1,
      "duration_seconds": 12.93,
      "text": "Yes, I have. With feeling very unwell, about a six out of ten. There was rapidly spreading redness on the thigh, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.19,
      "end_seconds": 84.98,
      "duration_seconds": 3.79,
      "text": "have you noticed diarrhoea, cough or recent cut?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.49,
      "end_seconds": 92.74,
      "duration_seconds": 2.25,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.45,
      "end_seconds": 97.38,
      "duration_seconds": 2.93,
      "text": "Any trouble with the the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 100.83,
      "duration_seconds": 2.19,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.96,
      "end_seconds": 104.79,
      "duration_seconds": 2.83,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.44,
      "end_seconds": 112.56,
      "duration_seconds": 6.12,
      "text": "I have diabetes. I have an irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.06,
      "end_seconds": 114.76,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.42,
      "end_seconds": 119.45,
      "duration_seconds": 4.03,
      "text": "An underactive thyroid, for nearly five years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.13,
      "end_seconds": 128.79,
      "duration_seconds": 8.66,
      "text": "Right, so diabetes and an underactive thyroid are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.88,
      "end_seconds": 148.95,
      "duration_seconds": 3.07,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.74,
      "end_seconds": 154.21,
      "duration_seconds": 4.47,
      "text": "my son has asthma. My uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.26,
      "end_seconds": 158.71,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.42,
      "end_seconds": 172.78,
      "duration_seconds": 12.36,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.79,
      "end_seconds": 176.97,
      "duration_seconds": 3.18,
      "text": "okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.39,
      "end_seconds": 187.48,
      "duration_seconds": 7.09,
      "text": "She is on sitagliptin, once a day for my sugar, I give it to her."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.25,
      "end_seconds": 190.28,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 191.93,
      "end_seconds": 205.72,
      "duration_seconds": 13.79,
      "text": "100 milligrams, I think that's what's on the box. She is on metoprolol, twice a day for the heart rhythm, I give it to her."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.12,
      "end_seconds": 209.08,
      "duration_seconds": 1.96,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 209.73,
      "end_seconds": 216.16,
      "duration_seconds": 6.43,
      "text": "50 milligrams. It's Thyronorm, 50 micrograms, every morning for my thyroid, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.48,
      "end_seconds": 219.87,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.24,
      "end_seconds": 225.23,
      "duration_seconds": 3.99,
      "text": "oh, nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.12,
      "end_seconds": 229.08,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.78,
      "end_seconds": 233.47,
      "duration_seconds": 2.69,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.4,
      "end_seconds": 236.87,
      "duration_seconds": 2.47,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.8,
      "end_seconds": 242.5,
      "duration_seconds": 3.7,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.3,
      "end_seconds": 247.1,
      "duration_seconds": 2.8,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.22,
      "end_seconds": 251.62,
      "duration_seconds": 3.4,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.88,
      "end_seconds": 254.16,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.52,
      "end_seconds": 259.44,
      "duration_seconds": 3.92,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 260.65,
      "end_seconds": 270.36,
      "duration_seconds": 9.71,
      "text": "here are the numbers, doctor temperature 36.5, pulse 92, SpO2 98 percent on room air, blood pressure 102 over 61, respiratory rate 19."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.04,
      "end_seconds": 273.14,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.32,
      "end_seconds": 278.94,
      "duration_seconds": 3.62,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.37,
      "end_seconds": 282.7,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.75,
      "end_seconds": 301.6,
      "duration_seconds": 7.85,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.48,
      "end_seconds": 307.19,
      "duration_seconds": 1.71,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.81,
      "end_seconds": 328.47,
      "duration_seconds": 9.66,
      "text": "right, here's what I'm thinking it points towards a possible necrotising soft tissue infection i'd also keep severe cellulitis in mind"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.49,
      "end_seconds": 352.12,
      "duration_seconds": 11.63,
      "text": "I think an urgent surgical review makes sense here, for possible necrotising infection. I think urgent blood tests makes sense here, for possible necrotising infection."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 353.79,
      "end_seconds": 354.98,
      "duration_seconds": 1.19,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.74,
      "end_seconds": 381.29,
      "duration_seconds": 25.55,
      "text": "you need emergency surgery and intravenous antibiotics, we are going now try to get to bed and wake up at the same time each day, and keep your phone away from the bed let's get you seen by the surgical team, I'll arrange the letter if the symptoms get worse, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 383.15,
      "end_seconds": 384.76,
      "duration_seconds": 1.61,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.87,
      "end_seconds": 388.35,
      "duration_seconds": 2.48,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.95,
      "end_seconds": 392.76,
      "duration_seconds": 2.81,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.95,
      "end_seconds": 396.63,
      "duration_seconds": 2.68,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.31,
      "end_seconds": 402.26,
      "duration_seconds": 3.95,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.3,
      "end_seconds": 404.59,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}