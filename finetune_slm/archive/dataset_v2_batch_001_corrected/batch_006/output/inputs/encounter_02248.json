{
  "schema_version": "1.0",
  "encounter_id": "02248",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 2.65,
      "duration_seconds": 1.58,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.41,
      "end_seconds": 6.47,
      "duration_seconds": 3.06,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 9.85,
      "duration_seconds": 1.3,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 16.66,
      "duration_seconds": 4.77,
      "text": "Um, so... a headache. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 20.64,
      "duration_seconds": 3.11,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.25,
      "end_seconds": 24.51,
      "duration_seconds": 2.26,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.58,
      "end_seconds": 28.9,
      "duration_seconds": 2.32,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.83,
      "end_seconds": 33.39,
      "duration_seconds": 3.56,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.48,
      "end_seconds": 38.23,
      "duration_seconds": 3.75,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.18,
      "end_seconds": 58.85,
      "duration_seconds": 18.67,
      "text": "I'd say moderate. And there's a severe painful red eye as well, one week now. With severe painful red eye, mostly severe. Blurred vision with halos was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.74,
      "end_seconds": 73.09,
      "duration_seconds": 2.35,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.55,
      "end_seconds": 83.81,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 102.96,
      "duration_seconds": 9.22,
      "text": "Okay: blood pressure 112 over 82, SpO2 98 percent on room air, pulse 86, respiratory rate 14, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.25,
      "end_seconds": 108.93,
      "duration_seconds": 3.68,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.85,
      "end_seconds": 124.55,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.0,
      "end_seconds": 129.41,
      "duration_seconds": 3.41,
      "text": "Alright, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.18,
      "end_seconds": 150.42,
      "duration_seconds": 8.24,
      "text": "The right eye is red, the pupil is fixed and mid-sized, and the eye feels rock hard."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.36,
      "end_seconds": 158.34,
      "duration_seconds": 1.98,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.62,
      "end_seconds": 172.56,
      "duration_seconds": 3.94,
      "text": "Have you had any contact lens, injury or discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.93,
      "end_seconds": 178.77,
      "duration_seconds": 2.84,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.78,
      "end_seconds": 182.67,
      "duration_seconds": 2.89,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.13,
      "end_seconds": 186.32,
      "duration_seconds": 2.19,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.64,
      "end_seconds": 190.55,
      "duration_seconds": 2.91,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.58,
      "end_seconds": 197.6,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 201.26,
      "duration_seconds": 3.05,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.23,
      "end_seconds": 209.32,
      "duration_seconds": 3.09,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.91,
      "end_seconds": 211.48,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.7,
      "end_seconds": 214.96,
      "duration_seconds": 2.26,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.7,
      "end_seconds": 217.98,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.35,
      "end_seconds": 225.02,
      "duration_seconds": 5.67,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.13,
      "end_seconds": 228.87,
      "duration_seconds": 2.74,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.01,
      "end_seconds": 233.48,
      "duration_seconds": 1.47,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.95,
      "end_seconds": 237.3,
      "duration_seconds": 2.35,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.21,
      "end_seconds": 252.32,
      "duration_seconds": 14.11,
      "text": "I take tamsulosin, 0.4 milligrams, at night for the prostate. It's losartan, 50 milligrams, once a day for my blood pressure. It's alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.87,
      "end_seconds": 256.96,
      "duration_seconds": 3.09,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.15,
      "end_seconds": 260.4,
      "duration_seconds": 2.25,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.62,
      "end_seconds": 263.69,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.73,
      "end_seconds": 277.44,
      "duration_seconds": 9.71,
      "text": "So, I have an enlarged prostate, for five years. I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.86,
      "end_seconds": 279.64,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.95,
      "end_seconds": 287.07,
      "duration_seconds": 6.12,
      "text": "Um, um, I have thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.11,
      "end_seconds": 323.81,
      "duration_seconds": 35.7,
      "text": "Alright, an enlarged prostate and thin bones, that matches what I have here. Having listened and examined, I think we're dealing with acute angle-closure glaucoma at this stage. A severe infection is also on my list. I'll request an urgent eye pressure check, it'll help with acute glaucoma. I'll start you on acetazolamide, 500 milligrams, now, single dose. That should help with acute glaucoma. This is a sight-threatening emergency, I am sending you to the eye casualty now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.88,
      "end_seconds": 336.96,
      "duration_seconds": 12.08,
      "text": "I think the eye emergency service should see you too. See me again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.12,
      "end_seconds": 341.88,
      "duration_seconds": 3.76,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.87,
      "end_seconds": 345.54,
      "duration_seconds": 1.67,
      "text": "Okay, see you soon."
    }
  ]
}