{
  "schema_version": "1.0",
  "encounter_id": "02288",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 3.62,
      "duration_seconds": 2.88,
      "text": "Hello doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.03,
      "end_seconds": 8.77,
      "duration_seconds": 3.74,
      "text": "yes have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.31,
      "end_seconds": 18.36,
      "duration_seconds": 9.05,
      "text": "I wanted to get not knowing where she is looked at. It's the the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 22.3,
      "duration_seconds": 3.33,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.19,
      "end_seconds": 28.62,
      "duration_seconds": 4.43,
      "text": "I'd give it a a seven out of ten"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.88,
      "end_seconds": 32.26,
      "duration_seconds": 2.38,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.87,
      "end_seconds": 40.81,
      "duration_seconds": 6.94,
      "text": "Seeing things that aren't there goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.58,
      "end_seconds": 49.08,
      "duration_seconds": 7.5,
      "text": "Have you had not knowing where she is before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.08,
      "end_seconds": 56.49,
      "duration_seconds": 5.41,
      "text": "a bit, last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.67,
      "end_seconds": 75.0,
      "duration_seconds": 2.33,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.95,
      "end_seconds": 86.8,
      "duration_seconds": 2.85,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 106.45,
      "duration_seconds": 7.18,
      "text": "okay: blood pressure 108 over 70, SpO2 97 percent on room air, heart rate 88."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.72,
      "end_seconds": 111.38,
      "duration_seconds": 3.66,
      "text": "now I'm gonna do a short physical check"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.51,
      "end_seconds": 115.45,
      "duration_seconds": 2.94,
      "text": "I'll listen to to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.11,
      "end_seconds": 130.59,
      "duration_seconds": 5.48,
      "text": "She is drowsy, hot, disoriented, and and her blood pressure is low."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.42,
      "end_seconds": 138.17,
      "duration_seconds": 1.75,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.54,
      "end_seconds": 159.01,
      "duration_seconds": 5.47,
      "text": "have you noticed chest pain, weakness on one side or head injury?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.64,
      "end_seconds": 164.57,
      "duration_seconds": 2.93,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.19,
      "end_seconds": 167.13,
      "duration_seconds": 0.94,
      "text": "Any fall?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.88,
      "end_seconds": 171.12,
      "duration_seconds": 3.24,
      "text": "well, not at all, no fall"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.12,
      "end_seconds": 177.06,
      "duration_seconds": 3.94,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.61,
      "end_seconds": 179.97,
      "duration_seconds": 2.36,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.45,
      "end_seconds": 184.59,
      "duration_seconds": 3.14,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.99,
      "end_seconds": 195.16,
      "duration_seconds": 5.17,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.18,
      "end_seconds": 199.03,
      "duration_seconds": 2.85,
      "text": "what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 204.59,
      "duration_seconds": 4.82,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 210.36,
      "duration_seconds": 2.57,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.89,
      "end_seconds": 215.16,
      "duration_seconds": 3.27,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.35,
      "end_seconds": 227.12,
      "duration_seconds": 2.77,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.64,
      "end_seconds": 231.48,
      "duration_seconds": 2.84,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.59,
      "end_seconds": 236.58,
      "duration_seconds": 3.99,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.4,
      "end_seconds": 241.19,
      "duration_seconds": 3.79,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.08,
      "end_seconds": 243.54,
      "duration_seconds": 1.46,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.96,
      "end_seconds": 247.88,
      "duration_seconds": 2.92,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 253.51,
      "duration_seconds": 3.37,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.6,
      "end_seconds": 257.07,
      "duration_seconds": 2.47,
      "text": "It's metoprolol twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.78,
      "end_seconds": 259.81,
      "duration_seconds": 2.03,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.77,
      "end_seconds": 262.8,
      "duration_seconds": 1.03,
      "text": "50 milligrams"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.44,
      "end_seconds": 267.34,
      "duration_seconds": 3.9,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.21,
      "end_seconds": 270.76,
      "duration_seconds": 1.55,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.9,
      "end_seconds": 301.71,
      "duration_seconds": 29.81,
      "text": "Having listened and examined, this looks most like delirium from an infection. Blood tests is what I'd like next, for delirium. I think a chest X-ray makes sense here, for fever and confusion. She needs to go to hospital today for fluids and antibiotics. Don't skip meals, and try to eat smaller portions more often through the day. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.52,
      "end_seconds": 304.98,
      "duration_seconds": 2.46,
      "text": "sure where do I go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.28,
      "end_seconds": 308.89,
      "duration_seconds": 2.61,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.15,
      "end_seconds": 312.29,
      "duration_seconds": 2.14,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.05,
      "end_seconds": 315.14,
      "duration_seconds": 2.09,
      "text": "So, goodbye for now."
    }
  ]
}