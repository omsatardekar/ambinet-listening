{
  "schema_version": "1.0",
  "encounter_id": "02079",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 3.24,
      "duration_seconds": 1.85,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.61,
      "end_seconds": 7.46,
      "duration_seconds": 2.85,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.43,
      "end_seconds": 12.11,
      "duration_seconds": 2.68,
      "text": "doctor, thank you for seeing us"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.03,
      "end_seconds": 15.73,
      "duration_seconds": 2.7,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.35,
      "end_seconds": 32.68,
      "duration_seconds": 16.33,
      "text": "Yeah, it's a high fever and shivers. I don't know what's causing it. Work has been very busy so I kept ignoring it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.83,
      "end_seconds": 36.77,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.0,
      "end_seconds": 45.44,
      "duration_seconds": 7.44,
      "text": "It's been going on for one week. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.12,
      "end_seconds": 53.39,
      "duration_seconds": 7.27,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 53.49,
      "end_seconds": 59.51,
      "duration_seconds": 6.02,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.23,
      "end_seconds": 67.65,
      "duration_seconds": 6.42,
      "text": "Later, thanks. Please go on. Any rapidly spreading redness on the thigh as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.05,
      "end_seconds": 77.59,
      "duration_seconds": 8.54,
      "text": "yeah, I've had that since this morning and I've been feeling very unwell as well"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.26,
      "end_seconds": 85.88,
      "duration_seconds": 6.62,
      "text": "Have you had a high fever and shivers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.48,
      "end_seconds": 95.85,
      "duration_seconds": 8.37,
      "text": "Um, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 96.7,
      "end_seconds": 98.85,
      "duration_seconds": 2.15,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.54,
      "end_seconds": 104.05,
      "duration_seconds": 3.51,
      "text": "Did you get recent cut, diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.27,
      "end_seconds": 117.21,
      "duration_seconds": 11.94,
      "text": "No, no recent cut, no diarrhoea, no cough. I did have severe pain at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.06,
      "end_seconds": 125.36,
      "duration_seconds": 4.3,
      "text": "Any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.73,
      "end_seconds": 129.73,
      "duration_seconds": 3.0,
      "text": "right, no, that's all normal"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.57,
      "end_seconds": 134.46,
      "duration_seconds": 2.89,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.98,
      "end_seconds": 144.44,
      "duration_seconds": 9.46,
      "text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I swim twice a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.24,
      "end_seconds": 154.6,
      "duration_seconds": 2.36,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.12,
      "end_seconds": 161.25,
      "duration_seconds": 5.13,
      "text": "Gliclazide. I take it 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 165.87,
      "duration_seconds": 2.88,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.85,
      "end_seconds": 171.58,
      "duration_seconds": 3.73,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.28,
      "end_seconds": 180.98,
      "duration_seconds": 7.7,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 188.68,
      "duration_seconds": 2.87,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.56,
      "end_seconds": 211.47,
      "duration_seconds": 20.91,
      "text": "Sorry, what was I saying, for the anxiety, I believe. My son sets them out for me, I just take what I'm given. I take Eltroxin, 100 micrograms, every morning. Okay, so it's rosuvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.29,
      "end_seconds": 215.58,
      "duration_seconds": 2.29,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.17,
      "end_seconds": 217.07,
      "duration_seconds": 0.9,
      "text": "10 milligrams"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.58,
      "end_seconds": 220.48,
      "duration_seconds": 2.9,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.08,
      "end_seconds": 227.17,
      "duration_seconds": 5.09,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.08,
      "end_seconds": 233.28,
      "duration_seconds": 5.2,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.15,
      "end_seconds": 236.21,
      "duration_seconds": 2.06,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 251.04,
      "duration_seconds": 2.62,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.94,
      "end_seconds": 283.82,
      "duration_seconds": 31.88,
      "text": "I have diabetes, for nearly five years. It's the not knowing that gets to me. Yes, anxiety. An underactive thyroid, for two years. I didn't want to bother you but it keeps coming back. High cholesterol, for nearly five years. I've been putting this off for weeks. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.86,
      "end_seconds": 295.01,
      "duration_seconds": 9.15,
      "text": "Okay, I can see diabetes and anxiety in your file as well. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.03,
      "end_seconds": 301.66,
      "duration_seconds": 5.63,
      "text": "My sister had breast cancer. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 302.63,
      "end_seconds": 312.25,
      "duration_seconds": 9.62,
      "text": "Here are the numbers, doctor. Respiratory rate 19, SpO2 96 percent on room air, blood pressure 102 over 65, heart rate 94."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.28,
      "end_seconds": 314.27,
      "duration_seconds": 0.99,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.69,
      "end_seconds": 321.62,
      "duration_seconds": 4.93,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.37,
      "end_seconds": 326.82,
      "duration_seconds": 3.45,
      "text": "Right, take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.63,
      "end_seconds": 353.29,
      "duration_seconds": 7.66,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.43,
      "end_seconds": 379.24,
      "duration_seconds": 21.81,
      "text": "Please sit back down. Taking everything into account, I can't pin this down yet. We're looking at a possible necrotising soft tissue infection or severe cellulitis. Stop me if I've got anything wrong. You've had a high fever and shivers for one week, and no cough or recent cut."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.16,
      "end_seconds": 383.86,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.99,
      "end_seconds": 406.88,
      "duration_seconds": 21.89,
      "text": "Urgent blood tests is what I'd like next, for possible necrotising infection. I'm sending you for an urgent surgical review because of possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now. I'm going to send a referral to the surgical team."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.75,
      "end_seconds": 408.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.81,
      "end_seconds": 418.09,
      "duration_seconds": 8.28,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 419.91,
      "end_seconds": 423.02,
      "duration_seconds": 3.11,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.0,
      "end_seconds": 441.62,
      "duration_seconds": 12.62,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 443.58,
      "end_seconds": 446.54,
      "duration_seconds": 2.96,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 447.73,
      "end_seconds": 448.92,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}