{
  "schema_version": "1.0",
  "encounter_id": "02446",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.75,
      "duration_seconds": 3.65,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.75,
      "end_seconds": 10.65,
      "duration_seconds": 3.9,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.2,
      "end_seconds": 17.83,
      "duration_seconds": 6.63,
      "text": "Mm, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.45,
      "end_seconds": 27.54,
      "duration_seconds": 8.09,
      "text": "Okay, so honestly, it's a throbbing toothache, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.2,
      "end_seconds": 31.63,
      "duration_seconds": 3.43,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.65,
      "end_seconds": 38.58,
      "duration_seconds": 4.93,
      "text": "So, it's iron tablets, once a day, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.29,
      "end_seconds": 41.65,
      "duration_seconds": 2.36,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.41,
      "end_seconds": 45.57,
      "duration_seconds": 2.16,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 50.02,
      "duration_seconds": 3.34,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.94,
      "end_seconds": 54.5,
      "duration_seconds": 3.56,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.91,
      "end_seconds": 59.8,
      "duration_seconds": 3.89,
      "text": "Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.49,
      "end_seconds": 67.72,
      "duration_seconds": 6.23,
      "text": "I, I'd give it a three, um, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.2,
      "end_seconds": 71.69,
      "duration_seconds": 2.49,
      "text": "Have you had a swollen cheek?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.67,
      "end_seconds": 76.13,
      "duration_seconds": 2.46,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.87,
      "end_seconds": 81.03,
      "duration_seconds": 3.16,
      "text": "Did you notice any difficulty opening the mouth?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.04,
      "end_seconds": 90.37,
      "duration_seconds": 4.33,
      "text": "No, none, no difficulty opening the mouth."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 99.0,
      "duration_seconds": 6.76,
      "text": "Let me check a few things. Any difficulty swallowing, eye swelling or noisy breathing?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.05,
      "end_seconds": 112.02,
      "duration_seconds": 7.97,
      "text": "Um, I haven't had difficulty swallowing, eye swelling or noisy breathing, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 118.35,
      "duration_seconds": 2.67,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.85,
      "end_seconds": 123.76,
      "duration_seconds": 3.91,
      "text": "Okay, so no, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.67,
      "end_seconds": 129.07,
      "duration_seconds": 3.4,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 135.96,
      "duration_seconds": 5.13,
      "text": "Let me think, um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.26,
      "end_seconds": 146.03,
      "duration_seconds": 1.77,
      "text": "Alright, what about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.9,
      "end_seconds": 150.97,
      "duration_seconds": 3.07,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.84,
      "end_seconds": 154.41,
      "duration_seconds": 1.57,
      "text": "Okay, any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.23,
      "end_seconds": 159.2,
      "duration_seconds": 3.97,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.23,
      "end_seconds": 163.74,
      "duration_seconds": 2.51,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.68,
      "end_seconds": 170.33,
      "duration_seconds": 4.65,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.86,
      "end_seconds": 172.44,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.11,
      "end_seconds": 177.24,
      "duration_seconds": 4.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.36,
      "end_seconds": 180.88,
      "duration_seconds": 2.52,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.63,
      "end_seconds": 190.36,
      "duration_seconds": 4.73,
      "text": "Uh, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.32,
      "end_seconds": 195.92,
      "duration_seconds": 3.6,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.28,
      "end_seconds": 203.71,
      "duration_seconds": 6.43,
      "text": "Uh, um, I have low haemoglobin, for about ten years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.94,
      "end_seconds": 211.29,
      "duration_seconds": 6.35,
      "text": "Right, so low haemoglobin is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.58,
      "end_seconds": 222.39,
      "duration_seconds": 2.81,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.69,
      "end_seconds": 239.14,
      "duration_seconds": 3.45,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.67,
      "end_seconds": 265.8,
      "duration_seconds": 15.13,
      "text": "Okay: weight 82 kilos, height 170 centimetres. And pulse is 100 beats a minute, respiratory rate 21, SpO2 96 percent on room air, BP is 109 over 68, temp 38.7 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.55,
      "end_seconds": 269.14,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.67,
      "end_seconds": 273.07,
      "duration_seconds": 2.4,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.57,
      "end_seconds": 279.02,
      "duration_seconds": 4.45,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.23,
      "end_seconds": 281.67,
      "duration_seconds": 1.44,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.32,
      "end_seconds": 296.86,
      "duration_seconds": 5.54,
      "text": "The lower right molar is tender with swollen gum and the cheek is puffy."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.07,
      "end_seconds": 300.93,
      "duration_seconds": 1.86,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.64,
      "end_seconds": 326.92,
      "duration_seconds": 11.28,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be a dental abscess, or it might be a salivary gland infection."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.79,
      "end_seconds": 332.02,
      "duration_seconds": 3.23,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.84,
      "end_seconds": 347.3,
      "duration_seconds": 14.46,
      "text": "I understand the worry. At the moment I'd say it's a dental abscess, and we'll know more once the a dental X-ray is back. I think a dental X-ray makes sense here, for dental abscess."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.67,
      "end_seconds": 350.86,
      "duration_seconds": 2.19,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.16,
      "end_seconds": 385.53,
      "duration_seconds": 33.37,
      "text": "I'd like you to take amoxicillin, 500 milligrams, three times a day, five days. You take it by mouth. That should help with dental abscess. See the dentist today, rinse with warm salt water. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. See me again in two days."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.08,
      "end_seconds": 389.69,
      "duration_seconds": 2.61,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.94,
      "end_seconds": 399.65,
      "duration_seconds": 4.71,
      "text": "Hmm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.67,
      "end_seconds": 401.91,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}