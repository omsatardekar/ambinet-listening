{
  "schema_version": "1.0",
  "encounter_id": "02063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 4.13,
      "duration_seconds": 3.53,
      "text": "come in, have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.94,
      "end_seconds": 9.61,
      "duration_seconds": 3.67,
      "text": "Afternoon, you know, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.61,
      "end_seconds": 12.58,
      "duration_seconds": 1.97,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.29,
      "end_seconds": 20.6,
      "duration_seconds": 6.31,
      "text": "well, I've been having a chronic cough with lots of phlegm"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 25.92,
      "duration_seconds": 3.41,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 30.47,
      "duration_seconds": 3.02,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.15,
      "end_seconds": 34.16,
      "duration_seconds": 2.01,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.86,
      "end_seconds": 38.4,
      "duration_seconds": 2.54,
      "text": "Mornings definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.71,
      "end_seconds": 42.13,
      "duration_seconds": 2.42,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.76,
      "end_seconds": 60.33,
      "duration_seconds": 17.57,
      "text": "Green phlegm lately goes along with it, most of the the time. I've also been getting out of breath, since last night. Sorry, what was I saying, the Green phlegm lately? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.83,
      "end_seconds": 61.53,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.1,
      "end_seconds": 83.23,
      "duration_seconds": 3.13,
      "text": "did you get fever or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.15,
      "end_seconds": 88.65,
      "duration_seconds": 3.5,
      "text": "well, no, no fever or weight loss"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.43,
      "end_seconds": 94.87,
      "duration_seconds": 4.44,
      "text": "And what about chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.58,
      "end_seconds": 101.19,
      "duration_seconds": 4.61,
      "text": "I haven't had chest pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.79,
      "end_seconds": 105.85,
      "duration_seconds": 3.06,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.21,
      "end_seconds": 109.44,
      "duration_seconds": 2.23,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.94,
      "end_seconds": 113.04,
      "duration_seconds": 2.1,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.91,
      "end_seconds": 114.83,
      "duration_seconds": 0.92,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 131.43,
      "duration_seconds": 3.44,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.0,
      "end_seconds": 136.7,
      "duration_seconds": 4.7,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 141.46,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.23,
      "end_seconds": 145.73,
      "duration_seconds": 3.5,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.47,
      "end_seconds": 150.55,
      "duration_seconds": 4.08,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.26,
      "end_seconds": 154.63,
      "duration_seconds": 2.37,
      "text": "my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.66,
      "end_seconds": 159.19,
      "duration_seconds": 3.53,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.1,
      "end_seconds": 166.16,
      "duration_seconds": 5.06,
      "text": "I'm allergic to walnuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.98,
      "end_seconds": 172.53,
      "duration_seconds": 5.55,
      "text": "Do you have any chronic illnesses? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 178.49,
      "duration_seconds": 4.16,
      "text": "I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.58,
      "end_seconds": 183.19,
      "duration_seconds": 3.61,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.19,
      "end_seconds": 188.38,
      "duration_seconds": 3.19,
      "text": "I'm on carvedilol, twice a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.66,
      "end_seconds": 192.13,
      "duration_seconds": 2.47,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.97,
      "end_seconds": 198.68,
      "duration_seconds": 5.71,
      "text": "6.25 milligrams, I think that's what's on the the box."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.05,
      "end_seconds": 202.61,
      "duration_seconds": 2.56,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.37,
      "end_seconds": 214.6,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.16,
      "end_seconds": 238.94,
      "duration_seconds": 9.78,
      "text": "Okay: heart rate 79, pressure 118 over 79, oxygen saturation is 97 percent. And temperature is 36.8 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.38,
      "end_seconds": 245.32,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.68,
      "end_seconds": 249.53,
      "duration_seconds": 2.85,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.86,
      "end_seconds": 273.31,
      "duration_seconds": 5.45,
      "text": "there are coarse crackles at both bases and the the fingers are slightly clubbed"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.31,
      "end_seconds": 277.86,
      "duration_seconds": 2.55,
      "text": "Yeah, um, no problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.72,
      "end_seconds": 294.45,
      "duration_seconds": 10.73,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, the most likely explanation is a flare of bronchiectasis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.99,
      "end_seconds": 311.78,
      "duration_seconds": 4.79,
      "text": "I think a sputum culture makes sense here, for purulent sputum"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 312.86,
      "end_seconds": 316.52,
      "duration_seconds": 3.66,
      "text": "I can book that for Tuesday at 2 pm"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.87,
      "end_seconds": 345.51,
      "duration_seconds": 25.64,
      "text": "I'll request a chest X-ray, it'll help with bronchiectasis flare. Let's use clarithromycin, 500 milligrams, twice a day, fourteen days. It's for bronchiectasis flare. Keep up your airway clearance exercises twice a day. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.14,
      "end_seconds": 350.75,
      "duration_seconds": 3.61,
      "text": "I, I know what to watch for"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.32,
      "end_seconds": 355.61,
      "duration_seconds": 3.29,
      "text": "Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.29,
      "end_seconds": 363.11,
      "duration_seconds": 1.82,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.06,
      "end_seconds": 368.94,
      "duration_seconds": 3.88,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.97,
      "end_seconds": 378.1,
      "duration_seconds": 4.13,
      "text": "right, I'll do that. Thank you, doctor"
    }
  ]
}