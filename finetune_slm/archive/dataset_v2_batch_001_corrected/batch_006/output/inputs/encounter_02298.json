{
  "schema_version": "1.0",
  "encounter_id": "02298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 5.05,
      "duration_seconds": 3.99,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.64,
      "end_seconds": 8.65,
      "duration_seconds": 3.01,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.52,
      "end_seconds": 12.22,
      "duration_seconds": 1.7,
      "text": "so, what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.05,
      "end_seconds": 24.22,
      "duration_seconds": 9.17,
      "text": "So, I've been getting puffed climbing stairs, doctor. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 27.98,
      "duration_seconds": 2.1,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.75,
      "end_seconds": 31.2,
      "duration_seconds": 2.45,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.95,
      "end_seconds": 43.46,
      "duration_seconds": 8.51,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.15,
      "end_seconds": 51.62,
      "duration_seconds": 7.47,
      "text": "Mild, really. I'd say a few times a day. I notice it more with stairs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.54,
      "end_seconds": 57.37,
      "duration_seconds": 4.83,
      "text": "Any a bit of a cough with exercise as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.14,
      "end_seconds": 61.15,
      "duration_seconds": 2.01,
      "text": "yes, for five days"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.12,
      "end_seconds": 66.01,
      "duration_seconds": 3.89,
      "text": "is it bearing on you a a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.57,
      "end_seconds": 69.07,
      "duration_seconds": 1.5,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.14,
      "end_seconds": 73.87,
      "duration_seconds": 2.73,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.19,
      "end_seconds": 78.68,
      "duration_seconds": 3.49,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.5,
      "end_seconds": 83.75,
      "duration_seconds": 3.25,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.79,
      "end_seconds": 87.83,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.86,
      "end_seconds": 109.97,
      "duration_seconds": 4.11,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.83,
      "end_seconds": 114.84,
      "duration_seconds": 4.01,
      "text": "No, um, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.92,
      "end_seconds": 117.91,
      "duration_seconds": 1.99,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.16,
      "end_seconds": 124.3,
      "duration_seconds": 1.14,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.64,
      "end_seconds": 137.82,
      "duration_seconds": 3.18,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 147.88,
      "duration_seconds": 5.99,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 154.51,
      "duration_seconds": 5.2,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.73,
      "end_seconds": 170.66,
      "duration_seconds": 14.93,
      "text": "My husband and I live above the shop. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.55,
      "end_seconds": 175.29,
      "duration_seconds": 2.74,
      "text": "any wheeze or palpitations at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.93,
      "end_seconds": 179.45,
      "duration_seconds": 2.52,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.56,
      "end_seconds": 183.64,
      "duration_seconds": 3.08,
      "text": "Any chest pain or fainting at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.33,
      "end_seconds": 187.05,
      "duration_seconds": 2.72,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.17,
      "end_seconds": 190.62,
      "duration_seconds": 2.45,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 193.55,
      "duration_seconds": 2.24,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.54,
      "end_seconds": 202.62,
      "duration_seconds": 4.08,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.0,
      "end_seconds": 207.33,
      "duration_seconds": 3.33,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 217.89,
      "end_seconds": 227.19,
      "duration_seconds": 9.3,
      "text": "Okay, so the vitals from earlier. Heart rate 83, blood pressure 117 over 71, SpO2 97 percent on room air, respiratory rate 17."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.84,
      "end_seconds": 229.15,
      "duration_seconds": 1.31,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 235.62,
      "duration_seconds": 4.48,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 239.47,
      "duration_seconds": 2.15,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.37,
      "end_seconds": 261.68,
      "duration_seconds": 6.31,
      "text": "your chest is clear and your oxygen level is normal at rest and after walking"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.25,
      "end_seconds": 263.31,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.78,
      "end_seconds": 281.9,
      "duration_seconds": 13.12,
      "text": "Good, you can sit up again. Taking everything into account, it's hard to say. Breathlessness from low fitness is one possibility and mild asthma another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 282.96,
      "end_seconds": 289.46,
      "duration_seconds": 6.5,
      "text": "Doctor, I did a peak flow before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.59,
      "end_seconds": 311.98,
      "duration_seconds": 21.39,
      "text": "Thanks, that helps. Build up to thirty minutes of brisk walking five days a week. Come back or go to emergency straight away if the symptoms get worse. Please come and see me in eight weeks. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.04,
      "end_seconds": 316.21,
      "duration_seconds": 3.17,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.06,
      "end_seconds": 318.31,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}