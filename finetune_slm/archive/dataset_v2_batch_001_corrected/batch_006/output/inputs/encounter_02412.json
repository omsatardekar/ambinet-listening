{
  "schema_version": "1.0",
  "encounter_id": "02412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.56,
      "end_seconds": 6.7,
      "duration_seconds": 6.14,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.03,
      "end_seconds": 13.15,
      "duration_seconds": 5.12,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 19.64,
      "duration_seconds": 4.62,
      "text": "Yeah, it's no symptoms. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.23,
      "end_seconds": 24.64,
      "duration_seconds": 3.41,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.51,
      "end_seconds": 32.38,
      "duration_seconds": 2.87,
      "text": "it's been like this since yesterday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.69,
      "end_seconds": 37.02,
      "duration_seconds": 3.33,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.67,
      "end_seconds": 56.73,
      "duration_seconds": 18.06,
      "text": "It's mild, honestly. Oh, and being a little overweight. That's been about the same, two days. Oh, and a high blood sugar on a routine test. That's been about the same, about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.27,
      "end_seconds": 64.79,
      "duration_seconds": 6.52,
      "text": "okay, have you had no symptoms before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.53,
      "end_seconds": 72.32,
      "duration_seconds": 6.79,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.42,
      "end_seconds": 92.38,
      "duration_seconds": 2.96,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.26,
      "end_seconds": 96.09,
      "duration_seconds": 2.83,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.93,
      "end_seconds": 117.38,
      "duration_seconds": 3.45,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.54,
      "end_seconds": 123.45,
      "duration_seconds": 4.91,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.64,
      "end_seconds": 126.86,
      "duration_seconds": 2.22,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.75,
      "end_seconds": 131.47,
      "duration_seconds": 2.72,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.4,
      "end_seconds": 136.33,
      "duration_seconds": 3.93,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.07,
      "end_seconds": 139.9,
      "duration_seconds": 2.83,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.86,
      "end_seconds": 145.13,
      "duration_seconds": 3.27,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.54,
      "end_seconds": 153.29,
      "duration_seconds": 6.75,
      "text": "I have heart failure. I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.38,
      "end_seconds": 158.69,
      "duration_seconds": 4.31,
      "text": "Yes, carry on. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.13,
      "end_seconds": 169.68,
      "duration_seconds": 5.55,
      "text": "just a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.41,
      "end_seconds": 173.51,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.36,
      "end_seconds": 187.3,
      "duration_seconds": 11.94,
      "text": "Metoprolol, 50 milligrams, twice a day for my heart. It's diclofenac, 50 milligrams, when needed. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.53,
      "end_seconds": 207.76,
      "duration_seconds": 2.23,
      "text": "And thirst, any of that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.51,
      "end_seconds": 210.56,
      "duration_seconds": 2.05,
      "text": "No, none, no thirst."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.32,
      "end_seconds": 215.34,
      "duration_seconds": 4.02,
      "text": "have you noticed blurred vision, weight loss or frequent urination?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.98,
      "end_seconds": 220.41,
      "duration_seconds": 4.43,
      "text": "No, you know, none of those at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.05,
      "end_seconds": 223.85,
      "duration_seconds": 2.8,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.96,
      "end_seconds": 228.38,
      "duration_seconds": 3.42,
      "text": "Okay, so no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 229.76,
      "end_seconds": 238.27,
      "duration_seconds": 8.51,
      "text": "Doctor, I've got the readings for you. Pulse 76, blood pressure 115 over 70, temperature 36.7, respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.32,
      "end_seconds": 241.32,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.91,
      "end_seconds": 248.27,
      "duration_seconds": 4.36,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.77,
      "end_seconds": 250.38,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.46,
      "end_seconds": 253.42,
      "duration_seconds": 1.96,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.84,
      "end_seconds": 274.39,
      "duration_seconds": 3.55,
      "text": "Your blood pressure and heart rate are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.97,
      "end_seconds": 276.99,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.12,
      "end_seconds": 308.98,
      "duration_seconds": 26.86,
      "text": "you can relax now. From what you've told me and what I found, it fits best with prediabetes. That's my thinking for now, and it may change as we learn more. I'll request a repeat HbA1c, it'll help with prediabetes. The result will help us decide whether anything more is needed. Walk thirty minutes daily, cut sugary drinks and aim to lose five percent of your weight"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.73,
      "end_seconds": 315.56,
      "duration_seconds": 5.83,
      "text": "please take the tablets with food so they don't upset your stomach"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.96,
      "end_seconds": 325.19,
      "duration_seconds": 9.23,
      "text": "yes, carry on. I'll also refer you to the diabetes prevention programme. I'd like to see you again in six months"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.23,
      "end_seconds": 329.72,
      "duration_seconds": 3.49,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.34,
      "end_seconds": 336.46,
      "duration_seconds": 5.12,
      "text": "before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 340.64,
      "end_seconds": 345.45,
      "duration_seconds": 4.81,
      "text": "so, I come back in six months. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.27,
      "end_seconds": 351.16,
      "duration_seconds": 3.89,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 352.75,
      "end_seconds": 356.28,
      "duration_seconds": 3.53,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}