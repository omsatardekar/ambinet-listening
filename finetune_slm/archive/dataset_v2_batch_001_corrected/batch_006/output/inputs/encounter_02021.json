{
  "schema_version": "1.0",
  "encounter_id": "02021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 7.38,
      "duration_seconds": 6.11,
      "text": "hello, sorry about the delay, do sit. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.14,
      "end_seconds": 16.57,
      "duration_seconds": 8.43,
      "text": "Mainly a nosebleed that won't stop. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 21.29,
      "duration_seconds": 2.75,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 26.2,
      "duration_seconds": 3.07,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.56,
      "end_seconds": 35.38,
      "duration_seconds": 7.82,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.23,
      "end_seconds": 54.88,
      "duration_seconds": 17.65,
      "text": "It's worse with blowing the nose. I'd say moderate. It settles a little with pinching. Oh, um, and blood down the back of my throat. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.09,
      "end_seconds": 76.86,
      "duration_seconds": 3.77,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.21,
      "end_seconds": 83.85,
      "duration_seconds": 5.64,
      "text": "I take a blood thinner, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.1,
      "end_seconds": 106.47,
      "duration_seconds": 5.37,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.84,
      "end_seconds": 110.36,
      "duration_seconds": 2.52,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.09,
      "end_seconds": 128.14,
      "duration_seconds": 3.05,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.67,
      "end_seconds": 131.55,
      "duration_seconds": 2.88,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.56,
      "end_seconds": 135.0,
      "duration_seconds": 2.44,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.88,
      "end_seconds": 139.69,
      "duration_seconds": 3.81,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.1,
      "end_seconds": 146.56,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.01,
      "end_seconds": 150.05,
      "duration_seconds": 2.04,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.71,
      "end_seconds": 155.49,
      "duration_seconds": 3.78,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.97,
      "end_seconds": 158.58,
      "duration_seconds": 1.61,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.14,
      "end_seconds": 162.1,
      "duration_seconds": 1.96,
      "text": "how about head injury?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.2,
      "end_seconds": 166.17,
      "duration_seconds": 1.97,
      "text": "No, no head injury."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 172.71,
      "duration_seconds": 4.86,
      "text": "Let me check a few things. Any black stools or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.5,
      "end_seconds": 177.49,
      "duration_seconds": 3.99,
      "text": "no, no black stools or chest pain"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.08,
      "end_seconds": 183.66,
      "duration_seconds": 5.58,
      "text": "Okay, go on. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.77,
      "end_seconds": 186.75,
      "duration_seconds": 1.98,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 192.49,
      "duration_seconds": 3.82,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.54,
      "end_seconds": 197.39,
      "duration_seconds": 2.85,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 198.96,
      "end_seconds": 206.71,
      "duration_seconds": 7.75,
      "text": "Doctor, I've got the readings for you. Blood pressure 128 over 69, heart rate 83, respiratory rate 16."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.93,
      "end_seconds": 209.94,
      "duration_seconds": 2.01,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.4,
      "end_seconds": 215.97,
      "duration_seconds": 3.57,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.66,
      "end_seconds": 218.7,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.58,
      "end_seconds": 221.75,
      "duration_seconds": 2.17,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.74,
      "end_seconds": 245.31,
      "duration_seconds": 7.57,
      "text": "There is a bleeding point on the front of the septum and the nose has been dry."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.34,
      "end_seconds": 262.82,
      "duration_seconds": 14.48,
      "text": "All finished, thank you. Okay, so my impression is this: The most likely explanation is an anterior nosebleed on a blood thinner. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.67,
      "end_seconds": 296.61,
      "duration_seconds": 14.94,
      "text": "A blood count is what I'd like next, for epistaxis. Lean forward and pinch the soft part of the nose for fifteen minutes; I will cauterise the point. Book a review in one week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.72,
      "end_seconds": 301.69,
      "duration_seconds": 3.97,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.16,
      "end_seconds": 308.62,
      "duration_seconds": 2.46,
      "text": "does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.46,
      "end_seconds": 314.43,
      "duration_seconds": 2.97,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.83,
      "end_seconds": 317.02,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}