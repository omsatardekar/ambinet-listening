{
  "schema_version": "1.0",
  "encounter_id": "02014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 6.81,
      "duration_seconds": 5.89,
      "text": "Come in, have a seat by the desk. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.2,
      "end_seconds": 20.7,
      "duration_seconds": 12.5,
      "text": "Doctor, it's vomiting large amounts of fresh blood. It's getting on my nerves now. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.33,
      "end_seconds": 30.7,
      "duration_seconds": 5.37,
      "text": "When did this begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.17,
      "end_seconds": 34.33,
      "duration_seconds": 2.16,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 39.04,
      "duration_seconds": 3.25,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.48,
      "end_seconds": 43.85,
      "duration_seconds": 3.37,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.43,
      "end_seconds": 48.34,
      "duration_seconds": 2.91,
      "text": "Right, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.35,
      "end_seconds": 52.92,
      "duration_seconds": 2.57,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.87,
      "end_seconds": 56.52,
      "duration_seconds": 2.65,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.38,
      "end_seconds": 71.22,
      "duration_seconds": 13.84,
      "text": "When it starts I tend to get being confused as well. I've also been feeling faint, for five days. With feeling faint, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.33,
      "end_seconds": 74.95,
      "duration_seconds": 2.62,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.08,
      "end_seconds": 79.85,
      "duration_seconds": 3.77,
      "text": "Nothing, uh, I haven't had any operations."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.35,
      "end_seconds": 83.02,
      "duration_seconds": 2.67,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.57,
      "end_seconds": 86.02,
      "duration_seconds": 2.45,
      "text": "COPD, for about ten years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.12,
      "end_seconds": 88.82,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.53,
      "end_seconds": 100.83,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 106.78,
      "duration_seconds": 2.37,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.66,
      "end_seconds": 111.83,
      "duration_seconds": 3.17,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 117.02,
      "duration_seconds": 4.57,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.71,
      "end_seconds": 121.49,
      "duration_seconds": 3.78,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.7,
      "end_seconds": 126.78,
      "duration_seconds": 4.08,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.33,
      "end_seconds": 129.98,
      "duration_seconds": 2.65,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.48,
      "end_seconds": 138.04,
      "duration_seconds": 6.56,
      "text": "Not currently, you know, but as a youngster trimethoprim gave me itching."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.88,
      "end_seconds": 152.27,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.64,
      "end_seconds": 156.89,
      "duration_seconds": 3.25,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.64,
      "end_seconds": 161.51,
      "duration_seconds": 2.87,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.36,
      "end_seconds": 164.76,
      "duration_seconds": 1.4,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.59,
      "end_seconds": 169.54,
      "duration_seconds": 2.95,
      "text": "Any fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.23,
      "end_seconds": 173.61,
      "duration_seconds": 3.38,
      "text": "Um, no, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.52,
      "end_seconds": 178.24,
      "duration_seconds": 2.72,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.09,
      "end_seconds": 182.43,
      "duration_seconds": 2.34,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.0,
      "end_seconds": 190.34,
      "duration_seconds": 2.34,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.47,
      "end_seconds": 194.17,
      "duration_seconds": 2.7,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.76,
      "end_seconds": 199.7,
      "duration_seconds": 3.94,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.75,
      "end_seconds": 208.1,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.87,
      "end_seconds": 233.88,
      "duration_seconds": 12.01,
      "text": "Okay: respiratory rate 20, pulse is 102 beats a minute, temp 36.8 degrees, pressure 99 over 66, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 238.42,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 241.92,
      "duration_seconds": 1.97,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.62,
      "end_seconds": 263.77,
      "duration_seconds": 6.15,
      "text": "You are yellow, your tummy is swollen with fluid, and your pulse is very fast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.39,
      "end_seconds": 269.77,
      "duration_seconds": 2.38,
      "text": "So, all finished, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.82,
      "end_seconds": 300.03,
      "duration_seconds": 13.21,
      "text": "So, based on the history and the examination, I can't pin this down yet. We're looking at a bleed from enlarged veins in the gullet in liver disease or a bleeding ulcer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.34,
      "end_seconds": 303.55,
      "duration_seconds": 2.21,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 321.87,
      "duration_seconds": 17.3,
      "text": "Nothing I've seen today points to an emergency. It looks like a bleed from enlarged veins in the gullet in liver disease, but I'd like to confirm. I'll request urgent blood tests, it'll help with major bleed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.81,
      "end_seconds": 323.86,
      "duration_seconds": 1.05,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.62,
      "end_seconds": 333.86,
      "duration_seconds": 9.24,
      "text": "I'll request an urgent endoscopy, it'll help with variceal bleed. I'm prescribing terlipressin, 2 milligrams, now, single dose. That's for variceal bleeding."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.61,
      "end_seconds": 337.18,
      "duration_seconds": 2.57,
      "text": "Well, fine, I'll begin it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.27,
      "end_seconds": 356.3,
      "duration_seconds": 18.03,
      "text": "You are going straight to resus, I am starting two drips. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.64,
      "end_seconds": 359.78,
      "duration_seconds": 2.14,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.65,
      "end_seconds": 362.96,
      "duration_seconds": 1.31,
      "text": "Look after yourself."
    }
  ]
}