      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.11,
      "end_seconds": 211.08,
      "duration_seconds": 13.97,
      "text": "I take hydrocortisone cream, when needed it's escitalopram, 10 milligrams, once a day right, I do miss it now and then, to be fair"
    },
