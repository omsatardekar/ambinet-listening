{
  "schema_version": "1.0",
  "encounter_id": "02365",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 3.13,
      "duration_seconds": 2.45,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.78,
      "end_seconds": 6.72,
      "duration_seconds": 0.94,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 11.27,
      "duration_seconds": 3.89,
      "text": "Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 18.59,
      "duration_seconds": 5.27,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.82,
      "end_seconds": 26.1,
      "duration_seconds": 2.28,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 33.17,
      "duration_seconds": 6.34,
      "text": "Um, so... a shaky feeling in my hands. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.16,
      "end_seconds": 37.94,
      "duration_seconds": 3.78,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.19,
      "end_seconds": 50.44,
      "duration_seconds": 11.25,
      "text": "I'd say about a month. Actually, no, closer to six months. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.97,
      "end_seconds": 64.38,
      "duration_seconds": 9.41,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.26,
      "end_seconds": 81.01,
      "duration_seconds": 15.75,
      "text": "Maybe a three out of ten on a bad day. It just comes and goes. Oh, and butterflies in my stomach. That's been about the same, three days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 84.78,
      "duration_seconds": 2.73,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.9,
      "end_seconds": 98.28,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.94,
      "end_seconds": 123.97,
      "duration_seconds": 13.03,
      "text": "Okay: pulse 73, temperature 36.6. And height 178 centimetres, BMI works out to 22.4, BP is 113 over 78, weight 71 kilos, saturation 99 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.24,
      "end_seconds": 130.31,
      "duration_seconds": 5.07,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.16,
      "end_seconds": 134.43,
      "duration_seconds": 2.27,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.59,
      "end_seconds": 148.27,
      "duration_seconds": 6.68,
      "text": "There is a fine, fast tremor that goes away when the hands are resting."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.19,
      "end_seconds": 153.93,
      "duration_seconds": 1.74,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.72,
      "end_seconds": 172.1,
      "duration_seconds": 3.38,
      "text": "And what about fainting, weight loss or palpitations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.8,
      "end_seconds": 176.11,
      "duration_seconds": 3.31,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.4,
      "end_seconds": 178.7,
      "duration_seconds": 1.3,
      "text": "How about weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.54,
      "end_seconds": 182.1,
      "duration_seconds": 1.56,
      "text": "Definitely no weakness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 186.14,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.98,
      "end_seconds": 188.97,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.85,
      "end_seconds": 193.56,
      "duration_seconds": 3.71,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.15,
      "end_seconds": 197.42,
      "duration_seconds": 2.27,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.73,
      "end_seconds": 211.0,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.72,
      "end_seconds": 216.54,
      "duration_seconds": 3.82,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.22,
      "end_seconds": 225.13,
      "duration_seconds": 2.91,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.9,
      "end_seconds": 232.22,
      "duration_seconds": 4.32,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.75,
      "end_seconds": 234.11,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.83,
      "end_seconds": 239.06,
      "duration_seconds": 3.23,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.04,
      "end_seconds": 244.11,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.6,
      "end_seconds": 247.6,
      "duration_seconds": 2.0,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.41,
      "end_seconds": 270.21,
      "duration_seconds": 8.8,
      "text": "Any allergies to tablets, food or anything in the environment? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.63,
      "end_seconds": 274.16,
      "duration_seconds": 2.53,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.62,
      "end_seconds": 278.6,
      "duration_seconds": 2.98,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.49,
      "end_seconds": 288.66,
      "duration_seconds": 8.17,
      "text": "Just an operation for a hernia, last spring. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.68,
      "end_seconds": 293.01,
      "duration_seconds": 3.33,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.96,
      "end_seconds": 298.36,
      "duration_seconds": 3.4,
      "text": "No, you know, I'm not on anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.4,
      "end_seconds": 313.23,
      "duration_seconds": 12.83,
      "text": "Let me tell you where I've got to. It's hard to say. An anxiety or caffeine-related tremor is one possibility and an overactive thyroid another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.42,
      "end_seconds": 356.47,
      "duration_seconds": 27.05,
      "text": "A thyroid test is what I'd like next, for tremor. I'd rather check than guess, and this is the quickest way to know more. Cut down caffeine and try slow breathing when it starts. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'll want another look in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.61,
      "end_seconds": 361.7,
      "duration_seconds": 4.09,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}