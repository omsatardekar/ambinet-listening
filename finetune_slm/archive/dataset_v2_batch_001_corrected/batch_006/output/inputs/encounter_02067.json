{
  "schema_version": "1.0",
  "encounter_id": "02067",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 5.33,
      "duration_seconds": 3.99,
      "text": "Hi doctor, um, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 12.05,
      "duration_seconds": 5.22,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 20.89,
      "duration_seconds": 6.97,
      "text": "I, I wanted to get a feeling of something stuck in my throat looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.72,
      "end_seconds": 25.62,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.14,
      "end_seconds": 32.37,
      "duration_seconds": 5.23,
      "text": "Around two months... no wait, it's more like about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.58,
      "end_seconds": 37.06,
      "duration_seconds": 3.48,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.05,
      "end_seconds": 42.21,
      "duration_seconds": 3.16,
      "text": "About a three out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 45.61,
      "duration_seconds": 2.45,
      "text": "Have you had any neck swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.56,
      "end_seconds": 49.62,
      "duration_seconds": 2.06,
      "text": "No. No neck swelling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.13,
      "end_seconds": 53.99,
      "duration_seconds": 2.86,
      "text": "And what about blood or difficulty breathing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.9,
      "end_seconds": 58.92,
      "duration_seconds": 4.02,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.27,
      "end_seconds": 63.87,
      "duration_seconds": 4.6,
      "text": "Yes, carry on. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.11,
      "end_seconds": 69.81,
      "duration_seconds": 4.7,
      "text": "Sorry, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 73.1,
      "duration_seconds": 2.28,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.3,
      "end_seconds": 77.57,
      "duration_seconds": 3.27,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.46,
      "end_seconds": 80.56,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.1,
      "end_seconds": 83.24,
      "duration_seconds": 1.14,
      "text": "Yes, eczema."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.47,
      "end_seconds": 85.17,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 88.3,
      "duration_seconds": 1.78,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.92,
      "end_seconds": 94.28,
      "duration_seconds": 1.36,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.48,
      "end_seconds": 111.0,
      "duration_seconds": 3.52,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.05,
      "end_seconds": 115.57,
      "duration_seconds": 3.52,
      "text": "Mm, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.63,
      "end_seconds": 134.25,
      "duration_seconds": 3.62,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.29,
      "end_seconds": 139.52,
      "duration_seconds": 3.23,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.45,
      "end_seconds": 143.48,
      "duration_seconds": 3.03,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.86,
      "end_seconds": 149.9,
      "duration_seconds": 5.04,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.69,
      "end_seconds": 153.75,
      "duration_seconds": 2.06,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.41,
      "end_seconds": 157.21,
      "duration_seconds": 2.8,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.34,
      "end_seconds": 160.71,
      "duration_seconds": 2.37,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 171.88,
      "duration_seconds": 9.18,
      "text": "Hydrocortisone cream. I take it when needed for the eczema. Carvedilol. I take it 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.73,
      "end_seconds": 179.58,
      "duration_seconds": 4.85,
      "text": "So, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.52,
      "end_seconds": 182.2,
      "duration_seconds": 1.68,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.23,
      "end_seconds": 186.67,
      "duration_seconds": 2.44,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.03,
      "end_seconds": 196.9,
      "duration_seconds": 2.87,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.29,
      "end_seconds": 219.77,
      "duration_seconds": 10.48,
      "text": "Okay: blood pressure 122 over 73, oxygen saturation is 99 percent, pulse 73. And temperature is 36.8 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.27,
      "end_seconds": 226.28,
      "duration_seconds": 5.01,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.98,
      "end_seconds": 240.96,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.08,
      "end_seconds": 244.38,
      "duration_seconds": 2.3,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 257.75,
      "duration_seconds": 5.68,
      "text": "I can't see anything in the throat and the neck is not tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.96,
      "end_seconds": 277.19,
      "duration_seconds": 15.23,
      "text": "Please sit back down. Okay, so my impression is this: I can't pin this down yet. We're looking at a possible fish bone scratch or lodged bone or a pharyngeal scratch."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.7,
      "end_seconds": 279.16,
      "duration_seconds": 1.46,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.6,
      "end_seconds": 292.59,
      "duration_seconds": 11.99,
      "text": "I understand the worry. At the moment I'd say it's a possible fish bone scratch or lodged bone, and we'll know more once the a neck X-ray is back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.01,
      "end_seconds": 320.53,
      "duration_seconds": 11.52,
      "text": "We should do a neck X-ray for foreign body sensation. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.13,
      "end_seconds": 323.57,
      "duration_seconds": 1.44,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.01,
      "end_seconds": 331.56,
      "duration_seconds": 6.55,
      "text": "I'd like you back if still stuck tomorrow. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.27,
      "end_seconds": 336.26,
      "duration_seconds": 2.99,
      "text": "Great, thank you for your help."
    }
  ]
}