{
  "schema_version": "1.0",
  "encounter_id": "02340",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 4.58,
      "duration_seconds": 3.29,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.46,
      "end_seconds": 9.78,
      "duration_seconds": 3.32,
      "text": "Afternoon, um, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.95,
      "end_seconds": 15.05,
      "duration_seconds": 4.1,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.67,
      "end_seconds": 22.46,
      "duration_seconds": 5.79,
      "text": "So, please do. Extra information is always welcome. Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.76,
      "end_seconds": 28.83,
      "duration_seconds": 5.07,
      "text": "Ah, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.75,
      "end_seconds": 34.83,
      "duration_seconds": 3.08,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.54,
      "end_seconds": 44.18,
      "duration_seconds": 8.64,
      "text": "It's my face drooping on the right, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.54,
      "end_seconds": 49.23,
      "duration_seconds": 3.69,
      "text": "Alright, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.14,
      "end_seconds": 53.82,
      "duration_seconds": 2.68,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.42,
      "end_seconds": 58.81,
      "duration_seconds": 3.39,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 60.76,
      "duration_seconds": 1.18,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.42,
      "end_seconds": 64.83,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.34,
      "end_seconds": 75.02,
      "duration_seconds": 9.68,
      "text": "Sorry, what was I saying, when it starts I tend to get a funny taste as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.93,
      "end_seconds": 83.29,
      "duration_seconds": 7.36,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 83.39,
      "end_seconds": 89.15,
      "duration_seconds": 5.76,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.09,
      "end_seconds": 104.67,
      "duration_seconds": 14.58,
      "text": "I was getting to that! Oh, and not being able to close my eye. That's been about the same, two days. The funny taste? That's been for six months."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.42,
      "end_seconds": 113.24,
      "duration_seconds": 6.82,
      "text": "Have you had your face drooping on the right before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.34,
      "end_seconds": 124.43,
      "duration_seconds": 9.09,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.54,
      "end_seconds": 145.14,
      "duration_seconds": 2.6,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.03,
      "end_seconds": 151.74,
      "duration_seconds": 4.71,
      "text": "Yeah, I have acid reflux, for five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.63,
      "end_seconds": 155.68,
      "duration_seconds": 2.05,
      "text": "Alright, is that everything?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.3,
      "end_seconds": 165.46,
      "duration_seconds": 8.16,
      "text": "Erm, I've had asthma, yes. I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.88,
      "end_seconds": 171.34,
      "duration_seconds": 1.46,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 177.39,
      "duration_seconds": 2.4,
      "text": "Heart failure, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.13,
      "end_seconds": 182.85,
      "duration_seconds": 4.72,
      "text": "I follow. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.84,
      "end_seconds": 186.21,
      "duration_seconds": 2.37,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.94,
      "end_seconds": 191.07,
      "duration_seconds": 4.13,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.13,
      "end_seconds": 210.64,
      "duration_seconds": 18.51,
      "text": "Actually, you know, I take pantoprazole, 40 milligrams, before breakfast. Foracort inhaler, twice a day. Metoprolol. I take it 50 milligrams, twice a day. I'm on furosemide, 40 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.01,
      "end_seconds": 217.36,
      "duration_seconds": 3.35,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.08,
      "end_seconds": 227.58,
      "duration_seconds": 4.5,
      "text": "Mm, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.54,
      "end_seconds": 232.52,
      "duration_seconds": 2.98,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.58,
      "end_seconds": 243.78,
      "duration_seconds": 9.2,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.13,
      "end_seconds": 249.81,
      "duration_seconds": 4.68,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.49,
      "end_seconds": 260.13,
      "duration_seconds": 8.64,
      "text": "I only drink at family occasions. I've never touched a cigarette. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.33,
      "end_seconds": 268.36,
      "duration_seconds": 3.03,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.93,
      "end_seconds": 273.34,
      "duration_seconds": 3.41,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.13,
      "end_seconds": 276.04,
      "duration_seconds": 1.91,
      "text": "How about slurred speech?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.23,
      "end_seconds": 280.49,
      "duration_seconds": 3.26,
      "text": "No, I haven't had any slurred speech."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.68,
      "end_seconds": 291.56,
      "duration_seconds": 7.88,
      "text": "Let me check a few things. Any headache, weakness in the arm or leg or rash in the ear?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.1,
      "end_seconds": 308.79,
      "duration_seconds": 15.69,
      "text": "No, no headache, no weakness in the arm or leg, no rash in the ear. I did have pain behind the ear at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.34,
      "end_seconds": 316.69,
      "duration_seconds": 3.35,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.38,
      "end_seconds": 324.16,
      "duration_seconds": 3.78,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.46,
      "end_seconds": 328.23,
      "duration_seconds": 2.77,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.36,
      "end_seconds": 337.31,
      "duration_seconds": 2.95,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.57,
      "end_seconds": 365.65,
      "duration_seconds": 8.08,
      "text": "Okay: BP is 128 over 73, saturation 99 percent, temp 36.9 degrees, heart rate 64."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.51,
      "end_seconds": 369.08,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.37,
      "end_seconds": 373.17,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.58,
      "end_seconds": 377.69,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.51,
      "end_seconds": 380.94,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.28,
      "end_seconds": 405.07,
      "duration_seconds": 8.79,
      "text": "The whole right side of the face is weak, including the forehead, and the left side is normal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.31,
      "end_seconds": 412.09,
      "duration_seconds": 1.78,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.4,
      "end_seconds": 432.85,
      "duration_seconds": 7.45,
      "text": "Having listened and examined, this is probably Bell's palsy. I can't rule out a stroke yet."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 433.89,
      "end_seconds": 435.71,
      "duration_seconds": 1.82,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 437.14,
      "end_seconds": 456.6,
      "duration_seconds": 19.46,
      "text": "I understand the worry. At the moment I'd say it's Bell's palsy, and we'll watch how it goes. Just to be sure I understood. You've had your face drooping on the right for four weeks, severe, and no headache or rash in the ear."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 457.75,
      "end_seconds": 460.14,
      "duration_seconds": 2.39,
      "text": "Mm, um, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 465.38,
      "end_seconds": 473.23,
      "duration_seconds": 7.85,
      "text": "For this, prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 474.29,
      "end_seconds": 477.48,
      "duration_seconds": 3.19,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 478.58,
      "end_seconds": 490.92,
      "duration_seconds": 12.34,
      "text": "Use eye drops and tape the eye shut at night to protect it. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 491.27,
      "end_seconds": 501.66,
      "duration_seconds": 10.39,
      "text": "Right, right. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 503.66,
      "end_seconds": 504.68,
      "duration_seconds": 1.02,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 505.71,
      "end_seconds": 512.39,
      "duration_seconds": 6.68,
      "text": "Come back or go to emergency straight away if you get weakness in an arm or leg."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 513.5,
      "end_seconds": 516.49,
      "duration_seconds": 2.99,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 517.44,
      "end_seconds": 521.97,
      "duration_seconds": 4.53,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 522.88,
      "end_seconds": 525.93,
      "duration_seconds": 3.05,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 527.74,
      "end_seconds": 529.2,
      "duration_seconds": 1.46,
      "text": "Take care now."
    }
  ]
}