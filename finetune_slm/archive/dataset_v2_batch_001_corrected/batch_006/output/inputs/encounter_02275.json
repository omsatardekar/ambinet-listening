  "schema_version": "1.0",
  "encounter_id": "02275",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 9.87,
      "duration_seconds": 8.69,
      "text": "sorry, what was I saying, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.24,
      "end_seconds": 15.75,
      "duration_seconds": 4.51,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.37,
      "end_seconds": 19.38,
      "duration_seconds": 2.01,
      "text": "It's yellow eyes, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.44,
      "end_seconds": 23.59,
      "duration_seconds": 2.15,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.29,
      "end_seconds": 37.92,
      "duration_seconds": 12.63,
      "text": "Ever since... since this morning, really. I've also been feeling sick, since last night. About feeling sick, it happens once or twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.56,
      "end_seconds": 41.13,
      "duration_seconds": 2.57,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.41,
      "end_seconds": 47.07,
      "duration_seconds": 4.66,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.81,
      "end_seconds": 52.47,
      "duration_seconds": 4.66,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.51,
      "end_seconds": 57.42,
      "duration_seconds": 2.91,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.19,
      "end_seconds": 71.66,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.37,
      "end_seconds": 82.72,
      "duration_seconds": 9.35,
      "text": "Eltroxin, 100 micrograms, every morning. Metoprolol. I take it 50 milligrams, twice a day for my heart"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.66,
      "end_seconds": 91.96,
      "duration_seconds": 4.3,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.2,
      "end_seconds": 104.82,
      "duration_seconds": 11.62,
      "text": "I do a yoga class on Thursdays. My husband and I live above the shop. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.12,
      "end_seconds": 122.95,
      "duration_seconds": 3.83,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.01,
      "end_seconds": 126.89,
      "duration_seconds": 1.88,
      "text": "my cousin has psoriasis"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.12,
      "end_seconds": 131.19,
      "duration_seconds": 3.07,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.78,
      "end_seconds": 136.07,
      "duration_seconds": 4.29,
      "text": "I've got an underactive thyroid. I've got heart disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.45,
      "end_seconds": 148.33,
      "duration_seconds": 10.88,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Any itching, vomiting blood or high fever at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.15,
      "end_seconds": 153.27,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.25,
      "end_seconds": 157.19,
      "duration_seconds": 1.94,
      "text": "Any sign of confusion?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 163.24,
      "duration_seconds": 2.19,
      "text": "No, none, no confusion."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 166.67,
      "duration_seconds": 2.76,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.32,
      "end_seconds": 168.3,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.17,
      "end_seconds": 171.42,
      "duration_seconds": 2.25,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.25,
      "end_seconds": 184.73,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.48,
      "end_seconds": 211.99,
      "duration_seconds": 9.51,
      "text": "Okay: pressure 120 over 70, oxygen saturation is 99 percent, heart rate 82, temperature 36.7, respiratory rate 14."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.4,
      "end_seconds": 216.27,
      "duration_seconds": 2.87,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.2,
      "end_seconds": 219.83,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.34,
      "end_seconds": 238.2,
      "duration_seconds": 5.86,
      "text": "the whites of the eyes are yellow and the liver edge is tender"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.0,
      "end_seconds": 251.31,
      "duration_seconds": 8.31,
      "text": "You can relax now. Okay, thinking it through, my working impression is acute hepatitis, possibly hepatitis A after travel."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.09,
      "end_seconds": 255.96,
      "duration_seconds": 2.87,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.47,
      "end_seconds": 267.66,
      "duration_seconds": 10.19,
      "text": "it's reasonable to be concerned, but right now acute hepatitis, possibly hepatitis A after travel is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.38,
      "end_seconds": 313.39,
      "duration_seconds": 30.01,
      "text": "I want an ultrasound of the liver done, that's for jaundice. I want liver blood tests done, that's for jaundice. Rest, avoid alcohol and wash your hands carefully, as it can spread. A short walk every day, even twenty minutes, will help more than you'd think. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.59,
      "end_seconds": 316.41,
      "duration_seconds": 1.82,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.75,
      "end_seconds": 321.37,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}