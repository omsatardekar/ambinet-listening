{
  "schema_version": "1.0",
  "encounter_id": "02034",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.04,
      "duration_seconds": 3.43,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.87,
      "end_seconds": 9.24,
      "duration_seconds": 4.37,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 16.94,
      "duration_seconds": 6.41,
      "text": "I wanted to get itchy red patches that have gone crusty looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.16,
      "end_seconds": 21.86,
      "duration_seconds": 3.7,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.82,
      "end_seconds": 29.55,
      "duration_seconds": 5.73,
      "text": "I'd say about a month. Actually, no, closer to two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.27,
      "end_seconds": 40.49,
      "duration_seconds": 9.22,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.02,
      "end_seconds": 51.19,
      "duration_seconds": 9.17,
      "text": "I'd give it a six, out of ten. It settles a little with emollient. It's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.31,
      "end_seconds": 70.64,
      "duration_seconds": 3.33,
      "text": "And what about eating poorly or drowsiness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.29,
      "end_seconds": 75.71,
      "duration_seconds": 3.42,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.52,
      "end_seconds": 79.79,
      "duration_seconds": 3.27,
      "text": "Did you get high fever or blisters?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.43,
      "end_seconds": 84.42,
      "duration_seconds": 3.99,
      "text": "I haven't had high fever or blisters, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.4,
      "end_seconds": 88.5,
      "duration_seconds": 2.1,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.53,
      "end_seconds": 93.98,
      "duration_seconds": 3.45,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.84,
      "end_seconds": 98.59,
      "duration_seconds": 2.75,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.43,
      "end_seconds": 101.4,
      "duration_seconds": 1.97,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.38,
      "end_seconds": 104.96,
      "duration_seconds": 2.58,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.89,
      "end_seconds": 118.09,
      "duration_seconds": 11.2,
      "text": "I retired from the post office two years ago. I swim twice a week. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.97,
      "end_seconds": 137.13,
      "duration_seconds": 7.16,
      "text": "Okay, do you have any medical conditions I should know about? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.64,
      "end_seconds": 140.33,
      "duration_seconds": 1.69,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.39,
      "end_seconds": 146.2,
      "duration_seconds": 3.81,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.78,
      "end_seconds": 149.62,
      "duration_seconds": 1.84,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.48,
      "end_seconds": 157.89,
      "duration_seconds": 2.41,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.71,
      "end_seconds": 163.69,
      "duration_seconds": 3.98,
      "text": "No, you know, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.9,
      "end_seconds": 181.55,
      "duration_seconds": 4.65,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.98,
      "end_seconds": 192.72,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.8,
      "end_seconds": 213.45,
      "duration_seconds": 3.65,
      "text": "Okay: heart rate 72, pressure 108 over 78."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.04,
      "end_seconds": 215.51,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.3,
      "end_seconds": 223.55,
      "duration_seconds": 4.25,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.54,
      "end_seconds": 228.69,
      "duration_seconds": 2.15,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.4,
      "end_seconds": 232.59,
      "duration_seconds": 2.19,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.57,
      "end_seconds": 252.13,
      "duration_seconds": 5.56,
      "text": "The eczema patches on the arms have yellow crusts and weeping areas."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.99,
      "end_seconds": 267.12,
      "duration_seconds": 9.13,
      "text": "All finished, thank you. Let me tell you where I've got to. This is probably eczema with a bacterial skin infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.86,
      "end_seconds": 284.78,
      "duration_seconds": 4.92,
      "text": "I think a skin swab makes sense here, for infected eczema."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.68,
      "end_seconds": 288.91,
      "duration_seconds": 3.23,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.78,
      "end_seconds": 308.87,
      "duration_seconds": 19.09,
      "text": "I'll start you on flucloxacillin, 250 milligrams, four times a day, seven days. You take it by mouth. It's for infected eczema. Keep the nails short and keep using the moisturiser. I'd like to see you again in one week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.68,
      "end_seconds": 312.82,
      "duration_seconds": 3.14,
      "text": "Okay, so I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.56,
      "end_seconds": 318.45,
      "duration_seconds": 4.89,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.66,
      "end_seconds": 322.95,
      "duration_seconds": 3.29,
      "text": "I think I understand everything. Thanks."
    }
  ]
}