{
  "schema_version": "1.0",
  "encounter_id": "02338",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 5.17,
      "duration_seconds": 4.64,
      "text": "Hello, sorry about the delay, do sit. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.7,
      "end_seconds": 13.94,
      "duration_seconds": 7.24,
      "text": "Yeah, it's a back that has got shorter. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 19.6,
      "duration_seconds": 4.06,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.57,
      "end_seconds": 22.68,
      "duration_seconds": 2.11,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.46,
      "end_seconds": 28.38,
      "duration_seconds": 3.92,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.47,
      "end_seconds": 36.21,
      "duration_seconds": 5.74,
      "text": "Severe, really. And a wrist broken in a slip, too."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.11,
      "end_seconds": 54.57,
      "duration_seconds": 3.46,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.48,
      "end_seconds": 66.6,
      "duration_seconds": 2.12,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.42,
      "end_seconds": 97.03,
      "duration_seconds": 16.61,
      "text": "Okay: BMI works out to 42.2, respiratory rate 18, height 150 centimetres. And weight 95 kilos, pulse is 66 beats a minute, oxygen saturation is 99 percent, pressure 123 over 79, temperature 36.8."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 99.86,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.31,
      "end_seconds": 106.84,
      "duration_seconds": 2.53,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 112.37,
      "duration_seconds": 3.92,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.58,
      "end_seconds": 116.38,
      "duration_seconds": 2.8,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.2,
      "end_seconds": 134.05,
      "duration_seconds": 7.85,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.18,
      "end_seconds": 141.23,
      "duration_seconds": 5.05,
      "text": "All finished, thank you. Any bladder problems, numbness or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.03,
      "end_seconds": 146.11,
      "duration_seconds": 3.08,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 149.95,
      "duration_seconds": 2.13,
      "text": "Any sign of weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.9,
      "end_seconds": 155.72,
      "duration_seconds": 3.82,
      "text": "Not that I've noticed, no weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 159.63,
      "duration_seconds": 3.45,
      "text": "Ah. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.91,
      "end_seconds": 165.01,
      "duration_seconds": 1.1,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.91,
      "end_seconds": 180.3,
      "duration_seconds": 6.39,
      "text": "Are you taking anything regularly, including from the pharmacy? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.78,
      "end_seconds": 190.9,
      "duration_seconds": 9.12,
      "text": "Alendronate, 70 milligrams, once a week. I take escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.33,
      "end_seconds": 199.08,
      "duration_seconds": 7.75,
      "text": "I see, go ahead. Do you have any chronic illnesses? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.68,
      "end_seconds": 207.03,
      "duration_seconds": 6.35,
      "text": "I've had thin bones, yes. I've had depression for about a year now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.43,
      "end_seconds": 218.81,
      "duration_seconds": 2.38,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.58,
      "end_seconds": 223.03,
      "duration_seconds": 2.45,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.71,
      "end_seconds": 227.82,
      "duration_seconds": 3.11,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.21,
      "end_seconds": 235.46,
      "duration_seconds": 4.25,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.09,
      "end_seconds": 249.35,
      "duration_seconds": 12.26,
      "text": "Okay, thinking it through, it's hard to say. Osteoporosis with a fragility fracture is one possibility and vitamin D deficiency another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.26,
      "end_seconds": 254.93,
      "duration_seconds": 3.67,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.99,
      "end_seconds": 278.19,
      "duration_seconds": 22.2,
      "text": "It's reasonable to be concerned, but right now osteoporosis with a fragility fracture is my leading thought, not anything worse. Let me just check I've got this right. You've had a back that has got shorter for two days, severe, and no weight loss or fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.9,
      "end_seconds": 283.18,
      "duration_seconds": 3.28,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.18,
      "end_seconds": 296.53,
      "duration_seconds": 3.35,
      "text": "I want blood tests done, that's for osteoporosis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.75,
      "end_seconds": 302.66,
      "duration_seconds": 1.91,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.72,
      "end_seconds": 313.38,
      "duration_seconds": 8.66,
      "text": "Take the tablet with a full glass of water, and stay upright for thirty minutes. Come back in three months."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.16,
      "end_seconds": 317.28,
      "duration_seconds": 2.12,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.33,
      "end_seconds": 324.11,
      "duration_seconds": 4.78,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.81,
      "end_seconds": 328.07,
      "duration_seconds": 3.26,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.73,
      "end_seconds": 331.18,
      "duration_seconds": 1.45,
      "text": "Look after yourself."
    }
  ]
}