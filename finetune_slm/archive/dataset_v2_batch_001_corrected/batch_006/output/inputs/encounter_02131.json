      "role": "PATIENT",
      "start_seconds": 71.53,
      "end_seconds": 74.85,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 77.52,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.2,
      "end_seconds": 81.47,
      "duration_seconds": 3.27,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.15,
      "end_seconds": 87.0,
      "duration_seconds": 3.85,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.25,
      "end_seconds": 91.81,
      "duration_seconds": 3.56,
      "text": "I take pantoprazole, 40 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 112.31,
      "duration_seconds": 2.33,
      "text": "Do you have any long-term conditions?"
