    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.81,
      "end_seconds": 42.06,
      "duration_seconds": 5.25,
      "text": "Amoxicillin. I come out in... well, a rash all over."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.57,
      "end_seconds": 59.42,
      "duration_seconds": 2.85,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.42,
      "end_seconds": 65.14,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.75,
      "end_seconds": 70.07,
