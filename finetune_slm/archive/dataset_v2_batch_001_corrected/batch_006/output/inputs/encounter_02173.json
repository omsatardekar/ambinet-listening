{
  "schema_version": "1.0",
  "encounter_id": "02173",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.08,
      "duration_seconds": 4.1,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 10.94,
      "duration_seconds": 4.28,
      "text": "Right, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.52,
      "end_seconds": 18.51,
      "duration_seconds": 6.99,
      "text": "So, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.29,
      "end_seconds": 23.67,
      "duration_seconds": 3.38,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.62,
      "end_seconds": 30.45,
      "duration_seconds": 4.83,
      "text": "So, we came because of a fever for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.3,
      "end_seconds": 33.63,
      "duration_seconds": 2.33,
      "text": "Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.62,
      "end_seconds": 39.22,
      "duration_seconds": 3.6,
      "text": "It's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.55,
      "end_seconds": 48.58,
      "duration_seconds": 9.03,
      "text": "Sure. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.2,
      "end_seconds": 59.71,
      "duration_seconds": 9.51,
      "text": "It's a few times a day. Mostly severe. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.36,
      "end_seconds": 61.97,
      "duration_seconds": 1.61,
      "text": "Have you had tiredness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.49,
      "end_seconds": 71.12,
      "duration_seconds": 7.63,
      "text": "Yeah. Six months, I'd say. I've had night sweats too, for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.95,
      "end_seconds": 85.89,
      "duration_seconds": 4.94,
      "text": "Right, and what about cough, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.67,
      "end_seconds": 90.06,
      "duration_seconds": 3.39,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.69,
      "end_seconds": 95.18,
      "duration_seconds": 4.49,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.32,
      "end_seconds": 98.72,
      "duration_seconds": 2.4,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.82,
      "end_seconds": 103.44,
      "duration_seconds": 2.62,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.55,
      "end_seconds": 106.15,
      "duration_seconds": 1.6,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 110.5,
      "duration_seconds": 2.58,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.17,
      "end_seconds": 114.08,
      "duration_seconds": 2.91,
      "text": "Heart disease, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 116.45,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.39,
      "end_seconds": 119.74,
      "duration_seconds": 2.35,
      "text": "I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.33,
      "end_seconds": 127.1,
      "duration_seconds": 5.77,
      "text": "Yes, heart disease and epilepsy are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.5,
      "end_seconds": 142.05,
      "duration_seconds": 2.55,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 143.16,
      "end_seconds": 153.36,
      "duration_seconds": 10.2,
      "text": "She takes metoprolol, 50 milligrams, twice a day. She takes sodium valproate, 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.13,
      "end_seconds": 155.74,
      "duration_seconds": 1.61,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.43,
      "end_seconds": 160.0,
      "duration_seconds": 3.57,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.16,
      "end_seconds": 162.03,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.55,
      "end_seconds": 166.53,
      "duration_seconds": 3.98,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.3,
      "end_seconds": 171.43,
      "duration_seconds": 4.13,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.67,
      "end_seconds": 178.22,
      "duration_seconds": 3.55,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.38,
      "end_seconds": 183.32,
      "duration_seconds": 3.94,
      "text": "So, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.45,
      "end_seconds": 188.82,
      "duration_seconds": 4.37,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.14,
      "end_seconds": 192.73,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.64,
      "end_seconds": 197.67,
      "duration_seconds": 3.03,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.84,
      "end_seconds": 201.37,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.17,
      "end_seconds": 211.48,
      "duration_seconds": 2.31,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.6,
      "end_seconds": 240.37,
      "duration_seconds": 16.77,
      "text": "Okay: BMI works out to 28.5, oxygen saturation is 95 percent. And height 151 centimetres, heart rate 106, pressure 120 over 67, weight 65 kilos, temperature is 38.3 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.87,
      "end_seconds": 245.68,
      "duration_seconds": 1.81,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.35,
      "end_seconds": 250.13,
      "duration_seconds": 3.78,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.27,
      "end_seconds": 256.23,
      "duration_seconds": 4.96,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.99,
      "end_seconds": 270.56,
      "duration_seconds": 2.57,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.5,
      "end_seconds": 272.93,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.25,
      "end_seconds": 295.17,
      "duration_seconds": 8.92,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 310.46,
      "duration_seconds": 12.03,
      "text": "Good, you can sit up again. Let me tell you where I've got to. I think we're dealing with possible infective endocarditis at this stage."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.53,
      "end_seconds": 316.05,
      "duration_seconds": 3.52,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.5,
      "end_seconds": 336.41,
      "duration_seconds": 18.91,
      "text": "I can't promise yet, but most people with possible infective endocarditis do well once it's treated properly. We should do blood tests for prolonged fever. Let's get blood cultures, for possible endocarditis. Let's get an echocardiogram, for new murmur."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.62,
      "end_seconds": 340.87,
      "duration_seconds": 3.25,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.2,
      "end_seconds": 371.22,
      "duration_seconds": 27.02,
      "text": "You need admission today for blood cultures and a heart scan. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. The cardiology team would be the right next step, I'll refer you. Let's plan a check straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.44,
      "end_seconds": 376.61,
      "duration_seconds": 4.17,
      "text": "So, no, that's all. Thanks a lot."
    }
  ]
}