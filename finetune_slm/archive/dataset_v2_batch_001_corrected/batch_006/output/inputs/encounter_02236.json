      "start_seconds": 121.4,
      "end_seconds": 125.1,
      "duration_seconds": 3.7,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.13,
      "end_seconds": 129.22,
      "duration_seconds": 3.09,
      "text": "mm no nothing like that"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.1,
      "end_seconds": 131.93,
      "duration_seconds": 1.83,
      "text": "Who lives with you?"
