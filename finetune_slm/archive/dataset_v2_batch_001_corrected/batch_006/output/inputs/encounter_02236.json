      "start_seconds": 72.15,
      "end_seconds": 77.13,
      "duration_seconds": 4.98,
      "text": "I follow. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 96.77,
      "duration_seconds": 18.99,
      "text": "about a six out of ten i've, I've also been sweating actually, uh, I've also had a pounding heart, for two days and, And there's being very breathless as well, about a month now"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.82,
      "end_seconds": 102.76,
      "duration_seconds": 3.94,
      "text": "have you noticed fever calf pain or wheeze?"
