{
  "schema_version": "1.0",
  "encounter_id": "02378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 6.8,
      "duration_seconds": 5.75,
      "text": "Good morning. I've just opened your notes. Okay, what's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.57,
      "end_seconds": 15.09,
      "duration_seconds": 6.52,
      "text": "I wanted to get a hot red swollen big toe looked at."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 18.72,
      "duration_seconds": 1.61,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.23,
      "end_seconds": 24.12,
      "duration_seconds": 4.89,
      "text": "Right, it's been going on for two months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.05,
      "end_seconds": 29.02,
      "duration_seconds": 2.97,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.37,
      "end_seconds": 32.06,
      "duration_seconds": 1.69,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.73,
      "end_seconds": 39.68,
      "duration_seconds": 5.95,
      "text": "Alright, what about not being able to wear a shoe, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.88,
      "end_seconds": 46.42,
      "duration_seconds": 5.54,
      "text": "Mm, uh, yes, about the same, four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.43,
      "end_seconds": 50.57,
      "duration_seconds": 3.14,
      "text": "Any pain that woke you as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.74,
      "end_seconds": 55.47,
      "duration_seconds": 3.73,
      "text": "Oh, yes, for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.45,
      "end_seconds": 59.44,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.88,
      "end_seconds": 65.53,
      "duration_seconds": 4.65,
      "text": "A six out of ten, you know, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.05,
      "end_seconds": 67.44,
      "duration_seconds": 1.39,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.81,
      "end_seconds": 71.88,
      "duration_seconds": 3.07,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.76,
      "end_seconds": 75.44,
      "duration_seconds": 1.68,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.82,
      "end_seconds": 82.88,
      "duration_seconds": 6.06,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.08,
      "end_seconds": 86.83,
      "duration_seconds": 2.75,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.1,
      "end_seconds": 91.66,
      "duration_seconds": 3.56,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.13,
      "end_seconds": 94.8,
      "duration_seconds": 1.67,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.58,
      "end_seconds": 99.67,
      "duration_seconds": 4.09,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.91,
      "end_seconds": 102.62,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.23,
      "end_seconds": 107.63,
      "duration_seconds": 3.4,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.26,
      "end_seconds": 125.56,
      "duration_seconds": 3.3,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.42,
      "end_seconds": 143.67,
      "duration_seconds": 14.25,
      "text": "I, I have gout. I'm not great at remembering details, so bear with me. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.43,
      "end_seconds": 145.36,
      "duration_seconds": 0.93,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.47,
      "end_seconds": 154.8,
      "duration_seconds": 8.33,
      "text": "I've, I've had high blood pressure, yes. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.72,
      "end_seconds": 157.18,
      "duration_seconds": 1.46,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.52,
      "end_seconds": 168.75,
      "duration_seconds": 10.23,
      "text": "Okay, I can see high blood pressure in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.52,
      "end_seconds": 176.74,
      "duration_seconds": 6.22,
      "text": "Hmm, not currently, but as a youngster trimethoprim gave me itching."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.17,
      "end_seconds": 192.57,
      "duration_seconds": 3.4,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.39,
      "end_seconds": 198.18,
      "duration_seconds": 3.79,
      "text": "Actually, I take allopurinol, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.0,
      "end_seconds": 201.46,
      "duration_seconds": 2.46,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.64,
      "end_seconds": 207.43,
      "duration_seconds": 4.79,
      "text": "It's, It's 100 milligrams. It's ramipril, every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.01,
      "end_seconds": 211.36,
      "duration_seconds": 2.35,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.42,
      "end_seconds": 216.92,
      "duration_seconds": 4.5,
      "text": "5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.72,
      "end_seconds": 221.94,
      "duration_seconds": 3.22,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.17,
      "end_seconds": 230.75,
      "duration_seconds": 7.58,
      "text": "For about a year. Ibuprofen. I take it 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.04,
      "end_seconds": 235.41,
      "duration_seconds": 3.37,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.1,
      "end_seconds": 237.95,
      "duration_seconds": 1.85,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.9,
      "end_seconds": 242.73,
      "duration_seconds": 3.83,
      "text": "Right, have you had any rash, fever or injury?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.73,
      "end_seconds": 248.35,
      "duration_seconds": 2.62,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.86,
      "end_seconds": 252.53,
      "duration_seconds": 3.67,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.71,
      "end_seconds": 257.04,
      "duration_seconds": 3.33,
      "text": "Well, no, that's been fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 262.36,
      "duration_seconds": 4.06,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.88,
      "end_seconds": 278.2,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.55,
      "end_seconds": 302.68,
      "duration_seconds": 8.13,
      "text": "Okay: saturation 98 percent, temperature 36.9, pulse 83, respiratory rate 14, blood pressure 113 over 78."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.68,
      "end_seconds": 309.31,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.18,
      "end_seconds": 312.99,
      "duration_seconds": 2.81,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.33,
      "end_seconds": 317.7,
      "duration_seconds": 3.37,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.39,
      "end_seconds": 335.25,
      "duration_seconds": 1.86,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.0,
      "end_seconds": 340.13,
      "duration_seconds": 3.13,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.07,
      "end_seconds": 359.03,
      "duration_seconds": 4.96,
      "text": "The big toe joint is red, hot, swollen and exquisitely tender."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.12,
      "end_seconds": 390.96,
      "duration_seconds": 29.84,
      "text": "You can relax now. Let me tell you where I've got to. I can't pin this down yet. We're looking at an acute gout attack or a septic joint. I'll request kidney function tests, it'll help with gout treatment. I want a uric acid blood test done, that's for gout. Rest the foot, ice it, and drink plenty of water; limit beer and red meat."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.54,
      "end_seconds": 407.17,
      "duration_seconds": 14.63,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 408.36,
      "end_seconds": 413.64,
      "duration_seconds": 5.28,
      "text": "Okay, so okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.29,
      "end_seconds": 415.65,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}