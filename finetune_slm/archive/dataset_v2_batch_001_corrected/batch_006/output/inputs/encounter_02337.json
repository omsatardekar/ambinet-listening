{
  "schema_version": "1.0",
  "encounter_id": "02337",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.83,
      "end_seconds": 8.5,
      "duration_seconds": 7.67,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.83,
      "end_seconds": 14.19,
      "duration_seconds": 4.36,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.7,
      "end_seconds": 21.28,
      "duration_seconds": 6.58,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.69,
      "end_seconds": 25.75,
      "duration_seconds": 3.06,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.16,
      "end_seconds": 35.33,
      "duration_seconds": 8.17,
      "text": "Mainly rapidly spreading redness on the thigh. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.86,
      "end_seconds": 39.86,
      "duration_seconds": 3.0,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.58,
      "end_seconds": 43.33,
      "duration_seconds": 2.75,
      "text": "I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.92,
      "end_seconds": 48.56,
      "duration_seconds": 3.64,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.21,
      "end_seconds": 54.78,
      "duration_seconds": 4.57,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.57,
      "end_seconds": 57.43,
      "duration_seconds": 1.86,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.13,
      "end_seconds": 63.82,
      "duration_seconds": 5.69,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 63.92,
      "end_seconds": 69.93,
      "duration_seconds": 6.01,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.91,
      "end_seconds": 73.24,
      "duration_seconds": 2.33,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.6,
      "end_seconds": 84.69,
      "duration_seconds": 10.09,
      "text": "As for severe pain, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.19,
      "end_seconds": 87.95,
      "duration_seconds": 2.76,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.39,
      "end_seconds": 96.25,
      "duration_seconds": 6.86,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.34,
      "end_seconds": 104.83,
      "duration_seconds": 6.49,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 109.39,
      "duration_seconds": 2.92,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 109.9,
      "end_seconds": 112.83,
      "duration_seconds": 2.93,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.66,
      "end_seconds": 118.45,
      "duration_seconds": 3.79,
      "text": "And what about cough, recent cut or diarrhoea?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.96,
      "end_seconds": 134.16,
      "duration_seconds": 15.2,
      "text": "No, no cough, no recent cut, no diarrhoea. I did have a high fever and shivers at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.17,
      "end_seconds": 140.17,
      "duration_seconds": 4.0,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.94,
      "end_seconds": 142.49,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.75,
      "end_seconds": 146.14,
      "duration_seconds": 2.39,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.54,
      "end_seconds": 150.86,
      "duration_seconds": 3.32,
      "text": "No, uh, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.03,
      "end_seconds": 156.49,
      "duration_seconds": 4.46,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.92,
      "end_seconds": 160.69,
      "duration_seconds": 2.77,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.0,
      "end_seconds": 168.05,
      "duration_seconds": 4.05,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.14,
      "end_seconds": 174.48,
      "duration_seconds": 5.34,
      "text": "I have diabetes, for nearly five years. Yes, acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.03,
      "end_seconds": 180.6,
      "duration_seconds": 5.57,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.33,
      "end_seconds": 185.16,
      "duration_seconds": 2.83,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.09,
      "end_seconds": 189.04,
      "duration_seconds": 1.95,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.82,
      "end_seconds": 192.54,
      "duration_seconds": 2.72,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.23,
      "end_seconds": 195.41,
      "duration_seconds": 1.18,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.54,
      "end_seconds": 201.17,
      "duration_seconds": 4.63,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.25,
      "end_seconds": 204.93,
      "duration_seconds": 2.68,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.52,
      "end_seconds": 210.59,
      "duration_seconds": 4.07,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.21,
      "end_seconds": 214.17,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.33,
      "end_seconds": 222.25,
      "duration_seconds": 6.92,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.61,
      "end_seconds": 226.21,
      "duration_seconds": 2.6,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.87,
      "end_seconds": 237.77,
      "duration_seconds": 9.9,
      "text": "For the reflux, I believe. My husband sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 240.29,
      "end_seconds": 250.06,
      "duration_seconds": 9.77,
      "text": "Here are the numbers, doctor. Blood pressure 99 over 57, temperature is 36.4 degrees, oxygen saturation is 96 percent, pulse is 112 beats a minute."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.46,
      "end_seconds": 252.43,
      "duration_seconds": 0.97,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.0,
      "end_seconds": 258.88,
      "duration_seconds": 3.88,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.36,
      "end_seconds": 261.78,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.13,
      "end_seconds": 280.93,
      "duration_seconds": 7.8,
      "text": "The skin is dusky with blisters, there is a crackling feeling under it and you are hypotensive."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.93,
      "end_seconds": 285.57,
      "duration_seconds": 1.64,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.16,
      "end_seconds": 322.2,
      "duration_seconds": 21.04,
      "text": "Let me tell you where I've got to. My working impression is a possible necrotising soft tissue infection. The reason I say that is that your story and my examination fit together. It could also be severe cellulitis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.26,
      "end_seconds": 342.84,
      "duration_seconds": 4.58,
      "text": "I'd like to arrange urgent blood tests for possible necrotising infection."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 344.92,
      "end_seconds": 347.13,
      "duration_seconds": 2.21,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.02,
      "end_seconds": 362.85,
      "duration_seconds": 14.83,
      "text": "I'm sending you for an urgent surgical review because of possible necrotising infection. You need emergency surgery and intravenous antibiotics, we are going now. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.68,
      "end_seconds": 366.87,
      "duration_seconds": 3.19,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.85,
      "end_seconds": 370.17,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}