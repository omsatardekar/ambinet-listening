{
  "schema_version": "1.0",
  "encounter_id": "02482",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 6.5,
      "duration_seconds": 5.76,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 12.57,
      "duration_seconds": 4.51,
      "text": "good, thank you welcome, tell me what's brought you in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.71,
      "end_seconds": 19.23,
      "duration_seconds": 5.52,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 19.78,
      "end_seconds": 29.96,
      "duration_seconds": 10.18,
      "text": "Well, I've been having a nosebleed that won't stop. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.95,
      "end_seconds": 35.81,
      "duration_seconds": 3.86,
      "text": "alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.62,
      "end_seconds": 55.07,
      "duration_seconds": 17.45,
      "text": "It's bisoprolol, 2.5 milligrams, once a day for the heart rhythm. I'd rather not end up on lots of tablets if I can avoid it. I'm on thyroxine, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.58,
      "end_seconds": 57.71,
      "duration_seconds": 2.13,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 64.29,
      "duration_seconds": 5.7,
      "text": "75 micrograms i'm on pantoprazole, 40 milligrams, before breakfast for my acidity"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 65.91,
      "end_seconds": 73.78,
      "duration_seconds": 7.87,
      "text": "Uh, he is supposed to take it before breakfast, but I can't say he always does."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.07,
      "end_seconds": 85.13,
      "duration_seconds": 3.06,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.61,
      "end_seconds": 92.55,
      "duration_seconds": 5.94,
      "text": "around about two weeks... no wait, it's more like four weeks"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 95.8,
      "duration_seconds": 1.69,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.34,
      "end_seconds": 99.6,
      "duration_seconds": 3.26,
      "text": "Blowing the nose definitely sets it off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.52,
      "end_seconds": 103.84,
      "duration_seconds": 3.32,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.93,
      "end_seconds": 111.85,
      "duration_seconds": 5.92,
      "text": "well, it's... hard to say, it's kind of.. i don't know—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.26,
      "end_seconds": 119.15,
      "duration_seconds": 5.89,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.19,
      "end_seconds": 122.35,
      "duration_seconds": 2.16,
      "text": "I'd call it severe"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.38,
      "end_seconds": 129.42,
      "duration_seconds": 2.04,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.19,
      "end_seconds": 135.79,
      "duration_seconds": 5.6,
      "text": "It usually comes with blood down the back of my throat."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.77,
      "end_seconds": 143.56,
      "duration_seconds": 6.79,
      "text": "and the other thing I wanted to to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 143.66,
      "end_seconds": 149.41,
      "duration_seconds": 5.75,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.04,
      "end_seconds": 153.45,
      "duration_seconds": 2.41,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.72,
      "end_seconds": 160.34,
      "duration_seconds": 5.62,
      "text": "Right, that's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.29,
      "end_seconds": 173.02,
      "duration_seconds": 11.73,
      "text": "as for feeling lightheaded, I honestly can't say when that began. It might have been last month or the month before"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.84,
      "end_seconds": 177.92,
      "duration_seconds": 3.08,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.7,
      "end_seconds": 185.94,
      "duration_seconds": 6.24,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.02,
      "end_seconds": 195.45,
      "duration_seconds": 5.43,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.42,
      "end_seconds": 209.36,
      "duration_seconds": 11.94,
      "text": "I'd give it a four, out of ten. The blood down the back of my throat? That's been since last night."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 210.52,
      "end_seconds": 212.64,
      "duration_seconds": 2.12,
      "text": "yes, exactly like that"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.66,
      "end_seconds": 218.19,
      "duration_seconds": 4.53,
      "text": "did you get head injury, easy bruising or black stools?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.91,
      "end_seconds": 223.72,
      "duration_seconds": 4.81,
      "text": "No, no head injury, easy bruising or black stools."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.53,
      "end_seconds": 226.71,
      "duration_seconds": 1.18,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.59,
      "end_seconds": 229.56,
      "duration_seconds": 1.97,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.5,
      "end_seconds": 233.45,
      "duration_seconds": 1.95,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.28,
      "end_seconds": 236.38,
      "duration_seconds": 2.1,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.95,
      "end_seconds": 239.2,
      "duration_seconds": 2.25,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.16,
      "end_seconds": 242.74,
      "duration_seconds": 1.58,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.67,
      "end_seconds": 246.79,
      "duration_seconds": 3.12,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.2,
      "end_seconds": 250.16,
      "duration_seconds": 1.96,
      "text": "my brother has epilepsy"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.55,
      "end_seconds": 254.06,
      "duration_seconds": 2.51,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.94,
      "end_seconds": 269.95,
      "duration_seconds": 14.01,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.36,
      "end_seconds": 281.05,
      "duration_seconds": 2.69,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.93,
      "end_seconds": 285.8,
      "duration_seconds": 3.87,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.43,
      "end_seconds": 291.33,
      "duration_seconds": 4.9,
      "text": "Do you have any long-term conditions? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.87,
      "end_seconds": 304.16,
      "duration_seconds": 12.29,
      "text": "I mean, um, I've had an irregular heartbeat for nearly five years now. An underactive thyroid, for two years. I've got acid reflux"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.88,
      "end_seconds": 312.97,
      "duration_seconds": 8.09,
      "text": "Right, so an irregular heartbeat and an underactive thyroid are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 314.01,
      "end_seconds": 325.15,
      "duration_seconds": 11.14,
      "text": "Doctor, I've got the readings for you. Temperature 36.9, respiratory rate 17, heart rate 86, BP is 126 over 78, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.46,
      "end_seconds": 328.88,
      "duration_seconds": 1.42,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.47,
      "end_seconds": 335.28,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 335.98,
      "end_seconds": 337.62,
      "duration_seconds": 1.64,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.22,
      "end_seconds": 341.68,
      "duration_seconds": 2.46,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.36,
      "end_seconds": 366.53,
      "duration_seconds": 7.17,
      "text": "there is a bleeding point on the front of the septum and the nose has been dry"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.19,
      "end_seconds": 383.2,
      "duration_seconds": 12.01,
      "text": "Thank you, you can get dressed. So where does that leave us? I'd lean towards an anterior nosebleed on a blood thinner. Another possibility is a clotting problem."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.01,
      "end_seconds": 387.44,
      "duration_seconds": 3.43,
      "text": "So, is there something to worry about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.13,
      "end_seconds": 413.72,
      "duration_seconds": 24.59,
      "text": "nothing I've seen today points to an emergency it looks like an anterior nosebleed on a blood thinner, but I'd like to confirm i'd like to arrange a blood count for epistaxis i'm going to order a clotting test, for epistaxis on anticoagulant lean forward and pinch the soft part of the nose for fifteen minutes; I will cauterise the point"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.68,
      "end_seconds": 422.86,
      "duration_seconds": 8.18,
      "text": "If the bleeding does not stop after twenty minutes, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 423.96,
      "end_seconds": 427.47,
      "duration_seconds": 3.51,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.45,
      "end_seconds": 431.17,
      "duration_seconds": 2.72,
      "text": "I'd like you back in one week"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 431.92,
      "end_seconds": 432.62,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.4,
      "end_seconds": 437.9,
      "duration_seconds": 3.5,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 439.07,
      "end_seconds": 442.15,
      "duration_seconds": 3.08,
      "text": "I think I understand everything. Thanks."
    }
  ]
}