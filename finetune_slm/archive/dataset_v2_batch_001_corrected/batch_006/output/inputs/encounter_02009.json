{
  "schema_version": "1.0",
  "encounter_id": "02009",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 4.16,
      "duration_seconds": 2.77,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.69,
      "end_seconds": 6.79,
      "duration_seconds": 1.1,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 11.12,
      "duration_seconds": 2.87,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.9,
      "end_seconds": 20.92,
      "duration_seconds": 9.02,
      "text": "Mainly breathlessness months after the infection. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.21,
      "end_seconds": 24.94,
      "duration_seconds": 2.73,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.7,
      "end_seconds": 28.72,
      "duration_seconds": 3.02,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.64,
      "end_seconds": 33.94,
      "duration_seconds": 3.3,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 37.05,
      "duration_seconds": 2.56,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.66,
      "end_seconds": 40.24,
      "duration_seconds": 2.58,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.63,
      "end_seconds": 45.92,
      "duration_seconds": 3.29,
      "text": "Oh, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.74,
      "end_seconds": 50.58,
      "duration_seconds": 2.84,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.24,
      "end_seconds": 62.82,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.36,
      "end_seconds": 84.6,
      "duration_seconds": 9.24,
      "text": "Okay: respiratory rate 18, pulse is 84 beats a minute, BP is 122 over 74, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.32,
      "end_seconds": 91.22,
      "duration_seconds": 4.9,
      "text": "So, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.38,
      "end_seconds": 94.95,
      "duration_seconds": 2.57,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 113.37,
      "duration_seconds": 6.32,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.49,
      "end_seconds": 119.22,
      "duration_seconds": 2.73,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.28,
      "end_seconds": 139.31,
      "duration_seconds": 6.03,
      "text": "Have you had any coughing up blood, chest pain or leg swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.09,
      "end_seconds": 143.7,
      "duration_seconds": 2.61,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 147.65,
      "duration_seconds": 2.25,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.95,
      "end_seconds": 151.96,
      "duration_seconds": 3.01,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.15,
      "end_seconds": 155.5,
      "duration_seconds": 2.35,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.65,
      "end_seconds": 159.13,
      "duration_seconds": 2.48,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 162.95,
      "duration_seconds": 2.55,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.49,
      "end_seconds": 167.09,
      "duration_seconds": 3.6,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.37,
      "end_seconds": 172.21,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.53,
      "end_seconds": 176.73,
      "duration_seconds": 3.2,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.55,
      "end_seconds": 181.7,
      "duration_seconds": 3.15,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 187.04,
      "duration_seconds": 4.76,
      "text": "I take simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 204.81,
      "duration_seconds": 1.79,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.24,
      "end_seconds": 211.07,
      "duration_seconds": 2.83,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.63,
      "end_seconds": 214.39,
      "duration_seconds": 1.76,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.32,
      "end_seconds": 219.73,
      "duration_seconds": 3.41,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.47,
      "end_seconds": 224.47,
      "duration_seconds": 3.0,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.08,
      "end_seconds": 230.81,
      "duration_seconds": 4.73,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.79,
      "end_seconds": 234.95,
      "duration_seconds": 3.16,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.51,
      "end_seconds": 244.5,
      "duration_seconds": 8.99,
      "text": "I've had high cholesterol for about ten years now. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.95,
      "end_seconds": 247.33,
      "duration_seconds": 1.38,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.4,
      "end_seconds": 276.09,
      "duration_seconds": 16.69,
      "text": "Okay, so my impression is this: I'm honestly not certain yet. It could be post-viral symptoms after COVID, or it might be a thyroid problem. We should do a chest X-ray for persistent breathlessness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.31,
      "end_seconds": 280.04,
      "duration_seconds": 2.73,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.24,
      "end_seconds": 299.41,
      "duration_seconds": 18.17,
      "text": "Pace your activity and increase it slowly each week. I'm going to send a referral to the post-COVID clinic. Blood tests is something we might do if this doesn't improve in two weeks. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.99,
      "end_seconds": 303.01,
      "duration_seconds": 2.02,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.96,
      "end_seconds": 307.51,
      "duration_seconds": 2.55,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.41,
      "end_seconds": 312.9,
      "duration_seconds": 3.49,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}