{
  "schema_version": "1.0",
  "encounter_id": "02101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 5.47,
      "duration_seconds": 4.16,
      "text": "Oh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.41,
      "end_seconds": 12.74,
      "duration_seconds": 5.33,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.98,
      "end_seconds": 20.66,
      "duration_seconds": 6.68,
      "text": "I wanted to get pain in the lower left tummy looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.43,
      "end_seconds": 24.16,
      "duration_seconds": 2.73,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.23,
      "end_seconds": 29.55,
      "duration_seconds": 3.32,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 34.49,
      "duration_seconds": 2.66,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.12,
      "end_seconds": 51.28,
      "duration_seconds": 16.16,
      "text": "I notice it more with moving. And there's constipation then loose stools as well, two days now. I mean, um, as for constipation then loose stools, moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.21,
      "end_seconds": 56.01,
      "duration_seconds": 3.8,
      "text": "What about a low fever, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.59,
      "end_seconds": 61.26,
      "duration_seconds": 4.67,
      "text": "Yeah, uh, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.86,
      "end_seconds": 65.29,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.74,
      "end_seconds": 78.6,
      "duration_seconds": 2.86,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.11,
      "end_seconds": 99.67,
      "duration_seconds": 7.56,
      "text": "Okay: blood pressure 117 over 78, SpO2 95 percent on room air, temperature 38.1, pulse 90."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.43,
      "end_seconds": 102.95,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.26,
      "end_seconds": 107.12,
      "duration_seconds": 2.86,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.91,
      "end_seconds": 113.76,
      "duration_seconds": 3.85,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.44,
      "end_seconds": 117.82,
      "duration_seconds": 2.38,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 135.72,
      "duration_seconds": 5.16,
      "text": "It is tender in the lower left with no guarding or rigidity."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.47,
      "end_seconds": 144.02,
      "duration_seconds": 4.55,
      "text": "Thank you, you can get dressed. Any sign of vomiting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.84,
      "end_seconds": 151.31,
      "duration_seconds": 1.47,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.12,
      "end_seconds": 158.02,
      "duration_seconds": 4.9,
      "text": "Have you noticed urinary symptoms, blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.53,
      "end_seconds": 169.91,
      "duration_seconds": 6.38,
      "text": "I haven't had urinary symptoms, blood in the stool or weight loss, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.68,
      "end_seconds": 172.39,
      "duration_seconds": 1.71,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.19,
      "end_seconds": 174.16,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.58,
      "end_seconds": 179.82,
      "duration_seconds": 2.24,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.85,
      "end_seconds": 181.85,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.66,
      "end_seconds": 185.36,
      "duration_seconds": 2.7,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.36,
      "end_seconds": 193.51,
      "duration_seconds": 7.15,
      "text": "Okay, so it's valsartan, 80 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.67,
      "end_seconds": 199.62,
      "duration_seconds": 4.95,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.65,
      "end_seconds": 220.34,
      "duration_seconds": 19.69,
      "text": "No, I've never smoked in my life. I only drink at family occasions. No, I share a house with my brother. I retired from the post office two years ago. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.42,
      "end_seconds": 224.79,
      "duration_seconds": 2.37,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.66,
      "end_seconds": 229.85,
      "duration_seconds": 3.19,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.37,
      "end_seconds": 232.72,
      "duration_seconds": 1.35,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.43,
      "end_seconds": 236.76,
      "duration_seconds": 3.33,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.39,
      "end_seconds": 239.21,
      "duration_seconds": 0.82,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.21,
      "end_seconds": 255.13,
      "duration_seconds": 3.92,
      "text": "Right, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.75,
      "end_seconds": 259.09,
      "duration_seconds": 2.34,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.38,
      "end_seconds": 280.69,
      "duration_seconds": 3.31,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.89,
      "end_seconds": 283.54,
      "duration_seconds": 1.65,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.31,
      "end_seconds": 324.18,
      "duration_seconds": 25.87,
      "text": "Okay, thinking it through, it's hard to say. Acute diverticulitis is one possibility and a bowel tumour another, and I'd rather not commit yet. I'll request blood tests, it'll help with abdominal pain. Let's book a CT scan to look into left iliac fossa pain. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.35,
      "end_seconds": 337.8,
      "duration_seconds": 12.45,
      "text": "I'm prescribing co-amoxiclav, 625 milligrams, three times a day, five days. It's for diverticulitis. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.65,
      "end_seconds": 341.26,
      "duration_seconds": 1.61,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.54,
      "end_seconds": 353.69,
      "duration_seconds": 11.15,
      "text": "Drink plenty and start with a light diet. I'd like to see you again in one week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.66,
      "end_seconds": 359.55,
      "duration_seconds": 3.89,
      "text": "Let me think, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.11,
      "end_seconds": 361.31,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}