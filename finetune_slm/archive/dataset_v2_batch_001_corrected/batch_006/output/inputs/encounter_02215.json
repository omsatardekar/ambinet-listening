{
  "schema_version": "1.0",
  "encounter_id": "02215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.62,
      "duration_seconds": 2.9,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.46,
      "end_seconds": 9.74,
      "duration_seconds": 4.28,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 16.97,
      "duration_seconds": 6.21,
      "text": "I wanted to get sudden severe pain in the left testicle looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.76,
      "end_seconds": 25.71,
      "duration_seconds": 6.95,
      "text": "So, has this been going on for long? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.19,
      "end_seconds": 33.17,
      "duration_seconds": 2.98,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.53,
      "end_seconds": 36.83,
      "duration_seconds": 3.3,
      "text": "Sure. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.54,
      "end_seconds": 54.68,
      "duration_seconds": 17.14,
      "text": "I, I'd say on and off. Sorry, what was I saying, I've also been feeling sick, since last night. I had pain going up to the tummy before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.38,
      "end_seconds": 63.08,
      "duration_seconds": 7.7,
      "text": "Alright, have you had sudden severe pain in the left testicle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.12,
      "end_seconds": 74.86,
      "duration_seconds": 9.74,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.04,
      "end_seconds": 78.99,
      "duration_seconds": 2.95,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.78,
      "end_seconds": 85.01,
      "duration_seconds": 4.23,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.8,
      "end_seconds": 89.15,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.94,
      "end_seconds": 93.53,
      "duration_seconds": 3.59,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.51,
      "end_seconds": 95.87,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.17,
      "end_seconds": 100.53,
      "duration_seconds": 3.36,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 104.84,
      "duration_seconds": 2.39,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.57,
      "end_seconds": 106.69,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.97,
      "end_seconds": 125.5,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.64,
      "end_seconds": 129.33,
      "duration_seconds": 2.69,
      "text": "No surgery, um, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.7,
      "end_seconds": 141.97,
      "duration_seconds": 4.27,
      "text": "Okay, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.88,
      "end_seconds": 143.92,
      "duration_seconds": 1.04,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.89,
      "end_seconds": 146.62,
      "duration_seconds": 1.73,
      "text": "Any injury or discharge?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.88,
      "end_seconds": 150.25,
      "duration_seconds": 2.37,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.47,
      "end_seconds": 156.71,
      "duration_seconds": 5.24,
      "text": "Let me check a few things. Any burning when passing urine or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.34,
      "end_seconds": 160.26,
      "duration_seconds": 1.92,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.03,
      "end_seconds": 164.93,
      "duration_seconds": 3.9,
      "text": "Alright, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.35,
      "end_seconds": 168.49,
      "duration_seconds": 2.14,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.57,
      "end_seconds": 173.89,
      "duration_seconds": 3.32,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.25,
      "end_seconds": 176.86,
      "duration_seconds": 1.61,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.98,
      "end_seconds": 180.68,
      "duration_seconds": 2.7,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.34,
      "end_seconds": 191.49,
      "duration_seconds": 2.15,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.09,
      "end_seconds": 223.26,
      "duration_seconds": 10.17,
      "text": "Okay: weight 73 kilos, BP is 128 over 70, heart rate 70, temp 36.4 degrees, oxygen saturation is 99 percent, height 159 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.21,
      "end_seconds": 225.76,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.71,
      "end_seconds": 232.19,
      "duration_seconds": 4.48,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.15,
      "end_seconds": 237.21,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.42,
      "end_seconds": 243.86,
      "duration_seconds": 1.44,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.59,
      "end_seconds": 247.59,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.52,
      "end_seconds": 266.67,
      "duration_seconds": 8.15,
      "text": "The left testicle is high, swollen and extremely tender, and the reflex on that side is missing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.34,
      "end_seconds": 278.64,
      "duration_seconds": 8.3,
      "text": "Good, you can sit up again. Taking everything into account, this is probably testicular torsion needing emergency surgery."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.76,
      "end_seconds": 311.59,
      "duration_seconds": 21.83,
      "text": "An urgent scrotal ultrasound is what I'd like next, for testicular pain. I think an urgent surgical exploration makes sense here, for possible torsion. Do not eat or drink, you are going to theatre now. I'd like to see you again straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.39,
      "end_seconds": 317.63,
      "duration_seconds": 4.24,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.58,
      "end_seconds": 324.52,
      "duration_seconds": 5.94,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.22,
      "end_seconds": 329.02,
      "duration_seconds": 3.8,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}