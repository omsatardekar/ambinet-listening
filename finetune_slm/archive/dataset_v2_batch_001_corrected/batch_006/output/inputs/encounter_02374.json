{
  "schema_version": "1.0",
  "encounter_id": "02374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.93,
      "end_seconds": 6.56,
      "duration_seconds": 5.63,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 13.16,
      "duration_seconds": 5.17,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.77,
      "end_seconds": 22.13,
      "duration_seconds": 4.36,
      "text": "Um, so... brain fog. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 28.42,
      "end_seconds": 38.76,
      "duration_seconds": 10.34,
      "text": "Okay, so the vitals from earlier. Saturation 99 percent, respiratory rate 14, pulse is 80 beats a minute, pressure 128 over 74, temperature 36.4."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.58,
      "end_seconds": 44.56,
      "duration_seconds": 4.98,
      "text": "Good, thank you. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.6,
      "end_seconds": 48.66,
      "duration_seconds": 2.06,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.6,
      "end_seconds": 53.42,
      "duration_seconds": 2.82,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.78,
      "end_seconds": 62.66,
      "duration_seconds": 6.88,
      "text": "A seven out of ten, I suppose. I've also had extreme tiredness."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.34,
      "end_seconds": 68.7,
      "duration_seconds": 4.36,
      "text": "And what about leg swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 74.98,
      "duration_seconds": 4.73,
      "text": "I haven't had leg swelling or coughing up blood, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.58,
      "end_seconds": 82.27,
      "duration_seconds": 3.69,
      "text": "Have you had any chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.49,
      "end_seconds": 85.95,
      "duration_seconds": 2.46,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.53,
      "end_seconds": 90.93,
      "duration_seconds": 4.4,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.07,
      "end_seconds": 94.45,
      "duration_seconds": 2.38,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.34,
      "end_seconds": 97.38,
      "duration_seconds": 2.04,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.81,
      "end_seconds": 105.36,
      "duration_seconds": 3.55,
      "text": "Nothing on the skin, uh, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.83,
      "end_seconds": 125.31,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 131.5,
      "duration_seconds": 3.15,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.32,
      "end_seconds": 136.37,
      "duration_seconds": 3.05,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.45,
      "end_seconds": 142.74,
      "duration_seconds": 5.29,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.8,
      "end_seconds": 147.81,
      "duration_seconds": 4.01,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.15,
      "end_seconds": 152.86,
      "duration_seconds": 3.71,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.49,
      "end_seconds": 168.87,
      "duration_seconds": 3.38,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.31,
      "end_seconds": 179.42,
      "duration_seconds": 9.11,
      "text": "Tamsulosin. I take it 0.4 milligrams, at night. I'm, I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.94,
      "end_seconds": 182.76,
      "duration_seconds": 1.82,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.84,
      "end_seconds": 185.85,
      "duration_seconds": 2.01,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.92,
      "end_seconds": 189.4,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.0,
      "end_seconds": 194.13,
      "duration_seconds": 4.13,
      "text": "I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.95,
      "end_seconds": 197.6,
      "duration_seconds": 2.65,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.16,
      "end_seconds": 203.57,
      "duration_seconds": 4.41,
      "text": "I've had an enlarged prostate, yes. I have diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.07,
      "end_seconds": 221.8,
      "duration_seconds": 2.73,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 228.23,
      "duration_seconds": 5.19,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.49,
      "end_seconds": 234.05,
      "duration_seconds": 4.56,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.48,
      "end_seconds": 237.41,
      "duration_seconds": 1.93,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 257.6,
      "duration_seconds": 6.31,
      "text": "Your oxygen is normal at rest and after walking and your chest is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.06,
      "end_seconds": 268.51,
      "duration_seconds": 8.45,
      "text": "That's the examination finished. Putting it all together, it points towards post-viral symptoms after COVID. A thyroid problem is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.33,
      "end_seconds": 273.59,
      "duration_seconds": 3.26,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.44,
      "end_seconds": 287.53,
      "duration_seconds": 12.09,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral symptoms after COVID, but I'd like to confirm. I'd like to arrange a chest X-ray for persistent breathlessness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.07,
      "end_seconds": 290.84,
      "duration_seconds": 2.77,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.56,
      "end_seconds": 305.62,
      "duration_seconds": 10.06,
      "text": "Let's get blood tests, for post-viral fatigue. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.2,
      "end_seconds": 309.59,
      "duration_seconds": 2.39,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.54,
      "end_seconds": 332.22,
      "duration_seconds": 21.68,
      "text": "Pace your activity and increase it slowly each week. Let's get you seen by the post-COVID clinic, I'll arrange the letter. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.28,
      "end_seconds": 338.11,
      "duration_seconds": 4.83,
      "text": "Mm, um, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.41,
      "end_seconds": 340.87,
      "duration_seconds": 1.46,
      "text": "See you soon."
    }
  ]
}