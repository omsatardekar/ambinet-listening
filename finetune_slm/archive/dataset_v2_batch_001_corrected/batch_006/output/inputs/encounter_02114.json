      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.23,
      "end_seconds": 169.91,
      "duration_seconds": 3.68,
      "text": "And what about burning when passing urine or discharge?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.04,
      "end_seconds": 177.24,
      "duration_seconds": 6.2,
      "text": "I haven't had burning when passing urine or discharge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.9,
      "end_seconds": 182.78,
      "duration_seconds": 3.88,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.8,
      "end_seconds": 186.89,
      "duration_seconds": 3.09,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.33,
      "end_seconds": 191.29,
      "duration_seconds": 2.96,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.73,
      "end_seconds": 196.26,
      "duration_seconds": 3.53,
      "text": "no, you know, joints are fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 201.13,
      "duration_seconds": 2.92,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0030",
