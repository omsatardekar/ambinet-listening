      "role": "PATIENT",
      "start_seconds": 18.11,
      "end_seconds": 24.28,
      "duration_seconds": 6.17,
      "text": "so, doctor, it's no symptoms it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0005",
