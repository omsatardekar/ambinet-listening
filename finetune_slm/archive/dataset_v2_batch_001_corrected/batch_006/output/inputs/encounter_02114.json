      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.55,
      "end_seconds": 11.9,
      "duration_seconds": 4.35,
      "text": "Actually, you know, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.43,
      "end_seconds": 17.39,
      "duration_seconds": 3.96,
      "text": "what would you like to to start with today?"
    },
    {
      "segment_id": "SEG0004",
