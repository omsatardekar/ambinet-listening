      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.59,
      "end_seconds": 34.16,
      "duration_seconds": 5.57,
      "text": "Around about two weeks... no wait, it's more like three weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.57,
      "end_seconds": 38.58,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 59.66,
      "duration_seconds": 17.44,
      "text": "A four out of ten, I suppose. As for new partner, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.59,
      "end_seconds": 65.78,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
