{
  "schema_version": "1.0",
  "encounter_id": "02141",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 7.51,
      "duration_seconds": 6.71,
      "text": "Doctor, uh, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 12.21,
      "duration_seconds": 4.06,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 19.31,
      "duration_seconds": 5.96,
      "text": "Mainly I've been getting puffed climbing stairs. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.6,
      "end_seconds": 23.55,
      "duration_seconds": 2.95,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.56,
      "end_seconds": 31.33,
      "duration_seconds": 2.77,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.22,
      "end_seconds": 41.98,
      "duration_seconds": 8.76,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 62.45,
      "duration_seconds": 19.23,
      "text": "Yes, stairs. That makes it worse. A six out of ten, I suppose. I thought it would sort itself out, but it hasn't. Oh, and a bit of a cough with exercise. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.6,
      "end_seconds": 75.54,
      "duration_seconds": 2.94,
      "text": "And what about wheeze or palpitations?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.55,
      "end_seconds": 80.29,
      "duration_seconds": 2.74,
      "text": "No, no wheeze or palpitations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.77,
      "end_seconds": 87.55,
      "duration_seconds": 3.78,
      "text": "So, have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.64,
      "end_seconds": 95.38,
      "duration_seconds": 3.74,
      "text": "No, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.78,
      "end_seconds": 99.06,
      "duration_seconds": 3.28,
      "text": "Sure. How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.89,
      "end_seconds": 103.79,
      "duration_seconds": 2.9,
      "text": "Yeah, no, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 108.63,
      "duration_seconds": 3.87,
      "text": "Okay, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.01,
      "end_seconds": 113.0,
      "duration_seconds": 2.99,
      "text": "Hmm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.63,
      "end_seconds": 119.11,
      "duration_seconds": 4.48,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.32,
      "end_seconds": 124.15,
      "duration_seconds": 3.83,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.85,
      "end_seconds": 128.51,
      "duration_seconds": 3.66,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.65,
      "end_seconds": 137.07,
      "duration_seconds": 3.42,
      "text": "Okay, so no, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.06,
      "end_seconds": 151.8,
      "duration_seconds": 2.74,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 155.78,
      "duration_seconds": 2.03,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.31,
      "end_seconds": 174.98,
      "duration_seconds": 2.67,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.84,
      "end_seconds": 179.76,
      "duration_seconds": 3.92,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.19,
      "end_seconds": 183.44,
      "duration_seconds": 2.25,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.67,
      "end_seconds": 187.15,
      "duration_seconds": 2.48,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.89,
      "end_seconds": 203.02,
      "duration_seconds": 3.13,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.6,
      "end_seconds": 207.63,
      "duration_seconds": 4.03,
      "text": "Oh, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.0,
      "end_seconds": 213.47,
      "duration_seconds": 4.47,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.59,
      "end_seconds": 222.17,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 247.28,
      "duration_seconds": 9.96,
      "text": "Okay: pressure 110 over 68, SpO2 99 percent on room air, respiratory rate 14, pulse is 82 beats a minute, temp 37.0 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.28,
      "end_seconds": 253.96,
      "duration_seconds": 3.68,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.33,
      "end_seconds": 259.34,
      "duration_seconds": 1.01,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.24,
      "end_seconds": 262.71,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.59,
      "end_seconds": 278.05,
      "duration_seconds": 6.46,
      "text": "Your chest is clear and your oxygen level is normal at rest and after walking."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.22,
      "end_seconds": 315.99,
      "duration_seconds": 32.77,
      "text": "Alright, that's all I needed to check. Taking everything into account, my working impression is breathlessness from low fitness. I'm going to order a peak flow, for exertional cough. Build up to thirty minutes of brisk walking five days a week. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back in eight weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.92,
      "end_seconds": 320.18,
      "duration_seconds": 3.26,
      "text": "Alright, um, thanks, take care."
    }
  ]
}