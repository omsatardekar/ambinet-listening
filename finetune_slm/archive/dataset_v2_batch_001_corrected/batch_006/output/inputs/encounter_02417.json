{
  "schema_version": "1.0",
  "encounter_id": "02417",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.67,
      "duration_seconds": 2.77,
      "text": "good morning. I've just opened your notes"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.72,
      "end_seconds": 11.96,
      "duration_seconds": 6.24,
      "text": "hi doctor, uh, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.67,
      "end_seconds": 15.09,
      "duration_seconds": 2.42,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.77,
      "end_seconds": 20.08,
      "duration_seconds": 4.31,
      "text": "Well, I've been having pain behind the ear."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.62,
      "end_seconds": 23.25,
      "duration_seconds": 2.63,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.16,
      "end_seconds": 39.17,
      "duration_seconds": 2.01,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.3,
      "end_seconds": 61.12,
      "duration_seconds": 8.82,
      "text": "okay: respiratory rate 15, temperature 36.4. And pressure 124 over 69, pulse is 78 beats a minute"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.39,
      "end_seconds": 64.61,
      "duration_seconds": 2.22,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.45,
      "end_seconds": 68.19,
      "duration_seconds": 2.74,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.23,
      "end_seconds": 85.26,
      "duration_seconds": 4.03,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.85,
      "end_seconds": 89.48,
      "duration_seconds": 1.63,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.4,
      "end_seconds": 94.94,
      "duration_seconds": 4.54,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.6,
      "end_seconds": 101.59,
      "duration_seconds": 4.99,
      "text": "It happens all the time. I'd call it it moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.04,
      "end_seconds": 106.74,
      "duration_seconds": 2.7,
      "text": "Any a funny taste as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.28,
      "end_seconds": 111.5,
      "duration_seconds": 3.22,
      "text": "Yes, about the same, ten days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.18,
      "end_seconds": 125.98,
      "duration_seconds": 3.8,
      "text": "Any sign of weakness in the arm or leg?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.06,
      "end_seconds": 132.13,
      "duration_seconds": 5.07,
      "text": "Not at all, no weakness in the arm or leg."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.93,
      "end_seconds": 138.8,
      "duration_seconds": 4.87,
      "text": "A few quick ones: slurred speech, headache or rash in the ear?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.84,
      "end_seconds": 145.93,
      "duration_seconds": 6.09,
      "text": "I haven't had slurred speech, headache or rash in the ear, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 149.65,
      "duration_seconds": 3.32,
      "text": "right, right your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.26,
      "end_seconds": 152.83,
      "duration_seconds": 2.57,
      "text": "Oh, no problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.94,
      "end_seconds": 157.57,
      "duration_seconds": 3.63,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.72,
      "end_seconds": 163.87,
      "duration_seconds": 4.15,
      "text": "let me think, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.38,
      "end_seconds": 168.77,
      "duration_seconds": 3.39,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 176.35,
      "duration_seconds": 5.75,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.75,
      "end_seconds": 180.09,
      "duration_seconds": 2.34,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.78,
      "end_seconds": 184.91,
      "duration_seconds": 3.13,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.17,
      "end_seconds": 196.63,
      "duration_seconds": 3.46,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.26,
      "end_seconds": 199.79,
      "duration_seconds": 1.53,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.8,
      "end_seconds": 203.29,
      "duration_seconds": 2.49,
      "text": "So, any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.98,
      "end_seconds": 208.44,
      "duration_seconds": 3.46,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.83,
      "end_seconds": 212.23,
      "duration_seconds": 2.4,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.31,
      "end_seconds": 221.31,
      "duration_seconds": 5.0,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 226.57,
      "duration_seconds": 3.66,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.33,
      "end_seconds": 233.2,
      "duration_seconds": 5.87,
      "text": "Yes, nickel, it it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.77,
      "end_seconds": 250.78,
      "duration_seconds": 5.01,
      "text": "from what you've told me, my working impression is Bell's palsy"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.3,
      "end_seconds": 255.35,
      "duration_seconds": 3.05,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.45,
      "end_seconds": 274.17,
      "duration_seconds": 17.72,
      "text": "I understand the worry. At the moment I'd say it's Bell's palsy, and we'll watch how it goes. We'll begin with prednisolone, 50 milligrams, once a day, ten days. You take it by mouth. That should help with Bell's palsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.73,
      "end_seconds": 276.25,
      "duration_seconds": 1.52,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.06,
      "end_seconds": 300.87,
      "duration_seconds": 22.81,
      "text": "Use eye drops and tape the eye shut at night to protect it. A short walk every day, even twenty minutes, will help more than you'd think. The thing that would worry me is if you get weakness in an arm or leg. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.58,
      "end_seconds": 305.68,
      "duration_seconds": 4.1,
      "text": "I mean, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.24,
      "end_seconds": 309.55,
      "duration_seconds": 3.31,
      "text": "Let's plan a check in one week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.99,
      "end_seconds": 312.77,
      "duration_seconds": 1.78,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.2,
      "end_seconds": 318.49,
      "duration_seconds": 4.29,
      "text": "Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.77,
      "end_seconds": 324.14,
      "duration_seconds": 4.37,
      "text": "okay, so I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.97,
      "end_seconds": 327.42,
      "duration_seconds": 2.45,
      "text": "Have a a good day."
    }
  ]
}