{
  "schema_version": "1.0",
  "encounter_id": "02286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.04,
      "end_seconds": 3.86,
      "duration_seconds": 2.82,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.84,
      "end_seconds": 11.51,
      "duration_seconds": 6.67,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.66,
      "end_seconds": 18.59,
      "duration_seconds": 5.93,
      "text": "Good, that'll be useful. Pull up a chair. So, have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.36,
      "end_seconds": 24.96,
      "duration_seconds": 4.6,
      "text": "A couple of times, um, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 28.39,
      "duration_seconds": 2.76,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.46,
      "end_seconds": 36.04,
      "duration_seconds": 5.58,
      "text": "Yeah, we came because of a lump in my left breast."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.5,
      "end_seconds": 49.82,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.36,
      "end_seconds": 71.18,
      "duration_seconds": 20.82,
      "text": "Let me think, you know, probably ten days. Yeah. I didn't want to bother you but it keeps coming back. Oh, and the lump being there for a month. And there's slight tenderness as well, about a week now. About slight tenderness, mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.49,
      "end_seconds": 76.59,
      "duration_seconds": 5.1,
      "text": "Ah. Have you noticed skin dimpling or lump under the arm?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.64,
      "end_seconds": 83.01,
      "duration_seconds": 4.37,
      "text": "No, no skin dimpling or lump under the arm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.54,
      "end_seconds": 88.28,
      "duration_seconds": 3.74,
      "text": "Did you get weight loss or nipple discharge?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.87,
      "end_seconds": 96.8,
      "duration_seconds": 2.93,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 99.56,
      "duration_seconds": 2.14,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.12,
      "end_seconds": 101.23,
      "duration_seconds": 1.11,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.14,
      "end_seconds": 108.6,
      "duration_seconds": 5.46,
      "text": "So, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.98,
      "end_seconds": 121.37,
      "duration_seconds": 11.39,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.96,
      "end_seconds": 124.21,
      "duration_seconds": 1.25,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.63,
      "end_seconds": 128.33,
      "duration_seconds": 2.7,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.54,
      "end_seconds": 131.21,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.05,
      "end_seconds": 135.18,
      "duration_seconds": 3.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.27,
      "end_seconds": 139.68,
      "duration_seconds": 2.41,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.9,
      "end_seconds": 144.69,
      "duration_seconds": 3.79,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 146.86,
      "duration_seconds": 1.64,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.78,
      "end_seconds": 155.93,
      "duration_seconds": 4.15,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.68,
      "end_seconds": 160.07,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.04,
      "end_seconds": 165.7,
      "duration_seconds": 3.66,
      "text": "I'm on rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 166.67,
      "end_seconds": 176.2,
      "duration_seconds": 9.53,
      "text": "Doctor, I think the last prescription for the rosuvastatin was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.87,
      "end_seconds": 180.98,
      "duration_seconds": 4.11,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.58,
      "end_seconds": 186.84,
      "duration_seconds": 4.26,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.91,
      "end_seconds": 208.56,
      "duration_seconds": 6.65,
      "text": "Do you have any chronic illnesses? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.15,
      "end_seconds": 215.44,
      "duration_seconds": 5.29,
      "text": "Um, I have an irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.42,
      "end_seconds": 217.12,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.16,
      "end_seconds": 222.81,
      "duration_seconds": 3.65,
      "text": "I have high cholesterol, for two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.16,
      "end_seconds": 225.62,
      "duration_seconds": 1.46,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.84,
      "end_seconds": 231.99,
      "duration_seconds": 5.15,
      "text": "Right, I've had an underactive thyroid for about a year now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.65,
      "end_seconds": 239.37,
      "duration_seconds": 5.72,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.53,
      "end_seconds": 244.76,
      "duration_seconds": 1.23,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 250.7,
      "duration_seconds": 4.54,
      "text": "So, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.52,
      "end_seconds": 253.85,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.21,
      "end_seconds": 279.72,
      "duration_seconds": 9.51,
      "text": "There is a firm, mobile, round lump about two centimetres in the upper outer part and no lumps under the arm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.02,
      "end_seconds": 295.35,
      "duration_seconds": 12.33,
      "text": "That's all I needed to check. Putting it all together, I can't pin this down yet. We're looking at a breast lump needing triple assessment or a cyst."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.29,
      "end_seconds": 300.4,
      "duration_seconds": 3.11,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.07,
      "end_seconds": 323.25,
      "duration_seconds": 21.18,
      "text": "I understand the worry. At the moment I'd say it's a breast lump needing triple assessment, and we'll know more once the a needle biopsy is back. So, to recap quickly. You've had a lump in your left breast for ten days, and no nipple discharge or lump under the arm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.91,
      "end_seconds": 326.12,
      "duration_seconds": 2.21,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.29,
      "end_seconds": 347.96,
      "duration_seconds": 4.67,
      "text": "Let's book a needle biopsy to look into breast lump."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.0,
      "end_seconds": 351.74,
      "duration_seconds": 2.74,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.26,
      "end_seconds": 391.65,
      "duration_seconds": 38.39,
      "text": "Let's book a mammogram and ultrasound to look into breast lump. This does not mean cancer, but we do arrange a specialist one-stop clinic to be sure. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look after the clinic. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 396.03,
      "end_seconds": 399.18,
      "duration_seconds": 3.15,
      "text": "Well, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.92,
      "end_seconds": 402.3,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}