{
  "schema_version": "1.0",
  "encounter_id": "02370",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 4.13,
      "duration_seconds": 3.32,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.59,
      "end_seconds": 10.9,
      "duration_seconds": 5.31,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.32,
      "end_seconds": 17.69,
      "duration_seconds": 5.37,
      "text": "I wanted to get not listening at school looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 22.51,
      "duration_seconds": 2.76,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.23,
      "end_seconds": 27.77,
      "duration_seconds": 3.54,
      "text": "I take glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.59,
      "end_seconds": 31.35,
      "duration_seconds": 2.76,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.25,
      "end_seconds": 35.65,
      "duration_seconds": 3.4,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.19,
      "end_seconds": 49.43,
      "duration_seconds": 2.24,
      "text": "Any dizziness, discharge or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.39,
      "end_seconds": 53.8,
      "duration_seconds": 3.41,
      "text": "No, um, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.29,
      "end_seconds": 61.2,
      "duration_seconds": 3.91,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.69,
      "end_seconds": 66.25,
      "duration_seconds": 3.56,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 78.01,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 83.27,
      "duration_seconds": 3.23,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.52,
      "end_seconds": 98.72,
      "duration_seconds": 2.2,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.65,
      "end_seconds": 101.89,
      "duration_seconds": 1.24,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.17,
      "end_seconds": 106.46,
      "duration_seconds": 3.29,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.46,
      "end_seconds": 121.35,
      "duration_seconds": 13.89,
      "text": "Nothing, I'm teetotal. I drink a lot of tea and snack through the day. I swim twice a week. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.15,
      "end_seconds": 130.11,
      "duration_seconds": 6.96,
      "text": "Let me ask about allergies, anything at all? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.44,
      "end_seconds": 134.04,
      "duration_seconds": 2.6,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.09,
      "end_seconds": 139.05,
      "duration_seconds": 3.96,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.63,
      "end_seconds": 153.06,
      "duration_seconds": 2.43,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.94,
      "end_seconds": 183.98,
      "duration_seconds": 13.04,
      "text": "Okay: blood pressure 125 over 82, SpO2 97 percent on room air, temperature is 36.5 degrees, pulse is 84 beats a minute, respiratory rate 16."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.22,
      "end_seconds": 186.59,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.72,
      "end_seconds": 190.45,
      "duration_seconds": 2.73,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.94,
      "end_seconds": 195.61,
      "duration_seconds": 3.67,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.51,
      "end_seconds": 213.48,
      "duration_seconds": 0.97,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.33,
      "end_seconds": 216.76,
      "duration_seconds": 1.43,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.26,
      "end_seconds": 235.9,
      "duration_seconds": 4.64,
      "text": "Both ear drums look dull and retracted with fluid behind them."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 247.48,
      "duration_seconds": 6.8,
      "text": "Good, you can sit up again. Having listened and examined, this is probably glue ear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.61,
      "end_seconds": 251.45,
      "duration_seconds": 2.84,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.7,
      "end_seconds": 268.83,
      "duration_seconds": 11.13,
      "text": "It's reasonable to be concerned, but right now glue ear is my leading thought, not anything worse. I'll request a hearing test, it'll help with reduced hearing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.29,
      "end_seconds": 275.76,
      "duration_seconds": 1.47,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.68,
      "end_seconds": 283.63,
      "duration_seconds": 5.95,
      "text": "We will watch for three months, and sit him at the front of the class."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.89,
      "end_seconds": 294.58,
      "duration_seconds": 10.69,
      "text": "Hm, okay. We'll catch up in three months. So, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.51,
      "end_seconds": 304.9,
      "duration_seconds": 5.39,
      "text": "So, I come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.8,
      "end_seconds": 310.5,
      "duration_seconds": 3.7,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.49,
      "end_seconds": 315.91,
      "duration_seconds": 3.42,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}