      "role": "DOCTOR",
      "start_seconds": 166.78,
      "end_seconds": 170.38,
      "duration_seconds": 3.6,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.35,
      "end_seconds": 176.48,
      "duration_seconds": 5.13,
      "text": "Uh I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.27,
      "end_seconds": 182.2,
      "duration_seconds": 4.93,
      "text": "yes, diabetes is known to us, good to have that clear"
