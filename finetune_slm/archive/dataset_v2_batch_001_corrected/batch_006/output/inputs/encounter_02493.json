    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 261.21,
      "duration_seconds": 6.57,
      "text": "The pulses at the left foot are absent and the foot is cool and shiny."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.74,
      "end_seconds": 277.81,
      "duration_seconds": 12.07,
      "text": "Okay that's enough for me. So where does that leave us? I'd lean towards peripheral arterial disease. I can't rule out a nerve problem yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 279.75,
      "end_seconds": 282.6,
      "duration_seconds": 2.85,
      "text": "Well, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.85,
      "end_seconds": 303.93,
      "duration_seconds": 20.08,
      "text": "I understand the worry. At the moment I'd say it's peripheral arterial disease and we'll watch how it goes. Just to be sure I understood. You've had cold feet for about a month and no pain at rest or back pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.57,
      "end_seconds": 306.27,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.88,
      "end_seconds": 314.08,
      "duration_seconds": 7.2,
      "text": "There's nothing new for me to start or arrange today. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
