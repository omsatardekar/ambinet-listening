    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 207.68,
      "duration_seconds": 2.83,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.14,
      "end_seconds": 230.04,
      "duration_seconds": 20.9,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I'm a hairdresser, on my feet all day. Lots of rice, lentils and some fruit. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.29,
      "end_seconds": 234.34,
      "duration_seconds": 2.05,
      "text": "shall I start the examination?"
