      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.95,
      "end_seconds": 237.44,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.77,
      "end_seconds": 240.96,
      "duration_seconds": 2.19,
      "text": "I'm just checking this side."
