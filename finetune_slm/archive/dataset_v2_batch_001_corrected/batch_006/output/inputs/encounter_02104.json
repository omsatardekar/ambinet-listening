{
  "schema_version": "1.0",
  "encounter_id": "02104",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 3.7,
      "duration_seconds": 2.97,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.46,
      "end_seconds": 5.41,
      "duration_seconds": 0.95,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 9.17,
      "duration_seconds": 2.74,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 18.91,
      "duration_seconds": 8.38,
      "text": "Mm, it's pain in my back and hips. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.97,
      "end_seconds": 23.61,
      "duration_seconds": 2.64,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 25.95,
      "duration_seconds": 1.15,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.34,
      "end_seconds": 30.69,
      "duration_seconds": 3.35,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.43,
      "end_seconds": 41.16,
      "duration_seconds": 9.73,
      "text": "Ah, uh, for two days, I'd say. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.12,
      "end_seconds": 51.13,
      "duration_seconds": 8.01,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 58.81,
      "duration_seconds": 6.47,
      "text": "It just comes and goes. I get some relief from regular tablets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.96,
      "end_seconds": 62.34,
      "duration_seconds": 2.38,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 66.16,
      "duration_seconds": 1.19,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 70.67,
      "duration_seconds": 2.55,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.34,
      "end_seconds": 75.65,
      "duration_seconds": 3.31,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.2,
      "end_seconds": 76.9,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.72,
      "end_seconds": 94.17,
      "duration_seconds": 2.45,
      "text": "Any confusion or shortness of breath?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.18,
      "end_seconds": 100.78,
      "duration_seconds": 2.6,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.68,
      "end_seconds": 104.44,
      "duration_seconds": 1.76,
      "text": "Alright, what about bleeding?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.3,
      "end_seconds": 107.69,
      "duration_seconds": 1.39,
      "text": "No. No bleeding."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.81,
      "end_seconds": 116.72,
      "duration_seconds": 3.91,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.89,
      "end_seconds": 119.51,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.15,
      "end_seconds": 126.03,
      "duration_seconds": 4.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.85,
      "end_seconds": 129.92,
      "duration_seconds": 3.07,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.42,
      "end_seconds": 131.83,
      "duration_seconds": 1.41,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.87,
      "end_seconds": 137.55,
      "duration_seconds": 2.68,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.47,
      "end_seconds": 140.56,
      "duration_seconds": 2.09,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.34,
      "end_seconds": 146.55,
      "duration_seconds": 4.21,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.81,
      "end_seconds": 155.08,
      "duration_seconds": 4.27,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.58,
      "end_seconds": 160.55,
      "duration_seconds": 3.97,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 172.4,
      "end_seconds": 181.71,
      "duration_seconds": 9.31,
      "text": "Here are the numbers, doctor. Temperature is 36.9 degrees, pulse is 79 beats a minute, blood pressure 112 over 81."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.98,
      "end_seconds": 184.43,
      "duration_seconds": 1.45,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.38,
      "end_seconds": 189.89,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.54,
      "end_seconds": 209.95,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.85,
      "end_seconds": 212.45,
      "duration_seconds": 1.6,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 231.45,
      "duration_seconds": 4.18,
      "text": "Your tummy is soft and you look comfortable and thin."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.5,
      "end_seconds": 242.92,
      "duration_seconds": 8.42,
      "text": "Good, you can sit up again. Okay, thinking it through, it points towards cancer pain needing better control."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.74,
      "end_seconds": 247.85,
      "duration_seconds": 4.11,
      "text": "I mean, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.52,
      "end_seconds": 256.08,
      "duration_seconds": 7.56,
      "text": "Nothing I've seen today points to an emergency. It looks like cancer pain needing better control."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.84,
      "end_seconds": 307.76,
      "duration_seconds": 35.92,
      "text": "I'll start you on morphine sulfate modified-release, 20 milligrams, twice a day, long term. You take it by mouth. That's for cancer pain. Take the long-acting tablet regularly and the liquid for breakthrough pain. Let's get you seen by the palliative care team, I'll arrange the letter. Come back or go to emergency straight away if the symptoms get worse. We'll catch up in one week. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.95,
      "end_seconds": 312.1,
      "duration_seconds": 3.15,
      "text": "Great, thank you for your help."
    }
  ]
}