{
  "schema_version": "1.0",
  "encounter_id": "02124",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.69,
      "duration_seconds": 3.9,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 11.06,
      "duration_seconds": 5.19,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.77,
      "end_seconds": 16.92,
      "duration_seconds": 4.15,
      "text": "It's an ulcer under the big toe, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.05,
      "end_seconds": 21.31,
      "duration_seconds": 3.26,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.46,
      "end_seconds": 25.31,
      "duration_seconds": 2.85,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.06,
      "end_seconds": 29.96,
      "duration_seconds": 2.9,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.52,
      "end_seconds": 34.64,
      "duration_seconds": 1.12,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.14,
      "end_seconds": 53.01,
      "duration_seconds": 6.87,
      "text": "Have you had any fever, black skin, tracking redness or pain in the foot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.71,
      "end_seconds": 59.38,
      "duration_seconds": 2.67,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.03,
      "end_seconds": 64.59,
      "duration_seconds": 3.56,
      "text": "Alright, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.5,
      "end_seconds": 68.16,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.13,
      "end_seconds": 72.6,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.47,
      "end_seconds": 76.43,
      "duration_seconds": 2.96,
      "text": "Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.1,
      "end_seconds": 79.73,
      "duration_seconds": 2.63,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.82,
      "end_seconds": 85.85,
      "duration_seconds": 5.03,
      "text": "Right, I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.48,
      "end_seconds": 104.0,
      "duration_seconds": 4.52,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.07,
      "end_seconds": 111.47,
      "duration_seconds": 3.4,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.98,
      "end_seconds": 125.42,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.64,
      "end_seconds": 137.37,
      "duration_seconds": 10.73,
      "text": "I hardly move around during the day. I work in accounts at a hospital. My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.97,
      "end_seconds": 141.98,
      "duration_seconds": 3.01,
      "text": "Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 144.46,
      "duration_seconds": 1.96,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 148.57,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.19,
      "end_seconds": 159.41,
      "duration_seconds": 2.22,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.26,
      "end_seconds": 185.1,
      "duration_seconds": 8.84,
      "text": "Okay: respiratory rate 18, pressure 116 over 68. And oxygen saturation is 97 percent, pulse is 96 beats a minute."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.38,
      "end_seconds": 188.05,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.05,
      "end_seconds": 191.87,
      "duration_seconds": 2.82,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.71,
      "end_seconds": 197.49,
      "duration_seconds": 2.78,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.53,
      "end_seconds": 201.3,
      "duration_seconds": 1.77,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.48,
      "end_seconds": 204.35,
      "duration_seconds": 1.87,
      "text": "Right, breathe out slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.76,
      "end_seconds": 224.39,
      "duration_seconds": 7.63,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.18,
      "end_seconds": 231.74,
      "duration_seconds": 1.56,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.59,
      "end_seconds": 256.87,
      "duration_seconds": 7.28,
      "text": "Okay, so my impression is this: This looks most like an infected diabetic foot ulcer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.78,
      "end_seconds": 261.06,
      "duration_seconds": 3.28,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.92,
      "end_seconds": 276.95,
      "duration_seconds": 15.03,
      "text": "It's reasonable to be concerned, but right now an infected diabetic foot ulcer is my leading thought, not anything worse. Let's book a wound swab to look into infected ulcer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.93,
      "end_seconds": 282.92,
      "duration_seconds": 4.99,
      "text": "We have a slot Thursday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.98,
      "end_seconds": 318.0,
      "duration_seconds": 33.02,
      "text": "I'm prescribing co-amoxiclav, 625 milligrams, three times a day, seven days. You take it by mouth. That's for infected ulcer. Keep the weight off the foot and keep the dressing dry. I'll also refer you to the diabetic foot clinic. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Please come and see me in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.14,
      "end_seconds": 323.29,
      "duration_seconds": 4.15,
      "text": "Good, you know, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.82,
      "end_seconds": 326.1,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}