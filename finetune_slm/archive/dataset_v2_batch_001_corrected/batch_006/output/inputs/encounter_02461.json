{
  "schema_version": "1.0",
  "encounter_id": "02461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.49,
      "duration_seconds": 3.51,
      "text": "sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.58,
      "duration_seconds": 4.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.54,
      "end_seconds": 24.47,
      "duration_seconds": 11.93,
      "text": "it's a chronic cough with lots of phlegm i thought I'd wait, but it hasn't gone i'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.14,
      "end_seconds": 28.38,
      "duration_seconds": 3.24,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.16,
      "end_seconds": 34.08,
      "duration_seconds": 2.92,
      "text": "I've had it for ten days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.98,
      "end_seconds": 43.79,
      "duration_seconds": 8.81,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.73,
      "end_seconds": 59.77,
      "duration_seconds": 15.04,
      "text": "Um, I'd say moderate. I get some relief from chest physio. It's worse with mornings. It just comes and goes. And I've been getting out of breath as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.12,
      "end_seconds": 65.18,
      "duration_seconds": 4.06,
      "text": "Have you noticed fever, coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.56,
      "end_seconds": 69.41,
      "duration_seconds": 2.85,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.32,
      "end_seconds": 72.63,
      "duration_seconds": 2.31,
      "text": "any sign of weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.6,
      "end_seconds": 76.84,
      "duration_seconds": 3.24,
      "text": "not at all, no weight loss"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.78,
      "end_seconds": 81.54,
      "duration_seconds": 3.76,
      "text": "on the the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.53,
      "end_seconds": 86.66,
      "duration_seconds": 3.13,
      "text": "I mean, no, that's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.72,
      "end_seconds": 90.38,
      "duration_seconds": 2.66,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.39,
      "end_seconds": 94.32,
      "duration_seconds": 1.93,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.27,
      "end_seconds": 98.79,
      "duration_seconds": 2.52,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.83,
      "end_seconds": 102.03,
      "duration_seconds": 1.2,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.26,
      "end_seconds": 115.16,
      "duration_seconds": 1.9,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.62,
      "end_seconds": 120.36,
      "duration_seconds": 3.74,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.39,
      "end_seconds": 123.85,
      "duration_seconds": 2.46,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.37,
      "end_seconds": 127.57,
      "duration_seconds": 3.2,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 132.43,
      "duration_seconds": 3.51,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.18,
      "end_seconds": 135.54,
      "duration_seconds": 2.36,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.85,
      "end_seconds": 144.76,
      "duration_seconds": 3.91,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.69,
      "end_seconds": 148.63,
      "duration_seconds": 2.94,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.44,
      "end_seconds": 166.99,
      "duration_seconds": 4.55,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.91,
      "end_seconds": 172.38,
      "duration_seconds": 3.47,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.48,
      "end_seconds": 176.59,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.4,
      "end_seconds": 180.56,
      "duration_seconds": 2.16,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.76,
      "end_seconds": 202.56,
      "duration_seconds": 5.8,
      "text": "There are coarse crackles at both bases and the fingers are slightly clubbed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.49,
      "end_seconds": 208.31,
      "duration_seconds": 2.82,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 231.64,
      "duration_seconds": 5.75,
      "text": "Okay, thinking it through, this looks most like a flare of bronchiectasis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.0,
      "end_seconds": 234.62,
      "duration_seconds": 1.62,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.53,
      "end_seconds": 245.43,
      "duration_seconds": 9.9,
      "text": "Nothing I've seen today points to an emergency. It looks like a flare of bronchiectasis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.16,
      "end_seconds": 259.0,
      "duration_seconds": 3.84,
      "text": "Let's get a chest X-ray, for bronchiectasis flare."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.34,
      "end_seconds": 264.64,
      "duration_seconds": 2.3,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.08,
      "end_seconds": 279.29,
      "duration_seconds": 13.21,
      "text": "what I'm giving you is clarithromycin, 500 milligrams, twice a day, fourteen days you take it by mouth that should help with bronchiectasis flare keep up your airway clearance exercises twice a day"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.59,
      "end_seconds": 285.3,
      "duration_seconds": 5.71,
      "text": "I follow let's get you seen by the respiratory clinic, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.61,
      "end_seconds": 287.31,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.45,
      "end_seconds": 294.94,
      "duration_seconds": 6.49,
      "text": "please don't wait if the symptoms get worse that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.45,
      "end_seconds": 298.48,
      "duration_seconds": 2.03,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.4,
      "end_seconds": 302.87,
      "duration_seconds": 3.47,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.21,
      "end_seconds": 307.41,
      "duration_seconds": 3.2,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.33,
      "end_seconds": 310.51,
      "duration_seconds": 1.18,
      "text": "Take care now."
    }
  ]
