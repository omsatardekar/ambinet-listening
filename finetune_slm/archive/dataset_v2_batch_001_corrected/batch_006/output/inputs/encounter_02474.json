{
  "schema_version": "1.0",
  "encounter_id": "02474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 2.93,
      "duration_seconds": 1.58,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.56,
      "end_seconds": 9.47,
      "duration_seconds": 4.91,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.38,
      "end_seconds": 15.72,
      "duration_seconds": 4.34,
      "text": "I wanted to get swelling within hours looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.12,
      "end_seconds": 20.36,
      "duration_seconds": 3.24,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.24,
      "end_seconds": 33.18,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.74,
      "end_seconds": 57.84,
      "duration_seconds": 11.1,
      "text": "Okay: saturation 99 percent, BP is 113 over 69, pulse is 85 beats a minute. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.27,
      "end_seconds": 61.22,
      "duration_seconds": 1.95,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.77,
      "end_seconds": 63.33,
      "duration_seconds": 1.56,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.43,
      "end_seconds": 66.47,
      "duration_seconds": 2.04,
      "text": "Ice helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 72.28,
      "duration_seconds": 4.16,
      "text": "Any not being able to straighten it fully as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.58,
      "end_seconds": 78.25,
      "duration_seconds": 1.67,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 84.21,
      "duration_seconds": 4.99,
      "text": "Okay, have you had any numbness, calf pain or locked knee?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 91.16,
      "duration_seconds": 5.03,
      "text": "I haven't had numbness, calf pain or locked knee, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.69,
      "end_seconds": 93.25,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.65,
      "end_seconds": 99.1,
      "duration_seconds": 4.45,
      "text": "Sorry, what was I saying, no problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.92,
      "end_seconds": 111.52,
      "duration_seconds": 2.6,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.47,
      "end_seconds": 116.73,
      "duration_seconds": 4.26,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.09,
      "end_seconds": 130.78,
      "duration_seconds": 3.69,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.16,
      "end_seconds": 141.46,
      "duration_seconds": 9.3,
      "text": "Ibuprofen. I take it 400 milligrams, with food. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.2,
      "end_seconds": 146.94,
      "duration_seconds": 4.74,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.71,
      "end_seconds": 150.25,
      "duration_seconds": 1.54,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.14,
      "end_seconds": 153.44,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.36,
      "end_seconds": 158.1,
      "duration_seconds": 2.74,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 162.62,
      "duration_seconds": 2.83,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.18,
      "end_seconds": 168.19,
      "duration_seconds": 4.01,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.24,
      "end_seconds": 172.34,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.12,
      "end_seconds": 179.03,
      "duration_seconds": 4.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.49,
      "end_seconds": 183.2,
      "duration_seconds": 2.71,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.22,
      "end_seconds": 188.43,
      "duration_seconds": 3.21,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.64,
      "end_seconds": 193.58,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.02,
      "end_seconds": 205.82,
      "duration_seconds": 1.8,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.13,
      "end_seconds": 208.43,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.08,
      "end_seconds": 226.97,
      "duration_seconds": 8.89,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.99,
      "end_seconds": 230.55,
      "duration_seconds": 1.56,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.88,
      "end_seconds": 273.16,
      "duration_seconds": 29.28,
      "text": "So, based on the history and the examination, the most likely explanation is a likely anterior cruciate ligament tear. The reason I say that is that your story and my examination fit together. An X-ray of the knee is what I'd like next, for knee injury. I think an MRI of the knee makes sense here, for knee injury. Rest, ice and elevation, and use crutches until the scan."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.55,
      "end_seconds": 296.47,
      "duration_seconds": 21.92,
      "text": "A short walk every day, even twenty minutes, will help more than you'd think. I'll also refer you to the sports injury clinic. One warning sign to remember: the symptoms get worse. In that case don't wait. Come back after the scan. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.51,
      "end_seconds": 304.9,
      "duration_seconds": 3.39,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.21,
      "end_seconds": 308.26,
      "duration_seconds": 2.05,
      "text": "Alright, take care now."
    }
  ]
}