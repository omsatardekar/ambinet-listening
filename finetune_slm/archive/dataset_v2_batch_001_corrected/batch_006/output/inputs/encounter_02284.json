      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.64,
      "end_seconds": 218.84,
      "duration_seconds": 4.2,
      "text": "I'm a plumber, lots of bending and kneeling."
