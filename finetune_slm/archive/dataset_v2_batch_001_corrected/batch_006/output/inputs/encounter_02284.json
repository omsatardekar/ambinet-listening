      "role": "DOCTOR",
      "start_seconds": 8.11,
      "end_seconds": 12.16,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 18.4,
