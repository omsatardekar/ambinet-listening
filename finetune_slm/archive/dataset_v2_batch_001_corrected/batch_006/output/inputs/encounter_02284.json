      "role": "DOCTOR",
      "start_seconds": 44.92,
      "end_seconds": 54.39,
      "duration_seconds": 9.47,
      "text": "okay: pressure 118 over 79, respiratory rate 15, pulse 70, SpO2 97 percent on room air, temperature is 36.5 degrees"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.11,
      "end_seconds": 56.46,
      "duration_seconds": 1.35,
      "text": "is that okay?"
