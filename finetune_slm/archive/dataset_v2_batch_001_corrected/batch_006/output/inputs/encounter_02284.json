      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.45,
      "end_seconds": 228.21,
      "duration_seconds": 3.76,
      "text": "No, I share a house with my brother"
