      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.73,
      "end_seconds": 269.04,
      "duration_seconds": 4.31,
      "text": "The prostate feels smooth and enlarged with no hard areas."
