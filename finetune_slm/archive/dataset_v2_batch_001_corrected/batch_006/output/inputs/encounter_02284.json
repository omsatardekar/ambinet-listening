      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.06,
      "end_seconds": 108.56,
      "duration_seconds": 5.5,
      "text": "Okay, so not at all, no blood in the urine."
