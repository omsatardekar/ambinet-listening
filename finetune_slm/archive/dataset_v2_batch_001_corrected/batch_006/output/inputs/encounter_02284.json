    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.4,
      "end_seconds": 88.79,
      "duration_seconds": 12.39,
      "text": "Moderate, really. I've been getting up at night to pass urine too, since Friday. About getting up at night to pass urine, it's Moderate, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.39,
      "end_seconds": 95.96,
      "duration_seconds": 5.57,
      "text": "a few quick ones: back pain, burning on passing urine or weight loss?"
