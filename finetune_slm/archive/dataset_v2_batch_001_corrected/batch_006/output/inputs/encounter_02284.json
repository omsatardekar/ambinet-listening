    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 237.88,
      "duration_seconds": 7.72,
      "text": "Do you have any medical conditions I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.78,
      "end_seconds": 244.98,
      "duration_seconds": 3.2,
