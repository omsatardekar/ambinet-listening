    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.54,
      "end_seconds": 66.42,
      "duration_seconds": 7.88,
      "text": "Don't worry, we'll discuss it in a second. How many days or weeks has it been?"
    },
