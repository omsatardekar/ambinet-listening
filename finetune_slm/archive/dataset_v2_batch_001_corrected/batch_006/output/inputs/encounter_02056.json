{
  "schema_version": "1.0",
  "encounter_id": "02056",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 6.71,
      "duration_seconds": 6.0,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.04,
      "end_seconds": 14.97,
      "duration_seconds": 3.93,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.79,
      "end_seconds": 24.87,
      "duration_seconds": 8.08,
      "text": "Doctor, it's a back that has got shorter. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.67,
      "end_seconds": 29.62,
      "duration_seconds": 2.95,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.23,
      "end_seconds": 32.2,
      "duration_seconds": 1.97,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.95,
      "end_seconds": 35.72,
      "duration_seconds": 2.77,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.25,
      "end_seconds": 45.36,
      "duration_seconds": 8.11,
      "text": "I'd call it mild. I've also had a dull ache in my back, since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.91,
      "end_seconds": 49.12,
      "duration_seconds": 3.21,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.01,
      "end_seconds": 63.5,
      "duration_seconds": 12.49,
      "text": "Okay, so I'd call it moderate. Oh, uh, and a wrist broken in a slip. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.85,
      "end_seconds": 71.6,
      "duration_seconds": 6.75,
      "text": "Have you had a back that has got shorter before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.64,
      "end_seconds": 81.28,
      "duration_seconds": 8.64,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.27,
      "end_seconds": 86.44,
      "duration_seconds": 3.17,
      "text": "Have you noticed bladder problems or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 91.63,
      "duration_seconds": 4.02,
      "text": "Uh, no, no bladder problems or numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.96,
      "end_seconds": 97.41,
      "duration_seconds": 4.45,
      "text": "Let me check a few things. Any weight loss or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.79,
      "end_seconds": 102.56,
      "duration_seconds": 3.77,
      "text": "No, no weight loss or fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.67,
      "end_seconds": 106.15,
      "duration_seconds": 2.48,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.27,
      "end_seconds": 108.26,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.01,
      "end_seconds": 110.69,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.92,
      "end_seconds": 116.12,
      "duration_seconds": 4.2,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.54,
      "end_seconds": 118.7,
      "duration_seconds": 1.16,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.42,
      "end_seconds": 124.69,
      "duration_seconds": 4.27,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.49,
      "end_seconds": 137.2,
      "duration_seconds": 4.71,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.73,
      "end_seconds": 140.73,
      "duration_seconds": 2.0,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.46,
      "end_seconds": 143.9,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.48,
      "end_seconds": 151.92,
      "duration_seconds": 6.44,
      "text": "Uh, just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.52,
      "end_seconds": 163.12,
      "duration_seconds": 2.6,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.24,
      "end_seconds": 167.35,
      "duration_seconds": 3.11,
      "text": "Yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.27,
      "end_seconds": 170.63,
      "duration_seconds": 2.36,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.41,
      "end_seconds": 176.18,
      "duration_seconds": 4.77,
      "text": "Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.05,
      "end_seconds": 192.97,
      "duration_seconds": 2.92,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 202.9,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.69,
      "end_seconds": 226.75,
      "duration_seconds": 13.06,
      "text": "Okay: height 152 centimetres, saturation 99 percent, heart rate 85, BMI works out to 36.4, weight 84 kilos, temperature is 36.6 degrees, BP is 110 over 80."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 232.83,
      "duration_seconds": 3.62,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.14,
      "end_seconds": 237.06,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.71,
      "end_seconds": 255.85,
      "duration_seconds": 7.14,
      "text": "There is a curve in the upper back and you are three centimetres shorter than before."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.12,
      "end_seconds": 269.34,
      "duration_seconds": 10.22,
      "text": "You can relax now. Having listened and examined, I think we're dealing with osteoporosis with a fragility fracture at this stage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.7,
      "end_seconds": 273.87,
      "duration_seconds": 3.17,
      "text": "Well, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.89,
      "end_seconds": 304.9,
      "duration_seconds": 30.01,
      "text": "Nothing I've seen today points to an emergency. It looks like osteoporosis with a fragility fracture, but I'd like to confirm. I want a bone density scan done, that's for osteoporosis. Take the tablet with a full glass of water, and stay upright for thirty minutes. Do get help quickly if the symptoms get worse. Book a review in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.28,
      "end_seconds": 309.52,
      "duration_seconds": 3.24,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}