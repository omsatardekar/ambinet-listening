      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.94,
      "end_seconds": 170.19,
      "duration_seconds": 12.25,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. I live with my elderly mother. I work in accounts at a hospital. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.25,
      "end_seconds": 175.21,
      "duration_seconds": 3.96,
      "text": "Are there any allergies I should be aware of?"
