      "role": "PATIENT",
      "start_seconds": 144.37,
      "end_seconds": 149.5,
      "duration_seconds": 5.13,
      "text": "I have eczema. An irregular heartbeat for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.49,
      "end_seconds": 157.26,
      "duration_seconds": 6.77,
      "text": "right, right. Alright, eczema, that matches what I have here. Now some background about your lifestyle"
    },
