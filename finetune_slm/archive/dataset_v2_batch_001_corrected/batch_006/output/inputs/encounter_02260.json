{
  "schema_version": "1.0",
  "encounter_id": "02260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.34,
      "duration_seconds": 4.22,
      "text": "sorry I'm a little late, uh, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 9.99,
      "duration_seconds": 3.66,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.0,
      "end_seconds": 17.15,
      "duration_seconds": 5.15,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.16,
      "end_seconds": 21.22,
      "duration_seconds": 3.06,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.0,
      "end_seconds": 28.18,
      "duration_seconds": 5.18,
      "text": "We came cos of my face drooping on the right."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 33.22,
      "duration_seconds": 3.94,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.31,
      "end_seconds": 41.27,
      "duration_seconds": 5.96,
      "text": "it's been four weeks, I'm fairly sure i've also had a funny taste"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.23,
      "end_seconds": 45.61,
      "duration_seconds": 3.38,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.19,
      "end_seconds": 57.92,
      "duration_seconds": 2.73,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.65,
      "end_seconds": 86.79,
      "duration_seconds": 13.14,
      "text": "Okay: pulse 80, oxygen saturation is 97 percent, pressure 122 over 76, temperature is 36.8 degrees. And what about weakness in the arm or leg, slurred speech or headache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.86,
      "end_seconds": 92.95,
      "duration_seconds": 3.09,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 97.32,
      "duration_seconds": 2.78,
      "text": "Any sign of rash in the ear?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 103.0,
      "duration_seconds": 4.3,
      "text": "I haven't noticed any rash in the ear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.53,
      "end_seconds": 107.56,
      "duration_seconds": 3.03,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.94,
      "end_seconds": 117.42,
      "duration_seconds": 5.48,
      "text": "Sorry, you know, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.44,
      "end_seconds": 120.61,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.45,
      "end_seconds": 126.22,
      "duration_seconds": 3.77,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.27,
      "end_seconds": 128.66,
      "duration_seconds": 1.39,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.31,
      "end_seconds": 132.74,
      "duration_seconds": 3.43,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.56,
      "end_seconds": 135.85,
      "duration_seconds": 1.29,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.54,
      "end_seconds": 140.77,
      "duration_seconds": 3.23,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.15,
      "end_seconds": 147.29,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 152.59,
      "duration_seconds": 3.68,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.7,
      "end_seconds": 155.73,
      "duration_seconds": 2.03,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 162.82,
      "duration_seconds": 5.67,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.22,
      "end_seconds": 181.99,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.05,
      "end_seconds": 188.93,
      "duration_seconds": 5.88,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.34,
      "end_seconds": 194.8,
      "duration_seconds": 4.46,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.7,
      "end_seconds": 199.6,
      "duration_seconds": 2.9,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.0,
      "end_seconds": 218.19,
      "duration_seconds": 2.19,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.09,
      "end_seconds": 230.39,
      "duration_seconds": 11.3,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day for the heart rhythm. Metoprolol. I take it 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.27,
      "end_seconds": 236.73,
      "duration_seconds": 4.46,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.52,
      "end_seconds": 241.86,
      "duration_seconds": 4.34,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.02,
      "end_seconds": 244.97,
      "duration_seconds": 1.95,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.44,
      "end_seconds": 253.57,
      "duration_seconds": 7.13,
      "text": "I have an irregular heartbeat, for nearly five years. I've got heart disease"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.79,
      "end_seconds": 275.75,
      "duration_seconds": 4.96,
      "text": "Right, here's what I'm thinking. My working impression is Bell's palsy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.11,
      "end_seconds": 280.72,
      "duration_seconds": 3.61,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 301.97,
      "duration_seconds": 20.34,
      "text": "Nothing I've seen today points to an emergency. It looks like Bell's palsy. Let's use prednisolone, 50 milligrams, once a day, ten days. That should help with Bell's palsy. Use eye drops and tape the eye shut at night to protect it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.54,
      "end_seconds": 319.9,
      "duration_seconds": 17.36,
      "text": "mm-hmm. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again in one week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.51,
      "end_seconds": 323.72,
      "duration_seconds": 3.21,
      "text": "I think I understand everything. Thanks."
    }
  ]
}