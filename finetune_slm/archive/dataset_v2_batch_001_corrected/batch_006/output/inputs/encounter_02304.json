{
  "schema_version": "1.0",
  "encounter_id": "02304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.28,
      "duration_seconds": 3.05,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 9.33,
      "duration_seconds": 3.73,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.05,
      "end_seconds": 19.13,
      "duration_seconds": 5.08,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.04,
      "end_seconds": 26.02,
      "duration_seconds": 4.98,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.06,
      "end_seconds": 32.17,
      "duration_seconds": 4.11,
      "text": "She's been having a red swollen foot, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.69,
      "end_seconds": 35.88,
      "duration_seconds": 3.19,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.61,
      "end_seconds": 41.82,
      "duration_seconds": 5.21,
      "text": "Mostly mild. There's an ulcer under the big toe as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.46,
      "end_seconds": 46.67,
      "duration_seconds": 3.21,
      "text": "Have you had a smell from the wound?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.52,
      "end_seconds": 56.58,
      "duration_seconds": 9.06,
      "text": "Yeah, I've had that since last night. About smell from the wound, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.94,
      "end_seconds": 67.85,
      "duration_seconds": 5.91,
      "text": "Have you had a red swollen foot before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.42,
      "end_seconds": 75.04,
      "duration_seconds": 6.62,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.71,
      "end_seconds": 82.93,
      "duration_seconds": 6.22,
      "text": "And what about tracking redness, fever, black skin or pain in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.84,
      "end_seconds": 86.73,
      "duration_seconds": 2.89,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.38,
      "end_seconds": 89.33,
      "duration_seconds": 1.95,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.44,
      "end_seconds": 94.48,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.57,
      "end_seconds": 109.52,
      "duration_seconds": 3.95,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.42,
      "end_seconds": 118.96,
      "duration_seconds": 8.54,
      "text": "I've had diabetes, yes. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.46,
      "end_seconds": 121.25,
      "duration_seconds": 0.79,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.38,
      "end_seconds": 124.03,
      "duration_seconds": 1.65,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 129.63,
      "duration_seconds": 3.56,
      "text": "Alright, diabetes, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 149.49,
      "duration_seconds": 2.62,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.54,
      "end_seconds": 154.24,
      "duration_seconds": 3.7,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.94,
      "end_seconds": 156.77,
      "duration_seconds": 1.83,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.7,
      "end_seconds": 159.99,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.05,
      "end_seconds": 165.99,
      "duration_seconds": 3.94,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.42,
      "end_seconds": 180.69,
      "duration_seconds": 13.27,
      "text": "Let me think, it's sitagliptin, 100 milligrams, once a day for my sugar. I take allopurinol, 100 milligrams, maybe, once a day for the gout."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.24,
      "end_seconds": 185.22,
      "duration_seconds": 3.98,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 190.23,
      "duration_seconds": 2.94,
      "text": "Well, no, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.63,
      "end_seconds": 196.05,
      "duration_seconds": 4.42,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.86,
      "end_seconds": 202.1,
      "duration_seconds": 5.24,
      "text": "Well, you know, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 203.01,
      "end_seconds": 210.67,
      "duration_seconds": 7.66,
      "text": "So, hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.75,
      "end_seconds": 214.84,
      "duration_seconds": 2.09,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.52,
      "end_seconds": 228.28,
      "duration_seconds": 8.76,
      "text": "Alright, so that's unclear. I'll record what each of you said. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.92,
      "end_seconds": 237.31,
      "duration_seconds": 7.39,
      "text": "Let me think, you know, my brother has epilepsy. My mother had a stroke."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.31,
      "end_seconds": 241.76,
      "duration_seconds": 2.45,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.58,
      "end_seconds": 243.61,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.47,
      "end_seconds": 246.63,
      "duration_seconds": 2.16,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.19,
      "end_seconds": 263.98,
      "duration_seconds": 6.79,
      "text": "The ulcer is deep to the fat with surrounding redness and the foot pulses are present."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.08,
      "end_seconds": 279.08,
      "duration_seconds": 12.0,
      "text": "You can relax now. Taking everything into account, I think we're dealing with an infected diabetic foot ulcer at this stage. I'd also keep osteomyelitis in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.51,
      "end_seconds": 282.02,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.72,
      "end_seconds": 291.38,
      "duration_seconds": 8.66,
      "text": "Nothing I've seen today points to an emergency. It looks like an infected diabetic foot ulcer, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.75,
      "end_seconds": 328.19,
      "duration_seconds": 23.44,
      "text": "I'd like to arrange an X-ray of the foot for possible osteomyelitis. We should do a wound swab for infected ulcer. It's a routine test and it'll give us a much clearer picture. The treatment will be co-amoxiclav, 625 milligrams, three times a day, seven days. That's for infected ulcer."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.74,
      "end_seconds": 331.33,
      "duration_seconds": 1.59,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.79,
      "end_seconds": 348.68,
      "duration_seconds": 15.89,
      "text": "Keep the weight off the foot and keep the dressing dry. We'll refer you to the diabetic foot clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.56,
      "end_seconds": 353.68,
      "duration_seconds": 3.12,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.04,
      "end_seconds": 358.74,
      "duration_seconds": 3.7,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.34,
      "end_seconds": 362.34,
      "duration_seconds": 2.0,
      "text": "Thank you, that's helpful."
    }
  ]
}