{
  "schema_version": "1.0",
  "encounter_id": "02456",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.88,
      "end_seconds": 5.25,
      "duration_seconds": 4.37,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 9.54,
      "duration_seconds": 3.42,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.39,
      "end_seconds": 20.12,
      "duration_seconds": 6.73,
      "text": "I wanted to get a knee that gave way playing football looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.58,
      "end_seconds": 23.65,
      "duration_seconds": 2.07,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 29.95,
      "duration_seconds": 5.6,
      "text": "Around about four days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.24,
      "end_seconds": 39.17,
      "duration_seconds": 8.93,
      "text": "Mm-hmm. Okay, give me more detail on it, whatever comes to mind. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.99,
      "end_seconds": 48.82,
      "duration_seconds": 7.83,
      "text": "Mostly severe. Yes, twisting. That makes it worse. I've also had swelling within hours."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.32,
      "end_seconds": 54.13,
      "duration_seconds": 3.81,
      "text": "Have you had any fever, numbness or locked knee?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.85,
      "end_seconds": 59.2,
      "duration_seconds": 4.35,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.11,
      "end_seconds": 64.45,
      "duration_seconds": 3.34,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.36,
      "end_seconds": 67.33,
      "duration_seconds": 0.97,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.86,
      "end_seconds": 88.85,
      "duration_seconds": 3.99,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.8,
      "end_seconds": 98.69,
      "duration_seconds": 5.89,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.5,
      "end_seconds": 101.47,
      "duration_seconds": 1.97,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.73,
      "end_seconds": 109.77,
      "duration_seconds": 4.04,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.43,
      "end_seconds": 112.65,
      "duration_seconds": 2.22,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.81,
      "end_seconds": 118.05,
      "duration_seconds": 4.24,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.59,
      "end_seconds": 121.59,
      "duration_seconds": 2.0,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.45,
      "end_seconds": 126.22,
      "duration_seconds": 3.77,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.8,
      "end_seconds": 129.73,
      "duration_seconds": 2.93,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.47,
      "end_seconds": 138.74,
      "duration_seconds": 8.27,
      "text": "I'm on spironolactone, 25 milligrams, once a day. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.16,
      "end_seconds": 155.51,
      "duration_seconds": 2.35,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.71,
      "end_seconds": 159.65,
      "duration_seconds": 2.94,
      "text": "Heart failure, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 163.25,
      "duration_seconds": 2.43,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.36,
      "end_seconds": 174.17,
      "duration_seconds": 5.81,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 176.26,
      "end_seconds": 185.84,
      "duration_seconds": 9.58,
      "text": "Doctor, I've got the readings for you. Pulse 84, weight 87 kilos, BMI works out to 26.3, pressure 120 over 76, height 182 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.56,
      "end_seconds": 188.64,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.46,
      "end_seconds": 194.71,
      "duration_seconds": 4.25,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.61,
      "end_seconds": 198.79,
      "duration_seconds": 3.18,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.85,
      "end_seconds": 218.72,
      "duration_seconds": 8.87,
      "text": "The knee is swollen and when I pull the shin forwards it moves more than the other side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.15,
      "end_seconds": 226.12,
      "duration_seconds": 1.97,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.02,
      "end_seconds": 250.35,
      "duration_seconds": 6.33,
      "text": "So where does that leave us? It points towards a likely anterior cruciate ligament tear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.27,
      "end_seconds": 254.94,
      "duration_seconds": 3.67,
      "text": "Well, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.76,
      "end_seconds": 275.19,
      "duration_seconds": 18.43,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely anterior cruciate ligament tear, but I'd like to confirm. Just to be sure I understood. You've had a knee that gave way playing football for ten days, severe, and no fever or numbness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.19,
      "end_seconds": 279.9,
      "duration_seconds": 2.71,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.6,
      "end_seconds": 311.68,
      "duration_seconds": 14.08,
      "text": "We should do an MRI of the knee for knee injury. Rest, ice and elevation, and use crutches until the scan. I think the sports injury clinic should see you too."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 313.25,
      "end_seconds": 313.95,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.01,
      "end_seconds": 324.42,
      "duration_seconds": 8.41,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. We'll catch up after the scan."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.9,
      "end_seconds": 328.0,
      "duration_seconds": 2.1,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.08,
      "end_seconds": 332.51,
      "duration_seconds": 2.43,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.14,
      "end_seconds": 336.48,
      "duration_seconds": 2.34,
      "text": "Alright, thanks, take care."
    }
  ]
}