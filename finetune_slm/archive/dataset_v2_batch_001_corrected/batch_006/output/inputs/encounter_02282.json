      "role": "DOCTOR",
      "start_seconds": 122.06,
      "end_seconds": 125.5,
      "duration_seconds": 3.44,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.94,
      "end_seconds": 133.07,
      "duration_seconds": 2.13,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.05,
      "end_seconds": 138.05,
      "duration_seconds": 4.0,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.72,
      "end_seconds": 141.39,
      "duration_seconds": 1.67,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.03,
      "end_seconds": 153.79,
      "duration_seconds": 11.76,
      "text": "I see, go ahead. Right, so diabetes is already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.85,
      "end_seconds": 157.04,
      "duration_seconds": 2.19,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.73,
      "end_seconds": 162.73,
      "duration_seconds": 2.0,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.43,
      "end_seconds": 166.04,
      "duration_seconds": 2.61,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.39,
      "end_seconds": 171.05,
      "duration_seconds": 3.66,
      "text": "What does a normal day of food look like?"
