      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.17,
      "end_seconds": 68.6,
      "duration_seconds": 22.43,
      "text": "let me think, when it starts I tend to get cramping in my calves when I walk as well the cramping in my calves when I walk? That's been for four weeks about cramping in my calves when I walk, severe, I'd say"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.59,
      "end_seconds": 76.0,
      "duration_seconds": 6.41,
      "text": "have you had hair loss on your shins before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.59,
      "end_seconds": 84.11,
      "duration_seconds": 6.52,
      "text": "a bit, a couple of years ago. It settled by itself back then"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.67,
      "end_seconds": 100.08,
      "duration_seconds": 3.41,
      "text": "Okay, did you get chest pain or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 105.67,
      "duration_seconds": 4.09,
      "text": "um, no, no chest pain or fever"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.18,
      "end_seconds": 111.91,
      "duration_seconds": 4.73,
      "text": "have you had any pain at rest or back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.74,
      "end_seconds": 121.42,
      "duration_seconds": 4.68,
      "text": "no pain at rest or back pain, none of it"
