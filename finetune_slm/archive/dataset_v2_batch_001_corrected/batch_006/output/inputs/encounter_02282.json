    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.85,
      "end_seconds": 44.82,
      "duration_seconds": 1.97,
      "text": "any other symptoms with it?"
