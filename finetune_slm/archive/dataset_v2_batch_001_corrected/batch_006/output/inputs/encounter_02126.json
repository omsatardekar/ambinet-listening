{
  "schema_version": "1.0",
  "encounter_id": "02126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.4,
      "duration_seconds": 5.77,
      "text": "Okay, so hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 11.48,
      "duration_seconds": 4.08,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 19.12,
      "duration_seconds": 6.18,
      "text": "Honestly, it's very heavy periods, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 21.58,
      "duration_seconds": 1.7,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.67,
      "end_seconds": 37.97,
      "duration_seconds": 10.3,
      "text": "Probably four weeks. Yeah. I did try to ignore it for a while. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.09,
      "end_seconds": 43.6,
      "duration_seconds": 4.51,
      "text": "Have you had any fainting, pain or weight loss?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.84,
      "end_seconds": 49.45,
      "duration_seconds": 4.61,
      "text": "I haven't had fainting, pain or weight loss, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.19,
      "end_seconds": 52.9,
      "duration_seconds": 2.71,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.97,
      "end_seconds": 56.05,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.02,
      "end_seconds": 59.0,
      "duration_seconds": 1.98,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.65,
      "end_seconds": 64.98,
      "duration_seconds": 5.33,
      "text": "Sorry, what was I saying, no, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.38,
      "end_seconds": 81.06,
      "duration_seconds": 4.68,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.77,
      "end_seconds": 83.37,
      "duration_seconds": 1.6,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.33,
      "end_seconds": 95.65,
      "duration_seconds": 3.32,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 98.47,
      "duration_seconds": 1.71,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.47,
      "end_seconds": 110.7,
      "duration_seconds": 6.23,
      "text": "Have you got any known allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.48,
      "end_seconds": 116.22,
      "duration_seconds": 4.74,
      "text": "Amoxicillin. I come out in... well, a rash all over."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.98,
      "end_seconds": 118.16,
      "duration_seconds": 1.18,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 124.12,
      "duration_seconds": 4.5,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.88,
      "end_seconds": 126.56,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.48,
      "end_seconds": 130.93,
      "duration_seconds": 2.45,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.8,
      "end_seconds": 150.57,
      "duration_seconds": 2.77,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.54,
      "end_seconds": 157.32,
      "duration_seconds": 5.78,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.1,
      "end_seconds": 161.85,
      "duration_seconds": 2.75,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.51,
      "end_seconds": 173.57,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.52,
      "end_seconds": 200.16,
      "duration_seconds": 6.64,
      "text": "Okay: respiratory rate 17, temperature 36.8, blood pressure 121 over 74, heart rate 110."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.93,
      "end_seconds": 205.63,
      "duration_seconds": 3.7,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.23,
      "end_seconds": 208.64,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.56,
      "end_seconds": 211.59,
      "duration_seconds": 2.03,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.05,
      "end_seconds": 230.01,
      "duration_seconds": 4.96,
      "text": "Your inner eyelids are pale and your pulse is a little fast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.88,
      "end_seconds": 244.01,
      "duration_seconds": 10.13,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. This is probably heavy periods with iron deficiency."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.98,
      "end_seconds": 248.77,
      "duration_seconds": 2.79,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.53,
      "end_seconds": 267.93,
      "duration_seconds": 18.4,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with iron deficiency, and we'll know more once the a blood count is back. Just to be sure I understood. You've had very heavy periods for four weeks, and no fainting or weight loss."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.77,
      "end_seconds": 272.56,
      "duration_seconds": 2.79,
      "text": "Well, yes, you've got it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.72,
      "end_seconds": 284.47,
      "duration_seconds": 4.75,
      "text": "I think a blood count makes sense here, for heavy periods."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.38,
      "end_seconds": 286.6,
      "duration_seconds": 1.22,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.91,
      "end_seconds": 305.82,
      "duration_seconds": 17.91,
      "text": "What I'm giving you is tranexamic acid, 1 gram, three times a day, during periods. That's for heavy periods. Keep a pad count diary. We'll catch up after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.8,
      "end_seconds": 309.17,
      "duration_seconds": 2.37,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.72,
      "end_seconds": 311.93,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}