{
  "schema_version": "1.0",
  "encounter_id": "02183",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.21,
      "duration_seconds": 3.47,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 9.17,
      "duration_seconds": 4.19,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.39,
      "end_seconds": 14.82,
      "duration_seconds": 4.43,
      "text": "Well, I've been having a fever for two weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.82,
      "end_seconds": 19.97,
      "duration_seconds": 3.15,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.13,
      "end_seconds": 35.08,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.74,
      "end_seconds": 61.18,
      "duration_seconds": 7.44,
      "text": "Okay: pressure 107 over 72, temperature is 38.7 degrees, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.38,
      "end_seconds": 65.78,
      "duration_seconds": 1.4,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.4,
      "end_seconds": 73.28,
      "duration_seconds": 5.88,
      "text": "I'll explain what these mean in a moment. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.88,
      "end_seconds": 78.71,
      "duration_seconds": 3.83,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 81.82,
      "duration_seconds": 2.6,
      "text": "Understood. Any night sweats as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 89.0,
      "duration_seconds": 2.87,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.71,
      "end_seconds": 94.45,
      "duration_seconds": 4.74,
      "text": "Has there been small painful spots on your fingers too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.3,
      "end_seconds": 102.86,
      "duration_seconds": 7.56,
      "text": "Yes, I have. About small painful spots on my fingers, honestly, all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.51,
      "end_seconds": 110.52,
      "duration_seconds": 6.01,
      "text": "Have you had a fever for two weeks before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.17,
      "end_seconds": 119.77,
      "duration_seconds": 7.6,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.42,
      "end_seconds": 137.2,
      "duration_seconds": 2.78,
      "text": "Have you noticed cough or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.52,
      "end_seconds": 142.58,
      "duration_seconds": 4.06,
      "text": "No cough or weight loss, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.1,
      "end_seconds": 145.0,
      "duration_seconds": 1.9,
      "text": "How about chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.66,
      "end_seconds": 150.0,
      "duration_seconds": 3.34,
      "text": "Not at all, no chest pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 152.97,
      "duration_seconds": 2.21,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.7,
      "end_seconds": 154.7,
      "duration_seconds": 1.0,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.85,
      "end_seconds": 158.43,
      "duration_seconds": 2.58,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.68,
      "end_seconds": 166.9,
      "duration_seconds": 4.22,
      "text": "I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 171.12,
      "duration_seconds": 2.35,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.89,
      "end_seconds": 173.41,
      "duration_seconds": 1.52,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.9,
      "end_seconds": 177.73,
      "duration_seconds": 3.83,
      "text": "Hm, okay. Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.27,
      "end_seconds": 182.8,
      "duration_seconds": 3.53,
      "text": "I have depression, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.86,
      "end_seconds": 202.24,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.26,
      "end_seconds": 207.59,
      "duration_seconds": 3.33,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.57,
      "end_seconds": 213.47,
      "duration_seconds": 4.9,
      "text": "Alright, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.25,
      "end_seconds": 218.08,
      "duration_seconds": 3.83,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.74,
      "end_seconds": 221.38,
      "duration_seconds": 1.64,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.84,
      "end_seconds": 226.14,
      "duration_seconds": 3.3,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.73,
      "end_seconds": 229.8,
      "duration_seconds": 3.07,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.51,
      "end_seconds": 235.34,
      "duration_seconds": 4.83,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.0,
      "end_seconds": 249.35,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.06,
      "end_seconds": 252.59,
      "duration_seconds": 1.53,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.63,
      "end_seconds": 257.25,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.34,
      "end_seconds": 264.53,
      "duration_seconds": 5.19,
      "text": "Erm, I'm allergic to kiwi, I get an itchy mouth."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.0,
      "end_seconds": 269.91,
      "duration_seconds": 3.91,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.11,
      "end_seconds": 273.36,
      "duration_seconds": 2.25,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.55,
      "end_seconds": 293.21,
      "duration_seconds": 7.66,
      "text": "There is a new murmur, small splinter lines under the nails and a tender spot on the finger pad."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.74,
      "end_seconds": 314.23,
      "duration_seconds": 15.49,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, I think we're dealing with possible infective endocarditis at this stage. I'd also keep a viral illness in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.7,
      "end_seconds": 319.42,
      "duration_seconds": 3.72,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.44,
      "end_seconds": 341.67,
      "duration_seconds": 20.23,
      "text": "Nothing I've seen today points to an emergency. It looks like possible infective endocarditis, but I'd like to confirm. I'd like to arrange an echocardiogram for new murmur. You need admission today for blood cultures and a heart scan. I'm going to send a referral to the cardiology team."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.74,
      "end_seconds": 345.13,
      "duration_seconds": 2.39,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.31,
      "end_seconds": 351.04,
      "duration_seconds": 4.73,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.6,
      "end_seconds": 355.63,
      "duration_seconds": 3.03,
      "text": "So, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.48,
      "end_seconds": 358.83,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}