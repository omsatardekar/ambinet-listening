{
  "schema_version": "1.0",
  "encounter_id": "02077",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.16,
      "duration_seconds": 3.47,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 9.67,
      "duration_seconds": 3.67,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.47,
      "end_seconds": 16.27,
      "duration_seconds": 5.8,
      "text": "I wanted to get spots on my forehead and chin looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.79,
      "end_seconds": 19.19,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.76,
      "end_seconds": 24.01,
      "duration_seconds": 3.25,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.46,
      "end_seconds": 28.68,
      "duration_seconds": 4.22,
      "text": "Ah. Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.87,
      "end_seconds": 34.91,
      "duration_seconds": 2.04,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.69,
      "end_seconds": 51.81,
      "duration_seconds": 3.12,
      "text": "Did you get irregular periods or low mood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 55.72,
      "duration_seconds": 2.8,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 59.8,
      "duration_seconds": 3.17,
      "text": "Did you get scarring or painful cysts?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.78,
      "end_seconds": 64.63,
      "duration_seconds": 2.85,
      "text": "No, no scarring or painful cysts."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.57,
      "end_seconds": 70.73,
      "duration_seconds": 4.16,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.13,
      "end_seconds": 73.75,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.44,
      "end_seconds": 80.97,
      "duration_seconds": 5.53,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.73,
      "end_seconds": 85.64,
      "duration_seconds": 2.91,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.62,
      "end_seconds": 90.58,
      "duration_seconds": 3.96,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.52,
      "end_seconds": 94.17,
      "duration_seconds": 1.65,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.14,
      "end_seconds": 96.84,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.62,
      "end_seconds": 107.7,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.1,
      "end_seconds": 112.8,
      "duration_seconds": 3.7,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 117.38,
      "duration_seconds": 2.78,
      "text": "Alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.48,
      "end_seconds": 121.3,
      "duration_seconds": 2.82,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.23,
      "end_seconds": 126.34,
      "duration_seconds": 3.11,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.96,
      "end_seconds": 130.32,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.45,
      "end_seconds": 133.92,
      "duration_seconds": 2.47,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.61,
      "end_seconds": 138.77,
      "duration_seconds": 3.16,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.28,
      "end_seconds": 159.47,
      "duration_seconds": 5.19,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.97,
      "end_seconds": 166.35,
      "duration_seconds": 5.38,
      "text": "It's metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.06,
      "end_seconds": 169.57,
      "duration_seconds": 2.51,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.3,
      "end_seconds": 172.55,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.39,
      "end_seconds": 176.21,
      "duration_seconds": 2.82,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.3,
      "end_seconds": 185.89,
      "duration_seconds": 3.59,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.94,
      "end_seconds": 210.59,
      "duration_seconds": 9.65,
      "text": "Okay: SpO2 99 percent on room air, heart rate 82. And pressure 128 over 77, temperature 36.9, respiratory rate 17."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.47,
      "end_seconds": 217.81,
      "duration_seconds": 5.34,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.21,
      "end_seconds": 220.52,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.32,
      "end_seconds": 237.04,
      "duration_seconds": 5.72,
      "text": "There are small blackheads and a few red spots with no deep cysts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.65,
      "end_seconds": 244.14,
      "duration_seconds": 2.49,
      "text": "Alright, you can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.89,
      "end_seconds": 268.46,
      "duration_seconds": 6.57,
      "text": "So, based on the history and the examination, it fits best with mild acne."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.3,
      "end_seconds": 273.71,
      "duration_seconds": 3.41,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.68,
      "end_seconds": 314.19,
      "duration_seconds": 38.51,
      "text": "I understand the worry. At the moment I'd say it's mild acne, and we'll watch how it goes. The treatment will be benzoyl peroxide gel, 5%, once a day, eight weeks. That should help with acne. It's a commonly used medicine and most people tolerate it well. Wash gently twice a day and don't squeeze the spots. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's review you in eight weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.92,
      "end_seconds": 318.55,
      "duration_seconds": 3.63,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.79,
      "end_seconds": 322.58,
      "duration_seconds": 2.79,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.49,
      "end_seconds": 327.08,
      "duration_seconds": 2.59,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.1,
      "end_seconds": 331.28,
      "duration_seconds": 3.18,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}