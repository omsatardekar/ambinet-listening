      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.71,
      "end_seconds": 411.2,
      "duration_seconds": 7.49,
      "text": "Come back if still stuck tomorrow. Right, that's the plan. Do you want to ask me anything?"
