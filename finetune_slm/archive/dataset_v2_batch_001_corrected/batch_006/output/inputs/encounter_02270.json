    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.55,
      "end_seconds": 87.96,
      "duration_seconds": 13.41,
      "text": "I'd say mild. I've been having eaten fish too, for one week. And, And there's a sharp scratch when swallowing as well, four weeks now."
