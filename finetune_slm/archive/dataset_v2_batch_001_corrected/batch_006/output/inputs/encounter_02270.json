    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.89,
      "end_seconds": 92.3,
      "duration_seconds": 2.41,
      "text": "Let's start with the basic checks."
