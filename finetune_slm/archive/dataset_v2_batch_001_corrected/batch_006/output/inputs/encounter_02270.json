      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.3,
      "end_seconds": 108.56,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.04,
      "end_seconds": 139.36,
      "duration_seconds": 9.32,
      "text": "Okay: respiratory rate 17, pulse is 84 beats a minute, oxygen saturation is 99 percent, pressure 121 over 76."
