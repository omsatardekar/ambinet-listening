    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.93,
      "end_seconds": 321.09,
      "duration_seconds": 4.16,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.77,
      "end_seconds": 329.9,
      "duration_seconds": 7.13,
      "text": "I have eczema, for about ten years. Thin bones, for two years. I've got asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.44,
      "end_seconds": 349.61,
      "duration_seconds": 19.17,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Taking everything into account, I don't have a clear answer today: a possible fish bone scratch or lodged bone is possible, and so is a pharyngeal scratch."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.46,
      "end_seconds": 353.62,
      "duration_seconds": 3.16,
      "text": "I'm scared it's something bad. Is it?"
    },
