    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.69,
      "end_seconds": 231.95,
      "duration_seconds": 14.26,
      "text": "I quit smoking around ten years ago. I'm vegetarian and have been for years. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.17,
      "end_seconds": 253.34,
      "duration_seconds": 5.17,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.13,
      "end_seconds": 258.75,
      "duration_seconds": 3.62,
      "text": "Hydrocortisone cream, when needed for the eczema."
