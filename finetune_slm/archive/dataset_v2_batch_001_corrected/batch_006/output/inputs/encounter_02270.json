      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.23,
      "end_seconds": 365.08,
      "duration_seconds": 10.85,
      "text": "It's reasonable to be concerned, but right now a possible fish bone scratch or lodged bone is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.54,
      "end_seconds": 397.56,
      "duration_seconds": 16.02,
      "text": "Let's book a neck X-ray to look into foreign body sensation. Sip water and eat soft foods; if it persists we look with a camera. Do get help quickly if you have trouble breathing or swallowing saliva."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.95,
      "end_seconds": 402.6,
      "duration_seconds": 3.65,
      "text": "I, I know what to watch for."
    },
