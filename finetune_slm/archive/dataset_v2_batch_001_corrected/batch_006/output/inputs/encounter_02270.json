    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.16,
      "end_seconds": 216.59,
      "duration_seconds": 3.43,
      "text": "A few questions about your lifestyle now."
