{
  "schema_version": "1.0",
  "encounter_id": "02164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.45,
      "duration_seconds": 6.18,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.48,
      "end_seconds": 13.34,
      "duration_seconds": 3.86,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.47,
      "end_seconds": 23.26,
      "duration_seconds": 8.79,
      "text": "Honestly, it's electric shock pains in my cheek, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.31,
      "end_seconds": 27.78,
      "duration_seconds": 3.47,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.8,
      "end_seconds": 35.83,
      "duration_seconds": 6.03,
      "text": "Diclofenac, 50 milligrams, when needed. I take paracetamol, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 39.26,
      "duration_seconds": 2.34,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.62,
      "end_seconds": 45.18,
      "duration_seconds": 4.56,
      "text": "1 gram, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.75,
      "end_seconds": 48.83,
      "duration_seconds": 3.08,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 57.61,
      "duration_seconds": 3.04,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.03,
      "end_seconds": 61.17,
      "duration_seconds": 3.14,
      "text": "right, right. What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.95,
      "end_seconds": 67.39,
      "duration_seconds": 5.44,
      "text": "Yes, chewing and touching the face. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.86,
      "end_seconds": 72.49,
      "duration_seconds": 3.63,
      "text": "Alright, has there been pain lasting seconds too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.4,
      "end_seconds": 84.89,
      "duration_seconds": 10.49,
      "text": "yes, for two days oh, and being afraid to eat that's been about the same, about two weeks"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.81,
      "end_seconds": 89.55,
      "duration_seconds": 3.74,
      "text": "Have you had hearing loss, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.48,
      "end_seconds": 92.68,
      "duration_seconds": 2.2,
      "text": "Nope, no hearing loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.53,
      "end_seconds": 98.45,
      "duration_seconds": 3.92,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.6,
      "end_seconds": 101.9,
      "duration_seconds": 2.3,
      "text": "nothing like that that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 104.58,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.94,
      "end_seconds": 109.14,
      "duration_seconds": 3.2,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.1,
      "end_seconds": 113.89,
      "duration_seconds": 2.79,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.63,
      "end_seconds": 119.95,
      "duration_seconds": 4.32,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.08,
      "end_seconds": 123.33,
      "duration_seconds": 2.25,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.87,
      "end_seconds": 131.39,
      "duration_seconds": 2.52,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.15,
      "end_seconds": 150.75,
      "duration_seconds": 5.6,
      "text": "Okay, do you have any chronic illnesses? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.31,
      "end_seconds": 157.67,
      "duration_seconds": 5.36,
      "text": "I have arthritis in my knees, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.52,
      "end_seconds": 164.15,
      "duration_seconds": 4.63,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.89,
      "end_seconds": 173.29,
      "duration_seconds": 7.4,
      "text": "Ah, not currently, but as a youngster tramadol gave me feeling very drowsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 187.67,
      "duration_seconds": 4.72,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.48,
      "end_seconds": 197.16,
      "duration_seconds": 2.68,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.63,
      "end_seconds": 224.73,
      "duration_seconds": 9.1,
      "text": "Okay: temp 36.8 degrees, oxygen saturation is 97 percent, pressure 124 over 79, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.79,
      "end_seconds": 231.31,
      "duration_seconds": 4.52,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.31,
      "end_seconds": 234.42,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.37,
      "end_seconds": 249.22,
      "duration_seconds": 5.85,
      "text": "Touching the right cheek sets off the pain and the face muscles work normally."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.59,
      "end_seconds": 256.02,
      "duration_seconds": 2.43,
      "text": "Okay, that's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.32,
      "end_seconds": 281.39,
      "duration_seconds": 12.07,
      "text": "putting it all together, it's hard to say. Trigeminal neuralgia is one possibility and a dental problem another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.22,
      "end_seconds": 287.51,
      "duration_seconds": 4.29,
      "text": "Um, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.97,
      "end_seconds": 307.65,
      "duration_seconds": 15.68,
      "text": "Nothing I've seen today points to an emergency. It looks like trigeminal neuralgia. I'm prescribing carbamazepine, 100 milligrams, twice a day, titrate. It's for nerve pain. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.56,
      "end_seconds": 314.8,
      "duration_seconds": 6.24,
      "text": "yeah, um, okay, that makes sense thanks for explaining"
    }
  ]
}