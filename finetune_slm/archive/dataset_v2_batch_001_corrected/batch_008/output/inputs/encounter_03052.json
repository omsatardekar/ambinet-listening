{
  "schema_version": "1.0",
  "encounter_id": "03052",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 4.7,
      "duration_seconds": 3.55,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.04,
      "end_seconds": 10.41,
      "duration_seconds": 4.37,
      "text": "that's fine, sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.44,
      "end_seconds": 23.21,
      "duration_seconds": 11.77,
      "text": "Yeah, it's a cough that eases on holiday. I don't know what's causing it. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.6,
      "end_seconds": 29.31,
      "duration_seconds": 4.71,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.34,
      "end_seconds": 36.04,
      "duration_seconds": 5.7,
      "text": "it's, It's all the time a eight out of ten, I suppose"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.99,
      "end_seconds": 40.28,
      "duration_seconds": 2.29,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.22,
      "end_seconds": 52.23,
      "duration_seconds": 11.01,
      "text": "Wheeze at work goes along with it, most of the time. I've also had itchy eyes at work, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.6,
      "end_seconds": 58.65,
      "duration_seconds": 5.05,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.27,
      "end_seconds": 61.91,
      "duration_seconds": 2.64,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.79,
      "end_seconds": 66.57,
      "duration_seconds": 2.78,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.55,
      "end_seconds": 73.47,
      "duration_seconds": 5.92,
      "text": "It's severe, honestly. The wheeze at work? That's been for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.57,
      "end_seconds": 78.75,
      "duration_seconds": 4.18,
      "text": "Have you noticed fever, weight loss or ankle swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 85.71,
      "duration_seconds": 5.31,
      "text": "No fever, weight loss or ankle swelling, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.49,
      "end_seconds": 88.46,
      "duration_seconds": 1.97,
      "text": "nothing like coughing up blood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.0,
      "end_seconds": 91.6,
      "duration_seconds": 2.6,
      "text": "definitely no coughing up blood"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.49,
      "end_seconds": 98.51,
      "duration_seconds": 5.02,
      "text": "okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.33,
      "end_seconds": 101.26,
      "duration_seconds": 1.93,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 119.29,
      "duration_seconds": 3.96,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 123.49,
      "duration_seconds": 2.92,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.31,
      "end_seconds": 127.22,
      "duration_seconds": 2.91,
      "text": "so, do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.56,
      "end_seconds": 134.83,
      "duration_seconds": 2.27,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.91,
      "end_seconds": 139.9,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.7,
      "end_seconds": 145.05,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.87,
      "end_seconds": 148.4,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.06,
      "end_seconds": 152.43,
      "duration_seconds": 2.37,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.49,
      "end_seconds": 156.85,
      "duration_seconds": 3.36,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 160.67,
      "duration_seconds": 2.83,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 165.67,
      "duration_seconds": 2.33,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.39,
      "end_seconds": 170.79,
      "duration_seconds": 3.4,
      "text": "No, uh, not at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.01,
      "end_seconds": 192.3,
      "duration_seconds": 3.29,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.23,
      "end_seconds": 205.07,
      "duration_seconds": 2.84,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.87,
      "end_seconds": 233.38,
      "duration_seconds": 18.51,
      "text": "okay: pulse is 84 beats a minute, height 180 centimetres, oxygen saturation is 99 percent, BMI works out to 30.2, blood pressure 113 over 82, respiratory rate 16, temp 37.0 degrees, weight 98 kilos"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.0,
      "end_seconds": 237.11,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.84,
      "end_seconds": 241.88,
      "duration_seconds": 4.04,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.66,
      "end_seconds": 248.95,
      "duration_seconds": 4.29,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.52,
      "end_seconds": 251.81,
      "duration_seconds": 1.29,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.29,
      "end_seconds": 267.25,
      "duration_seconds": 4.96,
      "text": "there is a little wheeze at the end of each breath out"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.73,
      "end_seconds": 272.73,
      "duration_seconds": 3.0,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.04,
      "end_seconds": 301.33,
      "duration_seconds": 15.29,
      "text": "Okay, so my impression is this: I think we're dealing with occupational asthma at this stage. So, to recap quickly. You've had a cough that eases on holiday, and no fever or ankle swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.68,
      "end_seconds": 303.38,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.25,
      "end_seconds": 337.65,
      "duration_seconds": 32.4,
      "text": "I'll request spirometry, it'll help with wheeze. I want serial peak flow readings done, that's for work-related wheeze. What I'm giving you is beclometasone inhaler, 200 micrograms, twice a day, long term. That should help with asthma. Record peak flows at work and at home for four weeks. I think occupational health should see you too. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.2,
      "end_seconds": 342.67,
      "duration_seconds": 4.47,
      "text": "Yes, um, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.37,
      "end_seconds": 351.22,
      "duration_seconds": 7.85,
      "text": "Please come and see me in four weeks. Right, that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.02,
      "end_seconds": 355.64,
      "duration_seconds": 2.62,
      "text": "That's clear, um, thanks."
    }
  ]
}