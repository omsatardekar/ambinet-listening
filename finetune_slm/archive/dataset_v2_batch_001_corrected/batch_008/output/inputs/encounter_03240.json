{
  "schema_version": "1.0",
  "encounter_id": "03240",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.32,
      "duration_seconds": 4.43,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.06,
      "end_seconds": 10.79,
      "duration_seconds": 3.73,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.7,
      "end_seconds": 15.18,
      "duration_seconds": 3.48,
      "text": "It's stiffness putting on socks, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.03,
      "end_seconds": 18.78,
      "duration_seconds": 2.75,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.6,
      "end_seconds": 22.65,
      "duration_seconds": 2.05,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.48,
      "end_seconds": 26.32,
      "duration_seconds": 2.84,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.08,
      "end_seconds": 32.53,
      "duration_seconds": 4.45,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.43,
      "end_seconds": 36.65,
      "duration_seconds": 3.22,
      "text": "So, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.57,
      "end_seconds": 52.95,
      "duration_seconds": 14.38,
      "text": "When it starts I tend to get pain in my groin and hip as well. The pain in my groin and hip? That's been for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.46,
      "end_seconds": 57.66,
      "duration_seconds": 4.2,
      "text": "A few quick ones: fall, weight loss or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.3,
      "end_seconds": 62.84,
      "duration_seconds": 4.54,
      "text": "I haven't had fall, weight loss or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.66,
      "end_seconds": 68.6,
      "duration_seconds": 3.94,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.59,
      "end_seconds": 71.76,
      "duration_seconds": 2.17,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.8,
      "end_seconds": 77.1,
      "duration_seconds": 3.3,
      "text": "Alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.1,
      "end_seconds": 80.26,
      "duration_seconds": 2.16,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.19,
      "end_seconds": 84.15,
      "duration_seconds": 2.96,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.45,
      "end_seconds": 88.2,
      "duration_seconds": 2.75,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 91.48,
      "duration_seconds": 2.09,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.74,
      "end_seconds": 96.3,
      "duration_seconds": 3.56,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.87,
      "end_seconds": 99.55,
      "duration_seconds": 2.68,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.89,
      "end_seconds": 104.5,
      "duration_seconds": 3.61,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.93,
      "end_seconds": 120.67,
      "duration_seconds": 3.74,
      "text": "So, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.96,
      "end_seconds": 125.4,
      "duration_seconds": 3.44,
      "text": "Well, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.29,
      "end_seconds": 143.05,
      "duration_seconds": 2.76,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.08,
      "end_seconds": 147.71,
      "duration_seconds": 2.63,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.69,
      "end_seconds": 153.94,
      "duration_seconds": 4.25,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.97,
      "end_seconds": 167.6,
      "duration_seconds": 2.63,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.01,
      "end_seconds": 185.96,
      "duration_seconds": 5.95,
      "text": "Okay: heart rate 74, blood pressure 121 over 73, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.65,
      "end_seconds": 191.87,
      "duration_seconds": 4.22,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.44,
      "end_seconds": 206.01,
      "duration_seconds": 1.57,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.3,
      "end_seconds": 208.63,
      "duration_seconds": 1.33,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.61,
      "end_seconds": 227.53,
      "duration_seconds": 5.92,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.09,
      "end_seconds": 234.74,
      "duration_seconds": 2.65,
      "text": "Okay, you can sit up now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.54,
      "end_seconds": 247.57,
      "duration_seconds": 4.03,
      "text": "Okay, thinking it through, it points towards hip osteoarthritis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.51,
      "end_seconds": 251.37,
      "duration_seconds": 2.86,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.15,
      "end_seconds": 269.94,
      "duration_seconds": 16.79,
      "text": "I understand the worry. At the moment I'd say it's hip osteoarthritis, and we'll know more once the an X-ray of the hips is back. I'm sending you for an X-ray of the hips because of hip pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.4,
      "end_seconds": 274.48,
      "duration_seconds": 3.08,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.39,
      "end_seconds": 304.88,
      "duration_seconds": 26.49,
      "text": "I'm going to put you on naproxen, 250 milligrams, twice a day with food, two weeks. It's for hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. One warning sign to remember: the symptoms get worse. In that case don't wait. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.45,
      "end_seconds": 309.58,
      "duration_seconds": 3.13,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}