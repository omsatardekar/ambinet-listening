{
  "schema_version": "1.0",
  "encounter_id": "03233",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 7.87,
      "duration_seconds": 6.9,
      "text": "Doctor, uh, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.15,
      "end_seconds": 13.95,
      "duration_seconds": 4.8,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.87,
      "end_seconds": 18.73,
      "duration_seconds": 2.86,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.8,
      "end_seconds": 27.05,
      "duration_seconds": 5.25,
      "text": "It's a splash of cleaning fluid in my eye, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.05,
      "end_seconds": 30.49,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.56,
      "end_seconds": 35.04,
      "duration_seconds": 3.48,
      "text": "Around a week, you know, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.73,
      "end_seconds": 40.37,
      "duration_seconds": 3.64,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.11,
      "end_seconds": 46.16,
      "duration_seconds": 4.05,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 49.33,
      "duration_seconds": 2.33,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.01,
      "end_seconds": 53.04,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.73,
      "end_seconds": 63.32,
      "duration_seconds": 9.59,
      "text": "Mostly mild. I've also had blurred vision. I did have severe burning at one point, um, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.62,
      "end_seconds": 79.64,
      "duration_seconds": 5.02,
      "text": "Let me check a few things. Any head injury or both eyes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.31,
      "end_seconds": 88.61,
      "duration_seconds": 5.3,
      "text": "No, you know, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.87,
      "end_seconds": 92.31,
      "duration_seconds": 2.44,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.71,
      "end_seconds": 95.45,
      "duration_seconds": 1.74,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.41,
      "end_seconds": 99.7,
      "duration_seconds": 3.29,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.74,
      "end_seconds": 102.93,
      "duration_seconds": 2.19,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.62,
      "end_seconds": 114.3,
      "duration_seconds": 1.68,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.06,
      "end_seconds": 121.71,
      "duration_seconds": 5.65,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.69,
      "end_seconds": 125.46,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.4,
      "end_seconds": 129.03,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.41,
      "end_seconds": 132.89,
      "duration_seconds": 2.48,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.72,
      "end_seconds": 138.22,
      "duration_seconds": 3.5,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.32,
      "end_seconds": 143.35,
      "duration_seconds": 3.03,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.57,
      "end_seconds": 148.8,
      "duration_seconds": 4.23,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.84,
      "end_seconds": 154.26,
      "duration_seconds": 4.42,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.97,
      "end_seconds": 156.02,
      "duration_seconds": 1.05,
      "text": "Yes, migraines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.21,
      "end_seconds": 165.47,
      "duration_seconds": 8.26,
      "text": "Okay, I can see migraines in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.25,
      "end_seconds": 179.07,
      "duration_seconds": 11.82,
      "text": "It's sumatriptan, 50 milligrams, when needed for my migraines. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.64,
      "end_seconds": 183.26,
      "duration_seconds": 2.62,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.8,
      "end_seconds": 199.74,
      "duration_seconds": 2.94,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.54,
      "end_seconds": 229.08,
      "duration_seconds": 7.54,
      "text": "Okay: temp 36.6 degrees, saturation 97 percent, pulse 77, BP is 115 over 68, respiratory rate 17."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.74,
      "end_seconds": 234.26,
      "duration_seconds": 3.52,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 238.03,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.77,
      "end_seconds": 253.15,
      "duration_seconds": 7.38,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.62,
      "end_seconds": 259.56,
      "duration_seconds": 1.94,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 286.62,
      "duration_seconds": 11.17,
      "text": "Stop me if I've got anything wrong. You've had a splash of cleaning fluid in your eye, mild, and no head injury or both eyes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.81,
      "end_seconds": 289.61,
      "duration_seconds": 1.8,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 295.32,
      "duration_seconds": 4.84,
      "text": "I want an urgent pH check done, that's for chemical burn."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.82,
      "end_seconds": 298.88,
      "duration_seconds": 3.06,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.22,
      "end_seconds": 309.68,
      "duration_seconds": 9.46,
      "text": "The treatment will be sterile saline irrigation, 2 litres, continuous, until pH neutral. That should help with chemical eye burn."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.56,
      "end_seconds": 314.72,
      "duration_seconds": 4.16,
      "text": "Right, is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.05,
      "end_seconds": 326.27,
      "duration_seconds": 10.22,
      "text": "I am washing the eye now, keep it open and do not stop. Let's review you straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.27,
      "end_seconds": 336.37,
      "duration_seconds": 4.1,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}