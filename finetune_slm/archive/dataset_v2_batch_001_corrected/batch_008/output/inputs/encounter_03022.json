{
  "schema_version": "1.0",
  "encounter_id": "03022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.07,
      "duration_seconds": 4.19,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.14,
      "end_seconds": 11.37,
      "duration_seconds": 4.23,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 23.52,
      "duration_seconds": 10.17,
      "text": "Sorry, what was I saying, I'm here because of tiredness. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.15,
      "end_seconds": 27.15,
      "duration_seconds": 2.0,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.96,
      "end_seconds": 44.68,
      "duration_seconds": 15.72,
      "text": "I, I take metoprolol, 50 milligrams, twice a day. Escitalopram. I take it 10 milligrams, once a day. I was on furosemide before. I stopped taking it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.26,
      "end_seconds": 61.89,
      "duration_seconds": 3.63,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.05,
      "end_seconds": 74.22,
      "duration_seconds": 11.17,
      "text": "Five days, I think... sorry, two days, I got that wrong. Oh, and mouth ulcers. Had that since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.98,
      "end_seconds": 79.39,
      "duration_seconds": 3.41,
      "text": "Any a rash on your elbows as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.47,
      "end_seconds": 83.34,
      "duration_seconds": 2.87,
      "text": "Yeah, you know, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.91,
      "end_seconds": 88.95,
      "duration_seconds": 5.04,
      "text": "Have you had tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.71,
      "end_seconds": 100.3,
      "duration_seconds": 9.59,
      "text": "Yes, um, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.59,
      "end_seconds": 106.67,
      "duration_seconds": 5.08,
      "text": "Any weight loss, bone pain, diarrhoea or vomiting at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.91,
      "end_seconds": 114.65,
      "duration_seconds": 6.74,
      "text": "I haven't had weight loss, bone pain, diarrhoea or vomiting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.38,
      "end_seconds": 116.95,
      "duration_seconds": 1.57,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.96,
      "end_seconds": 120.48,
      "duration_seconds": 2.52,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.26,
      "end_seconds": 125.97,
      "duration_seconds": 3.71,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 136.31,
      "duration_seconds": 9.57,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.17,
      "end_seconds": 156.1,
      "duration_seconds": 3.93,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.07,
      "end_seconds": 169.95,
      "duration_seconds": 12.88,
      "text": "I have heart failure, for two years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.31,
      "end_seconds": 172.01,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.1,
      "end_seconds": 175.9,
      "duration_seconds": 1.8,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.0,
      "end_seconds": 182.4,
      "duration_seconds": 5.4,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.82,
      "end_seconds": 195.18,
      "duration_seconds": 3.36,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.96,
      "end_seconds": 200.36,
      "duration_seconds": 3.4,
      "text": "Um, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.11,
      "end_seconds": 203.22,
      "duration_seconds": 2.11,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.53,
      "end_seconds": 210.48,
      "duration_seconds": 5.95,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.12,
      "end_seconds": 213.08,
      "duration_seconds": 1.96,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.21,
      "end_seconds": 218.64,
      "duration_seconds": 4.43,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.42,
      "end_seconds": 221.3,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.98,
      "end_seconds": 225.71,
      "duration_seconds": 2.73,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.29,
      "end_seconds": 231.41,
      "duration_seconds": 4.12,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.52,
      "end_seconds": 242.43,
      "duration_seconds": 2.91,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.09,
      "end_seconds": 257.73,
      "duration_seconds": 5.64,
      "text": "Okay: pressure 120 over 77, pulse 85, saturation 99 percent, temperature 36.6."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.18,
      "end_seconds": 263.11,
      "duration_seconds": 3.93,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.95,
      "end_seconds": 265.15,
      "duration_seconds": 1.2,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.38,
      "end_seconds": 284.99,
      "duration_seconds": 5.61,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.84,
      "end_seconds": 287.93,
      "duration_seconds": 2.09,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.24,
      "end_seconds": 302.25,
      "duration_seconds": 11.01,
      "text": "Okay, that's enough for me. Okay, thinking it through, it points towards coeliac disease on a gluten-free diet with some accidental exposure. Iron deficiency is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.91,
      "end_seconds": 305.56,
      "duration_seconds": 1.65,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.45,
      "end_seconds": 341.14,
      "duration_seconds": 30.69,
      "text": "Nothing I've seen today points to an emergency. It looks like coeliac disease on a gluten-free diet with some accidental exposure, but I'd like to confirm. Coeliac antibodies is what I'd like next, for coeliac follow-up. We should do a blood count for coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'll want another look in twelve months."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.87,
      "end_seconds": 345.29,
      "duration_seconds": 3.42,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.67,
      "end_seconds": 348.48,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}