{
  "schema_version": "1.0",
  "encounter_id": "03326",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.4,
      "duration_seconds": 4.07,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.3,
      "duration_seconds": 3.71,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 19.77,
      "duration_seconds": 7.74,
      "text": "Actually, mainly fever and shivers. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.11,
      "end_seconds": 24.94,
      "duration_seconds": 3.83,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.98,
      "end_seconds": 31.57,
      "duration_seconds": 4.59,
      "text": "Well, it's been like this since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.31,
      "end_seconds": 34.72,
      "duration_seconds": 2.41,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.29,
      "end_seconds": 38.08,
      "duration_seconds": 2.79,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.83,
      "end_seconds": 44.45,
      "duration_seconds": 4.62,
      "text": "What about pain in the lower tummy, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.75,
      "end_seconds": 47.46,
      "duration_seconds": 1.71,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.11,
      "end_seconds": 53.53,
      "duration_seconds": 4.42,
      "text": "What about cloudy smelly urine, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.31,
      "end_seconds": 56.44,
      "duration_seconds": 2.13,
      "text": "Yes, since last weekend."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.49,
      "end_seconds": 74.96,
      "duration_seconds": 3.47,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.48,
      "end_seconds": 87.81,
      "duration_seconds": 11.33,
      "text": "Tamsulosin. I take it 0.4 milligrams, at night. Febuxostat, 80 milligrams, once a day for the gout. It's a urinary catheter, in place."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 93.14,
      "duration_seconds": 4.75,
      "text": "I follow. Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.83,
      "end_seconds": 105.81,
      "duration_seconds": 10.98,
      "text": "I, I have an enlarged prostate, for two years. My sister suggested writing things down, but I forgot. I have gout."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.76,
      "end_seconds": 118.18,
      "duration_seconds": 10.42,
      "text": "Okay, I can see gout in your file as well. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.78,
      "end_seconds": 121.96,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.37,
      "end_seconds": 130.14,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.02,
      "end_seconds": 135.58,
      "duration_seconds": 4.56,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.74,
      "end_seconds": 155.52,
      "duration_seconds": 2.78,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.81,
      "end_seconds": 171.55,
      "duration_seconds": 14.74,
      "text": "I do a yoga class on Thursdays. I'm a bus driver, so I sit for long hours. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.21,
      "end_seconds": 176.59,
      "duration_seconds": 3.38,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.62,
      "end_seconds": 180.58,
      "duration_seconds": 1.96,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.24,
      "end_seconds": 185.2,
      "duration_seconds": 3.96,
      "text": "Any cough, back pain, fall or vomiting at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.81,
      "end_seconds": 189.94,
      "duration_seconds": 3.13,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.55,
      "end_seconds": 196.86,
      "duration_seconds": 2.31,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.78,
      "end_seconds": 199.8,
      "duration_seconds": 1.02,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.22,
      "end_seconds": 203.44,
      "duration_seconds": 2.22,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.56,
      "end_seconds": 211.83,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 237.04,
      "duration_seconds": 9.88,
      "text": "Okay: oxygen saturation is 97 percent, respiratory rate 16, blood pressure 110 over 78, heart rate 107, temperature 38.8."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.89,
      "end_seconds": 241.45,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.06,
      "end_seconds": 244.61,
      "duration_seconds": 2.55,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.36,
      "end_seconds": 250.98,
      "duration_seconds": 4.62,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.43,
      "end_seconds": 254.88,
      "duration_seconds": 2.45,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.88,
      "end_seconds": 280.58,
      "duration_seconds": 6.7,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.28,
      "end_seconds": 282.64,
      "duration_seconds": 1.36,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.8,
      "end_seconds": 297.47,
      "duration_seconds": 10.67,
      "text": "That's all I needed to check. So where does that leave us? I'd lean towards a catheter-related urinary infection. I'd also keep urosepsis in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.34,
      "end_seconds": 301.36,
      "duration_seconds": 3.02,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.39,
      "end_seconds": 313.47,
      "duration_seconds": 9.08,
      "text": "It's reasonable to be concerned, but right now a catheter-related urinary infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.07,
      "end_seconds": 360.51,
      "duration_seconds": 29.44,
      "text": "I'm sending you for a urine culture because of possible urinary infection. I'd like you to take co-amoxiclav, 625 milligrams, three times a day, seven days. That's for catheter urinary infection. Change the catheter and drink plenty. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'd like to see you again in two days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.65,
      "end_seconds": 362.35,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.63,
      "end_seconds": 370.71,
      "duration_seconds": 4.08,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.44,
      "end_seconds": 374.59,
      "duration_seconds": 2.15,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.33,
      "end_seconds": 376.77,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}