{
  "schema_version": "1.0",
  "encounter_id": "03003",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 5.67,
      "duration_seconds": 4.95,
      "text": "Sorry, um, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 11.49,
      "duration_seconds": 5.07,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 17.47,
      "duration_seconds": 5.42,
      "text": "Well, I've been having pain in my groin and hip."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.39,
      "end_seconds": 21.33,
      "duration_seconds": 2.94,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.24,
      "end_seconds": 28.1,
      "duration_seconds": 4.86,
      "text": "Erm, it's been going on for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.32,
      "end_seconds": 34.25,
      "duration_seconds": 2.93,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 39.04,
      "duration_seconds": 3.0,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.9,
      "end_seconds": 46.52,
      "duration_seconds": 2.62,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.06,
      "end_seconds": 52.93,
      "duration_seconds": 4.87,
      "text": "Mm, it it settles a little with rest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.73,
      "end_seconds": 57.51,
      "duration_seconds": 2.78,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.3,
      "end_seconds": 88.2,
      "duration_seconds": 28.9,
      "text": "Mm, I'd give it a four, out of ten. Oh, and a limp. That's been about the same, five days. Oh, um, as for stiffness putting on socks, I honestly can't say when that began. It might have been last month or the month before. Okay, so with stiffness putting on socks, I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 93.19,
      "duration_seconds": 3.84,
      "text": "have you had any fever, numbness or fall?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.05,
      "end_seconds": 102.32,
      "duration_seconds": 4.27,
      "text": "okay, so no, none that that I've noticed"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.07,
      "end_seconds": 106.08,
      "duration_seconds": 2.01,
      "text": "Any sign of weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.06,
      "end_seconds": 110.3,
      "duration_seconds": 2.24,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.79,
      "end_seconds": 113.58,
      "duration_seconds": 2.79,
      "text": "Yes. Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.2,
      "end_seconds": 117.76,
      "duration_seconds": 2.56,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.43,
      "end_seconds": 123.9,
      "duration_seconds": 4.47,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.9,
      "end_seconds": 130.73,
      "duration_seconds": 3.83,
      "text": "Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.55,
      "end_seconds": 136.43,
      "duration_seconds": 3.88,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.11,
      "end_seconds": 140.83,
      "duration_seconds": 3.72,
      "text": "No, you know, it's at home."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.9,
      "end_seconds": 146.67,
      "duration_seconds": 3.77,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.89,
      "end_seconds": 156.26,
      "duration_seconds": 4.37,
      "text": "Arthritis in my knees, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.45,
      "end_seconds": 158.15,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.69,
      "end_seconds": 164.79,
      "duration_seconds": 2.1,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.06,
      "end_seconds": 168.71,
      "duration_seconds": 2.65,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.21,
      "end_seconds": 176.57,
      "duration_seconds": 6.36,
      "text": "Right, so depression is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.14,
      "end_seconds": 198.99,
      "duration_seconds": 4.85,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.3,
      "end_seconds": 208.32,
      "duration_seconds": 6.02,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 214.73,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.09,
      "end_seconds": 217.89,
      "duration_seconds": 1.8,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 221.78,
      "duration_seconds": 3.34,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.49,
      "end_seconds": 229.12,
      "duration_seconds": 3.63,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.0,
      "end_seconds": 232.73,
      "duration_seconds": 2.73,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.91,
      "end_seconds": 237.58,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.66,
      "end_seconds": 242.17,
      "duration_seconds": 2.51,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.25,
      "end_seconds": 250.2,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.87,
      "end_seconds": 278.33,
      "duration_seconds": 7.46,
      "text": "Okay: pulse 70, BP is 119 over 80, SpO2 99 percent on room air, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.55,
      "end_seconds": 283.41,
      "duration_seconds": 3.86,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.26,
      "end_seconds": 287.44,
      "duration_seconds": 2.18,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.1,
      "end_seconds": 301.5,
      "duration_seconds": 6.4,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.32,
      "end_seconds": 304.96,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.35,
      "end_seconds": 309.17,
      "duration_seconds": 1.82,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.79,
      "end_seconds": 335.44,
      "duration_seconds": 10.65,
      "text": "Let me tell you where I've got to. My working impression is hip osteoarthritis. It could also be a back problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.53,
      "end_seconds": 358.37,
      "duration_seconds": 13.84,
      "text": "An X-ray of the hips is what I'd like next, for hip pain. We'll begin with naproxen, 250 milligrams, twice a day with food, two weeks. It's for hip pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.03,
      "end_seconds": 362.88,
      "duration_seconds": 3.85,
      "text": "Yeah, should I take that with food?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.74,
      "end_seconds": 388.31,
      "duration_seconds": 24.57,
      "text": "Use a walking stick in the left hand and do gentle strengthening exercises. I'm going to send a referral to the orthopaedic clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.99,
      "end_seconds": 391.94,
      "duration_seconds": 1.95,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.44,
      "end_seconds": 394.91,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}