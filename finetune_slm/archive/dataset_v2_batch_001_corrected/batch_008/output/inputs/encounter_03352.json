{
  "schema_version": "1.0",
  "encounter_id": "03352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 8.36,
      "duration_seconds": 7.7,
      "text": "Okay, so hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.21,
      "end_seconds": 12.88,
      "duration_seconds": 3.67,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.09,
      "end_seconds": 21.5,
      "duration_seconds": 7.41,
      "text": "Actually, you know, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.45,
      "end_seconds": 26.87,
      "duration_seconds": 3.42,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.69,
      "end_seconds": 44.86,
      "duration_seconds": 13.17,
      "text": "It's three early losses, mostly. I've been putting this off for weeks. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.21,
      "end_seconds": 50.5,
      "duration_seconds": 3.29,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.77,
      "end_seconds": 54.97,
      "duration_seconds": 3.2,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.61,
      "end_seconds": 58.68,
      "duration_seconds": 3.07,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.5,
      "end_seconds": 72.25,
      "duration_seconds": 11.75,
      "text": "About a five out of ten. And I've been feeling low and anxious as well, you know, for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 77.05,
      "duration_seconds": 2.74,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.54,
      "end_seconds": 85.62,
      "duration_seconds": 7.08,
      "text": "Oh, pretty mild, if I'm being honest. Oh, and irregular cycles."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.65,
      "end_seconds": 91.11,
      "duration_seconds": 3.46,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.95,
      "end_seconds": 96.23,
      "duration_seconds": 3.28,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.45,
      "end_seconds": 100.27,
      "duration_seconds": 3.82,
      "text": "Right, right. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.57,
      "end_seconds": 105.81,
      "duration_seconds": 4.24,
      "text": "Nothing, you know, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.85,
      "end_seconds": 108.64,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.22,
      "end_seconds": 114.35,
      "duration_seconds": 4.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.46,
      "end_seconds": 122.15,
      "duration_seconds": 2.69,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.02,
      "end_seconds": 128.22,
      "duration_seconds": 4.2,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.84,
      "end_seconds": 132.36,
      "duration_seconds": 3.52,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.13,
      "end_seconds": 136.23,
      "duration_seconds": 2.1,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.89,
      "end_seconds": 139.33,
      "duration_seconds": 1.44,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.85,
      "end_seconds": 142.9,
      "duration_seconds": 3.05,
      "text": "Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.86,
      "end_seconds": 155.26,
      "duration_seconds": 11.4,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.84,
      "end_seconds": 159.74,
      "duration_seconds": 2.9,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.4,
      "end_seconds": 172.97,
      "duration_seconds": 3.57,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.55,
      "end_seconds": 180.21,
      "duration_seconds": 5.66,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.2,
      "end_seconds": 185.13,
      "duration_seconds": 2.93,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.64,
      "end_seconds": 194.32,
      "duration_seconds": 8.68,
      "text": "About a year now. Pantoprazole. I take it 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 196.0,
      "end_seconds": 208.26,
      "duration_seconds": 12.26,
      "text": "Yeah, uh, doctor, I think the last prescription for the pantoprazole was 80 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.81,
      "end_seconds": 212.79,
      "duration_seconds": 3.98,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.78,
      "end_seconds": 224.56,
      "duration_seconds": 9.78,
      "text": "Right, no, I left it at home. Right, I take folic acid, 400 micrograms, maybe, daily."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.94,
      "end_seconds": 230.36,
      "duration_seconds": 4.42,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.22,
      "end_seconds": 234.71,
      "duration_seconds": 2.49,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.32,
      "end_seconds": 249.88,
      "duration_seconds": 4.56,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.78,
      "end_seconds": 266.98,
      "duration_seconds": 15.2,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.0,
      "end_seconds": 273.05,
      "duration_seconds": 4.05,
      "text": "Have you noticed fever, heavy bleeding now or clotting problem?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.69,
      "end_seconds": 281.62,
      "duration_seconds": 6.93,
      "text": "No fever, heavy bleeding now or clotting problem, none of it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.34,
      "end_seconds": 286.65,
      "duration_seconds": 4.31,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.85,
      "end_seconds": 297.62,
      "duration_seconds": 4.77,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.3,
      "end_seconds": 304.58,
      "duration_seconds": 2.28,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.42,
      "end_seconds": 310.11,
      "duration_seconds": 4.69,
      "text": "Sorry, what was I saying, no problems with breathing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.79,
      "end_seconds": 317.48,
      "duration_seconds": 4.69,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.74,
      "end_seconds": 333.77,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.48,
      "end_seconds": 337.99,
      "duration_seconds": 2.51,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.12,
      "end_seconds": 358.06,
      "duration_seconds": 1.94,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.62,
      "end_seconds": 376.31,
      "duration_seconds": 14.69,
      "text": "You can relax now. Right, here's what I'm thinking. It's hard to say. Recurrent miscarriage needing investigation is one possibility and a thyroid problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.2,
      "end_seconds": 380.87,
      "duration_seconds": 3.67,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.42,
      "end_seconds": 401.77,
      "duration_seconds": 19.35,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent miscarriage needing investigation, but I'd like to confirm. I want a pelvic ultrasound done, that's for recurrent miscarriage. Blood tests is what I'd like next, for recurrent miscarriage."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.74,
      "end_seconds": 403.85,
      "duration_seconds": 1.11,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.51,
      "end_seconds": 423.43,
      "duration_seconds": 18.92,
      "text": "We will arrange specialist care so the next pregnancy is looked after from the start. A short walk every day, even twenty minutes, will help more than you'd think. The recurrent miscarriage clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.79,
      "end_seconds": 426.51,
      "duration_seconds": 1.72,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.05,
      "end_seconds": 435.85,
      "duration_seconds": 8.8,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.79,
      "end_seconds": 438.5,
      "duration_seconds": 1.71,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.51,
      "end_seconds": 450.1,
      "duration_seconds": 10.59,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.92,
      "end_seconds": 452.7,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 453.96,
      "end_seconds": 455.28,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}