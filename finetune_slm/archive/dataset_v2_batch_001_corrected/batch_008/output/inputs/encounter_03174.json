{
  "schema_version": "1.0",
  "encounter_id": "03174",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.16,
      "end_seconds": 3.12,
      "duration_seconds": 1.96,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.21,
      "end_seconds": 7.84,
      "duration_seconds": 2.63,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.77,
      "end_seconds": 12.8,
      "duration_seconds": 4.03,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.87,
      "end_seconds": 19.79,
      "duration_seconds": 5.92,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 24.43,
      "duration_seconds": 2.94,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.11,
      "end_seconds": 34.56,
      "duration_seconds": 9.45,
      "text": "I'm here because of flakes on my shoulders. I thought it would sort itself out, but it it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 39.57,
      "duration_seconds": 3.35,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.17,
      "end_seconds": 43.28,
      "duration_seconds": 3.11,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.77,
      "end_seconds": 47.94,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.64,
      "end_seconds": 55.24,
      "duration_seconds": 6.6,
      "text": "About four days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.65,
      "end_seconds": 60.04,
      "duration_seconds": 4.39,
      "text": "hm, okay how strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 63.24,
      "duration_seconds": 2.43,
      "text": "I'd call it it mild"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.0,
      "end_seconds": 66.42,
      "duration_seconds": 2.42,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.07,
      "end_seconds": 70.26,
      "duration_seconds": 3.19,
      "text": "only shampoo, and it's not much"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.79,
      "end_seconds": 73.37,
      "duration_seconds": 2.58,
      "text": "Any an itchy scalp as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.54,
      "end_seconds": 76.16,
      "duration_seconds": 1.62,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.45,
      "duration_seconds": 2.77,
      "text": "and what about pain or pus?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.06,
      "end_seconds": 83.4,
      "duration_seconds": 2.34,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.42,
      "end_seconds": 90.07,
      "duration_seconds": 5.65,
      "text": "Let me check a few things. Any hair loss or rash elsewhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.65,
      "end_seconds": 93.96,
      "duration_seconds": 3.31,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.41,
      "end_seconds": 102.02,
      "duration_seconds": 4.61,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.82,
      "end_seconds": 106.07,
      "duration_seconds": 2.25,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.71,
      "end_seconds": 109.92,
      "duration_seconds": 2.21,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.86,
      "end_seconds": 112.77,
      "duration_seconds": 1.91,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.08,
      "end_seconds": 117.36,
      "duration_seconds": 3.28,
      "text": "do you work outside the the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.98,
      "end_seconds": 122.97,
      "duration_seconds": 3.99,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.88,
      "end_seconds": 126.9,
      "duration_seconds": 3.02,
      "text": "alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.51,
      "end_seconds": 130.8,
      "duration_seconds": 3.29,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.01,
      "end_seconds": 142.55,
      "duration_seconds": 2.54,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.47,
      "end_seconds": 147.31,
      "duration_seconds": 3.84,
      "text": "Yes, trimethoprim, it gives me a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.09,
      "end_seconds": 153.46,
      "duration_seconds": 4.37,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.42,
      "end_seconds": 157.57,
      "duration_seconds": 3.15,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.62,
      "end_seconds": 177.99,
      "duration_seconds": 2.37,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 188.01,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 216.92,
      "duration_seconds": 8.46,
      "text": "Okay: pressure 110 over 69, temp 36.7 degrees. And oxygen saturation is 99 percent, respiratory rate 18, pulse 70."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.57,
      "end_seconds": 222.78,
      "duration_seconds": 4.21,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.57,
      "end_seconds": 224.27,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.24,
      "end_seconds": 227.69,
      "duration_seconds": 1.45,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.3,
      "end_seconds": 245.46,
      "duration_seconds": 5.16,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.28,
      "end_seconds": 250.05,
      "duration_seconds": 1.77,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 272.34,
      "duration_seconds": 4.88,
      "text": "okay, so my impression is this: This looks most like simple dandruff"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.98,
      "end_seconds": 275.93,
      "duration_seconds": 1.95,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.72,
      "end_seconds": 283.82,
      "duration_seconds": 6.1,
      "text": "Nothing I've seen today points to an emergency. It looks like simple dandruff."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.64,
      "end_seconds": 311.87,
      "duration_seconds": 12.23,
      "text": "What I'm giving you is ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.71,
      "end_seconds": 314.41,
      "duration_seconds": 1.7,
      "text": "that's simple enough"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.96,
      "end_seconds": 335.14,
      "duration_seconds": 20.18,
      "text": "Leave the shampoo on for five minutes before rinsing. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again if not better in a month. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.38,
      "end_seconds": 339.61,
      "duration_seconds": 3.23,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.28,
      "end_seconds": 341.75,
      "duration_seconds": 1.47,
      "text": "All the best."
    }
  ]
}