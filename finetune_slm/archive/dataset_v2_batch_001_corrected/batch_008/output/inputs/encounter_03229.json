{
  "schema_version": "1.0",
  "encounter_id": "03229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 4.34,
      "duration_seconds": 3.39,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.24,
      "end_seconds": 9.85,
      "duration_seconds": 4.61,
      "text": "I mean, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.4,
      "end_seconds": 17.89,
      "duration_seconds": 7.49,
      "text": "Yes, that's no problem at all. Please sit. So, is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.02,
      "end_seconds": 24.75,
      "duration_seconds": 5.73,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.74,
      "end_seconds": 28.38,
      "duration_seconds": 2.64,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.72,
      "end_seconds": 33.79,
      "duration_seconds": 4.07,
      "text": "Mainly I've been feeling faint. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.69,
      "end_seconds": 37.28,
      "duration_seconds": 1.59,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.25,
      "end_seconds": 44.53,
      "duration_seconds": 5.28,
      "text": "Five days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.92,
      "end_seconds": 48.32,
      "duration_seconds": 2.4,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.59,
      "end_seconds": 52.71,
      "duration_seconds": 3.12,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.55,
      "end_seconds": 60.59,
      "duration_seconds": 3.04,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.22,
      "end_seconds": 67.25,
      "duration_seconds": 5.03,
      "text": "A seven out of ten, uh, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.32,
      "end_seconds": 70.71,
      "duration_seconds": 2.39,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.24,
      "end_seconds": 75.48,
      "duration_seconds": 3.24,
      "text": "It usually comes with shortness of breath."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 82.54,
      "duration_seconds": 6.5,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 82.64,
      "end_seconds": 88.74,
      "duration_seconds": 6.1,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 95.97,
      "duration_seconds": 2.23,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.55,
      "end_seconds": 107.16,
      "duration_seconds": 10.61,
      "text": "Ah, as for shortness of breath, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.55,
      "end_seconds": 112.24,
      "duration_seconds": 3.69,
      "text": "Right, has there been a racing heart too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.09,
      "end_seconds": 116.11,
      "duration_seconds": 2.02,
      "text": "Yes, that started yesterday."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 117.36,
      "end_seconds": 121.05,
      "duration_seconds": 3.69,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.13,
      "end_seconds": 125.48,
      "duration_seconds": 3.35,
      "text": "Did you get fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.2,
      "end_seconds": 130.72,
      "duration_seconds": 3.52,
      "text": "No, no fever, cough or leg swelling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.8,
      "end_seconds": 134.23,
      "duration_seconds": 2.43,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.57,
      "end_seconds": 137.84,
      "duration_seconds": 2.27,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.16,
      "end_seconds": 153.46,
      "duration_seconds": 2.3,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.44,
      "end_seconds": 157.46,
      "duration_seconds": 3.02,
      "text": "It's glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 162.74,
      "end_seconds": 168.35,
      "duration_seconds": 5.61,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.37,
      "end_seconds": 174.51,
      "duration_seconds": 4.14,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.58,
      "end_seconds": 189.05,
      "duration_seconds": 12.47,
      "text": "Actually, no, I left it at home. Right, you know, I'm on Tiotropium inhaler, once a day. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.95,
      "end_seconds": 192.52,
      "duration_seconds": 2.57,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.97,
      "end_seconds": 200.02,
      "duration_seconds": 4.05,
      "text": "No, you know, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.59,
      "end_seconds": 216.38,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.05,
      "end_seconds": 220.57,
      "duration_seconds": 2.52,
      "text": "Diabetes, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.27,
      "end_seconds": 223.09,
      "duration_seconds": 1.82,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.3,
      "end_seconds": 225.69,
      "duration_seconds": 1.39,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.92,
      "end_seconds": 230.03,
      "duration_seconds": 3.11,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.93,
      "end_seconds": 236.79,
      "duration_seconds": 5.86,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.79,
      "end_seconds": 242.36,
      "duration_seconds": 3.57,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.93,
      "end_seconds": 245.38,
      "duration_seconds": 2.45,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.45,
      "end_seconds": 252.35,
      "duration_seconds": 4.9,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 268.09,
      "duration_seconds": 15.08,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I'm vegetarian and have been for years. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 271.65,
      "end_seconds": 281.34,
      "duration_seconds": 9.69,
      "text": "Doctor, I've got the readings for you. Respiratory rate 16, pulse is 111 beats a minute, temperature is 36.9 degrees. BP is 102 over 56."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.13,
      "end_seconds": 285.57,
      "duration_seconds": 1.44,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.65,
      "end_seconds": 289.98,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.09,
      "end_seconds": 293.91,
      "duration_seconds": 2.82,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.58,
      "end_seconds": 320.58,
      "duration_seconds": 8.0,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.57,
      "end_seconds": 338.41,
      "duration_seconds": 11.84,
      "text": "Good, you can sit up again. Taking everything into account, this is probably possible cardiac tamponade. A heart attack is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 343.63,
      "end_seconds": 347.07,
      "duration_seconds": 3.44,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.05,
      "end_seconds": 373.47,
      "duration_seconds": 25.42,
      "text": "Right, thank you. I'll request an urgent echocardiogram, it'll help with possible tamponade. You need an urgent heart scan and possibly a drain. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 374.76,
      "end_seconds": 376.34,
      "duration_seconds": 1.58,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.34,
      "end_seconds": 386.43,
      "duration_seconds": 8.09,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.36,
      "end_seconds": 389.99,
      "duration_seconds": 1.63,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.61,
      "end_seconds": 399.74,
      "duration_seconds": 5.13,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 401.84,
      "end_seconds": 406.81,
      "duration_seconds": 4.97,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.76,
      "end_seconds": 413.56,
      "duration_seconds": 4.8,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.29,
      "end_seconds": 419.95,
      "duration_seconds": 4.66,
      "text": "Right, um, great, thank you for your help."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.93,
      "end_seconds": 422.6,
      "duration_seconds": 1.67,
      "text": "Have a good day."
    }
  ]
}