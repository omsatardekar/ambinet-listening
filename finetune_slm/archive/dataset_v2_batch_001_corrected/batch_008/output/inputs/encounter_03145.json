{
  "schema_version": "1.0",
  "encounter_id": "03145",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 5.67,
      "duration_seconds": 4.44,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.51,
      "duration_seconds": 3.82,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.57,
      "end_seconds": 16.95,
      "duration_seconds": 5.38,
      "text": "Um, so... nausea after the chemotherapy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.71,
      "end_seconds": 22.35,
      "duration_seconds": 3.64,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.56,
      "end_seconds": 38.38,
      "duration_seconds": 14.82,
      "text": "It's, It's been going on for one week. Work has been very busy so I kept ignoring it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.21,
      "end_seconds": 44.91,
      "duration_seconds": 4.7,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.84,
      "end_seconds": 50.62,
      "duration_seconds": 3.78,
      "text": "It's severe, honestly. I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.25,
      "end_seconds": 53.9,
      "duration_seconds": 2.65,
      "text": "Have you had being very tired?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.88,
      "end_seconds": 56.51,
      "duration_seconds": 1.63,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.93,
      "end_seconds": 61.38,
      "duration_seconds": 3.45,
      "text": "Any breathlessness, fever or shivering at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.81,
      "end_seconds": 67.05,
      "duration_seconds": 4.24,
      "text": "I haven't had breathlessness, fever or shivering, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.37,
      "end_seconds": 69.57,
      "duration_seconds": 1.2,
      "text": "Nothing like bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.81,
      "end_seconds": 72.4,
      "duration_seconds": 1.59,
      "text": "Nope, no bleeding."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.3,
      "end_seconds": 76.75,
      "duration_seconds": 2.45,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.9,
      "end_seconds": 80.98,
      "duration_seconds": 3.08,
      "text": "Uh, no, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.51,
      "end_seconds": 83.97,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.95,
      "end_seconds": 86.12,
      "duration_seconds": 1.17,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.01,
      "end_seconds": 108.59,
      "duration_seconds": 3.58,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.91,
      "end_seconds": 112.19,
      "duration_seconds": 2.28,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.55,
      "end_seconds": 129.38,
      "duration_seconds": 1.83,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.25,
      "end_seconds": 134.64,
      "duration_seconds": 4.39,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.48,
      "end_seconds": 140.15,
      "duration_seconds": 3.67,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 147.34,
      "duration_seconds": 3.47,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.27,
      "end_seconds": 168.41,
      "duration_seconds": 5.14,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.9,
      "end_seconds": 174.51,
      "duration_seconds": 4.61,
      "text": "Ondansetron. I take it 8 milligrams, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.38,
      "end_seconds": 178.98,
      "duration_seconds": 2.6,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.37,
      "end_seconds": 190.43,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.72,
      "end_seconds": 214.75,
      "duration_seconds": 8.03,
      "text": "Okay: saturation 97 percent, temp 36.8 degrees, pressure 123 over 68. And pulse 70, respiratory rate 16."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.5,
      "end_seconds": 218.63,
      "duration_seconds": 2.13,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.18,
      "end_seconds": 223.22,
      "duration_seconds": 4.04,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.09,
      "end_seconds": 227.07,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.68,
      "end_seconds": 229.41,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.23,
      "end_seconds": 233.22,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.99,
      "end_seconds": 254.72,
      "duration_seconds": 5.73,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.24,
      "end_seconds": 256.62,
      "duration_seconds": 1.38,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.67,
      "end_seconds": 272.38,
      "duration_seconds": 11.71,
      "text": "Thank you, you can get dressed. Taking everything into account, I can't pin this down yet. We're looking at expected chemotherapy side effects or an infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.68,
      "end_seconds": 276.93,
      "duration_seconds": 3.25,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.05,
      "end_seconds": 286.47,
      "duration_seconds": 8.42,
      "text": "I can't promise yet, but most people with expected chemotherapy side effects do well once it's treated properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.65,
      "end_seconds": 315.96,
      "duration_seconds": 15.31,
      "text": "A blood count is what I'd like next, for chemotherapy monitoring. The result will help us decide whether anything more is needed. See me again before the next cycle. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.86,
      "end_seconds": 319.69,
      "duration_seconds": 2.83,
      "text": "Great, thank you for your help."
    }
  ]
}