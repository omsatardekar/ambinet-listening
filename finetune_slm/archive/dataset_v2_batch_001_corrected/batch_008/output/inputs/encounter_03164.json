{
  "schema_version": "1.0",
  "encounter_id": "03164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.77,
      "duration_seconds": 4.22,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.27,
      "end_seconds": 9.31,
      "duration_seconds": 4.04,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 20.05,
      "duration_seconds": 5.45,
      "text": "Yeah, I wanted to get shaking chills looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.07,
      "end_seconds": 23.29,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.12,
      "end_seconds": 28.15,
      "duration_seconds": 3.03,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.85,
      "end_seconds": 34.27,
      "duration_seconds": 5.42,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.6,
      "end_seconds": 42.34,
      "duration_seconds": 6.74,
      "text": "It, It sort of comes and goes. It feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.77,
      "end_seconds": 46.58,
      "duration_seconds": 2.81,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.55,
      "end_seconds": 52.11,
      "duration_seconds": 3.56,
      "text": "Yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.82,
      "end_seconds": 55.93,
      "duration_seconds": 3.11,
      "text": "Did you get cough, rash or diarrhoea?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.36,
      "end_seconds": 64.78,
      "duration_seconds": 5.42,
      "text": "Well, I haven't had cough, rash or diarrhoea, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.92,
      "end_seconds": 68.37,
      "duration_seconds": 2.45,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.5,
      "end_seconds": 71.12,
      "duration_seconds": 1.62,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.17,
      "end_seconds": 76.3,
      "duration_seconds": 3.13,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.86,
      "end_seconds": 80.52,
      "duration_seconds": 3.66,
      "text": "Uh, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.26,
      "end_seconds": 84.46,
      "duration_seconds": 3.2,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.59,
      "end_seconds": 91.62,
      "duration_seconds": 6.03,
      "text": "Iron tablets, once a day. I'm on chemotherapy last week, recent."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.65,
      "end_seconds": 96.59,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.0,
      "end_seconds": 100.37,
      "duration_seconds": 2.37,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.28,
      "end_seconds": 108.62,
      "duration_seconds": 4.34,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.6,
      "end_seconds": 115.13,
      "duration_seconds": 4.53,
      "text": "Right, um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.11,
      "end_seconds": 127.0,
      "duration_seconds": 2.89,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.92,
      "end_seconds": 133.2,
      "duration_seconds": 4.28,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.53,
      "end_seconds": 136.49,
      "duration_seconds": 1.96,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.53,
      "end_seconds": 141.32,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.9,
      "end_seconds": 146.58,
      "duration_seconds": 3.68,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.22,
      "end_seconds": 151.78,
      "duration_seconds": 4.56,
      "text": "I have low haemoglobin, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.92,
      "end_seconds": 156.29,
      "duration_seconds": 3.37,
      "text": "Hm, okay. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.1,
      "end_seconds": 171.04,
      "duration_seconds": 2.94,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.07,
      "end_seconds": 198.42,
      "duration_seconds": 8.35,
      "text": "Okay: pulse 92, SpO2 97 percent on room air, BP is 101 over 56. And temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.48,
      "end_seconds": 204.23,
      "duration_seconds": 4.75,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.84,
      "end_seconds": 207.01,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.11,
      "end_seconds": 221.71,
      "duration_seconds": 7.6,
      "text": "You are hot, shaking and your blood pressure is low, and you had chemotherapy nine days ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.44,
      "end_seconds": 230.45,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.36,
      "end_seconds": 235.5,
      "duration_seconds": 2.14,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.53,
      "end_seconds": 275.48,
      "duration_seconds": 22.95,
      "text": "Right, here's what I'm thinking. This is probably neutropenic sepsis. A chest infection is also on my list. I'm sending you for urgent blood tests because of neutropenic sepsis. I'd like you to take piperacillin and tazobactam, 4.5 grams, now, single dose. That's for neutropenic sepsis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.12,
      "end_seconds": 278.2,
      "duration_seconds": 2.08,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.03,
      "end_seconds": 295.18,
      "duration_seconds": 16.15,
      "text": "This is an emergency, antibiotics are being given within the hour. The oncology team would be the right next step, I'll refer you. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.79,
      "end_seconds": 300.55,
      "duration_seconds": 3.76,
      "text": "Right, I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.2,
      "end_seconds": 309.36,
      "duration_seconds": 7.16,
      "text": "Please come and see me straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.7,
      "end_seconds": 313.53,
      "duration_seconds": 2.83,
      "text": "Well, alright, thanks, take care."
    }
  ]
}