{
  "schema_version": "1.0",
  "encounter_id": "03248",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 4.66,
      "duration_seconds": 3.34,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.75,
      "end_seconds": 7.85,
      "duration_seconds": 1.1,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.34,
      "end_seconds": 15.08,
      "duration_seconds": 1.74,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.14,
      "end_seconds": 20.09,
      "duration_seconds": 3.95,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.34,
      "end_seconds": 23.98,
      "duration_seconds": 2.64,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.94,
      "end_seconds": 34.74,
      "duration_seconds": 8.8,
      "text": "Honestly, it's a severe headache for days, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.74,
      "end_seconds": 37.75,
      "duration_seconds": 2.01,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.29,
      "end_seconds": 50.08,
      "duration_seconds": 10.79,
      "text": "Erm, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 59.73,
      "duration_seconds": 8.2,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.96,
      "end_seconds": 75.7,
      "duration_seconds": 10.74,
      "text": "It, It happens on and off. Mild, really. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.79,
      "end_seconds": 80.53,
      "duration_seconds": 2.74,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.54,
      "end_seconds": 88.77,
      "duration_seconds": 6.23,
      "text": "Double vision goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.15,
      "end_seconds": 92.58,
      "duration_seconds": 2.43,
      "text": "Has there been being sick too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.14,
      "end_seconds": 97.33,
      "duration_seconds": 3.19,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.73,
      "end_seconds": 100.75,
      "duration_seconds": 2.02,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.33,
      "end_seconds": 105.2,
      "duration_seconds": 2.87,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.87,
      "end_seconds": 110.05,
      "duration_seconds": 3.18,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.0,
      "end_seconds": 116.96,
      "duration_seconds": 5.96,
      "text": "Uh, I'd call it severe. There's drowsiness as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 130.49,
      "duration_seconds": 6.1,
      "text": "Let me check a few things. Any head injury, weakness on one side or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.55,
      "end_seconds": 135.43,
      "duration_seconds": 3.88,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.09,
      "end_seconds": 138.7,
      "duration_seconds": 2.61,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.45,
      "end_seconds": 144.03,
      "duration_seconds": 3.58,
      "text": "I mean, no problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.42,
      "end_seconds": 148.32,
      "duration_seconds": 2.9,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.79,
      "end_seconds": 152.36,
      "duration_seconds": 2.57,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.38,
      "end_seconds": 158.03,
      "duration_seconds": 3.65,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.99,
      "end_seconds": 162.79,
      "duration_seconds": 3.8,
      "text": "Um, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.85,
      "end_seconds": 167.69,
      "duration_seconds": 2.84,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.85,
      "end_seconds": 173.78,
      "duration_seconds": 4.93,
      "text": "I, I have COPD. I've had migraines, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.01,
      "end_seconds": 175.82,
      "duration_seconds": 0.81,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.66,
      "end_seconds": 205.78,
      "duration_seconds": 29.12,
      "text": "High blood pressure, for nearly five years. Sorry, I know I'm rambling a bit. I'd rather not end up on lots of tablets if I can avoid it. Let me think, I've had heart disease, yes. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.19,
      "end_seconds": 215.95,
      "duration_seconds": 8.76,
      "text": "Yes. Alright, migraines and high blood pressure, that matches what I have here. What do you do during the day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.68,
      "end_seconds": 221.53,
      "duration_seconds": 3.85,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 225.44,
      "duration_seconds": 2.34,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.51,
      "end_seconds": 230.81,
      "duration_seconds": 4.3,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.55,
      "end_seconds": 235.51,
      "duration_seconds": 2.96,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.81,
      "end_seconds": 240.74,
      "duration_seconds": 3.93,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.97,
      "end_seconds": 261.79,
      "duration_seconds": 3.82,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.21,
      "end_seconds": 269.2,
      "duration_seconds": 5.99,
      "text": "Oh, my mother had a stroke. Actually, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 281.14,
      "duration_seconds": 2.98,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.9,
      "end_seconds": 286.88,
      "duration_seconds": 3.98,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.62,
      "end_seconds": 296.38,
      "duration_seconds": 7.76,
      "text": "Are you taking anything regularly, including from the pharmacy? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.76,
      "end_seconds": 308.56,
      "duration_seconds": 10.8,
      "text": "Tiotropium inhaler, once a day for my chest. Uh, you know, I'm on propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.55,
      "end_seconds": 312.39,
      "duration_seconds": 2.84,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.66,
      "end_seconds": 331.37,
      "duration_seconds": 17.71,
      "text": "Six months now. Valsartan, 80 milligrams, once a day for my blood pressure. I mean, I do miss it now and then, to be fair. I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.09,
      "end_seconds": 335.71,
      "duration_seconds": 2.62,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.15,
      "end_seconds": 348.32,
      "duration_seconds": 2.17,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.47,
      "end_seconds": 367.67,
      "duration_seconds": 10.2,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 14, BP is 168 over 88, temperature is 36.8 degrees, heart rate 86."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.42,
      "end_seconds": 374.9,
      "duration_seconds": 4.48,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.94,
      "end_seconds": 379.04,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.27,
      "end_seconds": 396.37,
      "duration_seconds": 4.1,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.87,
      "end_seconds": 411.95,
      "duration_seconds": 11.08,
      "text": "All finished, thank you. Okay, so my impression is this: My working impression is possible cerebral venous thrombosis. Raised pressure in the head is still possible."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 417.37,
      "end_seconds": 420.33,
      "duration_seconds": 2.96,
      "text": "Right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 422.02,
      "end_seconds": 443.04,
      "duration_seconds": 21.02,
      "text": "I can't promise yet, but most people with possible cerebral venous thrombosis do well once it's treated properly. Let me repeat that back to make sure. You've had a severe headache for days, mild, and no fever or weakness on one side."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 444.98,
      "end_seconds": 445.68,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.89,
      "end_seconds": 451.7,
      "duration_seconds": 4.81,
      "text": "We should do an MRI of the head for papilloedema."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 452.65,
      "end_seconds": 454.96,
      "duration_seconds": 2.31,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 456.91,
      "end_seconds": 488.91,
      "duration_seconds": 32.0,
      "text": "Let's get an urgent CT venogram, for possible venous thrombosis. That will help us see what's going on underneath and decide the next step. Stop the pill, you need an urgent scan and admission. We'll refer you to the neurology team. One warning sign to remember: the symptoms get worse. In that case don't wait. Let's plan a check straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 490.95,
      "end_seconds": 496.09,
      "duration_seconds": 5.14,
      "text": "So, okay, that makes sense. Thanks for explaining."
    }
  ]
}