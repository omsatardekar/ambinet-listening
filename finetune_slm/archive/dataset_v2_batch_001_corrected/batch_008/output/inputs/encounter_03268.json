{
  "schema_version": "1.0",
  "encounter_id": "03268",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.61,
      "duration_seconds": 5.02,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.65,
      "end_seconds": 11.12,
      "duration_seconds": 4.47,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.55,
      "end_seconds": 29.74,
      "duration_seconds": 17.19,
      "text": "Doctor, it's a cough that eases on holiday. It's getting on my nerves now. My family kept telling me to get it checked. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.91,
      "end_seconds": 34.23,
      "duration_seconds": 3.32,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.33,
      "end_seconds": 38.0,
      "duration_seconds": 2.67,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.58,
      "end_seconds": 42.96,
      "duration_seconds": 3.38,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.61,
      "end_seconds": 49.02,
      "duration_seconds": 5.41,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.87,
      "end_seconds": 52.88,
      "duration_seconds": 2.01,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.63,
      "end_seconds": 70.04,
      "duration_seconds": 15.41,
      "text": "It usually comes with a tight chest at work. The tight chest at work? That's been since last night. About tight chest at work, honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.71,
      "end_seconds": 93.73,
      "duration_seconds": 5.02,
      "text": "Have you noticed ankle swelling, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.51,
      "end_seconds": 96.96,
      "duration_seconds": 2.45,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.0,
      "end_seconds": 102.16,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 105.3,
      "duration_seconds": 1.94,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.16,
      "end_seconds": 109.98,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.59,
      "end_seconds": 113.65,
      "duration_seconds": 3.06,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.79,
      "end_seconds": 118.24,
      "duration_seconds": 3.45,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.37,
      "end_seconds": 121.02,
      "duration_seconds": 1.65,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.76,
      "end_seconds": 123.98,
      "duration_seconds": 2.22,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.58,
      "end_seconds": 129.24,
      "duration_seconds": 3.66,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.57,
      "end_seconds": 133.19,
      "duration_seconds": 2.62,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.64,
      "end_seconds": 138.99,
      "duration_seconds": 4.35,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.8,
      "end_seconds": 150.03,
      "duration_seconds": 5.23,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.04,
      "end_seconds": 153.67,
      "duration_seconds": 2.63,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.21,
      "end_seconds": 158.0,
      "duration_seconds": 3.79,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.81,
      "end_seconds": 162.98,
      "duration_seconds": 3.17,
      "text": "It's a reliever inhaler, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.83,
      "end_seconds": 168.78,
      "duration_seconds": 1.95,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.65,
      "end_seconds": 171.68,
      "duration_seconds": 1.03,
      "text": "100 micrograms."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.11,
      "end_seconds": 175.97,
      "duration_seconds": 3.86,
      "text": "Mm-hmm. Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.1,
      "end_seconds": 191.46,
      "duration_seconds": 2.36,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 212.0,
      "duration_seconds": 9.0,
      "text": "Okay: pulse 72, pressure 108 over 77, oxygen saturation is 97 percent. And respiratory rate 18, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.51,
      "end_seconds": 220.0,
      "duration_seconds": 5.49,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.07,
      "end_seconds": 228.68,
      "duration_seconds": 1.61,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.67,
      "end_seconds": 231.97,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.26,
      "end_seconds": 254.09,
      "duration_seconds": 5.83,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.68,
      "end_seconds": 262.16,
      "duration_seconds": 2.48,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.17,
      "end_seconds": 289.05,
      "duration_seconds": 8.88,
      "text": "Having listened and examined, I don't have a clear answer today: occupational asthma is possible, and so is COPD."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.4,
      "end_seconds": 292.7,
      "duration_seconds": 2.3,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.57,
      "end_seconds": 303.04,
      "duration_seconds": 8.47,
      "text": "It's reasonable to be concerned, but right now occupational asthma is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.33,
      "end_seconds": 327.2,
      "duration_seconds": 16.87,
      "text": "Spirometry is what I'd like next, for wheeze. I'm prescribing beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma. Record peak flows at work and at home for four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.59,
      "end_seconds": 330.31,
      "duration_seconds": 1.72,
      "text": "That's clear, thanks."
    }
  ]
}