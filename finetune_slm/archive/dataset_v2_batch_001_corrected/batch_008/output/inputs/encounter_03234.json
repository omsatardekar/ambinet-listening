      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.01,
      "end_seconds": 194.7,
      "duration_seconds": 2.69,
      "text": "Right, I'm just checking this side."
