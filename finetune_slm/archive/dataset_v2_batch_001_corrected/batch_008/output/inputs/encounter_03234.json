      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 187.55,
      "duration_seconds": 3.84,
      "text": "Let me look at the area, I'll be gentle."
