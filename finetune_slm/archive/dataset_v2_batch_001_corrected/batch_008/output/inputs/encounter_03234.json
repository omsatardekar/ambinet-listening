      "start_seconds": 173.65,
      "end_seconds": 181.7,
      "duration_seconds": 8.05,
      "text": "okay: temp 36.9 degrees, blood pressure 108 over 77, saturation 99 percent, pulse is 81 beats a minute"
    },
