      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.55,
      "end_seconds": 213.23,
      "duration_seconds": 6.68,
      "text": "your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow"
