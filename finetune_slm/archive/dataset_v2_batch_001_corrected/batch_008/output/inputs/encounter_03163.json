{
  "schema_version": "1.0",
  "encounter_id": "03163",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 3.85,
      "duration_seconds": 3.14,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 10.44,
      "duration_seconds": 4.91,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.05,
      "end_seconds": 20.8,
      "duration_seconds": 9.75,
      "text": "Hello, doctor. I'm here with them in case I can help. He's been having headaches most days, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.39,
      "end_seconds": 24.87,
      "duration_seconds": 2.48,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.57,
      "end_seconds": 29.71,
      "duration_seconds": 3.14,
      "text": "I get some relief from painkillers."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.56,
      "end_seconds": 34.07,
      "duration_seconds": 3.51,
      "text": "What about light sensitivity, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.13,
      "end_seconds": 37.86,
      "duration_seconds": 1.73,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.02,
      "end_seconds": 41.26,
      "duration_seconds": 2.24,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.93,
      "end_seconds": 55.89,
      "duration_seconds": 13.96,
      "text": "Mm, yes. About feeling sick, pretty moderate, if I'm being honest. I'd say all the time. And there's taking painkillers every day as well, two months now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.52,
      "end_seconds": 58.94,
      "duration_seconds": 2.42,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.45,
      "end_seconds": 67.81,
      "duration_seconds": 2.36,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.13,
      "end_seconds": 89.58,
      "duration_seconds": 8.45,
      "text": "Okay: temperature is 36.5 degrees, respiratory rate 18, blood pressure 121 over 70, pulse 73, saturation 97 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.38,
      "end_seconds": 93.03,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.32,
      "end_seconds": 96.91,
      "duration_seconds": 2.59,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.66,
      "end_seconds": 103.84,
      "duration_seconds": 4.18,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.39,
      "end_seconds": 108.32,
      "duration_seconds": 0.93,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.95,
      "end_seconds": 111.79,
      "duration_seconds": 1.84,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.81,
      "end_seconds": 126.82,
      "duration_seconds": 2.01,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.15,
      "end_seconds": 131.79,
      "duration_seconds": 2.64,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.08,
      "end_seconds": 143.33,
      "duration_seconds": 4.25,
      "text": "A few quick ones: stiff neck or visual changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.04,
      "end_seconds": 147.63,
      "duration_seconds": 2.59,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.83,
      "end_seconds": 150.5,
      "duration_seconds": 1.67,
      "text": "Any fever or weakness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.04,
      "end_seconds": 155.77,
      "duration_seconds": 3.73,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.0,
      "end_seconds": 160.99,
      "duration_seconds": 3.99,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.31,
      "end_seconds": 168.11,
      "duration_seconds": 5.8,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 172.36,
      "duration_seconds": 3.59,
      "text": "Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.55,
      "end_seconds": 175.66,
      "duration_seconds": 2.11,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.49,
      "end_seconds": 193.02,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.73,
      "end_seconds": 210.84,
      "duration_seconds": 17.11,
      "text": "Yes, erythromycin. I've no idea what the reaction was, only that I'm not supposed to have it. Yes, diclofenac. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.71,
      "end_seconds": 216.49,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.9,
      "end_seconds": 220.98,
      "duration_seconds": 3.08,
      "text": "Okay, so I've had migraines, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 225.32,
      "duration_seconds": 2.81,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.25,
      "end_seconds": 234.79,
      "duration_seconds": 7.54,
      "text": "I have acid reflux, for two years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 238.56,
      "duration_seconds": 2.68,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.47,
      "end_seconds": 249.15,
      "duration_seconds": 8.68,
      "text": "Yes, acid reflux is known to us, good to have that clear. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.15,
      "end_seconds": 254.19,
      "duration_seconds": 3.04,
      "text": "Propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 255.93,
      "end_seconds": 265.37,
      "duration_seconds": 9.44,
      "text": "Doctor, I think the last prescription for the propranolol was 80 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.21,
      "end_seconds": 271.7,
      "duration_seconds": 4.49,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.42,
      "end_seconds": 280.57,
      "duration_seconds": 7.15,
      "text": "No, I left it at home. Omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.76,
      "end_seconds": 286.25,
      "duration_seconds": 4.49,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.0,
      "end_seconds": 289.92,
      "duration_seconds": 1.92,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.53,
      "end_seconds": 296.77,
      "duration_seconds": 1.24,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.77,
      "end_seconds": 301.6,
      "duration_seconds": 3.83,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.23,
      "end_seconds": 303.45,
      "duration_seconds": 1.22,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.84,
      "end_seconds": 308.64,
      "duration_seconds": 3.8,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.08,
      "end_seconds": 313.66,
      "duration_seconds": 3.58,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.54,
      "end_seconds": 317.82,
      "duration_seconds": 3.28,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.67,
      "end_seconds": 320.84,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.21,
      "end_seconds": 325.09,
      "duration_seconds": 2.88,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.33,
      "end_seconds": 335.08,
      "duration_seconds": 8.75,
      "text": "Right, here's what I'm thinking. My working impression is medication-overuse headache on a background of migraine. Tension-type headache is still possible."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.53,
      "end_seconds": 338.79,
      "duration_seconds": 2.26,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.83,
      "end_seconds": 349.51,
      "duration_seconds": 9.68,
      "text": "I understand the worry. At the moment I'd say it's medication-overuse headache on a background of migraine, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.41,
      "end_seconds": 376.5,
      "duration_seconds": 16.09,
      "text": "Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.59,
      "end_seconds": 379.98,
      "duration_seconds": 2.39,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.77,
      "end_seconds": 385.57,
      "duration_seconds": 3.8,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.15,
      "end_seconds": 390.3,
      "duration_seconds": 3.15,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.14,
      "end_seconds": 393.55,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
}