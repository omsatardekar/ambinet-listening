{
  "schema_version": "1.0",
  "encounter_id": "03186",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 3.91,
      "duration_seconds": 2.6,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.3,
      "end_seconds": 8.31,
      "duration_seconds": 3.01,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.32,
      "end_seconds": 11.56,
      "duration_seconds": 1.24,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.15,
      "end_seconds": 15.74,
      "duration_seconds": 3.59,
      "text": "It's a sudden severe tummy pain, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.51,
      "end_seconds": 19.74,
      "duration_seconds": 3.23,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.34,
      "end_seconds": 25.59,
      "duration_seconds": 2.25,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.83,
      "end_seconds": 30.04,
      "duration_seconds": 4.21,
      "text": "I see, go ahead is it worse at certain times?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.76,
      "end_seconds": 33.55,
      "duration_seconds": 1.79,
      "text": "It's worse with movement."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.44,
      "end_seconds": 40.05,
      "duration_seconds": 4.61,
      "text": "What about pain spreading all over, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.12,
      "end_seconds": 43.24,
      "duration_seconds": 1.12,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.3,
      "end_seconds": 49.06,
      "duration_seconds": 4.76,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.57,
      "end_seconds": 53.77,
      "duration_seconds": 4.2,
      "text": "I've had an irregular heartbeat for five years now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.99,
      "end_seconds": 55.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 74.12,
      "duration_seconds": 3.98,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.76,
      "end_seconds": 83.98,
      "duration_seconds": 8.22,
      "text": "Apixaban, 5 milligrams, twice a day. Ibuprofen i take it 600 milligrams, three times a day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 95.76,
      "duration_seconds": 1.92,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.36,
      "end_seconds": 98.97,
      "duration_seconds": 2.61,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.51,
      "end_seconds": 100.76,
      "duration_seconds": 1.25,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 104.67,
      "duration_seconds": 2.79,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.57,
      "end_seconds": 110.18,
      "duration_seconds": 3.61,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.72,
      "end_seconds": 115.55,
      "duration_seconds": 3.83,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.19,
      "end_seconds": 122.28,
      "duration_seconds": 5.09,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.15,
      "end_seconds": 126.52,
      "duration_seconds": 2.37,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 130.35,
      "duration_seconds": 2.12,
      "text": "Did you notice any diarrhoea?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.67,
      "end_seconds": 134.69,
      "duration_seconds": 3.02,
      "text": "Not that I've noticed, no diarrhoea."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.41,
      "end_seconds": 143.78,
      "duration_seconds": 4.37,
      "text": "have you had any blood in the vomit or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.42,
      "end_seconds": 148.96,
      "duration_seconds": 3.54,
      "text": "mm, no, I'd have said so"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.07,
      "end_seconds": 152.46,
      "duration_seconds": 2.39,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.84,
      "end_seconds": 154.82,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.53,
      "end_seconds": 161.23,
      "duration_seconds": 2.7,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.01,
      "end_seconds": 164.82,
      "duration_seconds": 1.81,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.96,
      "end_seconds": 178.39,
      "duration_seconds": 2.43,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.65,
      "end_seconds": 192.04,
      "duration_seconds": 2.39,
      "text": "sit still for a a moment.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.39,
      "end_seconds": 215.49,
      "duration_seconds": 7.1,
      "text": "okay: blood pressure 129 over 76, respiratory rate 16, pulse 119, saturation 96 percent"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.8,
      "end_seconds": 220.47,
      "duration_seconds": 2.67,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.74,
      "end_seconds": 222.81,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.2,
      "end_seconds": 226.63,
      "duration_seconds": 2.43,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 243.87,
      "duration_seconds": 6.96,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 255.08,
      "duration_seconds": 7.19,
      "text": "Thank you, you can get dressed. Having listened and examined, I'd lean towards a perforated stomach ulcer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.41,
      "end_seconds": 257.85,
      "duration_seconds": 1.44,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.8,
      "end_seconds": 270.86,
      "duration_seconds": 8.06,
      "text": "I can't promise yet, but most people with a perforated stomach ulcer do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.33,
      "end_seconds": 292.58,
      "duration_seconds": 12.25,
      "text": "I'd like to arrange urgent blood tests for acute abdomen. Nothing to eat or drink, you need an operation urgently. I think the surgical team should see you too."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.67,
      "end_seconds": 294.37,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.15,
      "end_seconds": 309.56,
      "duration_seconds": 13.41,
      "text": "The thing that would worry me is if the symptoms get worse. If that that happens, go to emergency. Let's review you straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.3,
      "end_seconds": 314.34,
      "duration_seconds": 3.04,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}