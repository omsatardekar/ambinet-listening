{
  "schema_version": "1.0",
  "encounter_id": "03086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.78,
      "end_seconds": 3.91,
      "duration_seconds": 3.13,
      "text": "Okay, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.08,
      "end_seconds": 12.04,
      "duration_seconds": 6.96,
      "text": "Hello, um, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.33,
      "end_seconds": 18.78,
      "duration_seconds": 5.45,
      "text": "Good, that'll be useful. Pull up a chair. What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 20.59,
      "end_seconds": 29.05,
      "duration_seconds": 8.46,
      "text": "Yeah, doctor, it's sudden severe pain in the lower tummy. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.24,
      "end_seconds": 33.74,
      "duration_seconds": 3.5,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.44,
      "end_seconds": 41.19,
      "duration_seconds": 5.75,
      "text": "Um, she takes omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.08,
      "end_seconds": 45.5,
      "duration_seconds": 3.42,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.93,
      "end_seconds": 51.75,
      "duration_seconds": 4.82,
      "text": "Yeah, um, ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.68,
      "end_seconds": 55.72,
      "duration_seconds": 2.04,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.08,
      "end_seconds": 64.76,
      "duration_seconds": 5.68,
      "text": "Shoulder tip pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.42,
      "end_seconds": 73.21,
      "duration_seconds": 7.79,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 73.31,
      "end_seconds": 78.93,
      "duration_seconds": 5.62,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.81,
      "end_seconds": 82.64,
      "duration_seconds": 2.83,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.42,
      "end_seconds": 88.76,
      "duration_seconds": 4.34,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.52,
      "end_seconds": 100.94,
      "duration_seconds": 10.42,
      "text": "Um, uh, the shoulder tip pain? That's been for two days. I've, I've had collapsing too, for four weeks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.65,
      "end_seconds": 103.86,
      "duration_seconds": 1.21,
      "text": "What about vomiting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.61,
      "end_seconds": 106.37,
      "duration_seconds": 1.76,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 107.48,
      "end_seconds": 112.43,
      "duration_seconds": 4.95,
      "text": "Actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.36,
      "end_seconds": 124.58,
      "duration_seconds": 7.22,
      "text": "Actually, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.0,
      "end_seconds": 132.84,
      "duration_seconds": 6.84,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about discharge or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.9,
      "end_seconds": 137.45,
      "duration_seconds": 2.55,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.82,
      "end_seconds": 141.35,
      "duration_seconds": 3.53,
      "text": "Right, right. Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 145.67,
      "duration_seconds": 3.17,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.03,
      "end_seconds": 150.35,
      "duration_seconds": 3.32,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.22,
      "end_seconds": 155.06,
      "duration_seconds": 3.84,
      "text": "Erm, um, no, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.36,
      "end_seconds": 158.32,
      "duration_seconds": 1.96,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.04,
      "end_seconds": 166.0,
      "duration_seconds": 5.96,
      "text": "I, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.19,
      "end_seconds": 183.47,
      "duration_seconds": 1.28,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.29,
      "end_seconds": 187.73,
      "duration_seconds": 3.44,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.95,
      "end_seconds": 192.64,
      "duration_seconds": 3.69,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.83,
      "end_seconds": 197.62,
      "duration_seconds": 3.79,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.94,
      "end_seconds": 202.08,
      "duration_seconds": 3.14,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.92,
      "end_seconds": 215.61,
      "duration_seconds": 12.69,
      "text": "Yes, acid reflux. I have migraines, for five years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.32,
      "end_seconds": 218.92,
      "duration_seconds": 1.6,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.87,
      "end_seconds": 229.62,
      "duration_seconds": 8.75,
      "text": "Yes, acid reflux is known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.14,
      "end_seconds": 242.65,
      "duration_seconds": 12.51,
      "text": "Yeah, you know, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.95,
      "end_seconds": 247.36,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.8,
      "end_seconds": 257.41,
      "duration_seconds": 8.61,
      "text": "Right, um, my daughter has type 1 diabetes. Hmm, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.63,
      "end_seconds": 271.93,
      "duration_seconds": 3.3,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.21,
      "end_seconds": 280.55,
      "duration_seconds": 2.34,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.62,
      "end_seconds": 300.09,
      "duration_seconds": 5.47,
      "text": "Okay: heart rate 112, pressure 104 over 58, saturation 99 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.17,
      "end_seconds": 304.94,
      "duration_seconds": 3.77,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.59,
      "end_seconds": 308.69,
      "duration_seconds": 2.1,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.68,
      "end_seconds": 313.51,
      "duration_seconds": 2.83,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.68,
      "end_seconds": 339.22,
      "duration_seconds": 7.54,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.9,
      "end_seconds": 358.21,
      "duration_seconds": 14.31,
      "text": "That's the examination finished. From what you've told me and what I found, it's hard to say. A ruptured ectopic pregnancy is one possibility and a ruptured ovarian cyst another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 363.56,
      "end_seconds": 367.07,
      "duration_seconds": 3.51,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.61,
      "end_seconds": 391.63,
      "duration_seconds": 19.02,
      "text": "I understand the worry. At the moment I'd say it's a ruptured ectopic pregnancy, and we'll know more once the a pregnancy test is back. I'd like to arrange a pregnancy test for collapse. Urgent blood tests is what I'd like next, for internal bleeding."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.03,
      "end_seconds": 396.05,
      "duration_seconds": 3.02,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.85,
      "end_seconds": 407.92,
      "duration_seconds": 11.07,
      "text": "I am calling the emergency team, you need an operation now. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 408.56,
      "end_seconds": 410.32,
      "duration_seconds": 1.76,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.47,
      "end_seconds": 414.03,
      "duration_seconds": 2.56,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.8,
      "end_seconds": 418.63,
      "duration_seconds": 2.83,
      "text": "Well, alright, I'll be back."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.4,
      "end_seconds": 429.15,
      "duration_seconds": 4.75,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 431.71,
      "end_seconds": 435.37,
      "duration_seconds": 3.66,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 437.07,
      "end_seconds": 438.9,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}