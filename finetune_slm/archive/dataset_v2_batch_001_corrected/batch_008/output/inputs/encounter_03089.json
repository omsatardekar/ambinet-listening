{
  "schema_version": "1.0",
  "encounter_id": "03089",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.19,
      "duration_seconds": 3.9,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.81,
      "end_seconds": 9.59,
      "duration_seconds": 3.78,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.22,
      "end_seconds": 15.67,
      "duration_seconds": 5.45,
      "text": "Um, so... bloating when I slip up. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.83,
      "end_seconds": 20.08,
      "duration_seconds": 3.25,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.94,
      "end_seconds": 32.14,
      "duration_seconds": 10.2,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.2,
      "end_seconds": 40.94,
      "duration_seconds": 7.74,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.56,
      "end_seconds": 65.38,
      "duration_seconds": 22.82,
      "text": "Yes, gluten. That makes it worse. It's moderate, honestly. Um, and a rash on my elbows as well, since this morning. About rash on my elbows, mostly moderate. Oh, uh, and mouth ulcers. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.43,
      "end_seconds": 86.23,
      "duration_seconds": 4.8,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.94,
      "end_seconds": 101.34,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.7,
      "end_seconds": 119.13,
      "duration_seconds": 5.43,
      "text": "Okay: pressure 120 over 74, oxygen saturation is 97 percent, heart rate 81."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 125.11,
      "duration_seconds": 4.37,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 128.02,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.97,
      "end_seconds": 151.16,
      "duration_seconds": 5.19,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.59,
      "end_seconds": 156.4,
      "duration_seconds": 2.81,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.21,
      "end_seconds": 176.25,
      "duration_seconds": 4.04,
      "text": "Have you had any weight loss or bone pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.17,
      "end_seconds": 180.83,
      "duration_seconds": 3.66,
      "text": "Okay, so no, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.21,
      "end_seconds": 184.88,
      "duration_seconds": 3.67,
      "text": "Yes. A few quick ones: vomiting or diarrhoea?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 190.21,
      "duration_seconds": 3.54,
      "text": "I haven't had vomiting or diarrhoea, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.3,
      "end_seconds": 196.01,
      "duration_seconds": 3.71,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.9,
      "end_seconds": 199.26,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.9,
      "end_seconds": 203.29,
      "duration_seconds": 2.39,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.21,
      "end_seconds": 205.69,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.78,
      "end_seconds": 210.74,
      "duration_seconds": 2.96,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.55,
      "end_seconds": 216.81,
      "duration_seconds": 3.26,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.62,
      "end_seconds": 221.06,
      "duration_seconds": 3.44,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.31,
      "end_seconds": 224.38,
      "duration_seconds": 2.07,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.99,
      "end_seconds": 229.07,
      "duration_seconds": 3.08,
      "text": "So, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.65,
      "end_seconds": 239.44,
      "duration_seconds": 8.79,
      "text": "I take metoprolol, 50 milligrams, twice a day. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.34,
      "end_seconds": 242.64,
      "duration_seconds": 1.3,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.46,
      "end_seconds": 247.0,
      "duration_seconds": 3.54,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.79,
      "end_seconds": 249.82,
      "duration_seconds": 2.03,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.91,
      "end_seconds": 253.78,
      "duration_seconds": 2.87,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.71,
      "end_seconds": 257.36,
      "duration_seconds": 1.65,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.93,
      "end_seconds": 261.52,
      "duration_seconds": 3.59,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.77,
      "end_seconds": 264.71,
      "duration_seconds": 1.94,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.42,
      "end_seconds": 270.37,
      "duration_seconds": 3.95,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.29,
      "end_seconds": 274.06,
      "duration_seconds": 1.77,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.12,
      "end_seconds": 280.8,
      "duration_seconds": 4.68,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.73,
      "end_seconds": 302.65,
      "duration_seconds": 8.92,
      "text": "So where does that leave us? The most likely explanation is coeliac disease on a gluten-free diet with some accidental exposure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.66,
      "end_seconds": 307.48,
      "duration_seconds": 2.82,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.97,
      "end_seconds": 328.79,
      "duration_seconds": 16.82,
      "text": "Nothing I've seen today points to an emergency. It looks like coeliac disease on a gluten-free diet with some accidental exposure, but I'd like to confirm. I think coeliac antibodies makes sense here, for coeliac follow-up."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 330.71,
      "end_seconds": 334.86,
      "duration_seconds": 4.15,
      "text": "We have a slot Wednesday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.43,
      "end_seconds": 357.28,
      "duration_seconds": 21.85,
      "text": "I think a blood count makes sense here, for coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. We'll refer you to the dietitian. I'd like to see you again in twelve months. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.19,
      "end_seconds": 362.09,
      "duration_seconds": 2.9,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.08,
      "end_seconds": 365.94,
      "duration_seconds": 1.86,
      "text": "Alright, look after yourself."
    }
  ]
}