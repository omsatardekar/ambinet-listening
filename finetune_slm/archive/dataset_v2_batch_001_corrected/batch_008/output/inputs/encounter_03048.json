{
  "schema_version": "1.0",
  "encounter_id": "03048",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 6.45,
      "duration_seconds": 5.42,
      "text": "well, um, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 11.85,
      "duration_seconds": 4.85,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.92,
      "end_seconds": 19.57,
      "duration_seconds": 5.65,
      "text": "doctor, um, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.43,
      "end_seconds": 24.12,
      "duration_seconds": 3.69,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.14,
      "end_seconds": 34.35,
      "duration_seconds": 8.21,
      "text": "it's stiffness putting on socks. I thought I'd wait, you know, but it hasn't gone"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 38.46,
      "duration_seconds": 3.42,
      "text": "So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.27,
      "end_seconds": 42.35,
      "duration_seconds": 3.08,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.9,
      "end_seconds": 46.3,
      "duration_seconds": 2.4,
      "text": "Has there been night pain too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.36,
      "end_seconds": 79.58,
      "duration_seconds": 31.22,
      "text": "Yes, about the same, three days. With night pain, I'd give it a three, out of ten. Okay, so as for pain in my groin and hip, I honestly can't say when that began. It might have been last month or the month before. About pain in my groin and hip, it feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.25,
      "end_seconds": 98.64,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.8,
      "end_seconds": 108.33,
      "duration_seconds": 2.53,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.59,
      "end_seconds": 127.77,
      "duration_seconds": 7.18,
      "text": "Okay: temp 36.7 degrees, pressure 122 over 69, respiratory rate 18, saturation 98 percent, pulse 85."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.53,
      "end_seconds": 131.08,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.62,
      "end_seconds": 135.38,
      "duration_seconds": 2.76,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.4,
      "end_seconds": 140.79,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 144.39,
      "duration_seconds": 2.62,
      "text": "so, raise your arm for me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 168.58,
      "duration_seconds": 6.42,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.63,
      "end_seconds": 171.03,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.04,
      "end_seconds": 180.54,
      "duration_seconds": 5.5,
      "text": "Alright, all finished, thank you. A few quick ones: fever, numbness or fall?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 184.27,
      "duration_seconds": 1.99,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.83,
      "end_seconds": 188.28,
      "duration_seconds": 2.45,
      "text": "have you had any weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.89,
      "end_seconds": 194.45,
      "duration_seconds": 4.56,
      "text": "Hmm, no, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.42,
      "end_seconds": 202.21,
      "duration_seconds": 2.79,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.89,
      "end_seconds": 204.98,
      "duration_seconds": 2.09,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.13,
      "end_seconds": 210.06,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.98,
      "end_seconds": 214.84,
      "duration_seconds": 3.86,
      "text": "I've, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.86,
      "end_seconds": 217.23,
      "duration_seconds": 1.37,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.92,
      "end_seconds": 223.43,
      "duration_seconds": 5.51,
      "text": "uh, I've had heart failure for about a year now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.94,
      "end_seconds": 233.22,
      "duration_seconds": 8.28,
      "text": "Okay, I can see heart failure in your file as well. Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.33,
      "end_seconds": 240.55,
      "duration_seconds": 3.22,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.1,
      "end_seconds": 244.06,
      "duration_seconds": 1.96,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.59,
      "end_seconds": 249.34,
      "duration_seconds": 3.75,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.41,
      "end_seconds": 255.73,
      "duration_seconds": 4.32,
      "text": "so, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.9,
      "end_seconds": 260.54,
      "duration_seconds": 3.64,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.0,
      "end_seconds": 276.95,
      "duration_seconds": 2.95,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.48,
      "end_seconds": 281.35,
      "duration_seconds": 2.87,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.07,
      "end_seconds": 287.8,
      "duration_seconds": 4.73,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.72,
      "end_seconds": 299.96,
      "duration_seconds": 11.24,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain. Furosemide. I take it 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 301.46,
      "end_seconds": 310.84,
      "duration_seconds": 9.38,
      "text": "oh, doctor, I think the last prescription for the furosemide was 20 milligrams we changed it it at the last visit"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.42,
      "end_seconds": 316.35,
      "duration_seconds": 4.93,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.04,
      "end_seconds": 322.07,
      "duration_seconds": 4.03,
      "text": "I don't think I have it with me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.64,
      "end_seconds": 327.31,
      "duration_seconds": 4.67,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.63,
      "end_seconds": 332.23,
      "duration_seconds": 3.6,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.93,
      "end_seconds": 343.42,
      "duration_seconds": 9.49,
      "text": "So, based on the history and the examination, it fits best with hip osteoarthritis. A back problem is still possible."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.38,
      "end_seconds": 347.29,
      "duration_seconds": 1.91,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.21,
      "end_seconds": 366.23,
      "duration_seconds": 17.02,
      "text": "Nothing I've seen today points to an emergency. It looks like hip osteoarthritis, but I'd like to confirm. Let me repeat that back to make sure. You've had stiffness putting on socks, severe, and no fall or weight loss."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.02,
      "end_seconds": 370.19,
      "duration_seconds": 2.17,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.42,
      "end_seconds": 390.2,
      "duration_seconds": 5.78,
      "text": "An X-ray of the hips is what I'd like next, for hip pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.85,
      "end_seconds": 393.69,
      "duration_seconds": 2.84,
      "text": "When would that that take place?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.36,
      "end_seconds": 403.32,
      "duration_seconds": 8.96,
      "text": "I'll start you on naproxen, 250 milligrams, twice a day with food, two weeks. That should help with hip pain"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.99,
      "end_seconds": 408.22,
      "duration_seconds": 1.23,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.11,
      "end_seconds": 439.19,
      "duration_seconds": 29.08,
      "text": "Use a walking stick in the left hand and do gentle strengthening exercises. We'll refer you to the orthopaedic clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the symptoms get worse. We'll catch up in six weeks. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.41,
      "end_seconds": 451.05,
      "duration_seconds": 10.64,
      "text": "So, I take the naproxen, 250 milligrams, twice a day with food and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.35,
      "end_seconds": 456.3,
      "duration_seconds": 3.95,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.14,
      "end_seconds": 460.65,
      "duration_seconds": 3.51,
      "text": "thank you, um, doctor, goodbye"
    }
  ]
}