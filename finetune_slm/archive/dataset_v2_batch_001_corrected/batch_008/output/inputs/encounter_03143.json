{
  "schema_version": "1.0",
  "encounter_id": "03143",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 6.66,
      "duration_seconds": 5.85,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.95,
      "end_seconds": 12.09,
      "duration_seconds": 4.14,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.79,
      "end_seconds": 18.09,
      "duration_seconds": 5.3,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 23.54,
      "duration_seconds": 4.08,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.59,
      "end_seconds": 30.37,
      "duration_seconds": 5.78,
      "text": "Doctor, it's darker skin. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.36,
      "end_seconds": 34.41,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.71,
      "end_seconds": 47.8,
      "duration_seconds": 12.09,
      "text": "He takes atorvastatin, 20 milligrams, at night. He takes hydrocortisone cream, when needed for the eczema. Erm, he takes escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 51.22,
      "duration_seconds": 2.8,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.78,
      "end_seconds": 70.48,
      "duration_seconds": 17.7,
      "text": "When it starts I tend to get dizziness on standing as well. Oh, and I've been feeling tired and weak as well, since last weekend. About dizziness on standing, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.82,
      "end_seconds": 76.17,
      "duration_seconds": 4.35,
      "text": "Have you had any vomiting, severe tummy pain or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.95,
      "end_seconds": 80.25,
      "duration_seconds": 2.3,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.63,
      "end_seconds": 85.04,
      "duration_seconds": 3.41,
      "text": "Right, have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.87,
      "end_seconds": 90.81,
      "duration_seconds": 3.94,
      "text": "Well, not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 92.77,
      "end_seconds": 97.6,
      "duration_seconds": 4.83,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.58,
      "end_seconds": 106.29,
      "duration_seconds": 7.71,
      "text": "No, um, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.29,
      "end_seconds": 115.68,
      "duration_seconds": 7.39,
      "text": "Alright, I'll note both what you've said and what you've noticed. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.21,
      "end_seconds": 118.96,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.94,
      "end_seconds": 123.41,
      "duration_seconds": 2.47,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.46,
      "end_seconds": 129.08,
      "duration_seconds": 3.62,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.67,
      "end_seconds": 139.2,
      "duration_seconds": 4.53,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.22,
      "end_seconds": 143.26,
      "duration_seconds": 3.04,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.68,
      "end_seconds": 149.31,
      "duration_seconds": 4.63,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.2,
      "end_seconds": 160.83,
      "duration_seconds": 9.63,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.27,
      "end_seconds": 174.73,
      "duration_seconds": 1.46,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.34,
      "end_seconds": 179.9,
      "duration_seconds": 3.56,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.29,
      "end_seconds": 183.71,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.95,
      "end_seconds": 189.03,
      "duration_seconds": 4.08,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 192.66,
      "duration_seconds": 2.49,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.34,
      "end_seconds": 197.65,
      "duration_seconds": 3.31,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 212.8,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.49,
      "end_seconds": 223.0,
      "duration_seconds": 8.51,
      "text": "I have high cholesterol. I've had eczema, yes. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.84,
      "end_seconds": 225.59,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.46,
      "end_seconds": 233.9,
      "duration_seconds": 6.44,
      "text": "I've had anxiety, yes. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.58,
      "end_seconds": 239.73,
      "duration_seconds": 5.15,
      "text": "Yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 241.59,
      "end_seconds": 250.91,
      "duration_seconds": 9.32,
      "text": "Okay, so the vitals from earlier. Heart rate 99, pressure 92 over 63, temperature is 36.6 degrees, respiratory rate 19."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.47,
      "end_seconds": 252.17,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.27,
      "end_seconds": 256.48,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.48,
      "end_seconds": 261.44,
      "duration_seconds": 2.96,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.48,
      "end_seconds": 283.9,
      "duration_seconds": 9.42,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 292.08,
      "duration_seconds": 2.55,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.43,
      "end_seconds": 318.39,
      "duration_seconds": 11.96,
      "text": "So, based on the history and the examination, I can't pin this down yet. We're looking at possible adrenal insufficiency or an underactive thyroid."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.84,
      "end_seconds": 321.3,
      "duration_seconds": 1.46,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.27,
      "end_seconds": 338.37,
      "duration_seconds": 16.1,
      "text": "It's reasonable to be concerned, but right now possible adrenal insufficiency is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had darker skin, and no fainting."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.08,
      "end_seconds": 339.78,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.4,
      "end_seconds": 346.38,
      "duration_seconds": 4.98,
      "text": "I want blood tests done, that's for possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 348.44,
      "end_seconds": 350.76,
      "duration_seconds": 2.32,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.46,
      "end_seconds": 380.53,
      "duration_seconds": 28.07,
      "text": "Let's book a short synacthen test to look into possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I think the endocrine clinic should see you too. If the symptoms get worse, that's the point to come in urgently. We'll catch up after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 381.92,
      "end_seconds": 386.83,
      "duration_seconds": 4.91,
      "text": "Right, um, I'll do that. Thank you, doctor."
    }
  ]
}