{
  "schema_version": "1.0",
  "encounter_id": "03341",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.23,
      "duration_seconds": 3.28,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 10.0,
      "duration_seconds": 4.18,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.41,
      "end_seconds": 16.38,
      "duration_seconds": 4.97,
      "text": "I wanted to get bloating when I slip up looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.06,
      "end_seconds": 23.47,
      "duration_seconds": 3.41,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.99,
      "end_seconds": 26.62,
      "duration_seconds": 2.63,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.55,
      "end_seconds": 37.13,
      "duration_seconds": 9.58,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.9,
      "end_seconds": 42.98,
      "duration_seconds": 5.08,
      "text": "I'd call it moderate. Gluten definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.57,
      "end_seconds": 45.82,
      "duration_seconds": 2.25,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 59.33,
      "duration_seconds": 12.07,
      "text": "A rash on my elbows goes along with it, most of the time. The rash on my elbows? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.67,
      "end_seconds": 64.8,
      "duration_seconds": 5.13,
      "text": "Yes, carry on. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.67,
      "end_seconds": 79.97,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.66,
      "end_seconds": 107.1,
      "duration_seconds": 6.44,
      "text": "Okay: weight 84 kilos, pressure 110 over 79, height 156 centimetres, heart rate 84."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.78,
      "end_seconds": 110.84,
      "duration_seconds": 2.06,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.52,
      "end_seconds": 113.43,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.84,
      "end_seconds": 116.49,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.0,
      "end_seconds": 132.9,
      "duration_seconds": 4.9,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.38,
      "end_seconds": 144.03,
      "duration_seconds": 5.65,
      "text": "Okay, that's enough for me. Have you had any diarrhoea or bone pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.94,
      "end_seconds": 150.58,
      "duration_seconds": 4.64,
      "text": "No, uh, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 155.97,
      "duration_seconds": 4.94,
      "text": "Sure. Let me check a few things. Any weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.52,
      "end_seconds": 159.96,
      "duration_seconds": 3.44,
      "text": "Oh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 165.26,
      "duration_seconds": 3.23,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.34,
      "end_seconds": 169.58,
      "duration_seconds": 2.24,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.5,
      "end_seconds": 191.44,
      "duration_seconds": 3.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.54,
      "end_seconds": 200.48,
      "duration_seconds": 6.94,
      "text": "Mm, I've had gout for five years now. High cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.65,
      "end_seconds": 203.88,
      "duration_seconds": 2.23,
      "text": "Alright, is there anything more?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.04,
      "end_seconds": 213.83,
      "duration_seconds": 8.79,
      "text": "Yes, gout is known to us, good to have that clear. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.83,
      "end_seconds": 219.16,
      "duration_seconds": 3.33,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.03,
      "end_seconds": 236.0,
      "duration_seconds": 4.97,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.47,
      "end_seconds": 246.5,
      "duration_seconds": 9.03,
      "text": "Febuxostat, 80 milligrams, once a day. Rosuvastatin. I take it 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.24,
      "end_seconds": 253.07,
      "duration_seconds": 4.83,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.1,
      "end_seconds": 257.18,
      "duration_seconds": 2.08,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.79,
      "end_seconds": 259.49,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.7,
      "end_seconds": 263.2,
      "duration_seconds": 2.5,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.23,
      "end_seconds": 266.58,
      "duration_seconds": 1.35,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.5,
      "end_seconds": 271.94,
      "duration_seconds": 4.44,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.95,
      "end_seconds": 276.33,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.93,
      "end_seconds": 281.02,
      "duration_seconds": 4.09,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.2,
      "end_seconds": 285.47,
      "duration_seconds": 3.27,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.05,
      "end_seconds": 289.43,
      "duration_seconds": 2.38,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.03,
      "end_seconds": 304.16,
      "duration_seconds": 10.13,
      "text": "So, based on the history and the examination, the most likely explanation is coeliac disease on a gluten-free diet with some accidental exposure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.61,
      "end_seconds": 308.55,
      "duration_seconds": 2.94,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.18,
      "end_seconds": 321.2,
      "duration_seconds": 11.02,
      "text": "It's reasonable to be concerned, but right now coeliac disease on a gluten-free diet with some accidental exposure is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.2,
      "end_seconds": 342.93,
      "duration_seconds": 8.73,
      "text": "I'm going to order coeliac antibodies, for coeliac follow-up. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 346.71,
      "end_seconds": 351.01,
      "duration_seconds": 4.3,
      "text": "I can book that for Monday at 3:30 pm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.84,
      "end_seconds": 353.82,
      "duration_seconds": 1.98,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.19,
      "end_seconds": 373.39,
      "duration_seconds": 18.2,
      "text": "Let's book a blood count to look into coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.22,
      "end_seconds": 375.23,
      "duration_seconds": 1.01,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.43,
      "end_seconds": 384.22,
      "duration_seconds": 7.79,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.92,
      "end_seconds": 386.43,
      "duration_seconds": 1.51,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.17,
      "end_seconds": 392.35,
      "duration_seconds": 4.18,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.22,
      "end_seconds": 397.09,
      "duration_seconds": 3.87,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.78,
      "end_seconds": 401.0,
      "duration_seconds": 1.22,
      "text": "Look after yourself."
    }
  ]
}