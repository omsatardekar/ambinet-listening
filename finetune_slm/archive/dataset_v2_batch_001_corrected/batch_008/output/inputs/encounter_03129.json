{
  "schema_version": "1.0",
  "encounter_id": "03129",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.31,
      "end_seconds": 7.95,
      "duration_seconds": 6.64,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.82,
      "end_seconds": 13.79,
      "duration_seconds": 4.97,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.1,
      "end_seconds": 22.31,
      "duration_seconds": 5.21,
      "text": "Oh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.32,
      "end_seconds": 28.76,
      "duration_seconds": 3.44,
      "text": "good, that'll be useful pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.82,
      "end_seconds": 37.43,
      "duration_seconds": 4.61,
      "text": "Erm, I'm here because of a severe headache for days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.56,
      "end_seconds": 41.83,
      "duration_seconds": 3.27,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 48.05,
      "duration_seconds": 5.39,
      "text": "it's, It's Thyronorm, 50 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 49.77,
      "end_seconds": 54.26,
      "duration_seconds": 4.49,
      "text": "Doctor, our chart from the last visit lists it as 25 micrograms."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.87,
      "end_seconds": 57.84,
      "duration_seconds": 2.97,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.93,
      "end_seconds": 67.0,
      "duration_seconds": 8.07,
      "text": "uh, no, I left it at home. Tiotropium inhaler, once a day for my chest"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.29,
      "end_seconds": 76.7,
      "duration_seconds": 8.41,
      "text": "Ah, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 80.71,
      "duration_seconds": 2.66,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.67,
      "end_seconds": 94.59,
      "duration_seconds": 11.92,
      "text": "For my cholesterol, I believe. My son sets them out for me, I just take what I'm given. I'm on the contraceptive pill, daily."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.43,
      "end_seconds": 97.97,
      "duration_seconds": 2.54,
      "text": "right, when did you start it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.07,
      "end_seconds": 100.49,
      "duration_seconds": 1.42,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.18,
      "end_seconds": 112.35,
      "duration_seconds": 2.17,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.81,
      "end_seconds": 117.64,
      "duration_seconds": 3.83,
      "text": "I've had it for about four days"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.74,
      "end_seconds": 124.1,
      "duration_seconds": 5.36,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.52,
      "end_seconds": 130.78,
      "duration_seconds": 5.26,
      "text": "It's moderate, honestly. I notice it more with lying down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.55,
      "end_seconds": 138.01,
      "duration_seconds": 6.46,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 138.11,
      "end_seconds": 145.61,
      "duration_seconds": 7.5,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.56,
      "end_seconds": 152.49,
      "duration_seconds": 3.93,
      "text": "Later, thanks. Please go on. Any drowsiness as well?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.33,
      "end_seconds": 155.73,
      "duration_seconds": 2.4,
      "text": "yes, for about four days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.09,
      "end_seconds": 160.58,
      "duration_seconds": 3.49,
      "text": "okay, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.48,
      "end_seconds": 166.55,
      "duration_seconds": 5.07,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.33,
      "end_seconds": 174.73,
      "duration_seconds": 6.4,
      "text": "Have you had a severe headache for days before, or is this the first time?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.46,
      "end_seconds": 181.15,
      "duration_seconds": 5.69,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.69,
      "end_seconds": 188.58,
      "duration_seconds": 5.89,
      "text": "Alright, a few quick ones: fever, weakness on one side or head injury?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.4,
      "end_seconds": 202.3,
      "duration_seconds": 12.9,
      "text": "No, no fever, no weakness on one side, no head injury. I did have double vision at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 207.86,
      "duration_seconds": 3.71,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.81,
      "end_seconds": 211.29,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.28,
      "end_seconds": 216.17,
      "duration_seconds": 3.89,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.23,
      "end_seconds": 220.52,
      "duration_seconds": 3.29,
      "text": "I have eczema, for five years"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 223.14,
      "duration_seconds": 2.05,
      "text": "So, any other things?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.22,
      "end_seconds": 242.66,
      "duration_seconds": 17.44,
      "text": "An underactive thyroid, for nearly five years. I've had COPD, yes. It's the not knowing that gets to me. Yes, high cholesterol. Let me think, I've had gout for two years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.67,
      "end_seconds": 245.2,
      "duration_seconds": 1.53,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.07,
      "end_seconds": 255.2,
      "duration_seconds": 9.13,
      "text": "So, any allergies to tablets, food or anything in the environment? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.08,
      "end_seconds": 268.57,
      "duration_seconds": 12.49,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.48,
      "end_seconds": 284.15,
      "duration_seconds": 3.67,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.85,
      "end_seconds": 291.56,
      "duration_seconds": 6.71,
      "text": "My grandfather had a stroke. I mean, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.71,
      "end_seconds": 299.6,
      "duration_seconds": 2.89,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.61,
      "end_seconds": 304.37,
      "duration_seconds": 2.76,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.15,
      "end_seconds": 307.6,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.21,
      "end_seconds": 312.38,
      "duration_seconds": 3.17,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.09,
      "end_seconds": 319.34,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.93,
      "end_seconds": 322.0,
      "duration_seconds": 2.07,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 322.96,
      "end_seconds": 334.9,
      "duration_seconds": 11.94,
      "text": "Doctor, I've got the readings for you. Temperature 36.5, weight 84 kilos. Pulse is 84 beats a minute, pressure 144 over 99, height 151 centimetres."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.81,
      "end_seconds": 338.96,
      "duration_seconds": 2.15,
      "text": "okay, good, thank you"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.05,
      "end_seconds": 342.47,
      "duration_seconds": 2.42,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.69,
      "end_seconds": 344.93,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.92,
      "end_seconds": 361.73,
      "duration_seconds": 4.81,
      "text": "The The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.8,
      "end_seconds": 399.86,
      "duration_seconds": 35.06,
      "text": "okay, that's enough for me. From what you've told me and what I found, this looks most like possible cerebral venous thrombosis. I'd also keep raised pressure in the head in mind. We should do an MRI of the head for papilloedema. Let's book an urgent CT venogram to look into possible venous thrombosis. Stop the pill, you need an urgent scan and admission. We'll refer you to the neurology team"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.28,
      "end_seconds": 411.0,
      "duration_seconds": 9.72,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.84,
      "end_seconds": 416.3,
      "duration_seconds": 4.46,
      "text": "yes, um, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.92,
      "end_seconds": 426.34,
      "duration_seconds": 8.42,
      "text": "If the symptoms get worse, that's the point to come in urgently. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.83,
      "end_seconds": 431.87,
      "duration_seconds": 2.04,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.38,
      "end_seconds": 434.76,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}