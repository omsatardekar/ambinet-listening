{
  "schema_version": "1.0",
  "encounter_id": "03423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.11,
      "duration_seconds": 3.45,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.82,
      "end_seconds": 9.11,
      "duration_seconds": 4.29,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.84,
      "end_seconds": 15.88,
      "duration_seconds": 6.04,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.02,
      "end_seconds": 29.4,
      "duration_seconds": 12.38,
      "text": "Um, uh, so... a bit tired sometimes. That's why I came. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 30.21,
      "end_seconds": 40.28,
      "duration_seconds": 10.07,
      "text": "Doctor, I've got the readings for you. Blood pressure 121 over 78, heart rate 84, respiratory rate 16, oxygen saturation is 97 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.15,
      "end_seconds": 45.52,
      "duration_seconds": 4.37,
      "text": "Good, thank you. How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.58,
      "end_seconds": 52.1,
      "duration_seconds": 5.52,
      "text": "Mm, uh, it's been like this since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.35,
      "end_seconds": 56.94,
      "duration_seconds": 3.59,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.48,
      "end_seconds": 62.83,
      "duration_seconds": 4.35,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.91,
      "end_seconds": 68.13,
      "duration_seconds": 3.22,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.07,
      "end_seconds": 72.28,
      "duration_seconds": 3.21,
      "text": "It usually comes with brittle nails."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.74,
      "end_seconds": 79.5,
      "duration_seconds": 6.76,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 79.6,
      "end_seconds": 86.1,
      "duration_seconds": 6.5,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.38,
      "end_seconds": 89.81,
      "duration_seconds": 2.43,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.85,
      "end_seconds": 100.67,
      "duration_seconds": 9.82,
      "text": "Uh, the brittle nails? That's been since Friday. I've also had being vegetarian, for six months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.85,
      "end_seconds": 104.45,
      "duration_seconds": 2.6,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.53,
      "end_seconds": 109.52,
      "duration_seconds": 2.99,
      "text": "Uh, I'd call it moderate."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 110.27,
      "end_seconds": 114.02,
      "duration_seconds": 3.75,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 120.71,
      "duration_seconds": 5.26,
      "text": "Let me check a few things. Any heavy periods, breathlessness or black stools?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.29,
      "end_seconds": 127.94,
      "duration_seconds": 5.65,
      "text": "No, you know, no heavy periods, breathlessness or black stools."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 131.02,
      "duration_seconds": 1.63,
      "text": "Any sign of dizziness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.34,
      "end_seconds": 133.81,
      "duration_seconds": 1.47,
      "text": "Definitely no dizziness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 134.33,
      "end_seconds": 139.94,
      "duration_seconds": 5.61,
      "text": "Actually, doctor, I did notice dizziness. She doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.98,
      "end_seconds": 148.77,
      "duration_seconds": 7.79,
      "text": "Yeah, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.23,
      "end_seconds": 159.59,
      "duration_seconds": 9.36,
      "text": "Alright, I'll note both what you've said and what you've noticed. Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.61,
      "end_seconds": 162.13,
      "duration_seconds": 1.52,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.24,
      "end_seconds": 166.57,
      "duration_seconds": 3.33,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.19,
      "end_seconds": 179.55,
      "duration_seconds": 11.36,
      "text": "I used to drink heavily but I stopped four years ago. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.39,
      "end_seconds": 183.53,
      "duration_seconds": 3.14,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.59,
      "end_seconds": 187.71,
      "duration_seconds": 2.12,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.29,
      "end_seconds": 191.63,
      "duration_seconds": 1.34,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.42,
      "end_seconds": 200.6,
      "duration_seconds": 7.18,
      "text": "Mm, I've had arthritis in my knees for two years now. Yes, diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.5,
      "end_seconds": 213.02,
      "duration_seconds": 11.52,
      "text": "Right, so an underactive thyroid and arthritis in your knees are already on your record. We'll keep that in mind today. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.6,
      "end_seconds": 219.75,
      "duration_seconds": 6.15,
      "text": "My uncle has high cholesterol. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.85,
      "end_seconds": 242.06,
      "duration_seconds": 4.21,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.0,
      "end_seconds": 250.29,
      "duration_seconds": 7.29,
      "text": "Hmm, it's something called thyr... thyroxine, 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 255.48,
      "duration_seconds": 3.41,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.87,
      "end_seconds": 261.66,
      "duration_seconds": 4.79,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.75,
      "end_seconds": 272.53,
      "duration_seconds": 9.78,
      "text": "Oh, uh, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.95,
      "end_seconds": 276.9,
      "duration_seconds": 2.95,
      "text": "Right, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.21,
      "end_seconds": 297.2,
      "duration_seconds": 18.99,
      "text": "For the joint pain, I believe. My son sets them out for me, I just take what I'm given. Uh, um, I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 298.55,
      "end_seconds": 303.24,
      "duration_seconds": 4.69,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.32,
      "end_seconds": 309.11,
      "duration_seconds": 4.79,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.61,
      "end_seconds": 319.92,
      "duration_seconds": 9.31,
      "text": "Mm, not with me. I'll bring it next time. Before this I was on glibenclamide; that's been stopped."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.63,
      "end_seconds": 328.65,
      "duration_seconds": 8.02,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.37,
      "end_seconds": 339.15,
      "duration_seconds": 8.78,
      "text": "I had a reaction to amoxicillin when I was younger, hives, and I've avoided it since."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.95,
      "end_seconds": 350.18,
      "duration_seconds": 9.23,
      "text": "Going by what you've described, I think we're dealing with mildly low iron stores risk from diet at this stage."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.56,
      "end_seconds": 385.73,
      "duration_seconds": 19.17,
      "text": "Eat pulses, leafy greens and vitamin-C rich foods with meals. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again after the results."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.58,
      "end_seconds": 390.22,
      "duration_seconds": 3.64,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.22,
      "end_seconds": 396.63,
      "duration_seconds": 4.41,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.27,
      "end_seconds": 399.65,
      "duration_seconds": 2.38,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}