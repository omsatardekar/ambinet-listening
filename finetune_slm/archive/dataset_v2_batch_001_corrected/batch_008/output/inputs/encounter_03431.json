{
  "schema_version": "1.0",
  "encounter_id": "03431",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 4.19,
      "duration_seconds": 3.46,
      "text": "So, hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.21,
      "end_seconds": 8.02,
      "duration_seconds": 2.81,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.77,
      "end_seconds": 9.96,
      "duration_seconds": 1.19,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.72,
      "end_seconds": 14.52,
      "duration_seconds": 3.8,
      "text": "I'm here because of three early losses."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.07,
      "end_seconds": 21.8,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.34,
      "end_seconds": 26.98,
      "duration_seconds": 3.64,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.51,
      "end_seconds": 32.54,
      "duration_seconds": 5.03,
      "text": "I see, go ahead. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.41,
      "end_seconds": 36.22,
      "duration_seconds": 1.81,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.3,
      "end_seconds": 41.22,
      "duration_seconds": 2.92,
      "text": "Has there been irregular cycles too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.56,
      "end_seconds": 45.94,
      "duration_seconds": 3.38,
      "text": "Erm, yeah. One week, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.41,
      "end_seconds": 53.25,
      "duration_seconds": 6.84,
      "text": "I see, go ahead. Have you had three early losses before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.27,
      "end_seconds": 65.23,
      "duration_seconds": 7.96,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.88,
      "end_seconds": 67.33,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.99,
      "end_seconds": 70.7,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.71,
      "end_seconds": 74.07,
      "duration_seconds": 2.36,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.23,
      "end_seconds": 79.57,
      "duration_seconds": 4.34,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.66,
      "end_seconds": 83.14,
      "duration_seconds": 2.48,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.55,
      "end_seconds": 88.16,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.55,
      "end_seconds": 92.0,
      "duration_seconds": 2.45,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.85,
      "end_seconds": 97.69,
      "duration_seconds": 3.84,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.6,
      "end_seconds": 115.41,
      "duration_seconds": 4.81,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.34,
      "end_seconds": 125.22,
      "duration_seconds": 7.88,
      "text": "I take something called rosu... rosuvastatin, 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.51,
      "end_seconds": 130.62,
      "duration_seconds": 4.11,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.4,
      "end_seconds": 139.75,
      "duration_seconds": 8.35,
      "text": "Not with me. I'll bring it next time. I'm on folic acid, 400 micrograms, daily."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.83,
      "end_seconds": 150.61,
      "duration_seconds": 2.78,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.52,
      "end_seconds": 153.67,
      "duration_seconds": 2.15,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.74,
      "end_seconds": 158.74,
      "duration_seconds": 3.0,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.79,
      "end_seconds": 163.81,
      "duration_seconds": 4.02,
      "text": "I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.38,
      "end_seconds": 169.42,
      "duration_seconds": 4.04,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.57,
      "end_seconds": 173.24,
      "duration_seconds": 2.67,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 178.55,
      "duration_seconds": 4.58,
      "text": "Did you get clotting problem, fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.78,
      "end_seconds": 183.23,
      "duration_seconds": 3.45,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.8,
      "end_seconds": 191.04,
      "duration_seconds": 4.24,
      "text": "Alright, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.46,
      "end_seconds": 194.01,
      "duration_seconds": 1.55,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 195.4,
      "end_seconds": 213.86,
      "duration_seconds": 18.46,
      "text": "Doctor, I've got the readings for you. Height 168 centimetres, heart rate 74, SpO2 98 percent on room air, temp 36.7 degrees, blood pressure 111 over 70, BMI works out to 26.9, respiratory rate 15, weight 76 kilos."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.14,
      "end_seconds": 216.1,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.86,
      "end_seconds": 220.83,
      "duration_seconds": 1.97,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.55,
      "end_seconds": 224.55,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.12,
      "end_seconds": 241.82,
      "duration_seconds": 1.7,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.36,
      "end_seconds": 249.37,
      "duration_seconds": 2.01,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.89,
      "end_seconds": 270.23,
      "duration_seconds": 6.34,
      "text": "Having listened and examined, the most likely explanation is recurrent miscarriage needing investigation."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.98,
      "end_seconds": 275.05,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.95,
      "end_seconds": 311.64,
      "duration_seconds": 35.69,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent miscarriage needing investigation, but I'd like to confirm. We should do a pelvic ultrasound for recurrent miscarriage. I'm sending you for blood tests because of recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.73,
      "end_seconds": 314.1,
      "duration_seconds": 1.37,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.03,
      "end_seconds": 320.4,
      "duration_seconds": 2.37,
      "text": "We'll catch up after the results."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.54,
      "end_seconds": 322.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.04,
      "end_seconds": 326.59,
      "duration_seconds": 2.55,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.16,
      "end_seconds": 331.38,
      "duration_seconds": 3.22,
      "text": "I think I understand everything. Thanks."
    }
  ]
}