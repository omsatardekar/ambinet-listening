{
  "schema_version": "1.0",
  "encounter_id": "03019",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 6.39,
      "duration_seconds": 5.79,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.59,
      "end_seconds": 11.5,
      "duration_seconds": 3.91,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.46,
      "end_seconds": 17.84,
      "duration_seconds": 5.38,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.47,
      "end_seconds": 23.61,
      "duration_seconds": 4.14,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.42,
      "end_seconds": 27.95,
      "duration_seconds": 3.53,
      "text": "I've been dealing with being very tired."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.95,
      "end_seconds": 32.67,
      "duration_seconds": 3.72,
      "text": "So, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.89,
      "end_seconds": 39.08,
      "duration_seconds": 5.19,
      "text": "Probably two months. Yeah. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 43.31,
      "duration_seconds": 3.25,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.12,
      "end_seconds": 51.51,
      "duration_seconds": 3.39,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.06,
      "end_seconds": 59.84,
      "duration_seconds": 7.78,
      "text": "Oh, you know, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 59.94,
      "end_seconds": 66.97,
      "duration_seconds": 7.03,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.54,
      "end_seconds": 69.82,
      "duration_seconds": 2.28,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.5,
      "end_seconds": 73.73,
      "duration_seconds": 3.23,
      "text": "And nausea after the chemotherapy, too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.89,
      "end_seconds": 80.56,
      "duration_seconds": 5.67,
      "text": "Have you had being very tired before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.49,
      "end_seconds": 87.82,
      "duration_seconds": 5.33,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.28,
      "end_seconds": 93.25,
      "duration_seconds": 3.97,
      "text": "Did you get fever, shivering, breathlessness or bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.18,
      "end_seconds": 107.67,
      "duration_seconds": 12.49,
      "text": "No, um, no fever, no shivering, no breathlessness. I did have mouth ulcers at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.42,
      "end_seconds": 111.48,
      "duration_seconds": 2.06,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.53,
      "end_seconds": 113.62,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.13,
      "end_seconds": 119.21,
      "duration_seconds": 4.08,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.39,
      "end_seconds": 139.56,
      "duration_seconds": 19.17,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I drink a lot of tea and snack through the day. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.31,
      "end_seconds": 143.18,
      "duration_seconds": 2.87,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.15,
      "end_seconds": 148.79,
      "duration_seconds": 3.64,
      "text": "Yeah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 167.99,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.28,
      "end_seconds": 184.85,
      "duration_seconds": 15.57,
      "text": "I've, I've had anxiety for nearly five years now. Work has been very busy so I kept ignoring it. I've had depression for nearly five years now. I've got gout."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.09,
      "end_seconds": 188.42,
      "duration_seconds": 2.33,
      "text": "So, is there anything more?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.64,
      "end_seconds": 202.15,
      "duration_seconds": 8.51,
      "text": "Yes, gout is known to us, good to have that clear. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.23,
      "end_seconds": 210.93,
      "duration_seconds": 6.7,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.37,
      "end_seconds": 219.57,
      "duration_seconds": 7.2,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.32,
      "end_seconds": 224.09,
      "duration_seconds": 2.77,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.96,
      "end_seconds": 240.82,
      "duration_seconds": 14.86,
      "text": "Mm, for my mood, I believe. My daughter sets them out for me, I just take what I'm given. Allopurinol. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.45,
      "end_seconds": 246.61,
      "duration_seconds": 4.16,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.74,
      "end_seconds": 252.24,
      "duration_seconds": 4.5,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 253.93,
      "end_seconds": 261.96,
      "duration_seconds": 8.03,
      "text": "Actually, I remember he had some kind of reaction to diclofenac before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.92,
      "end_seconds": 266.13,
      "duration_seconds": 2.21,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.49,
      "end_seconds": 276.12,
      "duration_seconds": 8.63,
      "text": "Alright, so that's unclear. I'll record what each of you said. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.64,
      "end_seconds": 278.69,
      "duration_seconds": 2.05,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 291.53,
      "end_seconds": 301.01,
      "duration_seconds": 9.48,
      "text": "Doctor, I've got the readings for you. Pulse 85, temperature is 36.8 degrees. Oxygen saturation is 99 percent, blood pressure 116 over 71."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.73,
      "end_seconds": 305.08,
      "duration_seconds": 1.35,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.78,
      "end_seconds": 313.09,
      "duration_seconds": 5.31,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.67,
      "end_seconds": 315.93,
      "duration_seconds": 1.26,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.12,
      "end_seconds": 338.11,
      "duration_seconds": 4.99,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.84,
      "end_seconds": 363.74,
      "duration_seconds": 19.9,
      "text": "That's the examination finished. Taking everything into account, I don't have a clear answer today: expected chemotherapy side effects is possible, and so is an infection. Call the chemotherapy helpline straight away if your temperature goes over 37.5. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.78,
      "end_seconds": 367.12,
      "duration_seconds": 2.34,
      "text": "Thank you, that's helpful."
    }
  ]
}