{
  "schema_version": "1.0",
  "encounter_id": "03255",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 3.79,
      "duration_seconds": 3.11,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.71,
      "end_seconds": 8.99,
      "duration_seconds": 4.28,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 16.6,
      "duration_seconds": 3.74,
      "text": "Well, I've been having headaches most days."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.22,
      "end_seconds": 20.86,
      "duration_seconds": 3.64,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.16,
      "end_seconds": 29.33,
      "duration_seconds": 4.17,
      "text": "I take propranolol, 40 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.21,
      "end_seconds": 40.44,
      "duration_seconds": 3.23,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 44.11,
      "duration_seconds": 3.09,
      "text": "ah, it's been two days now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.7,
      "end_seconds": 47.53,
      "duration_seconds": 1.83,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.55,
      "end_seconds": 51.61,
      "duration_seconds": 2.06,
      "text": "Painkillers helps a bit"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.38,
      "end_seconds": 57.16,
      "duration_seconds": 3.78,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.93,
      "end_seconds": 62.06,
      "duration_seconds": 4.13,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.06,
      "end_seconds": 67.73,
      "duration_seconds": 4.67,
      "text": "Have you had any weakness, visual changes, stiff neck or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.44,
      "end_seconds": 74.26,
      "duration_seconds": 5.82,
      "text": "actually, no, no weakness, visual changes, stiff neck or fever"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.64,
      "end_seconds": 79.01,
      "duration_seconds": 3.37,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.9,
      "end_seconds": 83.32,
      "duration_seconds": 3.42,
      "text": "Erm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.94,
      "end_seconds": 88.98,
      "duration_seconds": 4.04,
      "text": "So, what line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.52,
      "end_seconds": 96.29,
      "duration_seconds": 5.77,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.87,
      "end_seconds": 100.48,
      "duration_seconds": 2.61,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.01,
      "end_seconds": 105.34,
      "duration_seconds": 3.33,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.11,
      "end_seconds": 110.87,
      "duration_seconds": 1.76,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.98,
      "end_seconds": 120.67,
      "duration_seconds": 3.69,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.62,
      "end_seconds": 130.45,
      "duration_seconds": 5.83,
      "text": "So, do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.34,
      "end_seconds": 141.8,
      "duration_seconds": 9.46,
      "text": "Erm, um, years back I got wheezing from diclofenac, so I stay away from it it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.09,
      "end_seconds": 155.76,
      "duration_seconds": 1.67,
      "text": "so, any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.6,
      "end_seconds": 159.86,
      "duration_seconds": 3.26,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.67,
      "end_seconds": 163.92,
      "duration_seconds": 2.25,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.1,
      "end_seconds": 169.34,
      "duration_seconds": 4.24,
      "text": "I mean, I have migraines, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.11,
      "end_seconds": 176.32,
      "duration_seconds": 6.21,
      "text": "Okay, I can see migraines in your file as well. I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.64,
      "end_seconds": 191.12,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.44,
      "end_seconds": 212.79,
      "duration_seconds": 11.35,
      "text": "Okay: blood pressure 120 over 79, respiratory rate 15, SpO2 98 percent on room air. And heart rate 84, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.28,
      "end_seconds": 217.87,
      "duration_seconds": 3.59,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.06,
      "end_seconds": 221.71,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 236.67,
      "duration_seconds": 2.42,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.92,
      "end_seconds": 241.49,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.91,
      "end_seconds": 265.17,
      "duration_seconds": 9.26,
      "text": "So, based on the history and the examination, it fits best with medication-overuse headache on a background of migraine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 277.18,
      "duration_seconds": 3.98,
      "text": "We should do a headache diary for daily headache."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.29,
      "end_seconds": 280.87,
      "duration_seconds": 2.58,
      "text": "Oh, okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.13,
      "end_seconds": 290.41,
      "duration_seconds": 8.28,
      "text": "I'd like you to take amitriptyline, 10 milligrams, at night, long term. That should help with headache prevention."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.18,
      "end_seconds": 294.09,
      "duration_seconds": 2.91,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.62,
      "end_seconds": 309.46,
      "duration_seconds": 14.84,
      "text": "Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. Do get help quickly if the symptoms get worse. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.28,
      "end_seconds": 312.98,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.87,
      "end_seconds": 317.56,
      "duration_seconds": 3.69,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.48,
      "end_seconds": 325.03,
      "duration_seconds": 5.55,
      "text": "um, uh, good, thanks, I'll see you then"
    }
  ]
}