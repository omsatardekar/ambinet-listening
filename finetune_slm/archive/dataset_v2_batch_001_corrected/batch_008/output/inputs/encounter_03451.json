{
  "schema_version": "1.0",
  "encounter_id": "03451",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 6.15,
      "duration_seconds": 5.45,
      "text": "Good morning, grab a seat. Right, what's the the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 19.89,
      "duration_seconds": 8.39,
      "text": "Yeah it's a splash of cleaning fluid in my eye. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.76,
      "end_seconds": 25.89,
      "duration_seconds": 5.13,
      "text": "Did it come on recently? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.56,
      "end_seconds": 33.21,
      "duration_seconds": 6.65,
      "text": "Around about two weeks... no wait it's more like about a week."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.37,
      "end_seconds": 36.85,
      "duration_seconds": 2.48,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.79,
      "end_seconds": 47.58,
      "duration_seconds": 9.79,
      "text": "it usually comes with being unable to open it. Actually the being unable to open it? That's been since yesterday"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.57,
      "end_seconds": 57.81,
      "duration_seconds": 8.24,
      "text": "okay, give me more detail on it, whatever comes to mind. It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.81,
      "end_seconds": 75.01,
      "duration_seconds": 16.2,
      "text": "I'd give it a five out of ten. It's once or twice a day. I've had blurred vision too for about a week. As for blurred vision a seven out of ten I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.53,
      "end_seconds": 84.27,
      "duration_seconds": 3.74,
      "text": "and what about both eyes or head injury?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.42,
      "end_seconds": 92.24,
      "duration_seconds": 6.82,
      "text": "Well, you know, I haven't had both eyes or head injury, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.97,
      "end_seconds": 96.44,
      "duration_seconds": 2.47,
      "text": "So, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 101.03,
      "duration_seconds": 2.78,
      "text": "I, I move fine otherwise"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 106.91,
      "duration_seconds": 3.96,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.44,
      "end_seconds": 115.58,
      "duration_seconds": 7.14,
      "text": "I've had heart disease, yes. I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.27,
      "end_seconds": 118.6,
      "duration_seconds": 1.33,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 125.42,
      "duration_seconds": 5.79,
      "text": "Okay, I can see heart disease and heart failure in your file as well."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.9,
      "end_seconds": 142.82,
      "duration_seconds": 2.92,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.79,
      "end_seconds": 149.87,
      "duration_seconds": 6.08,
      "text": "Spironolactone. I take it 25 milligrams once a day for my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.36,
      "end_seconds": 156.91,
      "duration_seconds": 3.55,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.85,
      "end_seconds": 160.27,
      "duration_seconds": 2.42,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.77,
      "end_seconds": 178.18,
      "duration_seconds": 3.41,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.04,
      "end_seconds": 185.1,
      "duration_seconds": 4.06,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.0,
      "end_seconds": 187.95,
      "duration_seconds": 1.95,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.88,
      "end_seconds": 192.32,
      "duration_seconds": 3.44,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.83,
      "end_seconds": 197.8,
      "duration_seconds": 4.97,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.87,
      "end_seconds": 203.58,
      "duration_seconds": 3.71,
      "text": "Trimethoprim i come out in... well a rash"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.29,
      "end_seconds": 208.28,
      "duration_seconds": 2.99,
      "text": "so have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.07,
      "end_seconds": 210.64,
      "duration_seconds": 1.57,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.84,
      "end_seconds": 214.18,
      "duration_seconds": 2.34,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.74,
      "end_seconds": 230.21,
      "duration_seconds": 3.47,
      "text": "okay, that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.15,
      "end_seconds": 247.8,
      "duration_seconds": 7.65,
      "text": "okay: pressure 117 over 79, temperature is 36.4 degrees and heart rate 71, saturation 97 percent"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.83,
      "end_seconds": 251.77,
      "duration_seconds": 2.94,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 256.27,
      "duration_seconds": 3.09,
      "text": "Okay, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.28,
      "end_seconds": 263.21,
      "duration_seconds": 4.93,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.71,
      "end_seconds": 266.18,
      "duration_seconds": 1.47,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.87,
      "end_seconds": 270.86,
      "duration_seconds": 2.99,
      "text": "alright, take a deep breath for me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.0,
      "end_seconds": 296.49,
      "duration_seconds": 8.49,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.31,
      "end_seconds": 299.32,
      "duration_seconds": 1.01,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.21,
      "end_seconds": 316.15,
      "duration_seconds": 10.94,
      "text": "okay, good, you can sit up again. Putting it it all together, it points towards an alkali chemical burn to the eye"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.11,
      "end_seconds": 319.8,
      "duration_seconds": 1.69,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.56,
      "end_seconds": 335.69,
      "duration_seconds": 10.13,
      "text": "I understand the worry. At the moment I'd say it's an alkali chemical burn to the eye, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.26,
      "end_seconds": 354.55,
      "duration_seconds": 6.29,
      "text": "For now, no new medicines or tests are needed. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.55,
      "end_seconds": 358.79,
      "duration_seconds": 2.24,
      "text": "thank you, that's helpful"
    }
  ]
}