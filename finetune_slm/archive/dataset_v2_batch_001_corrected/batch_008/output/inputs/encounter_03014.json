{
  "schema_version": "1.0",
  "encounter_id": "03014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.19,
      "duration_seconds": 4.51,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 10.9,
      "duration_seconds": 4.65,
      "text": "So, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.65,
      "end_seconds": 29.07,
      "duration_seconds": 17.42,
      "text": "Hmm, doctor, it's confusion. It's getting on my nerves now. I didn't wanna bother you but it keeps coming back. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.65,
      "end_seconds": 31.28,
      "duration_seconds": 1.63,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.3,
      "end_seconds": 38.62,
      "duration_seconds": 5.32,
      "text": "Around five days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.65,
      "end_seconds": 42.65,
      "duration_seconds": 3.0,
      "text": "Okay, any cloudy smelly urine as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.8,
      "end_seconds": 45.5,
      "duration_seconds": 1.7,
      "text": "yeah, that too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.35,
      "end_seconds": 49.25,
      "duration_seconds": 2.9,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.77,
      "end_seconds": 55.24,
      "duration_seconds": 3.47,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.57,
      "end_seconds": 61.51,
      "duration_seconds": 4.94,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.11,
      "end_seconds": 66.81,
      "duration_seconds": 3.7,
      "text": "I'm on a urinary catheter, in place."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.42,
      "end_seconds": 70.22,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.4,
      "end_seconds": 72.9,
      "duration_seconds": 1.5,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.84,
      "end_seconds": 78.44,
      "duration_seconds": 4.6,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.43,
      "end_seconds": 82.77,
      "duration_seconds": 3.34,
      "text": "oh, my sister had breast cancer"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.18,
      "end_seconds": 101.65,
      "duration_seconds": 1.47,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 106.62,
      "duration_seconds": 3.33,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.82,
      "end_seconds": 112.06,
      "duration_seconds": 2.24,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 118.38,
      "duration_seconds": 4.65,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.15,
      "end_seconds": 120.51,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.21,
      "end_seconds": 125.39,
      "duration_seconds": 4.18,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.93,
      "end_seconds": 138.24,
      "duration_seconds": 3.31,
      "text": "Have you had any vomiting or cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.66,
      "end_seconds": 142.26,
      "duration_seconds": 2.6,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.78,
      "end_seconds": 144.97,
      "duration_seconds": 2.19,
      "text": "Any fall or back pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.38,
      "end_seconds": 151.19,
      "duration_seconds": 4.81,
      "text": "I, I haven't had fall or back pain, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.2,
      "end_seconds": 157.16,
      "duration_seconds": 3.96,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.85,
      "end_seconds": 162.9,
      "duration_seconds": 3.05,
      "text": "Right, no, that side's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.61,
      "end_seconds": 167.04,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.21,
      "end_seconds": 182.21,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.43,
      "end_seconds": 202.9,
      "duration_seconds": 6.47,
      "text": "Okay: respiratory rate 18, pressure 124 over 78, pulse is 96 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.99,
      "end_seconds": 205.68,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.66,
      "end_seconds": 210.53,
      "duration_seconds": 2.87,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.31,
      "end_seconds": 214.66,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.12,
      "end_seconds": 217.49,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.64,
      "end_seconds": 235.7,
      "duration_seconds": 6.06,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 241.44,
      "duration_seconds": 2.61,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.26,
      "end_seconds": 263.24,
      "duration_seconds": 5.98,
      "text": "Right, here's what I'm thinking. This looks most like a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.79,
      "end_seconds": 267.94,
      "duration_seconds": 3.15,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.01,
      "end_seconds": 277.61,
      "duration_seconds": 8.6,
      "text": "Nothing I've seen today points to an emergency. It looks like a catheter-related urinary infection, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.35,
      "end_seconds": 293.78,
      "duration_seconds": 7.43,
      "text": "Let's book blood tests to look into fever. Let's book a urine culture to look into possible urinary infection."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.83,
      "end_seconds": 299.45,
      "duration_seconds": 2.62,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.84,
      "end_seconds": 327.95,
      "duration_seconds": 27.11,
      "text": "I'm going to put you on co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with catheter urinary infection. Change the catheter and drink plenty. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.73,
      "end_seconds": 330.17,
      "duration_seconds": 1.44,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.11,
      "end_seconds": 333.76,
      "duration_seconds": 2.65,
      "text": "See me again in two days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.76,
      "end_seconds": 338.98,
      "duration_seconds": 3.22,
      "text": "I'll note it it in my calendar."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.65,
      "end_seconds": 343.5,
      "duration_seconds": 3.85,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.36,
      "end_seconds": 348.49,
      "duration_seconds": 3.13,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}