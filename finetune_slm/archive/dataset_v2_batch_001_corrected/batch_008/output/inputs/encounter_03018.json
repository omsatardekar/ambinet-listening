{
  "schema_version": "1.0",
  "encounter_id": "03018",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.12,
      "duration_seconds": 4.05,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 10.58,
      "duration_seconds": 3.82,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.19,
      "end_seconds": 15.31,
      "duration_seconds": 4.12,
      "text": "Well, I've been having vomiting once or twice."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.73,
      "end_seconds": 19.99,
      "duration_seconds": 3.26,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.86,
      "end_seconds": 23.87,
      "duration_seconds": 2.01,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.09,
      "end_seconds": 29.8,
      "duration_seconds": 4.71,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.68,
      "end_seconds": 37.69,
      "duration_seconds": 6.01,
      "text": "I get some relief from sips of fluid. I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 40.81,
      "duration_seconds": 2.34,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.77,
      "end_seconds": 45.81,
      "duration_seconds": 3.04,
      "text": "It usually comes with loose stools."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.39,
      "end_seconds": 64.73,
      "duration_seconds": 5.34,
      "text": "Any high fever, blood in the stool, drowsiness or no wet nappies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.3,
      "end_seconds": 73.8,
      "duration_seconds": 7.5,
      "text": "No high fever, blood in the stool, drowsiness or no wet nappies, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.72,
      "end_seconds": 81.53,
      "duration_seconds": 2.81,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.08,
      "end_seconds": 84.75,
      "duration_seconds": 1.67,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.72,
      "end_seconds": 88.34,
      "duration_seconds": 2.62,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.56,
      "end_seconds": 92.68,
      "duration_seconds": 1.12,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.3,
      "end_seconds": 115.06,
      "duration_seconds": 3.76,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.31,
      "end_seconds": 117.9,
      "duration_seconds": 1.59,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.78,
      "end_seconds": 127.44,
      "duration_seconds": 4.66,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.09,
      "end_seconds": 131.32,
      "duration_seconds": 3.23,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.26,
      "end_seconds": 137.69,
      "duration_seconds": 4.43,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.8,
      "end_seconds": 150.39,
      "duration_seconds": 11.59,
      "text": "I do a yoga class on Thursdays. No, I share a house with my brother. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.94,
      "end_seconds": 170.8,
      "duration_seconds": 2.86,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.31,
      "end_seconds": 184.06,
      "duration_seconds": 2.75,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.83,
      "end_seconds": 206.55,
      "duration_seconds": 9.72,
      "text": "Okay: temp 36.9 degrees, respiratory rate 16. And pressure 114 over 74, heart rate 76, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 211.43,
      "duration_seconds": 3.64,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.25,
      "end_seconds": 214.35,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.67,
      "end_seconds": 217.09,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 233.27,
      "duration_seconds": 5.03,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.23,
      "end_seconds": 248.41,
      "duration_seconds": 10.18,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this looks most like a mild stomach bug."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.03,
      "end_seconds": 252.85,
      "duration_seconds": 3.82,
      "text": "Mm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.79,
      "end_seconds": 264.87,
      "duration_seconds": 9.08,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.32,
      "end_seconds": 296.69,
      "duration_seconds": 19.37,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. If he stops drinking or becomes drowsy, or you feel really unwell, please come to the emergency department. Come back if he is not drinking."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 298.17,
      "end_seconds": 301.97,
      "duration_seconds": 3.8,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.98,
      "end_seconds": 306.38,
      "duration_seconds": 2.4,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.31,
      "end_seconds": 310.34,
      "duration_seconds": 2.03,
      "text": "Thank you, that's helpful."
    }
  ]
}