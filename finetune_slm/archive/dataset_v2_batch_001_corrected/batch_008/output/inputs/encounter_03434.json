{
  "schema_version": "1.0",
  "encounter_id": "03434",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 7.72,
      "duration_seconds": 6.92,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.26,
      "end_seconds": 12.0,
      "duration_seconds": 3.74,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.54,
      "end_seconds": 15.82,
      "duration_seconds": 3.28,
      "text": "I've been dealing with being very tired."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.86,
      "end_seconds": 20.25,
      "duration_seconds": 3.39,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.2,
      "end_seconds": 31.44,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.44,
      "end_seconds": 55.53,
      "duration_seconds": 8.09,
      "text": "Okay: temperature is 36.7 degrees, SpO2 99 percent on room air, pulse 73. And blood pressure 127 over 78."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.45,
      "end_seconds": 57.89,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.09,
      "end_seconds": 65.47,
      "duration_seconds": 3.38,
      "text": "We'll go over that shortly. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.64,
      "end_seconds": 69.98,
      "duration_seconds": 3.34,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.33,
      "end_seconds": 74.83,
      "duration_seconds": 4.5,
      "text": "Hm, okay. Any nausea after the chemotherapy as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.17,
      "end_seconds": 92.62,
      "duration_seconds": 16.45,
      "text": "Yes, actually. About nausea after the chemotherapy, honestly, all the time. Oh, and numb fingertips. That's been about the same, three days. About numb fingertips, I'd call it mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.8,
      "end_seconds": 104.18,
      "duration_seconds": 2.38,
      "text": "Have you noticed breathlessness or shivering?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.46,
      "end_seconds": 107.85,
      "duration_seconds": 2.39,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.63,
      "end_seconds": 111.63,
      "duration_seconds": 3.0,
      "text": "Have you had any fever or bleeding?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.66,
      "end_seconds": 116.33,
      "duration_seconds": 3.67,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.57,
      "end_seconds": 119.22,
      "duration_seconds": 2.65,
      "text": "Understood. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.21,
      "end_seconds": 121.74,
      "duration_seconds": 1.53,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.83,
      "end_seconds": 125.56,
      "duration_seconds": 2.73,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.38,
      "end_seconds": 127.37,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.41,
      "end_seconds": 130.81,
      "duration_seconds": 2.4,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.78,
      "end_seconds": 149.47,
      "duration_seconds": 12.69,
      "text": "I walk the dog every morning. I'm a bus driver, so I sit for long hours. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.26,
      "end_seconds": 152.73,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.22,
      "end_seconds": 159.68,
      "duration_seconds": 5.46,
      "text": "Alendronate. I take it 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 164.3,
      "duration_seconds": 3.16,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.92,
      "end_seconds": 171.73,
      "duration_seconds": 3.81,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.43,
      "end_seconds": 176.79,
      "duration_seconds": 4.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.45,
      "end_seconds": 181.49,
      "duration_seconds": 4.04,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.81,
      "end_seconds": 188.81,
      "duration_seconds": 2.0,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.19,
      "end_seconds": 200.47,
      "duration_seconds": 9.28,
      "text": "Hmm, you know, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.85,
      "end_seconds": 221.46,
      "duration_seconds": 2.61,
      "text": "Okay, what about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.35,
      "end_seconds": 224.94,
      "duration_seconds": 2.59,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.27,
      "end_seconds": 231.67,
      "duration_seconds": 4.4,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.39,
      "end_seconds": 234.94,
      "duration_seconds": 1.55,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.48,
      "end_seconds": 239.26,
      "duration_seconds": 2.78,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.32,
      "end_seconds": 260.01,
      "duration_seconds": 5.69,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.36,
      "end_seconds": 267.12,
      "duration_seconds": 1.76,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.56,
      "end_seconds": 304.81,
      "duration_seconds": 29.25,
      "text": "From what you've told me and what I found, it fits best with expected chemotherapy side effects. It could also be an infection, so we'll keep that open. Call the chemotherapy helpline straight away if your temperature goes over 37.5. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.24,
      "end_seconds": 316.47,
      "duration_seconds": 10.23,
      "text": "The thing that would worry me is if your temperature is 37.5 or above. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.12,
      "end_seconds": 321.55,
      "duration_seconds": 3.43,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.27,
      "end_seconds": 325.83,
      "duration_seconds": 2.56,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.87,
      "end_seconds": 334.14,
      "duration_seconds": 3.27,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}