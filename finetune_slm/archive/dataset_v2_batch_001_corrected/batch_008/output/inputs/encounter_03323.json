{
  "schema_version": "1.0",
  "encounter_id": "03323",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 3.11,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.99,
      "end_seconds": 8.92,
      "duration_seconds": 3.93,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.06,
      "end_seconds": 15.91,
      "duration_seconds": 5.85,
      "text": "It's wheeze at work. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.81,
      "end_seconds": 20.28,
      "duration_seconds": 3.47,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.35,
      "end_seconds": 29.1,
      "duration_seconds": 6.75,
      "text": "About four days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.67,
      "end_seconds": 36.17,
      "duration_seconds": 6.5,
      "text": "Mm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.01,
      "end_seconds": 42.69,
      "duration_seconds": 5.68,
      "text": "It happens all the time. Only weekends away, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.41,
      "end_seconds": 46.01,
      "duration_seconds": 2.6,
      "text": "Okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.39,
      "end_seconds": 66.25,
      "duration_seconds": 18.86,
      "text": "When it starts I tend to get a tight chest at work as well. With tight chest at work, maybe a eight out of ten on a bad day. Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.84,
      "end_seconds": 78.26,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.91,
      "end_seconds": 83.29,
      "duration_seconds": 3.38,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 101.31,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.59,
      "end_seconds": 105.44,
      "duration_seconds": 2.85,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.82,
      "end_seconds": 113.9,
      "duration_seconds": 3.08,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.96,
      "end_seconds": 121.74,
      "duration_seconds": 5.78,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.85,
      "end_seconds": 125.75,
      "duration_seconds": 2.9,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.26,
      "end_seconds": 130.71,
      "duration_seconds": 3.45,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.31,
      "end_seconds": 136.38,
      "duration_seconds": 5.07,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.38,
      "end_seconds": 144.33,
      "duration_seconds": 6.95,
      "text": "Years back I got hives from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.49,
      "end_seconds": 149.75,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.71,
      "end_seconds": 153.08,
      "duration_seconds": 2.37,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.96,
      "end_seconds": 156.74,
      "duration_seconds": 2.78,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 163.52,
      "duration_seconds": 5.19,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 166.22,
      "duration_seconds": 0.8,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.04,
      "end_seconds": 168.77,
      "duration_seconds": 1.73,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.69,
      "end_seconds": 174.3,
      "duration_seconds": 4.61,
      "text": "Okay, have you noticed coughing up blood or ankle swelling?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.99,
      "end_seconds": 181.74,
      "duration_seconds": 5.75,
      "text": "I mean, no coughing up blood or ankle swelling, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.33,
      "end_seconds": 187.71,
      "duration_seconds": 4.38,
      "text": "Alright, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.77,
      "end_seconds": 191.88,
      "duration_seconds": 2.11,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.54,
      "end_seconds": 196.84,
      "duration_seconds": 3.3,
      "text": "Right, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.51,
      "end_seconds": 203.81,
      "duration_seconds": 3.3,
      "text": "Uh, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.35,
      "end_seconds": 207.33,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.36,
      "end_seconds": 209.62,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.07,
      "end_seconds": 228.22,
      "duration_seconds": 5.15,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 234.26,
      "duration_seconds": 1.73,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.11,
      "end_seconds": 256.3,
      "duration_seconds": 5.19,
      "text": "I want serial peak flow readings done, that's for work-related wheeze."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 258.13,
      "end_seconds": 260.5,
      "duration_seconds": 2.37,
      "text": "The earliest is Wednesday, 10 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.49,
      "end_seconds": 296.69,
      "duration_seconds": 34.2,
      "text": "I'm sending you for spirometry because of wheeze. The treatment will be beclometasone inhaler, 200 micrograms, twice a day, long term. It's for asthma. I'll put all of this in writing so you don't have to remember it. Record peak flows at work and at home for four weeks. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. We'll refer you to occupational health."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.99,
      "end_seconds": 300.63,
      "duration_seconds": 2.64,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.61,
      "end_seconds": 307.68,
      "duration_seconds": 6.07,
      "text": "Let's review you in four weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.63,
      "end_seconds": 313.0,
      "duration_seconds": 4.37,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}