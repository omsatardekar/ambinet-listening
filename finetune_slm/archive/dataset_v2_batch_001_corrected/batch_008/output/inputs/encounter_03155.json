{
  "schema_version": "1.0",
  "encounter_id": "03155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 6.86,
      "duration_seconds": 6.1,
      "text": "Okay, hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.12,
      "end_seconds": 9.23,
      "duration_seconds": 1.11,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.08,
      "end_seconds": 15.2,
      "duration_seconds": 4.12,
      "text": "right, thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.71,
      "end_seconds": 17.58,
      "duration_seconds": 1.87,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.33,
      "end_seconds": 27.57,
      "duration_seconds": 4.24,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.54,
      "end_seconds": 31.17,
      "duration_seconds": 1.63,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.78,
      "end_seconds": 39.76,
      "duration_seconds": 7.98,
      "text": "So the thing is, uh, I've got a high sugar test in pregnancy."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.06,
      "end_seconds": 42.79,
      "duration_seconds": 1.73,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.12,
      "end_seconds": 50.05,
      "duration_seconds": 5.93,
      "text": "Three days, I think... sorry, ten days, I got that wrong."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.44,
      "end_seconds": 54.39,
      "duration_seconds": 2.95,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.1,
      "end_seconds": 60.33,
      "duration_seconds": 4.23,
      "text": "I'd say moderate. Oh, and no symptoms."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 64.29,
      "duration_seconds": 3.15,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.7,
      "end_seconds": 69.14,
      "duration_seconds": 3.44,
      "text": "Mm, it feels mild to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.23,
      "end_seconds": 78.75,
      "duration_seconds": 7.52,
      "text": "alright, have you had a high sugar test in pregnancy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.18,
      "end_seconds": 87.81,
      "duration_seconds": 7.63,
      "text": "Okay, so I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.8,
      "end_seconds": 93.12,
      "duration_seconds": 4.32,
      "text": "and what about passing a lot of urine or blurred vision?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.19,
      "end_seconds": 98.44,
      "duration_seconds": 4.25,
      "text": "no, you know, not a single one"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.36,
      "end_seconds": 104.1,
      "duration_seconds": 3.74,
      "text": "And what about reduced baby movements or thirst?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.56,
      "end_seconds": 110.71,
      "duration_seconds": 5.15,
      "text": "Let me think, uh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.68,
      "end_seconds": 116.35,
      "duration_seconds": 4.67,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.38,
      "end_seconds": 120.61,
      "duration_seconds": 2.23,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.33,
      "end_seconds": 125.61,
      "duration_seconds": 3.28,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 131.63,
      "duration_seconds": 4.74,
      "text": "Um, um, no, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.78,
      "end_seconds": 135.59,
      "duration_seconds": 2.81,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.4,
      "end_seconds": 141.07,
      "duration_seconds": 3.67,
      "text": "So, no, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.48,
      "end_seconds": 158.76,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.43,
      "end_seconds": 166.54,
      "duration_seconds": 6.11,
      "text": "Alendronate. I take it 70 milligrams, once a week for my bones"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.27,
      "end_seconds": 170.0,
      "duration_seconds": 1.73,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.56,
      "end_seconds": 172.53,
      "duration_seconds": 1.97,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.09,
      "end_seconds": 173.79,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.33,
      "end_seconds": 180.66,
      "duration_seconds": 6.33,
      "text": "I'm, I'm on lisinopril, 10 milligrams, once a day for my pressure"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.7,
      "end_seconds": 186.14,
      "duration_seconds": 3.44,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.43,
      "end_seconds": 194.63,
      "duration_seconds": 7.2,
      "text": "yes, I had a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.27,
      "end_seconds": 198.3,
      "duration_seconds": 2.03,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.82,
      "end_seconds": 210.89,
      "duration_seconds": 12.07,
      "text": "I have thin bones, for nearly five years. I told my wife I'd come today. I have high blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.19,
      "end_seconds": 223.58,
      "duration_seconds": 7.39,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.94,
      "end_seconds": 244.05,
      "duration_seconds": 3.11,
      "text": "right, now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.13,
      "end_seconds": 258.94,
      "duration_seconds": 12.81,
      "text": "I'm vegetarian and have been for years. I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.97,
      "end_seconds": 263.09,
      "duration_seconds": 3.12,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.89,
      "end_seconds": 271.84,
      "duration_seconds": 1.95,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.17,
      "end_seconds": 291.8,
      "duration_seconds": 9.63,
      "text": "Okay: pressure 117 over 69, weight 87 kilos, height 159 centimetres, pulse is 81 beats a minute, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.44,
      "end_seconds": 295.61,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.7,
      "end_seconds": 301.97,
      "duration_seconds": 4.27,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.55,
      "end_seconds": 309.14,
      "duration_seconds": 4.59,
      "text": "right, I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.39,
      "end_seconds": 321.4,
      "duration_seconds": 1.01,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.69,
      "end_seconds": 325.6,
      "duration_seconds": 2.91,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.17,
      "end_seconds": 339.89,
      "duration_seconds": 5.72,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.46,
      "end_seconds": 352.55,
      "duration_seconds": 8.09,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. It fits best with gestational diabetes controllable with diet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.58,
      "end_seconds": 355.71,
      "duration_seconds": 2.13,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.0,
      "end_seconds": 392.98,
      "duration_seconds": 35.98,
      "text": "I understand the worry. At the moment I'd say it's gestational diabetes controllable with diet, and we'll know more once the a growth scan is back. I want a growth scan done, that's for gestational diabetes. I think a glucose meter and diary makes sense here, for gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals. The diabetes midwife would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.54,
      "end_seconds": 396.35,
      "duration_seconds": 2.81,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.42,
      "end_seconds": 405.8,
      "duration_seconds": 8.38,
      "text": "come back or go to emergency straight away if the symptoms get worse let's review you in two weeks"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.99,
      "end_seconds": 409.68,
      "duration_seconds": 2.69,
      "text": "Oh, I can manage that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.89,
      "end_seconds": 414.02,
      "duration_seconds": 3.13,
      "text": "Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.54,
      "end_seconds": 419.4,
      "duration_seconds": 3.86,
      "text": "Yeah, good, thanks, I'll see you then."
    }
  ]
}