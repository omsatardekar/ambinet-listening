  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 6.48,
      "duration_seconds": 5.21,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.3,
      "end_seconds": 12.04,
      "duration_seconds": 3.74,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 20.21,
      "duration_seconds": 6.6,
      "text": "It's severe back pain. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.25,
      "end_seconds": 22.83,
      "duration_seconds": 1.58,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.36,
      "end_seconds": 26.08,
      "duration_seconds": 2.72,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.84,
      "end_seconds": 32.87,
      "duration_seconds": 5.03,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.11,
      "end_seconds": 39.15,
      "duration_seconds": 5.04,
      "text": "Honestly, once or twice a day. I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.85,
      "end_seconds": 43.53,
      "duration_seconds": 2.68,
      "text": "Have you had trouble passing urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.0,
      "end_seconds": 48.62,
      "duration_seconds": 3.62,
      "text": "I mean, yeah. Five days, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 53.59,
      "duration_seconds": 4.38,
      "text": "A few quick ones: chest pain or recent fall?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.78,
      "end_seconds": 58.99,
      "duration_seconds": 4.21,
      "text": "I haven't had chest pain or recent fall, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 61.51,
      "duration_seconds": 1.88,
      "text": "How about weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.56,
      "end_seconds": 64.95,
      "duration_seconds": 2.39,
      "text": "nope, no weight loss"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.11,
      "end_seconds": 71.79,
      "duration_seconds": 2.68,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 74.33,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 78.92,
      "duration_seconds": 3.66,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.97,
      "end_seconds": 84.79,
      "duration_seconds": 4.82,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.66,
      "end_seconds": 90.36,
      "duration_seconds": 3.7,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.03,
      "end_seconds": 96.81,
      "duration_seconds": 5.78,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.93,
      "end_seconds": 100.32,
      "duration_seconds": 2.39,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.35,
      "end_seconds": 104.38,
      "duration_seconds": 2.03,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.39,
      "end_seconds": 116.41,
      "duration_seconds": 3.02,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.93,
      "end_seconds": 120.05,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 123.84,
      "duration_seconds": 2.33,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.91,
      "end_seconds": 131.41,
      "duration_seconds": 5.5,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.4,
      "end_seconds": 135.21,
      "duration_seconds": 2.81,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.2,
      "end_seconds": 139.66,
      "duration_seconds": 3.46,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.13,
      "end_seconds": 155.67,
      "duration_seconds": 2.54,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.87,
      "end_seconds": 161.56,
      "duration_seconds": 4.69,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.42,
      "end_seconds": 178.7,
      "duration_seconds": 7.28,
      "text": "which medicines do you take at the moment? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 183.21,
      "duration_seconds": 4.0,
      "text": "I take glibenclamide, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.02,
      "end_seconds": 187.7,
      "duration_seconds": 2.68,
      "text": "Okay, and what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.94,
      "end_seconds": 192.42,
      "duration_seconds": 3.48,
      "text": "5 milligrams. It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.37,
      "end_seconds": 197.4,
      "duration_seconds": 3.03,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.28,
      "end_seconds": 201.1,
      "duration_seconds": 2.82,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.98,
      "end_seconds": 204.62,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.29,
      "end_seconds": 214.14,
      "duration_seconds": 2.85,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.1,
      "end_seconds": 232.19,
      "duration_seconds": 7.09,
      "text": "Okay: pulse is 103 beats a minute, temp 38.3 degrees, BP is 117 over 67."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.53,
      "end_seconds": 236.98,
      "duration_seconds": 3.45,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 240.34,
      "duration_seconds": 1.43,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.73,
      "end_seconds": 254.06,
      "duration_seconds": 6.33,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.16,
      "end_seconds": 274.07,
      "duration_seconds": 17.91,
      "text": "alright, that's all I needed to check okay, thinking it through, it points towards a possible spinal infection pressing on the nerves the reason I say that is that your story and my examination fit together"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.62,
      "end_seconds": 278.46,
      "duration_seconds": 2.84,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.98,
      "end_seconds": 302.06,
      "duration_seconds": 19.08,
      "text": "I can't promise yet, but most people with a possible spinal infection pressing on the nerves do well once it's treated properly i think urgent blood tests makes sense here, for possible spinal infection i want an urgent MRI of the spine done, that's for possible epidural abscess"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.0,
      "end_seconds": 304.03,
      "duration_seconds": 1.03,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.5,
      "end_seconds": 313.33,
      "duration_seconds": 7.83,
      "text": "You are going to hospital now, this can cause permanent weakness. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.65,
      "end_seconds": 319.7,
      "duration_seconds": 2.05,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.74,
      "end_seconds": 326.57,
      "duration_seconds": 4.83,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.68,
      "end_seconds": 330.42,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks."
    }
  ]
