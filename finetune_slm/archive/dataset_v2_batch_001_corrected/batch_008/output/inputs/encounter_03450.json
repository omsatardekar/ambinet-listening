{
  "schema_version": "1.0",
  "encounter_id": "03450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.22,
      "duration_seconds": 3.83,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 10.68,
      "duration_seconds": 4.52,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 15.03,
      "duration_seconds": 3.52,
      "text": "I've been dealing with shortness of breath."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.96,
      "end_seconds": 20.17,
      "duration_seconds": 3.21,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.5,
      "end_seconds": 24.5,
      "duration_seconds": 3.0,
      "text": "Probably about a month. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.57,
      "end_seconds": 29.52,
      "duration_seconds": 2.95,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.61,
      "end_seconds": 34.19,
      "duration_seconds": 2.58,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.86,
      "end_seconds": 38.67,
      "duration_seconds": 2.81,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.24,
      "end_seconds": 40.5,
      "duration_seconds": 1.26,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.27,
      "end_seconds": 43.34,
      "duration_seconds": 2.07,
      "text": "Any chest pain as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.12,
      "end_seconds": 63.39,
      "duration_seconds": 19.27,
      "text": "Yes, about the same, six months. Right, as for chest pain, mild, really. It's once or twice a day. I've had a racing heart too, for ten days. About racing heart, about a seven out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.41,
      "end_seconds": 77.97,
      "duration_seconds": 4.56,
      "text": "So, a few quick ones: fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.38,
      "end_seconds": 85.68,
      "duration_seconds": 6.3,
      "text": "Okay, so I haven't had fever, leg swelling or cough, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 89.04,
      "duration_seconds": 1.46,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.5,
      "end_seconds": 92.61,
      "duration_seconds": 2.11,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.43,
      "end_seconds": 96.33,
      "duration_seconds": 2.9,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.96,
      "end_seconds": 100.85,
      "duration_seconds": 3.89,
      "text": "Uh, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.17,
      "end_seconds": 103.39,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.38,
      "end_seconds": 106.65,
      "duration_seconds": 2.27,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.42,
      "end_seconds": 111.02,
      "duration_seconds": 2.6,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.12,
      "end_seconds": 124.9,
      "duration_seconds": 11.78,
      "text": "Not much, I mostly stay in these days. I work in accounts at a hospital. My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.82,
      "end_seconds": 146.71,
      "duration_seconds": 7.89,
      "text": "Okay, anything in your past medical history I should know? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.31,
      "end_seconds": 150.88,
      "duration_seconds": 3.57,
      "text": "I've had COPD for five years now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.54,
      "end_seconds": 160.53,
      "duration_seconds": 7.99,
      "text": "I follow. Okay, I can see COPD in your file as well. Let me quickly check your readings"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.76,
      "end_seconds": 174.69,
      "duration_seconds": 2.93,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.51,
      "end_seconds": 195.74,
      "duration_seconds": 7.23,
      "text": "Okay: pulse 94, pressure 98 over 63, temperature is 37.0 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.48,
      "end_seconds": 199.59,
      "duration_seconds": 3.11,
      "text": "hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.62,
      "end_seconds": 204.89,
      "duration_seconds": 3.27,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.62,
      "end_seconds": 208.57,
      "duration_seconds": 1.95,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.05,
      "end_seconds": 212.67,
      "duration_seconds": 2.62,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.56,
      "end_seconds": 236.99,
      "duration_seconds": 7.43,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.73,
      "end_seconds": 243.26,
      "duration_seconds": 2.53,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.82,
      "end_seconds": 287.08,
      "duration_seconds": 35.26,
      "text": "So where does that leave us? This looks most like possible cardiac tamponade. A heart attack is still possible. I'll request an ECG, it'll help with chest pain. You need an urgent heart scan and possibly a drain. We'll refer you to the cardiology team. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.32,
      "end_seconds": 297.7,
      "duration_seconds": 5.38,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.91,
      "end_seconds": 303.02,
      "duration_seconds": 4.11,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.6,
      "end_seconds": 305.06,
      "duration_seconds": 1.46,
      "text": "all the best"
    }
  ]
}