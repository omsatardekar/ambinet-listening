{
  "schema_version": "1.0",
  "encounter_id": "03485",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.65,
      "duration_seconds": 3.14,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.45,
      "end_seconds": 8.81,
      "duration_seconds": 4.36,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.55,
      "end_seconds": 16.15,
      "duration_seconds": 6.6,
      "text": "Doctor, it's flakes on my shoulders. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.97,
      "end_seconds": 20.82,
      "duration_seconds": 2.85,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.86,
      "end_seconds": 34.86,
      "duration_seconds": 2.0,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.32,
      "end_seconds": 54.89,
      "duration_seconds": 6.57,
      "text": "Okay: pressure 118 over 69, oxygen saturation is 99 percent, pulse is 82 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.6,
      "end_seconds": 74.51,
      "duration_seconds": 3.91,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.5,
      "end_seconds": 97.34,
      "duration_seconds": 21.84,
      "text": "It's been three days, I'm fairly sure. There's an itchy scalp as well. Sorry, what was I saying, as for itchy scalp, it's moderate, honestly. As for little redness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.09,
      "end_seconds": 101.78,
      "duration_seconds": 3.69,
      "text": "Any pain, rash elsewhere or pus at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.06,
      "end_seconds": 109.21,
      "duration_seconds": 3.15,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 111.53,
      "duration_seconds": 1.6,
      "text": "How about hair loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.5,
      "end_seconds": 114.83,
      "duration_seconds": 2.33,
      "text": "Nope, no hair loss."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.57,
      "end_seconds": 121.14,
      "duration_seconds": 4.57,
      "text": "So, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.97,
      "end_seconds": 124.95,
      "duration_seconds": 1.98,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.99,
      "end_seconds": 128.15,
      "duration_seconds": 2.16,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.46,
      "end_seconds": 131.93,
      "duration_seconds": 2.47,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.01,
      "end_seconds": 137.43,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.64,
      "end_seconds": 144.09,
      "duration_seconds": 3.45,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.64,
      "end_seconds": 161.7,
      "duration_seconds": 4.06,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.39,
      "end_seconds": 165.21,
      "duration_seconds": 2.82,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.46,
      "end_seconds": 175.37,
      "duration_seconds": 4.91,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.18,
      "end_seconds": 189.0,
      "duration_seconds": 11.82,
      "text": "It's escitalopram, 10 milligrams, once a day. My family kept telling me to get it checked. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.85,
      "end_seconds": 194.92,
      "duration_seconds": 4.07,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.64,
      "end_seconds": 206.2,
      "duration_seconds": 10.56,
      "text": "I'm a bus driver, so I sit for long hours. I live with my elderly mother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.17,
      "end_seconds": 209.23,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.56,
      "end_seconds": 214.32,
      "duration_seconds": 3.76,
      "text": "I have anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.63,
      "end_seconds": 219.76,
      "duration_seconds": 4.13,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.9,
      "end_seconds": 224.54,
      "duration_seconds": 3.64,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.9,
      "end_seconds": 227.85,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.84,
      "end_seconds": 252.66,
      "duration_seconds": 5.82,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.55,
      "end_seconds": 261.55,
      "duration_seconds": 3.0,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.38,
      "end_seconds": 307.52,
      "duration_seconds": 29.14,
      "text": "Having listened and examined, my working impression is simple dandruff. I want to be honest that this is an impression, not a final answer. I'd like you to take ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. Leave the shampoo on for five minutes before rinsing. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.42,
      "end_seconds": 312.19,
      "duration_seconds": 3.77,
      "text": "Well, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.79,
      "end_seconds": 322.71,
      "duration_seconds": 9.92,
      "text": "Let's plan a check if not better in a month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.69,
      "end_seconds": 326.72,
      "duration_seconds": 2.03,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.69,
      "end_seconds": 330.08,
      "duration_seconds": 1.39,
      "text": "Goodbye for now."
    }
  ]
}