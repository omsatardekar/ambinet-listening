{
  "schema_version": "1.0",
  "encounter_id": "03453",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 3.25,
      "duration_seconds": 1.92,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.13,
      "end_seconds": 6.68,
      "duration_seconds": 2.55,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.68,
      "end_seconds": 10.96,
      "duration_seconds": 3.28,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.08,
      "end_seconds": 17.26,
      "duration_seconds": 5.18,
      "text": "Absolutely, come and sit beside them. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.43,
      "end_seconds": 31.57,
      "duration_seconds": 9.14,
      "text": "okay, so mainly severe back pain there's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 38.51,
      "duration_seconds": 4.91,
      "text": "Okay, give me more detail on it, whatever comes to to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.33,
      "end_seconds": 45.67,
      "duration_seconds": 5.34,
      "text": "honestly, on and off a seven out of ten, I suppose"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.39,
      "end_seconds": 52.5,
      "duration_seconds": 6.11,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 52.6,
      "end_seconds": 60.06,
      "duration_seconds": 7.46,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.71,
      "end_seconds": 67.9,
      "duration_seconds": 6.19,
      "text": "later, thanks please go on what about trouble passing urine, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.59,
      "end_seconds": 71.24,
      "duration_seconds": 1.65,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.69,
      "end_seconds": 76.21,
      "duration_seconds": 3.52,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.06,
      "end_seconds": 81.83,
      "duration_seconds": 4.77,
      "text": "Mild, I'd say. Oh, and weakness in the legs."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.68,
      "end_seconds": 89.25,
      "duration_seconds": 5.57,
      "text": "Have you had severe back pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.85,
      "end_seconds": 95.63,
      "duration_seconds": 4.78,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 97.73,
      "end_seconds": 99.65,
      "duration_seconds": 1.92,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.54,
      "end_seconds": 112.17,
      "duration_seconds": 4.63,
      "text": "Have you noticed recent fall, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.27,
      "end_seconds": 129.14,
      "duration_seconds": 15.87,
      "text": "Okay, so no, no recent fall, no chest pain, no weight loss. I did have a fever at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.88,
      "end_seconds": 135.07,
      "duration_seconds": 4.19,
      "text": "On the the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.85,
      "end_seconds": 138.23,
      "duration_seconds": 2.38,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.01,
      "end_seconds": 142.46,
      "duration_seconds": 2.45,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.17,
      "end_seconds": 149.02,
      "duration_seconds": 4.85,
      "text": "I've had diabetes for five years now. Yes, asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.71,
      "end_seconds": 160.21,
      "duration_seconds": 9.5,
      "text": "understood. Alright, diabetes and asthma, that matches what I have here. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.31,
      "end_seconds": 164.74,
      "duration_seconds": 3.43,
      "text": "It's metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 166.12,
      "end_seconds": 170.89,
      "duration_seconds": 4.77,
      "text": "doctor, our chart from the last visit lists it as 1000 milligrams"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.53,
      "end_seconds": 175.2,
      "duration_seconds": 3.67,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.04,
      "end_seconds": 188.06,
      "duration_seconds": 11.02,
      "text": "No, uh, I left it at home. It's Asthalin inhaler, when needed for my asthma. I'm on injecting drugs, recent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.66,
      "end_seconds": 193.58,
      "duration_seconds": 4.92,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.67,
      "end_seconds": 200.9,
      "duration_seconds": 5.23,
      "text": "My brother has epilepsy. Ah, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.94,
      "end_seconds": 204.16,
      "duration_seconds": 1.22,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.18,
      "end_seconds": 209.75,
      "duration_seconds": 3.57,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.95,
      "end_seconds": 212.86,
      "duration_seconds": 1.91,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.25,
      "end_seconds": 219.23,
      "duration_seconds": 4.98,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.04,
      "end_seconds": 223.49,
      "duration_seconds": 3.45,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.23,
      "end_seconds": 231.06,
      "duration_seconds": 2.83,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.2,
      "end_seconds": 236.04,
      "duration_seconds": 3.84,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.86,
      "end_seconds": 240.78,
      "duration_seconds": 3.92,
      "text": "Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 241.81,
      "end_seconds": 249.95,
      "duration_seconds": 8.14,
      "text": "Okay, so the vitals from earlier. Respiratory rate 19, temperature is 38.6 degrees, blood pressure 110 over 79. Pulse 95."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.81,
      "end_seconds": 252.51,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.56,
      "end_seconds": 257.19,
      "duration_seconds": 3.63,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.34,
      "end_seconds": 273.09,
      "duration_seconds": 1.75,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.29,
      "end_seconds": 275.84,
      "duration_seconds": 1.55,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.03,
      "end_seconds": 290.82,
      "duration_seconds": 6.79,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.43,
      "end_seconds": 309.35,
      "duration_seconds": 12.92,
      "text": "Please sit back down. So where does that leave us? It fits best with a possible spinal infection pressing on the nerves. I'd also keep a slipped disc in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.58,
      "end_seconds": 313.96,
      "duration_seconds": 3.38,
      "text": "Right, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.88,
      "end_seconds": 334.75,
      "duration_seconds": 19.87,
      "text": "it's reasonable to be concerned, but right now a possible spinal infection pressing on the nerves is my leading thought, not anything worse. Just to be sure I understood. You've had severe back pain, and no weight loss or recent fall"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.71,
      "end_seconds": 336.41,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.02,
      "end_seconds": 354.07,
      "duration_seconds": 16.05,
      "text": "Let's book an urgent MRI of the spine to look into possible epidural abscess. Let's book urgent blood tests to look into possible spinal infection. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.87,
      "end_seconds": 356.39,
      "duration_seconds": 1.52,
      "text": "does it hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.25,
      "end_seconds": 371.52,
      "duration_seconds": 13.27,
      "text": "You are going to to hospital now, this can cause permanent weakness. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.47,
      "end_seconds": 377.02,
      "duration_seconds": 3.55,
      "text": "Erm, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.07,
      "end_seconds": 383.32,
      "duration_seconds": 4.25,
      "text": "Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.3,
      "end_seconds": 388.37,
      "duration_seconds": 3.07,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.3,
      "end_seconds": 392.72,
      "duration_seconds": 2.42,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.56,
      "end_seconds": 396.67,
      "duration_seconds": 2.11,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.75,
      "end_seconds": 403.04,
      "duration_seconds": 4.29,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.21,
      "end_seconds": 410.14,
      "duration_seconds": 3.93,
      "text": "great, uh, thank you for your help"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.59,
      "end_seconds": 412.83,
      "duration_seconds": 1.24,
      "text": "look after yourself"
    }
  ]
}