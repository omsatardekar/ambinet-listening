{
  "schema_version": "1.0",
  "encounter_id": "03235",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.21,
      "duration_seconds": 3.47,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.32,
      "end_seconds": 10.28,
      "duration_seconds": 4.96,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 19.06,
      "duration_seconds": 6.85,
      "text": "I've been feeling anxious and agitated, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.33,
      "end_seconds": 27.63,
      "duration_seconds": 3.3,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.11,
      "end_seconds": 38.86,
      "duration_seconds": 5.75,
      "text": "Sorry, what was I saying, it's been two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.66,
      "end_seconds": 43.1,
      "duration_seconds": 3.44,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.82,
      "end_seconds": 55.69,
      "duration_seconds": 10.87,
      "text": "About a three out of ten. Oh, and being unable to sleep. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.16,
      "end_seconds": 69.56,
      "duration_seconds": 4.4,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.23,
      "end_seconds": 74.18,
      "duration_seconds": 2.95,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.33,
      "end_seconds": 79.39,
      "duration_seconds": 4.06,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.03,
      "end_seconds": 82.68,
      "duration_seconds": 1.65,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.24,
      "end_seconds": 84.94,
      "duration_seconds": 1.7,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.81,
      "end_seconds": 90.99,
      "duration_seconds": 5.18,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.13,
      "end_seconds": 94.52,
      "duration_seconds": 2.39,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.13,
      "end_seconds": 101.03,
      "duration_seconds": 5.9,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.04,
      "end_seconds": 104.37,
      "duration_seconds": 1.33,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.51,
      "end_seconds": 108.98,
      "duration_seconds": 3.47,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.92,
      "end_seconds": 112.94,
      "duration_seconds": 2.02,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.5,
      "end_seconds": 117.37,
      "duration_seconds": 3.87,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.28,
      "end_seconds": 121.95,
      "duration_seconds": 2.67,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.93,
      "end_seconds": 125.04,
      "duration_seconds": 1.11,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.54,
      "end_seconds": 141.33,
      "duration_seconds": 1.79,
      "text": "How about vomiting blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.95,
      "end_seconds": 149.46,
      "duration_seconds": 2.51,
      "text": "No, none, no vomiting blood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.59,
      "end_seconds": 158.78,
      "duration_seconds": 4.19,
      "text": "Alright, a few quick ones: seizure or seeing things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.17,
      "end_seconds": 162.87,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.07,
      "end_seconds": 167.52,
      "duration_seconds": 3.45,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.8,
      "end_seconds": 171.18,
      "duration_seconds": 2.38,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.49,
      "end_seconds": 188.87,
      "duration_seconds": 2.38,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.22,
      "end_seconds": 197.32,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 219.42,
      "duration_seconds": 7.43,
      "text": "Okay: SpO2 96 percent on room air, pulse 110, temperature is 36.9 degrees, pressure 129 over 74."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.86,
      "end_seconds": 224.97,
      "duration_seconds": 4.11,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.79,
      "end_seconds": 228.81,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 244.89,
      "duration_seconds": 5.98,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.5,
      "end_seconds": 251.2,
      "duration_seconds": 1.7,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 263.95,
      "duration_seconds": 4.81,
      "text": "Okay, so my impression is this: It points towards alcohol withdrawal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.4,
      "end_seconds": 267.96,
      "duration_seconds": 2.56,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.23,
      "end_seconds": 294.02,
      "duration_seconds": 24.79,
      "text": "It's reasonable to be concerned, but right now alcohol withdrawal is my leading thought, not anything worse. Let's book blood tests to look into alcohol withdrawal. For this, thiamine, 100 milligrams, three times a day, long term. That's for alcohol-related deficiency. Do not stop alcohol suddenly without medical support. Let's plan a check in two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.27,
      "end_seconds": 301.35,
      "duration_seconds": 2.08,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.36,
      "end_seconds": 306.51,
      "duration_seconds": 3.15,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.34,
      "end_seconds": 308.9,
      "duration_seconds": 1.56,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.27,
      "end_seconds": 311.57,
      "duration_seconds": 1.3,
      "text": "See you soon."
    }
  ]
}