{
  "schema_version": "1.0",
  "encounter_id": "03398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.26,
      "duration_seconds": 3.46,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 10.83,
      "duration_seconds": 4.54,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.21,
      "end_seconds": 19.95,
      "duration_seconds": 3.74,
      "text": "I'm here because of a bit tired sometimes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.83,
      "end_seconds": 27.34,
      "duration_seconds": 6.51,
      "text": "How long has it been like this? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.15,
      "end_seconds": 31.25,
      "duration_seconds": 3.1,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.63,
      "end_seconds": 35.38,
      "duration_seconds": 2.75,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.54,
      "end_seconds": 39.62,
      "duration_seconds": 3.08,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.45,
      "end_seconds": 46.18,
      "duration_seconds": 4.73,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.84,
      "end_seconds": 50.24,
      "duration_seconds": 3.4,
      "text": "Tramadol. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.96,
      "end_seconds": 56.18,
      "duration_seconds": 4.22,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.91,
      "end_seconds": 61.23,
      "duration_seconds": 3.32,
      "text": "Propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.18,
      "end_seconds": 75.61,
      "duration_seconds": 2.43,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.93,
      "end_seconds": 81.41,
      "duration_seconds": 4.48,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 83.65,
      "duration_seconds": 1.24,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.49,
      "end_seconds": 88.43,
      "duration_seconds": 3.94,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.6,
      "end_seconds": 97.74,
      "duration_seconds": 8.14,
      "text": "What conditions have you been treated for in the past? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.51,
      "end_seconds": 102.25,
      "duration_seconds": 2.74,
      "text": "Migraines, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.14,
      "end_seconds": 114.68,
      "duration_seconds": 2.54,
      "text": "And what about breathlessness or dizziness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.35,
      "end_seconds": 120.4,
      "duration_seconds": 4.05,
      "text": "No breathlessness or dizziness, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.92,
      "end_seconds": 124.11,
      "duration_seconds": 3.19,
      "text": "Have you noticed heavy periods or black stools?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.63,
      "end_seconds": 129.75,
      "duration_seconds": 4.12,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.74,
      "end_seconds": 135.27,
      "duration_seconds": 3.53,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.54,
      "end_seconds": 137.89,
      "duration_seconds": 1.35,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.98,
      "end_seconds": 144.64,
      "duration_seconds": 4.66,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.27,
      "end_seconds": 148.44,
      "duration_seconds": 2.17,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.1,
      "end_seconds": 159.78,
      "duration_seconds": 2.68,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.95,
      "end_seconds": 174.49,
      "duration_seconds": 3.54,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.61,
      "end_seconds": 196.8,
      "duration_seconds": 12.19,
      "text": "Okay: temp 36.6 degrees, BMI works out to 24.8, weight 83 kilos, heart rate 65, pressure 114 over 70, height 183 centimetres, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.79,
      "end_seconds": 199.71,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.56,
      "end_seconds": 203.99,
      "duration_seconds": 2.43,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.79,
      "end_seconds": 210.96,
      "duration_seconds": 4.17,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.84,
      "end_seconds": 214.29,
      "duration_seconds": 2.45,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.51,
      "end_seconds": 233.91,
      "duration_seconds": 6.4,
      "text": "Your pulse and blood pressure are normal and the eyelids are a good colour."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.66,
      "end_seconds": 240.63,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.73,
      "end_seconds": 247.48,
      "duration_seconds": 1.75,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.61,
      "end_seconds": 272.56,
      "duration_seconds": 6.95,
      "text": "So where does that leave us? This looks most like mildly low iron stores risk from diet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.11,
      "end_seconds": 276.9,
      "duration_seconds": 2.79,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.06,
      "end_seconds": 311.59,
      "duration_seconds": 33.53,
      "text": "It's reasonable to be concerned, but right now mildly low iron stores risk from diet is my leading thought, not anything worse. I'll request a B12 level, it'll help with vegetarian diet. I'll request a ferritin level, it'll help with tiredness. Eat pulses, leafy greens and vitamin-C rich foods with meals. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.62,
      "end_seconds": 314.82,
      "duration_seconds": 2.2,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.65,
      "end_seconds": 319.3,
      "duration_seconds": 3.65,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.77,
      "end_seconds": 322.87,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    }
  ]
}