{
  "schema_version": "1.0",
  "encounter_id": "03117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.72,
      "duration_seconds": 3.58,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.83,
      "duration_seconds": 4.65,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.99,
      "end_seconds": 16.09,
      "duration_seconds": 4.1,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.86,
      "end_seconds": 21.42,
      "duration_seconds": 3.56,
      "text": "Well, I've been having three early losses."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.93,
      "end_seconds": 23.11,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.88,
      "end_seconds": 26.53,
      "duration_seconds": 2.65,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.08,
      "end_seconds": 31.68,
      "duration_seconds": 3.6,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.91,
      "end_seconds": 39.81,
      "duration_seconds": 6.9,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.85,
      "end_seconds": 46.69,
      "duration_seconds": 5.84,
      "text": "Okay, take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.95,
      "end_seconds": 50.73,
      "duration_seconds": 2.78,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 59.74,
      "duration_seconds": 8.25,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 59.84,
      "end_seconds": 64.87,
      "duration_seconds": 5.03,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.45,
      "end_seconds": 73.4,
      "duration_seconds": 7.95,
      "text": "I was getting to that! And there's irregular cycles as well, three weeks now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.43,
      "end_seconds": 79.7,
      "duration_seconds": 5.27,
      "text": "Have you had three early losses before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.97,
      "end_seconds": 85.66,
      "duration_seconds": 4.69,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.5,
      "end_seconds": 90.42,
      "duration_seconds": 2.92,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.43,
      "end_seconds": 99.3,
      "duration_seconds": 2.87,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.69,
      "end_seconds": 128.69,
      "duration_seconds": 8.0,
      "text": "Okay: saturation 97 percent, respiratory rate 18, blood pressure 116 over 77, temp 36.6 degrees, pulse 85."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.57,
      "end_seconds": 132.06,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.98,
      "end_seconds": 136.73,
      "duration_seconds": 2.75,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.33,
      "end_seconds": 141.79,
      "duration_seconds": 3.46,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 144.89,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.18,
      "end_seconds": 158.78,
      "duration_seconds": 1.6,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 165.46,
      "duration_seconds": 2.65,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.37,
      "end_seconds": 188.41,
      "duration_seconds": 4.04,
      "text": "Right, have you had any heavy bleeding now or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.94,
      "end_seconds": 200.65,
      "duration_seconds": 10.71,
      "text": "No, no heavy bleeding now, no fever. I was feeling low and anxious at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.68,
      "end_seconds": 205.36,
      "duration_seconds": 2.68,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.06,
      "end_seconds": 207.01,
      "duration_seconds": 0.95,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.7,
      "end_seconds": 216.1,
      "duration_seconds": 8.4,
      "text": "Do you react to any medicines or foods? Any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.72,
      "end_seconds": 224.0,
      "duration_seconds": 3.28,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 227.71,
      "duration_seconds": 1.82,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.42,
      "end_seconds": 231.89,
      "duration_seconds": 2.47,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.39,
      "end_seconds": 234.12,
      "duration_seconds": 1.73,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.51,
      "end_seconds": 238.67,
      "duration_seconds": 3.16,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.64,
      "end_seconds": 242.9,
      "duration_seconds": 2.26,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.23,
      "end_seconds": 246.88,
      "duration_seconds": 2.65,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.29,
      "end_seconds": 249.59,
      "duration_seconds": 1.3,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.57,
      "end_seconds": 254.45,
      "duration_seconds": 3.88,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.0,
      "end_seconds": 259.24,
      "duration_seconds": 4.24,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.46,
      "end_seconds": 262.9,
      "duration_seconds": 2.44,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.65,
      "end_seconds": 268.72,
      "duration_seconds": 4.07,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.62,
      "end_seconds": 272.86,
      "duration_seconds": 2.24,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.79,
      "end_seconds": 276.34,
      "duration_seconds": 2.55,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.62,
      "end_seconds": 285.0,
      "duration_seconds": 7.38,
      "text": "I've got anxiety. I've, I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.95,
      "end_seconds": 287.81,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.85,
      "end_seconds": 301.2,
      "duration_seconds": 12.35,
      "text": "Yes, diabetes. Work has been very busy so I kept ignoring it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.7,
      "end_seconds": 306.78,
      "duration_seconds": 5.08,
      "text": "Understood. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.33,
      "end_seconds": 323.54,
      "duration_seconds": 15.21,
      "text": "Lansoprazole. I take it 30 milligrams, before breakfast for my acidity. My sister suggested writing things down, but I forgot. Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.53,
      "end_seconds": 332.69,
      "duration_seconds": 7.16,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.7,
      "end_seconds": 337.56,
      "duration_seconds": 2.86,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.39,
      "end_seconds": 360.99,
      "duration_seconds": 22.6,
      "text": "For my pressure, I believe. My husband sets them out for me, I just take what I'm given. It's Glycomet, 500 milligrams, twice a day for my sugar. I had sitagliptin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.43,
      "end_seconds": 382.44,
      "duration_seconds": 20.01,
      "text": "Okay, so my impression is this: This looks most like recurrent miscarriage needing investigation. I'd also keep a thyroid problem in mind. So, to recap quickly. You've had three early losses for about two weeks, severe, and no heavy bleeding now or fever."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.94,
      "end_seconds": 385.92,
      "duration_seconds": 1.98,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.6,
      "end_seconds": 414.18,
      "duration_seconds": 9.58,
      "text": "Let's book a pelvic ultrasound to look into recurrent miscarriage. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.47,
      "end_seconds": 417.71,
      "duration_seconds": 2.24,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.42,
      "end_seconds": 444.19,
      "duration_seconds": 24.77,
      "text": "Blood tests is what I'd like next, for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. Don't skip meals, and try to eat smaller portions more often through the day. The recurrent miscarriage clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.09,
      "end_seconds": 448.46,
      "duration_seconds": 2.37,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.0,
      "end_seconds": 452.14,
      "duration_seconds": 2.14,
      "text": "Come back after the results."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.17,
      "end_seconds": 455.36,
      "duration_seconds": 2.19,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.45,
      "end_seconds": 460.29,
      "duration_seconds": 2.84,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 460.83,
      "end_seconds": 463.26,
      "duration_seconds": 2.43,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.31,
      "end_seconds": 466.53,
      "duration_seconds": 1.22,
      "text": "Goodbye for now."
    }
  ]
}