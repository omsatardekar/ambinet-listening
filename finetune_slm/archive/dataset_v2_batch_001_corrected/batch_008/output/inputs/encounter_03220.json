  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 2.52,
      "duration_seconds": 1.67,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.06,
      "end_seconds": 7.69,
      "duration_seconds": 4.63,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.9,
      "end_seconds": 14.56,
      "duration_seconds": 5.66,
      "text": "I've been dealing with a pearly bump on my nose that bleeds."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.32,
      "end_seconds": 20.17,
      "duration_seconds": 3.85,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.23,
      "end_seconds": 25.83,
      "duration_seconds": 3.6,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.04,
      "end_seconds": 33.38,
      "duration_seconds": 2.34,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.82,
      "end_seconds": 37.25,
      "duration_seconds": 2.43,
      "text": "Washing definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.49,
      "end_seconds": 40.99,
      "duration_seconds": 2.5,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.57,
      "end_seconds": 49.61,
      "duration_seconds": 7.04,
      "text": "I was told I'm allergic to amoxicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.6,
      "end_seconds": 53.27,
      "duration_seconds": 2.67,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.28,
      "end_seconds": 58.27,
      "duration_seconds": 2.99,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.23,
      "end_seconds": 62.45,
      "duration_seconds": 3.22,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.54,
      "end_seconds": 69.0,
      "duration_seconds": 4.46,
      "text": "I'm on naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.17,
      "end_seconds": 86.57,
      "duration_seconds": 2.4,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.72,
      "end_seconds": 92.65,
      "duration_seconds": 3.93,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 95.93,
      "duration_seconds": 2.19,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.4,
      "end_seconds": 101.81,
      "duration_seconds": 4.41,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.04,
      "end_seconds": 117.89,
      "duration_seconds": 2.85,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.38,
      "end_seconds": 122.74,
      "duration_seconds": 3.36,
      "text": "Okay, so no, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.33,
      "end_seconds": 126.92,
      "duration_seconds": 3.59,
      "text": "any other new lumps or pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 132.79,
      "duration_seconds": 5.2,
      "text": "No other new lumps or pain, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.69,
      "end_seconds": 137.35,
      "duration_seconds": 2.66,
      "text": "Did you notice any swollen glands?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.58,
      "end_seconds": 141.23,
      "duration_seconds": 2.65,
      "text": "no, none, no swollen glands"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.36,
      "end_seconds": 145.37,
      "duration_seconds": 3.01,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.64,
      "end_seconds": 148.42,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.22,
      "end_seconds": 153.67,
      "duration_seconds": 3.45,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.06,
      "end_seconds": 157.07,
      "duration_seconds": 2.01,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.18,
      "end_seconds": 162.6,
      "duration_seconds": 4.42,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.03,
      "end_seconds": 176.32,
      "duration_seconds": 2.29,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.3,
      "end_seconds": 210.45,
      "duration_seconds": 12.15,
      "text": "Okay: temp 36.8 degrees, BP is 125 over 72, saturation 97 percent. And respiratory rate 17, height 155 centimetres, pulse is 85 beats a minute, weight 82 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.22,
      "end_seconds": 215.22,
      "duration_seconds": 2.0,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.49,
      "end_seconds": 219.19,
      "duration_seconds": 2.7,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.17,
      "end_seconds": 238.1,
      "duration_seconds": 7.93,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.05,
      "end_seconds": 248.84,
      "duration_seconds": 1.79,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.32,
      "end_seconds": 265.7,
      "duration_seconds": 11.38,
      "text": "Good, you can sit up again. Let me tell you where I've got to. I'd lean towards a a likely basal cell carcinoma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.73,
      "end_seconds": 287.68,
      "duration_seconds": 12.95,
      "text": "We should do a skin biopsy for suspicious lesion. Please use a high-factor sunscreen and a hat. I think the skin cancer clinic should see you too."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.43,
      "end_seconds": 289.13,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.73,
      "end_seconds": 294.35,
      "duration_seconds": 3.62,
      "text": "I'd like to see you again after the biopsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.48,
      "end_seconds": 297.35,
      "duration_seconds": 1.87,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.39,
      "end_seconds": 302.18,
      "duration_seconds": 3.79,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.24,
      "end_seconds": 306.26,
      "duration_seconds": 3.02,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}