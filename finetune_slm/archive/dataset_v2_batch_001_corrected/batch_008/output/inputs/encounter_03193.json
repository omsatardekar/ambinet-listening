{
  "schema_version": "1.0",
  "encounter_id": "03193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 4.8,
      "duration_seconds": 4.0,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.88,
      "end_seconds": 9.64,
      "duration_seconds": 3.76,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.02,
      "end_seconds": 18.68,
      "duration_seconds": 7.66,
      "text": "Honestly, it's a sudden severe tummy pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.8,
      "end_seconds": 23.2,
      "duration_seconds": 3.4,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.16,
      "end_seconds": 37.29,
      "duration_seconds": 11.13,
      "text": "It's been going on for three weeks. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.35,
      "end_seconds": 41.45,
      "duration_seconds": 2.1,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.63,
      "end_seconds": 49.54,
      "duration_seconds": 2.91,
      "text": "Well, lying still helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.85,
      "end_seconds": 53.77,
      "duration_seconds": 3.92,
      "text": "Hm, okay. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.27,
      "end_seconds": 74.73,
      "duration_seconds": 20.46,
      "text": "When it starts I tend to get shoulder tip pain as well. The shoulder tip pain? That's been for about a week. With shoulder tip pain, pretty moderate, if I'm being honest. Oh, and pain spreading all over."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.81,
      "end_seconds": 79.14,
      "duration_seconds": 3.33,
      "text": "Right, and what about diarrhoea or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.89,
      "end_seconds": 82.85,
      "duration_seconds": 2.96,
      "text": "Oh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 88.3,
      "duration_seconds": 3.53,
      "text": "And blood in the vomit, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.15,
      "end_seconds": 94.73,
      "duration_seconds": 4.58,
      "text": "Not at all, no blood in the vomit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.44,
      "end_seconds": 99.01,
      "duration_seconds": 2.57,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.52,
      "end_seconds": 102.17,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.18,
      "end_seconds": 116.88,
      "duration_seconds": 3.7,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 135.55,
      "duration_seconds": 14.88,
      "text": "Tiotropium inhaler. I take it once a day for my chest. Naproxen, 250 milligrams, twice a day. I'm on ibuprofen, 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 138.38,
      "duration_seconds": 2.06,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 144.46,
      "duration_seconds": 4.84,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 148.98,
      "duration_seconds": 3.43,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.84,
      "end_seconds": 152.16,
      "duration_seconds": 2.32,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.84,
      "end_seconds": 172.9,
      "duration_seconds": 3.06,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.52,
      "end_seconds": 197.65,
      "duration_seconds": 21.13,
      "text": "I gave up cigarettes last spring. I used to drink heavily but I stopped four years ago. I'm vegetarian and have been for years. Yes, I work in a bakery, early starts. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.04,
      "end_seconds": 209.83,
      "duration_seconds": 3.79,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.92,
      "end_seconds": 222.32,
      "duration_seconds": 10.4,
      "text": "I have COPD. I have an underactive thyroid, for about ten years. I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.43,
      "end_seconds": 230.0,
      "duration_seconds": 6.57,
      "text": "I see, go ahead. Okay, I can see an underactive thyroid in your file as well."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 231.57,
      "end_seconds": 239.89,
      "duration_seconds": 8.32,
      "text": "Here are the numbers, doctor. Pulse 124, saturation 97 percent, BP is 118 over 78, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.48,
      "end_seconds": 241.18,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.62,
      "end_seconds": 246.57,
      "duration_seconds": 3.95,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.36,
      "end_seconds": 250.0,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 253.72,
      "duration_seconds": 2.11,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.3,
      "end_seconds": 269.55,
      "duration_seconds": 7.25,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.9,
      "end_seconds": 283.63,
      "duration_seconds": 10.73,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, the most likely explanation is a perforated stomach ulcer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.33,
      "end_seconds": 286.26,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.19,
      "end_seconds": 309.54,
      "duration_seconds": 22.35,
      "text": "It's reasonable to be concerned, but right now a perforated stomach ulcer is my leading thought, not anything worse. I'm going to order an erect chest X-ray, for possible perforation. Nothing to eat or drink, you need an operation urgently. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.78,
      "end_seconds": 312.57,
      "duration_seconds": 1.79,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.47,
      "end_seconds": 318.02,
      "duration_seconds": 3.55,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.61,
      "end_seconds": 322.03,
      "duration_seconds": 2.42,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}