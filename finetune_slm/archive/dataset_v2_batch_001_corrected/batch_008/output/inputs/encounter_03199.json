{
  "schema_version": "1.0",
  "encounter_id": "03199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.43,
      "duration_seconds": 5.17,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.52,
      "end_seconds": 12.34,
      "duration_seconds": 3.82,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.56,
      "end_seconds": 23.66,
      "duration_seconds": 8.1,
      "text": "Doctor, it's a pearly bump on my nose that bleeds. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.29,
      "end_seconds": 25.57,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.99,
      "end_seconds": 33.69,
      "duration_seconds": 6.7,
      "text": "Around about a month... no wait, uh, it's more like about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.47,
      "end_seconds": 36.85,
      "duration_seconds": 2.38,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.35,
      "end_seconds": 48.21,
      "duration_seconds": 6.86,
      "text": "It's worse with washing. I've also had a sore that won't heal, for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.16,
      "end_seconds": 53.02,
      "duration_seconds": 2.86,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.83,
      "end_seconds": 60.42,
      "duration_seconds": 5.59,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.92,
      "end_seconds": 62.23,
      "duration_seconds": 1.31,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 77.83,
      "duration_seconds": 5.94,
      "text": "And what about swollen glands, family history of skin cancer or other new lumps?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.95,
      "end_seconds": 89.67,
      "duration_seconds": 8.72,
      "text": "No swollen glands, family history of skin cancer or other new lumps, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.86,
      "end_seconds": 92.82,
      "duration_seconds": 1.96,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.15,
      "end_seconds": 97.41,
      "duration_seconds": 3.26,
      "text": "Ah, no, that side's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.65,
      "end_seconds": 102.23,
      "duration_seconds": 3.58,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.2,
      "end_seconds": 104.92,
      "duration_seconds": 1.72,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.42,
      "end_seconds": 110.59,
      "duration_seconds": 4.17,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.32,
      "end_seconds": 116.85,
      "duration_seconds": 4.53,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.09,
      "end_seconds": 121.15,
      "duration_seconds": 3.06,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.43,
      "end_seconds": 125.08,
      "duration_seconds": 2.65,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.35,
      "end_seconds": 141.82,
      "duration_seconds": 1.47,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.67,
      "end_seconds": 147.48,
      "duration_seconds": 3.81,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.43,
      "end_seconds": 151.22,
      "duration_seconds": 2.79,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.0,
      "end_seconds": 156.49,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.08,
      "end_seconds": 159.96,
      "duration_seconds": 2.88,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.23,
      "end_seconds": 165.19,
      "duration_seconds": 3.96,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.37,
      "end_seconds": 173.6,
      "duration_seconds": 3.23,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.38,
      "end_seconds": 182.39,
      "duration_seconds": 2.01,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 208.01,
      "duration_seconds": 6.14,
      "text": "Okay: respiratory rate 17, BP is 125 over 78, pulse 69. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.04,
      "end_seconds": 210.69,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.84,
      "end_seconds": 214.85,
      "duration_seconds": 3.01,
      "text": "So, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.03,
      "end_seconds": 218.88,
      "duration_seconds": 2.85,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.8,
      "end_seconds": 223.84,
      "duration_seconds": 3.04,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.07,
      "end_seconds": 243.04,
      "duration_seconds": 7.97,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.62,
      "end_seconds": 249.92,
      "duration_seconds": 2.3,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.4,
      "end_seconds": 272.0,
      "duration_seconds": 5.6,
      "text": "Okay, so my impression is this: It points towards a likely basal cell carcinoma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.7,
      "end_seconds": 276.47,
      "duration_seconds": 2.77,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.27,
      "end_seconds": 292.38,
      "duration_seconds": 14.11,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely basal cell carcinoma. There's nothing new for me to start or arrange today. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.96,
      "end_seconds": 300.35,
      "duration_seconds": 3.39,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.19,
      "end_seconds": 302.41,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}