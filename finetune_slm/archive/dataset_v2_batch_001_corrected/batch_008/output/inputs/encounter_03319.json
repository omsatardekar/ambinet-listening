{
  "schema_version": "1.0",
  "encounter_id": "03319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 2.43,
      "duration_seconds": 1.62,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.48,
      "end_seconds": 7.96,
      "duration_seconds": 4.48,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.04,
      "end_seconds": 12.76,
      "duration_seconds": 3.72,
      "text": "Mm, I've been dealing with three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.96,
      "end_seconds": 17.41,
      "duration_seconds": 3.45,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.11,
      "end_seconds": 21.12,
      "duration_seconds": 3.01,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 25.94,
      "duration_seconds": 2.88,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.85,
      "end_seconds": 30.54,
      "duration_seconds": 2.69,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.54,
      "end_seconds": 37.73,
      "duration_seconds": 3.19,
      "text": "Have you been feeling low and anxious?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.45,
      "end_seconds": 40.6,
      "duration_seconds": 1.15,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.34,
      "end_seconds": 57.83,
      "duration_seconds": 3.49,
      "text": "Alright, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 62.29,
      "duration_seconds": 2.48,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.65,
      "end_seconds": 68.34,
      "duration_seconds": 4.69,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.42,
      "end_seconds": 71.44,
      "duration_seconds": 2.02,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.44,
      "end_seconds": 75.1,
      "duration_seconds": 2.66,
      "text": "Okay, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.12,
      "end_seconds": 78.87,
      "duration_seconds": 2.75,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.38,
      "end_seconds": 83.29,
      "duration_seconds": 2.91,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.81,
      "end_seconds": 88.11,
      "duration_seconds": 3.3,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.93,
      "end_seconds": 95.26,
      "duration_seconds": 2.33,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.37,
      "end_seconds": 100.2,
      "duration_seconds": 3.83,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.27,
      "end_seconds": 104.05,
      "duration_seconds": 2.78,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.31,
      "end_seconds": 108.71,
      "duration_seconds": 3.4,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.22,
      "end_seconds": 113.25,
      "duration_seconds": 4.03,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.33,
      "end_seconds": 119.13,
      "duration_seconds": 2.8,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.17,
      "end_seconds": 123.5,
      "duration_seconds": 3.33,
      "text": "Have you had any heavy bleeding now?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.78,
      "end_seconds": 127.14,
      "duration_seconds": 2.36,
      "text": "Definitely no heavy bleeding now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.72,
      "end_seconds": 131.23,
      "duration_seconds": 3.51,
      "text": "Have you had any fever or clotting problem?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.13,
      "end_seconds": 134.51,
      "duration_seconds": 2.38,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.02,
      "end_seconds": 137.93,
      "duration_seconds": 2.91,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.71,
      "end_seconds": 139.67,
      "duration_seconds": 0.96,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.81,
      "end_seconds": 154.81,
      "duration_seconds": 3.0,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.56,
      "end_seconds": 163.94,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.41,
      "end_seconds": 181.48,
      "duration_seconds": 7.07,
      "text": "Okay: heart rate 72, temperature 37.0, blood pressure 116 over 76, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.91,
      "end_seconds": 186.93,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.47,
      "end_seconds": 190.29,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.66,
      "end_seconds": 205.56,
      "duration_seconds": 1.9,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.91,
      "end_seconds": 212.37,
      "duration_seconds": 2.46,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.27,
      "end_seconds": 237.63,
      "duration_seconds": 7.36,
      "text": "From what you've told me and what I found, I'd lean towards recurrent miscarriage needing investigation."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.89,
      "end_seconds": 241.64,
      "duration_seconds": 2.75,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.98,
      "end_seconds": 252.81,
      "duration_seconds": 9.83,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the a pelvic ultrasound is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.57,
      "end_seconds": 267.86,
      "duration_seconds": 4.29,
      "text": "I'm sending you for a pelvic ultrasound because of recurrent miscarriage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.79,
      "end_seconds": 270.48,
      "duration_seconds": 1.69,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.49,
      "end_seconds": 283.33,
      "duration_seconds": 10.84,
      "text": "We will arrange specialist care so the next pregnancy is looked after from the start. I'm going to send a referral to the recurrent miscarriage clinic."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.53,
      "end_seconds": 286.21,
      "duration_seconds": 1.68,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.85,
      "end_seconds": 294.45,
      "duration_seconds": 6.6,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.21,
      "end_seconds": 298.22,
      "duration_seconds": 3.01,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.83,
      "end_seconds": 307.69,
      "duration_seconds": 8.86,
      "text": "I'd like you back after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.21,
      "end_seconds": 311.98,
      "duration_seconds": 3.77,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.0,
      "end_seconds": 315.31,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}