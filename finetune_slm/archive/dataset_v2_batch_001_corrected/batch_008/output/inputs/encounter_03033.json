{
  "schema_version": "1.0",
  "encounter_id": "03033",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 6.63,
      "duration_seconds": 5.79,
      "text": "I mean, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 12.51,
      "duration_seconds": 4.28,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.67,
      "end_seconds": 19.66,
      "duration_seconds": 5.99,
      "text": "Uh, you know, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.38,
      "end_seconds": 24.61,
      "duration_seconds": 4.23,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.73,
      "end_seconds": 34.04,
      "duration_seconds": 8.31,
      "text": "It's a sudden severe tummy pain, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.29,
      "end_seconds": 36.66,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.28,
      "end_seconds": 41.48,
      "duration_seconds": 3.2,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.27,
      "end_seconds": 46.94,
      "duration_seconds": 4.67,
      "text": "It, It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.83,
      "end_seconds": 53.2,
      "duration_seconds": 4.37,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.12,
      "end_seconds": 58.76,
      "duration_seconds": 3.64,
      "text": "Okay, so that sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.87,
      "end_seconds": 64.81,
      "duration_seconds": 4.94,
      "text": "So, what about pain spreading all over, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.94,
      "end_seconds": 82.02,
      "duration_seconds": 12.08,
      "text": "Uh, uh, yes, for five days. With pain spreading all over, mostly severe. Erm, there's shoulder tip pain as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.17,
      "end_seconds": 85.87,
      "duration_seconds": 2.7,
      "text": "Any diarrhoea or fever at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.97,
      "end_seconds": 90.66,
      "duration_seconds": 2.69,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 94.2,
      "duration_seconds": 2.96,
      "text": "How about blood in the vomit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 98.98,
      "duration_seconds": 3.39,
      "text": "Nope, no blood in the vomit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.02,
      "end_seconds": 105.61,
      "duration_seconds": 2.59,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.77,
      "end_seconds": 109.95,
      "duration_seconds": 3.18,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.32,
      "end_seconds": 117.36,
      "duration_seconds": 3.04,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.78,
      "end_seconds": 125.61,
      "duration_seconds": 6.83,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.19,
      "end_seconds": 135.24,
      "duration_seconds": 2.05,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.21,
      "end_seconds": 140.41,
      "duration_seconds": 4.2,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.12,
      "end_seconds": 142.59,
      "duration_seconds": 1.47,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.21,
      "end_seconds": 146.29,
      "duration_seconds": 3.08,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.29,
      "end_seconds": 150.22,
      "duration_seconds": 2.93,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.63,
      "end_seconds": 156.43,
      "duration_seconds": 4.8,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.04,
      "end_seconds": 159.8,
      "duration_seconds": 2.76,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 164.52,
      "duration_seconds": 4.12,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.71,
      "end_seconds": 178.52,
      "duration_seconds": 2.81,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.05,
      "end_seconds": 186.67,
      "duration_seconds": 6.62,
      "text": "I have high cholesterol. Um, I have depression, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.09,
      "end_seconds": 193.23,
      "duration_seconds": 5.14,
      "text": "Yes, depression is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.96,
      "end_seconds": 211.79,
      "duration_seconds": 2.83,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.71,
      "end_seconds": 220.94,
      "duration_seconds": 8.23,
      "text": "Oh, um, my grandfather had a stroke. Okay, so my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.99,
      "end_seconds": 225.33,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.26,
      "end_seconds": 230.06,
      "duration_seconds": 3.8,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.38,
      "end_seconds": 235.03,
      "duration_seconds": 3.65,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.75,
      "end_seconds": 240.69,
      "duration_seconds": 4.94,
      "text": "Rosuvastatin. I take it at night for my cholesterol."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.14,
      "end_seconds": 248.17,
      "duration_seconds": 3.03,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.5,
      "end_seconds": 260.03,
      "duration_seconds": 10.53,
      "text": "10 milligrams. Yeah, I take mirtazapine, 15 milligrams, at night. I was on simvastatin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.58,
      "end_seconds": 263.04,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.13,
      "end_seconds": 273.78,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.87,
      "end_seconds": 296.07,
      "duration_seconds": 7.2,
      "text": "Okay: blood pressure 116 over 79, pulse is 108 beats a minute, respiratory rate 20."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.02,
      "end_seconds": 301.69,
      "duration_seconds": 2.67,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.73,
      "end_seconds": 304.84,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.37,
      "end_seconds": 308.37,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.19,
      "end_seconds": 330.48,
      "duration_seconds": 8.29,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.32,
      "end_seconds": 364.89,
      "duration_seconds": 31.57,
      "text": "Good, you can sit up again. So where does that leave us? This looks most like a perforated stomach ulcer. I'd also keep pancreatitis in mind. Let's get a CT scan, for possible perforation. It's a routine test and it'll give us a much clearer picture. I'll request an erect chest X-ray, it'll help with possible perforation. Nothing to eat or drink, you need an operation urgently."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.2,
      "end_seconds": 370.81,
      "duration_seconds": 4.61,
      "text": "Can you send me for urgent blood tests?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.91,
      "end_seconds": 380.85,
      "duration_seconds": 8.94,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Come back straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.68,
      "end_seconds": 386.56,
      "duration_seconds": 3.88,
      "text": "Mm, you know, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.85,
      "end_seconds": 394.13,
      "duration_seconds": 6.28,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.37,
      "end_seconds": 400.61,
      "duration_seconds": 5.24,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.71,
      "end_seconds": 407.15,
      "duration_seconds": 5.44,
      "text": "Okay, yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.55,
      "end_seconds": 414.16,
      "duration_seconds": 1.61,
      "text": "That's clear, thanks."
    }
  ]
}