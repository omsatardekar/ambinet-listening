    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.45,
      "end_seconds": 100.71,
      "duration_seconds": 3.26,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.55,
      "end_seconds": 104.41,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.24,
      "end_seconds": 109.19,
      "duration_seconds": 3.95,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.79,
      "end_seconds": 116.03,
      "duration_seconds": 6.24,
      "text": "Any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.58,
      "end_seconds": 119.69,
      "duration_seconds": 2.11,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.65,
      "end_seconds": 139.34,
      "duration_seconds": 2.69,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.89,
      "end_seconds": 143.59,
      "duration_seconds": 3.7,
      "text": "actually, no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.8,
      "end_seconds": 148.28,
      "duration_seconds": 3.48,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 154.86,
      "duration_seconds": 5.66,
      "text": "Actually, you know, yes, cat fur, it gives me sneezing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.77,
      "end_seconds": 166.13,
      "duration_seconds": 2.36,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.21,
      "end_seconds": 177.61,
      "duration_seconds": 2.4,
      "text": "Nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.69,
      "end_seconds": 203.05,
      "duration_seconds": 7.36,
      "text": "Okay: heart rate 68, SpO2 98 percent on room air, BP is 109 over 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.78,
      "end_seconds": 206.38,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.31,
      "end_seconds": 211.27,
      "duration_seconds": 3.96,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.73,
      "end_seconds": 218.57,
      "duration_seconds": 4.84,
      "text": "Right, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.65,
      "end_seconds": 221.1,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.72,
      "end_seconds": 246.21,
      "duration_seconds": 6.49,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.8,
      "end_seconds": 267.67,
      "duration_seconds": 2.87,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.39,
      "end_seconds": 305.21,
      "duration_seconds": 32.82,
      "text": "That's all I needed to check. So, based on the history and the examination, this looks most like severe hypothermia. I'd like to arrange blood tests for hypothermia. Handle gently and warm slowly with warm blankets and warm fluids through the drip. I'm gonna send a referral to the emergency team. Let's hold off on a blood sugar for now, and if there's no change in a month we can revisit it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 320.9,
      "duration_seconds": 14.59,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.79,
      "end_seconds": 326.55,
      "duration_seconds": 3.76,
      "text": "Alright, you know, thanks, take care."
    }
  ]
