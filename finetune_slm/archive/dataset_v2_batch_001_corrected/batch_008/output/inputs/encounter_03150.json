      "role": "PATIENT",
      "start_seconds": 36.8,
      "end_seconds": 43.0,
      "duration_seconds": 6.2,
      "text": "I've had being found cold and drowsy too, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.76,
      "end_seconds": 47.44,
      "duration_seconds": 1.68,
      "text": "Any fall or alcohol?"
