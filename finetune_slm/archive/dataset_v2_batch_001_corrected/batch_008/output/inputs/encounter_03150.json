      "role": "PATIENT",
      "start_seconds": 67.89,
      "end_seconds": 69.26,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 83.94,
