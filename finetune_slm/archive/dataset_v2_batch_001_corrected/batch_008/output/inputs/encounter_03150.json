      "role": "DOCTOR",
      "start_seconds": 8.04,
      "end_seconds": 13.31,
      "duration_seconds": 5.27,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.79,
      "end_seconds": 23.28,
      "duration_seconds": 7.49,
      "text": "it's shivering that has stopped i thought I'd wait, but it hasn't gone"
    },
    {
