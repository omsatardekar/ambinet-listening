    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 33.71,
      "duration_seconds": 3.54,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.97,
      "end_seconds": 35.79,
      "duration_seconds": 1.82,
      "text": "I see, go ahead."
