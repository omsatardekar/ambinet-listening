    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.98,
      "end_seconds": 87.9,
      "duration_seconds": 1.92,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.55,
      "end_seconds": 92.48,
      "duration_seconds": 2.93,
      "text": "do you follow any particular diet?"
