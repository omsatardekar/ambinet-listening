{
  "schema_version": "1.0",
  "encounter_id": "03056",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.43,
      "duration_seconds": 2.45,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.37,
      "end_seconds": 5.43,
      "duration_seconds": 1.06,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.31,
      "end_seconds": 9.23,
      "duration_seconds": 1.92,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.8,
      "end_seconds": 16.73,
      "duration_seconds": 5.93,
      "text": "I, I wanted to get nausea after the chemotherapy looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.88,
      "end_seconds": 23.72,
      "duration_seconds": 2.84,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.34,
      "end_seconds": 34.42,
      "duration_seconds": 6.08,
      "text": "Actually, I'd say six months. Actually, no, closer to about three months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.41,
      "end_seconds": 40.03,
      "duration_seconds": 4.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.13,
      "end_seconds": 57.01,
      "duration_seconds": 11.88,
      "text": "Moderate, I'd say. It happens every other day. Antisickness tablets helps a bit. I've also had numb fingertips, for five days"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.23,
      "end_seconds": 61.05,
      "duration_seconds": 2.82,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.92,
      "end_seconds": 64.03,
      "duration_seconds": 1.11,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.77,
      "end_seconds": 66.68,
      "duration_seconds": 1.91,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.42,
      "end_seconds": 72.35,
      "duration_seconds": 3.93,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.11,
      "end_seconds": 76.62,
      "duration_seconds": 2.51,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.03,
      "end_seconds": 81.62,
      "duration_seconds": 3.59,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.93,
      "end_seconds": 85.89,
      "duration_seconds": 2.96,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.75,
      "end_seconds": 89.47,
      "duration_seconds": 2.72,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.31,
      "end_seconds": 91.62,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.27,
      "end_seconds": 94.2,
      "duration_seconds": 1.93,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.93,
      "end_seconds": 110.5,
      "duration_seconds": 2.57,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.16,
      "end_seconds": 121.51,
      "duration_seconds": 9.35,
      "text": "I, I take furosemide, 40 milligrams, every morning. Ondansetron. I take it 8 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.37,
      "end_seconds": 127.7,
      "duration_seconds": 4.33,
      "text": "Have you got the the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.53,
      "end_seconds": 132.5,
      "duration_seconds": 2.97,
      "text": "ah, no, it's at home"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 137.9,
      "duration_seconds": 4.54,
      "text": "what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.75,
      "end_seconds": 140.24,
      "duration_seconds": 1.49,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.37,
      "end_seconds": 142.07,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.74,
      "end_seconds": 155.39,
      "duration_seconds": 3.65,
      "text": "So, have you noticed breathlessness, fever or bleeding?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.85,
      "end_seconds": 160.7,
      "duration_seconds": 3.85,
      "text": "mm, no, none of those at all"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 163.75,
      "duration_seconds": 1.59,
      "text": "Any sign of shivering?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.53,
      "end_seconds": 167.98,
      "duration_seconds": 3.45,
      "text": "Um, I haven't noticed any shivering."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.79,
      "end_seconds": 171.38,
      "duration_seconds": 2.59,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.39,
      "end_seconds": 175.51,
      "duration_seconds": 2.12,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.52,
      "end_seconds": 180.92,
      "duration_seconds": 3.4,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.79,
      "end_seconds": 193.25,
      "duration_seconds": 2.46,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.71,
      "end_seconds": 219.11,
      "duration_seconds": 7.4,
      "text": "Okay: saturation 98 percent, BP is 116 over 69, respiratory rate 17, heart rate 81."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.1,
      "end_seconds": 224.97,
      "duration_seconds": 2.87,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.51,
      "end_seconds": 228.3,
      "duration_seconds": 2.79,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.42,
      "end_seconds": 231.84,
      "duration_seconds": 2.42,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 248.35,
      "duration_seconds": 4.69,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.44,
      "end_seconds": 258.88,
      "duration_seconds": 7.44,
      "text": "All finished, thank you. Right, here's what I'm thinking. I'd lean towards expected chemotherapy side effects."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.24,
      "end_seconds": 262.32,
      "duration_seconds": 2.08,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.83,
      "end_seconds": 273.38,
      "duration_seconds": 9.55,
      "text": "I understand the worry. At the moment I'd say it's expected chemotherapy side effects, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.12,
      "end_seconds": 302.9,
      "duration_seconds": 18.78,
      "text": "Call the chemotherapy helpline straight away if your temperature goes over 37.5. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.76,
      "end_seconds": 307.21,
      "duration_seconds": 2.45,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}