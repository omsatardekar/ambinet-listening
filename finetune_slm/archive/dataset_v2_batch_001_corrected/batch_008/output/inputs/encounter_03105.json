{
  "schema_version": "1.0",
  "encounter_id": "03105",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.37,
      "duration_seconds": 4.3,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 10.09,
      "duration_seconds": 3.95,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.15,
      "end_seconds": 18.66,
      "duration_seconds": 6.51,
      "text": "Um, so... being found cold and drowsy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 22.14,
      "duration_seconds": 2.91,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.16,
      "end_seconds": 38.03,
      "duration_seconds": 11.87,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.01,
      "end_seconds": 43.79,
      "duration_seconds": 3.78,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.12,
      "end_seconds": 55.74,
      "duration_seconds": 10.62,
      "text": "Let me think, pretty mild, if I'm being honest. Oh, uh, and confusion. That's been about the same, three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.47,
      "end_seconds": 60.0,
      "duration_seconds": 3.53,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.31,
      "end_seconds": 64.89,
      "duration_seconds": 3.58,
      "text": "Yeah, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.77,
      "end_seconds": 68.36,
      "duration_seconds": 2.59,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 74.82,
      "duration_seconds": 4.57,
      "text": "Mm, I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 79.99,
      "duration_seconds": 4.0,
      "text": "Hm, okay. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.7,
      "end_seconds": 86.37,
      "duration_seconds": 5.67,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.91,
      "end_seconds": 91.5,
      "duration_seconds": 4.59,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.89,
      "end_seconds": 107.68,
      "duration_seconds": 11.79,
      "text": "Not much, I mostly stay in these days. Yes, I work in a bakery, early starts. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.94,
      "end_seconds": 129.08,
      "duration_seconds": 5.14,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.29,
      "end_seconds": 134.81,
      "duration_seconds": 4.52,
      "text": "Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.48,
      "end_seconds": 138.11,
      "duration_seconds": 1.63,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 140.83,
      "duration_seconds": 1.86,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.99,
      "end_seconds": 147.44,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.41,
      "end_seconds": 157.27,
      "duration_seconds": 3.86,
      "text": "Yeah, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.09,
      "end_seconds": 173.22,
      "duration_seconds": 3.13,
      "text": "Alright, any fall, alcohol or head injury?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.1,
      "end_seconds": 176.39,
      "duration_seconds": 2.29,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.19,
      "end_seconds": 182.05,
      "duration_seconds": 1.86,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.07,
      "end_seconds": 188.97,
      "duration_seconds": 2.9,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.89,
      "end_seconds": 192.09,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.12,
      "end_seconds": 200.79,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.67,
      "end_seconds": 228.7,
      "duration_seconds": 11.03,
      "text": "Okay: temperature is 36.7 degrees, oxygen saturation is 98 percent, blood pressure 126 over 70. And pulse is 78 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.96,
      "end_seconds": 234.77,
      "duration_seconds": 4.81,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.97,
      "end_seconds": 237.44,
      "duration_seconds": 1.47,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.32,
      "end_seconds": 257.04,
      "duration_seconds": 6.72,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.88,
      "end_seconds": 262.79,
      "duration_seconds": 1.91,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.4,
      "end_seconds": 283.0,
      "duration_seconds": 6.6,
      "text": "From what you've told me and what I found, my working impression is severe hypothermia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.73,
      "end_seconds": 286.65,
      "duration_seconds": 2.92,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.01,
      "end_seconds": 314.48,
      "duration_seconds": 24.47,
      "text": "I can't promise yet, but most people with severe hypothermia do well once it's treated properly. Let's get a blood sugar, for hypothermia. We should do blood tests for hypothermia. Handle gently and warm slowly with warm blankets and warm fluids through the drip. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.98,
      "end_seconds": 331.6,
      "duration_seconds": 16.62,
      "text": "Mm, okay. I think the emergency team should see you too. One warning sign to remember: the symptoms get worse. In that case don't wait. Please come and see me straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.92,
      "end_seconds": 334.51,
      "duration_seconds": 1.59,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.18,
      "end_seconds": 337.6,
      "duration_seconds": 1.42,
      "text": "Take care now."
    }
  ]
}