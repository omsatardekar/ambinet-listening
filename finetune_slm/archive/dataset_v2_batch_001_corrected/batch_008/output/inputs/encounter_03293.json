  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.05,
      "duration_seconds": 4.89,
      "text": "good evening you know doctor thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 11.01,
      "duration_seconds": 4.45,
      "text": "You're alright take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.74,
      "end_seconds": 20.65,
      "duration_seconds": 7.91,
      "text": "It's It's fever and shivers. I thought I'd wait but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.4,
      "end_seconds": 24.71,
      "duration_seconds": 3.31,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.59,
      "end_seconds": 33.03,
      "duration_seconds": 4.44,
      "text": "it's been three days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.95,
      "end_seconds": 36.33,
      "duration_seconds": 2.38,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.85,
      "end_seconds": 42.72,
      "duration_seconds": 4.87,
      "text": "Yeah, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.58,
      "end_seconds": 47.45,
      "duration_seconds": 2.87,
      "text": "What about confusion, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.97,
      "end_seconds": 61.62,
      "duration_seconds": 13.65,
      "text": "yes, um, for about four days oh, and pain in the lower tummy that's been about the same, about four days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.04,
      "end_seconds": 68.1,
      "duration_seconds": 5.06,
      "text": "Have you had fever and shivers before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.84,
      "end_seconds": 75.68,
      "duration_seconds": 5.84,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.31,
      "end_seconds": 77.57,
      "duration_seconds": 1.26,
      "text": "any back pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.62,
      "end_seconds": 81.92,
      "duration_seconds": 2.3,
      "text": "definitely no back pain"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.7,
      "end_seconds": 86.68,
      "duration_seconds": 2.98,
      "text": "have you noticed cough, vomiting or fall?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.59,
      "end_seconds": 92.23,
      "duration_seconds": 3.64,
      "text": "none of those, you know, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.09,
      "end_seconds": 96.45,
      "duration_seconds": 3.36,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.22,
      "end_seconds": 101.21,
      "duration_seconds": 2.99,
      "text": "no, um, nothing there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.5,
      "end_seconds": 104.8,
      "duration_seconds": 2.3,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.27,
      "end_seconds": 107.26,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.93,
      "end_seconds": 111.17,
      "duration_seconds": 3.24,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.7,
      "end_seconds": 115.72,
      "duration_seconds": 3.02,
      "text": "it's sertraline, once a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.7,
      "end_seconds": 120.06,
      "duration_seconds": 2.36,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.49,
      "end_seconds": 125.9,
      "duration_seconds": 4.41,
      "text": "50 milligrams. It's a urinary catheter, in place."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.41,
      "end_seconds": 128.65,
      "duration_seconds": 1.24,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.71,
      "end_seconds": 133.08,
      "duration_seconds": 2.37,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.01,
      "end_seconds": 152.01,
      "duration_seconds": 5.0,
      "text": "tell me about your routine work habits that sort of thing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.79,
      "end_seconds": 166.74,
      "duration_seconds": 12.95,
      "text": "I grab fast food at lunch most days. I'm a plumber, lots of bending and kneeling. My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.82,
      "end_seconds": 169.78,
      "duration_seconds": 1.96,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.3,
      "end_seconds": 179.31,
      "duration_seconds": 6.01,
      "text": "I had a caesarean for my second baby nine years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.36,
      "end_seconds": 183.1,
      "duration_seconds": 2.74,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.38,
      "end_seconds": 193.47,
      "duration_seconds": 9.09,
      "text": "Depression, for about ten years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.49,
      "end_seconds": 196.48,
      "duration_seconds": 0.99,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.01,
      "end_seconds": 212.86,
      "duration_seconds": 3.85,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.31,
      "end_seconds": 217.18,
      "duration_seconds": 2.87,
      "text": "my mother had a stroke"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 221.76,
      "duration_seconds": 3.14,
      "text": "Let me ask about allergies anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.32,
      "end_seconds": 227.27,
      "duration_seconds": 4.95,
      "text": "um, no, not that that I know of"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.87,
      "end_seconds": 233.17,
      "duration_seconds": 4.3,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.58,
      "end_seconds": 245.78,
      "duration_seconds": 2.2,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 277.41,
      "duration_seconds": 13.34,
      "text": "Okay: pulse 103, respiratory rate 20, pressure 112 over 79, BMI works out to to 18.7, saturation 96 percent, weight 64 kilos, temp 39.2 degrees, height 185 centimetres."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.82,
      "end_seconds": 295.57,
      "duration_seconds": 5.75,
      "text": "From what you've told me it fits best with a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.54,
      "end_seconds": 299.61,
      "duration_seconds": 3.07,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.3,
      "end_seconds": 317.34,
      "duration_seconds": 17.04,
      "text": "I can't promise yet, but most people with a catheter-related urinary infection do well once it's treated properly i'm sending you for a urine culture because of possible urinary infection it's a routine test and it'll give us a much clearer picture"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.83,
      "end_seconds": 323.24,
      "duration_seconds": 4.41,
      "text": "we have a slot Tuesday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.77,
      "end_seconds": 326.34,
      "duration_seconds": 2.57,
      "text": "Let's get blood tests for fever."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.27,
      "end_seconds": 332.87,
      "duration_seconds": 4.6,
      "text": "let me think, how long will it it take?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.38,
      "end_seconds": 353.63,
      "duration_seconds": 20.25,
      "text": "we'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days it's for catheter urinary infection change the catheter and drink plenty the thing that would worry me is if the symptoms get worse if that happens, go to emergency book a review in two days"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.29,
      "end_seconds": 356.41,
      "duration_seconds": 2.12,
      "text": "okay I'll arrange it"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.89,
      "end_seconds": 361.71,
      "duration_seconds": 3.82,
      "text": "that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.86,
      "end_seconds": 365.15,
      "duration_seconds": 2.29,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.67,
      "end_seconds": 367.37,
      "duration_seconds": 1.7,
      "text": "right, look after yourself"
    }
  ]
