      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.6,
      "end_seconds": 269.85,
      "duration_seconds": 5.25,
      "text": "Nothing I've seen today points to an emergency. It looks like simple dandruff."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.04,
      "end_seconds": 297.85,
      "duration_seconds": 18.81,
      "text": "I'll start you on ketoconazole shampoo 2% twice a week four weeks it's for dandruff leave the shampoo on for five minutes before rinsing i'd like you back if not better in a month anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.44,
