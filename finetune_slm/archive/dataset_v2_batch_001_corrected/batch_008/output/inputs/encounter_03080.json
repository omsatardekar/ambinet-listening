      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.49,
      "end_seconds": 255.22,
      "duration_seconds": 4.73,
      "text": "so where does that leave us? It points towards simple dandruff"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.47,
      "end_seconds": 263.08,
      "duration_seconds": 3.61,
      "text": "I'm scared it's something bad. Is it?"
