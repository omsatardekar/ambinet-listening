      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.28,
      "end_seconds": 146.68,
      "duration_seconds": 3.4,
      "text": "are there any illnesses in your family?"
