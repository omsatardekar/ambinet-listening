      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.56,
      "end_seconds": 177.08,
      "duration_seconds": 2.52,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.25,
      "end_seconds": 199.92,
      "duration_seconds": 6.67,
      "text": "Okay: pulse 68, BP is 117 over 73, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.5,
      "end_seconds": 205.87,
      "duration_seconds": 4.37,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.26,
      "end_seconds": 208.67,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
