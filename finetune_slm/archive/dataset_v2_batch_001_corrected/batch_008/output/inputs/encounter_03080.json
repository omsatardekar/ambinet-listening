      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.16,
      "end_seconds": 164.0,
      "duration_seconds": 2.84,
      "text": "time for your numbers, if that's okay"
