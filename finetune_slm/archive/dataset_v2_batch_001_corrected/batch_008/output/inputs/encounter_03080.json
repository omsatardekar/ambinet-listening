      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.34,
      "end_seconds": 229.42,
      "duration_seconds": 5.08,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
