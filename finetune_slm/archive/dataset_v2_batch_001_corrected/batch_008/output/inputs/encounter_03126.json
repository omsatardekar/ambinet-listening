{
  "schema_version": "1.0",
  "encounter_id": "03126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.95,
      "duration_seconds": 3.57,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.04,
      "duration_seconds": 4.07,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.52,
      "end_seconds": 15.96,
      "duration_seconds": 4.44,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.93,
      "end_seconds": 22.78,
      "duration_seconds": 2.85,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.67,
      "end_seconds": 35.48,
      "duration_seconds": 10.81,
      "text": "Honestly, it's fever and shivers, and my family pushed me to come. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.67,
      "end_seconds": 40.08,
      "duration_seconds": 3.41,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.64,
      "end_seconds": 54.16,
      "duration_seconds": 12.52,
      "text": "For three weeks, I'd say. I'm hoping you can tell me something definite. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.87,
      "end_seconds": 59.44,
      "duration_seconds": 4.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.03,
      "end_seconds": 64.19,
      "duration_seconds": 3.16,
      "text": "Mostly moderate. It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.54,
      "end_seconds": 68.08,
      "duration_seconds": 2.54,
      "text": "Any cloudy smelly urine as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.25,
      "end_seconds": 76.46,
      "duration_seconds": 7.21,
      "text": "Yes, for about two weeks. I've had confusion too, for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.48,
      "end_seconds": 80.76,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.51,
      "end_seconds": 89.35,
      "duration_seconds": 7.84,
      "text": "I take carbamazepine, 200 milligrams, twice a day. I take a urinary catheter, in place."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.12,
      "end_seconds": 103.69,
      "duration_seconds": 2.57,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.09,
      "end_seconds": 118.79,
      "duration_seconds": 10.7,
      "text": "I only drink at family occasions. I hardly move around during the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.45,
      "end_seconds": 124.15,
      "duration_seconds": 3.7,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 127.46,
      "duration_seconds": 2.23,
      "text": "I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.56,
      "end_seconds": 137.47,
      "duration_seconds": 7.91,
      "text": "Hm, okay. Okay, I can see epilepsy in your file as well. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.55,
      "end_seconds": 147.9,
      "duration_seconds": 6.35,
      "text": "Sorry, what was I saying, I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.6,
      "end_seconds": 153.01,
      "duration_seconds": 3.41,
      "text": "A few quick ones: back pain or fall?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.88,
      "end_seconds": 156.32,
      "duration_seconds": 2.44,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.34,
      "end_seconds": 160.64,
      "duration_seconds": 3.3,
      "text": "A few quick ones: vomiting or cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.56,
      "end_seconds": 165.1,
      "duration_seconds": 3.54,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.05,
      "end_seconds": 169.38,
      "duration_seconds": 2.33,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.37,
      "end_seconds": 171.45,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.98,
      "end_seconds": 192.78,
      "duration_seconds": 2.8,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.45,
      "end_seconds": 205.69,
      "duration_seconds": 2.24,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.15,
      "end_seconds": 232.15,
      "duration_seconds": 8.0,
      "text": "Okay: temperature is 39.2 degrees, blood pressure 123 over 67, pulse is 88 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.84,
      "end_seconds": 235.09,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.4,
      "end_seconds": 243.91,
      "duration_seconds": 2.51,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.64,
      "end_seconds": 251.58,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.89,
      "end_seconds": 254.78,
      "duration_seconds": 1.89,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.38,
      "end_seconds": 278.91,
      "duration_seconds": 6.53,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.56,
      "end_seconds": 288.55,
      "duration_seconds": 6.99,
      "text": "You can relax now. So where does that leave us? It points towards a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.48,
      "end_seconds": 302.81,
      "duration_seconds": 4.33,
      "text": "We should do a urine culture for possible urinary infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.11,
      "end_seconds": 305.77,
      "duration_seconds": 1.66,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.7,
      "end_seconds": 328.8,
      "duration_seconds": 21.1,
      "text": "We should do blood tests for fever. We'll begin with co-amoxiclav, 625 milligrams, three times a day, seven days. You take it by mouth. That's for catheter urinary infection. Change the catheter and drink plenty. Please take the tablets with food so they don't upset your stomach. Come back in two days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.76,
      "end_seconds": 335.88,
      "duration_seconds": 2.12,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.38,
      "end_seconds": 340.5,
      "duration_seconds": 4.12,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.86,
      "end_seconds": 344.97,
      "duration_seconds": 3.11,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.06,
      "end_seconds": 347.23,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}