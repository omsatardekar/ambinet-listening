{
  "schema_version": "1.0",
  "encounter_id": "03198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.33,
      "duration_seconds": 3.11,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.3,
      "end_seconds": 11.08,
      "duration_seconds": 4.78,
      "text": "alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 19.86,
      "duration_seconds": 7.66,
      "text": "well, mainly headaches most days. There's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.73,
      "end_seconds": 22.96,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.83,
      "end_seconds": 29.15,
      "duration_seconds": 5.32,
      "text": "Clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.89,
      "end_seconds": 33.12,
      "duration_seconds": 2.23,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.92,
      "end_seconds": 45.7,
      "duration_seconds": 10.78,
      "text": "Just since yesterday. My family kept telling me to get it checked. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.26,
      "end_seconds": 58.54,
      "duration_seconds": 8.28,
      "text": "Okay, give me more detail on it, whatever comes to mind. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.94,
      "end_seconds": 66.68,
      "duration_seconds": 6.74,
      "text": "Maybe a six out of ten on a bad day. Painkillers helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.75,
      "end_seconds": 70.83,
      "duration_seconds": 3.08,
      "text": "so, have you been feeling sick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.2,
      "end_seconds": 74.19,
      "duration_seconds": 1.99,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.57,
      "end_seconds": 91.66,
      "duration_seconds": 2.09,
      "text": "So, what about fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.42,
      "end_seconds": 94.03,
      "duration_seconds": 1.61,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.57,
      "end_seconds": 99.51,
      "duration_seconds": 3.94,
      "text": "did you get stiff neck or visual changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.03,
      "end_seconds": 105.53,
      "duration_seconds": 4.5,
      "text": "No stiff neck or visual changes, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.78,
      "end_seconds": 107.74,
      "duration_seconds": 1.96,
      "text": "sure. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.71,
      "end_seconds": 114.51,
      "duration_seconds": 1.8,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.57,
      "end_seconds": 120.04,
      "duration_seconds": 3.47,
      "text": "Alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.94,
      "end_seconds": 124.04,
      "duration_seconds": 2.1,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.81,
      "end_seconds": 127.36,
      "duration_seconds": 2.55,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.21,
      "end_seconds": 130.18,
      "duration_seconds": 1.97,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.84,
      "end_seconds": 135.56,
      "duration_seconds": 4.72,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.49,
      "end_seconds": 139.79,
      "duration_seconds": 3.3,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.32,
      "end_seconds": 143.11,
      "duration_seconds": 2.79,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.96,
      "end_seconds": 148.26,
      "duration_seconds": 4.3,
      "text": "yes, I had a triple bypass, eight years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.8,
      "end_seconds": 163.11,
      "duration_seconds": 1.31,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.64,
      "end_seconds": 167.39,
      "duration_seconds": 3.75,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.87,
      "end_seconds": 171.47,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.34,
      "end_seconds": 176.62,
      "duration_seconds": 3.28,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.59,
      "end_seconds": 181.37,
      "duration_seconds": 2.78,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.97,
      "end_seconds": 186.19,
      "duration_seconds": 3.22,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.32,
      "end_seconds": 192.39,
      "duration_seconds": 5.07,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.81,
      "end_seconds": 196.21,
      "duration_seconds": 2.4,
      "text": "Hold that that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.43,
      "end_seconds": 212.67,
      "duration_seconds": 2.24,
      "text": "your neurological examination is normal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.96,
      "end_seconds": 228.47,
      "duration_seconds": 1.51,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.87,
      "end_seconds": 233.26,
      "duration_seconds": 2.39,
      "text": "Okay, all finished, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.26,
      "end_seconds": 254.03,
      "duration_seconds": 7.77,
      "text": "So where does that leave us? I'd lean towards medication-overuse headache on a background of migraine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.03,
      "end_seconds": 259.22,
      "duration_seconds": 3.19,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.03,
      "end_seconds": 291.93,
      "duration_seconds": 30.9,
      "text": "nothing I've seen today points to an emergency. It looks like medication-overuse headache on a background of migraine, but I'd like to confirm. I'd like to arrange a headache diary for daily headache. You'll be taking amitriptyline, 10 milligrams, at night, long term. It's for headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.15,
      "end_seconds": 297.81,
      "duration_seconds": 5.66,
      "text": "ah come back in six weeks that's all from me any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.5,
      "end_seconds": 301.87,
      "duration_seconds": 3.37,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.02,
      "end_seconds": 308.48,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}