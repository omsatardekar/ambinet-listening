{
  "schema_version": "1.0",
  "encounter_id": "03130",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 11.24,
      "duration_seconds": 10.18,
      "text": "Sorry, what was I saying, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.85,
      "end_seconds": 17.31,
      "duration_seconds": 4.46,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.3,
      "end_seconds": 23.3,
      "duration_seconds": 5.0,
      "text": "Um, so... shaking chills. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.83,
      "end_seconds": 28.3,
      "duration_seconds": 3.47,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.46,
      "end_seconds": 32.01,
      "duration_seconds": 2.55,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.8,
      "end_seconds": 43.4,
      "duration_seconds": 10.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.06,
      "end_seconds": 49.82,
      "duration_seconds": 5.76,
      "text": "Yeah, pretty severe, if I'm being honest. It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.25,
      "end_seconds": 53.87,
      "duration_seconds": 2.62,
      "text": "Have you been feeling very weak?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.82,
      "end_seconds": 69.83,
      "duration_seconds": 10.01,
      "text": "Yes, for five days. About feeling very weak, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.72,
      "end_seconds": 76.01,
      "duration_seconds": 5.29,
      "text": "Have you had shaking chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 84.7,
      "duration_seconds": 6.92,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.42,
      "end_seconds": 88.56,
      "duration_seconds": 2.14,
      "text": "Have you had any cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.23,
      "end_seconds": 90.96,
      "duration_seconds": 1.73,
      "text": "Nope, no cough."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.56,
      "end_seconds": 95.12,
      "duration_seconds": 2.56,
      "text": "Any diarrhoea or rash at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.5,
      "end_seconds": 99.44,
      "duration_seconds": 2.94,
      "text": "No, no diarrhoea or rash."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.34,
      "end_seconds": 103.35,
      "duration_seconds": 2.01,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.19,
      "end_seconds": 106.32,
      "duration_seconds": 1.13,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.53,
      "end_seconds": 111.41,
      "duration_seconds": 3.88,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.07,
      "end_seconds": 114.46,
      "duration_seconds": 2.39,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.05,
      "end_seconds": 118.42,
      "duration_seconds": 2.37,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.61,
      "end_seconds": 123.66,
      "duration_seconds": 4.05,
      "text": "I'm allergic to walnuts, I get hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.48,
      "end_seconds": 128.3,
      "duration_seconds": 3.82,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.25,
      "end_seconds": 136.87,
      "duration_seconds": 6.62,
      "text": "Mm, you know, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.89,
      "end_seconds": 140.04,
      "duration_seconds": 2.15,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.85,
      "end_seconds": 146.26,
      "duration_seconds": 5.41,
      "text": "Just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.42,
      "end_seconds": 150.26,
      "duration_seconds": 2.84,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.83,
      "end_seconds": 155.14,
      "duration_seconds": 3.31,
      "text": "I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.21,
      "end_seconds": 163.67,
      "duration_seconds": 7.46,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.8,
      "end_seconds": 168.46,
      "duration_seconds": 3.66,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.32,
      "end_seconds": 172.19,
      "duration_seconds": 2.87,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.35,
      "end_seconds": 176.63,
      "duration_seconds": 3.28,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.36,
      "end_seconds": 193.78,
      "duration_seconds": 5.42,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.89,
      "end_seconds": 204.86,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.01,
      "end_seconds": 220.85,
      "duration_seconds": 5.84,
      "text": "Okay: temperature is 36.4 degrees, pulse 98, blood pressure 100 over 66."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.8,
      "end_seconds": 226.29,
      "duration_seconds": 3.49,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.09,
      "end_seconds": 229.39,
      "duration_seconds": 2.3,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.41,
      "end_seconds": 234.59,
      "duration_seconds": 3.18,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.5,
      "end_seconds": 249.51,
      "duration_seconds": 3.01,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.41,
      "end_seconds": 252.61,
      "duration_seconds": 1.2,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 275.39,
      "duration_seconds": 7.14,
      "text": "You are hot, shaking and your blood pressure is low, and you had chemotherapy nine days ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.58,
      "end_seconds": 277.79,
      "duration_seconds": 1.21,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.11,
      "end_seconds": 283.16,
      "duration_seconds": 3.05,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.01,
      "end_seconds": 304.97,
      "duration_seconds": 5.96,
      "text": "Putting it all together, I think we're dealing with neutropenic sepsis at this stage."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.77,
      "end_seconds": 309.08,
      "duration_seconds": 2.31,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.73,
      "end_seconds": 338.67,
      "duration_seconds": 28.94,
      "text": "I can't promise yet, but most people with neutropenic sepsis do well once it's treated properly. Let's book urgent blood tests to look into neutropenic sepsis. For this, piperacillin and tazobactam, 4.5 grams, now, single dose. That's for neutropenic sepsis. This is an emergency, antibiotics are being given within the hour. The oncology team would be the right next step, I'll refer you. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.19,
      "end_seconds": 341.29,
      "duration_seconds": 2.1,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.2,
      "end_seconds": 345.3,
      "duration_seconds": 3.1,
      "text": "So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.11,
      "end_seconds": 350.3,
      "duration_seconds": 3.19,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.21,
      "end_seconds": 353.63,
      "duration_seconds": 1.42,
      "text": "Take care now."
    }
  ]
}