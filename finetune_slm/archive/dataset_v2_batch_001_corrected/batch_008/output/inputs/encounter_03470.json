{
  "schema_version": "1.0",
  "encounter_id": "03470",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 6.44,
      "duration_seconds": 5.05,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.14,
      "end_seconds": 13.12,
      "duration_seconds": 4.98,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.63,
      "end_seconds": 19.14,
      "duration_seconds": 4.51,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.46,
      "end_seconds": 23.06,
      "duration_seconds": 2.6,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.53,
      "end_seconds": 28.56,
      "duration_seconds": 4.03,
      "text": "so the thing is, I've got breathlessness"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.27,
      "end_seconds": 31.66,
      "duration_seconds": 1.39,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.29,
      "end_seconds": 35.34,
      "duration_seconds": 2.05,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.94,
      "end_seconds": 42.97,
      "duration_seconds": 7.03,
      "text": "Hm, okay. Okay, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.3,
      "end_seconds": 46.33,
      "duration_seconds": 2.03,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.06,
      "end_seconds": 52.88,
      "duration_seconds": 5.82,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 52.98,
      "end_seconds": 58.94,
      "duration_seconds": 5.96,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.96,
      "end_seconds": 63.36,
      "duration_seconds": 2.4,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.37,
      "end_seconds": 69.41,
      "duration_seconds": 5.04,
      "text": "And there's a gurgling chest as well, three weeks now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.09,
      "end_seconds": 74.26,
      "duration_seconds": 3.17,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 77.21,
      "duration_seconds": 0.92,
      "text": "mostly moderate"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.43,
      "end_seconds": 80.4,
      "duration_seconds": 1.97,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.49,
      "end_seconds": 84.5,
      "duration_seconds": 3.01,
      "text": "yeah. About a month, I'd say"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.37,
      "end_seconds": 89.71,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.37,
      "end_seconds": 93.96,
      "duration_seconds": 3.59,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.4,
      "end_seconds": 103.3,
      "duration_seconds": 4.9,
      "text": "have you had breathlessness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.87,
      "end_seconds": 116.38,
      "duration_seconds": 7.51,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.08,
      "end_seconds": 121.57,
      "duration_seconds": 4.49,
      "text": "Have you had any fever, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.09,
      "end_seconds": 134.78,
      "duration_seconds": 12.69,
      "text": "No, no fever, no weight loss, no chest pain. I was coughing up large amounts of blood at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 140.14,
      "duration_seconds": 3.71,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.24,
      "end_seconds": 143.88,
      "duration_seconds": 2.64,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.89,
      "end_seconds": 148.12,
      "duration_seconds": 3.23,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.75,
      "end_seconds": 157.57,
      "duration_seconds": 8.82,
      "text": "Just my septum straightened, in my thirties. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.18,
      "end_seconds": 162.55,
      "duration_seconds": 3.37,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.11,
      "end_seconds": 173.64,
      "duration_seconds": 10.53,
      "text": "It's metoprolol, 50 milligrams, twice a day. I had furosemide at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.08,
      "end_seconds": 188.3,
      "duration_seconds": 4.22,
      "text": "Is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.57,
      "end_seconds": 194.71,
      "duration_seconds": 5.14,
      "text": "My mother has an underactive thyroid. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.11,
      "end_seconds": 200.72,
      "duration_seconds": 4.61,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.67,
      "end_seconds": 204.49,
      "duration_seconds": 2.82,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 210.06,
      "duration_seconds": 4.13,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.33,
      "end_seconds": 220.24,
      "duration_seconds": 5.91,
      "text": "I have arthritis in my knees. Heart failure, for about a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.61,
      "end_seconds": 236.33,
      "duration_seconds": 14.72,
      "text": "Okay, go on. Right, so arthritis in your knees and heart failure are already on your record. We'll keep that in mind today. What do you do during the day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.2,
      "end_seconds": 240.38,
      "duration_seconds": 3.18,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.26,
      "end_seconds": 245.34,
      "duration_seconds": 2.08,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.42,
      "end_seconds": 251.87,
      "duration_seconds": 5.45,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 252.87,
      "end_seconds": 263.66,
      "duration_seconds": 10.79,
      "text": "here are the numbers, doctor respiratory rate 23, blood pressure 141 over 81, temperature is 37.4 degrees, pulse 88, SpO2 94 percent on room air"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.69,
      "end_seconds": 270.39,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.95,
      "end_seconds": 274.75,
      "duration_seconds": 2.8,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.55,
      "end_seconds": 278.42,
      "duration_seconds": 1.87,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.04,
      "end_seconds": 297.08,
      "duration_seconds": 6.04,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.86,
      "end_seconds": 317.51,
      "duration_seconds": 15.65,
      "text": "Good, you can sit up again. So where does that leave us? I don't have a clear answer today: life-threatening haemoptysis is possible, and so is a pulmonary embolus. Another possibility is a lung tumour."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.51,
      "end_seconds": 368.86,
      "duration_seconds": 35.35,
      "text": "I'm sending you for an urgent CT scan because of massive haemoptysis let's book urgent blood tests to look into bleeding you'll be taking tranexamic acid, 1 gram, now, single dose it's for haemoptysis lie on the bleeding side and I am calling the emergency team don't skip meals, and try to eat smaller portions more often through the day i'm going to send a referral to the emergency team book a review straight away"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.75,
      "end_seconds": 373.71,
      "duration_seconds": 3.96,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 375.7,
      "end_seconds": 378.64,
      "duration_seconds": 2.94,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.62,
      "end_seconds": 380.93,
      "duration_seconds": 1.31,
      "text": "all the best"
    }
  ]
}