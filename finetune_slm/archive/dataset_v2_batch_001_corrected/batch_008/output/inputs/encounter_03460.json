{
  "schema_version": "1.0",
  "encounter_id": "03460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.49,
      "duration_seconds": 4.41,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.57,
      "end_seconds": 10.89,
      "duration_seconds": 4.32,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.07,
      "end_seconds": 18.35,
      "duration_seconds": 6.28,
      "text": "I've been dealing with a pearly bump on my nose that bleeds."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.19,
      "end_seconds": 20.59,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.6,
      "end_seconds": 25.32,
      "duration_seconds": 2.72,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.11,
      "end_seconds": 29.18,
      "duration_seconds": 2.07,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.58,
      "end_seconds": 33.3,
      "duration_seconds": 2.72,
      "text": "I notice it more with washing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.51,
      "end_seconds": 34.21,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.01,
      "end_seconds": 56.45,
      "duration_seconds": 5.44,
      "text": "Have you had any family history of skin cancer, pain or swollen glands?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.86,
      "end_seconds": 60.73,
      "duration_seconds": 2.87,
      "text": "None of those, uh, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.54,
      "end_seconds": 63.38,
      "duration_seconds": 1.84,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.52,
      "end_seconds": 67.13,
      "duration_seconds": 2.61,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.66,
      "end_seconds": 69.47,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.35,
      "end_seconds": 72.93,
      "duration_seconds": 2.58,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.38,
      "end_seconds": 77.09,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.45,
      "end_seconds": 85.77,
      "duration_seconds": 3.32,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.81,
      "end_seconds": 99.07,
      "duration_seconds": 3.26,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.59,
      "end_seconds": 103.84,
      "duration_seconds": 3.25,
      "text": "Hmm, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.42,
      "end_seconds": 108.76,
      "duration_seconds": 4.34,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.82,
      "end_seconds": 111.66,
      "duration_seconds": 1.84,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.94,
      "end_seconds": 129.75,
      "duration_seconds": 3.81,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.46,
      "end_seconds": 133.37,
      "duration_seconds": 2.91,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 138.31,
      "duration_seconds": 3.43,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.17,
      "end_seconds": 140.43,
      "duration_seconds": 1.26,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.31,
      "end_seconds": 148.16,
      "duration_seconds": 2.85,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.05,
      "end_seconds": 154.7,
      "duration_seconds": 3.65,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.27,
      "end_seconds": 161.15,
      "duration_seconds": 3.88,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.06,
      "end_seconds": 178.08,
      "duration_seconds": 3.02,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.34,
      "end_seconds": 198.89,
      "duration_seconds": 7.55,
      "text": "Okay: heart rate 79, saturation 99 percent, temp 36.6 degrees, blood pressure 125 over 81."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.12,
      "end_seconds": 205.37,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.14,
      "end_seconds": 209.9,
      "duration_seconds": 2.76,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.6,
      "end_seconds": 216.44,
      "duration_seconds": 3.84,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.27,
      "end_seconds": 219.89,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.11,
      "end_seconds": 238.1,
      "duration_seconds": 8.99,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.54,
      "end_seconds": 242.27,
      "duration_seconds": 1.73,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.19,
      "end_seconds": 265.86,
      "duration_seconds": 5.67,
      "text": "Taking everything into account, the most likely explanation is a likely basal cell carcinoma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.06,
      "end_seconds": 268.87,
      "duration_seconds": 1.81,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.26,
      "end_seconds": 282.52,
      "duration_seconds": 12.26,
      "text": "It's reasonable to be concerned, but right now a likely basal cell carcinoma is my leading thought, not anything worse. We should do a skin biopsy for suspicious lesion."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.82,
      "end_seconds": 285.69,
      "duration_seconds": 1.87,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.53,
      "end_seconds": 302.74,
      "duration_seconds": 16.21,
      "text": "I'm sending you for a dermoscopy because of suspicious lesion. Please use a high-factor sunscreen and a hat. I'll also refer you to the skin cancer clinic. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.5,
      "end_seconds": 307.59,
      "duration_seconds": 3.09,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.76,
      "end_seconds": 314.53,
      "duration_seconds": 2.77,
      "text": "We'll catch up after the biopsy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.31,
      "end_seconds": 318.34,
      "duration_seconds": 3.03,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.24,
      "end_seconds": 324.69,
      "duration_seconds": 5.45,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.87,
      "end_seconds": 330.85,
      "duration_seconds": 4.98,
      "text": "So, I come back after the biopsy. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.94,
      "end_seconds": 340.05,
      "duration_seconds": 7.11,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.75,
      "end_seconds": 344.58,
      "duration_seconds": 2.83,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.71,
      "end_seconds": 348.86,
      "duration_seconds": 2.15,
      "text": "Alright, have a good day."
    }
  ]
}