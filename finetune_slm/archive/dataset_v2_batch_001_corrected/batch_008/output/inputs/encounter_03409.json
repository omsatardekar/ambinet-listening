  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.32,
      "duration_seconds": 3.78,
      "text": "hello, doctor. I think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.34,
      "end_seconds": 10.55,
      "duration_seconds": 4.21,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 17.25,
      "duration_seconds": 5.22,
      "text": "Doctor, it's slurred speech. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.22,
      "end_seconds": 20.52,
      "duration_seconds": 2.3,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.06,
      "end_seconds": 24.61,
      "duration_seconds": 2.55,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.04,
      "end_seconds": 29.02,
      "duration_seconds": 2.98,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.49,
      "end_seconds": 35.45,
      "duration_seconds": 1.96,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.87,
      "end_seconds": 44.88,
      "duration_seconds": 5.01,
      "text": "What about shivering that has stopped, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.58,
      "end_seconds": 46.76,
      "duration_seconds": 1.18,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 55.44,
      "duration_seconds": 3.82,
      "text": "Okay, any head injury, fall or alcohol at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.29,
      "end_seconds": 60.09,
      "duration_seconds": 2.8,
      "text": "No, not a a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.3,
      "end_seconds": 64.18,
      "duration_seconds": 2.88,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.84,
      "end_seconds": 65.93,
      "duration_seconds": 1.09,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.83,
      "end_seconds": 71.56,
      "duration_seconds": 3.73,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.55,
      "end_seconds": 74.66,
      "duration_seconds": 2.11,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.74,
      "end_seconds": 78.12,
      "duration_seconds": 2.38,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.63,
      "end_seconds": 98.89,
      "duration_seconds": 19.26,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I swim twice a week. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 104.46,
      "duration_seconds": 4.46,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.3,
      "end_seconds": 109.5,
      "duration_seconds": 3.2,
      "text": "Yes, trimethoprim, it gives me itching."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.08,
      "end_seconds": 111.27,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.72,
      "end_seconds": 115.96,
      "duration_seconds": 3.24,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.25,
      "end_seconds": 137.04,
      "duration_seconds": 3.79,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.99,
      "end_seconds": 140.33,
      "duration_seconds": 2.34,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.74,
      "end_seconds": 155.54,
      "duration_seconds": 2.8,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.14,
      "end_seconds": 158.69,
      "duration_seconds": 1.55,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 170.33,
      "duration_seconds": 2.55,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.16,
      "end_seconds": 186.31,
      "duration_seconds": 2.15,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.74,
      "end_seconds": 213.15,
      "duration_seconds": 6.41,
      "text": "Okay: pulse 67, SpO2 98 percent on room air, BP is 128 over 80."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.19,
      "end_seconds": 217.25,
      "duration_seconds": 2.06,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.55,
      "end_seconds": 221.21,
      "duration_seconds": 2.66,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.43,
      "end_seconds": 225.48,
      "duration_seconds": 2.05,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.82,
      "end_seconds": 243.33,
      "duration_seconds": 1.51,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.69,
      "end_seconds": 248.68,
      "duration_seconds": 3.99,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.42,
      "end_seconds": 272.84,
      "duration_seconds": 6.42,
      "text": "your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 282.59,
      "duration_seconds": 7.56,
      "text": "That's all I needed to check. Okay, thinking it through, it points towards severe hypothermia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.31,
      "end_seconds": 287.11,
      "duration_seconds": 3.8,
      "text": "So, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.62,
      "end_seconds": 304.68,
      "duration_seconds": 17.06,
      "text": "I understand the worry at the moment I'd say it's severe hypothermia, and we'll watch how it goes i don't need to add any tests or treatment at this point right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.89,
      "end_seconds": 308.96,
      "duration_seconds": 3.07,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.87,
      "end_seconds": 311.16,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}