{
  "schema_version": "1.0",
  "encounter_id": "03008",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 5.07,
      "duration_seconds": 4.55,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 11.16,
      "duration_seconds": 4.25,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.3,
      "end_seconds": 20.92,
      "duration_seconds": 8.62,
      "text": "Okay, you know, so hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.05,
      "end_seconds": 26.09,
      "duration_seconds": 4.04,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.8,
      "end_seconds": 32.55,
      "duration_seconds": 4.75,
      "text": "Right, we came because of headaches most days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.35,
      "end_seconds": 37.06,
      "duration_seconds": 3.71,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.97,
      "end_seconds": 44.19,
      "duration_seconds": 6.22,
      "text": "Let me think, um, I've had it for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.83,
      "end_seconds": 50.93,
      "duration_seconds": 5.1,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.51,
      "end_seconds": 62.61,
      "duration_seconds": 9.1,
      "text": "It's on and off. Light sensitivity was there, uh, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 68.22,
      "duration_seconds": 4.31,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.79,
      "end_seconds": 79.15,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 106.49,
      "duration_seconds": 8.79,
      "text": "Okay: temperature 36.7, oxygen saturation is 98 percent, pulse 74, respiratory rate 15, blood pressure 115 over 69."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.01,
      "end_seconds": 109.47,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.04,
      "end_seconds": 112.53,
      "duration_seconds": 2.49,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.04,
      "end_seconds": 118.77,
      "duration_seconds": 3.73,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.96,
      "end_seconds": 121.5,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.28,
      "end_seconds": 126.09,
      "duration_seconds": 2.81,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 145.54,
      "duration_seconds": 2.25,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.24,
      "end_seconds": 150.37,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.75,
      "end_seconds": 159.84,
      "duration_seconds": 2.09,
      "text": "Has there been any weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 164.6,
      "duration_seconds": 3.55,
      "text": "No, I haven't had any weakness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.61,
      "end_seconds": 169.27,
      "duration_seconds": 3.66,
      "text": "Any stiff neck, fever or visual changes at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.03,
      "end_seconds": 173.62,
      "duration_seconds": 3.59,
      "text": "Well, no, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.53,
      "end_seconds": 178.98,
      "duration_seconds": 4.45,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.45,
      "end_seconds": 183.8,
      "duration_seconds": 3.35,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.65,
      "end_seconds": 189.57,
      "duration_seconds": 4.92,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.75,
      "end_seconds": 205.97,
      "duration_seconds": 12.22,
      "text": "I smoke roughly a pack every two days. Lots of rice, lentils and some fruit. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.25,
      "end_seconds": 222.86,
      "duration_seconds": 2.61,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.39,
      "end_seconds": 233.37,
      "duration_seconds": 5.98,
      "text": "It's tamsulosin, 0.4 milligrams, maybe, at night for the prostate."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.71,
      "end_seconds": 239.29,
      "duration_seconds": 4.58,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.31,
      "end_seconds": 245.24,
      "duration_seconds": 3.93,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.04,
      "end_seconds": 248.05,
      "duration_seconds": 2.01,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.09,
      "end_seconds": 260.12,
      "duration_seconds": 10.03,
      "text": "Erm, I've had migraines for nearly five years now. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.86,
      "end_seconds": 263.2,
      "duration_seconds": 1.34,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.26,
      "end_seconds": 267.76,
      "duration_seconds": 2.5,
      "text": "I've got an enlarged prostate."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.48,
      "end_seconds": 277.53,
      "duration_seconds": 8.05,
      "text": "Mm, okay. Okay, I can see migraines in your file as well. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.49,
      "end_seconds": 282.61,
      "duration_seconds": 2.12,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.34,
      "end_seconds": 292.9,
      "duration_seconds": 9.56,
      "text": "So where does that leave us? It fits best with medication-overuse headache on a background of migraine. Tension-type headache is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.92,
      "end_seconds": 297.1,
      "duration_seconds": 3.18,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.99,
      "end_seconds": 318.53,
      "duration_seconds": 20.54,
      "text": "I can't promise yet, but most people with medication-overuse headache on a background of migraine do well once it's treated properly. A headache diary is what I'd like next, for daily headache. For this, amitriptyline, 10 milligrams, at night, long term. It's for headache prevention."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.13,
      "end_seconds": 320.65,
      "duration_seconds": 1.52,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.62,
      "end_seconds": 340.82,
      "duration_seconds": 15.2,
      "text": "Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.7,
      "end_seconds": 345.4,
      "duration_seconds": 3.7,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.87,
      "end_seconds": 360.84,
      "duration_seconds": 13.97,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Come back in six weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.55,
      "end_seconds": 373.67,
      "duration_seconds": 11.12,
      "text": "So, I take the amitriptyline, 10 milligrams, at night and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.65,
      "end_seconds": 379.73,
      "duration_seconds": 5.08,
      "text": "Alright, yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.48,
      "end_seconds": 384.66,
      "duration_seconds": 4.18,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}