{
  "schema_version": "1.0",
  "encounter_id": "03484",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 6.5,
      "duration_seconds": 5.55,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.66,
      "end_seconds": 11.3,
      "duration_seconds": 3.64,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.86,
      "end_seconds": 18.47,
      "duration_seconds": 5.61,
      "text": "Mm, mainly I've been feeling tired and weak. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 24.22,
      "duration_seconds": 4.57,
      "text": "Okay, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.47,
      "end_seconds": 39.41,
      "duration_seconds": 2.94,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.99,
      "end_seconds": 70.93,
      "duration_seconds": 11.94,
      "text": "Okay: SpO2 97 percent on room air, height 178 centimetres, temperature is 37.1 degrees. And weight 72 kilos, pressure 93 over 61, pulse is 98 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.82,
      "end_seconds": 74.81,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.07,
      "end_seconds": 84.19,
      "duration_seconds": 8.12,
      "text": "They help me see the whole picture, more shortly. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.24,
      "end_seconds": 88.92,
      "duration_seconds": 2.68,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.92,
      "end_seconds": 93.25,
      "duration_seconds": 2.33,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.79,
      "end_seconds": 103.26,
      "duration_seconds": 7.47,
      "text": "It usually comes with darker skin. The darker skin? That's been for about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.15,
      "end_seconds": 109.86,
      "duration_seconds": 4.71,
      "text": "Have you noticed severe tummy pain, fainting, fever or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.89,
      "end_seconds": 113.82,
      "duration_seconds": 2.93,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.31,
      "end_seconds": 117.27,
      "duration_seconds": 2.96,
      "text": "I follow. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 119.41,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.74,
      "end_seconds": 130.69,
      "duration_seconds": 2.95,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 143.52,
      "duration_seconds": 12.07,
      "text": "Not much, I mostly stay in these days. I retired from the post office two years ago. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.36,
      "end_seconds": 147.72,
      "duration_seconds": 2.36,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.77,
      "end_seconds": 166.11,
      "duration_seconds": 16.34,
      "text": "Yeah, I take alendronate, 70 milligrams, once a week. I'd rather not end up on lots of tablets if I can avoid it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.38,
      "end_seconds": 186.92,
      "duration_seconds": 3.54,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.74,
      "end_seconds": 191.1,
      "duration_seconds": 2.36,
      "text": "Thin bones, for five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.92,
      "end_seconds": 209.86,
      "duration_seconds": 3.94,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.5,
      "end_seconds": 215.05,
      "duration_seconds": 3.55,
      "text": "Yes, cat fur, it gives me wheezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.35,
      "end_seconds": 220.5,
      "duration_seconds": 4.15,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.55,
      "end_seconds": 222.74,
      "duration_seconds": 1.19,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.12,
      "end_seconds": 225.36,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.56,
      "end_seconds": 246.31,
      "duration_seconds": 9.75,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.08,
      "end_seconds": 271.79,
      "duration_seconds": 22.71,
      "text": "Okay, that's enough for me. Putting it all together, my working impression is possible adrenal insufficiency. That's my thinking for now, and it may change as we learn more. We shouldn't forget an underactive thyroid. Let me just check I've got this right. You've been feeling tired and weak, since Monday, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.02,
      "end_seconds": 273.72,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.76,
      "end_seconds": 280.06,
      "duration_seconds": 4.3,
      "text": "I'm going to order blood tests, for possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 281.22,
      "end_seconds": 285.0,
      "duration_seconds": 3.78,
      "text": "I can book that for Wednesday at 11:30 am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.96,
      "end_seconds": 292.61,
      "duration_seconds": 5.65,
      "text": "I'll request a short synacthen test, it'll help with possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.06,
      "end_seconds": 296.6,
      "duration_seconds": 2.54,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.6,
      "end_seconds": 329.99,
      "duration_seconds": 31.39,
      "text": "I'm sending you for a morning cortisol because of possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'm going to send a referral to the endocrine clinic. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check after the results."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.83,
      "end_seconds": 336.08,
      "duration_seconds": 2.25,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.41,
      "end_seconds": 341.79,
      "duration_seconds": 4.38,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.0,
      "end_seconds": 344.53,
      "duration_seconds": 1.53,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.57,
      "end_seconds": 346.96,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}