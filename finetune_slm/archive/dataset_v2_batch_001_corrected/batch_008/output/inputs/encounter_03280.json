{
  "schema_version": "1.0",
  "encounter_id": "03280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.61,
      "duration_seconds": 3.1,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.09,
      "end_seconds": 9.04,
      "duration_seconds": 3.95,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.49,
      "end_seconds": 15.27,
      "duration_seconds": 4.78,
      "text": "I wanted to get headaches most days looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.46,
      "end_seconds": 19.74,
      "duration_seconds": 3.28,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.37,
      "end_seconds": 30.46,
      "duration_seconds": 2.09,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 57.78,
      "duration_seconds": 5.89,
      "text": "Okay: pressure 123 over 69, heart rate 82, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.28,
      "end_seconds": 60.63,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.96,
      "end_seconds": 71.15,
      "duration_seconds": 7.19,
      "text": "Don't worry, we'll discuss it in a second. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.58,
      "end_seconds": 76.98,
      "duration_seconds": 4.4,
      "text": "Um, it's been going on for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.28,
      "end_seconds": 88.35,
      "duration_seconds": 11.07,
      "text": "Hm, okay. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.53,
      "end_seconds": 94.56,
      "duration_seconds": 5.03,
      "text": "honestly, a couple of times a week. Severe, really"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.78,
      "end_seconds": 111.54,
      "duration_seconds": 1.76,
      "text": "What about stiff neck?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.78,
      "end_seconds": 115.6,
      "duration_seconds": 2.82,
      "text": "I haven't noticed any stiff neck."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.17,
      "end_seconds": 118.7,
      "duration_seconds": 2.53,
      "text": "Did you get fever or weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 122.29,
      "duration_seconds": 2.67,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.6,
      "end_seconds": 125.82,
      "duration_seconds": 2.22,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.1,
      "end_seconds": 128.91,
      "duration_seconds": 1.81,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.05,
      "end_seconds": 135.63,
      "duration_seconds": 1.58,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.93,
      "end_seconds": 139.4,
      "duration_seconds": 2.47,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.76,
      "end_seconds": 146.15,
      "duration_seconds": 1.39,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.18,
      "end_seconds": 152.0,
      "duration_seconds": 3.82,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.98,
      "end_seconds": 156.22,
      "duration_seconds": 3.24,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.39,
      "end_seconds": 162.21,
      "duration_seconds": 2.82,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 179.86,
      "duration_seconds": 2.77,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.82,
      "end_seconds": 183.49,
      "duration_seconds": 1.67,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.13,
      "end_seconds": 192.01,
      "duration_seconds": 7.88,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.95,
      "end_seconds": 197.44,
      "duration_seconds": 1.49,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.92,
      "end_seconds": 213.99,
      "duration_seconds": 7.07,
      "text": "Any allergies to tablets, food or anything in the environment? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.78,
      "end_seconds": 224.27,
      "duration_seconds": 4.49,
      "text": "So, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.76,
      "end_seconds": 229.22,
      "duration_seconds": 2.46,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.65,
      "end_seconds": 232.93,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.14,
      "end_seconds": 245.39,
      "duration_seconds": 2.25,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.35,
      "end_seconds": 250.43,
      "duration_seconds": 2.08,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.62,
      "end_seconds": 274.72,
      "duration_seconds": 14.1,
      "text": "Putting it all together, I'd lean towards medication-overuse headache on a background of migraine. So, to recap quickly. You've had headaches most days for ten days, severe, and no stiff neck or fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.38,
      "end_seconds": 278.53,
      "duration_seconds": 3.15,
      "text": "Yes, uh, you've got it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.97,
      "end_seconds": 308.14,
      "duration_seconds": 28.17,
      "text": "I think a headache diary makes sense here, for daily headache. For this, amitriptyline, 10 milligrams, at night, long term. That should help with headache prevention. It's a commonly used medicine and most people tolerate it well. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. Let's review you in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.3,
      "end_seconds": 312.27,
      "duration_seconds": 2.97,
      "text": "I think I understand everything thanks"
    }
  ]
}