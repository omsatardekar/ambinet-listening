{
  "schema_version": "1.0",
  "encounter_id": "03496",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.57,
      "duration_seconds": 4.73,
      "text": "Ah, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 12.21,
      "duration_seconds": 5.42,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.86,
      "end_seconds": 20.32,
      "duration_seconds": 4.46,
      "text": "I wanted to get three early losses looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 27.04,
      "duration_seconds": 5.94,
      "text": "How long has it been like this? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.91,
      "end_seconds": 39.22,
      "duration_seconds": 10.31,
      "text": "It's been going on for two weeks. I just want to get back to normal, you know, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.16,
      "end_seconds": 42.56,
      "duration_seconds": 2.4,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.99,
      "end_seconds": 47.93,
      "duration_seconds": 3.94,
      "text": "Erm, about a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.89,
      "end_seconds": 52.82,
      "duration_seconds": 2.93,
      "text": "Have you been feeling low and anxious?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.03,
      "end_seconds": 65.62,
      "duration_seconds": 11.59,
      "text": "Yeah, that too. Uh, uh, I did have irregular cycles at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 80.69,
      "duration_seconds": 1.81,
      "text": "How about clotting problem?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.41,
      "end_seconds": 83.78,
      "duration_seconds": 2.37,
      "text": "No clotting problem, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.31,
      "end_seconds": 87.92,
      "duration_seconds": 3.61,
      "text": "Did you get heavy bleeding now or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.84,
      "end_seconds": 94.69,
      "duration_seconds": 4.85,
      "text": "I haven't had heavy bleeding now or fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 97.15,
      "duration_seconds": 1.69,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 102.21,
      "duration_seconds": 3.57,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 107.16,
      "duration_seconds": 4.2,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.14,
      "end_seconds": 114.7,
      "duration_seconds": 6.56,
      "text": "Alendronate, 70 milligrams, once a week. Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.17,
      "end_seconds": 115.92,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.45,
      "end_seconds": 137.25,
      "duration_seconds": 3.8,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.18,
      "end_seconds": 151.02,
      "duration_seconds": 12.84,
      "text": "I've had thin bones for about a year now. I've got heart disease. I thought it would sort itself out, you know, but it hasn't."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.36,
      "end_seconds": 154.98,
      "duration_seconds": 2.62,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.98,
      "end_seconds": 166.53,
      "duration_seconds": 9.55,
      "text": "Sorry, what was I saying, I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.72,
      "end_seconds": 172.22,
      "duration_seconds": 4.5,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.88,
      "end_seconds": 185.63,
      "duration_seconds": 12.75,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.65,
      "end_seconds": 198.24,
      "duration_seconds": 3.59,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.11,
      "end_seconds": 204.31,
      "duration_seconds": 5.2,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 209.93,
      "duration_seconds": 3.95,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.38,
      "end_seconds": 223.1,
      "duration_seconds": 2.72,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.2,
      "end_seconds": 248.48,
      "duration_seconds": 7.28,
      "text": "Okay: respiratory rate 18, temperature is 36.7 degrees, pulse 69, BP is 116 over 71."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.74,
      "end_seconds": 254.69,
      "duration_seconds": 3.95,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.49,
      "end_seconds": 258.46,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.06,
      "end_seconds": 270.62,
      "duration_seconds": 1.56,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.51,
      "end_seconds": 272.85,
      "duration_seconds": 1.34,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.66,
      "end_seconds": 286.78,
      "duration_seconds": 9.12,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. This is probably recurrent miscarriage needing investigation."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.83,
      "end_seconds": 291.92,
      "duration_seconds": 3.09,
      "text": "Is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.56,
      "end_seconds": 328.93,
      "duration_seconds": 35.37,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the a pelvic ultrasound is back. I'm going to order a pelvic ultrasound, for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. We'll refer you to the recurrent miscarriage clinic. I'm not ordering blood tests today. If things carry on in a month, we'll consider it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.46,
      "end_seconds": 342.14,
      "duration_seconds": 12.68,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Come back after the results. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.07,
      "end_seconds": 349.71,
      "duration_seconds": 5.64,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.25,
      "end_seconds": 356.67,
      "duration_seconds": 5.42,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.6,
      "end_seconds": 361.15,
      "duration_seconds": 2.55,
      "text": "Thank you, that's helpful."
    }
  ]
}