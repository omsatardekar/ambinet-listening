{
  "schema_version": "1.0",
  "encounter_id": "03354",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.38,
      "end_seconds": 8.24,
      "duration_seconds": 6.86,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.09,
      "end_seconds": 12.96,
      "duration_seconds": 3.87,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.86,
      "end_seconds": 21.65,
      "duration_seconds": 6.79,
      "text": "Hmm, uh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.93,
      "end_seconds": 25.68,
      "duration_seconds": 2.75,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.13,
      "end_seconds": 36.87,
      "duration_seconds": 5.74,
      "text": "Yeah, it's severe back pain. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 42.34,
      "duration_seconds": 3.39,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 46.74,
      "duration_seconds": 3.42,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.73,
      "end_seconds": 51.53,
      "duration_seconds": 2.8,
      "text": "Have you had weakness in the legs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.11,
      "end_seconds": 54.15,
      "duration_seconds": 2.04,
      "text": "Yes, for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.92,
      "end_seconds": 57.63,
      "duration_seconds": 2.71,
      "text": "Has there been a fever too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 77.49,
      "duration_seconds": 17.91,
      "text": "Yes, I have. As for fever, mostly mild. It happens once or twice a day. I've had trouble passing urine too, for about a month. With trouble passing urine, mostly moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.09,
      "end_seconds": 91.58,
      "duration_seconds": 3.49,
      "text": "Any recent fall, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.31,
      "end_seconds": 98.0,
      "duration_seconds": 5.69,
      "text": "No recent fall, chest pain or weight loss, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.97,
      "end_seconds": 102.1,
      "duration_seconds": 2.13,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.38,
      "end_seconds": 104.39,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.15,
      "end_seconds": 109.39,
      "duration_seconds": 4.24,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.65,
      "end_seconds": 113.02,
      "duration_seconds": 2.37,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.33,
      "end_seconds": 132.06,
      "duration_seconds": 3.73,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.46,
      "end_seconds": 139.63,
      "duration_seconds": 6.17,
      "text": "Yeah, I take glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.6,
      "end_seconds": 148.37,
      "duration_seconds": 7.77,
      "text": "It's, It's meant to be before breakfast, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.89,
      "end_seconds": 152.73,
      "duration_seconds": 3.84,
      "text": "Spironolactone, 25 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.8,
      "end_seconds": 157.71,
      "duration_seconds": 3.91,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 163.51,
      "duration_seconds": 5.18,
      "text": "No, it's at home. Injecting drugs. I take it recent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.22,
      "end_seconds": 167.11,
      "duration_seconds": 2.89,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.56,
      "end_seconds": 185.3,
      "duration_seconds": 16.74,
      "text": "I used to drink heavily but I stopped four years ago. I work in accounts at a hospital. I grab fast food at lunch most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.8,
      "end_seconds": 192.79,
      "duration_seconds": 5.99,
      "text": "Has anyone ever diagnosed you with something? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.16,
      "end_seconds": 201.55,
      "duration_seconds": 7.39,
      "text": "Diabetes, for about ten years. I've had heart failure for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.46,
      "end_seconds": 211.86,
      "duration_seconds": 9.4,
      "text": "Right, yes, diabetes and heart failure are known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.76,
      "end_seconds": 222.58,
      "duration_seconds": 8.82,
      "text": "Yes, wheat. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 226.96,
      "end_seconds": 234.97,
      "duration_seconds": 8.01,
      "text": "Okay, so the vitals from earlier. Blood pressure 122 over 77, temperature is 39.2 degrees, heart rate 99."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.43,
      "end_seconds": 237.13,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.89,
      "end_seconds": 243.34,
      "duration_seconds": 4.45,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.74,
      "end_seconds": 247.21,
      "duration_seconds": 2.47,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.16,
      "end_seconds": 272.08,
      "duration_seconds": 6.92,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.89,
      "end_seconds": 280.36,
      "duration_seconds": 2.47,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.6,
      "end_seconds": 314.34,
      "duration_seconds": 16.74,
      "text": "Okay, so my impression is this: I think we're dealing with a possible spinal infection pressing on the nerves at this stage. It could also be a slipped disc, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.26,
      "end_seconds": 318.33,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.02,
      "end_seconds": 334.73,
      "duration_seconds": 15.71,
      "text": "I can't promise yet, but most people with a possible spinal infection pressing on the nerves do well once it's treated properly. I'd like to arrange an urgent MRI of the spine for possible epidural abscess."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 335.44,
      "end_seconds": 336.55,
      "duration_seconds": 1.11,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.68,
      "end_seconds": 355.78,
      "duration_seconds": 18.1,
      "text": "I'm going to order urgent blood tests, for possible spinal infection. You are going to hospital now, this can cause permanent weakness. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 356.35,
      "end_seconds": 358.15,
      "duration_seconds": 1.8,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.95,
      "end_seconds": 369.22,
      "duration_seconds": 10.27,
      "text": "Do get help quickly if the symptoms get worse. Please come and see me straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.83,
      "end_seconds": 371.34,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    }
  ]
}