{
  "schema_version": "1.0",
  "encounter_id": "03399",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 7.57,
      "duration_seconds": 6.61,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.15,
      "end_seconds": 15.0,
      "duration_seconds": 3.85,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.83,
      "end_seconds": 24.65,
      "duration_seconds": 8.82,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. She's been having slurred speech, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.29,
      "end_seconds": 30.04,
      "duration_seconds": 3.75,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.67,
      "end_seconds": 32.76,
      "duration_seconds": 2.09,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.54,
      "end_seconds": 36.91,
      "duration_seconds": 2.37,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.69,
      "end_seconds": 53.25,
      "duration_seconds": 14.56,
      "text": "A four out of ten, I suppose. I've also had confusion, for two months. With confusion, I'd call it mild. And there's shivering that has stopped as well, three days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.25,
      "end_seconds": 59.17,
      "duration_seconds": 3.92,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.95,
      "end_seconds": 62.34,
      "duration_seconds": 2.39,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.64,
      "end_seconds": 79.85,
      "duration_seconds": 4.21,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.83,
      "end_seconds": 85.49,
      "duration_seconds": 3.66,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.16,
      "end_seconds": 88.77,
      "duration_seconds": 1.61,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.51,
      "end_seconds": 93.08,
      "duration_seconds": 3.57,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.93,
      "end_seconds": 96.26,
      "duration_seconds": 2.33,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 101.67,
      "duration_seconds": 3.84,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.54,
      "end_seconds": 105.06,
      "duration_seconds": 2.52,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.15,
      "end_seconds": 120.96,
      "duration_seconds": 12.81,
      "text": "I'm on escitalopram, 10 milligrams, once a day for the anxiety. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.52,
      "end_seconds": 125.74,
      "duration_seconds": 3.22,
      "text": "Alright, how long have you taken that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.68,
      "end_seconds": 129.03,
      "duration_seconds": 1.35,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.38,
      "end_seconds": 150.28,
      "duration_seconds": 4.9,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.94,
      "end_seconds": 157.83,
      "duration_seconds": 5.89,
      "text": "So, yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.55,
      "end_seconds": 160.92,
      "duration_seconds": 2.37,
      "text": "Did you get alcohol or fall?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.69,
      "end_seconds": 164.24,
      "duration_seconds": 2.55,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.83,
      "end_seconds": 167.47,
      "duration_seconds": 2.64,
      "text": "And head injury, any of that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.25,
      "end_seconds": 170.18,
      "duration_seconds": 1.93,
      "text": "No head injury, thankfully."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.73,
      "end_seconds": 173.92,
      "duration_seconds": 3.19,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.96,
      "end_seconds": 176.8,
      "duration_seconds": 1.84,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.68,
      "end_seconds": 181.66,
      "duration_seconds": 2.98,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.38,
      "end_seconds": 184.78,
      "duration_seconds": 2.4,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.22,
      "end_seconds": 189.08,
      "duration_seconds": 2.86,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.93,
      "end_seconds": 203.36,
      "duration_seconds": 2.43,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.99,
      "end_seconds": 223.49,
      "duration_seconds": 8.5,
      "text": "Okay: pulse is 80 beats a minute, blood pressure 110 over 70, respiratory rate 17, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.17,
      "end_seconds": 226.74,
      "duration_seconds": 1.57,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 231.54,
      "duration_seconds": 2.57,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.88,
      "end_seconds": 237.74,
      "duration_seconds": 3.86,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.0,
      "end_seconds": 240.47,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.04,
      "end_seconds": 256.76,
      "duration_seconds": 7.72,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.01,
      "end_seconds": 271.67,
      "duration_seconds": 11.66,
      "text": "Thank you, you can get dressed. Right, here's what I'm thinking. I don't have a clear answer today: severe hypothermia is possible, and so is hypoglycaemia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.58,
      "end_seconds": 276.2,
      "duration_seconds": 3.62,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.12,
      "end_seconds": 284.85,
      "duration_seconds": 6.73,
      "text": "I can't promise yet, but most people with severe hypothermia do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.01,
      "end_seconds": 302.63,
      "duration_seconds": 3.62,
      "text": "I'll request blood tests, it'll help with hypothermia."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.53,
      "end_seconds": 306.91,
      "duration_seconds": 2.38,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.34,
      "end_seconds": 317.33,
      "duration_seconds": 8.99,
      "text": "Let's get an ECG, for bradycardia. Handle gently and warm slowly with warm blankets and warm fluids through the drip."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.73,
      "end_seconds": 340.71,
      "duration_seconds": 22.98,
      "text": "I see, go ahead. A blood sugar is something we might do if this doesn't improve next month. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like to see you again straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.65,
      "end_seconds": 343.68,
      "duration_seconds": 2.03,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.88,
      "end_seconds": 346.47,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}