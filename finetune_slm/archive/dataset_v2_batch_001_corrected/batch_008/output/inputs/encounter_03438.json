{
  "schema_version": "1.0",
  "encounter_id": "03438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 3.72,
      "duration_seconds": 3.18,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.63,
      "end_seconds": 6.54,
      "duration_seconds": 0.91,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 9.7,
      "duration_seconds": 2.33,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.69,
      "end_seconds": 21.53,
      "duration_seconds": 6.84,
      "text": "Doctor, uh, it's flakes on my shoulders. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.05,
      "end_seconds": 24.72,
      "duration_seconds": 2.67,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 40.23,
      "duration_seconds": 3.2,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.12,
      "end_seconds": 64.32,
      "duration_seconds": 9.2,
      "text": "Okay: pressure 122 over 81, pulse is 68 beats a minute, temperature 36.5. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.03,
      "end_seconds": 67.57,
      "duration_seconds": 2.54,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.16,
      "end_seconds": 70.26,
      "duration_seconds": 2.1,
      "text": "Yes. Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 74.42,
      "duration_seconds": 3.11,
      "text": "It settles a little with shampoo."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.88,
      "end_seconds": 83.11,
      "duration_seconds": 3.23,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.98,
      "end_seconds": 90.28,
      "duration_seconds": 5.3,
      "text": "A little redness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.75,
      "end_seconds": 96.48,
      "duration_seconds": 4.73,
      "text": "Let me check a few things. Any hair loss or pus?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.0,
      "end_seconds": 99.9,
      "duration_seconds": 2.9,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.08,
      "end_seconds": 104.31,
      "duration_seconds": 3.23,
      "text": "A few quick ones: pain or rash elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.49,
      "end_seconds": 109.67,
      "duration_seconds": 4.18,
      "text": "No pain or rash elsewhere, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.43,
      "end_seconds": 116.76,
      "duration_seconds": 4.33,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.7,
      "end_seconds": 120.8,
      "duration_seconds": 3.1,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.81,
      "end_seconds": 126.3,
      "duration_seconds": 3.49,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.28,
      "end_seconds": 131.74,
      "duration_seconds": 1.46,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.29,
      "end_seconds": 151.11,
      "duration_seconds": 1.82,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.88,
      "end_seconds": 153.49,
      "duration_seconds": 1.61,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 156.69,
      "duration_seconds": 2.11,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.39,
      "end_seconds": 161.31,
      "duration_seconds": 3.92,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.39,
      "end_seconds": 166.71,
      "duration_seconds": 3.32,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 175.64,
      "duration_seconds": 3.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.21,
      "end_seconds": 177.82,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 181.31,
      "duration_seconds": 2.44,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.6,
      "end_seconds": 185.08,
      "duration_seconds": 2.48,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.12,
      "end_seconds": 190.15,
      "duration_seconds": 4.03,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.08,
      "end_seconds": 210.47,
      "duration_seconds": 2.39,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.51,
      "end_seconds": 223.28,
      "duration_seconds": 10.77,
      "text": "I, I had keyhole surgery on my gallbladder two years back. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.79,
      "end_seconds": 237.99,
      "duration_seconds": 3.2,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.81,
      "end_seconds": 241.92,
      "duration_seconds": 3.11,
      "text": "Well, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.38,
      "end_seconds": 245.78,
      "duration_seconds": 2.4,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.73,
      "end_seconds": 248.44,
      "duration_seconds": 1.71,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.66,
      "end_seconds": 269.49,
      "duration_seconds": 4.83,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.4,
      "end_seconds": 286.44,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.34,
      "end_seconds": 296.16,
      "duration_seconds": 6.82,
      "text": "That's the examination finished. Putting it all together, my working impression is simple dandruff."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.13,
      "end_seconds": 303.83,
      "duration_seconds": 3.7,
      "text": "Right, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.97,
      "end_seconds": 332.85,
      "duration_seconds": 27.88,
      "text": "I understand the worry. At the moment I'd say it's simple dandruff, and we'll watch how it goes. We'll begin with ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. Leave the shampoo on for five minutes before rinsing. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.82,
      "end_seconds": 335.73,
      "duration_seconds": 1.91,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.06,
      "end_seconds": 341.05,
      "duration_seconds": 3.99,
      "text": "I'll want another look if not better in a month."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.09,
      "end_seconds": 344.29,
      "duration_seconds": 2.2,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.88,
      "end_seconds": 349.66,
      "duration_seconds": 4.78,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.85,
      "end_seconds": 356.26,
      "duration_seconds": 2.41,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}