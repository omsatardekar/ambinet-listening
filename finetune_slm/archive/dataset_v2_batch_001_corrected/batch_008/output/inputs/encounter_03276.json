{
  "schema_version": "1.0",
  "encounter_id": "03276",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 2.48,
      "duration_seconds": 1.65,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.54,
      "end_seconds": 5.76,
      "duration_seconds": 1.22,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.46,
      "end_seconds": 10.84,
      "duration_seconds": 2.38,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 17.32,
      "duration_seconds": 5.96,
      "text": "So, uh, I've been coughing up large amounts of blood, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.13,
      "end_seconds": 22.32,
      "duration_seconds": 3.19,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.37,
      "end_seconds": 26.7,
      "duration_seconds": 3.33,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.83,
      "end_seconds": 30.93,
      "duration_seconds": 3.1,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.03,
      "end_seconds": 37.07,
      "duration_seconds": 5.04,
      "text": "I'd call it moderate. I've also had breathlessness, for six months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 41.71,
      "duration_seconds": 2.59,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 47.86,
      "duration_seconds": 4.54,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.58,
      "end_seconds": 54.73,
      "duration_seconds": 2.15,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.62,
      "end_seconds": 69.14,
      "duration_seconds": 12.52,
      "text": "Yeah. One week, I'd say. With feeling faint, it feels severe to me. I had a gurgling chest before. That's settled now, though."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 74.77,
      "duration_seconds": 4.47,
      "text": "And what about weight loss, fever or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 78.93,
      "duration_seconds": 2.92,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.71,
      "end_seconds": 84.43,
      "duration_seconds": 3.72,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.81,
      "end_seconds": 87.78,
      "duration_seconds": 1.97,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.23,
      "end_seconds": 93.63,
      "duration_seconds": 3.4,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.75,
      "end_seconds": 96.84,
      "duration_seconds": 2.09,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.71,
      "end_seconds": 108.95,
      "duration_seconds": 2.24,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.64,
      "end_seconds": 115.69,
      "duration_seconds": 5.05,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 134.69,
      "duration_seconds": 1.33,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.19,
      "end_seconds": 142.01,
      "duration_seconds": 2.82,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.06,
      "end_seconds": 145.52,
      "duration_seconds": 1.46,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.44,
      "end_seconds": 150.96,
      "duration_seconds": 4.52,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.84,
      "end_seconds": 161.66,
      "duration_seconds": 2.82,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.31,
      "end_seconds": 165.51,
      "duration_seconds": 3.2,
      "text": "I've had eczema for two years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.5,
      "end_seconds": 167.41,
      "duration_seconds": 0.91,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.15,
      "end_seconds": 173.72,
      "duration_seconds": 4.57,
      "text": "I've had an underactive thyroid for about ten years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.69,
      "end_seconds": 179.77,
      "duration_seconds": 2.08,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.84,
      "end_seconds": 188.29,
      "duration_seconds": 7.45,
      "text": "It's hydrocortisone cream, when needed for the eczema. Thyroxine, 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.07,
      "end_seconds": 194.06,
      "duration_seconds": 3.99,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.1,
      "end_seconds": 198.48,
      "duration_seconds": 2.38,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 203.54,
      "duration_seconds": 3.79,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.1,
      "end_seconds": 212.46,
      "duration_seconds": 5.36,
      "text": "My aunt has rheumatoid arthritis. My mother had a stroke."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.55,
      "end_seconds": 217.36,
      "duration_seconds": 3.81,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.37,
      "end_seconds": 229.89,
      "duration_seconds": 10.52,
      "text": "I was told I'm allergic to plasters, but I don't remember what reaction I had. I'm allergic to tramadol, I get vomiting."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.94,
      "end_seconds": 234.3,
      "duration_seconds": 2.36,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.73,
      "end_seconds": 244.72,
      "duration_seconds": 2.99,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.82,
      "end_seconds": 273.89,
      "duration_seconds": 8.07,
      "text": "Okay: pressure 131 over 81, temperature 37.5. And respiratory rate 20, pulse 99, oxygen saturation is 92 percent."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.12,
      "end_seconds": 276.55,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.2,
      "end_seconds": 281.64,
      "duration_seconds": 3.44,
      "text": "Okay, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.86,
      "end_seconds": 286.26,
      "duration_seconds": 2.4,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.14,
      "end_seconds": 289.43,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.1,
      "end_seconds": 303.28,
      "duration_seconds": 5.18,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.76,
      "end_seconds": 315.28,
      "duration_seconds": 7.52,
      "text": "You can relax now. Taking everything into account, this is probably life-threatening haemoptysis. We shouldn't forget a lung tumour."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.65,
      "end_seconds": 318.28,
      "duration_seconds": 1.63,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.26,
      "end_seconds": 335.29,
      "duration_seconds": 13.03,
      "text": "Nothing I've seen today points to an emergency. It looks like life-threatening haemoptysis, but I'd like to confirm. An urgent CT scan is what I'd like next, for massive haemoptysis."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 336.41,
      "end_seconds": 340.02,
      "duration_seconds": 3.61,
      "text": "I can book that for Friday at 11:30 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.24,
      "end_seconds": 373.56,
      "duration_seconds": 32.32,
      "text": "Urgent blood tests is what I'd like next, for bleeding. I'd like you to take tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.39,
      "end_seconds": 385.16,
      "duration_seconds": 9.77,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.87,
      "end_seconds": 389.91,
      "duration_seconds": 3.04,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.98,
      "end_seconds": 404.46,
      "duration_seconds": 13.48,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Book a review straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.37,
      "end_seconds": 407.6,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}