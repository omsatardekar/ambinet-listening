{
  "schema_version": "1.0",
  "encounter_id": "03136",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.16,
      "duration_seconds": 3.36,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.81,
      "end_seconds": 10.99,
      "duration_seconds": 5.18,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.35,
      "end_seconds": 17.51,
      "duration_seconds": 5.16,
      "text": "I wanted to get a severe headache for days looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.42,
      "end_seconds": 21.82,
      "duration_seconds": 3.4,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.97,
      "end_seconds": 35.63,
      "duration_seconds": 12.66,
      "text": "Ah, about... well, three days. It's a relief to finally sit down and talk about it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.14,
      "end_seconds": 40.87,
      "duration_seconds": 4.73,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.48,
      "end_seconds": 48.73,
      "duration_seconds": 6.25,
      "text": "Honestly, a couple of times a week. It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.03,
      "end_seconds": 52.01,
      "duration_seconds": 1.98,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.99,
      "end_seconds": 61.68,
      "duration_seconds": 8.69,
      "text": "When it starts I tend to get drowsiness as well. The drowsiness? That's been since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.57,
      "end_seconds": 80.9,
      "duration_seconds": 5.33,
      "text": "Have you noticed weakness on one side, fever or head injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.51,
      "end_seconds": 84.22,
      "duration_seconds": 2.71,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.25,
      "end_seconds": 88.27,
      "duration_seconds": 2.02,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.75,
      "end_seconds": 91.84,
      "duration_seconds": 2.09,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.88,
      "end_seconds": 96.97,
      "duration_seconds": 3.09,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.27,
      "end_seconds": 103.17,
      "duration_seconds": 4.9,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.06,
      "end_seconds": 123.79,
      "duration_seconds": 1.73,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.31,
      "end_seconds": 127.97,
      "duration_seconds": 3.66,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.4,
      "end_seconds": 131.71,
      "duration_seconds": 2.31,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.79,
      "end_seconds": 138.06,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.98,
      "end_seconds": 141.99,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.05,
      "end_seconds": 147.93,
      "duration_seconds": 3.88,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.28,
      "end_seconds": 163.87,
      "duration_seconds": 3.59,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.92,
      "end_seconds": 169.03,
      "duration_seconds": 4.11,
      "text": "Erm, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.02,
      "end_seconds": 175.42,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.02,
      "end_seconds": 180.84,
      "duration_seconds": 3.82,
      "text": "Yeah, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 185.8,
      "duration_seconds": 2.04,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.92,
      "end_seconds": 189.73,
      "duration_seconds": 2.81,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 195.14,
      "duration_seconds": 4.89,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.82,
      "end_seconds": 209.48,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.9,
      "end_seconds": 229.28,
      "duration_seconds": 9.38,
      "text": "Okay: oxygen saturation is 96 percent, pulse is 85 beats a minute. And blood pressure 169 over 89, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.93,
      "end_seconds": 235.17,
      "duration_seconds": 4.24,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.54,
      "end_seconds": 244.24,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.33,
      "end_seconds": 247.45,
      "duration_seconds": 2.12,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.45,
      "end_seconds": 269.14,
      "duration_seconds": 3.69,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.43,
      "end_seconds": 304.95,
      "duration_seconds": 31.52,
      "text": "Thank you, you can get dressed. So where does that leave us? I think we're dealing with possible cerebral venous thrombosis at this stage. I want to be honest that this is an impression, not a final answer. Let's get an MRI of the head, for papilloedema. Stop the pill, you need an urgent scan and admission. I'll also refer you to the neurology team. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.91,
      "end_seconds": 310.02,
      "duration_seconds": 1.11,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.88,
      "end_seconds": 312.95,
      "duration_seconds": 2.07,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.26,
      "end_seconds": 316.11,
      "duration_seconds": 1.85,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.81,
      "end_seconds": 321.79,
      "duration_seconds": 4.98,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.47,
      "end_seconds": 325.78,
      "duration_seconds": 3.31,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.3,
      "end_seconds": 330.99,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}