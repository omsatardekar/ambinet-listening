  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 2.29,
      "duration_seconds": 1.68,
      "text": "welcome. Make yourself comfortable"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.64,
      "end_seconds": 6.56,
      "duration_seconds": 2.92,
      "text": "So, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 10.0,
      "duration_seconds": 2.5,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 16.23,
      "duration_seconds": 4.29,
      "text": "So the thing is, I've got headaches most days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.93,
      "end_seconds": 20.8,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 24.28,
      "duration_seconds": 2.27,
      "text": "about... well, two days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.28,
      "end_seconds": 37.54,
      "duration_seconds": 12.26,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.18,
      "end_seconds": 50.25,
      "duration_seconds": 11.07,
      "text": "erm, it feels mild to me it just comes and goes there's light sensitivity as well about light sensitivity, mostly mild"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 67.72,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.64,
      "end_seconds": 73.68,
      "duration_seconds": 4.04,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 77.17,
      "duration_seconds": 2.44,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.75,
      "end_seconds": 81.8,
      "duration_seconds": 4.05,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.8,
      "end_seconds": 87.95,
      "duration_seconds": 4.15,
      "text": "So, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.91,
      "end_seconds": 92.57,
      "duration_seconds": 1.66,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.6,
      "end_seconds": 108.4,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.32,
      "end_seconds": 110.46,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.16,
      "end_seconds": 114.33,
      "duration_seconds": 3.17,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.53,
      "end_seconds": 118.14,
      "duration_seconds": 2.61,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 122.47,
      "duration_seconds": 2.6,
      "text": "Alright, any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.49,
      "end_seconds": 126.47,
      "duration_seconds": 2.98,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 133.95,
      "duration_seconds": 5.72,
      "text": "Let me check a few things. Any visual changes, weakness or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.65,
      "end_seconds": 141.38,
      "duration_seconds": 5.73,
      "text": "okay, so I haven't had visual changes, weakness or fever, no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.04,
      "end_seconds": 145.31,
      "duration_seconds": 3.27,
      "text": "Have you had stiff neck, by any chance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.86,
      "end_seconds": 151.06,
      "duration_seconds": 4.2,
      "text": "Not that I've noticed, um, no stiff neck."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 157.02,
      "duration_seconds": 4.75,
      "text": "Alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.03,
      "end_seconds": 163.95,
      "duration_seconds": 5.92,
      "text": "Um, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.74,
      "end_seconds": 168.28,
      "duration_seconds": 3.54,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.68,
      "end_seconds": 179.74,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.2,
      "end_seconds": 200.32,
      "duration_seconds": 11.12,
      "text": "Okay: BP is 118 over 81, saturation 98 percent, respiratory rate 17, pulse 79, temp 36.6 degrees, height 179 centimetres, weight 85 kilos."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.37,
      "end_seconds": 206.07,
      "duration_seconds": 3.7,
      "text": "So, um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.21,
      "end_seconds": 210.97,
      "duration_seconds": 3.76,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.99,
      "end_seconds": 218.09,
      "duration_seconds": 5.1,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.78,
      "end_seconds": 222.42,
      "duration_seconds": 2.64,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.6,
      "end_seconds": 238.0,
      "duration_seconds": 2.4,
      "text": "your neurological examination is normal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.63,
      "end_seconds": 245.37,
      "duration_seconds": 2.74,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.69,
      "end_seconds": 278.79,
      "duration_seconds": 19.1,
      "text": "So where does that leave us? The most likely explanation is medication-overuse headache on a background of migraine. Let me repeat that back to make sure. You've had headaches most days for two days, mild, and no stiff neck or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.2,
      "end_seconds": 281.69,
      "duration_seconds": 1.49,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.52,
      "end_seconds": 285.92,
      "duration_seconds": 3.4,
      "text": "let's get a headache diary, for daily headache"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.27,
      "end_seconds": 288.86,
      "duration_seconds": 1.59,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.8,
      "end_seconds": 305.7,
      "duration_seconds": 14.9,
      "text": "We'll begin with amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That should help with headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.97,
      "end_seconds": 310.18,
      "duration_seconds": 4.21,
      "text": "Yes. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.71,
      "end_seconds": 312.73,
      "duration_seconds": 2.02,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.29,
      "end_seconds": 319.0,
      "duration_seconds": 5.71,
      "text": "let's plan a check in six weeks does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.92,
      "end_seconds": 322.93,
      "duration_seconds": 2.01,
      "text": "thank you, that's helpful"
    }
  ]
}