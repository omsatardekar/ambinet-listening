{
  "schema_version": "1.0",
  "encounter_id": "03375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.68,
      "duration_seconds": 4.33,
      "text": "Good evening, uh, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.67,
      "end_seconds": 11.7,
      "duration_seconds": 4.03,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.6,
      "end_seconds": 20.18,
      "duration_seconds": 6.58,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.67,
      "end_seconds": 32.48,
      "duration_seconds": 10.81,
      "text": "Mainly a splash of cleaning fluid in my eye. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.33,
      "end_seconds": 40.08,
      "duration_seconds": 2.75,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.55,
      "end_seconds": 46.06,
      "duration_seconds": 4.51,
      "text": "I've, I've had it for about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.11,
      "end_seconds": 49.94,
      "duration_seconds": 2.83,
      "text": "How much does it it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.34,
      "end_seconds": 52.94,
      "duration_seconds": 1.6,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.34,
      "end_seconds": 56.7,
      "duration_seconds": 2.36,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 63.01,
      "duration_seconds": 4.82,
      "text": "Severe burning goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.84,
      "end_seconds": 67.73,
      "duration_seconds": 2.89,
      "text": "Alright, have you had blurred vision?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.56,
      "end_seconds": 74.76,
      "duration_seconds": 6.2,
      "text": "yeah, that too the, The severe burning? That's been since yesterday"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.84,
      "end_seconds": 78.32,
      "duration_seconds": 2.48,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.01,
      "end_seconds": 94.36,
      "duration_seconds": 2.35,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.28,
      "end_seconds": 120.88,
      "duration_seconds": 7.6,
      "text": "okay: heart rate 79, pressure 115 over 71. And temperature is 36.7 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.59,
      "end_seconds": 122.94,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 127.2,
      "duration_seconds": 3.01,
      "text": "Alright, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 131.89,
      "duration_seconds": 3.31,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.47,
      "end_seconds": 135.13,
      "duration_seconds": 1.66,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 138.84,
      "duration_seconds": 1.8,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.29,
      "end_seconds": 159.32,
      "duration_seconds": 8.03,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.76,
      "end_seconds": 168.69,
      "duration_seconds": 5.93,
      "text": "good, you can sit up again. Any both eyes or head injury at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.83,
      "end_seconds": 172.28,
      "duration_seconds": 2.45,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.71,
      "end_seconds": 176.83,
      "duration_seconds": 3.12,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.62,
      "end_seconds": 180.51,
      "duration_seconds": 1.89,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.49,
      "end_seconds": 184.79,
      "duration_seconds": 3.3,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.54,
      "end_seconds": 187.53,
      "duration_seconds": 1.99,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.6,
      "end_seconds": 192.98,
      "duration_seconds": 2.38,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.75,
      "end_seconds": 197.06,
      "duration_seconds": 3.31,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.38,
      "end_seconds": 203.7,
      "duration_seconds": 5.32,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.48,
      "end_seconds": 208.94,
      "duration_seconds": 4.46,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 229.77,
      "duration_seconds": 3.76,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.66,
      "end_seconds": 233.51,
      "duration_seconds": 1.85,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.49,
      "end_seconds": 236.29,
      "duration_seconds": 1.8,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.13,
      "end_seconds": 239.58,
      "duration_seconds": 1.45,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.33,
      "end_seconds": 246.88,
      "duration_seconds": 5.55,
      "text": "Right, right. Okay, I can see eczema in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.93,
      "end_seconds": 258.46,
      "duration_seconds": 2.53,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.02,
      "end_seconds": 264.78,
      "duration_seconds": 4.76,
      "text": "It's omeprazole, 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.07,
      "end_seconds": 265.85,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.4,
      "end_seconds": 272.75,
      "duration_seconds": 4.35,
      "text": "I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.41,
      "end_seconds": 277.28,
      "duration_seconds": 2.87,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.15,
      "end_seconds": 281.25,
      "duration_seconds": 2.1,
      "text": "about about a month"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.81,
      "end_seconds": 284.03,
      "duration_seconds": 1.22,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.03,
      "end_seconds": 288.8,
      "duration_seconds": 3.77,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.48,
      "end_seconds": 291.19,
      "duration_seconds": 1.71,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.04,
      "end_seconds": 297.04,
      "duration_seconds": 5.0,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.96,
      "end_seconds": 300.49,
      "duration_seconds": 2.53,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.66,
      "end_seconds": 305.1,
      "duration_seconds": 3.44,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.17,
      "end_seconds": 309.1,
      "duration_seconds": 2.93,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.65,
      "end_seconds": 312.92,
      "duration_seconds": 3.27,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.95,
      "end_seconds": 318.23,
      "duration_seconds": 3.28,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.95,
      "end_seconds": 322.69,
      "duration_seconds": 3.74,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.2,
      "end_seconds": 352.52,
      "duration_seconds": 13.32,
      "text": "Having listened and examined, I think we're dealing with an alkali chemical burn to the eye at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.02,
      "end_seconds": 357.44,
      "duration_seconds": 4.42,
      "text": "Actually, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.06,
      "end_seconds": 382.41,
      "duration_seconds": 23.35,
      "text": "it's reasonable to be concerned, but right now an alkali chemical burn to the eye is my leading thought, not anything worse we should do an urgent eye assessment for chemical eye injury it's a routine test and it'll give us a much clearer picture come back straight away right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.95,
      "end_seconds": 385.08,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.08,
      "end_seconds": 387.25,
      "duration_seconds": 1.17,
      "text": "all the best"
    }
  ]
}