{
  "schema_version": "1.0",
  "encounter_id": "03374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 5.31,
      "duration_seconds": 4.64,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 9.79,
      "duration_seconds": 3.95,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.78,
      "end_seconds": 17.89,
      "duration_seconds": 6.11,
      "text": "It's, It's severe back pain. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.94,
      "end_seconds": 22.77,
      "duration_seconds": 2.83,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.22,
      "end_seconds": 37.56,
      "duration_seconds": 13.34,
      "text": "It's been going on for two days. I wasn't sure whether to come in at all, to be honest. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.92,
      "end_seconds": 40.91,
      "duration_seconds": 1.99,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.39,
      "end_seconds": 48.95,
      "duration_seconds": 3.56,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.0,
      "end_seconds": 53.81,
      "duration_seconds": 2.81,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.59,
      "end_seconds": 56.65,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 61.17,
      "duration_seconds": 2.44,
      "text": "Any trouble passing urine as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.31,
      "end_seconds": 69.95,
      "duration_seconds": 4.64,
      "text": "Yes, um, about the same, two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.53,
      "end_seconds": 73.86,
      "duration_seconds": 3.33,
      "text": "So, any weakness in the legs as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.56,
      "end_seconds": 77.08,
      "duration_seconds": 1.52,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.71,
      "end_seconds": 83.54,
      "duration_seconds": 5.83,
      "text": "Let me check a few things. Any weight loss or recent fall?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.62,
      "end_seconds": 88.41,
      "duration_seconds": 3.79,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.29,
      "end_seconds": 92.31,
      "duration_seconds": 2.02,
      "text": "Any sign of chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.32,
      "end_seconds": 97.06,
      "duration_seconds": 3.74,
      "text": "Not that I've noticed, no chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.03,
      "end_seconds": 101.58,
      "duration_seconds": 2.55,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.38,
      "end_seconds": 104.93,
      "duration_seconds": 1.55,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.93,
      "end_seconds": 110.06,
      "duration_seconds": 4.13,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.92,
      "end_seconds": 115.52,
      "duration_seconds": 3.6,
      "text": "I've had diabetes, yes. Yes, thin bones."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.71,
      "end_seconds": 126.7,
      "duration_seconds": 9.99,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.3,
      "end_seconds": 129.7,
      "duration_seconds": 2.4,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.41,
      "end_seconds": 132.94,
      "duration_seconds": 2.53,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.0,
      "end_seconds": 138.85,
      "duration_seconds": 4.85,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.7,
      "end_seconds": 156.49,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.25,
      "end_seconds": 161.46,
      "duration_seconds": 3.21,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.67,
      "end_seconds": 169.36,
      "duration_seconds": 1.69,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.3,
      "end_seconds": 175.47,
      "duration_seconds": 4.17,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.93,
      "end_seconds": 181.25,
      "duration_seconds": 3.32,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.17,
      "end_seconds": 185.96,
      "duration_seconds": 2.79,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.56,
      "end_seconds": 189.92,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.73,
      "end_seconds": 194.44,
      "duration_seconds": 3.71,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.63,
      "end_seconds": 209.73,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.91,
      "end_seconds": 220.96,
      "duration_seconds": 10.05,
      "text": "Sitagliptin. I take it 100 milligrams, once a day for my sugar. I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 226.14,
      "duration_seconds": 3.88,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.12,
      "end_seconds": 236.62,
      "duration_seconds": 2.5,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.03,
      "end_seconds": 261.69,
      "duration_seconds": 7.66,
      "text": "Okay: SpO2 97 percent on room air, BP is 112 over 68, temp 38.3 degrees, pulse 97."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.5,
      "end_seconds": 267.05,
      "duration_seconds": 3.55,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.36,
      "end_seconds": 270.84,
      "duration_seconds": 2.48,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 275.31,
      "duration_seconds": 3.35,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.11,
      "end_seconds": 278.4,
      "duration_seconds": 2.29,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.93,
      "end_seconds": 291.84,
      "duration_seconds": 5.91,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.59,
      "end_seconds": 299.5,
      "duration_seconds": 1.91,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.1,
      "end_seconds": 346.74,
      "duration_seconds": 30.64,
      "text": "Okay, thinking it through, I think we're dealing with a possible spinal infection pressing on the nerves at this stage. That's my thinking for now, and it may change as we learn more. I think an urgent MRI of the spine makes sense here, for possible epidural abscess. You are going to hospital now, this can cause permanent weakness. Let's get you seen by the spinal team, I'll arrange the letter. Book a review straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.27,
      "end_seconds": 349.88,
      "duration_seconds": 2.61,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.63,
      "end_seconds": 354.65,
      "duration_seconds": 3.02,
      "text": "I think I understand everything. Thanks."
    }
  ]
}