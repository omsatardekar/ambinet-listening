{
  "schema_version": "1.0",
  "encounter_id": "03483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.21,
      "duration_seconds": 3.52,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 9.02,
      "duration_seconds": 3.67,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.63,
      "end_seconds": 12.78,
      "duration_seconds": 3.15,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.44,
      "end_seconds": 22.34,
      "duration_seconds": 7.9,
      "text": "Doctor, it's sudden severe pain in the lower tummy. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.92,
      "end_seconds": 27.2,
      "duration_seconds": 3.28,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.13,
      "end_seconds": 32.24,
      "duration_seconds": 3.11,
      "text": "for about two weeks, I'd say"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.96,
      "end_seconds": 36.35,
      "duration_seconds": 2.39,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.84,
      "end_seconds": 46.65,
      "duration_seconds": 6.81,
      "text": "It, It sort of comes and goes. Oh, and shoulder tip pain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.75,
      "end_seconds": 63.09,
      "duration_seconds": 3.34,
      "text": "A few quick ones: discharge, fever or vomiting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.25,
      "end_seconds": 70.39,
      "duration_seconds": 3.14,
      "text": "No, no discharge, fever or vomiting."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.03,
      "end_seconds": 75.55,
      "duration_seconds": 3.52,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.48,
      "end_seconds": 78.35,
      "duration_seconds": 1.87,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.8,
      "end_seconds": 82.11,
      "duration_seconds": 2.31,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.49,
      "end_seconds": 88.4,
      "duration_seconds": 1.91,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.97,
      "end_seconds": 91.65,
      "duration_seconds": 2.68,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.14,
      "end_seconds": 97.49,
      "duration_seconds": 4.35,
      "text": "I had a a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.04,
      "end_seconds": 102.88,
      "duration_seconds": 3.84,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 108.83,
      "duration_seconds": 2.37,
      "text": "I'm on sumatriptan, when needed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.66,
      "end_seconds": 112.01,
      "duration_seconds": 2.35,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.74,
      "end_seconds": 117.99,
      "duration_seconds": 5.25,
      "text": "It's 50 milligrams. I take hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.98,
      "end_seconds": 124.03,
      "duration_seconds": 3.05,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.95,
      "end_seconds": 126.33,
      "duration_seconds": 1.38,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.0,
      "end_seconds": 147.77,
      "duration_seconds": 2.77,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.32,
      "end_seconds": 153.23,
      "duration_seconds": 3.91,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.74,
      "end_seconds": 157.57,
      "duration_seconds": 3.83,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.0,
      "end_seconds": 170.73,
      "duration_seconds": 8.73,
      "text": "I've had migraines, yes i have high blood pressure, for about a year yes, heart disease"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.85,
      "end_seconds": 177.14,
      "duration_seconds": 5.29,
      "text": "Alright, migraines and high blood pressure, that matches what I have here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.99,
      "end_seconds": 192.41,
      "duration_seconds": 3.42,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.39,
      "end_seconds": 197.59,
      "duration_seconds": 3.2,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.98,
      "end_seconds": 202.42,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.4,
      "end_seconds": 207.08,
      "duration_seconds": 3.68,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.44,
      "end_seconds": 210.96,
      "duration_seconds": 2.52,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.69,
      "end_seconds": 226.94,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.3,
      "end_seconds": 245.41,
      "duration_seconds": 8.11,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 17, pulse 98, temperature 37.2, pressure 98 over 64."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.62,
      "end_seconds": 252.11,
      "duration_seconds": 4.49,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.59,
      "end_seconds": 255.68,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.12,
      "end_seconds": 273.63,
      "duration_seconds": 6.51,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.7,
      "end_seconds": 310.73,
      "duration_seconds": 33.03,
      "text": "Please sit back down. Let me tell you where I've got to. I'd lean towards a ruptured ectopic pregnancy. It could also be a ruptured ovarian cyst, so we'll keep that open. I'd like to arrange a pregnancy test for collapse. I'd like to arrange urgent blood tests for internal bleeding. I am calling the emergency team, you need an operation now. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.85,
      "end_seconds": 315.02,
      "duration_seconds": 3.17,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.93,
      "end_seconds": 320.32,
      "duration_seconds": 3.39,
      "text": "hmm, okay, I'll arrange it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.86,
      "end_seconds": 326.12,
      "duration_seconds": 3.26,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.38,
      "end_seconds": 329.98,
      "duration_seconds": 2.6,
      "text": "So, thank you, that's helpful."
    }
  ]
}