{
  "schema_version": "1.0",
  "encounter_id": "03109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.93,
      "duration_seconds": 3.88,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 12.35,
      "duration_seconds": 4.13,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.33,
      "end_seconds": 18.71,
      "duration_seconds": 4.38,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.43,
      "end_seconds": 22.46,
      "duration_seconds": 3.03,
      "text": "Alright, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.41,
      "end_seconds": 29.49,
      "duration_seconds": 6.08,
      "text": "Yeah, it's vomiting once or twice. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.59,
      "end_seconds": 34.97,
      "duration_seconds": 3.38,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.37,
      "end_seconds": 39.97,
      "duration_seconds": 3.6,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.92,
      "end_seconds": 46.09,
      "duration_seconds": 5.17,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 51.45,
      "duration_seconds": 4.45,
      "text": "It's moderate, honestly. It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.81,
      "end_seconds": 55.53,
      "duration_seconds": 2.72,
      "text": "Have you had a mild tummy ache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.92,
      "end_seconds": 64.64,
      "duration_seconds": 7.72,
      "text": "Yeah. Three days, I'd say. I had loose stools before. That's settled now, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.94,
      "end_seconds": 67.96,
      "duration_seconds": 2.02,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 68.84,
      "end_seconds": 79.03,
      "duration_seconds": 10.19,
      "text": "So, um, it's metoprolol, 50 milligrams, twice a day, doctor. He takes pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.43,
      "end_seconds": 83.34,
      "duration_seconds": 3.91,
      "text": "Hm, okay. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.25,
      "end_seconds": 87.16,
      "duration_seconds": 2.91,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.71,
      "end_seconds": 92.24,
      "duration_seconds": 3.53,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.5,
      "end_seconds": 96.31,
      "duration_seconds": 2.81,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.09,
      "end_seconds": 98.39,
      "duration_seconds": 1.3,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.26,
      "end_seconds": 100.89,
      "duration_seconds": 1.63,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.8,
      "end_seconds": 106.46,
      "duration_seconds": 4.66,
      "text": "Alright, acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.67,
      "end_seconds": 124.81,
      "duration_seconds": 5.14,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.88,
      "end_seconds": 138.31,
      "duration_seconds": 11.43,
      "text": "I smoke roughly a pack every two days. I look after my grandchildren most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.59,
      "end_seconds": 156.28,
      "duration_seconds": 5.69,
      "text": "Did you get no wet nappies, drowsiness, high fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.24,
      "end_seconds": 164.43,
      "duration_seconds": 7.19,
      "text": "I haven't had no wet nappies, drowsiness, high fever or blood in the stool, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.22,
      "end_seconds": 168.0,
      "duration_seconds": 2.78,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.4,
      "end_seconds": 172.01,
      "duration_seconds": 2.61,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.06,
      "end_seconds": 177.69,
      "duration_seconds": 4.63,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.61,
      "end_seconds": 193.17,
      "duration_seconds": 2.56,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.87,
      "end_seconds": 217.11,
      "duration_seconds": 8.24,
      "text": "Okay: pressure 127 over 82, temp 36.7 degrees, respiratory rate 16, pulse 86, saturation 97 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.23,
      "end_seconds": 222.65,
      "duration_seconds": 3.42,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.65,
      "end_seconds": 225.89,
      "duration_seconds": 2.24,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 245.62,
      "duration_seconds": 5.54,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 251.65,
      "duration_seconds": 1.7,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.97,
      "end_seconds": 288.03,
      "duration_seconds": 18.06,
      "text": "Right, here's what I'm thinking. My working impression is a mild stomach bug. Small, frequent sips of fluid and keep him off nursery for two days after it stops. Let's review you if he is not drinking."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.31,
      "end_seconds": 291.22,
      "duration_seconds": 1.91,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.01,
      "end_seconds": 296.64,
      "duration_seconds": 4.63,
      "text": "So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.63,
      "end_seconds": 300.72,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}