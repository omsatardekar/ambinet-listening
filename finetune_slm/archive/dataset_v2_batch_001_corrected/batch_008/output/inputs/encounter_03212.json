  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 2.54,
      "duration_seconds": 1.48,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.04,
      "end_seconds": 9.89,
      "duration_seconds": 5.85,
      "text": "Okay, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.36,
      "end_seconds": 19.44,
      "duration_seconds": 6.08,
      "text": "Doctor, it's three early losses. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.94,
      "end_seconds": 24.29,
      "duration_seconds": 3.35,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.38,
      "end_seconds": 30.06,
      "duration_seconds": 3.68,
      "text": "it's been going on for about a month"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.29,
      "end_seconds": 34.2,
      "duration_seconds": 3.91,
      "text": "Hm, okay. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.48,
      "end_seconds": 36.55,
      "duration_seconds": 1.07,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.12,
      "end_seconds": 42.72,
      "duration_seconds": 5.6,
      "text": "Hm, okay. Okay, what about irregular cycles, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.8,
      "end_seconds": 46.37,
      "duration_seconds": 1.57,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.54,
      "end_seconds": 50.99,
      "duration_seconds": 3.45,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.54,
      "end_seconds": 53.66,
      "duration_seconds": 1.12,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.51,
      "end_seconds": 64.4,
      "duration_seconds": 0.89,
      "text": "any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 68.25,
      "duration_seconds": 1.76,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.65,
      "end_seconds": 74.26,
      "duration_seconds": 4.61,
      "text": "A few quick ones: heavy bleeding now or clotting problem?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.92,
      "end_seconds": 78.05,
      "duration_seconds": 2.13,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.58,
      "end_seconds": 82.01,
      "duration_seconds": 3.43,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.9,
      "end_seconds": 86.79,
      "duration_seconds": 2.89,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 88.94,
      "duration_seconds": 0.95,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.88,
      "end_seconds": 93.59,
      "duration_seconds": 3.71,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.21,
      "end_seconds": 97.09,
      "duration_seconds": 1.88,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.07,
      "end_seconds": 101.5,
      "duration_seconds": 3.43,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.67,
      "end_seconds": 106.89,
      "duration_seconds": 4.22,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.12,
      "end_seconds": 111.7,
      "duration_seconds": 3.58,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 118.75,
      "duration_seconds": 5.24,
      "text": "What about your medical history? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.78,
      "end_seconds": 127.05,
      "duration_seconds": 3.27,
      "text": "I have COPD, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.3,
      "end_seconds": 138.74,
      "duration_seconds": 10.44,
      "text": "Right, so COPD is already on your record. We'll keep that in mind today. Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.59,
      "end_seconds": 142.69,
      "duration_seconds": 3.1,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.79,
      "end_seconds": 145.89,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.4,
      "end_seconds": 155.86,
      "duration_seconds": 8.46,
      "text": "it's Tiotropium inhaler, once a day for my chest. Folic acid, 400 micrograms, maybe, daily"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.74,
      "end_seconds": 161.33,
      "duration_seconds": 4.59,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.08,
      "end_seconds": 165.15,
      "duration_seconds": 2.07,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.28,
      "end_seconds": 169.78,
      "duration_seconds": 3.5,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.02,
      "end_seconds": 172.65,
      "duration_seconds": 1.63,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.72,
      "end_seconds": 188.92,
      "duration_seconds": 3.2,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.99,
      "end_seconds": 193.05,
      "duration_seconds": 2.06,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 197.5,
      "duration_seconds": 3.81,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.39,
      "end_seconds": 213.81,
      "duration_seconds": 2.42,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.72,
      "end_seconds": 240.91,
      "duration_seconds": 8.19,
      "text": "Okay: respiratory rate 17, temp 36.8 degrees, BP is 128 over 77. And pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.07,
      "end_seconds": 246.27,
      "duration_seconds": 4.2,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.66,
      "end_seconds": 249.09,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.93,
      "end_seconds": 251.56,
      "duration_seconds": 1.63,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.6,
      "end_seconds": 267.2,
      "duration_seconds": 1.6,
      "text": "your examination is normal"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.04,
      "end_seconds": 275.28,
      "duration_seconds": 2.24,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.2,
      "end_seconds": 299.71,
      "duration_seconds": 8.51,
      "text": "Having listened and examined, I'd lean towards recurrent miscarriage needing investigation. I'd also keep an antiphospholipid problem in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.24,
      "end_seconds": 304.22,
      "duration_seconds": 2.98,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.81,
      "end_seconds": 343.31,
      "duration_seconds": 37.5,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the blood tests is back. I'm going to order blood tests, for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. I think the recurrent miscarriage clinic should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.3,
      "end_seconds": 349.82,
      "duration_seconds": 4.52,
      "text": "Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.9,
      "end_seconds": 353.68,
      "duration_seconds": 1.78,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.06,
      "end_seconds": 356.32,
      "duration_seconds": 1.26,
      "text": "Goodbye for now."
    }
  ]
}