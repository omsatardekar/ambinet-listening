{
  "schema_version": "1.0",
  "encounter_id": "03187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 2.33,
      "duration_seconds": 1.81,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.17,
      "end_seconds": 7.86,
      "duration_seconds": 4.69,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.94,
      "end_seconds": 12.65,
      "duration_seconds": 2.71,
      "text": "I've been dealing with chest pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.51,
      "end_seconds": 16.24,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.42,
      "end_seconds": 21.39,
      "duration_seconds": 3.97,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.11,
      "end_seconds": 25.02,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.65,
      "end_seconds": 27.33,
      "duration_seconds": 1.68,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.57,
      "end_seconds": 31.23,
      "duration_seconds": 3.66,
      "text": "I follow. Have you had a racing heart?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.23,
      "end_seconds": 36.82,
      "duration_seconds": 3.59,
      "text": "Actually, yes, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.77,
      "end_seconds": 40.31,
      "duration_seconds": 2.54,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.85,
      "end_seconds": 43.39,
      "duration_seconds": 2.54,
      "text": "Nothing regular, uh, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.02,
      "end_seconds": 55.58,
      "duration_seconds": 3.56,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.39,
      "end_seconds": 57.92,
      "duration_seconds": 1.53,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.24,
      "end_seconds": 63.27,
      "duration_seconds": 4.03,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.57,
      "end_seconds": 68.95,
      "duration_seconds": 4.38,
      "text": "Um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.72,
      "end_seconds": 86.66,
      "duration_seconds": 0.94,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.75,
      "end_seconds": 94.36,
      "duration_seconds": 3.61,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.38,
      "end_seconds": 97.83,
      "duration_seconds": 1.45,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.24,
      "end_seconds": 102.17,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.76,
      "end_seconds": 107.15,
      "duration_seconds": 3.39,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.1,
      "end_seconds": 111.83,
      "duration_seconds": 3.73,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.28,
      "end_seconds": 115.54,
      "duration_seconds": 2.26,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.16,
      "end_seconds": 121.13,
      "duration_seconds": 3.97,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.34,
      "end_seconds": 124.82,
      "duration_seconds": 2.48,
      "text": "Did you get cough or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.6,
      "end_seconds": 129.7,
      "duration_seconds": 4.1,
      "text": "So, uh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.46,
      "end_seconds": 137.83,
      "duration_seconds": 2.37,
      "text": "Have you had any leg swelling?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.15,
      "end_seconds": 141.02,
      "duration_seconds": 1.87,
      "text": "Definitely no leg swelling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.37,
      "end_seconds": 147.13,
      "duration_seconds": 4.76,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.12,
      "end_seconds": 149.6,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.77,
      "end_seconds": 154.81,
      "duration_seconds": 4.04,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.14,
      "end_seconds": 169.28,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.75,
      "end_seconds": 199.27,
      "duration_seconds": 9.52,
      "text": "Okay: temp 36.7 degrees, respiratory rate 18, blood pressure 97 over 65. And saturation 99 percent, pulse 95."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.23,
      "end_seconds": 204.95,
      "duration_seconds": 3.72,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.27,
      "end_seconds": 221.4,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.11,
      "end_seconds": 225.62,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.45,
      "end_seconds": 240.76,
      "duration_seconds": 7.31,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.22,
      "end_seconds": 254.85,
      "duration_seconds": 8.63,
      "text": "All finished, thank you. Okay, so my impression is this: The most likely explanation is possible cardiac tamponade."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.15,
      "end_seconds": 258.95,
      "duration_seconds": 2.8,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.49,
      "end_seconds": 277.29,
      "duration_seconds": 17.8,
      "text": "I understand the worry. At the moment I'd say it's possible cardiac tamponade, and we'll know more once the an urgent echocardiogram is back. So, to recap quickly. You've had chest pain for about a week, mild, and no fever or leg swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.92,
      "end_seconds": 279.62,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.12,
      "end_seconds": 285.11,
      "duration_seconds": 4.99,
      "text": "I'll request an urgent echocardiogram, it'll help with possible tamponade."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.13,
      "end_seconds": 289.49,
      "duration_seconds": 2.36,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.26,
      "end_seconds": 304.2,
      "duration_seconds": 13.94,
      "text": "I'm going to order an ECG, for chest pain. You need an urgent heart scan and possibly a drain. Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.98,
      "end_seconds": 308.49,
      "duration_seconds": 3.51,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}