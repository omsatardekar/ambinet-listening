{
  "schema_version": "1.0",
  "encounter_id": "03289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 3.58,
      "duration_seconds": 2.66,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.22,
      "end_seconds": 7.49,
      "duration_seconds": 3.27,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.36,
      "end_seconds": 14.62,
      "duration_seconds": 5.26,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.29,
      "end_seconds": 19.62,
      "duration_seconds": 3.33,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.49,
      "end_seconds": 25.38,
      "duration_seconds": 3.89,
      "text": "It's a severe headache for days, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.02,
      "end_seconds": 28.92,
      "duration_seconds": 1.9,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.18,
      "end_seconds": 37.6,
      "duration_seconds": 7.42,
      "text": "I've had it for six months. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.79,
      "end_seconds": 43.43,
      "duration_seconds": 2.64,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.67,
      "end_seconds": 63.1,
      "duration_seconds": 18.43,
      "text": "Being sick goes along with it, you know, most of the time. Ah, the being sick? That's been for four weeks. Right, uh, as for being sick, mild, really. Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.23,
      "end_seconds": 72.06,
      "duration_seconds": 2.83,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.63,
      "end_seconds": 88.14,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 108.33,
      "duration_seconds": 10.17,
      "text": "Okay: blood pressure 151 over 99, respiratory rate 16, temperature 37.0, pulse is 83 beats a minute, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.12,
      "end_seconds": 114.21,
      "duration_seconds": 4.09,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.13,
      "end_seconds": 118.46,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.28,
      "end_seconds": 139.02,
      "duration_seconds": 3.74,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.08,
      "end_seconds": 146.51,
      "duration_seconds": 2.43,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 159.85,
      "duration_seconds": 5.0,
      "text": "Have you had any head injury, fever or weakness on one side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.46,
      "end_seconds": 165.86,
      "duration_seconds": 5.4,
      "text": "No, no head injury, fever or weakness on one side."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.92,
      "end_seconds": 170.25,
      "duration_seconds": 3.33,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.22,
      "end_seconds": 173.85,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.11,
      "end_seconds": 177.61,
      "duration_seconds": 2.5,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.22,
      "end_seconds": 186.49,
      "duration_seconds": 3.27,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.18,
      "end_seconds": 206.03,
      "duration_seconds": 3.85,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 206.63,
      "end_seconds": 213.03,
      "duration_seconds": 6.4,
      "text": "I mean, she takes lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.6,
      "end_seconds": 216.61,
      "duration_seconds": 3.01,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 221.07,
      "end_seconds": 225.74,
      "duration_seconds": 4.67,
      "text": "For about three months. It's the contraceptive pill, daily, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.45,
      "end_seconds": 248.16,
      "duration_seconds": 4.71,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.7,
      "end_seconds": 269.43,
      "duration_seconds": 19.73,
      "text": "I only drink at family occasions. I've never touched a cigarette. I hardly move around during the day. I drink a lot of tea and snack through the day. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.92,
      "end_seconds": 274.22,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.28,
      "end_seconds": 286.15,
      "duration_seconds": 10.87,
      "text": "Hmm, uh, I've had acid reflux for nearly five years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.72,
      "end_seconds": 295.31,
      "duration_seconds": 7.59,
      "text": "Understood. Alright, acid reflux, that matches what I have here. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.28,
      "end_seconds": 300.74,
      "duration_seconds": 4.46,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.75,
      "end_seconds": 306.75,
      "duration_seconds": 4.0,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.44,
      "end_seconds": 312.39,
      "duration_seconds": 3.95,
      "text": "Ah, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.05,
      "end_seconds": 322.89,
      "duration_seconds": 9.84,
      "text": "From what you've told me and what I found, it fits best with possible cerebral venous thrombosis. Raised pressure in the head is still possible."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.48,
      "end_seconds": 327.55,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.95,
      "end_seconds": 350.91,
      "duration_seconds": 16.96,
      "text": "It's reasonable to be concerned, but right now possible cerebral venous thrombosis is my leading thought, not anything worse. I think an urgent CT venogram makes sense here, for possible venous thrombosis. We should do an MRI of the head for papilloedema."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.34,
      "end_seconds": 359.38,
      "duration_seconds": 3.04,
      "text": "Hmm, that's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.07,
      "end_seconds": 371.34,
      "duration_seconds": 10.27,
      "text": "Stop the pill, you need an urgent scan and admission. The neurology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.16,
      "end_seconds": 376.76,
      "duration_seconds": 2.6,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.89,
      "end_seconds": 390.79,
      "duration_seconds": 12.9,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.7,
      "end_seconds": 395.52,
      "duration_seconds": 2.82,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.43,
      "end_seconds": 398.85,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}