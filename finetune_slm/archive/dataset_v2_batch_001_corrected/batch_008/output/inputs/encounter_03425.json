{
  "schema_version": "1.0",
  "encounter_id": "03425",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 2.61,
      "duration_seconds": 1.75,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.68,
      "end_seconds": 8.83,
      "duration_seconds": 4.15,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.63,
      "end_seconds": 14.13,
      "duration_seconds": 3.5,
      "text": "I've been dealing with three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.08,
      "end_seconds": 25.02,
      "duration_seconds": 8.94,
      "text": "Can you list what you take, tablets, creams or inhalers? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 33.31,
      "duration_seconds": 4.41,
      "text": "Mm, I'm on folic acid, 400 micrograms, daily."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.69,
      "end_seconds": 39.15,
      "duration_seconds": 2.46,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.65,
      "end_seconds": 42.74,
      "duration_seconds": 2.09,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.73,
      "end_seconds": 47.24,
      "duration_seconds": 3.51,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.12,
      "end_seconds": 51.69,
      "duration_seconds": 2.57,
      "text": "Well, I'd call it severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.2,
      "end_seconds": 55.08,
      "duration_seconds": 2.88,
      "text": "Have you been feeling low and anxious?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.4,
      "end_seconds": 59.7,
      "duration_seconds": 3.3,
      "text": "Yes, uh, for ten days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.61,
      "end_seconds": 67.03,
      "duration_seconds": 5.42,
      "text": "Have you had three early losses before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.74,
      "end_seconds": 76.86,
      "duration_seconds": 9.12,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.56,
      "end_seconds": 99.79,
      "duration_seconds": 4.23,
      "text": "Did you get clotting problem, fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.61,
      "end_seconds": 109.71,
      "duration_seconds": 8.1,
      "text": "Let me think, I haven't had clotting problem, fever or heavy bleeding now, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.74,
      "end_seconds": 114.6,
      "duration_seconds": 2.86,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.65,
      "end_seconds": 117.41,
      "duration_seconds": 1.76,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.97,
      "end_seconds": 120.5,
      "duration_seconds": 1.53,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.58,
      "end_seconds": 125.6,
      "duration_seconds": 3.02,
      "text": "Erm, no weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.21,
      "end_seconds": 129.53,
      "duration_seconds": 3.32,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.33,
      "end_seconds": 135.52,
      "duration_seconds": 4.19,
      "text": "Um, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.14,
      "end_seconds": 140.69,
      "duration_seconds": 3.55,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 146.12,
      "duration_seconds": 3.73,
      "text": "Yes, trimethoprim. I get a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.42,
      "end_seconds": 150.71,
      "duration_seconds": 1.29,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.71,
      "end_seconds": 156.57,
      "duration_seconds": 4.86,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.82,
      "end_seconds": 159.26,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.94,
      "end_seconds": 163.21,
      "duration_seconds": 3.27,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.75,
      "end_seconds": 166.28,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.06,
      "end_seconds": 172.35,
      "duration_seconds": 4.29,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.57,
      "end_seconds": 178.49,
      "duration_seconds": 4.92,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.91,
      "end_seconds": 183.6,
      "duration_seconds": 3.69,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.48,
      "end_seconds": 193.22,
      "duration_seconds": 8.74,
      "text": "So, do you have any medical conditions I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.94,
      "end_seconds": 198.03,
      "duration_seconds": 4.09,
      "text": "Ah, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.66,
      "end_seconds": 201.73,
      "duration_seconds": 2.07,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.09,
      "end_seconds": 214.49,
      "duration_seconds": 8.4,
      "text": "Sorry, what was I saying, I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.27,
      "end_seconds": 232.66,
      "duration_seconds": 2.39,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.48,
      "end_seconds": 243.52,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.37,
      "end_seconds": 263.69,
      "duration_seconds": 9.32,
      "text": "Okay: oxygen saturation is 99 percent, heart rate 79, pressure 126 over 75. And respiratory rate 18, temperature 36.7."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.4,
      "end_seconds": 265.92,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 269.97,
      "duration_seconds": 2.33,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.95,
      "end_seconds": 274.99,
      "duration_seconds": 2.04,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.25,
      "end_seconds": 277.42,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.21,
      "end_seconds": 292.79,
      "duration_seconds": 1.58,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.07,
      "end_seconds": 298.63,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.1,
      "end_seconds": 333.8,
      "duration_seconds": 18.7,
      "text": "Taking everything into account, the most likely explanation is recurrent miscarriage needing investigation. I can't rule out an antiphospholipid problem yet. We will arrange specialist care so the next pregnancy is looked after from the start. Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.75,
      "end_seconds": 339.44,
      "duration_seconds": 3.69,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.97,
      "end_seconds": 341.15,
      "duration_seconds": 1.18,
      "text": "Take care now."
    }
  ]
}