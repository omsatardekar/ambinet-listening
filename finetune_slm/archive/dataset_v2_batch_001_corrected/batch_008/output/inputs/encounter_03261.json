{
  "schema_version": "1.0",
  "encounter_id": "03261",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.58,
      "duration_seconds": 4.25,
      "text": "Actually, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.54,
      "end_seconds": 11.37,
      "duration_seconds": 4.83,
      "text": "So, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.78,
      "end_seconds": 15.06,
      "duration_seconds": 2.28,
      "text": "It's slurred speech, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.54,
      "end_seconds": 19.48,
      "duration_seconds": 2.94,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.29,
      "end_seconds": 36.07,
      "duration_seconds": 2.78,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.47,
      "end_seconds": 62.42,
      "duration_seconds": 12.95,
      "text": "Okay: saturation 97 percent, BP is 126 over 72. And temperature is 36.5 degrees, height 170 centimetres, BMI works out to 25.3, weight 73 kilos, pulse 82."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.28,
      "end_seconds": 68.04,
      "duration_seconds": 1.76,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 72.47,
      "duration_seconds": 2.35,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.83,
      "end_seconds": 89.69,
      "duration_seconds": 1.86,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 93.92,
      "duration_seconds": 2.3,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 97.61,
      "duration_seconds": 2.53,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.86,
      "end_seconds": 108.84,
      "duration_seconds": 9.98,
      "text": "Okay, so I'd call it severe. And there's shivering that has stopped as well, two months now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.3,
      "end_seconds": 113.6,
      "duration_seconds": 3.3,
      "text": "And what about alcohol, fall or head injury?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.68,
      "end_seconds": 118.79,
      "duration_seconds": 3.11,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.69,
      "end_seconds": 122.79,
      "duration_seconds": 2.1,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.7,
      "end_seconds": 126.35,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.8,
      "end_seconds": 130.75,
      "duration_seconds": 2.95,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.6,
      "end_seconds": 134.31,
      "duration_seconds": 2.71,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.41,
      "end_seconds": 138.13,
      "duration_seconds": 2.72,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.01,
      "end_seconds": 144.6,
      "duration_seconds": 4.59,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.29,
      "end_seconds": 147.9,
      "duration_seconds": 1.61,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.4,
      "end_seconds": 153.06,
      "duration_seconds": 4.66,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.99,
      "end_seconds": 157.79,
      "duration_seconds": 3.8,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.64,
      "end_seconds": 167.3,
      "duration_seconds": 8.66,
      "text": "Alendronate. I take it 70 milligrams, once a week. Oh, it's lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.1,
      "end_seconds": 172.35,
      "duration_seconds": 4.25,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.73,
      "end_seconds": 183.16,
      "duration_seconds": 9.43,
      "text": "I have an irregular heartbeat. I've got thin bones. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.69,
      "end_seconds": 185.63,
      "duration_seconds": 0.94,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 193.97,
      "duration_seconds": 7.3,
      "text": "I have acid reflux. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.51,
      "end_seconds": 196.71,
      "duration_seconds": 1.2,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 204.12,
      "duration_seconds": 5.91,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 216.01,
      "duration_seconds": 3.72,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.16,
      "end_seconds": 220.8,
      "duration_seconds": 3.64,
      "text": "Actually, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.65,
      "end_seconds": 233.3,
      "duration_seconds": 2.65,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.47,
      "end_seconds": 241.43,
      "duration_seconds": 6.96,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.68,
      "end_seconds": 248.74,
      "duration_seconds": 5.06,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.58,
      "end_seconds": 251.67,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.69,
      "end_seconds": 273.19,
      "duration_seconds": 7.5,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.71,
      "end_seconds": 286.17,
      "duration_seconds": 7.46,
      "text": "Alright, that's all I needed to check. I think an ECG makes sense here, for bradycardia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.72,
      "end_seconds": 290.49,
      "duration_seconds": 2.77,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.25,
      "end_seconds": 310.11,
      "duration_seconds": 18.86,
      "text": "Handle gently and warm slowly with warm blankets and warm fluids through the drip. The emergency team would be the right next step, I'll refer you. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.92,
      "end_seconds": 316.1,
      "duration_seconds": 5.18,
      "text": "Okay, um, so okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.83,
      "end_seconds": 320.51,
      "duration_seconds": 2.68,
      "text": "I'll want another look straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.13,
      "end_seconds": 324.22,
      "duration_seconds": 2.09,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.26,
      "end_seconds": 334.49,
      "duration_seconds": 4.23,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.87,
      "end_seconds": 339.04,
      "duration_seconds": 3.17,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}