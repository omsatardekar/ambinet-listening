{
  "schema_version": "1.0",
  "encounter_id": "03179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.7,
      "duration_seconds": 5.69,
      "text": "I mean, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.41,
      "end_seconds": 12.09,
      "duration_seconds": 3.68,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.65,
      "end_seconds": 29.76,
      "duration_seconds": 17.11,
      "text": "Let me think, mainly I've been feeling faint. That's why I came. I kept putting it it off, which I know isn't sensible. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.44,
      "end_seconds": 35.1,
      "duration_seconds": 3.66,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.09,
      "end_seconds": 46.32,
      "duration_seconds": 10.23,
      "text": "About... well, about two weeks. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.38,
      "end_seconds": 56.95,
      "duration_seconds": 8.57,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.37,
      "end_seconds": 90.64,
      "duration_seconds": 29.27,
      "text": "Mostly mild. It's once or twice a day. I looked a few things up online, and that probably didn't help. I just want to get back to to normal, really. I mean, um, I've also had a gurgling chest. Oh, and breathlessness. That's been about the same, ten days. Mm, about breathlessness, I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.3,
      "end_seconds": 109.21,
      "duration_seconds": 5.91,
      "text": "Let me check a few things. Any weight loss, chest pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.36,
      "end_seconds": 115.67,
      "duration_seconds": 5.31,
      "text": "I haven't had weight loss, chest pain or fever, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.55,
      "end_seconds": 119.57,
      "duration_seconds": 3.02,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.54,
      "end_seconds": 122.23,
      "duration_seconds": 1.69,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 134.68,
      "duration_seconds": 4.88,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.95,
      "end_seconds": 147.75,
      "duration_seconds": 11.8,
      "text": "Not much, I mostly stay in these days. I'm vegetarian and have been for years. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 152.92,
      "duration_seconds": 4.25,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.45,
      "end_seconds": 156.11,
      "duration_seconds": 2.66,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.08,
      "end_seconds": 160.4,
      "duration_seconds": 2.32,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.39,
      "end_seconds": 166.52,
      "duration_seconds": 4.13,
      "text": "It's Eltroxin, 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.29,
      "end_seconds": 171.92,
      "duration_seconds": 4.63,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.49,
      "end_seconds": 178.0,
      "duration_seconds": 5.51,
      "text": "Okay, so not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.28,
      "end_seconds": 187.83,
      "duration_seconds": 8.55,
      "text": "Do you react to any medicines or foods? Any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.4,
      "end_seconds": 202.7,
      "duration_seconds": 10.3,
      "text": "I, I had a reaction to tramadol when I was younger, feeling very drowsy, and and I've avoided it since."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.05,
      "end_seconds": 205.41,
      "duration_seconds": 1.36,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.17,
      "end_seconds": 209.82,
      "duration_seconds": 3.65,
      "text": "Ah, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.7,
      "end_seconds": 230.15,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.9,
      "end_seconds": 243.46,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.1,
      "end_seconds": 263.89,
      "duration_seconds": 10.79,
      "text": "Okay: pulse is 93 beats a minute, pressure 120 over 89, oxygen saturation is 92 percent. And temperature is 37.0 degrees, respiratory rate 23."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.57,
      "end_seconds": 269.96,
      "duration_seconds": 4.39,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.59,
      "end_seconds": 273.67,
      "duration_seconds": 2.08,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.94,
      "end_seconds": 298.31,
      "duration_seconds": 6.37,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 301.88,
      "duration_seconds": 1.71,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.91,
      "end_seconds": 316.93,
      "duration_seconds": 12.02,
      "text": "right, you can sit up now having listened and examined, this looks most like life-threatening haemoptysis i can't rule out a lung tumour yet"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.19,
      "end_seconds": 322.28,
      "duration_seconds": 4.09,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.33,
      "end_seconds": 345.37,
      "duration_seconds": 22.04,
      "text": "nothing I've seen today points to an emergency it looks like life-threatening haemoptysis, but I'd like to confirm. An urgent CT scan is what I'd like next, for massive haemoptysis. Urgent blood tests is what I'd like next, for bleeding the result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.38,
      "end_seconds": 349.8,
      "duration_seconds": 3.42,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.48,
      "end_seconds": 382.66,
      "duration_seconds": 31.18,
      "text": "I'd like you to take tranexamic acid, 1 gram, now, single dose. It's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. I'm going to send a referral to the emergency team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.98,
      "end_seconds": 387.92,
      "duration_seconds": 3.94,
      "text": "right, I'll do that. Thank you, doctor"
    }
  ]
}