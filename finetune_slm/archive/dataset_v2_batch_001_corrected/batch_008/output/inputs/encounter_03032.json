{
  "schema_version": "1.0",
  "encounter_id": "03032",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 4.59,
      "duration_seconds": 3.32,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 11.45,
      "duration_seconds": 5.16,
      "text": "okay, that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.8,
      "end_seconds": 25.02,
      "duration_seconds": 12.22,
      "text": "Sorry, what was I saying, mainly headaches most days. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 43.79,
      "duration_seconds": 3.75,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.58,
      "end_seconds": 49.8,
      "duration_seconds": 4.22,
      "text": "let me think, it's been three days now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.2,
      "end_seconds": 54.61,
      "duration_seconds": 3.41,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 57.08,
      "duration_seconds": 1.67,
      "text": "it's mild, honestly"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.31,
      "end_seconds": 60.61,
      "duration_seconds": 2.3,
      "text": "okay, does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.2,
      "end_seconds": 64.44,
      "duration_seconds": 3.24,
      "text": "It settles a little with painkillers."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.65,
      "end_seconds": 69.12,
      "duration_seconds": 3.47,
      "text": "Has there been taking painkillers every day too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 85.18,
      "duration_seconds": 12.29,
      "text": "Yes, actually. Uh, uh, with taking painkillers every day, maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.07,
      "end_seconds": 92.46,
      "duration_seconds": 6.39,
      "text": "Let me check a few things. Any stiff neck, weakness, visual changes or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.33,
      "end_seconds": 101.05,
      "duration_seconds": 6.72,
      "text": "No stiff neck, weakness, visual changes or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.52,
      "end_seconds": 105.33,
      "duration_seconds": 2.81,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.81,
      "end_seconds": 108.3,
      "duration_seconds": 1.49,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.75,
      "end_seconds": 112.55,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.44,
      "end_seconds": 139.86,
      "duration_seconds": 23.42,
      "text": "I have migraines, for two years. I'd rather not end up on lots of tablets if I can avoid it. I took the morning off to come in today. I've got gout. I've had an irregular heartbeat for about ten years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.53,
      "end_seconds": 144.12,
      "duration_seconds": 2.59,
      "text": "Okay, is there anything more?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.21,
      "end_seconds": 151.99,
      "duration_seconds": 5.78,
      "text": "Alright, gout, that matches what I have here. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.26,
      "end_seconds": 158.56,
      "duration_seconds": 3.3,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 161.29,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 165.49,
      "duration_seconds": 2.63,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.56,
      "end_seconds": 171.89,
      "duration_seconds": 2.33,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.4,
      "end_seconds": 177.85,
      "duration_seconds": 4.45,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.4,
      "end_seconds": 182.36,
      "duration_seconds": 1.96,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.2,
      "end_seconds": 187.42,
      "duration_seconds": 4.22,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.27,
      "end_seconds": 190.67,
      "duration_seconds": 1.4,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.81,
      "end_seconds": 196.15,
      "duration_seconds": 4.34,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.46,
      "end_seconds": 217.36,
      "duration_seconds": 2.9,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.89,
      "end_seconds": 222.4,
      "duration_seconds": 4.51,
      "text": "Let me think, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.81,
      "end_seconds": 235.36,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.45,
      "end_seconds": 243.71,
      "duration_seconds": 3.26,
      "text": "no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.65,
      "end_seconds": 248.54,
      "duration_seconds": 2.89,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.39,
      "end_seconds": 256.56,
      "duration_seconds": 6.17,
      "text": "let me think, just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.09,
      "end_seconds": 260.11,
      "duration_seconds": 2.02,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.06,
      "end_seconds": 265.19,
      "duration_seconds": 4.13,
      "text": "I'm on sumatriptan, when needed for my migraines"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.27,
      "end_seconds": 269.55,
      "duration_seconds": 2.28,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.62,
      "end_seconds": 271.74,
      "duration_seconds": 1.12,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.07,
      "end_seconds": 273.07,
      "duration_seconds": 1.0,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.62,
      "end_seconds": 283.88,
      "duration_seconds": 9.26,
      "text": "Allopurinol, 100 milligrams, once a day. I'm not great at remembering details, so so bear with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.46,
      "end_seconds": 285.16,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.39,
      "end_seconds": 290.92,
      "duration_seconds": 4.53,
      "text": "Apixaban i take it 5 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.52,
      "end_seconds": 297.08,
      "duration_seconds": 3.56,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.48,
      "end_seconds": 300.24,
      "duration_seconds": 1.76,
      "text": "alright, does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.25,
      "end_seconds": 315.46,
      "duration_seconds": 2.21,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.25,
      "end_seconds": 333.47,
      "duration_seconds": 15.22,
      "text": "You can relax now. From what you've told me and what I found, it points towards medication-overuse headache on a background of migraine. I'll request a headache diary, it'll help with daily headache."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.22,
      "end_seconds": 335.39,
      "duration_seconds": 1.17,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.52,
      "end_seconds": 365.31,
      "duration_seconds": 28.79,
      "text": "I'm prescribing amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That should help with headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. One warning sign to remember: the symptoms get worse. In that case don't wait. Let's review you in six weeks. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.9,
      "end_seconds": 371.36,
      "duration_seconds": 5.46,
      "text": "Let me think, great, thank you for your help."
    }
  ]
}