{
  "schema_version": "1.0",
  "encounter_id": "03173",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 7.88,
      "duration_seconds": 6.88,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.02,
      "end_seconds": 16.96,
      "duration_seconds": 3.94,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.88,
      "end_seconds": 20.63,
      "duration_seconds": 2.75,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.23,
      "end_seconds": 32.22,
      "duration_seconds": 6.99,
      "text": "It's flakes on my shoulders, mostly. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.42,
      "end_seconds": 37.1,
      "duration_seconds": 3.68,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.49,
      "end_seconds": 45.42,
      "duration_seconds": 6.93,
      "text": "Metformin, 500 milligrams, twice a day. It's, It's thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 46.16,
      "end_seconds": 51.06,
      "duration_seconds": 4.9,
      "text": "Doctor, our chart from the last visit lists it as 150 micrograms."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.36,
      "end_seconds": 57.03,
      "duration_seconds": 4.67,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.84,
      "end_seconds": 65.4,
      "duration_seconds": 7.56,
      "text": "No, I left it at home. An anti-dandruff shampoo. I take it twice a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.35,
      "end_seconds": 70.49,
      "duration_seconds": 3.14,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.86,
      "end_seconds": 73.36,
      "duration_seconds": 1.5,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.91,
      "end_seconds": 77.14,
      "duration_seconds": 3.23,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 82.96,
      "duration_seconds": 2.23,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 94.51,
      "duration_seconds": 10.4,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.64,
      "end_seconds": 100.65,
      "duration_seconds": 5.01,
      "text": "It feels moderate to me. It settles a little with shampoo."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.48,
      "end_seconds": 108.43,
      "duration_seconds": 6.95,
      "text": "Okay, so I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 108.53,
      "end_seconds": 114.6,
      "duration_seconds": 6.07,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.09,
      "end_seconds": 121.62,
      "duration_seconds": 5.53,
      "text": "Alright, later, thanks. Please go on. Has there been an itchy scalp too?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.89,
      "end_seconds": 129.72,
      "duration_seconds": 3.83,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.67,
      "end_seconds": 133.41,
      "duration_seconds": 2.74,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.2,
      "end_seconds": 151.46,
      "duration_seconds": 17.26,
      "text": "Pretty moderate, if I'm being honest. Yeah, uh, as for little redness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.8,
      "end_seconds": 153.74,
      "duration_seconds": 0.94,
      "text": "Any pus?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.82,
      "end_seconds": 157.94,
      "duration_seconds": 3.12,
      "text": "No, you know, none, no pus."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.83,
      "end_seconds": 163.65,
      "duration_seconds": 4.82,
      "text": "Have you had any hair loss, rash elsewhere or pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.18,
      "end_seconds": 169.27,
      "duration_seconds": 5.09,
      "text": "No hair loss, rash elsewhere or pain, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.22,
      "end_seconds": 174.0,
      "duration_seconds": 3.78,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.49,
      "end_seconds": 177.64,
      "duration_seconds": 2.15,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.39,
      "end_seconds": 182.76,
      "duration_seconds": 3.37,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.56,
      "end_seconds": 189.92,
      "duration_seconds": 5.36,
      "text": "Diabetes, for about a year. I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.82,
      "end_seconds": 198.93,
      "duration_seconds": 7.11,
      "text": "Okay, I can see diabetes in your file as well. Do you do any exercise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.79,
      "end_seconds": 206.28,
      "duration_seconds": 2.49,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.9,
      "end_seconds": 208.19,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.45,
      "end_seconds": 213.2,
      "duration_seconds": 3.75,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.71,
      "end_seconds": 229.86,
      "duration_seconds": 2.15,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.52,
      "end_seconds": 237.3,
      "duration_seconds": 5.78,
      "text": "Uh, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.5,
      "end_seconds": 241.81,
      "duration_seconds": 3.31,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.18,
      "end_seconds": 253.02,
      "duration_seconds": 5.84,
      "text": "My mother has an underactive thyroid. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.27,
      "end_seconds": 258.79,
      "duration_seconds": 4.52,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.23,
      "end_seconds": 269.06,
      "duration_seconds": 8.83,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 279.55,
      "end_seconds": 290.68,
      "duration_seconds": 11.13,
      "text": "Doctor, I've got the readings for you. BP is 119 over 76, SpO2 98 percent on room air, temp 36.7 degrees, pulse is 67 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.6,
      "end_seconds": 293.65,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.66,
      "end_seconds": 298.7,
      "duration_seconds": 4.04,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.77,
      "end_seconds": 302.47,
      "duration_seconds": 1.7,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.68,
      "end_seconds": 304.87,
      "duration_seconds": 1.19,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.0,
      "end_seconds": 324.71,
      "duration_seconds": 4.71,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.86,
      "end_seconds": 361.53,
      "duration_seconds": 32.67,
      "text": "Okay, that's enough for me. Okay, thinking it through, this is probably simple dandruff. Seborrhoeic dermatitis is also on my list. I'm prescribing ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. Leave the shampoo on for five minutes before rinsing. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. See me again if not better in a month. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.26,
      "end_seconds": 365.22,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.32,
      "end_seconds": 367.71,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}