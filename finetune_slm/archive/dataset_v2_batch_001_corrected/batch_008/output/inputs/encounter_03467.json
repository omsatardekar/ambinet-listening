{
  "schema_version": "1.0",
  "encounter_id": "03467",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.27,
      "duration_seconds": 3.52,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.03,
      "end_seconds": 9.95,
      "duration_seconds": 4.92,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.47,
      "end_seconds": 21.63,
      "duration_seconds": 11.16,
      "text": "Hello, doctor. I'm here with them in case I can help. It's dizziness on standing, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.29,
      "end_seconds": 24.59,
      "duration_seconds": 1.3,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.1,
      "end_seconds": 29.84,
      "duration_seconds": 4.74,
      "text": "About... well, two weeks. And darker skin, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.12,
      "end_seconds": 33.53,
      "duration_seconds": 2.41,
      "text": "Any craving salt as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.81,
      "end_seconds": 36.9,
      "duration_seconds": 2.09,
      "text": "Yes, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.72,
      "end_seconds": 41.73,
      "duration_seconds": 3.01,
      "text": "Have you been feeling tired and weak?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.39,
      "end_seconds": 44.65,
      "duration_seconds": 2.26,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.73,
      "end_seconds": 52.01,
      "duration_seconds": 3.28,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.44,
      "end_seconds": 55.12,
      "duration_seconds": 1.68,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.46,
      "end_seconds": 60.74,
      "duration_seconds": 4.28,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.49,
      "end_seconds": 74.92,
      "duration_seconds": 2.43,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.73,
      "end_seconds": 97.87,
      "duration_seconds": 13.14,
      "text": "Okay: temp 36.4 degrees, height 165 centimetres, BMI works out to 32.0. And saturation 99 percent, heart rate 105, blood pressure 93 over 65, weight 87 kilos."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.03,
      "end_seconds": 100.62,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.92,
      "end_seconds": 107.71,
      "duration_seconds": 3.79,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.44,
      "end_seconds": 113.42,
      "duration_seconds": 3.98,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.49,
      "end_seconds": 115.83,
      "duration_seconds": 1.34,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 140.69,
      "duration_seconds": 8.73,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.03,
      "end_seconds": 147.43,
      "duration_seconds": 4.4,
      "text": "That's the examination finished. Right, any fainting, fever or vomiting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.98,
      "end_seconds": 150.97,
      "duration_seconds": 2.99,
      "text": "No, no fainting, fever or vomiting."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.42,
      "end_seconds": 156.3,
      "duration_seconds": 3.88,
      "text": "Have you had severe tummy pain, by any chance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.15,
      "end_seconds": 162.87,
      "duration_seconds": 4.72,
      "text": "Oh, not that I've noticed, no severe tummy pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.63,
      "end_seconds": 166.13,
      "duration_seconds": 2.5,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.97,
      "end_seconds": 167.92,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.46,
      "end_seconds": 170.77,
      "duration_seconds": 2.31,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.81,
      "end_seconds": 174.37,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.16,
      "end_seconds": 179.16,
      "duration_seconds": 4.0,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.72,
      "end_seconds": 183.39,
      "duration_seconds": 2.67,
      "text": "High cholesterol, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.45,
      "end_seconds": 186.91,
      "duration_seconds": 1.46,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.9,
      "end_seconds": 191.28,
      "duration_seconds": 2.38,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.27,
      "end_seconds": 196.3,
      "duration_seconds": 4.03,
      "text": "Alright, high cholesterol, that matches what I have here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.54,
      "end_seconds": 211.75,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.66,
      "end_seconds": 216.68,
      "duration_seconds": 3.02,
      "text": "Atorvastatin. I take it at night."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 220.54,
      "duration_seconds": 2.02,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.12,
      "end_seconds": 226.41,
      "duration_seconds": 4.29,
      "text": "20 milligrams. I take mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 227.94,
      "end_seconds": 236.57,
      "duration_seconds": 8.63,
      "text": "Doctor, I think the last prescription for the mirtazapine was 7.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.84,
      "end_seconds": 242.36,
      "duration_seconds": 4.52,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.76,
      "end_seconds": 247.11,
      "duration_seconds": 3.35,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.35,
      "end_seconds": 263.17,
      "duration_seconds": 2.82,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.74,
      "end_seconds": 268.71,
      "duration_seconds": 4.97,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.79,
      "end_seconds": 272.77,
      "duration_seconds": 2.98,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.62,
      "end_seconds": 276.89,
      "duration_seconds": 3.27,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.34,
      "end_seconds": 286.82,
      "duration_seconds": 2.48,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.05,
      "end_seconds": 298.74,
      "duration_seconds": 5.69,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.62,
      "end_seconds": 303.41,
      "duration_seconds": 2.79,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.87,
      "end_seconds": 307.87,
      "duration_seconds": 3.0,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 309.33,
      "end_seconds": 315.28,
      "duration_seconds": 5.95,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.81,
      "end_seconds": 318.94,
      "duration_seconds": 2.13,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.14,
      "end_seconds": 345.62,
      "duration_seconds": 25.48,
      "text": "Alright, so that's unclear. I'll record what each of you said. So where does that leave us? It points towards possible adrenal insufficiency. It could also be an underactive thyroid, so we'll keep that open. Just to be sure I understood. You've had dizziness on standing for two weeks, and no fainting or vomiting."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.88,
      "end_seconds": 348.9,
      "duration_seconds": 2.02,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.55,
      "end_seconds": 374.04,
      "duration_seconds": 20.49,
      "text": "We should do blood tests for possible adrenal insufficiency. I'm sending you for a morning cortisol because of possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'd like you to see the endocrine clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.58,
      "end_seconds": 377.3,
      "duration_seconds": 1.72,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.19,
      "end_seconds": 387.64,
      "duration_seconds": 8.45,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.27,
      "end_seconds": 390.23,
      "duration_seconds": 1.96,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.07,
      "end_seconds": 405.95,
      "duration_seconds": 13.88,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.88,
      "end_seconds": 410.67,
      "duration_seconds": 3.79,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.79,
      "end_seconds": 417.75,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}