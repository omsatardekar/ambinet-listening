{
  "schema_version": "1.0",
  "encounter_id": "03305",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.7,
      "duration_seconds": 3.05,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.17,
      "end_seconds": 9.5,
      "duration_seconds": 4.33,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.08,
      "end_seconds": 21.46,
      "duration_seconds": 11.38,
      "text": "Doctor, you know, I've come along because I know the history, if it helps. He's been having headaches most days, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.77,
      "end_seconds": 25.04,
      "duration_seconds": 2.27,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.67,
      "end_seconds": 29.42,
      "duration_seconds": 3.75,
      "text": "Propranolol, 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 35.94,
      "duration_seconds": 4.76,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.47,
      "end_seconds": 40.83,
      "duration_seconds": 3.36,
      "text": "Uh, no, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.23,
      "end_seconds": 49.01,
      "duration_seconds": 6.78,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.69,
      "end_seconds": 53.05,
      "duration_seconds": 2.36,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 66.49,
      "duration_seconds": 12.88,
      "text": "For my cholesterol, I believe. My wife sets them out for me, I just take what I'm given. I'm on metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.82,
      "end_seconds": 70.16,
      "duration_seconds": 2.34,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.73,
      "end_seconds": 75.6,
      "duration_seconds": 4.87,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.62,
      "end_seconds": 80.87,
      "duration_seconds": 3.25,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.95,
      "end_seconds": 85.47,
      "duration_seconds": 3.52,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 88.71,
      "end_seconds": 93.12,
      "duration_seconds": 4.41,
      "text": "I think it's been nearer about two months, actually."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 98.55,
      "duration_seconds": 4.44,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.34,
      "end_seconds": 104.46,
      "duration_seconds": 1.12,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.26,
      "end_seconds": 107.09,
      "duration_seconds": 1.83,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.4,
      "end_seconds": 126.33,
      "duration_seconds": 14.93,
      "text": "I mean, I get some relief from painkillers. I've also had taking painkillers every day, since last weekend. I've been feeling sick too, for about three months."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.15,
      "end_seconds": 137.1,
      "duration_seconds": 8.95,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.94,
      "end_seconds": 144.64,
      "duration_seconds": 5.7,
      "text": "Pretty mild, if I'm being honest. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 148.94,
      "duration_seconds": 3.27,
      "text": "Any weakness, stiff neck or visual changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.48,
      "end_seconds": 154.69,
      "duration_seconds": 4.21,
      "text": "No, no weakness, stiff neck or visual changes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.23,
      "end_seconds": 157.65,
      "duration_seconds": 1.42,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.23,
      "end_seconds": 162.44,
      "duration_seconds": 3.21,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.57,
      "end_seconds": 166.45,
      "duration_seconds": 2.88,
      "text": "Okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.72,
      "end_seconds": 169.59,
      "duration_seconds": 1.87,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.84,
      "end_seconds": 173.79,
      "duration_seconds": 2.95,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.65,
      "end_seconds": 178.32,
      "duration_seconds": 2.67,
      "text": "Mm, no, that's all fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.37,
      "end_seconds": 199.39,
      "duration_seconds": 4.02,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.45,
      "end_seconds": 202.09,
      "duration_seconds": 1.64,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.92,
      "end_seconds": 203.62,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.29,
      "end_seconds": 208.89,
      "duration_seconds": 4.6,
      "text": "I have high cholesterol. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.01,
      "end_seconds": 221.79,
      "duration_seconds": 11.78,
      "text": "Right, so migraines and high cholesterol are already on your record. We'll keep that in mind today. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.67,
      "end_seconds": 225.42,
      "duration_seconds": 2.75,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 229.48,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.53,
      "end_seconds": 234.43,
      "duration_seconds": 2.9,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 241.23,
      "duration_seconds": 5.33,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.25,
      "end_seconds": 254.64,
      "duration_seconds": 10.39,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 267.83,
      "end_seconds": 277.13,
      "duration_seconds": 9.3,
      "text": "Okay, so the vitals from earlier. SpO2 99 percent on room air, pulse 85. Temperature 36.8, blood pressure 120 over 81."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.16,
      "end_seconds": 279.14,
      "duration_seconds": 0.98,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.92,
      "end_seconds": 286.37,
      "duration_seconds": 4.45,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.03,
      "end_seconds": 289.1,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.02,
      "end_seconds": 292.77,
      "duration_seconds": 2.75,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.13,
      "end_seconds": 311.16,
      "duration_seconds": 2.03,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.18,
      "end_seconds": 348.47,
      "duration_seconds": 33.29,
      "text": "That's the examination finished. Right, here's what I'm thinking. I can't pin this down yet. We're looking at medication-overuse headache on a background of migraine or tension-type headache. I'm going to order a headache diary, for daily headache. The treatment will be amitriptyline, 10 milligrams, at night, long term. It's for headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.64,
      "end_seconds": 370.01,
      "duration_seconds": 20.37,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. Come back in six weeks. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.56,
      "end_seconds": 375.86,
      "duration_seconds": 5.3,
      "text": "Let me think, uh, alright, thanks, take care."
    }
  ]
}