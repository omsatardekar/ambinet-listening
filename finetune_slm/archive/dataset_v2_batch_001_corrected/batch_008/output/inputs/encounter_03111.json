{
  "schema_version": "1.0",
  "encounter_id": "03111",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.69,
      "duration_seconds": 5.33,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.56,
      "end_seconds": 11.9,
      "duration_seconds": 4.34,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 19.19,
      "duration_seconds": 6.22,
      "text": "Well, you know, I've been having sudden breathlessness five days after surgery."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.21,
      "end_seconds": 22.39,
      "duration_seconds": 2.18,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 25.93,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.51,
      "end_seconds": 29.37,
      "duration_seconds": 2.86,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.32,
      "end_seconds": 32.73,
      "duration_seconds": 2.41,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.35,
      "end_seconds": 36.8,
      "duration_seconds": 2.45,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.28,
      "end_seconds": 46.08,
      "duration_seconds": 7.8,
      "text": "it it usually comes with a swollen calf the swollen calf? That's been for about two weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.5,
      "end_seconds": 52.31,
      "duration_seconds": 4.81,
      "text": "And what about fever, coughing up blood or wound problem?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.04,
      "end_seconds": 60.37,
      "duration_seconds": 4.33,
      "text": "No, no fever, coughing up blood or wound problem."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.88,
      "end_seconds": 64.86,
      "duration_seconds": 2.98,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.67,
      "end_seconds": 67.75,
      "duration_seconds": 2.08,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.07,
      "end_seconds": 89.79,
      "duration_seconds": 3.72,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.72,
      "end_seconds": 94.28,
      "duration_seconds": 2.56,
      "text": "Heart failure, for five years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.36,
      "end_seconds": 99.11,
      "duration_seconds": 3.75,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.62,
      "end_seconds": 104.55,
      "duration_seconds": 3.93,
      "text": "Um, uh, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.22,
      "end_seconds": 110.14,
      "duration_seconds": 4.92,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.32,
      "end_seconds": 114.01,
      "duration_seconds": 2.69,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.35,
      "end_seconds": 134.04,
      "duration_seconds": 1.69,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.67,
      "end_seconds": 136.91,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.02,
      "end_seconds": 140.44,
      "duration_seconds": 2.42,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.31,
      "end_seconds": 145.08,
      "duration_seconds": 2.77,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.63,
      "end_seconds": 159.27,
      "duration_seconds": 2.64,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.65,
      "end_seconds": 163.35,
      "duration_seconds": 2.7,
      "text": "actually, no, not at all"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.43,
      "end_seconds": 168.7,
      "duration_seconds": 3.27,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.54,
      "end_seconds": 177.9,
      "duration_seconds": 2.36,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.59,
      "end_seconds": 200.18,
      "duration_seconds": 9.59,
      "text": "Okay: blood pressure 138 over 75, pulse is 86 beats a minute, temperature is 37.0 degrees. And saturation 92 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.34,
      "end_seconds": 204.49,
      "duration_seconds": 2.15,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.31,
      "end_seconds": 207.01,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.97,
      "end_seconds": 210.33,
      "duration_seconds": 2.36,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.71,
      "end_seconds": 225.02,
      "duration_seconds": 5.31,
      "text": "your left calf is swollen and tender and your oxygen is low"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.36,
      "end_seconds": 227.99,
      "duration_seconds": 1.63,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.78,
      "end_seconds": 248.26,
      "duration_seconds": 17.48,
      "text": "Good, you can sit up again. Okay, so my impression is this: It's hard to say. A possible blood clot in the lung after surgery is one possibility and a chest infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.79,
      "end_seconds": 251.5,
      "duration_seconds": 2.71,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.45,
      "end_seconds": 265.75,
      "duration_seconds": 12.3,
      "text": "it's reasonable to be concerned, but right now a a possible blood clot in the lung after surgery is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.36,
      "end_seconds": 296.73,
      "duration_seconds": 21.37,
      "text": "I want a D-dimer done, that's for possible clot. I'm prescribing enoxaparin, 1.5 mg per kg, once now, single dose. It's for possible clot. Please go to hospital now, I will call ahead. I think the emergency team should see you too"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.92,
      "end_seconds": 299.47,
      "duration_seconds": 1.55,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.43,
      "end_seconds": 309.83,
      "duration_seconds": 8.4,
      "text": "keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.85,
      "end_seconds": 313.01,
      "duration_seconds": 2.16,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.56,
      "end_seconds": 317.57,
      "duration_seconds": 4.01,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.51,
      "end_seconds": 322.81,
      "duration_seconds": 3.3,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.99,
      "end_seconds": 329.88,
      "duration_seconds": 1.89,
      "text": "have a good day"
    }
  ]
}