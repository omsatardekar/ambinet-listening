{
  "schema_version": "1.0",
  "encounter_id": "03322",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.59,
      "end_seconds": 5.6,
      "duration_seconds": 5.01,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 10.59,
      "duration_seconds": 4.17,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.3,
      "end_seconds": 18.9,
      "duration_seconds": 6.6,
      "text": "Doctor, it's a sudden severe tummy pain. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.28,
      "end_seconds": 23.3,
      "duration_seconds": 3.02,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.84,
      "end_seconds": 37.31,
      "duration_seconds": 11.47,
      "text": "So, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.85,
      "end_seconds": 40.21,
      "duration_seconds": 2.36,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.85,
      "end_seconds": 44.83,
      "duration_seconds": 2.98,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.49,
      "end_seconds": 51.46,
      "duration_seconds": 5.97,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 51.56,
      "end_seconds": 57.83,
      "duration_seconds": 6.27,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.42,
      "end_seconds": 61.81,
      "duration_seconds": 2.39,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.67,
      "end_seconds": 66.22,
      "duration_seconds": 2.55,
      "text": "Oh, uh, and vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.22,
      "end_seconds": 75.6,
      "duration_seconds": 8.38,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.37,
      "end_seconds": 87.41,
      "duration_seconds": 10.04,
      "text": "Actually, I'd give it a three, out of ten. It's a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.04,
      "end_seconds": 95.74,
      "duration_seconds": 6.7,
      "text": "Right, have you had a sudden severe tummy pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.34,
      "end_seconds": 104.65,
      "duration_seconds": 8.31,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.07,
      "end_seconds": 111.8,
      "duration_seconds": 5.73,
      "text": "Let me check a few things. Any blood in the vomit, diarrhoea or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.35,
      "end_seconds": 129.6,
      "duration_seconds": 16.25,
      "text": "No, no blood in the vomit, no diarrhoea, no fever. I did have pain spreading all over at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.37,
      "end_seconds": 137.35,
      "duration_seconds": 3.98,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.97,
      "end_seconds": 141.07,
      "duration_seconds": 3.1,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.06,
      "end_seconds": 145.08,
      "duration_seconds": 3.02,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.07,
      "end_seconds": 156.66,
      "duration_seconds": 9.59,
      "text": "I've had thin bones, yes. I've got acid reflux. Mm, I've had anxiety, yes. I, I have asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.5,
      "end_seconds": 161.81,
      "duration_seconds": 4.31,
      "text": "Okay, I can see asthma in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.43,
      "end_seconds": 173.08,
      "duration_seconds": 1.65,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.14,
      "end_seconds": 176.97,
      "duration_seconds": 1.83,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.15,
      "end_seconds": 179.96,
      "duration_seconds": 1.81,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.5,
      "end_seconds": 186.37,
      "duration_seconds": 4.87,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.37,
      "end_seconds": 194.08,
      "duration_seconds": 3.71,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.81,
      "end_seconds": 218.17,
      "duration_seconds": 20.36,
      "text": "Alendronate, 70 milligrams, once a week. Sorry, what was I saying, it's escitalopram, 10 milligrams, once a day. Yeah, it's Seretide inhaler, twice a day for my asthma. I'm on ibuprofen, 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 219.32,
      "end_seconds": 223.88,
      "duration_seconds": 4.56,
      "text": "Doctor, our chart from the last visit lists it as 1200 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.04,
      "end_seconds": 229.91,
      "duration_seconds": 4.87,
      "text": "Right, hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.88,
      "end_seconds": 245.66,
      "duration_seconds": 13.78,
      "text": "Um, not with me. I'll bring it next time. Sorry, um, what was I saying, I'd been on pantoprazole, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.75,
      "end_seconds": 261.41,
      "duration_seconds": 4.66,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.8,
      "end_seconds": 273.14,
      "duration_seconds": 10.34,
      "text": "I'm, I'm allergic to tramadol, I get feeling very drowsy. Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.23,
      "end_seconds": 275.48,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.62,
      "end_seconds": 281.02,
      "duration_seconds": 4.4,
      "text": "Yeah, uh, no, not at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 282.39,
      "end_seconds": 289.83,
      "duration_seconds": 7.44,
      "text": "Here are the numbers, doctor. Pulse 123, pressure 128 over 82. Temperature is 37.0 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.46,
      "end_seconds": 292.42,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.78,
      "end_seconds": 297.04,
      "duration_seconds": 3.26,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.74,
      "end_seconds": 300.11,
      "duration_seconds": 1.37,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.71,
      "end_seconds": 317.2,
      "duration_seconds": 7.49,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.85,
      "end_seconds": 335.38,
      "duration_seconds": 13.53,
      "text": "That's the examination finished. Let me tell you where I've got to. I think we're dealing with a perforated stomach ulcer at this stage. Another possibility is pancreatitis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 336.58,
      "end_seconds": 339.65,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.69,
      "end_seconds": 354.01,
      "duration_seconds": 12.32,
      "text": "It's reasonable to be concerned, but right now a perforated stomach ulcer is my leading thought, not anything worse. Let's book urgent blood tests to look into acute abdomen."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 354.85,
      "end_seconds": 357.91,
      "duration_seconds": 3.06,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.43,
      "end_seconds": 381.1,
      "duration_seconds": 22.67,
      "text": "We should do a CT scan for possible perforation. It's a routine test and it'll give us a much clearer picture. Nothing to eat or drink, you need an operation urgently. Cut down on salt and fried food for now, it really does make a difference. I'm going to send a referral to the surgical team."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.01,
      "end_seconds": 384.89,
      "duration_seconds": 2.88,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.4,
      "end_seconds": 395.4,
      "duration_seconds": 9.0,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.71,
      "end_seconds": 401.82,
      "duration_seconds": 1.11,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.49,
      "end_seconds": 408.97,
      "duration_seconds": 5.48,
      "text": "Let's plan a check straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 410.24,
      "end_seconds": 414.03,
      "duration_seconds": 3.79,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}