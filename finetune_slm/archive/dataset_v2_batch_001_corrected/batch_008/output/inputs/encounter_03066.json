{
  "schema_version": "1.0",
  "encounter_id": "03066",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.71,
      "end_seconds": 7.79,
      "duration_seconds": 7.08,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.47,
      "end_seconds": 13.13,
      "duration_seconds": 3.66,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.01,
      "end_seconds": 19.93,
      "duration_seconds": 4.92,
      "text": "I'm here because of hearing getting worse in both ears."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 25.41,
      "duration_seconds": 4.06,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 37.05,
      "duration_seconds": 10.55,
      "text": "Ah, uh, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.02,
      "end_seconds": 40.1,
      "duration_seconds": 2.08,
      "text": "Have you had no dizziness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.19,
      "end_seconds": 48.21,
      "duration_seconds": 6.02,
      "text": "Yes, actually. And, And hearing better in a noisy room, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.01,
      "end_seconds": 55.31,
      "duration_seconds": 3.3,
      "text": "Did you get facial weakness or discharge?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.51,
      "end_seconds": 60.96,
      "duration_seconds": 4.45,
      "text": "No, you know, no facial weakness or discharge."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.24,
      "end_seconds": 68.61,
      "duration_seconds": 2.37,
      "text": "Did you notice any ear pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.41,
      "end_seconds": 76.9,
      "duration_seconds": 7.49,
      "text": "Sorry, uh, what was I saying, I haven't noticed any ear pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.91,
      "end_seconds": 81.64,
      "duration_seconds": 2.73,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.24,
      "end_seconds": 85.37,
      "duration_seconds": 2.13,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.29,
      "end_seconds": 90.3,
      "duration_seconds": 3.01,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.31,
      "end_seconds": 92.89,
      "duration_seconds": 1.58,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 102.54,
      "duration_seconds": 4.79,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.76,
      "end_seconds": 112.47,
      "duration_seconds": 3.71,
      "text": "Um, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.0,
      "end_seconds": 133.85,
      "duration_seconds": 2.85,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.94,
      "end_seconds": 147.86,
      "duration_seconds": 8.92,
      "text": "Asthma, for nearly five years. Let me think, I've had gout for nearly five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 158.18,
      "duration_seconds": 9.65,
      "text": "Yes, carry on. Okay, I can see asthma and gout in your file as well. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.55,
      "end_seconds": 171.36,
      "duration_seconds": 11.81,
      "text": "Let me think, um, I take Asthalin inhaler, when needed for my asthma. I'm on allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.93,
      "end_seconds": 175.16,
      "duration_seconds": 3.23,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.1,
      "end_seconds": 179.34,
      "duration_seconds": 3.24,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.72,
      "end_seconds": 185.26,
      "duration_seconds": 4.54,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.03,
      "end_seconds": 197.73,
      "duration_seconds": 11.7,
      "text": "I'm vegetarian and have been for years. My husband and I live above the shop. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 216.37,
      "end_seconds": 233.81,
      "duration_seconds": 17.44,
      "text": "Okay, so the vitals from earlier. Weight 95 kilos, height 178 centimetres, BP is 126 over 78. Pulse is 72 beats a minute, SpO2 99 percent on room air, BMI works out to 30.0, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.65,
      "end_seconds": 236.35,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.02,
      "end_seconds": 240.94,
      "duration_seconds": 2.92,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.81,
      "end_seconds": 243.08,
      "duration_seconds": 1.27,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.93,
      "end_seconds": 260.32,
      "duration_seconds": 7.39,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.28,
      "end_seconds": 265.43,
      "duration_seconds": 2.15,
      "text": "Right, you can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.34,
      "end_seconds": 300.57,
      "duration_seconds": 27.23,
      "text": "Putting it all together, this is probably a conductive hearing loss, possibly otosclerosis. I think a CT scan of the ears makes sense here, for possible otosclerosis. I think a hearing test makes sense here, for hearing loss. A hearing aid or an operation are both options after the tests. I'd like to see you again after the tests. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.3,
      "end_seconds": 309.16,
      "duration_seconds": 3.86,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.05,
      "end_seconds": 311.84,
      "duration_seconds": 1.79,
      "text": "Have a good day."
    }
  ]
}