{
  "schema_version": "1.0",
  "encounter_id": "03211",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.95,
      "duration_seconds": 4.58,
      "text": "So, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.23,
      "end_seconds": 11.89,
      "duration_seconds": 4.66,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 23.2,
      "duration_seconds": 10.38,
      "text": "I've been feeling tired and weak, and I wanted to get it checked. I've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.93,
      "end_seconds": 26.92,
      "duration_seconds": 1.99,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.85,
      "end_seconds": 31.08,
      "duration_seconds": 3.23,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.09,
      "end_seconds": 36.3,
      "duration_seconds": 3.21,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.02,
      "end_seconds": 51.02,
      "duration_seconds": 13.0,
      "text": "I'd give it a eight, out of ten. I've had darker skin too, for about three months. About darker skin, moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.81,
      "end_seconds": 70.87,
      "duration_seconds": 5.06,
      "text": "Can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.34,
      "end_seconds": 84.39,
      "duration_seconds": 3.05,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.93,
      "end_seconds": 109.55,
      "duration_seconds": 14.62,
      "text": "Okay: weight 77 kilos, temp 36.7 degrees. And BMI works out to 23.2, pulse is 98 beats a minute, BP is 93 over 61, height 182 centimetres."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.37,
      "end_seconds": 111.97,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.65,
      "end_seconds": 115.29,
      "duration_seconds": 2.64,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.65,
      "end_seconds": 122.19,
      "duration_seconds": 4.54,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 140.13,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.91,
      "end_seconds": 144.06,
      "duration_seconds": 2.15,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.82,
      "end_seconds": 169.94,
      "duration_seconds": 10.12,
      "text": "The creases in your palms and your scars are darker than they should be and and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.0,
      "end_seconds": 179.54,
      "duration_seconds": 6.54,
      "text": "Thank you, you can get dressed. And severe tummy pain, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.57,
      "end_seconds": 182.93,
      "duration_seconds": 2.36,
      "text": "Nope, no severe tummy pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.79,
      "end_seconds": 189.27,
      "duration_seconds": 4.48,
      "text": "A A few quick ones: fever, vomiting or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.63,
      "end_seconds": 199.14,
      "duration_seconds": 6.51,
      "text": "Um, um, no fever, vomiting or fainting, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.08,
      "end_seconds": 203.51,
      "duration_seconds": 1.43,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.7,
      "end_seconds": 207.67,
      "duration_seconds": 2.97,
      "text": "erm, no, that's all normal"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.26,
      "end_seconds": 228.65,
      "duration_seconds": 2.39,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.73,
      "end_seconds": 239.71,
      "duration_seconds": 6.98,
      "text": "Diclofenac. I take it 50 milligrams, when needed. Valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.88,
      "end_seconds": 248.4,
      "duration_seconds": 3.52,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.23,
      "end_seconds": 255.71,
      "duration_seconds": 5.48,
      "text": "I, I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.28,
      "end_seconds": 257.38,
      "duration_seconds": 1.1,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.2,
      "end_seconds": 260.25,
      "duration_seconds": 2.05,
      "text": "yes, high blood pressure"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.78,
      "end_seconds": 272.74,
      "duration_seconds": 7.96,
      "text": "Okay, I can see arthritis in your knees and high blood pressure in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.92,
      "end_seconds": 276.92,
      "duration_seconds": 3.0,
      "text": "Okay, so no, not at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.91,
      "end_seconds": 281.03,
      "duration_seconds": 3.12,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.02,
      "end_seconds": 286.24,
      "duration_seconds": 3.22,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.22,
      "end_seconds": 291.52,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.42,
      "end_seconds": 295.59,
      "duration_seconds": 3.17,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.13,
      "end_seconds": 298.27,
      "duration_seconds": 2.14,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.88,
      "end_seconds": 304.88,
      "duration_seconds": 5.0,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.46,
      "end_seconds": 307.65,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.87,
      "end_seconds": 313.07,
      "duration_seconds": 4.2,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.09,
      "end_seconds": 316.38,
      "duration_seconds": 2.29,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.27,
      "end_seconds": 323.62,
      "duration_seconds": 2.35,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.51,
      "end_seconds": 330.29,
      "duration_seconds": 4.78,
      "text": "putting it all together, it fits best with possible adrenal insufficiency"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.92,
      "end_seconds": 335.13,
      "duration_seconds": 3.21,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.15,
      "end_seconds": 354.54,
      "duration_seconds": 18.39,
      "text": "It's reasonable to be concerned, but right now possible adrenal insufficiency is my leading thought, not anything worse. A morning cortisol is what I'd like next, for possible adrenal insufficiency. Let's book blood tests to look into possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.58,
      "end_seconds": 357.0,
      "duration_seconds": 1.42,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.28,
      "end_seconds": 381.77,
      "duration_seconds": 23.49,
      "text": "Drink fluids and eat salty foods until the results, and come in if you vomit. I'm not ordering a short synacthen test today. If things carry on in a month, we'll consider it. I'll want another look after the results. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.36,
      "end_seconds": 385.28,
      "duration_seconds": 2.92,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}