{
  "schema_version": "1.0",
  "encounter_id": "03103",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.24,
      "duration_seconds": 4.19,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 12.39,
      "duration_seconds": 5.5,
      "text": "So, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.11,
      "end_seconds": 17.38,
      "duration_seconds": 3.27,
      "text": "So, I've been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.87,
      "end_seconds": 26.14,
      "duration_seconds": 3.27,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.8,
      "end_seconds": 31.1,
      "duration_seconds": 3.3,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.03,
      "end_seconds": 35.14,
      "duration_seconds": 3.11,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 42.02,
      "duration_seconds": 5.79,
      "text": "It's moderate, honestly. I've also been coughing up large amounts of blood."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.8,
      "end_seconds": 64.7,
      "duration_seconds": 4.9,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.11,
      "end_seconds": 67.34,
      "duration_seconds": 1.23,
      "text": "Yes, trimethoprim."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.11,
      "end_seconds": 70.45,
      "duration_seconds": 2.34,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.13,
      "end_seconds": 75.43,
      "duration_seconds": 3.3,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 94.25,
      "duration_seconds": 2.54,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.81,
      "end_seconds": 99.36,
      "duration_seconds": 4.55,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.91,
      "end_seconds": 103.99,
      "duration_seconds": 4.08,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.66,
      "end_seconds": 115.7,
      "duration_seconds": 11.04,
      "text": "I take naproxen, 250 milligrams, twice a day for the knee pain. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.86,
      "end_seconds": 118.61,
      "duration_seconds": 1.75,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.68,
      "end_seconds": 121.29,
      "duration_seconds": 1.61,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.23,
      "end_seconds": 125.63,
      "duration_seconds": 3.4,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.59,
      "end_seconds": 130.26,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.96,
      "end_seconds": 134.25,
      "duration_seconds": 3.29,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.86,
      "end_seconds": 138.32,
      "duration_seconds": 3.46,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.58,
      "end_seconds": 141.14,
      "duration_seconds": 1.56,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.59,
      "end_seconds": 146.67,
      "duration_seconds": 4.08,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.26,
      "end_seconds": 150.61,
      "duration_seconds": 2.35,
      "text": "Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.39,
      "end_seconds": 157.22,
      "duration_seconds": 2.83,
      "text": "No, no fever or chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 160.06,
      "duration_seconds": 1.6,
      "text": "How about weight loss?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.73,
      "end_seconds": 163.41,
      "duration_seconds": 2.68,
      "text": "I haven't noticed any weight loss."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.87,
      "end_seconds": 167.64,
      "duration_seconds": 2.77,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.35,
      "end_seconds": 171.1,
      "duration_seconds": 2.75,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.67,
      "end_seconds": 175.63,
      "duration_seconds": 2.96,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.16,
      "end_seconds": 183.65,
      "duration_seconds": 2.49,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.94,
      "end_seconds": 187.67,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.54,
      "end_seconds": 197.83,
      "duration_seconds": 2.29,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 217.05,
      "duration_seconds": 6.48,
      "text": "Okay: BP is 138 over 72, saturation 94 percent. And heart rate 88, respiratory rate 23."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.14,
      "end_seconds": 220.83,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.82,
      "end_seconds": 226.54,
      "duration_seconds": 3.72,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.09,
      "end_seconds": 234.09,
      "duration_seconds": 5.0,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.31,
      "end_seconds": 236.77,
      "duration_seconds": 1.46,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 238.93,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.44,
      "end_seconds": 254.95,
      "duration_seconds": 6.51,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.26,
      "end_seconds": 258.98,
      "duration_seconds": 1.72,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.95,
      "end_seconds": 309.29,
      "duration_seconds": 33.34,
      "text": "Putting it all together, I'd lean towards life-threatening haemoptysis. A pulmonary embolus is also on my list. We should do urgent blood tests for bleeding. We should do an urgent CT scan for massive haemoptysis. Let's use tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. It's a commonly used medicine and most people tolerate it well. Lie on the bleeding side and I am calling the emergency team. Come back straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.16,
      "end_seconds": 315.77,
      "duration_seconds": 1.61,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.66,
      "end_seconds": 320.35,
      "duration_seconds": 2.69,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.92,
      "end_seconds": 322.48,
      "duration_seconds": 1.56,
      "text": "That's clear, thanks."
    }
  ]
}