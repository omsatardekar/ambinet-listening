{
  "schema_version": "1.0",
  "encounter_id": "03055",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 6.07,
      "duration_seconds": 5.15,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.0,
      "end_seconds": 11.67,
      "duration_seconds": 3.67,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.59,
      "end_seconds": 17.94,
      "duration_seconds": 4.35,
      "text": "I wanted to get severe back pain looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.62,
      "end_seconds": 26.49,
      "duration_seconds": 2.87,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.53,
      "end_seconds": 30.76,
      "duration_seconds": 3.23,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 34.55,
      "duration_seconds": 3.19,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.07,
      "end_seconds": 37.03,
      "duration_seconds": 0.96,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 40.81,
      "duration_seconds": 2.65,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.93,
      "end_seconds": 54.9,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.2,
      "end_seconds": 81.06,
      "duration_seconds": 6.86,
      "text": "Okay: blood pressure 114 over 76, temperature is 38.8 degrees, heart rate 108."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.81,
      "end_seconds": 86.15,
      "duration_seconds": 3.34,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.78,
      "end_seconds": 98.75,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.85,
      "end_seconds": 101.97,
      "duration_seconds": 2.12,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.27,
      "end_seconds": 125.85,
      "duration_seconds": 5.58,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.91,
      "end_seconds": 131.59,
      "duration_seconds": 2.68,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.63,
      "end_seconds": 147.83,
      "duration_seconds": 5.2,
      "text": "A few quick ones: weight loss, chest pain or recent fall?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.49,
      "end_seconds": 152.02,
      "duration_seconds": 2.53,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.88,
      "end_seconds": 158.63,
      "duration_seconds": 2.75,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.73,
      "end_seconds": 162.99,
      "duration_seconds": 3.26,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.85,
      "end_seconds": 166.41,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.05,
      "end_seconds": 169.02,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.04,
      "end_seconds": 182.73,
      "duration_seconds": 4.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.2,
      "end_seconds": 193.99,
      "duration_seconds": 9.79,
      "text": "I walk the dog every morning. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 198.35,
      "duration_seconds": 3.69,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.22,
      "end_seconds": 201.25,
      "duration_seconds": 1.03,
      "text": "Yes, tramadol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.3,
      "end_seconds": 203.72,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.78,
      "end_seconds": 206.98,
      "duration_seconds": 2.2,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.1,
      "end_seconds": 212.77,
      "duration_seconds": 4.67,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.15,
      "end_seconds": 217.17,
      "duration_seconds": 3.02,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.63,
      "end_seconds": 228.97,
      "duration_seconds": 2.34,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.07,
      "end_seconds": 231.85,
      "duration_seconds": 1.78,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.65,
      "end_seconds": 251.3,
      "duration_seconds": 18.65,
      "text": "Right, here's what I'm thinking. I think we're dealing with a possible spinal infection pressing on the nerves at this stage. So, to recap quickly. You've had severe back pain for about two weeks, moderate, and no weight loss or chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.97,
      "end_seconds": 252.67,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 259.52,
      "duration_seconds": 4.88,
      "text": "I want urgent blood tests done, that's for possible spinal infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.95,
      "end_seconds": 264.84,
      "duration_seconds": 3.89,
      "text": "Right, you know, is that done today?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.6,
      "end_seconds": 274.9,
      "duration_seconds": 9.3,
      "text": "You are going to hospital now, this can cause permanent weakness. I'm going to send a referral to the spinal team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.67,
      "end_seconds": 276.37,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.35,
      "end_seconds": 283.79,
      "duration_seconds": 2.44,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.93,
      "end_seconds": 288.63,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.49,
      "end_seconds": 293.51,
      "duration_seconds": 4.02,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.97,
      "end_seconds": 297.74,
      "duration_seconds": 2.77,
      "text": "Well, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.58,
      "end_seconds": 300.9,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
