{
  "schema_version": "1.0",
  "encounter_id": "03232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.93,
      "duration_seconds": 5.69,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.68,
      "end_seconds": 13.0,
      "duration_seconds": 4.32,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 18.86,
      "duration_seconds": 5.07,
      "text": "Doctor, it's shortness of breath. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.49,
      "end_seconds": 23.44,
      "duration_seconds": 3.95,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 28.78,
      "duration_seconds": 3.74,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.21,
      "end_seconds": 32.77,
      "duration_seconds": 2.56,
      "text": "Right, what brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.8,
      "end_seconds": 50.43,
      "duration_seconds": 16.63,
      "text": "Yes, lying flat. That makes it worse. As for feeling faint, I honestly can't say when that began. It might have been last month or the month before. With feeling faint, it's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 51.61,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.63,
      "end_seconds": 72.01,
      "duration_seconds": 2.38,
      "text": "Did you notice any cough?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.69,
      "end_seconds": 75.06,
      "duration_seconds": 1.37,
      "text": "Definitely no cough."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.58,
      "end_seconds": 79.2,
      "duration_seconds": 3.62,
      "text": "Okay, a few quick ones: leg swelling or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.35,
      "end_seconds": 84.03,
      "duration_seconds": 3.68,
      "text": "No, you know, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.12,
      "end_seconds": 90.26,
      "duration_seconds": 4.14,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.53,
      "end_seconds": 94.28,
      "duration_seconds": 2.75,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.43,
      "end_seconds": 98.94,
      "duration_seconds": 3.51,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.52,
      "end_seconds": 101.96,
      "duration_seconds": 2.44,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.42,
      "end_seconds": 106.73,
      "duration_seconds": 3.31,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.56,
      "end_seconds": 119.26,
      "duration_seconds": 10.7,
      "text": "Erm, uh, it's glimepiride, 2 milligrams, before breakfast for my sugar. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.26,
      "end_seconds": 123.88,
      "duration_seconds": 2.62,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.45,
      "end_seconds": 126.42,
      "duration_seconds": 1.97,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.31,
      "end_seconds": 130.55,
      "duration_seconds": 2.24,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 135.4,
      "duration_seconds": 4.02,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.85,
      "end_seconds": 138.05,
      "duration_seconds": 1.2,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.11,
      "end_seconds": 143.96,
      "duration_seconds": 3.85,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.21,
      "end_seconds": 147.46,
      "duration_seconds": 2.25,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.29,
      "end_seconds": 156.31,
      "duration_seconds": 7.02,
      "text": "I have diabetes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 162.99,
      "duration_seconds": 5.69,
      "text": "Alright, yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.3,
      "end_seconds": 183.73,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.88,
      "end_seconds": 193.13,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 215.83,
      "duration_seconds": 12.84,
      "text": "Okay: height 171 centimetres, respiratory rate 19. And pulse 104, BP is 99 over 66, temperature 36.6, BMI works out to 29.8, weight 87 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.78,
      "end_seconds": 222.04,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.4,
      "end_seconds": 225.48,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.2,
      "end_seconds": 251.79,
      "duration_seconds": 7.59,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.93,
      "end_seconds": 273.05,
      "duration_seconds": 16.12,
      "text": "Okay, that's enough for me. Putting it all together, it fits best with possible cardiac tamponade. The reason I say that is that your story and my examination fit together. Another possibility is a heart attack."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.69,
      "end_seconds": 276.4,
      "duration_seconds": 2.71,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.2,
      "end_seconds": 287.16,
      "duration_seconds": 8.96,
      "text": "Nothing I've seen today points to an emergency. It looks like possible cardiac tamponade, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.71,
      "end_seconds": 322.64,
      "duration_seconds": 16.93,
      "text": "We should do an ECG for chest pain. Let's get an urgent echocardiogram, for possible tamponade. You need an urgent heart scan and possibly a drain. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.41,
      "end_seconds": 326.36,
      "duration_seconds": 1.95,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.77,
      "end_seconds": 335.1,
      "duration_seconds": 5.33,
      "text": "Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.78,
      "end_seconds": 337.71,
      "duration_seconds": 1.93,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.98,
      "end_seconds": 340.89,
      "duration_seconds": 1.91,
      "text": "Have a good day."
    }
  ]
}