  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 5.23,
      "duration_seconds": 4.17,
      "text": "So, hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.5,
      "end_seconds": 11.79,
      "duration_seconds": 5.29,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.32,
      "end_seconds": 15.77,
      "duration_seconds": 2.45,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.65,
      "end_seconds": 24.65,
      "duration_seconds": 8.0,
      "text": "Uh, I've been coughing up large amounts of blood, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.88,
      "end_seconds": 29.2,
      "duration_seconds": 1.32,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.86,
      "end_seconds": 32.85,
      "duration_seconds": 1.99,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.29,
      "end_seconds": 38.83,
      "duration_seconds": 5.54,
      "text": "okay, go on so, how much does it it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.44,
      "end_seconds": 45.8,
      "duration_seconds": 5.36,
      "text": "Moderate, really. And, And there's breathlessness as well, three days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.9,
      "end_seconds": 50.03,
      "duration_seconds": 3.13,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.06,
      "end_seconds": 54.86,
      "duration_seconds": 2.8,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.65,
      "end_seconds": 61.83,
      "duration_seconds": 2.18,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.74,
      "end_seconds": 66.41,
      "duration_seconds": 2.67,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.77,
      "end_seconds": 71.44,
      "duration_seconds": 4.67,
      "text": "I follow. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.48,
      "end_seconds": 81.55,
      "duration_seconds": 2.07,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.35,
      "end_seconds": 107.88,
      "duration_seconds": 8.53,
      "text": "okay: temperature 37.2, heart rate 91, respiratory rate 20, saturation 89 percent, pressure 138 over 82."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.75,
      "end_seconds": 113.7,
      "duration_seconds": 2.95,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.48,
      "end_seconds": 117.48,
      "duration_seconds": 2.0,
      "text": "Right, look straight ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 140.64,
      "duration_seconds": 6.05,
      "text": "You are pale, breathing fast and and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.21,
      "end_seconds": 153.32,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.02,
      "end_seconds": 158.55,
      "duration_seconds": 2.53,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.75,
      "end_seconds": 168.63,
      "duration_seconds": 2.88,
      "text": "So, has there been any weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.69,
      "end_seconds": 172.8,
      "duration_seconds": 2.11,
      "text": "No. No weight loss."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.49,
      "end_seconds": 178.08,
      "duration_seconds": 4.59,
      "text": "let me check a few things any fever or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.6,
      "end_seconds": 183.5,
      "duration_seconds": 4.9,
      "text": "Yeah, no fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.33,
      "end_seconds": 190.79,
      "duration_seconds": 5.46,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.1,
      "end_seconds": 194.71,
      "duration_seconds": 2.61,
      "text": "well, no, nothing like that"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.27,
      "end_seconds": 197.93,
      "duration_seconds": 2.66,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.87,
      "end_seconds": 202.03,
      "duration_seconds": 3.16,
      "text": "no, um, skin's been fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.69,
      "end_seconds": 206.55,
      "duration_seconds": 2.86,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.52,
      "end_seconds": 213.26,
      "duration_seconds": 5.74,
      "text": "yes, I had a caesarean for my second baby, nine years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.23,
      "end_seconds": 218.31,
      "duration_seconds": 3.08,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.93,
      "end_seconds": 230.98,
      "duration_seconds": 11.05,
      "text": "My partner and our baby. Yes, I work in a bakery, early starts. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.63,
      "end_seconds": 249.33,
      "duration_seconds": 3.7,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.18,
      "end_seconds": 254.34,
      "duration_seconds": 4.16,
      "text": "I take valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.96,
      "end_seconds": 257.96,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.71,
      "end_seconds": 266.06,
      "duration_seconds": 7.35,
      "text": "I have high blood pressure. My neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.21,
      "end_seconds": 268.62,
      "duration_seconds": 1.41,
      "text": "okay, what else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.44,
      "end_seconds": 273.69,
      "duration_seconds": 4.25,
      "text": "I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.24,
      "end_seconds": 284.36,
      "duration_seconds": 10.12,
      "text": "alright, high blood pressure, that matches what I have here are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.22,
      "end_seconds": 293.14,
      "duration_seconds": 4.92,
      "text": "uh, I don't think I have any, no"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.94,
      "end_seconds": 328.37,
      "duration_seconds": 33.43,
      "text": "Taking everything into account, it fits best with life-threatening haemoptysis. I'm sending you for urgent blood tests because of bleeding. I'd like to arrange an urgent CT scan for massive haemoptysis. We'll begin with tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.35,
      "end_seconds": 340.47,
      "duration_seconds": 10.12,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's review you straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 342.22,
      "end_seconds": 343.72,
      "duration_seconds": 1.5,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.93,
      "end_seconds": 348.9,
      "duration_seconds": 3.97,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 350.97,
      "end_seconds": 354.04,
      "duration_seconds": 3.07,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}