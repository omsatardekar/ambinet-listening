{
  "schema_version": "1.0",
  "encounter_id": "03349",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 4.34,
      "duration_seconds": 3.01,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 10.09,
      "duration_seconds": 5.09,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.71,
      "end_seconds": 19.5,
      "duration_seconds": 8.79,
      "text": "Sorry, what was I saying, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.39,
      "end_seconds": 24.87,
      "duration_seconds": 3.48,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.64,
      "end_seconds": 34.2,
      "duration_seconds": 8.56,
      "text": "I wanted to get shaking looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.08,
      "end_seconds": 38.31,
      "duration_seconds": 3.23,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.12,
      "end_seconds": 43.42,
      "duration_seconds": 3.3,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.96,
      "end_seconds": 48.33,
      "duration_seconds": 3.37,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 49.97,
      "duration_seconds": 0.91,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.8,
      "end_seconds": 53.72,
      "duration_seconds": 2.92,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 57.93,
      "duration_seconds": 3.36,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.41,
      "end_seconds": 65.63,
      "duration_seconds": 7.22,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 65.73,
      "end_seconds": 70.53,
      "duration_seconds": 4.8,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.58,
      "end_seconds": 75.42,
      "duration_seconds": 2.84,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.93,
      "end_seconds": 81.07,
      "duration_seconds": 4.14,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.18,
      "end_seconds": 88.36,
      "duration_seconds": 6.18,
      "text": "I mean, I've also been feeling anxious and agitated, for about a month."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.6,
      "end_seconds": 92.4,
      "duration_seconds": 2.8,
      "text": "Any being unable to sleep as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.89,
      "end_seconds": 107.88,
      "duration_seconds": 10.99,
      "text": "Yes, uh, for four weeks. With being unable to sleep, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.23,
      "end_seconds": 114.64,
      "duration_seconds": 5.41,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.4,
      "end_seconds": 117.67,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.45,
      "end_seconds": 133.43,
      "duration_seconds": 5.98,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.16,
      "end_seconds": 138.65,
      "duration_seconds": 2.49,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.35,
      "end_seconds": 159.66,
      "duration_seconds": 3.31,
      "text": "Have you had seeing things, by any chance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.5,
      "end_seconds": 162.42,
      "duration_seconds": 1.92,
      "text": "Definitely no seeing things."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.97,
      "end_seconds": 165.72,
      "duration_seconds": 2.75,
      "text": "Any vomiting blood, seizure or confusion?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.7,
      "end_seconds": 176.85,
      "duration_seconds": 10.15,
      "text": "No, no vomiting blood, no seizure, no confusion. I was sweating at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.5,
      "end_seconds": 186.9,
      "duration_seconds": 4.4,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.97,
      "end_seconds": 193.3,
      "duration_seconds": 5.33,
      "text": "I mean, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.36,
      "end_seconds": 197.44,
      "duration_seconds": 2.08,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.92,
      "end_seconds": 200.49,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.04,
      "end_seconds": 203.23,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.67,
      "end_seconds": 206.79,
      "duration_seconds": 2.12,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.56,
      "end_seconds": 210.87,
      "duration_seconds": 3.31,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.5,
      "end_seconds": 216.93,
      "duration_seconds": 5.43,
      "text": "I take febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 218.39,
      "end_seconds": 227.7,
      "duration_seconds": 9.31,
      "text": "Doctor, I think the last prescription for the febuxostat was 40 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.35,
      "end_seconds": 232.5,
      "duration_seconds": 4.15,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.01,
      "end_seconds": 246.03,
      "duration_seconds": 13.02,
      "text": "Erm, you know, not with me. I'll bring it next time. Ah, I take heavy drinking until two days ago, stopped two days ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.99,
      "end_seconds": 251.84,
      "duration_seconds": 4.85,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.78,
      "end_seconds": 257.57,
      "duration_seconds": 3.79,
      "text": "I've got an irregular heartbeat. I've got gout."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.19,
      "end_seconds": 270.72,
      "duration_seconds": 11.53,
      "text": "I see, go ahead. Right, so gout is already on your record. We'll keep that in mind today. Is there someone at home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.48,
      "end_seconds": 276.81,
      "duration_seconds": 4.33,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.07,
      "end_seconds": 295.47,
      "duration_seconds": 7.4,
      "text": "Any allergies to tablets, food or anything in the environment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.68,
      "end_seconds": 308.84,
      "duration_seconds": 12.16,
      "text": "Cat fur. I come out in... well, sneezing. I was told I'm allergic to nickel, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.73,
      "end_seconds": 318.75,
      "duration_seconds": 8.02,
      "text": "Having listened and examined, it points towards alcohol withdrawal. An anxiety state is also on my list."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.22,
      "end_seconds": 323.97,
      "duration_seconds": 3.75,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.61,
      "end_seconds": 341.52,
      "duration_seconds": 16.91,
      "text": "It's reasonable to be concerned, but right now alcohol withdrawal is my leading thought, not anything worse. So, to recap quickly. You've had shaking for about a month, mild, and no vomiting blood or seizure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.01,
      "end_seconds": 343.71,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.95,
      "end_seconds": 349.01,
      "duration_seconds": 4.06,
      "text": "Blood tests is what I'd like next, for alcohol withdrawal."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 349.96,
      "end_seconds": 352.69,
      "duration_seconds": 2.73,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.76,
      "end_seconds": 356.65,
      "duration_seconds": 2.89,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.06,
      "end_seconds": 394.03,
      "duration_seconds": 33.97,
      "text": "I'm prescribing thiamine, 100 milligrams, three times a day, long term. That should help with alcohol-related deficiency. The treatment will be chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. It's for alcohol withdrawal. Do not stop alcohol suddenly without medical support. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the alcohol liaison service."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.14,
      "end_seconds": 417.16,
      "duration_seconds": 22.02,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again in two days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.95,
      "end_seconds": 424.7,
      "duration_seconds": 3.75,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.54,
      "end_seconds": 428.81,
      "duration_seconds": 1.27,
      "text": "Look after yourself."
    }
  ]
}