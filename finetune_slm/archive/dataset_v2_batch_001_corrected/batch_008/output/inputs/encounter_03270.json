{
  "schema_version": "1.0",
  "encounter_id": "03270",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 10.13,
      "duration_seconds": 8.91,
      "text": "Sorry, what was I saying, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.78,
      "end_seconds": 15.42,
      "duration_seconds": 4.64,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.97,
      "end_seconds": 22.56,
      "duration_seconds": 5.59,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.52,
      "end_seconds": 28.31,
      "duration_seconds": 3.79,
      "text": "Alright, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.84,
      "end_seconds": 35.58,
      "duration_seconds": 5.74,
      "text": "We came because of a pearly bump on my nose that bleeds."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.09,
      "end_seconds": 38.94,
      "duration_seconds": 1.85,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.83,
      "end_seconds": 42.92,
      "duration_seconds": 3.09,
      "text": "I notice it more with washing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.83,
      "end_seconds": 47.3,
      "duration_seconds": 2.47,
      "text": "So, has there been crusting too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.98,
      "end_seconds": 51.87,
      "duration_seconds": 2.89,
      "text": "Yeah. Two months, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.73,
      "end_seconds": 56.29,
      "duration_seconds": 2.56,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.06,
      "end_seconds": 70.87,
      "duration_seconds": 12.81,
      "text": "Mild, really. Erm, I've also had a sore that won't heal, for one week. With sore that won't heal, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.37,
      "end_seconds": 78.89,
      "duration_seconds": 7.52,
      "text": "Understood. Any swollen glands, family history of skin cancer, other new lumps or pain at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.46,
      "end_seconds": 82.19,
      "duration_seconds": 2.73,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.92,
      "end_seconds": 88.46,
      "duration_seconds": 3.54,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.31,
      "end_seconds": 93.38,
      "duration_seconds": 3.07,
      "text": "I mean, no, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.85,
      "end_seconds": 98.7,
      "duration_seconds": 3.85,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.42,
      "end_seconds": 102.34,
      "duration_seconds": 1.92,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.47,
      "end_seconds": 105.43,
      "duration_seconds": 1.96,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.28,
      "end_seconds": 110.25,
      "duration_seconds": 3.97,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.91,
      "end_seconds": 113.27,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.83,
      "end_seconds": 118.65,
      "duration_seconds": 3.82,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.1,
      "end_seconds": 123.29,
      "duration_seconds": 3.19,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.91,
      "end_seconds": 127.05,
      "duration_seconds": 3.14,
      "text": "She takes hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.36,
      "end_seconds": 135.96,
      "duration_seconds": 4.6,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.12,
      "end_seconds": 139.02,
      "duration_seconds": 1.9,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.87,
      "end_seconds": 150.64,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.5,
      "end_seconds": 156.41,
      "duration_seconds": 3.91,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.34,
      "end_seconds": 161.71,
      "duration_seconds": 4.37,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.95,
      "end_seconds": 166.24,
      "duration_seconds": 3.29,
      "text": "Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.58,
      "end_seconds": 173.78,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.63,
      "end_seconds": 181.82,
      "duration_seconds": 7.19,
      "text": "Eczema, for five years. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.33,
      "end_seconds": 191.26,
      "duration_seconds": 8.93,
      "text": "Okay, I can see eczema in your file as well. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.4,
      "end_seconds": 199.39,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.63,
      "end_seconds": 218.09,
      "duration_seconds": 9.46,
      "text": "Okay: SpO2 98 percent on room air, pulse is 86 beats a minute. And temperature 36.6, pressure 126 over 79."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.52,
      "end_seconds": 220.91,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.47,
      "end_seconds": 223.71,
      "duration_seconds": 2.24,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.24,
      "end_seconds": 230.44,
      "duration_seconds": 4.2,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.43,
      "end_seconds": 235.29,
      "duration_seconds": 2.86,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.18,
      "end_seconds": 262.64,
      "duration_seconds": 8.46,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.77,
      "end_seconds": 269.03,
      "duration_seconds": 2.26,
      "text": "So, all finished, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.98,
      "end_seconds": 290.81,
      "duration_seconds": 9.83,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at a likely basal cell carcinoma or a squamous cell carcinoma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.97,
      "end_seconds": 323.06,
      "duration_seconds": 19.09,
      "text": "Let's get a dermoscopy, for suspicious lesion. Let's get a skin biopsy, for suspicious lesion. Please use a high-factor sunscreen and a hat. I think the skin cancer clinic should see you too. Please come and see me after the biopsy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.89,
      "end_seconds": 327.4,
      "duration_seconds": 1.51,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.28,
      "end_seconds": 333.7,
      "duration_seconds": 4.42,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.39,
      "end_seconds": 336.71,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.27,
      "end_seconds": 338.68,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}