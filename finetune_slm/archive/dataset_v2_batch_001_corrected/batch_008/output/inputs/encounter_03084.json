{
  "schema_version": "1.0",
  "encounter_id": "03084",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.4,
      "duration_seconds": 3.33,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.47,
      "end_seconds": 13.7,
      "duration_seconds": 4.23,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.38,
      "end_seconds": 19.9,
      "duration_seconds": 4.52,
      "text": "So the thing is, I've got severe burning."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.55,
      "end_seconds": 24.33,
      "duration_seconds": 3.78,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 28.13,
      "duration_seconds": 2.57,
      "text": "About... well, about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.74,
      "end_seconds": 34.3,
      "duration_seconds": 5.56,
      "text": "Alright, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.62,
      "end_seconds": 43.73,
      "duration_seconds": 8.11,
      "text": "I'd say once or twice a day. Oh, and a splash of cleaning fluid in my eye."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.94,
      "end_seconds": 47.23,
      "duration_seconds": 3.29,
      "text": "Hm, okay. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.87,
      "end_seconds": 52.62,
      "duration_seconds": 3.75,
      "text": "I have an enlarged prostate, for five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.52,
      "end_seconds": 54.31,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.78,
      "end_seconds": 71.29,
      "duration_seconds": 2.51,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.15,
      "end_seconds": 73.2,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.31,
      "end_seconds": 81.19,
      "duration_seconds": 4.88,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.45,
      "end_seconds": 89.94,
      "duration_seconds": 7.49,
      "text": "Tamsulosin. I take it it 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.64,
      "end_seconds": 95.15,
      "duration_seconds": 4.51,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.96,
      "end_seconds": 100.69,
      "duration_seconds": 3.73,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.91,
      "end_seconds": 110.33,
      "duration_seconds": 2.42,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.7,
      "end_seconds": 115.42,
      "duration_seconds": 3.72,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.57,
      "end_seconds": 120.0,
      "duration_seconds": 3.43,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.63,
      "end_seconds": 124.45,
      "duration_seconds": 2.82,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.46,
      "end_seconds": 126.66,
      "duration_seconds": 1.2,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 131.23,
      "duration_seconds": 3.84,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.87,
      "end_seconds": 139.7,
      "duration_seconds": 3.83,
      "text": "A few quick ones: both eyes or head injury?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.68,
      "end_seconds": 142.77,
      "duration_seconds": 2.09,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.29,
      "end_seconds": 146.48,
      "duration_seconds": 2.19,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.64,
      "end_seconds": 152.81,
      "duration_seconds": 2.17,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.61,
      "end_seconds": 171.09,
      "duration_seconds": 2.48,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.12,
      "end_seconds": 183.61,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.52,
      "end_seconds": 213.03,
      "duration_seconds": 7.51,
      "text": "Okay: pulse is 84 beats a minute, blood pressure 115 over 70, saturation 99 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.19,
      "end_seconds": 219.55,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.76,
      "end_seconds": 223.48,
      "duration_seconds": 2.72,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.69,
      "end_seconds": 226.77,
      "duration_seconds": 2.08,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.63,
      "end_seconds": 229.7,
      "duration_seconds": 2.07,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.58,
      "end_seconds": 246.91,
      "duration_seconds": 7.33,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.76,
      "end_seconds": 251.63,
      "duration_seconds": 1.87,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.18,
      "end_seconds": 284.4,
      "duration_seconds": 14.22,
      "text": "From what you've told me and what I found, I'm honestly not certain yet. It could be an alkali chemical burn to the eye, or it might be a corneal abrasion."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.46,
      "end_seconds": 290.44,
      "duration_seconds": 3.98,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.11,
      "end_seconds": 321.66,
      "duration_seconds": 30.55,
      "text": "I can't promise yet, but most people with an alkali chemical burn to the eye do well once it's treated properly. An urgent pH check is what I'd like next, for chemical burn the treatment will be sterile saline irrigation, 2 litres, continuous, until pH neutral it's for chemical eye burn i am washing the eye now, keep it open and do not stop"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.09,
      "end_seconds": 326.58,
      "duration_seconds": 4.49,
      "text": "mm, okay let's plan a a check straight away"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.81,
      "end_seconds": 329.95,
      "duration_seconds": 2.14,
      "text": "okay, I'll arrange it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.9,
      "end_seconds": 339.43,
      "duration_seconds": 6.53,
      "text": "let me check I've been clear what will you do once you get home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.15,
      "end_seconds": 354.39,
      "duration_seconds": 10.24,
      "text": "so, I take the sterile saline irrigation, 2 litres, continuous and come back straight away is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.19,
      "end_seconds": 360.7,
      "duration_seconds": 4.51,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.48,
      "end_seconds": 365.19,
      "duration_seconds": 2.71,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.74,
      "end_seconds": 367.96,
      "duration_seconds": 1.22,
      "text": "Take care now."
    }
  ]
