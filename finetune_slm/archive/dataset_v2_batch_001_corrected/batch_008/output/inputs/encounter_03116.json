{
  "schema_version": "1.0",
  "encounter_id": "03116",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 5.35,
      "duration_seconds": 4.29,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.44,
      "end_seconds": 11.36,
      "duration_seconds": 4.92,
      "text": "Right, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 18.07,
      "duration_seconds": 6.18,
      "text": "I'm here because of sudden severe pain in the lower tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 23.28,
      "duration_seconds": 3.56,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 37.34,
      "duration_seconds": 2.51,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.5,
      "end_seconds": 59.13,
      "duration_seconds": 6.63,
      "text": "Okay: saturation 96 percent, BP is 94 over 64, pulse is 103 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 61.86,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.88,
      "end_seconds": 66.25,
      "duration_seconds": 2.37,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.27,
      "end_seconds": 85.48,
      "duration_seconds": 3.21,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.27,
      "end_seconds": 90.06,
      "duration_seconds": 3.79,
      "text": "Probably three days. Yeah. I've also had collapsing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.16,
      "end_seconds": 95.34,
      "duration_seconds": 3.18,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.93,
      "end_seconds": 96.96,
      "duration_seconds": 1.03,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.27,
      "end_seconds": 98.01,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 109.06,
      "duration_seconds": 3.29,
      "text": "Have you noticed fever, discharge or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.29,
      "end_seconds": 112.26,
      "duration_seconds": 1.97,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.32,
      "end_seconds": 120.74,
      "duration_seconds": 3.42,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.91,
      "end_seconds": 128.07,
      "duration_seconds": 6.16,
      "text": "I mean, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 131.6,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.38,
      "end_seconds": 136.51,
      "duration_seconds": 4.13,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 141.56,
      "duration_seconds": 4.17,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.12,
      "end_seconds": 146.92,
      "duration_seconds": 3.8,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.48,
      "end_seconds": 153.25,
      "duration_seconds": 4.77,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.91,
      "end_seconds": 163.64,
      "duration_seconds": 9.73,
      "text": "I had a reaction to naproxen when I was younger, stomach pain, and I've avoided it since."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.54,
      "end_seconds": 166.61,
      "duration_seconds": 2.07,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.0,
      "end_seconds": 170.57,
      "duration_seconds": 2.57,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.32,
      "end_seconds": 175.69,
      "duration_seconds": 4.37,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.57,
      "end_seconds": 179.13,
      "duration_seconds": 1.56,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.85,
      "end_seconds": 185.34,
      "duration_seconds": 3.49,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.66,
      "end_seconds": 194.18,
      "duration_seconds": 1.52,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.33,
      "end_seconds": 197.53,
      "duration_seconds": 2.2,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 217.8,
      "duration_seconds": 6.77,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.33,
      "end_seconds": 221.88,
      "duration_seconds": 1.55,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 262.15,
      "duration_seconds": 30.3,
      "text": "Let me tell you where I've got to. It fits best with a ruptured ectopic pregnancy. The reason I say that is that your story and my examination fit together. I want a pregnancy test done, that's for collapse. That will help us see what's going on underneath and decide the next step. I am calling the emergency team, you need an operation now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.58,
      "end_seconds": 269.56,
      "duration_seconds": 5.98,
      "text": "I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.35,
      "end_seconds": 272.05,
      "duration_seconds": 1.7,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.96,
      "end_seconds": 291.05,
      "duration_seconds": 17.09,
      "text": "Urgent blood tests is something we might do if this doesn't improve in two weeks. If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.07,
      "end_seconds": 293.92,
      "duration_seconds": 1.85,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.04,
      "end_seconds": 298.66,
      "duration_seconds": 3.62,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.01,
      "end_seconds": 303.7,
      "duration_seconds": 3.69,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}