{
  "schema_version": "1.0",
  "encounter_id": "03236",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 6.83,
      "duration_seconds": 5.9,
      "text": "Alright, come in, have a seat by the desk. Cold out there today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.65,
      "end_seconds": 11.17,
      "duration_seconds": 3.52,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.76,
      "end_seconds": 14.1,
      "duration_seconds": 1.34,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.2,
      "end_seconds": 21.83,
      "duration_seconds": 6.63,
      "text": "Honestly, it's pain in my breastbone wound, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.52,
      "end_seconds": 26.28,
      "duration_seconds": 3.76,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.12,
      "end_seconds": 34.59,
      "duration_seconds": 3.47,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 41.56,
      "duration_seconds": 6.52,
      "text": "Mm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.65,
      "end_seconds": 47.79,
      "duration_seconds": 4.14,
      "text": "Yeah, mostly mild. I'd say all the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.26,
      "end_seconds": 62.75,
      "duration_seconds": 2.49,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 72.46,
      "duration_seconds": 2.34,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.5,
      "end_seconds": 104.55,
      "duration_seconds": 14.05,
      "text": "Okay: weight 98 kilos, temp 36.8 degrees, pressure 112 over 74, saturation 98 percent, pulse is 86 beats a minute, height 171 centimetres, BMI works out to 33.5."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.31,
      "end_seconds": 110.76,
      "duration_seconds": 3.45,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.58,
      "end_seconds": 114.05,
      "duration_seconds": 2.47,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.32,
      "end_seconds": 135.12,
      "duration_seconds": 9.8,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.08,
      "end_seconds": 139.92,
      "duration_seconds": 1.84,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.3,
      "end_seconds": 159.7,
      "duration_seconds": 4.4,
      "text": "Any breathlessness, fever or chest pain on exertion at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.45,
      "end_seconds": 162.42,
      "duration_seconds": 1.97,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.29,
      "end_seconds": 165.39,
      "duration_seconds": 2.1,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.18,
      "end_seconds": 170.51,
      "duration_seconds": 3.33,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 187.1,
      "duration_seconds": 1.29,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.94,
      "end_seconds": 192.12,
      "duration_seconds": 3.18,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.79,
      "end_seconds": 194.1,
      "duration_seconds": 1.31,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.9,
      "end_seconds": 200.25,
      "duration_seconds": 4.35,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 203.86,
      "duration_seconds": 2.26,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.09,
      "end_seconds": 209.11,
      "duration_seconds": 4.02,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.18,
      "end_seconds": 212.51,
      "duration_seconds": 2.33,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.25,
      "end_seconds": 215.69,
      "duration_seconds": 2.44,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.3,
      "end_seconds": 221.47,
      "duration_seconds": 4.17,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.06,
      "end_seconds": 226.64,
      "duration_seconds": 3.58,
      "text": "I've had heart disease for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.39,
      "end_seconds": 238.87,
      "duration_seconds": 7.48,
      "text": "Alright, heart disease, that matches what I have here. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.65,
      "end_seconds": 247.4,
      "duration_seconds": 4.75,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.55,
      "end_seconds": 275.54,
      "duration_seconds": 12.99,
      "text": "Let me tell you where I've got to. This looks most like recovering well after bypass surgery. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.67,
      "end_seconds": 280.29,
      "duration_seconds": 3.62,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.25,
      "end_seconds": 313.9,
      "duration_seconds": 31.65,
      "text": "It's reasonable to be concerned, but right now recovering well after bypass surgery is my leading thought, not anything worse. I want an ECG done, that's for post-operative review. It's a routine test and it'll give us a much clearer picture. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. See me again in six weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.7,
      "end_seconds": 318.46,
      "duration_seconds": 3.76,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.63,
      "end_seconds": 321.04,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}