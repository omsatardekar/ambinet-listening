{
  "schema_version": "1.0",
  "encounter_id": "03389",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.5,
      "duration_seconds": 4.52,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 12.82,
      "duration_seconds": 5.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.03,
      "end_seconds": 22.42,
      "duration_seconds": 8.39,
      "text": "Um, so... sudden severe pain in the lower tummy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.34,
      "end_seconds": 27.56,
      "duration_seconds": 3.22,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 41.18,
      "duration_seconds": 2.44,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.71,
      "end_seconds": 68.84,
      "duration_seconds": 14.13,
      "text": "Okay: temperature 36.9, SpO2 97 percent on room air, pulse is 98 beats a minute, respiratory rate 19, BP is 101 over 62. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.4,
      "end_seconds": 71.53,
      "duration_seconds": 2.13,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.25,
      "end_seconds": 74.35,
      "duration_seconds": 2.1,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.67,
      "end_seconds": 83.05,
      "duration_seconds": 7.38,
      "text": "Hmm, it usually comes with collapsing. The collapsing? That's been for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.74,
      "end_seconds": 92.98,
      "duration_seconds": 8.24,
      "text": "Have you had sudden severe pain in the lower tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.82,
      "end_seconds": 101.99,
      "duration_seconds": 8.17,
      "text": "Um, um, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 105.34,
      "duration_seconds": 1.47,
      "text": "nothing like fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.09,
      "end_seconds": 110.91,
      "duration_seconds": 3.82,
      "text": "Yeah, not at all, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.3,
      "end_seconds": 116.19,
      "duration_seconds": 3.89,
      "text": "Let me check a few things. Any discharge or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 122.22,
      "duration_seconds": 4.15,
      "text": "no, uh, none that I've noticed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.01,
      "end_seconds": 125.18,
      "duration_seconds": 2.17,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.81,
      "end_seconds": 128.75,
      "duration_seconds": 1.94,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.18,
      "end_seconds": 132.17,
      "duration_seconds": 1.99,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.2,
      "end_seconds": 135.77,
      "duration_seconds": 2.57,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.35,
      "end_seconds": 147.39,
      "duration_seconds": 2.04,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.37,
      "end_seconds": 166.97,
      "duration_seconds": 18.6,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago. I didn't want to bother you but it keeps coming back. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.23,
      "end_seconds": 172.64,
      "duration_seconds": 4.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.06,
      "end_seconds": 175.8,
      "duration_seconds": 1.74,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.87,
      "end_seconds": 181.62,
      "duration_seconds": 3.75,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.78,
      "end_seconds": 186.45,
      "duration_seconds": 3.67,
      "text": "I'm on hydrocortisone cream, when needed"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 187.66,
      "duration_seconds": 0.7,
      "text": "ah"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.33,
      "end_seconds": 193.58,
      "duration_seconds": 4.25,
      "text": "I take propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.98,
      "end_seconds": 197.02,
      "duration_seconds": 2.04,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 200.65,
      "duration_seconds": 1.58,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.07,
      "end_seconds": 205.68,
      "duration_seconds": 3.61,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.88,
      "end_seconds": 208.98,
      "duration_seconds": 2.1,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.17,
      "end_seconds": 212.38,
      "duration_seconds": 2.21,
      "text": "Right, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.01,
      "end_seconds": 215.76,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 218.08,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.85,
      "end_seconds": 221.83,
      "duration_seconds": 2.98,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.73,
      "end_seconds": 229.18,
      "duration_seconds": 3.45,
      "text": "okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.83,
      "end_seconds": 236.7,
      "duration_seconds": 5.87,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.85,
      "end_seconds": 240.97,
      "duration_seconds": 3.12,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.46,
      "end_seconds": 245.61,
      "duration_seconds": 3.15,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 250.32,
      "duration_seconds": 3.5,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.46,
      "end_seconds": 255.11,
      "duration_seconds": 3.65,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.57,
      "end_seconds": 266.44,
      "duration_seconds": 3.87,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.67,
      "end_seconds": 270.2,
      "duration_seconds": 2.53,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.13,
      "end_seconds": 273.83,
      "duration_seconds": 2.7,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.21,
      "end_seconds": 276.3,
      "duration_seconds": 1.09,
      "text": "Yes, migraines."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.37,
      "end_seconds": 281.05,
      "duration_seconds": 3.68,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 284.4,
      "duration_seconds": 1.37,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.88,
      "end_seconds": 304.22,
      "duration_seconds": 6.34,
      "text": "you are pale and clammy with a rigid, tender tummy and a very low blood pressure"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.96,
      "end_seconds": 316.01,
      "duration_seconds": 9.05,
      "text": "You can relax now. So, based on the history and the examination, it fits best with a ruptured ectopic pregnancy."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.53,
      "end_seconds": 319.18,
      "duration_seconds": 1.65,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.51,
      "end_seconds": 328.43,
      "duration_seconds": 7.92,
      "text": "I can't promise yet, but most people with a ruptured ectopic pregnancy do well once it's treated properly"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.56,
      "end_seconds": 346.38,
      "duration_seconds": 3.82,
      "text": "I'll request a pregnancy test, it'll help with collapse"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 347.8,
      "end_seconds": 351.27,
      "duration_seconds": 3.47,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.09,
      "end_seconds": 369.23,
      "duration_seconds": 17.14,
      "text": "I am calling the emergency team, you need an operation now. I'll also refer you to the emergency team. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.96,
      "end_seconds": 374.16,
      "duration_seconds": 3.2,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.96,
      "end_seconds": 377.72,
      "duration_seconds": 1.76,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.54,
      "end_seconds": 380.78,
      "duration_seconds": 2.24,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.54,
      "end_seconds": 387.01,
      "duration_seconds": 4.47,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.46,
      "end_seconds": 392.94,
      "duration_seconds": 4.48,
      "text": "ah, great, thank you for your help"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.98,
      "end_seconds": 396.27,
      "duration_seconds": 1.29,
      "text": "take care now"
    }
  ]
}