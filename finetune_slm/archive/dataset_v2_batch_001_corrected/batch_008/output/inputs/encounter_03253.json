  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 7.75,
      "duration_seconds": 6.94,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 13.19,
      "duration_seconds": 4.31,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.05,
      "end_seconds": 19.75,
      "duration_seconds": 4.7,
      "text": "Let me think, I'm here because of severe back pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.08,
      "end_seconds": 23.76,
      "duration_seconds": 2.68,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.97,
      "end_seconds": 28.72,
      "duration_seconds": 3.75,
      "text": "Hmm, it's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.01,
      "end_seconds": 32.7,
      "duration_seconds": 3.69,
      "text": "Hm, okay. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.75,
      "end_seconds": 35.55,
      "duration_seconds": 1.8,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.54,
      "end_seconds": 41.57,
      "duration_seconds": 5.03,
      "text": "And what about weight loss, chest pain or recent fall?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.02,
      "end_seconds": 48.52,
      "duration_seconds": 2.5,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.03,
      "end_seconds": 51.15,
      "duration_seconds": 2.12,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.44,
      "end_seconds": 53.95,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.15,
      "end_seconds": 66.06,
      "duration_seconds": 3.91,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.08,
      "end_seconds": 69.4,
      "duration_seconds": 2.32,
      "text": "It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 84.79,
      "duration_seconds": 2.86,
      "text": "Okay, do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.83,
      "end_seconds": 90.46,
      "duration_seconds": 4.63,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.48,
      "end_seconds": 93.97,
      "duration_seconds": 2.49,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.35,
      "end_seconds": 98.56,
      "duration_seconds": 3.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.95,
      "end_seconds": 115.25,
      "duration_seconds": 4.3,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.32,
      "end_seconds": 121.36,
      "duration_seconds": 5.04,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.19,
      "end_seconds": 127.13,
      "duration_seconds": 3.94,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.05,
      "end_seconds": 131.1,
      "duration_seconds": 2.05,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.9,
      "end_seconds": 135.01,
      "duration_seconds": 3.11,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.09,
      "end_seconds": 147.76,
      "duration_seconds": 2.67,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.5,
      "end_seconds": 179.68,
      "duration_seconds": 10.18,
      "text": "Okay: pulse 101, BP is 110 over 69, oxygen saturation is 97 percent, temperature is 39.3 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.26,
      "end_seconds": 185.73,
      "duration_seconds": 4.47,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.38,
      "end_seconds": 189.46,
      "duration_seconds": 2.08,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.1,
      "end_seconds": 209.45,
      "duration_seconds": 6.35,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.26,
      "end_seconds": 217.29,
      "duration_seconds": 2.03,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.18,
      "end_seconds": 243.95,
      "duration_seconds": 8.77,
      "text": "Okay, so my impression is this: The most likely explanation is a possible spinal infection pressing on the nerves."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.59,
      "end_seconds": 248.26,
      "duration_seconds": 3.67,
      "text": "Hmm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.99,
      "end_seconds": 281.77,
      "duration_seconds": 32.78,
      "text": "It's reasonable to be concerned, but right now a possible spinal infection pressing on the nerves is my leading thought, not anything worse. I'm going to order urgent blood tests, for possible spinal infection. You are going to hospital now, this can cause permanent weakness. An urgent MRI of the spine is something we might do if this doesn't improve in two weeks. Come back straight away."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.57,
      "end_seconds": 285.85,
      "duration_seconds": 2.28,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.76,
      "end_seconds": 293.23,
      "duration_seconds": 5.47,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.2,
      "end_seconds": 297.06,
      "duration_seconds": 2.86,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.46,
      "end_seconds": 300.85,
      "duration_seconds": 2.39,
      "text": "So, have a good day."
    }
  ]
}