{
  "schema_version": "1.0",
  "encounter_id": "03141",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.56,
      "duration_seconds": 2.93,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.08,
      "end_seconds": 8.14,
      "duration_seconds": 4.06,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.11,
      "end_seconds": 15.77,
      "duration_seconds": 6.66,
      "text": "Oh, you know, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.67,
      "end_seconds": 20.39,
      "duration_seconds": 2.72,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.56,
      "end_seconds": 40.07,
      "duration_seconds": 18.51,
      "text": "Honestly, it's flakes on my shoulders, and my family pushed me to come. I wasn't sure whether to come in at all, to be honest. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.63,
      "end_seconds": 42.57,
      "duration_seconds": 1.94,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 56.05,
      "duration_seconds": 11.78,
      "text": "Ah, it's been like this since Monday. Right, I've also had an itchy scalp. About itchy scalp, it's once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.28,
      "end_seconds": 64.66,
      "duration_seconds": 4.38,
      "text": "Right, have you noticed pain, rash elsewhere or pus?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.89,
      "end_seconds": 69.67,
      "duration_seconds": 3.78,
      "text": "Okay, so no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.28,
      "end_seconds": 75.22,
      "duration_seconds": 1.94,
      "text": "How about hair loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.76,
      "end_seconds": 80.19,
      "duration_seconds": 4.43,
      "text": "Mm, um, not at all, no hair loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.54,
      "end_seconds": 83.99,
      "duration_seconds": 2.45,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.6,
      "end_seconds": 88.53,
      "duration_seconds": 3.93,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.09,
      "end_seconds": 92.32,
      "duration_seconds": 3.23,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.61,
      "end_seconds": 102.84,
      "duration_seconds": 5.23,
      "text": "Ah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.84,
      "end_seconds": 111.72,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.75,
      "end_seconds": 117.49,
      "duration_seconds": 3.74,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.74,
      "end_seconds": 121.16,
      "duration_seconds": 2.42,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.39,
      "end_seconds": 127.96,
      "duration_seconds": 5.57,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.78,
      "end_seconds": 132.53,
      "duration_seconds": 2.75,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.72,
      "end_seconds": 141.32,
      "duration_seconds": 3.6,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.72,
      "end_seconds": 144.81,
      "duration_seconds": 2.09,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.72,
      "end_seconds": 149.34,
      "duration_seconds": 2.62,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.34,
      "end_seconds": 168.04,
      "duration_seconds": 3.7,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.89,
      "end_seconds": 170.53,
      "duration_seconds": 1.64,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.69,
      "end_seconds": 184.48,
      "duration_seconds": 1.79,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.01,
      "end_seconds": 190.35,
      "duration_seconds": 5.34,
      "text": "Um, uh, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.83,
      "end_seconds": 196.43,
      "duration_seconds": 3.6,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.69,
      "end_seconds": 201.9,
      "duration_seconds": 4.21,
      "text": "An anti-dandruff shampoo. I take it twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 205.83,
      "duration_seconds": 3.23,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.02,
      "end_seconds": 215.06,
      "duration_seconds": 3.04,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.35,
      "end_seconds": 242.75,
      "duration_seconds": 9.4,
      "text": "Okay: BP is 121 over 68, temp 36.7 degrees, SpO2 99 percent on room air, respiratory rate 16, heart rate 66."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.14,
      "end_seconds": 246.25,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.65,
      "end_seconds": 250.04,
      "duration_seconds": 2.39,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.79,
      "end_seconds": 256.07,
      "duration_seconds": 4.28,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.03,
      "end_seconds": 258.45,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.14,
      "end_seconds": 275.85,
      "duration_seconds": 5.71,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.33,
      "end_seconds": 279.99,
      "duration_seconds": 1.66,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.63,
      "end_seconds": 297.4,
      "duration_seconds": 9.77,
      "text": "Okay, thinking it through, it points towards simple dandruff. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.34,
      "end_seconds": 301.9,
      "duration_seconds": 3.56,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 335.07,
      "duration_seconds": 31.46,
      "text": "I understand the worry. At the moment I'd say it's simple dandruff, and we'll watch how it goes. You'll be taking ketoconazole shampoo, 2%, twice a week, four weeks. It's for dandruff. Leave the shampoo on for five minutes before rinsing. Do get help quickly if the symptoms get worse. We'll catch up if not better in a month. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.81,
      "end_seconds": 339.71,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.05,
      "end_seconds": 345.47,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}