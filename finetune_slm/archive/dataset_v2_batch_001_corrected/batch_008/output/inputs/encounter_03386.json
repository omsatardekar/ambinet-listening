{
  "schema_version": "1.0",
  "encounter_id": "03386",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 6.51,
      "duration_seconds": 5.71,
      "text": "um, hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.14,
      "end_seconds": 12.33,
      "duration_seconds": 4.19,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 32.02,
      "duration_seconds": 18.67,
      "text": "I mean, um, I've been feeling faint, and I wanted to get it checked. I thought it would sort itself out, but it hasn't. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.07,
      "end_seconds": 37.21,
      "duration_seconds": 3.14,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.02,
      "end_seconds": 39.98,
      "duration_seconds": 1.96,
      "text": "about... well, three weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.98,
      "end_seconds": 46.75,
      "duration_seconds": 4.77,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.72,
      "end_seconds": 61.61,
      "duration_seconds": 13.89,
      "text": "Moderate, really. Honestly, a couple of times a week. I told myself I'd wait and see, and here I am. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.68,
      "end_seconds": 77.51,
      "duration_seconds": 2.83,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.73,
      "end_seconds": 79.87,
      "duration_seconds": 1.14,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.95,
      "end_seconds": 85.84,
      "duration_seconds": 4.89,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.44,
      "end_seconds": 91.68,
      "duration_seconds": 2.24,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.75,
      "end_seconds": 96.56,
      "duration_seconds": 2.81,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.05,
      "end_seconds": 102.16,
      "duration_seconds": 4.11,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.87,
      "end_seconds": 105.83,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.9,
      "end_seconds": 110.53,
      "duration_seconds": 2.63,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.16,
      "end_seconds": 131.37,
      "duration_seconds": 4.21,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.09,
      "end_seconds": 134.81,
      "duration_seconds": 1.72,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.33,
      "end_seconds": 144.72,
      "duration_seconds": 4.39,
      "text": "And what about fever, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.22,
      "end_seconds": 148.57,
      "duration_seconds": 2.35,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.1,
      "end_seconds": 151.74,
      "duration_seconds": 1.64,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.05,
      "end_seconds": 154.72,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.35,
      "end_seconds": 161.77,
      "duration_seconds": 4.42,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.54,
      "end_seconds": 165.66,
      "duration_seconds": 2.12,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.67,
      "end_seconds": 182.37,
      "duration_seconds": 5.7,
      "text": "You are pale, breathing fast and and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.6,
      "end_seconds": 188.26,
      "duration_seconds": 1.66,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 210.39,
      "duration_seconds": 4.27,
      "text": "Putting it all together, this looks most like life-threatening haemoptysis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.5,
      "end_seconds": 215.05,
      "duration_seconds": 3.55,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.74,
      "end_seconds": 224.33,
      "duration_seconds": 7.59,
      "text": "nothing I've seen today points to an emergency it looks like life-threatening haemoptysis, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 241.46,
      "duration_seconds": 4.35,
      "text": "I'm going to order urgent blood tests, for bleeding."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 242.39,
      "end_seconds": 245.54,
      "duration_seconds": 3.15,
      "text": "The earliest is Wednesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 252.26,
      "duration_seconds": 4.8,
      "text": "I'll request an urgent CT scan, it'll help with massive haemoptysis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.6,
      "end_seconds": 256.31,
      "duration_seconds": 2.71,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.9,
      "end_seconds": 278.64,
      "duration_seconds": 20.74,
      "text": "You'll be taking tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.39,
      "end_seconds": 283.31,
      "duration_seconds": 2.92,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.36,
      "end_seconds": 294.42,
      "duration_seconds": 9.06,
      "text": "I'd like to see you again straight away let me check I've been clear what will you do once you get home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.49,
      "end_seconds": 304.65,
      "duration_seconds": 9.16,
      "text": "So, I take the tranexamic acid, 1 gram, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.38,
      "end_seconds": 310.39,
      "duration_seconds": 4.01,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.31,
      "end_seconds": 317.26,
      "duration_seconds": 4.95,
      "text": "Let me think, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.34,
      "end_seconds": 324.73,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}