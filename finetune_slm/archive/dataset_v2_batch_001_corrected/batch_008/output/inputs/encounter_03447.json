{
  "schema_version": "1.0",
  "encounter_id": "03447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.0,
      "duration_seconds": 2.8,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.81,
      "end_seconds": 9.22,
      "duration_seconds": 4.41,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.98,
      "end_seconds": 13.24,
      "duration_seconds": 3.26,
      "text": "So, I've been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.04,
      "end_seconds": 18.27,
      "duration_seconds": 3.23,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.11,
      "end_seconds": 30.42,
      "duration_seconds": 10.31,
      "text": "Around ten days... no wait, it's more like two days. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.04,
      "end_seconds": 35.07,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 38.34,
      "duration_seconds": 2.07,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.95,
      "end_seconds": 42.81,
      "duration_seconds": 2.86,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.23,
      "end_seconds": 46.27,
      "duration_seconds": 2.04,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.55,
      "end_seconds": 62.52,
      "duration_seconds": 2.97,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.03,
      "end_seconds": 77.37,
      "duration_seconds": 2.34,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 107.1,
      "duration_seconds": 10.51,
      "text": "Okay: temp 37.4 degrees, oxygen saturation is 92 percent, pulse is 97 beats a minute, blood pressure 119 over 77, respiratory rate 25."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.18,
      "end_seconds": 111.28,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.38,
      "end_seconds": 117.17,
      "duration_seconds": 3.79,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.79,
      "end_seconds": 123.73,
      "duration_seconds": 3.94,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.44,
      "end_seconds": 128.33,
      "duration_seconds": 2.89,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.48,
      "end_seconds": 144.17,
      "duration_seconds": 5.69,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.8,
      "end_seconds": 154.91,
      "duration_seconds": 1.11,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.13,
      "end_seconds": 160.72,
      "duration_seconds": 2.59,
      "text": "So, you can sit up now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 181.0,
      "duration_seconds": 4.03,
      "text": "So, a few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.45,
      "end_seconds": 186.92,
      "duration_seconds": 4.47,
      "text": "I haven't had chest pain or fever, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.73,
      "end_seconds": 190.15,
      "duration_seconds": 2.42,
      "text": "Have you had any weight loss?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.87,
      "end_seconds": 192.88,
      "duration_seconds": 2.01,
      "text": "Definitely no weight loss."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.94,
      "end_seconds": 200.71,
      "duration_seconds": 3.77,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.97,
      "end_seconds": 204.43,
      "duration_seconds": 2.46,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.26,
      "end_seconds": 224.19,
      "duration_seconds": 4.93,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.14,
      "end_seconds": 227.37,
      "duration_seconds": 2.23,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.88,
      "end_seconds": 230.67,
      "duration_seconds": 2.79,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.41,
      "end_seconds": 232.95,
      "duration_seconds": 1.54,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.7,
      "end_seconds": 243.06,
      "duration_seconds": 9.36,
      "text": "Hm, okay. Yes, diabetes is known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.59,
      "end_seconds": 246.62,
      "duration_seconds": 3.03,
      "text": "Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 249.42,
      "duration_seconds": 2.27,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 255.08,
      "duration_seconds": 4.63,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.03,
      "end_seconds": 257.32,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.94,
      "end_seconds": 261.69,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.15,
      "end_seconds": 265.79,
      "duration_seconds": 2.64,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.77,
      "end_seconds": 269.71,
      "duration_seconds": 2.94,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.47,
      "end_seconds": 279.38,
      "duration_seconds": 8.91,
      "text": "Having listened and examined, the most likely explanation is life-threatening haemoptysis. Let's book urgent blood tests to look into bleeding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.51,
      "end_seconds": 282.0,
      "duration_seconds": 1.49,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.54,
      "end_seconds": 296.45,
      "duration_seconds": 12.91,
      "text": "Let's use tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. See me again straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.53,
      "end_seconds": 301.59,
      "duration_seconds": 3.06,
      "text": "Alright, you know, I'll be back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.33,
      "end_seconds": 307.98,
      "duration_seconds": 4.65,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.17,
      "end_seconds": 312.53,
      "duration_seconds": 3.36,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.35,
      "end_seconds": 314.69,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}