{
  "schema_version": "1.0",
  "encounter_id": "03149",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 7.56,
      "duration_seconds": 6.56,
      "text": "So, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 12.42,
      "duration_seconds": 3.54,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.16,
      "end_seconds": 17.08,
      "duration_seconds": 3.92,
      "text": "I've been dealing with shivering that has stopped."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.79,
      "end_seconds": 20.37,
      "duration_seconds": 1.58,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.43,
      "end_seconds": 29.35,
      "duration_seconds": 7.92,
      "text": "I'd say ten days. Actually, uh, no, closer to to three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.38,
      "end_seconds": 33.6,
      "duration_seconds": 3.22,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.14,
      "end_seconds": 41.53,
      "duration_seconds": 6.39,
      "text": "Severe, I'd say. I've also had slurred speech, since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.82,
      "end_seconds": 49.24,
      "duration_seconds": 3.42,
      "text": "Have you had being found cold and drowsy?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.37,
      "end_seconds": 51.69,
      "duration_seconds": 1.32,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.19,
      "end_seconds": 55.62,
      "duration_seconds": 2.43,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.44,
      "end_seconds": 78.0,
      "duration_seconds": 21.56,
      "text": "I've, I've had migraines for about ten years now. Mm, uh, I have gout, for two years. I looked a few things up online, and that probably didn't help. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.42,
      "end_seconds": 91.08,
      "duration_seconds": 11.66,
      "text": "I follow. Yes, migraines and gout are known to us, good to to have that clear. Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.59,
      "end_seconds": 93.74,
      "duration_seconds": 1.15,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.26,
      "end_seconds": 98.94,
      "duration_seconds": 3.68,
      "text": "right, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.76,
      "end_seconds": 123.62,
      "duration_seconds": 20.86,
      "text": "I used to drink heavily but I stopped four years ago. I'm a hairdresser, on my feet all day. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.42,
      "end_seconds": 127.57,
      "duration_seconds": 2.15,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.47,
      "end_seconds": 135.98,
      "duration_seconds": 6.51,
      "text": "Erm, I'm on sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.42,
      "end_seconds": 139.51,
      "duration_seconds": 2.09,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.26,
      "end_seconds": 157.48,
      "duration_seconds": 16.22,
      "text": "About a month now sorry, what was I saying, I take allopurinol, 100 milligrams, once a day my sister suggested writing things down, but I forgot"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.13,
      "end_seconds": 170.05,
      "duration_seconds": 2.92,
      "text": "Any head injury, alcohol or fall?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.79,
      "end_seconds": 175.56,
      "duration_seconds": 4.77,
      "text": "well, no, no head injury, alcohol or fall"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.81,
      "end_seconds": 178.93,
      "duration_seconds": 2.12,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.64,
      "end_seconds": 183.87,
      "duration_seconds": 3.23,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.47,
      "end_seconds": 203.59,
      "duration_seconds": 4.12,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.77,
      "end_seconds": 212.74,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.58,
      "end_seconds": 243.84,
      "duration_seconds": 9.26,
      "text": "Okay: temperature 36.7, pressure 128 over 76, respiratory rate 16, pulse is 64 beats a minute, saturation 98 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.34,
      "end_seconds": 246.81,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.61,
      "end_seconds": 251.2,
      "duration_seconds": 3.59,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.22,
      "end_seconds": 256.25,
      "duration_seconds": 4.03,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.96,
      "end_seconds": 257.99,
      "duration_seconds": 1.03,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.12,
      "end_seconds": 262.23,
      "duration_seconds": 3.11,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.72,
      "end_seconds": 281.01,
      "duration_seconds": 7.29,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.47,
      "end_seconds": 291.0,
      "duration_seconds": 6.53,
      "text": "Okay, that's enough for me. Having listened and examined, this is probably severe hypothermia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.88,
      "end_seconds": 297.51,
      "duration_seconds": 5.63,
      "text": "I mean, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.85,
      "end_seconds": 306.82,
      "duration_seconds": 7.97,
      "text": "I understand the worry. At the moment I'd say it's severe hypothermia, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.09,
      "end_seconds": 324.81,
      "duration_seconds": 10.72,
      "text": "Handle gently and warm slowly with warm blankets and warm fluids through the drip. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.44,
      "end_seconds": 330.59,
      "duration_seconds": 5.15,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.14,
      "end_seconds": 332.42,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}