{
  "schema_version": "1.0",
  "encounter_id": "03110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.28,
      "duration_seconds": 4.18,
      "text": "Actually, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 10.97,
      "duration_seconds": 3.65,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.56,
      "end_seconds": 17.65,
      "duration_seconds": 5.09,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.02,
      "end_seconds": 26.11,
      "duration_seconds": 3.09,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.27,
      "end_seconds": 30.75,
      "duration_seconds": 3.48,
      "text": "Well, I've been having shortness of breath."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.47,
      "end_seconds": 33.95,
      "duration_seconds": 1.48,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.75,
      "end_seconds": 39.63,
      "duration_seconds": 3.88,
      "text": "Since last weekend, that's when it began"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 43.74,
      "duration_seconds": 2.05,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.8,
      "end_seconds": 48.09,
      "duration_seconds": 3.29,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.2,
      "end_seconds": 51.29,
      "duration_seconds": 2.09,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.14,
      "end_seconds": 56.11,
      "duration_seconds": 2.97,
      "text": "Lying flat definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.64,
      "end_seconds": 59.43,
      "duration_seconds": 2.79,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.69,
      "end_seconds": 68.05,
      "duration_seconds": 7.36,
      "text": "Well, uh, it's... hard to say, it's kinda... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.79,
      "end_seconds": 74.64,
      "duration_seconds": 5.85,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.96,
      "end_seconds": 77.43,
      "duration_seconds": 1.47,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.89,
      "end_seconds": 86.24,
      "duration_seconds": 8.35,
      "text": "Yeah, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 86.34,
      "end_seconds": 91.7,
      "duration_seconds": 5.36,
      "text": "Actually, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.33,
      "end_seconds": 100.49,
      "duration_seconds": 7.16,
      "text": "I was getting to that! Oh, and a racing heart had that since Monday"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.39,
      "end_seconds": 108.56,
      "duration_seconds": 6.17,
      "text": "have you had shortness of breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.06,
      "end_seconds": 117.46,
      "duration_seconds": 5.4,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 118.44,
      "end_seconds": 131.18,
      "duration_seconds": 12.74,
      "text": "Doctor, I've got the readings for you. Pulse is 93 beats a minute, oxygen saturation is 96 percent, temp 37.0 degrees, height 162 centimetres, weight 77 kilos, pressure 94 over 61."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.4,
      "end_seconds": 133.35,
      "duration_seconds": 0.95,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.88,
      "end_seconds": 140.72,
      "duration_seconds": 4.84,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.62,
      "end_seconds": 144.58,
      "duration_seconds": 2.96,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.07,
      "end_seconds": 167.06,
      "duration_seconds": 6.99,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.13,
      "end_seconds": 179.0,
      "duration_seconds": 6.87,
      "text": "Good, you can sit up again. And what about cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.97,
      "end_seconds": 193.16,
      "duration_seconds": 12.19,
      "text": "Right, no, no cough, no leg swelling, no fever. I was feeling faint at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.72,
      "end_seconds": 196.12,
      "duration_seconds": 2.4,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.44,
      "end_seconds": 199.93,
      "duration_seconds": 2.49,
      "text": "Yeah, no, skin's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.97,
      "end_seconds": 205.5,
      "duration_seconds": 4.53,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.49,
      "end_seconds": 208.61,
      "duration_seconds": 2.12,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.26,
      "end_seconds": 220.5,
      "duration_seconds": 1.24,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.8,
      "end_seconds": 225.84,
      "duration_seconds": 4.04,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.84,
      "end_seconds": 229.82,
      "duration_seconds": 1.98,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.41,
      "end_seconds": 234.53,
      "duration_seconds": 4.12,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.42,
      "end_seconds": 240.8,
      "duration_seconds": 4.38,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.48,
      "end_seconds": 245.08,
      "duration_seconds": 3.6,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 251.17,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.32,
      "end_seconds": 256.1,
      "duration_seconds": 3.78,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.64,
      "end_seconds": 262.14,
      "duration_seconds": 4.5,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.0,
      "end_seconds": 265.61,
      "duration_seconds": 2.61,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.42,
      "end_seconds": 269.37,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.4,
      "end_seconds": 277.76,
      "duration_seconds": 7.36,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.99,
      "end_seconds": 281.66,
      "duration_seconds": 2.67,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.88,
      "end_seconds": 298.42,
      "duration_seconds": 15.54,
      "text": "For the anxiety, I believe. My husband sets them out for me, I just take what I'm given. Propranolol. I take it 40 milligrams, maybe, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.52,
      "end_seconds": 303.8,
      "duration_seconds": 4.28,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.83,
      "end_seconds": 308.91,
      "duration_seconds": 3.08,
      "text": "Erm, no, it's at home."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.96,
      "end_seconds": 314.82,
      "duration_seconds": 4.86,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.43,
      "end_seconds": 324.22,
      "duration_seconds": 7.79,
      "text": "Ah, years back I got a rash from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.3,
      "end_seconds": 327.68,
      "duration_seconds": 2.38,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.68,
      "end_seconds": 348.55,
      "duration_seconds": 18.87,
      "text": "I have anxiety, for nearly five years. I have migraines, for about a year. I've been reading about it online and it worried me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.1,
      "end_seconds": 364.55,
      "duration_seconds": 2.45,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.22,
      "end_seconds": 366.98,
      "duration_seconds": 1.76,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.62,
      "end_seconds": 380.99,
      "duration_seconds": 13.37,
      "text": "Having listened and examined, it it fits best with possible cardiac tamponade. A heart attack is also on my list. I want an urgent echocardiogram done, that's for possible tamponade."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 382.64,
      "end_seconds": 385.79,
      "duration_seconds": 3.15,
      "text": "The earliest is Wednesday, 11:30 am."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.85,
      "end_seconds": 409.09,
      "duration_seconds": 19.24,
      "text": "Let's get an ECG, for chest pain. You need an urgent heart scan and possibly a drain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.17,
      "end_seconds": 413.48,
      "duration_seconds": 2.31,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.48,
      "end_seconds": 416.65,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}