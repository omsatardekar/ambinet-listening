{
  "schema_version": "1.0",
  "encounter_id": "03282",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.09,
      "duration_seconds": 4.15,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 10.81,
      "duration_seconds": 3.95,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.72,
      "end_seconds": 17.75,
      "duration_seconds": 5.03,
      "text": "Ah, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.32,
      "end_seconds": 23.74,
      "duration_seconds": 4.42,
      "text": "I've been coughing up large amounts of blood."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.45,
      "end_seconds": 29.06,
      "duration_seconds": 3.61,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.58,
      "end_seconds": 33.75,
      "duration_seconds": 3.17,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.96,
      "end_seconds": 38.44,
      "duration_seconds": 4.48,
      "text": "Okay, go on. So, how frequently does it come?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.46,
      "end_seconds": 46.84,
      "duration_seconds": 6.38,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.89,
      "end_seconds": 54.49,
      "duration_seconds": 6.6,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.91,
      "end_seconds": 58.59,
      "duration_seconds": 2.68,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.24,
      "end_seconds": 66.29,
      "duration_seconds": 7.05,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 66.39,
      "end_seconds": 72.69,
      "duration_seconds": 6.3,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.36,
      "end_seconds": 78.72,
      "duration_seconds": 4.36,
      "text": "Later, thanks. Please go on. Have you had breathlessness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.68,
      "end_seconds": 94.45,
      "duration_seconds": 14.77,
      "text": "Yes, for two days. I've been feeling faint too, for about a week. I did have a gurgling chest at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.54,
      "end_seconds": 98.95,
      "duration_seconds": 2.41,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.98,
      "end_seconds": 107.27,
      "duration_seconds": 6.29,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.62,
      "end_seconds": 113.86,
      "duration_seconds": 5.24,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.07,
      "end_seconds": 128.26,
      "duration_seconds": 13.19,
      "text": "No, I've never smoked in my life. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.41,
      "end_seconds": 148.98,
      "duration_seconds": 3.57,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.1,
      "end_seconds": 153.03,
      "duration_seconds": 2.93,
      "text": "Paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.35,
      "end_seconds": 162.09,
      "duration_seconds": 7.74,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.82,
      "end_seconds": 166.4,
      "duration_seconds": 2.58,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.19,
      "end_seconds": 180.57,
      "duration_seconds": 13.38,
      "text": "For the seizures, I believe. My wife sets them out for me, I just take what I'm given. I was on mirtazapine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.2,
      "end_seconds": 186.08,
      "duration_seconds": 4.88,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 194.37,
      "duration_seconds": 6.53,
      "text": "Not currently, uh, but as a youngster erythromycin gave me a rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.82,
      "end_seconds": 206.84,
      "duration_seconds": 5.02,
      "text": "Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.02,
      "end_seconds": 210.91,
      "duration_seconds": 2.89,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.12,
      "end_seconds": 213.33,
      "duration_seconds": 1.21,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.57,
      "end_seconds": 216.15,
      "duration_seconds": 1.58,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.11,
      "end_seconds": 218.34,
      "duration_seconds": 1.23,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.67,
      "end_seconds": 223.21,
      "duration_seconds": 3.54,
      "text": "I've had epilepsy for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.32,
      "end_seconds": 225.5,
      "duration_seconds": 1.18,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.65,
      "end_seconds": 232.23,
      "duration_seconds": 5.58,
      "text": "Let me check a few things. Any fever, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.73,
      "end_seconds": 236.9,
      "duration_seconds": 3.17,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 240.94,
      "duration_seconds": 3.46,
      "text": "Yes. And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.29,
      "end_seconds": 243.36,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.07,
      "end_seconds": 249.24,
      "duration_seconds": 4.17,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.98,
      "end_seconds": 253.75,
      "duration_seconds": 3.77,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 254.96,
      "end_seconds": 269.28,
      "duration_seconds": 14.32,
      "text": "Doctor, I've got the readings for you. BP is 137 over 88, weight 63 kilos. Pulse 88, respiratory rate 26, height 164 centimetres, oxygen saturation is 89 percent, BMI works out to 23.4."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.05,
      "end_seconds": 272.14,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.06,
      "end_seconds": 276.04,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.23,
      "end_seconds": 278.54,
      "duration_seconds": 1.31,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.55,
      "end_seconds": 293.31,
      "duration_seconds": 5.76,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.25,
      "end_seconds": 323.82,
      "duration_seconds": 25.57,
      "text": "Thank you, you can get dressed. Putting it all together, I think we're dealing with life-threatening haemoptysis at this stage. We shouldn't forget a pulmonary embolus. I can't rule out a lung tumour yet. I'm going to order urgent blood tests, for bleeding. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 324.47,
      "end_seconds": 328.1,
      "duration_seconds": 3.63,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.9,
      "end_seconds": 356.39,
      "duration_seconds": 26.49,
      "text": "I'd like to arrange an urgent CT scan for massive haemoptysis. You'll be taking tranexamic acid, 1 gram, now, single dose. That should help with haemoptysis. Lie on the bleeding side and I am calling the emergency team. I'd like you back straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.08,
      "end_seconds": 367.87,
      "duration_seconds": 10.79,
      "text": "So, I take the tranexamic acid, 1 gram, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.0,
      "end_seconds": 375.5,
      "duration_seconds": 6.5,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.37,
      "end_seconds": 380.11,
      "duration_seconds": 3.74,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}