{
  "schema_version": "1.0",
  "encounter_id": "03148",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 11.35,
      "duration_seconds": 10.57,
      "text": "Sorry, um, what was I saying, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.61,
      "end_seconds": 22.35,
      "duration_seconds": 4.74,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.1,
      "end_seconds": 26.11,
      "duration_seconds": 3.01,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.43,
      "end_seconds": 29.95,
      "duration_seconds": 2.52,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.95,
      "end_seconds": 43.36,
      "duration_seconds": 11.41,
      "text": "Yeah, you know, it's shortness of breath. I don't know what's causing it. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.12,
      "end_seconds": 48.38,
      "duration_seconds": 3.26,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.44,
      "end_seconds": 50.6,
      "duration_seconds": 1.16,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.62,
      "end_seconds": 54.18,
      "duration_seconds": 2.56,
      "text": "Any a racing heart as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.09,
      "end_seconds": 56.27,
      "duration_seconds": 1.18,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.91,
      "end_seconds": 63.95,
      "duration_seconds": 3.04,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.34,
      "end_seconds": 78.34,
      "duration_seconds": 13.0,
      "text": "Pretty mild, if I'm being honest. Oh, and chest pain. That's been about the same, two months. About chest pain, I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.4,
      "end_seconds": 87.57,
      "duration_seconds": 5.17,
      "text": "Have you had shortness of breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.26,
      "end_seconds": 100.72,
      "duration_seconds": 11.46,
      "text": "Okay, so yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.34,
      "end_seconds": 105.24,
      "duration_seconds": 3.9,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.63,
      "end_seconds": 117.72,
      "duration_seconds": 11.09,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 135.27,
      "duration_seconds": 4.17,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.22,
      "end_seconds": 144.88,
      "duration_seconds": 7.66,
      "text": "I've got anxiety. Ah, I've had an enlarged prostate, yes. I've got epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.9,
      "end_seconds": 160.17,
      "duration_seconds": 13.27,
      "text": "I see, go ahead. Right, so epilepsy is already on your record. We'll keep that in mind today. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 178.14,
      "duration_seconds": 17.09,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. I live with my elderly mother. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.03,
      "end_seconds": 181.64,
      "duration_seconds": 2.61,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.41,
      "end_seconds": 187.73,
      "duration_seconds": 4.32,
      "text": "Um, I take escitalopram, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.63,
      "end_seconds": 191.77,
      "duration_seconds": 2.14,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.05,
      "end_seconds": 201.3,
      "duration_seconds": 8.25,
      "text": "10 milligrams. Tamsulosin, 0.4 milligrams, at night. Lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.75,
      "end_seconds": 205.97,
      "duration_seconds": 3.22,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.96,
      "end_seconds": 209.92,
      "duration_seconds": 1.96,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.96,
      "end_seconds": 214.52,
      "duration_seconds": 3.56,
      "text": "And what about cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.24,
      "end_seconds": 219.67,
      "duration_seconds": 4.43,
      "text": "Mm, um, no, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.62,
      "end_seconds": 222.9,
      "duration_seconds": 2.28,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.89,
      "end_seconds": 227.43,
      "duration_seconds": 3.54,
      "text": "Okay, so I move fine otherwise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.85,
      "end_seconds": 248.26,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.69,
      "end_seconds": 259.04,
      "duration_seconds": 2.35,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.05,
      "end_seconds": 288.1,
      "duration_seconds": 11.05,
      "text": "Okay: pressure 100 over 62, weight 62 kilos. And height 175 centimetres, BMI works out to 20.2, SpO2 96 percent on room air, heart rate 102."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.38,
      "end_seconds": 291.0,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.72,
      "end_seconds": 296.13,
      "duration_seconds": 3.41,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.46,
      "end_seconds": 302.4,
      "duration_seconds": 3.94,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.94,
      "end_seconds": 305.53,
      "duration_seconds": 1.59,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.18,
      "end_seconds": 308.44,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.46,
      "end_seconds": 328.11,
      "duration_seconds": 7.65,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.18,
      "end_seconds": 335.63,
      "duration_seconds": 2.45,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.48,
      "end_seconds": 376.8,
      "duration_seconds": 24.32,
      "text": "Putting it all together, I don't have a clear answer today: possible cardiac tamponade is possible, and so is a heart attack. I'll request an ECG, it'll help with chest pain. That will help us see what's going on underneath and decide the next step. I'd like to arrange an urgent echocardiogram for possible tamponade."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.13,
      "end_seconds": 383.42,
      "duration_seconds": 2.29,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.05,
      "end_seconds": 400.95,
      "duration_seconds": 12.9,
      "text": "You need an urgent heart scan and possibly a drain. I'd like you to see the cardiology team as well, and I'll write the referral. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.53,
      "end_seconds": 403.72,
      "duration_seconds": 2.19,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.68,
      "end_seconds": 411.93,
      "duration_seconds": 6.25,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.47,
      "end_seconds": 417.93,
      "duration_seconds": 5.46,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.71,
      "end_seconds": 422.7,
      "duration_seconds": 3.99,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.38,
      "end_seconds": 428.76,
      "duration_seconds": 4.38,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.07,
      "end_seconds": 431.91,
      "duration_seconds": 1.84,
      "text": "Have a good day."
    }
  ]
}