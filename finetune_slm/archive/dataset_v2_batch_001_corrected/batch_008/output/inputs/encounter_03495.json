    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.71,
      "end_seconds": 92.99,
      "duration_seconds": 3.28,
      "text": "Did you get numbness, weight loss or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.73,
      "end_seconds": 96.11,
      "duration_seconds": 2.38,
      "text": "No none that I've noticed."
