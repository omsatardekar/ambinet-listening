      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.61,
      "end_seconds": 116.0,
      "duration_seconds": 4.39,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.69,
      "end_seconds": 128.61,
      "duration_seconds": 10.92,
      "text": "Arthritis in my knees for nearly five years. I I have asthma for five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.41,
      "end_seconds": 136.8,
      "duration_seconds": 6.39,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 151.97,
      "duration_seconds": 1.32,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.4,
      "end_seconds": 154.99,
      "duration_seconds": 1.59,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.08,
      "end_seconds": 165.05,
      "duration_seconds": 1.97,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.82,
      "end_seconds": 170.65,
      "duration_seconds": 3.83,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.65,
      "end_seconds": 174.87,
      "duration_seconds": 3.22,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.95,
      "end_seconds": 179.25,
      "duration_seconds": 3.3,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 185.76,
      "duration_seconds": 2.05,
      "text": "tell me about your eating"
