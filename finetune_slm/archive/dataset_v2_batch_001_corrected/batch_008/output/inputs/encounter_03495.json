    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.07,
      "end_seconds": 62.15,
      "duration_seconds": 9.08,
      "text": "Okay: pressure 110 over 73, pulse 83, temp 36.6 degrees. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.67,
      "end_seconds": 67.09,
      "duration_seconds": 3.42,
      "text": "Ah, it's been two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.07,
      "end_seconds": 71.15,
      "duration_seconds": 3.08,
      "text": "is it bearing on you a lot?"
