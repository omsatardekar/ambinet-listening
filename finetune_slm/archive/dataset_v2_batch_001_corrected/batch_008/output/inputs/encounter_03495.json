      "role": "PATIENT",
      "start_seconds": 72.37,
      "end_seconds": 73.87,
      "duration_seconds": 1.5,
      "text": "Moderate, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.51,
      "end_seconds": 76.61,
      "duration_seconds": 2.1,
      "text": "What eases it, if anything?"
