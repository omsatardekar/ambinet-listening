    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 102.4,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 106.56,
      "duration_seconds": 2.81,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 110.15,
      "duration_seconds": 1.61,
      "text": "No known allergies."
