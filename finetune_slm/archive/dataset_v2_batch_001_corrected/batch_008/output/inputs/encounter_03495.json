    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.48,
      "end_seconds": 100.18,
      "duration_seconds": 2.7,
      "text": "and your skin, any changes there?"
