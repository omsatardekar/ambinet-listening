{
  "schema_version": "1.0",
  "encounter_id": "03102",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.42,
      "duration_seconds": 3.87,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.5,
      "end_seconds": 11.26,
      "duration_seconds": 4.76,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.83,
      "end_seconds": 17.18,
      "duration_seconds": 5.35,
      "text": "Well, so the thing is, I've got darker skin."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 19.53,
      "duration_seconds": 1.64,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.95,
      "end_seconds": 26.22,
      "duration_seconds": 5.27,
      "text": "Around about two weeks... no wait, it's more like four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.73,
      "end_seconds": 45.16,
      "duration_seconds": 3.43,
      "text": "Have you noticed vomiting, fever or fainting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.77,
      "end_seconds": 49.27,
      "duration_seconds": 2.5,
      "text": "Oh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.64,
      "end_seconds": 53.72,
      "duration_seconds": 3.08,
      "text": "And severe tummy pain, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.4,
      "end_seconds": 59.34,
      "duration_seconds": 3.94,
      "text": "No, I haven't had any severe tummy pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.21,
      "end_seconds": 63.93,
      "duration_seconds": 2.72,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.1,
      "end_seconds": 67.17,
      "duration_seconds": 2.07,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.97,
      "end_seconds": 84.93,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.94,
      "end_seconds": 93.09,
      "duration_seconds": 3.15,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 95.62,
      "duration_seconds": 1.78,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.66,
      "end_seconds": 101.28,
      "duration_seconds": 3.62,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 105.02,
      "duration_seconds": 3.24,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 110.42,
      "duration_seconds": 3.95,
      "text": "I have heart failure, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.83,
      "end_seconds": 116.7,
      "duration_seconds": 4.87,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.6,
      "end_seconds": 124.31,
      "duration_seconds": 5.71,
      "text": "Okay, uh, so no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.31,
      "end_seconds": 128.26,
      "duration_seconds": 2.95,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.61,
      "end_seconds": 136.7,
      "duration_seconds": 4.09,
      "text": "Uh, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.26,
      "end_seconds": 140.71,
      "duration_seconds": 2.45,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.58,
      "end_seconds": 151.66,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.32,
      "end_seconds": 175.16,
      "duration_seconds": 12.84,
      "text": "Okay: pressure 99 over 63, heart rate 95. And height 166 centimetres, respiratory rate 18, weight 62 kilos, BMI works out to 22.5, temperature 37.2."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.73,
      "end_seconds": 179.7,
      "duration_seconds": 1.97,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.92,
      "end_seconds": 182.56,
      "duration_seconds": 1.64,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.93,
      "end_seconds": 200.14,
      "duration_seconds": 10.21,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.94,
      "end_seconds": 207.45,
      "duration_seconds": 2.51,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 230.84,
      "duration_seconds": 6.14,
      "text": "Right, here's what I'm thinking. The most likely explanation is possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.64,
      "end_seconds": 235.7,
      "duration_seconds": 3.06,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.69,
      "end_seconds": 247.14,
      "duration_seconds": 9.45,
      "text": "I understand the worry. At the moment I'd say it's possible adrenal insufficiency, and we'll know more once the a morning cortisol is back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.86,
      "end_seconds": 269.82,
      "duration_seconds": 10.96,
      "text": "I think a morning cortisol makes sense here, for possible adrenal insufficiency. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 271.39,
      "end_seconds": 276.84,
      "duration_seconds": 5.45,
      "text": "We have a slot Wednesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.72,
      "end_seconds": 291.36,
      "duration_seconds": 13.64,
      "text": "I'd like to arrange a short synacthen test for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. We'll refer you to the endocrine clinic."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.54,
      "end_seconds": 295.97,
      "duration_seconds": 3.43,
      "text": "Erm, sure, where do I go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.27,
      "end_seconds": 302.74,
      "duration_seconds": 5.47,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.86,
      "end_seconds": 308.08,
      "duration_seconds": 4.22,
      "text": "Let me think, I know what to watch for."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.77,
      "end_seconds": 313.13,
      "duration_seconds": 3.36,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.22,
      "end_seconds": 317.62,
      "duration_seconds": 3.4,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.16,
      "end_seconds": 320.91,
      "duration_seconds": 1.75,
      "text": "Right, all the best."
    }
  ]
}