{
  "schema_version": "1.0",
  "encounter_id": "03131",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 4.33,
      "duration_seconds": 3.72,
      "text": "so, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.41,
      "end_seconds": 9.83,
      "duration_seconds": 4.42,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.74,
      "end_seconds": 19.77,
      "duration_seconds": 8.03,
      "text": "doctor, it's a splash of cleaning fluid in my eye. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 23.58,
      "duration_seconds": 2.76,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.75,
      "end_seconds": 27.99,
      "duration_seconds": 3.24,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.64,
      "end_seconds": 32.64,
      "duration_seconds": 3.0,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.14,
      "end_seconds": 40.74,
      "duration_seconds": 3.6,
      "text": "About a a five out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.71,
      "end_seconds": 45.43,
      "duration_seconds": 3.72,
      "text": "What about blurred vision, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.99,
      "end_seconds": 53.5,
      "duration_seconds": 3.51,
      "text": "Yeah, I've had that since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.36,
      "end_seconds": 58.32,
      "duration_seconds": 2.96,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.32,
      "end_seconds": 63.96,
      "duration_seconds": 4.64,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.46,
      "end_seconds": 70.12,
      "duration_seconds": 5.66,
      "text": "Let me check a a few things. Any both eyes or head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.42,
      "end_seconds": 76.3,
      "duration_seconds": 4.88,
      "text": "I haven't had both eyes or head injury, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.34,
      "end_seconds": 79.53,
      "duration_seconds": 2.19,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.19,
      "end_seconds": 86.26,
      "duration_seconds": 1.07,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.24,
      "end_seconds": 98.19,
      "duration_seconds": 3.95,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.78,
      "end_seconds": 103.63,
      "duration_seconds": 4.85,
      "text": "I'm, I'm allergic to to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 109.83,
      "duration_seconds": 4.9,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.8,
      "end_seconds": 112.35,
      "duration_seconds": 1.55,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.19,
      "end_seconds": 115.78,
      "duration_seconds": 2.59,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.26,
      "end_seconds": 135.6,
      "duration_seconds": 18.34,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. I swim twice a week. No, I share a house with my brother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.29,
      "end_seconds": 138.34,
      "duration_seconds": 2.05,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.47,
      "end_seconds": 141.28,
      "duration_seconds": 1.81,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.26,
      "end_seconds": 164.1,
      "duration_seconds": 4.84,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.57,
      "end_seconds": 167.95,
      "duration_seconds": 2.38,
      "text": "my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.72,
      "end_seconds": 173.12,
      "duration_seconds": 3.4,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.01,
      "end_seconds": 183.49,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.69,
      "end_seconds": 208.8,
      "duration_seconds": 8.11,
      "text": "Okay: heart rate 71, saturation 97 percent. And blood pressure 110 over 70, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.01,
      "end_seconds": 213.86,
      "duration_seconds": 2.85,
      "text": "let's move on to to the examination"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.74,
      "end_seconds": 223.11,
      "duration_seconds": 1.37,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.98,
      "end_seconds": 226.84,
      "duration_seconds": 1.86,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.19,
      "end_seconds": 253.06,
      "duration_seconds": 7.87,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.46,
      "end_seconds": 276.5,
      "duration_seconds": 21.04,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, this looks most like an alkali chemical burn to the eye. I want to be honest that this is an impression, not a final answer. It could also be a corneal abrasion, so we'll keep that open."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.13,
      "end_seconds": 281.63,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.76,
      "end_seconds": 305.41,
      "duration_seconds": 22.65,
      "text": "Nothing I've seen today points to an emergency. It looks like an alkali chemical burn to the eye, but I'd like to confirm. Let's get an urgent eye assessment, for chemical eye injury. I'm going to put you on sterile saline irrigation, 2 litres, continuous, until pH neutral. That should help with chemical eye burn."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.49,
      "end_seconds": 308.16,
      "duration_seconds": 1.67,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.31,
      "end_seconds": 326.08,
      "duration_seconds": 15.77,
      "text": "I am washing the eye now, keep it open and do not stop. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.32,
      "end_seconds": 331.99,
      "duration_seconds": 4.67,
      "text": "Should I have an urgent pH check as well?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.93,
      "end_seconds": 347.5,
      "duration_seconds": 13.57,
      "text": "Not right now, it wouldn't change what we do today. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Book a review straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.5,
      "end_seconds": 352.24,
      "duration_seconds": 2.74,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.56,
      "end_seconds": 357.08,
      "duration_seconds": 3.52,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.01,
      "end_seconds": 361.33,
      "duration_seconds": 3.32,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.53,
      "end_seconds": 363.7,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}