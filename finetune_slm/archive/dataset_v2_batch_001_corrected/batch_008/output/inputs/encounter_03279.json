{
  "schema_version": "1.0",
  "encounter_id": "03279",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 3.61,
      "duration_seconds": 2.96,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.63,
      "end_seconds": 7.86,
      "duration_seconds": 3.23,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.65,
      "end_seconds": 11.66,
      "duration_seconds": 3.01,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 17.36,
      "duration_seconds": 4.18,
      "text": "I'm here because of pain in my breastbone wound."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.94,
      "end_seconds": 22.34,
      "duration_seconds": 3.4,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.15,
      "end_seconds": 26.41,
      "duration_seconds": 3.26,
      "text": "I've had it it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.24,
      "end_seconds": 30.84,
      "duration_seconds": 2.6,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.88,
      "end_seconds": 37.78,
      "duration_seconds": 2.9,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.2,
      "end_seconds": 45.04,
      "duration_seconds": 6.84,
      "text": "I was just going to to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.14,
      "end_seconds": 51.28,
      "duration_seconds": 6.14,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 58.31,
      "duration_seconds": 5.84,
      "text": "later, thanks please go on alright, any a clicking in the breastbone as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 60.9,
      "duration_seconds": 1.67,
      "text": "Yes, since Friday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.54,
      "end_seconds": 65.35,
      "duration_seconds": 2.81,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.81,
      "end_seconds": 74.26,
      "duration_seconds": 7.45,
      "text": "I'd say moderate. Oh, and tiredness. That's been about the the same, three days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.81,
      "end_seconds": 81.19,
      "duration_seconds": 6.38,
      "text": "have you had pain in your breastbone wound before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.14,
      "end_seconds": 92.82,
      "duration_seconds": 6.68,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 93.78,
      "end_seconds": 95.78,
      "duration_seconds": 2.0,
      "text": "yes, exactly like that"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.73,
      "end_seconds": 100.82,
      "duration_seconds": 4.09,
      "text": "any breathlessness, fever or chest pain on exertion at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.59,
      "end_seconds": 114.34,
      "duration_seconds": 11.75,
      "text": "No, no breathlessness, no fever, no chest pain on exertion. I did have swollen ankles at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 120.67,
      "duration_seconds": 4.8,
      "text": "so, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 123.65,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.67,
      "end_seconds": 127.6,
      "duration_seconds": 2.93,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.35,
      "end_seconds": 129.99,
      "duration_seconds": 1.64,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.93,
      "end_seconds": 134.75,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.32,
      "end_seconds": 147.99,
      "duration_seconds": 11.67,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.31,
      "end_seconds": 167.07,
      "duration_seconds": 3.76,
      "text": "right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.71,
      "end_seconds": 171.23,
      "duration_seconds": 3.52,
      "text": "Heart disease, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.87,
      "end_seconds": 172.57,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.2,
      "end_seconds": 178.29,
      "duration_seconds": 4.09,
      "text": "I have depression. I've had migraines, yes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 187.54,
      "duration_seconds": 8.0,
      "text": "Okay, I can see depression and migraines in your file as well. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.92,
      "end_seconds": 192.84,
      "duration_seconds": 3.92,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.88,
      "end_seconds": 199.98,
      "duration_seconds": 5.1,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.8,
      "end_seconds": 209.55,
      "duration_seconds": 7.75,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.41,
      "end_seconds": 212.82,
      "duration_seconds": 2.41,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.37,
      "end_seconds": 236.77,
      "duration_seconds": 20.4,
      "text": "for my heart, I believe my wife sets them out for me, I just take what I'm given yeah, I'm on sertraline, 50 milligrams, once a day. Sumatriptan, 50 milligrams, when needed for my migraines"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.89,
      "end_seconds": 239.88,
      "duration_seconds": 1.99,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.51,
      "end_seconds": 245.45,
      "duration_seconds": 3.94,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 256.21,
      "end_seconds": 265.39,
      "duration_seconds": 9.18,
      "text": "Here are the numbers, doctor. Blood pressure 126 over 75, temperature is 36.5 degrees, pulse is 75 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.47,
      "end_seconds": 267.37,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.31,
      "end_seconds": 273.63,
      "duration_seconds": 4.32,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.63,
      "end_seconds": 277.3,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.11,
      "end_seconds": 280.98,
      "duration_seconds": 2.87,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.61,
      "end_seconds": 303.23,
      "duration_seconds": 8.62,
      "text": "the chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.77,
      "end_seconds": 328.39,
      "duration_seconds": 20.62,
      "text": "that's all I needed to check. Okay, thinking it through, this is probably recovering well after bypass surgery. I'd also keep a leg wound infection in mind. Just to be sure I understood. You've had pain in your breastbone wound for one week, and no breathlessness or chest pain on exertion"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.06,
      "end_seconds": 331.08,
      "duration_seconds": 2.02,
      "text": "yes, you've got it"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 331.92,
      "end_seconds": 338.42,
      "duration_seconds": 6.5,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.05,
      "end_seconds": 346.13,
      "duration_seconds": 7.08,
      "text": "so, thanks, that that helps i think blood tests makes sense here, for post-operative review"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 347.32,
      "end_seconds": 350.95,
      "duration_seconds": 3.63,
      "text": "I can book that for Thursday at 11:30 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.47,
      "end_seconds": 366.32,
      "duration_seconds": 13.85,
      "text": "Walk daily, no heavy lifting for six weeks and no driving until you are cleared. The cardiac rehabilitation team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.99,
      "end_seconds": 372.69,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.37,
      "end_seconds": 385.57,
      "duration_seconds": 11.2,
      "text": "If the symptoms get worse, that's the point to come in urgently. See me again in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.73,
      "end_seconds": 389.99,
      "duration_seconds": 3.26,
      "text": "Great, thank you for your help."
    }
  ]
}