{
  "schema_version": "1.0",
  "encounter_id": "03044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.69,
      "duration_seconds": 3.63,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 10.22,
      "duration_seconds": 4.06,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.19,
      "end_seconds": 24.03,
      "duration_seconds": 11.84,
      "text": "Well, hello, doctor. I hope it's alright if I stay in for this. Um, she's been having shortness of breath, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.33,
      "end_seconds": 28.64,
      "duration_seconds": 3.31,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.1,
      "end_seconds": 34.99,
      "duration_seconds": 4.89,
      "text": "Um, um, for three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.34,
      "end_seconds": 39.19,
      "duration_seconds": 2.85,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.76,
      "end_seconds": 41.86,
      "duration_seconds": 1.1,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.5,
      "end_seconds": 45.85,
      "duration_seconds": 2.35,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.82,
      "end_seconds": 50.94,
      "duration_seconds": 4.12,
      "text": "It, It happens a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.48,
      "end_seconds": 55.52,
      "duration_seconds": 4.04,
      "text": "Okay, go on. Any chest pain as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.0,
      "end_seconds": 76.1,
      "duration_seconds": 19.1,
      "text": "Yes, for one week. So, as for chest pain, honestly, a few times a day. I've been feeling faint too, for about a month. I've also had a racing heart. About racing heart, moderate, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.1,
      "end_seconds": 82.89,
      "duration_seconds": 5.79,
      "text": "Have you had shortness of breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.82,
      "end_seconds": 90.95,
      "duration_seconds": 6.13,
      "text": "Um, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.5,
      "end_seconds": 94.84,
      "duration_seconds": 3.34,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 101.33,
      "duration_seconds": 4.57,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.3,
      "end_seconds": 104.57,
      "duration_seconds": 2.27,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.54,
      "end_seconds": 109.56,
      "duration_seconds": 4.02,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.82,
      "end_seconds": 123.97,
      "duration_seconds": 4.15,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.78,
      "end_seconds": 127.09,
      "duration_seconds": 2.31,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.24,
      "end_seconds": 130.61,
      "duration_seconds": 2.37,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.31,
      "end_seconds": 135.86,
      "duration_seconds": 4.55,
      "text": "I take lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 136.65,
      "end_seconds": 147.59,
      "duration_seconds": 10.94,
      "text": "Doctor, I think the last prescription for the lamotrigine was 200 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.37,
      "end_seconds": 151.79,
      "duration_seconds": 3.42,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.26,
      "end_seconds": 157.77,
      "duration_seconds": 4.51,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.01,
      "end_seconds": 161.9,
      "duration_seconds": 2.89,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.7,
      "end_seconds": 168.98,
      "duration_seconds": 5.28,
      "text": "Okay, uh, so no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.97,
      "end_seconds": 173.21,
      "duration_seconds": 2.24,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.16,
      "end_seconds": 180.98,
      "duration_seconds": 5.82,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.98,
      "end_seconds": 190.37,
      "duration_seconds": 7.39,
      "text": "Right, tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.37,
      "end_seconds": 198.11,
      "duration_seconds": 5.74,
      "text": "I've had epilepsy, yes. Eczema, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.09,
      "end_seconds": 212.74,
      "duration_seconds": 2.65,
      "text": "And leg swelling, any of that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.46,
      "end_seconds": 218.44,
      "duration_seconds": 3.98,
      "text": "No, I haven't had any leg swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.46,
      "end_seconds": 224.79,
      "duration_seconds": 4.33,
      "text": "Let me check a few things. Any fever or cough?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.32,
      "end_seconds": 228.87,
      "duration_seconds": 2.55,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.46,
      "end_seconds": 233.67,
      "duration_seconds": 4.21,
      "text": "Okay, go on. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.55,
      "end_seconds": 238.45,
      "duration_seconds": 3.9,
      "text": "Well, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.76,
      "end_seconds": 242.71,
      "duration_seconds": 2.95,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.03,
      "end_seconds": 247.12,
      "duration_seconds": 3.09,
      "text": "Yeah, no, that's all fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.81,
      "end_seconds": 252.41,
      "duration_seconds": 3.6,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.97,
      "end_seconds": 263.47,
      "duration_seconds": 2.5,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.48,
      "end_seconds": 294.53,
      "duration_seconds": 15.05,
      "text": "Okay: BMI works out to 33.7, respiratory rate 17, weight 82 kilos, blood pressure 104 over 61, pulse is 97 beats a minute, temp 36.8 degrees, height 156 centimetres, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.99,
      "end_seconds": 299.27,
      "duration_seconds": 2.28,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.22,
      "end_seconds": 303.77,
      "duration_seconds": 2.55,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.11,
      "end_seconds": 320.55,
      "duration_seconds": 7.44,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.46,
      "end_seconds": 344.35,
      "duration_seconds": 18.89,
      "text": "All finished, thank you. Okay, so my impression is this: The most likely explanation is possible cardiac tamponade. The reason I say that is that your story and my examination fit together. Another possibility is a heart attack."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.58,
      "end_seconds": 352.77,
      "duration_seconds": 3.19,
      "text": "Ah, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.32,
      "end_seconds": 361.1,
      "duration_seconds": 7.78,
      "text": "Nothing I've seen today points to an emergency. It looks like possible cardiac tamponade, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.64,
      "end_seconds": 392.57,
      "duration_seconds": 23.93,
      "text": "I think an urgent echocardiogram makes sense here, for possible tamponade. I think an ECG makes sense here, for chest pain. You need an urgent heart scan and possibly a drain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.11,
      "end_seconds": 399.66,
      "duration_seconds": 5.55,
      "text": "Sorry, what was I saying, good, I'll return then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.93,
      "end_seconds": 403.76,
      "duration_seconds": 2.83,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.32,
      "end_seconds": 409.99,
      "duration_seconds": 3.67,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.59,
      "end_seconds": 412.94,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}