{
  "schema_version": "1.0",
  "encounter_id": "03047",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 6.11,
      "duration_seconds": 5.56,
      "text": "Doctor? Hello, I hope this is the the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 10.35,
      "duration_seconds": 3.69,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.16,
      "end_seconds": 15.95,
      "duration_seconds": 4.79,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.99,
      "end_seconds": 24.04,
      "duration_seconds": 7.05,
      "text": "Doctor, you know, it's stiffness putting on socks. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.82,
      "end_seconds": 27.38,
      "duration_seconds": 2.56,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.23,
      "end_seconds": 38.26,
      "duration_seconds": 9.03,
      "text": "it sort of comes and goes. Oh, and and a limp. That's been about the same, two months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 43.15,
      "duration_seconds": 2.9,
      "text": "Okay, what eases it, if anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.89,
      "end_seconds": 47.58,
      "duration_seconds": 3.69,
      "text": "Only a stick, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.7,
      "end_seconds": 50.77,
      "duration_seconds": 2.07,
      "text": "any night pain as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.7,
      "end_seconds": 59.61,
      "duration_seconds": 7.91,
      "text": "Yes, actually. About night pain, it's moderate, honestly. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 64.12,
      "duration_seconds": 2.98,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 74.43,
      "duration_seconds": 2.54,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.04,
      "end_seconds": 92.42,
      "duration_seconds": 8.38,
      "text": "okay: saturation 97 percent, pulse 65, temperature 36.8, respiratory rate 16, pressure 117 over 78."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.26,
      "end_seconds": 96.79,
      "duration_seconds": 1.53,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.77,
      "end_seconds": 101.19,
      "duration_seconds": 2.42,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.75,
      "end_seconds": 107.97,
      "duration_seconds": 4.22,
      "text": "Right, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.57,
      "end_seconds": 112.54,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 128.25,
      "duration_seconds": 6.0,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.42,
      "end_seconds": 135.02,
      "duration_seconds": 2.6,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.26,
      "end_seconds": 148.58,
      "duration_seconds": 4.32,
      "text": "let me check a few things any numbness or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 153.22,
      "duration_seconds": 2.87,
      "text": "No, no numbness or weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 155.72,
      "duration_seconds": 1.57,
      "text": "Any fall or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.83,
      "end_seconds": 163.9,
      "duration_seconds": 3.07,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 167.38,
      "duration_seconds": 2.45,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.15,
      "end_seconds": 170.07,
      "duration_seconds": 1.92,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.78,
      "end_seconds": 174.28,
      "duration_seconds": 2.5,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.05,
      "end_seconds": 177.55,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 194.63,
      "duration_seconds": 2.78,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.03,
      "end_seconds": 200.14,
      "duration_seconds": 4.11,
      "text": "I had part of my thyroid removed years back"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.12,
      "end_seconds": 202.32,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.53,
      "end_seconds": 206.54,
      "duration_seconds": 3.01,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.32,
      "end_seconds": 210.09,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.42,
      "end_seconds": 213.93,
      "duration_seconds": 2.51,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.77,
      "end_seconds": 219.42,
      "duration_seconds": 3.65,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.34,
      "end_seconds": 223.98,
      "duration_seconds": 3.64,
      "text": "yes, arthritis in my knees. Yes, migraines"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.84,
      "end_seconds": 233.19,
      "duration_seconds": 8.35,
      "text": "yes, arthritis in your knees is known to us, good to have that clear. Tell me your medicines, please"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.24,
      "end_seconds": 241.92,
      "duration_seconds": 6.68,
      "text": "I take naproxen, 250 milligrams, twice a day for the knee pain"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 243.61,
      "end_seconds": 253.31,
      "duration_seconds": 9.7,
      "text": "doctor, I think the last prescription for the naproxen was 500 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.93,
      "end_seconds": 259.64,
      "duration_seconds": 5.71,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.37,
      "end_seconds": 269.39,
      "duration_seconds": 8.02,
      "text": "Not with me. I'll bring it next time. I take propranolol, twice a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.93,
      "end_seconds": 272.04,
      "duration_seconds": 2.11,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.58,
      "end_seconds": 282.39,
      "duration_seconds": 8.81,
      "text": "40 milligrams, I think that's what's on the box. It's paracetamol, 1 gram, four times a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.34,
      "end_seconds": 295.37,
      "duration_seconds": 4.03,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.27,
      "end_seconds": 298.69,
      "duration_seconds": 1.42,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 300.56,
      "end_seconds": 308.08,
      "duration_seconds": 7.52,
      "text": "Hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.84,
      "end_seconds": 313.0,
      "duration_seconds": 3.16,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.77,
      "end_seconds": 347.63,
      "duration_seconds": 32.86,
      "text": "Alright, so that's unclear. I'll record what each of you said. Taking everything into account, this is probably hip osteoarthritis. I'd also keep a back problem in mind. An X-ray of the hips is what I'd like next, for hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.81,
      "end_seconds": 350.44,
      "duration_seconds": 1.63,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.01,
      "end_seconds": 359.22,
      "duration_seconds": 7.21,
      "text": "Do get help quickly if the symptoms get worse. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.55,
      "end_seconds": 364.27,
      "duration_seconds": 3.72,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}