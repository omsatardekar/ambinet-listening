{
  "schema_version": "1.0",
  "encounter_id": "03441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 7.39,
      "duration_seconds": 6.24,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 12.72,
      "duration_seconds": 4.09,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.26,
      "end_seconds": 17.72,
      "duration_seconds": 3.46,
      "text": "I'm here because of shortness of breath."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.66,
      "end_seconds": 22.94,
      "duration_seconds": 3.28,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.38,
      "end_seconds": 33.85,
      "duration_seconds": 2.47,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.5,
      "end_seconds": 62.29,
      "duration_seconds": 7.79,
      "text": "Okay: pulse 112, SpO2 99 percent on room air. And BP is 95 over 62, temp 37.2 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 65.62,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.22,
      "end_seconds": 72.37,
      "duration_seconds": 6.15,
      "text": "I'll explain what these mean in a moment. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.39,
      "end_seconds": 78.98,
      "duration_seconds": 4.59,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.56,
      "end_seconds": 82.09,
      "duration_seconds": 2.53,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.44,
      "end_seconds": 100.89,
      "duration_seconds": 17.45,
      "text": "It settles a little with sitting forward. Mm, you know, I've been feeling faint too, for about a month. Ah, as for feeling faint, I'd call it mild. Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.11,
      "end_seconds": 104.97,
      "duration_seconds": 2.86,
      "text": "Right, have you had chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.84,
      "end_seconds": 124.68,
      "duration_seconds": 18.84,
      "text": "Yeah, yes, for five days. With chest pain, it's severe, honestly. Right, as for racing heart, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 130.01,
      "duration_seconds": 4.54,
      "text": "Alright, did you get leg swelling, cough or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.87,
      "end_seconds": 133.88,
      "duration_seconds": 3.01,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.43,
      "end_seconds": 137.18,
      "duration_seconds": 2.75,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.03,
      "end_seconds": 139.78,
      "duration_seconds": 1.75,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.47,
      "end_seconds": 144.69,
      "duration_seconds": 3.22,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.98,
      "end_seconds": 148.78,
      "duration_seconds": 2.8,
      "text": "Right, no, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.37,
      "end_seconds": 152.48,
      "duration_seconds": 3.11,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.99,
      "end_seconds": 159.17,
      "duration_seconds": 5.18,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.68,
      "end_seconds": 163.45,
      "duration_seconds": 2.77,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 167.58,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.86,
      "end_seconds": 172.51,
      "duration_seconds": 3.65,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.49,
      "end_seconds": 179.98,
      "duration_seconds": 5.49,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.05,
      "end_seconds": 185.84,
      "duration_seconds": 4.79,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.83,
      "end_seconds": 196.49,
      "duration_seconds": 8.66,
      "text": "Not with me. I'll bring it next time. I take alendronate, once a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.55,
      "end_seconds": 200.74,
      "duration_seconds": 2.19,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.9,
      "end_seconds": 202.99,
      "duration_seconds": 1.09,
      "text": "70 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.76,
      "end_seconds": 219.55,
      "duration_seconds": 2.79,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.13,
      "end_seconds": 224.42,
      "duration_seconds": 3.29,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.13,
      "end_seconds": 236.23,
      "duration_seconds": 4.1,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.83,
      "end_seconds": 240.38,
      "duration_seconds": 2.55,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.22,
      "end_seconds": 246.18,
      "duration_seconds": 3.96,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.86,
      "end_seconds": 270.54,
      "duration_seconds": 18.68,
      "text": "Anxiety, for five years. Sorry, uh, what was I saying, I've got thin bones. A neighbour of mine said I should see someone about it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 276.52,
      "duration_seconds": 4.56,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.34,
      "end_seconds": 279.53,
      "duration_seconds": 2.19,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.42,
      "end_seconds": 297.06,
      "duration_seconds": 7.64,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.49,
      "end_seconds": 303.45,
      "duration_seconds": 1.96,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.5,
      "end_seconds": 323.66,
      "duration_seconds": 8.16,
      "text": "Having listened and examined, my working impression is possible cardiac tamponade. We shouldn't forget a heart attack."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.16,
      "end_seconds": 326.88,
      "duration_seconds": 1.72,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.59,
      "end_seconds": 340.4,
      "duration_seconds": 12.81,
      "text": "It's reasonable to be concerned, but right now possible cardiac tamponade is my leading thought, not anything worse. I'm sending you for an ECG because of chest pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.29,
      "end_seconds": 344.18,
      "duration_seconds": 2.89,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.09,
      "end_seconds": 367.06,
      "duration_seconds": 20.97,
      "text": "Let's get an urgent echocardiogram, for possible tamponade. That will help us see what's going on underneath and decide the next step. You need an urgent heart scan and possibly a drain. I'd like you to see the cardiology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.62,
      "end_seconds": 369.32,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.33,
      "end_seconds": 390.26,
      "duration_seconds": 19.93,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's review you straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.07,
      "end_seconds": 396.38,
      "duration_seconds": 4.31,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.16,
      "end_seconds": 400.44,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}