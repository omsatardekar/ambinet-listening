{
  "schema_version": "1.0",
  "encounter_id": "03482",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 5.84,
      "duration_seconds": 4.52,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.79,
      "end_seconds": 11.83,
      "duration_seconds": 4.04,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.11,
      "end_seconds": 16.99,
      "duration_seconds": 3.88,
      "text": "Well, I've been having three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.76,
      "end_seconds": 20.17,
      "duration_seconds": 2.41,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 26.76,
      "duration_seconds": 5.75,
      "text": "Around three days... no wait, it's more like about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.51,
      "end_seconds": 30.54,
      "duration_seconds": 3.03,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.99,
      "end_seconds": 38.08,
      "duration_seconds": 6.09,
      "text": "Mostly mild. Oh, you know, and irregular cycles. Had that since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.69,
      "end_seconds": 45.36,
      "duration_seconds": 3.67,
      "text": "Any fever or heavy bleeding now at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 48.88,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.65,
      "end_seconds": 54.95,
      "duration_seconds": 4.3,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.52,
      "end_seconds": 58.83,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.64,
      "end_seconds": 62.97,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.44,
      "end_seconds": 66.59,
      "duration_seconds": 2.15,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.94,
      "end_seconds": 69.29,
      "duration_seconds": 1.35,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.78,
      "end_seconds": 74.28,
      "duration_seconds": 3.5,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.01,
      "end_seconds": 76.9,
      "duration_seconds": 1.89,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.67,
      "end_seconds": 83.98,
      "duration_seconds": 2.31,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.08,
      "end_seconds": 86.74,
      "duration_seconds": 1.66,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 91.05,
      "duration_seconds": 3.29,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.12,
      "end_seconds": 98.19,
      "duration_seconds": 4.07,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.69,
      "end_seconds": 104.37,
      "duration_seconds": 4.68,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.9,
      "end_seconds": 109.86,
      "duration_seconds": 3.96,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.91,
      "end_seconds": 121.93,
      "duration_seconds": 11.02,
      "text": "I have anxiety. I kept putting it off, which I know isn't sensible. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.72,
      "end_seconds": 139.6,
      "duration_seconds": 4.88,
      "text": "So, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.14,
      "end_seconds": 145.01,
      "duration_seconds": 3.87,
      "text": "I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.99,
      "end_seconds": 149.86,
      "duration_seconds": 2.87,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.74,
      "end_seconds": 157.45,
      "duration_seconds": 5.71,
      "text": "About two months. Folic acid. I take it 400 micrograms, daily."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.37,
      "end_seconds": 161.26,
      "duration_seconds": 2.89,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.13,
      "end_seconds": 173.06,
      "duration_seconds": 2.93,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.49,
      "end_seconds": 189.53,
      "duration_seconds": 6.04,
      "text": "Okay: heart rate 66, BP is 115 over 82, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.99,
      "end_seconds": 193.03,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.79,
      "end_seconds": 198.32,
      "duration_seconds": 4.53,
      "text": "So, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.7,
      "end_seconds": 204.95,
      "duration_seconds": 4.25,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.86,
      "end_seconds": 208.77,
      "duration_seconds": 1.91,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.34,
      "end_seconds": 226.24,
      "duration_seconds": 1.9,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 230.24,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 259.82,
      "duration_seconds": 12.87,
      "text": "Right, here's what I'm thinking. It's hard to say. Recurrent miscarriage needing investigation is one possibility and a thyroid problem another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.08,
      "end_seconds": 272.4,
      "duration_seconds": 3.32,
      "text": "Let's get a pelvic ultrasound, for recurrent miscarriage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 274.07,
      "end_seconds": 276.64,
      "duration_seconds": 2.57,
      "text": "The earliest is Friday, 2 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.25,
      "end_seconds": 290.36,
      "duration_seconds": 13.11,
      "text": "Let's get blood tests, for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. I'll also refer you to the recurrent miscarriage clinic."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.45,
      "end_seconds": 297.18,
      "duration_seconds": 1.73,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.46,
      "end_seconds": 308.31,
      "duration_seconds": 9.85,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Let's plan a check after the results."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.01,
      "end_seconds": 312.71,
      "duration_seconds": 3.7,
      "text": "I, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.64,
      "end_seconds": 317.21,
      "duration_seconds": 3.57,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.21,
      "end_seconds": 320.28,
      "duration_seconds": 2.07,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.05,
      "end_seconds": 322.49,
      "duration_seconds": 1.44,
      "text": "Goodbye for now."
    }
  ]
}