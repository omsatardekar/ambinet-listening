{
  "schema_version": "1.0",
  "encounter_id": "03361",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.5,
      "duration_seconds": 2.3,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.15,
      "end_seconds": 6.22,
      "duration_seconds": 1.07,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 9.96,
      "duration_seconds": 2.76,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.82,
      "end_seconds": 14.99,
      "duration_seconds": 4.17,
      "text": "Mainly I've been feeling sick. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 21.67,
      "duration_seconds": 1.95,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.76,
      "end_seconds": 30.11,
      "duration_seconds": 6.35,
      "text": "Well, around about a week... no wait, it's more like about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.1,
      "end_seconds": 33.96,
      "duration_seconds": 2.86,
      "text": "Any taking painkillers every day as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.28,
      "end_seconds": 36.76,
      "duration_seconds": 1.48,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.4,
      "end_seconds": 39.57,
      "duration_seconds": 2.17,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.57,
      "end_seconds": 44.31,
      "duration_seconds": 3.74,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.04,
      "end_seconds": 48.3,
      "duration_seconds": 3.26,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.08,
      "end_seconds": 61.7,
      "duration_seconds": 2.62,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.5,
      "end_seconds": 91.6,
      "duration_seconds": 11.1,
      "text": "Okay: temp 36.6 degrees, weight 65 kilos. And height 186 centimetres, pulse 64, pressure 123 over 82, BMI works out to 18.8, saturation 99 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.71,
      "end_seconds": 95.08,
      "duration_seconds": 2.37,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.82,
      "end_seconds": 98.83,
      "duration_seconds": 2.01,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.76,
      "end_seconds": 117.85,
      "duration_seconds": 2.09,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.51,
      "end_seconds": 124.36,
      "duration_seconds": 1.85,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.26,
      "end_seconds": 140.43,
      "duration_seconds": 4.17,
      "text": "Have you noticed weakness, visual changes, fever or stiff neck?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.2,
      "end_seconds": 148.74,
      "duration_seconds": 6.54,
      "text": "No weakness, visual changes, fever or stiff neck, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.72,
      "end_seconds": 153.26,
      "duration_seconds": 2.54,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.08,
      "end_seconds": 156.54,
      "duration_seconds": 1.46,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.12,
      "end_seconds": 162.96,
      "duration_seconds": 4.84,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.02,
      "end_seconds": 167.19,
      "duration_seconds": 3.17,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.36,
      "end_seconds": 172.79,
      "duration_seconds": 2.43,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.77,
      "end_seconds": 178.1,
      "duration_seconds": 3.33,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.11,
      "end_seconds": 181.93,
      "duration_seconds": 1.82,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.26,
      "end_seconds": 187.45,
      "duration_seconds": 4.19,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.73,
      "end_seconds": 201.26,
      "duration_seconds": 2.53,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.78,
      "end_seconds": 202.81,
      "duration_seconds": 1.03,
      "text": "Yes, migraines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.33,
      "end_seconds": 213.31,
      "duration_seconds": 9.98,
      "text": "Yes, carry on. Okay, I can see migraines in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.09,
      "end_seconds": 219.81,
      "duration_seconds": 4.72,
      "text": "It's sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.82,
      "end_seconds": 224.62,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.17,
      "end_seconds": 228.16,
      "duration_seconds": 1.99,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.22,
      "end_seconds": 244.5,
      "duration_seconds": 6.28,
      "text": "So where does that leave us? It points towards medication-overuse headache on a background of migraine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.38,
      "end_seconds": 251.99,
      "duration_seconds": 1.61,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.58,
      "end_seconds": 290.67,
      "duration_seconds": 37.09,
      "text": "It's reasonable to be concerned, but right now medication-overuse headache on a background of migraine is my leading thought, not anything worse. I'd like to arrange a headache diary for daily headache. Let's use amitriptyline, 10 milligrams, at night, long term. That should help with headache prevention. I'll put all of this in writing so you don't have to remember it. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 304.75,
      "duration_seconds": 12.3,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Let's plan a check in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.72,
      "end_seconds": 309.68,
      "duration_seconds": 2.96,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.22,
      "end_seconds": 311.69,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
}