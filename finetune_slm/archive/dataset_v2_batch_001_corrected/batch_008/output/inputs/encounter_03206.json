{
  "schema_version": "1.0",
  "encounter_id": "03206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.78,
      "duration_seconds": 5.4,
      "text": "I mean, uh, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.58,
      "end_seconds": 12.85,
      "duration_seconds": 4.27,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.76,
      "end_seconds": 22.67,
      "duration_seconds": 7.91,
      "text": "I mean, I wanted to get pain in my groin and hip looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.71,
      "end_seconds": 26.84,
      "duration_seconds": 3.13,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.38,
      "end_seconds": 40.4,
      "duration_seconds": 13.02,
      "text": "Right, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.35,
      "end_seconds": 45.2,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.41,
      "end_seconds": 48.21,
      "duration_seconds": 1.8,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.35,
      "end_seconds": 52.15,
      "duration_seconds": 2.8,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.85,
      "end_seconds": 61.07,
      "duration_seconds": 3.22,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.67,
      "end_seconds": 65.05,
      "duration_seconds": 2.38,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.13,
      "end_seconds": 76.61,
      "duration_seconds": 10.48,
      "text": "Uh, um, it's worse with walking. Oh, and stiffness putting on socks. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 79.26,
      "duration_seconds": 2.03,
      "text": "Have you had a limp?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.45,
      "end_seconds": 82.03,
      "duration_seconds": 1.58,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.21,
      "end_seconds": 85.42,
      "duration_seconds": 2.21,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.89,
      "end_seconds": 94.52,
      "duration_seconds": 2.63,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.12,
      "end_seconds": 119.47,
      "duration_seconds": 11.35,
      "text": "Okay: temperature 36.8, respiratory rate 17. And blood pressure 110 over 82, pulse is 68 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.06,
      "end_seconds": 123.06,
      "duration_seconds": 3.0,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.74,
      "end_seconds": 128.35,
      "duration_seconds": 4.61,
      "text": "So, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.18,
      "end_seconds": 134.63,
      "duration_seconds": 4.45,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.69,
      "end_seconds": 148.39,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.92,
      "end_seconds": 151.4,
      "duration_seconds": 1.48,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.12,
      "end_seconds": 169.3,
      "duration_seconds": 7.18,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.03,
      "end_seconds": 174.87,
      "duration_seconds": 1.84,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.34,
      "end_seconds": 194.64,
      "duration_seconds": 5.3,
      "text": "Let me check a few things. Any numbness, fall or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.82,
      "end_seconds": 198.85,
      "duration_seconds": 3.03,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.6,
      "end_seconds": 201.8,
      "duration_seconds": 2.2,
      "text": "Any sign of weight loss?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.72,
      "end_seconds": 206.26,
      "duration_seconds": 2.54,
      "text": "No weight loss, thankfully."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.12,
      "end_seconds": 210.26,
      "duration_seconds": 2.14,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.99,
      "end_seconds": 214.29,
      "duration_seconds": 2.3,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.4,
      "end_seconds": 218.21,
      "duration_seconds": 2.81,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.27,
      "end_seconds": 224.28,
      "duration_seconds": 5.01,
      "text": "Hmm, uh, no, that side's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.46,
      "end_seconds": 241.36,
      "duration_seconds": 2.9,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.25,
      "end_seconds": 252.96,
      "duration_seconds": 9.71,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.04,
      "end_seconds": 259.52,
      "duration_seconds": 4.48,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.7,
      "end_seconds": 269.09,
      "duration_seconds": 4.39,
      "text": "I take diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.68,
      "end_seconds": 273.06,
      "duration_seconds": 3.38,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.02,
      "end_seconds": 299.8,
      "duration_seconds": 25.78,
      "text": "Six months now. I'm on tamsulosin, 0.4 milligrams, at night for the prostate. I take sitagliptin, 100 milligrams, once a day. Paracetamol. I take it 1 gram, four times a day. I was on Glycomet before. I stopped taking it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.52,
      "end_seconds": 303.39,
      "duration_seconds": 2.87,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.15,
      "end_seconds": 308.29,
      "duration_seconds": 4.14,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.82,
      "end_seconds": 312.4,
      "duration_seconds": 2.58,
      "text": "So, do you do any exercise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.38,
      "end_seconds": 317.06,
      "duration_seconds": 2.68,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.5,
      "end_seconds": 322.73,
      "duration_seconds": 4.23,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.79,
      "end_seconds": 333.7,
      "duration_seconds": 9.91,
      "text": "I have arthritis in my knees, for five years. An enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.5,
      "end_seconds": 336.46,
      "duration_seconds": 0.96,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.13,
      "end_seconds": 340.94,
      "duration_seconds": 2.81,
      "text": "Diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.51,
      "end_seconds": 349.58,
      "duration_seconds": 8.07,
      "text": "Alright, arthritis in your knees, that matches what I have here. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.75,
      "end_seconds": 357.72,
      "duration_seconds": 6.97,
      "text": "Um, you know, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.49,
      "end_seconds": 367.5,
      "duration_seconds": 9.01,
      "text": "Let me tell you where I've got to. The most likely explanation is hip osteoarthritis. A back problem is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.68,
      "end_seconds": 373.07,
      "duration_seconds": 4.39,
      "text": "I mean, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.72,
      "end_seconds": 395.41,
      "duration_seconds": 21.69,
      "text": "I can't promise yet, but most people with hip osteoarthritis do well once it's treated properly. I'm sending you for an X-ray of the hips because of hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. Let's review you in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.49,
      "end_seconds": 400.52,
      "duration_seconds": 3.03,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}