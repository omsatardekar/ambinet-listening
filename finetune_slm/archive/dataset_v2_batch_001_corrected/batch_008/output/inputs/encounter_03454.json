{
  "schema_version": "1.0",
  "encounter_id": "03454",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 5.36,
      "duration_seconds": 4.41,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 10.64,
      "duration_seconds": 3.67,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.35,
      "end_seconds": 33.82,
      "duration_seconds": 22.47,
      "text": "Um, so... a pearly bump on my nose that bleeds. That's why I came. I wasn't sure whether to come in at all, to be honest. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.74,
      "end_seconds": 38.58,
      "duration_seconds": 2.84,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.52,
      "end_seconds": 46.8,
      "duration_seconds": 6.28,
      "text": "Right, for two weeks, I'd say. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 49.95,
      "duration_seconds": 2.0,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.78,
      "end_seconds": 55.32,
      "duration_seconds": 4.54,
      "text": "Okay, so I notice it more with washing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.2,
      "end_seconds": 77.48,
      "duration_seconds": 6.28,
      "text": "Have you noticed swollen glands, other new lumps, family history of skin cancer or pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.84,
      "end_seconds": 87.78,
      "duration_seconds": 8.94,
      "text": "I haven't had swollen glands, other new lumps, family history of skin cancer or pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 92.61,
      "duration_seconds": 3.14,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.67,
      "end_seconds": 97.92,
      "duration_seconds": 3.25,
      "text": "Let me think, I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.59,
      "end_seconds": 111.75,
      "duration_seconds": 4.16,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.54,
      "end_seconds": 116.37,
      "duration_seconds": 2.83,
      "text": "An irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.55,
      "end_seconds": 122.64,
      "duration_seconds": 5.09,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.95,
      "end_seconds": 128.47,
      "duration_seconds": 4.52,
      "text": "It's bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.58,
      "end_seconds": 148.92,
      "duration_seconds": 4.34,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.51,
      "end_seconds": 154.19,
      "duration_seconds": 4.68,
      "text": "No, you know, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 158.13,
      "duration_seconds": 2.42,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.41,
      "end_seconds": 160.64,
      "duration_seconds": 1.23,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 162.74,
      "duration_seconds": 1.24,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.49,
      "end_seconds": 167.64,
      "duration_seconds": 3.15,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.37,
      "end_seconds": 172.3,
      "duration_seconds": 2.93,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.62,
      "end_seconds": 177.01,
      "duration_seconds": 3.39,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 180.87,
      "duration_seconds": 2.37,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.73,
      "end_seconds": 185.71,
      "duration_seconds": 3.98,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.94,
      "end_seconds": 192.57,
      "duration_seconds": 4.63,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.52,
      "end_seconds": 194.91,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.64,
      "end_seconds": 215.19,
      "duration_seconds": 7.55,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.84,
      "end_seconds": 220.77,
      "duration_seconds": 1.93,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 242.27,
      "duration_seconds": 10.42,
      "text": "Taking everything into account, I don't have a clear answer today: a likely basal cell carcinoma is possible, and so is a squamous cell carcinoma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.36,
      "end_seconds": 246.68,
      "duration_seconds": 2.32,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 279.41,
      "duration_seconds": 26.42,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely basal cell carcinoma, but I'd like to confirm. I want a dermoscopy done, that's for suspicious lesion. Please use a high-factor sunscreen and a hat. I'm going to send a referral to the skin cancer clinic. I'm not ordering a skin biopsy today. If things carry on in two weeks, we'll consider it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.12,
      "end_seconds": 289.2,
      "duration_seconds": 8.08,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.89,
      "end_seconds": 296.95,
      "duration_seconds": 2.06,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.62,
      "end_seconds": 302.7,
      "duration_seconds": 5.08,
      "text": "I'd like you back after the biopsy. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.23,
      "end_seconds": 306.32,
      "duration_seconds": 2.09,
      "text": "Thank you, that's helpful."
    }
  ]
}