{
  "schema_version": "1.0",
  "encounter_id": "03016",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 5.11,
      "duration_seconds": 4.25,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.89,
      "end_seconds": 10.77,
      "duration_seconds": 4.88,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.26,
      "end_seconds": 22.34,
      "duration_seconds": 7.08,
      "text": "It's shortness of breath, mostly. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 24.2,
      "end_seconds": 31.53,
      "duration_seconds": 7.33,
      "text": "Here are the numbers, doctor. Pulse 101, oxygen saturation is 98 percent, BP is 98 over 56."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 37.25,
      "duration_seconds": 4.61,
      "text": "Okay, noted. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.72,
      "end_seconds": 47.65,
      "duration_seconds": 6.93,
      "text": "It's been six months, I'm fairly sure. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.65,
      "end_seconds": 57.45,
      "duration_seconds": 7.8,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.06,
      "end_seconds": 77.68,
      "duration_seconds": 19.62,
      "text": "Actually, um, pretty severe, if I'm being honest. Sitting forward helps a bit. I've been reading about it online and it worried me. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.42,
      "end_seconds": 81.41,
      "duration_seconds": 2.99,
      "text": "Alright, have you been feeling faint?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.92,
      "end_seconds": 92.77,
      "duration_seconds": 9.85,
      "text": "Ah, yes, about the same, about two weeks. Ah, I've had chest pain too, for about three months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.18,
      "end_seconds": 104.08,
      "duration_seconds": 2.9,
      "text": "Any leg swelling, cough or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.65,
      "end_seconds": 107.6,
      "duration_seconds": 2.95,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.54,
      "end_seconds": 111.81,
      "duration_seconds": 2.27,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.48,
      "end_seconds": 116.6,
      "duration_seconds": 3.12,
      "text": "Right, no, skin's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.4,
      "end_seconds": 121.22,
      "duration_seconds": 2.82,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.24,
      "end_seconds": 125.32,
      "duration_seconds": 3.08,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 130.98,
      "duration_seconds": 4.62,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.81,
      "end_seconds": 135.15,
      "duration_seconds": 3.34,
      "text": "Heart failure, for about a year."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 142.03,
      "duration_seconds": 5.6,
      "text": "I follow. Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.55,
      "end_seconds": 162.12,
      "duration_seconds": 4.57,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.48,
      "end_seconds": 166.57,
      "duration_seconds": 3.09,
      "text": "Well, my mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.35,
      "end_seconds": 174.56,
      "duration_seconds": 4.21,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.69,
      "end_seconds": 181.07,
      "duration_seconds": 5.38,
      "text": "Ah, I'm allergic to cat fur, I get sneezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 184.94,
      "duration_seconds": 2.36,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.57,
      "end_seconds": 191.59,
      "duration_seconds": 6.02,
      "text": "Let me think, um, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.57,
      "end_seconds": 195.95,
      "duration_seconds": 2.38,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.48,
      "end_seconds": 205.09,
      "duration_seconds": 7.61,
      "text": "I, I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.59,
      "end_seconds": 208.98,
      "duration_seconds": 2.39,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 229.52,
      "duration_seconds": 15.59,
      "text": "Lots of rice, lentils and some fruit. My husband and I live above the shop. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.04,
      "end_seconds": 233.11,
      "duration_seconds": 2.07,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.02,
      "end_seconds": 237.17,
      "duration_seconds": 2.15,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.37,
      "end_seconds": 251.13,
      "duration_seconds": 6.76,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.61,
      "end_seconds": 265.53,
      "duration_seconds": 10.92,
      "text": "All finished, thank you. Right, here's what I'm thinking. I'd lean towards possible cardiac tamponade. A heart attack is also on my list."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.81,
      "end_seconds": 299.13,
      "duration_seconds": 16.32,
      "text": "Let's get an ECG, for chest pain. I'm sending you for an urgent echocardiogram because of possible tamponade. You need an urgent heart scan and possibly a drain. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.36,
      "end_seconds": 306.74,
      "duration_seconds": 7.38,
      "text": "Understood. I'd like you to see the cardiology team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.85,
      "end_seconds": 309.54,
      "duration_seconds": 1.69,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.31,
      "end_seconds": 322.52,
      "duration_seconds": 12.21,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.37,
      "end_seconds": 325.23,
      "duration_seconds": 1.86,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.23,
      "end_seconds": 327.67,
      "duration_seconds": 1.44,
      "text": "Look after yourself."
    }
  ]
}