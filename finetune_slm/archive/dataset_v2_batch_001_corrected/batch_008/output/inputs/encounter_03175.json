{
  "schema_version": "1.0",
  "encounter_id": "03175",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 6.96,
      "duration_seconds": 5.71,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.5,
      "end_seconds": 12.98,
      "duration_seconds": 4.48,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.95,
      "end_seconds": 20.59,
      "duration_seconds": 5.64,
      "text": "Actually, doctor, it's shaking. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 24.0,
      "duration_seconds": 1.94,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.9,
      "end_seconds": 31.57,
      "duration_seconds": 3.67,
      "text": "right, ever since... since last Tuesday, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.25,
      "end_seconds": 35.65,
      "duration_seconds": 3.4,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.86,
      "end_seconds": 38.34,
      "duration_seconds": 1.48,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.33,
      "end_seconds": 43.38,
      "duration_seconds": 4.05,
      "text": "What about being unable to sleep, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.17,
      "end_seconds": 52.39,
      "duration_seconds": 8.22,
      "text": "yes, for about four days with being unable to sleep, pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.94,
      "end_seconds": 57.48,
      "duration_seconds": 4.54,
      "text": "Mm, okay. Have you been feeling anxious and agitated?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.82,
      "end_seconds": 70.8,
      "duration_seconds": 11.98,
      "text": "Yes, you know, about the same, ten days. About feeling anxious and agitated, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.89,
      "end_seconds": 77.64,
      "duration_seconds": 4.75,
      "text": "Have you had shaking before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.7,
      "end_seconds": 83.75,
      "duration_seconds": 5.05,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.26,
      "end_seconds": 87.32,
      "duration_seconds": 2.06,
      "text": "Any confusion or vomiting blood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 91.52,
      "duration_seconds": 2.34,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 96.07,
      "duration_seconds": 3.34,
      "text": "Have you had any seeing things or seizure?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.08,
      "end_seconds": 101.24,
      "duration_seconds": 3.16,
      "text": "no, no seeing things or seizure"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.46,
      "end_seconds": 106.38,
      "duration_seconds": 3.92,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.1,
      "end_seconds": 111.35,
      "duration_seconds": 4.25,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.23,
      "end_seconds": 115.52,
      "duration_seconds": 2.29,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 120.29,
      "duration_seconds": 3.52,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.88,
      "end_seconds": 125.27,
      "duration_seconds": 3.39,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.18,
      "end_seconds": 129.23,
      "duration_seconds": 2.05,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.89,
      "end_seconds": 142.4,
      "duration_seconds": 4.51,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.08,
      "end_seconds": 158.32,
      "duration_seconds": 15.24,
      "text": "It's aspirin, 75 milligrams, once a day for my heart. Though honestly, some days I forget to take it. It's Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 163.79,
      "duration_seconds": 3.39,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.84,
      "end_seconds": 170.74,
      "duration_seconds": 1.9,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.07,
      "end_seconds": 175.35,
      "duration_seconds": 3.28,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.54,
      "end_seconds": 187.01,
      "duration_seconds": 10.47,
      "text": "Heart disease, for two years. I've got COPD. Um, I have an enlarged prostate, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.7,
      "end_seconds": 197.55,
      "duration_seconds": 8.85,
      "text": "yes, COPD and an enlarged prostate are known to us, good to have that clear any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.39,
      "end_seconds": 204.52,
      "duration_seconds": 6.13,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.78,
      "end_seconds": 208.19,
      "duration_seconds": 2.41,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.63,
      "end_seconds": 228.3,
      "duration_seconds": 18.67,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. I look after my grandchildren most days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.3,
      "end_seconds": 233.09,
      "duration_seconds": 3.79,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.11,
      "end_seconds": 241.45,
      "duration_seconds": 2.34,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.91,
      "end_seconds": 263.27,
      "duration_seconds": 8.36,
      "text": "Okay: oxygen saturation is 96 percent, heart rate 124, temp 36.6 degrees. And And blood pressure 133 over 86."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.9,
      "end_seconds": 268.38,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.15,
      "end_seconds": 272.55,
      "duration_seconds": 2.4,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.62,
      "end_seconds": 294.59,
      "duration_seconds": 5.97,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.12,
      "end_seconds": 303.02,
      "duration_seconds": 0.9,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.04,
      "end_seconds": 308.37,
      "duration_seconds": 2.33,
      "text": "Right, that's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.53,
      "end_seconds": 342.63,
      "duration_seconds": 20.1,
      "text": "Let's book blood tests to look into alcohol withdrawal. I'd like you to take chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. It's for alcohol withdrawal. Do not stop alcohol suddenly without medical support. Come back in two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.52,
      "end_seconds": 348.36,
      "duration_seconds": 3.84,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.73,
      "end_seconds": 358.44,
      "duration_seconds": 4.71,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.38,
      "end_seconds": 369.56,
      "duration_seconds": 10.18,
      "text": "So, I take the chlordiazepoxide, 20 milligrams, four times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.07,
      "end_seconds": 375.23,
      "duration_seconds": 5.16,
      "text": "Yes, exactly right. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.79,
      "end_seconds": 380.57,
      "duration_seconds": 4.78,
      "text": "Sorry, what was I saying, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.08,
      "end_seconds": 386.45,
      "duration_seconds": 1.37,
      "text": "Take care now."
    }
  ]
}