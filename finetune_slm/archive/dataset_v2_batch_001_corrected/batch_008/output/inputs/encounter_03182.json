{
  "schema_version": "1.0",
  "encounter_id": "03182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 4.36,
      "duration_seconds": 3.38,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.78,
      "end_seconds": 10.22,
      "duration_seconds": 4.44,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.01,
      "end_seconds": 20.53,
      "duration_seconds": 9.52,
      "text": "Good morning, doctor. I came along to help out. He's been having a pearly bump on my nose that bleeds, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.34,
      "end_seconds": 24.96,
      "duration_seconds": 3.62,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.04,
      "end_seconds": 34.96,
      "duration_seconds": 7.92,
      "text": "About... well, two weeks. I've also had a sore that won't heal, since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.15,
      "end_seconds": 39.33,
      "duration_seconds": 3.18,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.32,
      "end_seconds": 44.98,
      "duration_seconds": 4.66,
      "text": "It feels mild to me. And crusting, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.81,
      "end_seconds": 49.9,
      "duration_seconds": 3.09,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.78,
      "end_seconds": 53.27,
      "duration_seconds": 1.49,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.47,
      "end_seconds": 72.69,
      "duration_seconds": 2.22,
      "text": "And pain, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.12,
      "end_seconds": 76.37,
      "duration_seconds": 2.25,
      "text": "I haven't noticed any pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.07,
      "end_seconds": 84.78,
      "duration_seconds": 7.71,
      "text": "Let me check a few things. Any swollen glands, family history of skin cancer or other new lumps?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 93.21,
      "duration_seconds": 7.08,
      "text": "No swollen glands, family history of skin cancer or other new lumps, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.46,
      "end_seconds": 101.44,
      "duration_seconds": 3.98,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.49,
      "end_seconds": 105.35,
      "duration_seconds": 1.86,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.43,
      "end_seconds": 110.45,
      "duration_seconds": 3.02,
      "text": "Alright, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.17,
      "end_seconds": 113.64,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.75,
      "end_seconds": 118.42,
      "duration_seconds": 3.67,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.06,
      "end_seconds": 124.89,
      "duration_seconds": 4.83,
      "text": "My father has Parkinson's disease. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.44,
      "end_seconds": 128.7,
      "duration_seconds": 3.26,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.88,
      "end_seconds": 136.35,
      "duration_seconds": 4.47,
      "text": "I have heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.33,
      "end_seconds": 144.27,
      "duration_seconds": 6.94,
      "text": "I see, go ahead. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.45,
      "end_seconds": 148.41,
      "duration_seconds": 2.96,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 150.42,
      "end_seconds": 158.06,
      "duration_seconds": 7.64,
      "text": "Actually, I remember he had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.1,
      "end_seconds": 160.99,
      "duration_seconds": 1.89,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.5,
      "end_seconds": 168.51,
      "duration_seconds": 7.01,
      "text": "Fair enough, I'll write down both versions. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.69,
      "end_seconds": 187.8,
      "duration_seconds": 17.11,
      "text": "It's aspirin, 75 milligrams, once a day for my heart. I wasn't sure whether to come in at all, to be honest. I was on metoprolol before. I stopped taking it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.73,
      "end_seconds": 192.8,
      "duration_seconds": 3.07,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.89,
      "end_seconds": 198.3,
      "duration_seconds": 4.41,
      "text": "I, I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.45,
      "end_seconds": 201.84,
      "duration_seconds": 2.39,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.5,
      "end_seconds": 215.18,
      "duration_seconds": 11.68,
      "text": "I walk the dog every morning. My husband and I live above the shop. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 226.79,
      "end_seconds": 237.23,
      "duration_seconds": 10.44,
      "text": "Doctor, I've got the readings for you. Blood pressure 117 over 76, SpO2 97 percent on room air, pulse 76, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.66,
      "end_seconds": 239.36,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.27,
      "end_seconds": 244.63,
      "duration_seconds": 3.36,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.97,
      "end_seconds": 247.99,
      "duration_seconds": 2.02,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 262.46,
      "duration_seconds": 7.41,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.32,
      "end_seconds": 276.02,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 298.29,
      "duration_seconds": 19.24,
      "text": "Okay, that's enough for me. Okay, so my impression is this: This looks most like a likely basal cell carcinoma. I want to be honest that this is an impression, not a final answer. A squamous cell carcinoma is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.26,
      "end_seconds": 302.4,
      "duration_seconds": 3.14,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.1,
      "end_seconds": 323.99,
      "duration_seconds": 19.89,
      "text": "It's reasonable to be concerned, but right now a likely basal cell carcinoma is my leading thought, not anything worse. So, to recap quickly. You've had a pearly bump on your nose that bleeds for two weeks, and no family history of skin cancer or pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.65,
      "end_seconds": 327.65,
      "duration_seconds": 2.0,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.03,
      "end_seconds": 331.88,
      "duration_seconds": 2.85,
      "text": "Let's get a dermoscopy, for suspicious lesion."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.02,
      "end_seconds": 334.09,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.63,
      "end_seconds": 363.35,
      "duration_seconds": 28.72,
      "text": "We should do a skin biopsy for suspicious lesion. That will help us see what's going on underneath and decide the next step. Please use a high-factor sunscreen and a hat. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like to see you again after the biopsy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.62,
      "end_seconds": 366.63,
      "duration_seconds": 2.01,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.9,
      "end_seconds": 374.19,
      "duration_seconds": 6.29,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.22,
      "end_seconds": 381.39,
      "duration_seconds": 5.17,
      "text": "So, I come back after the biopsy. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.26,
      "end_seconds": 388.04,
      "duration_seconds": 5.78,
      "text": "Okay, yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.87,
      "end_seconds": 394.02,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.16,
      "end_seconds": 396.43,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}