{
  "schema_version": "1.0",
  "encounter_id": "03410",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 5.77,
      "duration_seconds": 4.82,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.37,
      "duration_seconds": 4.43,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.58,
      "end_seconds": 18.4,
      "duration_seconds": 5.82,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.2,
      "end_seconds": 26.79,
      "duration_seconds": 6.59,
      "text": "It's flakes on my shoulders, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.89,
      "end_seconds": 29.34,
      "duration_seconds": 1.45,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.34,
      "end_seconds": 33.71,
      "duration_seconds": 2.37,
      "text": "Probably about a month. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.75,
      "end_seconds": 38.47,
      "duration_seconds": 2.72,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.53,
      "end_seconds": 51.1,
      "duration_seconds": 10.57,
      "text": "Maybe a six out of ten on a bad day. I've also had an itchy scalp, for five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 52.19,
      "end_seconds": 55.22,
      "duration_seconds": 3.03,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.23,
      "end_seconds": 57.45,
      "duration_seconds": 1.22,
      "text": "Nothing like pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.08,
      "end_seconds": 60.85,
      "duration_seconds": 1.77,
      "text": "No pain, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.93,
      "end_seconds": 66.71,
      "duration_seconds": 3.78,
      "text": "Have you noticed hair loss, rash elsewhere or pus?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.95,
      "end_seconds": 82.95,
      "duration_seconds": 15.0,
      "text": "No, you know, no hair loss, no rash elsewhere, no pus. I did have a little redness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 87.68,
      "duration_seconds": 3.28,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.04,
      "end_seconds": 90.63,
      "duration_seconds": 1.59,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.22,
      "end_seconds": 96.04,
      "duration_seconds": 0.82,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.12,
      "end_seconds": 101.89,
      "duration_seconds": 3.77,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.39,
      "end_seconds": 105.05,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.23,
      "end_seconds": 108.61,
      "duration_seconds": 2.38,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.99,
      "end_seconds": 113.89,
      "duration_seconds": 3.9,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.49,
      "end_seconds": 123.92,
      "duration_seconds": 9.43,
      "text": "So, I take something called febu... febuxostat, 80 milligrams, maybe, once a day for the gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.51,
      "end_seconds": 130.01,
      "duration_seconds": 4.5,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.89,
      "end_seconds": 135.04,
      "duration_seconds": 4.15,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.18,
      "end_seconds": 144.64,
      "duration_seconds": 8.46,
      "text": "It's a... um, uh, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 148.53,
      "duration_seconds": 2.86,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.38,
      "end_seconds": 163.81,
      "duration_seconds": 13.43,
      "text": "For the anxiety, I believe. My wife sets them out for me, I just take what I'm given. Before this I was on allopurinol; that's been stopped."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.68,
      "end_seconds": 182.22,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.54,
      "end_seconds": 196.94,
      "duration_seconds": 13.4,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.66,
      "end_seconds": 202.07,
      "duration_seconds": 3.41,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.92,
      "end_seconds": 208.12,
      "duration_seconds": 5.2,
      "text": "My grandmother had dementia. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.69,
      "end_seconds": 211.03,
      "duration_seconds": 2.34,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.71,
      "end_seconds": 221.81,
      "duration_seconds": 5.1,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 227.09,
      "duration_seconds": 3.86,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.04,
      "end_seconds": 231.98,
      "duration_seconds": 2.94,
      "text": "I have gout. Yes, anxiety."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.14,
      "end_seconds": 246.78,
      "duration_seconds": 9.64,
      "text": "Right, so gout is already on your record. We'll keep that in mind today. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.72,
      "end_seconds": 258.16,
      "duration_seconds": 2.44,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 285.13,
      "duration_seconds": 9.67,
      "text": "Okay: blood pressure 125 over 68, temperature is 36.9 degrees, oxygen saturation is 99 percent. And respiratory rate 17, pulse 78."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.05,
      "end_seconds": 288.42,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.72,
      "end_seconds": 293.21,
      "duration_seconds": 3.49,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.37,
      "end_seconds": 296.44,
      "duration_seconds": 2.07,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.38,
      "end_seconds": 299.41,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.18,
      "end_seconds": 323.09,
      "duration_seconds": 4.91,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.14,
      "end_seconds": 329.5,
      "duration_seconds": 2.36,
      "text": "Right, you can relax now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.34,
      "end_seconds": 363.42,
      "duration_seconds": 24.08,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be simple dandruff, or it might be seborrhoeic dermatitis. What I'm giving you is ketoconazole shampoo, 2%, twice a week, four weeks. That should help with dandruff. The pharmacy will go through the details again when you pick it up. Leave the shampoo on for five minutes before rinsing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.36,
      "end_seconds": 373.91,
      "duration_seconds": 8.55,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.25,
      "end_seconds": 379.25,
      "duration_seconds": 4.0,
      "text": "Erm, uh, thank you, that's clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.26,
      "end_seconds": 389.42,
      "duration_seconds": 9.16,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.16,
      "end_seconds": 395.11,
      "duration_seconds": 3.95,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}