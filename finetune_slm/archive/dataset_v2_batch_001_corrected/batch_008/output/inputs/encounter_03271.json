{
  "schema_version": "1.0",
  "encounter_id": "03271",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 7.24,
      "duration_seconds": 6.31,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.13,
      "end_seconds": 12.54,
      "duration_seconds": 4.41,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.36,
      "end_seconds": 17.48,
      "duration_seconds": 3.12,
      "text": "I'm here because of a fever."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.83,
      "end_seconds": 21.41,
      "duration_seconds": 2.58,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.83,
      "end_seconds": 28.12,
      "duration_seconds": 2.29,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.62,
      "end_seconds": 40.26,
      "duration_seconds": 11.64,
      "text": "I see, go ahead. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 46.09,
      "duration_seconds": 5.07,
      "text": "It sort of comes and goes. It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.3,
      "end_seconds": 49.68,
      "duration_seconds": 2.38,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.97,
      "end_seconds": 67.18,
      "duration_seconds": 12.21,
      "text": "When it starts I tend to get trouble passing urine as well. Actually, the trouble passing urine? That's been for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.88,
      "end_seconds": 71.13,
      "duration_seconds": 3.25,
      "text": "Has there been weakness in the legs too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.28,
      "end_seconds": 77.37,
      "duration_seconds": 2.09,
      "text": "Yes, for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.8,
      "end_seconds": 82.7,
      "duration_seconds": 3.9,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.72,
      "end_seconds": 88.13,
      "duration_seconds": 3.41,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.82,
      "end_seconds": 95.2,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.16,
      "end_seconds": 99.37,
      "duration_seconds": 2.21,
      "text": "It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.08,
      "end_seconds": 101.46,
      "duration_seconds": 1.38,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.99,
      "end_seconds": 106.9,
      "duration_seconds": 3.91,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.64,
      "end_seconds": 112.46,
      "duration_seconds": 2.82,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.36,
      "end_seconds": 117.9,
      "duration_seconds": 3.54,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.81,
      "end_seconds": 122.55,
      "duration_seconds": 2.74,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.06,
      "end_seconds": 127.56,
      "duration_seconds": 4.5,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.24,
      "end_seconds": 130.47,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.24,
      "end_seconds": 138.81,
      "duration_seconds": 3.57,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.05,
      "end_seconds": 150.47,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.68,
      "end_seconds": 154.83,
      "duration_seconds": 3.15,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.35,
      "end_seconds": 159.55,
      "duration_seconds": 4.2,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.69,
      "end_seconds": 164.98,
      "duration_seconds": 4.29,
      "text": "Mm, um, I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.14,
      "end_seconds": 181.21,
      "duration_seconds": 5.07,
      "text": "Have you had any weight loss, recent fall or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.42,
      "end_seconds": 190.31,
      "duration_seconds": 5.89,
      "text": "No weight loss, recent fall or chest pain, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.93,
      "end_seconds": 194.31,
      "duration_seconds": 3.38,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.0,
      "end_seconds": 197.36,
      "duration_seconds": 2.36,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.53,
      "end_seconds": 201.66,
      "duration_seconds": 3.13,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.63,
      "end_seconds": 218.08,
      "duration_seconds": 2.45,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.67,
      "end_seconds": 247.49,
      "duration_seconds": 8.82,
      "text": "Okay: heart rate 96, height 173 centimetres, temperature is 38.9 degrees. And weight 74 kilos, BP is 105 over 75."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.65,
      "end_seconds": 253.08,
      "duration_seconds": 4.43,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.16,
      "end_seconds": 257.18,
      "duration_seconds": 3.02,
      "text": "So, I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.04,
      "end_seconds": 281.31,
      "duration_seconds": 6.27,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.13,
      "end_seconds": 297.95,
      "duration_seconds": 12.82,
      "text": "Okay, that's enough for me. Okay, so my impression is this: I can't pin this down yet. We're looking at a possible spinal infection pressing on the nerves or a slipped disc."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.82,
      "end_seconds": 312.77,
      "duration_seconds": 5.95,
      "text": "I'll request an urgent MRI of the spine, it'll help with possible epidural abscess."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.74,
      "end_seconds": 315.38,
      "duration_seconds": 1.64,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.92,
      "end_seconds": 321.47,
      "duration_seconds": 5.55,
      "text": "I want urgent blood tests done, that's for possible spinal infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.22,
      "end_seconds": 323.34,
      "duration_seconds": 1.12,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.04,
      "end_seconds": 338.77,
      "duration_seconds": 14.73,
      "text": "You are going to hospital now, this can cause permanent weakness. I think the spinal team should see you too. Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.72,
      "end_seconds": 342.01,
      "duration_seconds": 2.29,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.71,
      "end_seconds": 344.15,
      "duration_seconds": 1.44,
      "text": "Goodbye for now."
    }
  ]
