{
  "schema_version": "1.0",
  "encounter_id": "03373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 6.69,
      "duration_seconds": 5.77,
      "text": "Hi, you know, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 12.19,
      "duration_seconds": 4.04,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.46,
      "end_seconds": 30.92,
      "duration_seconds": 17.46,
      "text": "Mainly vomiting once or twice. There's a couple of other things, but that's the main one. I took the morning off to come in today. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.38,
      "end_seconds": 37.2,
      "duration_seconds": 4.82,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.32,
      "end_seconds": 49.81,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.43,
      "end_seconds": 77.93,
      "duration_seconds": 9.5,
      "text": "Okay: blood pressure 109 over 75, heart rate 84. And temp 36.6 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 81.08,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.85,
      "end_seconds": 85.68,
      "duration_seconds": 3.83,
      "text": "We'll look at it together shortly. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.02,
      "end_seconds": 92.74,
      "duration_seconds": 5.72,
      "text": "Around three days... no wait, it's more like ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 97.26,
      "duration_seconds": 3.0,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 100.78,
      "duration_seconds": 2.14,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.45,
      "end_seconds": 104.93,
      "duration_seconds": 3.48,
      "text": "So, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.85,
      "end_seconds": 113.47,
      "duration_seconds": 6.62,
      "text": "It usually comes with a mild tummy ache. About mild tummy ache, mild, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 133.32,
      "duration_seconds": 4.75,
      "text": "Any blood in the stool, high fever or no wet nappies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.35,
      "end_seconds": 141.39,
      "duration_seconds": 7.04,
      "text": "I haven't had blood in the stool, high fever or no wet nappies, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 144.45,
      "duration_seconds": 2.84,
      "text": "Yes, carry on. Nothing like drowsiness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.01,
      "end_seconds": 147.36,
      "duration_seconds": 2.35,
      "text": "No, none, no drowsiness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.46,
      "end_seconds": 152.82,
      "duration_seconds": 3.36,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.13,
      "end_seconds": 156.31,
      "duration_seconds": 2.18,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.35,
      "end_seconds": 169.4,
      "duration_seconds": 3.05,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.15,
      "end_seconds": 174.24,
      "duration_seconds": 3.09,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.25,
      "end_seconds": 184.58,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.48,
      "end_seconds": 188.56,
      "duration_seconds": 2.08,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.89,
      "duration_seconds": 2.66,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.41,
      "end_seconds": 215.86,
      "duration_seconds": 15.45,
      "text": "I smoke roughly a pack every two days. My partner and our baby. I grab fast food at lunch most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.33,
      "end_seconds": 220.56,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.27,
      "end_seconds": 233.91,
      "duration_seconds": 11.64,
      "text": "I'm on aspirin, 75 milligrams, once a day for my heart. I'm on oral rehydration solution, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.94,
      "end_seconds": 238.11,
      "duration_seconds": 2.17,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.65,
      "end_seconds": 242.5,
      "duration_seconds": 2.85,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.58,
      "end_seconds": 248.71,
      "duration_seconds": 4.13,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.54,
      "end_seconds": 253.5,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.84,
      "end_seconds": 256.49,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.45,
      "end_seconds": 277.75,
      "duration_seconds": 5.3,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.57,
      "end_seconds": 313.77,
      "duration_seconds": 31.2,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I think we're dealing with a mild stomach bug at this stage. The reason I say that is that your story and my examination fit together. Let me just check I've got this right. You've had vomiting once or twice for ten days, severe, and no no wet nappies or blood in the stool."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.63,
      "end_seconds": 316.74,
      "duration_seconds": 2.11,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.46,
      "end_seconds": 331.26,
      "duration_seconds": 12.8,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. If he stops drinking or becomes drowsy, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.57,
      "end_seconds": 334.62,
      "duration_seconds": 2.05,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.38,
      "end_seconds": 338.79,
      "duration_seconds": 3.41,
      "text": "So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.66,
      "end_seconds": 344.17,
      "duration_seconds": 3.51,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}