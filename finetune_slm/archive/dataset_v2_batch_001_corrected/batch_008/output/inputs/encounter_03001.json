{
  "schema_version": "1.0",
  "encounter_id": "03001",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.07,
      "end_seconds": 8.8,
      "duration_seconds": 7.73,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.35,
      "end_seconds": 13.46,
      "duration_seconds": 4.11,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.64,
      "end_seconds": 19.26,
      "duration_seconds": 4.62,
      "text": "Actually, I wanted to get a swollen calf looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 24.93,
      "duration_seconds": 4.28,
      "text": "Okay, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.9,
      "end_seconds": 40.11,
      "duration_seconds": 13.21,
      "text": "It's been four weeks now. I've never really been one for hospitals. Oh, and sharp chest pain on breathing in. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.44,
      "end_seconds": 65.36,
      "duration_seconds": 6.92,
      "text": "Let me check a few things. Any fever, wound problem or coughing up blood?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.41,
      "end_seconds": 73.28,
      "duration_seconds": 6.87,
      "text": "Let me think, no, no fever, wound problem or coughing up blood."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.66,
      "end_seconds": 77.12,
      "duration_seconds": 2.46,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.02,
      "end_seconds": 79.51,
      "duration_seconds": 1.49,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.12,
      "end_seconds": 87.42,
      "duration_seconds": 7.3,
      "text": "Let me ask about allergies, anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.45,
      "end_seconds": 93.48,
      "duration_seconds": 4.03,
      "text": "Uh, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.46,
      "end_seconds": 98.87,
      "duration_seconds": 3.41,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.68,
      "end_seconds": 104.44,
      "duration_seconds": 3.76,
      "text": "Mm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.99,
      "end_seconds": 109.29,
      "duration_seconds": 3.3,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.96,
      "end_seconds": 114.36,
      "duration_seconds": 4.4,
      "text": "Apixaban. I take it 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.29,
      "end_seconds": 123.99,
      "duration_seconds": 3.7,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.22,
      "end_seconds": 128.28,
      "duration_seconds": 3.06,
      "text": "An irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.36,
      "end_seconds": 131.06,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 145.53,
      "duration_seconds": 4.95,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.05,
      "end_seconds": 157.06,
      "duration_seconds": 11.01,
      "text": "I have about eight cigarettes in a day. I grab fast food at lunch most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 158.9,
      "end_seconds": 169.42,
      "duration_seconds": 10.52,
      "text": "Here are the numbers, doctor. SpO2 92 percent on room air, pressure 126 over 81, temp 37.3 degrees, pulse is 95 beats a minute."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.18,
      "end_seconds": 171.2,
      "duration_seconds": 1.02,
      "text": "So, thanks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 179.31,
      "duration_seconds": 5.27,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.25,
      "end_seconds": 188.19,
      "duration_seconds": 0.94,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.63,
      "end_seconds": 192.78,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.44,
      "end_seconds": 207.31,
      "duration_seconds": 4.87,
      "text": "Your left calf is swollen and tender and your oxygen is low."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.36,
      "end_seconds": 219.53,
      "duration_seconds": 10.17,
      "text": "You can relax now. So, based on the history and the examination, it points towards a possible blood clot in the lung after surgery."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.32,
      "end_seconds": 224.56,
      "duration_seconds": 3.24,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.45,
      "end_seconds": 238.69,
      "duration_seconds": 13.24,
      "text": "I understand the worry. At the moment I'd say it's a possible blood clot in the lung after surgery, and we'll know more once the a D-dimer is back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.43,
      "end_seconds": 251.57,
      "duration_seconds": 4.14,
      "text": "I think a D-dimer makes sense here, for possible clot."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.36,
      "end_seconds": 253.39,
      "duration_seconds": 1.03,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 273.54,
      "duration_seconds": 18.28,
      "text": "Let's book a CT pulmonary angiogram to look into possible pulmonary embolus. That will help us see what's going on underneath and decide the next step. Let's use enoxaparin, 1.5 mg per kg, once now, single dose. That's for possible clot."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.68,
      "end_seconds": 279.28,
      "duration_seconds": 4.6,
      "text": "Let me think, how soon will it work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.31,
      "end_seconds": 305.09,
      "duration_seconds": 23.78,
      "text": "Please go to hospital now, I will call ahead. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.31,
      "end_seconds": 312.36,
      "duration_seconds": 3.05,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.17,
      "end_seconds": 314.65,
      "duration_seconds": 1.48,
      "text": "See you soon."
    }
  ]
}