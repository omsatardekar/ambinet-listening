{
  "schema_version": "1.0",
  "encounter_id": "03368",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 7.1,
      "duration_seconds": 6.59,
      "text": "Right, thanks for waiting, come in. Was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.26,
      "end_seconds": 12.63,
      "duration_seconds": 4.37,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.49,
      "end_seconds": 15.2,
      "duration_seconds": 1.71,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.78,
      "end_seconds": 24.96,
      "duration_seconds": 6.18,
      "text": "Actually, I wanted to get three early losses looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.64,
      "end_seconds": 28.57,
      "duration_seconds": 2.93,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.24,
      "end_seconds": 34.66,
      "duration_seconds": 4.42,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.34,
      "end_seconds": 40.11,
      "duration_seconds": 4.77,
      "text": "Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.17,
      "end_seconds": 43.95,
      "duration_seconds": 1.78,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.34,
      "end_seconds": 48.49,
      "duration_seconds": 3.15,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.01,
      "end_seconds": 57.54,
      "duration_seconds": 8.53,
      "text": "Let me think, when it starts I tend to get irregular cycles as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.62,
      "end_seconds": 62.49,
      "duration_seconds": 2.87,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.01,
      "end_seconds": 71.83,
      "duration_seconds": 2.82,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 96.63,
      "duration_seconds": 11.7,
      "text": "Okay: oxygen saturation is 98 percent, respiratory rate 14, blood pressure 118 over 78, pulse is 83 beats a minute, temperature 36.8."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.51,
      "end_seconds": 103.53,
      "duration_seconds": 4.02,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.43,
      "end_seconds": 107.0,
      "duration_seconds": 1.57,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.7,
      "end_seconds": 122.56,
      "duration_seconds": 1.86,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.59,
      "end_seconds": 133.19,
      "duration_seconds": 5.6,
      "text": "That's all I needed to check. Did you get fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.31,
      "end_seconds": 139.89,
      "duration_seconds": 5.58,
      "text": "I, I haven't had fever or heavy bleeding now, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.73,
      "end_seconds": 144.69,
      "duration_seconds": 3.96,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.34,
      "end_seconds": 152.69,
      "duration_seconds": 3.35,
      "text": "Erm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 163.65,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.61,
      "end_seconds": 168.48,
      "duration_seconds": 2.87,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.32,
      "end_seconds": 173.82,
      "duration_seconds": 3.5,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.84,
      "end_seconds": 178.42,
      "duration_seconds": 3.58,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.18,
      "end_seconds": 183.13,
      "duration_seconds": 2.95,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 187.06,
      "duration_seconds": 3.42,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.63,
      "end_seconds": 202.72,
      "duration_seconds": 2.09,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.3,
      "end_seconds": 215.2,
      "duration_seconds": 10.9,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety. Ah, though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 221.88,
      "duration_seconds": 5.98,
      "text": "Do you have any chronic illnesses? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.14,
      "end_seconds": 224.98,
      "duration_seconds": 1.84,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 229.52,
      "duration_seconds": 3.63,
      "text": "Hm, okay. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.38,
      "end_seconds": 239.1,
      "duration_seconds": 8.72,
      "text": "So, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.36,
      "end_seconds": 250.4,
      "duration_seconds": 10.04,
      "text": "Okay, so my impression is this: I'd lean towards recurrent miscarriage needing investigation. An antiphospholipid problem is also on my list."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.33,
      "end_seconds": 254.36,
      "duration_seconds": 3.03,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.15,
      "end_seconds": 267.4,
      "duration_seconds": 11.25,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.72,
      "end_seconds": 287.76,
      "duration_seconds": 4.04,
      "text": "I'll request blood tests, it'll help with recurrent miscarriage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.68,
      "end_seconds": 292.5,
      "duration_seconds": 2.82,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.71,
      "end_seconds": 317.71,
      "duration_seconds": 24.0,
      "text": "We should do a pelvic ultrasound for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'll want another look after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.62,
      "end_seconds": 322.41,
      "duration_seconds": 2.79,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.92,
      "end_seconds": 324.09,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}