{
  "schema_version": "1.0",
  "encounter_id": "03430",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.01,
      "duration_seconds": 3.45,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.72,
      "end_seconds": 10.4,
      "duration_seconds": 4.68,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.77,
      "end_seconds": 19.52,
      "duration_seconds": 7.75,
      "text": "Mainly nausea after the chemotherapy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.77,
      "end_seconds": 32.63,
      "duration_seconds": 11.86,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.13,
      "end_seconds": 44.94,
      "duration_seconds": 8.81,
      "text": "Only antisickness tablets, and it's not much. I'd say on and off. And numb fingertips, too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.14,
      "end_seconds": 48.32,
      "duration_seconds": 2.18,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.9,
      "end_seconds": 51.29,
      "duration_seconds": 1.39,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.06,
      "end_seconds": 56.03,
      "duration_seconds": 2.97,
      "text": "Have you noticed breathlessness, bleeding or shivering?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.24,
      "end_seconds": 62.27,
      "duration_seconds": 5.03,
      "text": "Well, no breathlessness, bleeding or shivering, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.08,
      "end_seconds": 65.93,
      "duration_seconds": 2.85,
      "text": "So, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.14,
      "end_seconds": 68.81,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.42,
      "end_seconds": 73.44,
      "duration_seconds": 3.02,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.29,
      "end_seconds": 77.4,
      "duration_seconds": 2.11,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 84.02,
      "duration_seconds": 5.98,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.88,
      "end_seconds": 88.68,
      "duration_seconds": 3.8,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.69,
      "end_seconds": 99.83,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.86,
      "end_seconds": 111.68,
      "duration_seconds": 9.82,
      "text": "Alendronate. I take it 70 milligrams, once a week for my bones. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 114.26,
      "duration_seconds": 1.33,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.29,
      "end_seconds": 119.39,
      "duration_seconds": 3.1,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.18,
      "end_seconds": 123.57,
      "duration_seconds": 3.39,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.43,
      "end_seconds": 128.62,
      "duration_seconds": 4.19,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.26,
      "end_seconds": 132.04,
      "duration_seconds": 1.78,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.52,
      "end_seconds": 135.81,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.22,
      "end_seconds": 147.42,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.5,
      "end_seconds": 150.84,
      "duration_seconds": 2.34,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.03,
      "end_seconds": 154.98,
      "duration_seconds": 2.95,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.97,
      "end_seconds": 160.84,
      "duration_seconds": 4.87,
      "text": "Anxiety, for five years. I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.53,
      "end_seconds": 170.71,
      "duration_seconds": 8.18,
      "text": "Alright, anxiety and thin bones, that matches what I have here. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.65,
      "end_seconds": 180.68,
      "duration_seconds": 3.03,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.92,
      "end_seconds": 196.92,
      "duration_seconds": 7.0,
      "text": "Okay: respiratory rate 16, oxygen saturation is 97 percent, pressure 115 over 73, pulse 66."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.46,
      "end_seconds": 199.0,
      "duration_seconds": 1.54,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.77,
      "end_seconds": 203.44,
      "duration_seconds": 2.67,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.73,
      "end_seconds": 208.67,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.94,
      "end_seconds": 211.72,
      "duration_seconds": 1.78,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.29,
      "end_seconds": 232.1,
      "duration_seconds": 4.81,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.85,
      "end_seconds": 238.64,
      "duration_seconds": 2.79,
      "text": "So, you can sit up now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.75,
      "end_seconds": 268.69,
      "duration_seconds": 13.94,
      "text": "Let me tell you where I've got to. I think we're dealing with expected chemotherapy side effects at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.54,
      "end_seconds": 272.78,
      "duration_seconds": 2.24,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.76,
      "end_seconds": 292.5,
      "duration_seconds": 13.74,
      "text": "It's reasonable to be concerned, but right now expected chemotherapy side effects is my leading thought, not anything worse. Let's book a blood count to look into chemotherapy monitoring."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.5,
      "end_seconds": 295.77,
      "duration_seconds": 2.27,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.55,
      "end_seconds": 301.42,
      "duration_seconds": 4.87,
      "text": "Do get help quickly if your temperature is 37.5 or above."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.47,
      "end_seconds": 305.42,
      "duration_seconds": 2.95,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.43,
      "end_seconds": 310.0,
      "duration_seconds": 3.57,
      "text": "I'll want another look before the next cycle."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.08,
      "end_seconds": 312.78,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.25,
      "end_seconds": 316.6,
      "duration_seconds": 2.35,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.62,
      "end_seconds": 321.81,
      "duration_seconds": 3.19,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}