{
  "schema_version": "1.0",
  "encounter_id": "03251",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 6.69,
      "duration_seconds": 5.76,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.51,
      "end_seconds": 12.92,
      "duration_seconds": 4.41,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 20.39,
      "duration_seconds": 6.78,
      "text": "Honestly, it's being found cold and drowsy, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.52,
      "end_seconds": 23.12,
      "duration_seconds": 1.6,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.92,
      "end_seconds": 26.71,
      "duration_seconds": 1.79,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.5,
      "end_seconds": 31.59,
      "duration_seconds": 3.09,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.6,
      "end_seconds": 33.62,
      "duration_seconds": 1.02,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.27,
      "end_seconds": 37.06,
      "duration_seconds": 2.79,
      "text": "Has there been slurred speech too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.16,
      "end_seconds": 41.62,
      "duration_seconds": 3.46,
      "text": "Yes, about the same, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.36,
      "end_seconds": 46.24,
      "duration_seconds": 3.88,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.1,
      "end_seconds": 51.58,
      "duration_seconds": 3.48,
      "text": "Well, it feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 57.59,
      "duration_seconds": 4.68,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.92,
      "end_seconds": 62.44,
      "duration_seconds": 3.52,
      "text": "Omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.43,
      "end_seconds": 69.17,
      "duration_seconds": 4.74,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.3,
      "end_seconds": 73.87,
      "duration_seconds": 3.57,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.97,
      "end_seconds": 78.36,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.26,
      "end_seconds": 82.98,
      "duration_seconds": 2.72,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 87.0,
      "duration_seconds": 3.45,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.16,
      "end_seconds": 97.71,
      "duration_seconds": 5.55,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.61,
      "end_seconds": 121.39,
      "duration_seconds": 5.78,
      "text": "Right, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.31,
      "end_seconds": 132.34,
      "duration_seconds": 10.03,
      "text": "Lots of rice, lentils and some fruit. I walk the dog every morning. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.65,
      "end_seconds": 148.26,
      "duration_seconds": 4.61,
      "text": "Alright, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.27,
      "end_seconds": 151.97,
      "duration_seconds": 2.7,
      "text": "I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.03,
      "end_seconds": 157.56,
      "duration_seconds": 4.53,
      "text": "I see, go ahead. Did you notice any alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.52,
      "end_seconds": 160.03,
      "duration_seconds": 1.51,
      "text": "Nope, no alcohol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.75,
      "end_seconds": 165.91,
      "duration_seconds": 4.16,
      "text": "Alright, a few quick ones: fall or head injury?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.91,
      "end_seconds": 171.67,
      "duration_seconds": 3.76,
      "text": "I haven't had fall or head injury, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.5,
      "end_seconds": 175.59,
      "duration_seconds": 2.09,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.43,
      "end_seconds": 177.45,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.51,
      "end_seconds": 183.45,
      "duration_seconds": 3.94,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.21,
      "end_seconds": 196.6,
      "duration_seconds": 2.39,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.91,
      "end_seconds": 223.32,
      "duration_seconds": 7.41,
      "text": "Okay: saturation 99 percent, temp 36.8 degrees, heart rate 80, pressure 110 over 77."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.04,
      "end_seconds": 227.59,
      "duration_seconds": 2.55,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 231.51,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.18,
      "end_seconds": 250.04,
      "duration_seconds": 6.86,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.98,
      "end_seconds": 253.77,
      "duration_seconds": 1.79,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.39,
      "end_seconds": 268.62,
      "duration_seconds": 11.23,
      "text": "Thank you, you can get dressed. So where does that leave us? I'd lean towards severe hypothermia. It could also be hypoglycaemia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.23,
      "end_seconds": 271.5,
      "duration_seconds": 2.27,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.71,
      "end_seconds": 288.72,
      "duration_seconds": 16.01,
      "text": "I can't promise yet, but most people with severe hypothermia do well once it's treated properly. Stop me if I've got anything wrong. You've had being found cold and drowsy for one week, moderate, and no head injury or alcohol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.51,
      "end_seconds": 290.21,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 334.69,
      "duration_seconds": 28.38,
      "text": "I think an ECG makes sense here, for bradycardia. I think blood tests makes sense here, for hypothermia. I think a blood sugar makes sense here, for hypothermia. Handle gently and warm slowly with warm blankets and warm fluids through the drip. I think the emergency team should see you too. Come back straight away. Alright, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 339.91,
      "duration_seconds": 4.42,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.98,
      "end_seconds": 346.06,
      "duration_seconds": 5.08,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.15,
      "end_seconds": 349.51,
      "duration_seconds": 2.36,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}