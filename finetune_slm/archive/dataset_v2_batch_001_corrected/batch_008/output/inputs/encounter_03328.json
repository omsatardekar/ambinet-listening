{
  "schema_version": "1.0",
  "encounter_id": "03328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.88,
      "end_seconds": 7.25,
      "duration_seconds": 6.37,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.94,
      "end_seconds": 12.37,
      "duration_seconds": 3.43,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.14,
      "end_seconds": 18.84,
      "duration_seconds": 4.7,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.49,
      "end_seconds": 23.66,
      "duration_seconds": 3.17,
      "text": "Right, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.14,
      "end_seconds": 30.56,
      "duration_seconds": 5.42,
      "text": "We came because of a pearly bump on my nose that bleeds."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.82,
      "end_seconds": 34.19,
      "duration_seconds": 2.37,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 39.67,
      "duration_seconds": 3.4,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.38,
      "end_seconds": 42.64,
      "duration_seconds": 2.26,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.43,
      "end_seconds": 49.71,
      "duration_seconds": 2.28,
      "text": "Washing definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.16,
      "end_seconds": 55.21,
      "duration_seconds": 4.05,
      "text": "Has there been a sore that won't heal too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.9,
      "end_seconds": 56.96,
      "duration_seconds": 1.06,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.52,
      "end_seconds": 60.11,
      "duration_seconds": 1.59,
      "text": "Any crusting as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.18,
      "end_seconds": 66.31,
      "duration_seconds": 4.13,
      "text": "Right, yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.57,
      "end_seconds": 78.86,
      "duration_seconds": 11.29,
      "text": "Doctor, I've got the readings for you. Temperature is 36.9 degrees, BP is 108 over 76, pulse is 84 beats a minute. SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.67,
      "end_seconds": 81.05,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 86.89,
      "duration_seconds": 2.99,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 91.73,
      "duration_seconds": 3.39,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.93,
      "end_seconds": 112.24,
      "duration_seconds": 9.31,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.1,
      "end_seconds": 126.07,
      "duration_seconds": 7.97,
      "text": "Thank you, you can get dressed. Okay, have you had family history of skin cancer, by any chance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.21,
      "end_seconds": 130.6,
      "duration_seconds": 3.39,
      "text": "No family history of skin cancer, thankfully."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.67,
      "end_seconds": 136.03,
      "duration_seconds": 3.36,
      "text": "Any pain, swollen glands or other new lumps?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.06,
      "end_seconds": 142.91,
      "duration_seconds": 4.85,
      "text": "No, no pain, swollen glands or other new lumps."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.64,
      "end_seconds": 147.56,
      "duration_seconds": 2.92,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.03,
      "end_seconds": 149.98,
      "duration_seconds": 0.95,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.07,
      "end_seconds": 154.94,
      "duration_seconds": 3.87,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.93,
      "end_seconds": 160.36,
      "duration_seconds": 3.43,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.05,
      "end_seconds": 165.7,
      "duration_seconds": 4.65,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.54,
      "end_seconds": 178.13,
      "duration_seconds": 11.59,
      "text": "I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.12,
      "end_seconds": 184.0,
      "duration_seconds": 3.88,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 185.37,
      "end_seconds": 188.2,
      "duration_seconds": 2.83,
      "text": "She takes febuxostat, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 191.58,
      "duration_seconds": 2.36,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 193.29,
      "end_seconds": 207.53,
      "duration_seconds": 14.24,
      "text": "80 milligrams, I think that's what's on the box. She takes escitalopram, 10 milligrams, once a day. She is on Seretide inhaler, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.72,
      "end_seconds": 226.37,
      "duration_seconds": 4.65,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.62,
      "end_seconds": 240.03,
      "duration_seconds": 12.41,
      "text": "Okay, um, so I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.75,
      "end_seconds": 243.49,
      "duration_seconds": 2.74,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.53,
      "end_seconds": 256.3,
      "duration_seconds": 11.77,
      "text": "I've got gout. I have depression, for nearly five years. I just want to get back to normal, really. Yes, asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.98,
      "end_seconds": 258.68,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.6,
      "end_seconds": 262.07,
      "duration_seconds": 2.47,
      "text": "I, I have heart disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.96,
      "end_seconds": 269.19,
      "duration_seconds": 6.23,
      "text": "Ah. Okay, I can see gout and depression in your file as well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.49,
      "end_seconds": 286.41,
      "duration_seconds": 2.92,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.1,
      "end_seconds": 293.8,
      "duration_seconds": 5.7,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.26,
      "end_seconds": 308.04,
      "duration_seconds": 12.78,
      "text": "Taking everything into account, I think we're dealing with a likely basal cell carcinoma at this stage. I'd also keep a squamous cell carcinoma in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.02,
      "end_seconds": 310.69,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.5,
      "end_seconds": 320.44,
      "duration_seconds": 8.94,
      "text": "It's reasonable to be concerned, but right now a likely basal cell carcinoma is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.94,
      "end_seconds": 354.82,
      "duration_seconds": 26.88,
      "text": "I'm sending you for a skin biopsy because of suspicious lesion. That will help us see what's going on underneath and decide the next step. A dermoscopy is what I'd like next, for suspicious lesion. Please use a high-factor sunscreen and a hat. The skin cancer clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 355.61,
      "end_seconds": 357.11,
      "duration_seconds": 1.5,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.14,
      "end_seconds": 365.7,
      "duration_seconds": 6.56,
      "text": "Do get help quickly if the symptoms get worse. Let's review you after the biopsy."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 366.49,
      "end_seconds": 367.19,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.2,
      "end_seconds": 373.0,
      "duration_seconds": 4.8,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 374.27,
      "end_seconds": 378.58,
      "duration_seconds": 4.31,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.09,
      "end_seconds": 381.55,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}