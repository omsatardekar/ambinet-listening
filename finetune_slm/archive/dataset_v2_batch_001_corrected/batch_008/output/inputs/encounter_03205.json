{
  "schema_version": "1.0",
  "encounter_id": "03205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 5.16,
      "duration_seconds": 4.53,
      "text": "Afternoon, thanks for coming in. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.66,
      "end_seconds": 19.04,
      "duration_seconds": 8.38,
      "text": "I've been coughing up large amounts of blood, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 22.89,
      "duration_seconds": 2.2,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.23,
      "end_seconds": 27.42,
      "duration_seconds": 3.19,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.31,
      "end_seconds": 33.25,
      "duration_seconds": 3.94,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.39,
      "end_seconds": 35.31,
      "duration_seconds": 0.92,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.26,
      "end_seconds": 39.04,
      "duration_seconds": 2.78,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.13,
      "end_seconds": 45.51,
      "duration_seconds": 4.38,
      "text": "Breathlessness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.63,
      "end_seconds": 50.68,
      "duration_seconds": 4.05,
      "text": "Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.06,
      "end_seconds": 60.46,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.78,
      "end_seconds": 80.74,
      "duration_seconds": 10.96,
      "text": "Okay: respiratory rate 26, temperature is 37.3 degrees, pressure 118 over 84, pulse is 90 beats a minute, SpO2 90 percent on room air."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.43,
      "end_seconds": 83.36,
      "duration_seconds": 1.93,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.45,
      "end_seconds": 87.81,
      "duration_seconds": 2.36,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.85,
      "end_seconds": 91.24,
      "duration_seconds": 2.39,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.98,
      "end_seconds": 95.43,
      "duration_seconds": 2.45,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.44,
      "end_seconds": 111.17,
      "duration_seconds": 5.73,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.25,
      "end_seconds": 116.11,
      "duration_seconds": 2.86,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.88,
      "end_seconds": 130.16,
      "duration_seconds": 6.28,
      "text": "Let me check a few things. Any weight loss, chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 134.64,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.52,
      "end_seconds": 138.37,
      "duration_seconds": 2.85,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.02,
      "end_seconds": 142.05,
      "duration_seconds": 2.03,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.09,
      "end_seconds": 146.71,
      "duration_seconds": 2.62,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.73,
      "end_seconds": 150.75,
      "duration_seconds": 2.02,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.47,
      "end_seconds": 161.96,
      "duration_seconds": 3.49,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.53,
      "end_seconds": 170.76,
      "duration_seconds": 3.23,
      "text": "An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 175.22,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.76,
      "end_seconds": 180.21,
      "duration_seconds": 3.45,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.92,
      "end_seconds": 184.08,
      "duration_seconds": 3.16,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.35,
      "end_seconds": 187.52,
      "duration_seconds": 2.17,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.85,
      "end_seconds": 208.91,
      "duration_seconds": 4.06,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.55,
      "end_seconds": 226.84,
      "duration_seconds": 17.29,
      "text": "I gave up cigarettes last spring. I do a yoga class on Thursdays. I drink a lot of tea and snack through the day. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 230.99,
      "duration_seconds": 2.45,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.72,
      "end_seconds": 234.29,
      "duration_seconds": 2.57,
      "text": "Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.71,
      "end_seconds": 255.0,
      "duration_seconds": 4.29,
      "text": "So where does that leave us? It points towards life-threatening haemoptysis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.05,
      "end_seconds": 260.11,
      "duration_seconds": 3.06,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.27,
      "end_seconds": 287.86,
      "duration_seconds": 23.59,
      "text": "I understand the worry. At the moment I'd say it's life-threatening haemoptysis, and we'll know more once the an urgent CT scan is back. I'll request an urgent CT scan, it'll help with massive haemoptysis. I'm prescribing tranexamic acid, 1 gram, now, single dose. That should help with haemoptysis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.6,
      "end_seconds": 291.19,
      "duration_seconds": 1.59,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.26,
      "end_seconds": 304.81,
      "duration_seconds": 12.55,
      "text": "Lie on the bleeding side and I am calling the emergency team. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.73,
      "end_seconds": 308.99,
      "duration_seconds": 3.26,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.95,
      "end_seconds": 312.31,
      "duration_seconds": 2.36,
      "text": "Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.27,
      "end_seconds": 313.97,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.71,
      "end_seconds": 321.09,
      "duration_seconds": 2.38,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.94,
      "end_seconds": 325.6,
      "duration_seconds": 3.66,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}