      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.75,
      "end_seconds": 322.53,
      "duration_seconds": 15.78,
      "text": "check labels carefully and use separate toasters and chopping boards. We'll refer you to the dietitian. Let's review you in twelve months. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
