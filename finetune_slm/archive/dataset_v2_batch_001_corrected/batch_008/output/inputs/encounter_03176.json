      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 225.0,
      "duration_seconds": 8.4,
      "text": "okay: saturation 97 percent, pulse is 83 beats a minute, temperature is 36.5 degrees, BP is 110 over 80."
    },
