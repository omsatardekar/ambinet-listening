{
  "schema_version": "1.0",
  "encounter_id": "03287",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.42,
      "duration_seconds": 4.13,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.52,
      "end_seconds": 11.47,
      "duration_seconds": 4.95,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.97,
      "end_seconds": 17.47,
      "duration_seconds": 5.5,
      "text": "So the thing is, I've got a sudden severe tummy pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.3,
      "end_seconds": 20.09,
      "duration_seconds": 1.79,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.14,
      "end_seconds": 29.19,
      "duration_seconds": 8.05,
      "text": "I notice it more with movement. Vomiting was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.79,
      "end_seconds": 34.65,
      "duration_seconds": 3.86,
      "text": "Okay, any fever, blood in the vomit or diarrhoea?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.5,
      "end_seconds": 37.87,
      "duration_seconds": 2.37,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 42.62,
      "duration_seconds": 4.15,
      "text": "Yes, carry on. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.16,
      "end_seconds": 45.26,
      "duration_seconds": 1.1,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.32,
      "end_seconds": 65.06,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 74.57,
      "duration_seconds": 7.92,
      "text": "I've had eczema for five years now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.97,
      "end_seconds": 77.05,
      "duration_seconds": 1.08,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.85,
      "end_seconds": 98.45,
      "duration_seconds": 4.6,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.48,
      "end_seconds": 103.43,
      "duration_seconds": 2.95,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.11,
      "end_seconds": 108.75,
      "duration_seconds": 3.64,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 113.2,
      "duration_seconds": 3.27,
      "text": "I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 116.77,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.05,
      "end_seconds": 124.81,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.95,
      "end_seconds": 133.35,
      "duration_seconds": 4.4,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.98,
      "end_seconds": 137.79,
      "duration_seconds": 3.81,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 141.29,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.24,
      "end_seconds": 146.95,
      "duration_seconds": 3.71,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.2,
      "end_seconds": 151.07,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.37,
      "end_seconds": 165.84,
      "duration_seconds": 2.47,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.59,
      "end_seconds": 191.08,
      "duration_seconds": 15.49,
      "text": "Okay: height 155 centimetres, temperature is 36.9 degrees, BMI works out to 37.9, blood pressure 135 over 87, respiratory rate 20, SpO2 99 percent on room air, weight 91 kilos, heart rate 112."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.18,
      "end_seconds": 195.19,
      "duration_seconds": 2.01,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.96,
      "end_seconds": 198.08,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.35,
      "end_seconds": 202.33,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.52,
      "end_seconds": 227.38,
      "duration_seconds": 7.86,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.17,
      "end_seconds": 233.93,
      "duration_seconds": 1.76,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.44,
      "end_seconds": 254.51,
      "duration_seconds": 8.07,
      "text": "Okay, so my impression is this: This is probably a perforated stomach ulcer. Pancreatitis is still possible."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.57,
      "end_seconds": 259.94,
      "duration_seconds": 3.37,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.32,
      "end_seconds": 276.92,
      "duration_seconds": 15.6,
      "text": "I understand the worry. At the moment I'd say it's a perforated stomach ulcer, and we'll know more once the urgent blood tests is back. We should do urgent blood tests for acute abdomen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 278.8,
      "end_seconds": 283.74,
      "duration_seconds": 4.94,
      "text": "We have a slot Thursday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.35,
      "end_seconds": 297.72,
      "duration_seconds": 12.37,
      "text": "I think a CT scan makes sense here, for possible perforation. Nothing to eat or drink, you need an operation urgently. Book a review straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.62,
      "end_seconds": 300.32,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.46,
      "end_seconds": 307.06,
      "duration_seconds": 3.6,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.59,
      "end_seconds": 311.6,
      "duration_seconds": 4.01,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.98,
      "end_seconds": 314.46,
      "duration_seconds": 1.48,
      "text": "Look after yourself."
    }
  ]
}