    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.87,
      "end_seconds": 19.27,
      "duration_seconds": 7.4,
      "text": "it's wheeze at work i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.03,
      "end_seconds": 23.02,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.79,
      "end_seconds": 36.5,
      "duration_seconds": 11.71,
      "text": "Mostly severe. I've, I've had a cough that eases on holiday too, for two months. About cough that eases on holiday, mostly mild."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.18,
      "end_seconds": 43.01,
      "duration_seconds": 5.83,
      "text": "Have you had wheeze at work before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.66,
      "end_seconds": 55.08,
      "duration_seconds": 10.42,
      "text": "Yes, um, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.41,
      "end_seconds": 59.16,
      "duration_seconds": 2.75,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.31,
      "end_seconds": 75.01,
      "duration_seconds": 2.7,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.46,
      "end_seconds": 108.02,
      "duration_seconds": 14.56,
      "text": "Okay: weight 57 kilos, temperature is 36.9 degrees, respiratory rate 15, BMI works out to 22.5, saturation 99 percent, pressure 128 over 79, pulse 81, height 159 centimetres."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.94,
      "end_seconds": 111.53,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.52,
      "end_seconds": 120.15,
      "duration_seconds": 3.63,
      "text": "So, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 125.93,
      "duration_seconds": 3.66,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 129.21,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.01,
      "end_seconds": 150.47,
      "duration_seconds": 5.46,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.49,
      "end_seconds": 156.26,
      "duration_seconds": 1.77,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.19,
      "end_seconds": 178.25,
      "duration_seconds": 5.06,
      "text": "Have you noticed ankle swelling coughing up blood fever or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.65,
      "end_seconds": 184.1,
      "duration_seconds": 4.45,
      "text": "Oh no I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.58,
      "end_seconds": 190.03,
      "duration_seconds": 5.45,
      "text": "okay, go on so, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.99,
      "end_seconds": 194.08,
      "duration_seconds": 2.09,
      "text": "I move fine otherwise"
