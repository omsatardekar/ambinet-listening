{
  "schema_version": "1.0",
  "encounter_id": "03154",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.59,
      "duration_seconds": 3.21,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 13.85,
      "duration_seconds": 4.21,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.65,
      "end_seconds": 22.04,
      "duration_seconds": 6.39,
      "text": "It's a severe headache for days. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.26,
      "end_seconds": 32.79,
      "duration_seconds": 10.53,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.43,
      "end_seconds": 42.74,
      "duration_seconds": 5.31,
      "text": "It's worse with lying down. It feels severe to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.42,
      "end_seconds": 45.44,
      "duration_seconds": 2.02,
      "text": "Have you had being sick?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 49.2,
      "duration_seconds": 2.2,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.82,
      "end_seconds": 52.55,
      "duration_seconds": 1.73,
      "text": "Have you had drowsiness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.86,
      "end_seconds": 55.42,
      "duration_seconds": 1.56,
      "text": "Yes, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.39,
      "end_seconds": 68.49,
      "duration_seconds": 7.1,
      "text": "Have you had a severe headache for days before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.72,
      "end_seconds": 79.38,
      "duration_seconds": 4.66,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 86.05,
      "duration_seconds": 4.12,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.96,
      "end_seconds": 90.29,
      "duration_seconds": 2.33,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.1,
      "end_seconds": 106.44,
      "duration_seconds": 4.34,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.52,
      "end_seconds": 113.42,
      "duration_seconds": 2.9,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.61,
      "end_seconds": 125.98,
      "duration_seconds": 5.37,
      "text": "Any head injury, fever or weakness on one side at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.72,
      "end_seconds": 129.65,
      "duration_seconds": 2.93,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.79,
      "end_seconds": 133.38,
      "duration_seconds": 2.59,
      "text": "Okay, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.04,
      "end_seconds": 137.07,
      "duration_seconds": 2.03,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 141.09,
      "duration_seconds": 2.11,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.14,
      "end_seconds": 143.61,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.01,
      "end_seconds": 146.95,
      "duration_seconds": 1.94,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 158.94,
      "duration_seconds": 10.72,
      "text": "I'm on sertraline, 50 milligrams, once a day. It's something called allo... allopurinol, 100 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.71,
      "end_seconds": 163.78,
      "duration_seconds": 3.07,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.79,
      "end_seconds": 170.91,
      "duration_seconds": 6.12,
      "text": "Not with me. I'll bring it next time. It's the contraceptive pill, daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.68,
      "end_seconds": 189.12,
      "duration_seconds": 2.44,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.05,
      "end_seconds": 192.71,
      "duration_seconds": 1.66,
      "text": "I have depression."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.71,
      "end_seconds": 196.12,
      "duration_seconds": 1.41,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.64,
      "end_seconds": 202.85,
      "duration_seconds": 1.21,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.39,
      "end_seconds": 204.71,
      "duration_seconds": 1.32,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.74,
      "end_seconds": 219.24,
      "duration_seconds": 9.5,
      "text": "Right, so depression and gout are already on your record. We'll keep that in mind today. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.48,
      "end_seconds": 233.24,
      "duration_seconds": 12.76,
      "text": "I drink a lot of tea and snack through the day. I work in accounts at a hospital. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 237.8,
      "duration_seconds": 2.97,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.22,
      "end_seconds": 243.9,
      "duration_seconds": 4.68,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 250.1,
      "duration_seconds": 5.08,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.67,
      "end_seconds": 254.09,
      "duration_seconds": 2.42,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.18,
      "end_seconds": 269.06,
      "duration_seconds": 13.88,
      "text": "Okay, so my impression is this: It points towards possible cerebral venous thrombosis. I want to be honest that this is an impression, not a final answer. We shouldn't forget raised pressure in the head."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.37,
      "end_seconds": 274.26,
      "duration_seconds": 3.89,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 286.7,
      "duration_seconds": 11.24,
      "text": "I understand the worry. At the moment I'd say it's possible cerebral venous thrombosis, and we'll know more once the an urgent CT venogram is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.75,
      "end_seconds": 330.33,
      "duration_seconds": 33.58,
      "text": "Let's book an urgent CT venogram to look into possible venous thrombosis. An MRI of the head is what I'd like next, for papilloedema. Stop the pill, you need an urgent scan and admission. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.14,
      "end_seconds": 333.59,
      "duration_seconds": 2.45,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.37,
      "end_seconds": 338.09,
      "duration_seconds": 2.72,
      "text": "I think I understand everything. Thanks."
    }
  ]
}