{
  "schema_version": "1.0",
  "encounter_id": "03317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 3.95,
      "duration_seconds": 2.89,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.92,
      "end_seconds": 11.57,
      "duration_seconds": 6.65,
      "text": "Hi doctor, um, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.23,
      "end_seconds": 14.79,
      "duration_seconds": 1.56,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.13,
      "end_seconds": 22.32,
      "duration_seconds": 6.19,
      "text": "Doctor, it's pain in my breastbone wound. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.93,
      "end_seconds": 28.41,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.77,
      "end_seconds": 43.53,
      "duration_seconds": 10.76,
      "text": "I'd say mild. I'd say a few times a day. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.13,
      "end_seconds": 47.48,
      "duration_seconds": 2.35,
      "text": "Has there been tiredness too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.27,
      "end_seconds": 57.15,
      "duration_seconds": 8.88,
      "text": "Yes, I have. Erm, I had a clicking in the breastbone before. That's settled now, though."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.62,
      "end_seconds": 65.8,
      "duration_seconds": 3.18,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.5,
      "end_seconds": 68.85,
      "duration_seconds": 2.35,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.18,
      "end_seconds": 84.67,
      "duration_seconds": 4.49,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 89.87,
      "duration_seconds": 4.19,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.38,
      "end_seconds": 108.32,
      "duration_seconds": 4.94,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.0,
      "end_seconds": 128.61,
      "duration_seconds": 18.61,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. Not much, I mostly stay in these days. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.31,
      "end_seconds": 134.36,
      "duration_seconds": 4.05,
      "text": "Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.31,
      "end_seconds": 138.56,
      "duration_seconds": 2.25,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.91,
      "end_seconds": 150.01,
      "duration_seconds": 2.1,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.76,
      "end_seconds": 163.14,
      "duration_seconds": 11.38,
      "text": "Oh, you know, I'm on metoprolol, 50 milligrams, twice a day. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 167.11,
      "duration_seconds": 2.91,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.11,
      "end_seconds": 173.38,
      "duration_seconds": 5.27,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.12,
      "end_seconds": 178.48,
      "duration_seconds": 3.36,
      "text": "Any chest pain on exertion or breathlessness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.61,
      "end_seconds": 182.57,
      "duration_seconds": 2.96,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.83,
      "end_seconds": 186.09,
      "duration_seconds": 3.26,
      "text": "I see, go ahead. What about fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.16,
      "end_seconds": 188.63,
      "duration_seconds": 1.47,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 193.11,
      "duration_seconds": 3.67,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.98,
      "end_seconds": 196.05,
      "duration_seconds": 2.07,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 196.81,
      "end_seconds": 207.53,
      "duration_seconds": 10.72,
      "text": "Doctor, I've got the readings for you. SpO2 99 percent on room air, respiratory rate 18, temperature 36.9, pressure 114 over 78, pulse 75."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.65,
      "end_seconds": 210.23,
      "duration_seconds": 1.58,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.23,
      "end_seconds": 215.98,
      "duration_seconds": 3.75,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.89,
      "end_seconds": 219.28,
      "duration_seconds": 2.39,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.08,
      "end_seconds": 237.31,
      "duration_seconds": 8.23,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.06,
      "end_seconds": 254.02,
      "duration_seconds": 12.96,
      "text": "All finished, thank you. Having listened and examined, it fits best with recovering well after bypass surgery. I can't rule out a leg wound infection yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 255.61,
      "end_seconds": 261.98,
      "duration_seconds": 6.37,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.03,
      "end_seconds": 298.83,
      "duration_seconds": 35.8,
      "text": "Thanks, I'll have a look. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Let's get you seen by the cardiac rehabilitation team, I'll arrange the letter. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.74,
      "end_seconds": 302.08,
      "duration_seconds": 2.34,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.91,
      "end_seconds": 307.11,
      "duration_seconds": 4.2,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.86,
      "end_seconds": 310.81,
      "duration_seconds": 2.95,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}