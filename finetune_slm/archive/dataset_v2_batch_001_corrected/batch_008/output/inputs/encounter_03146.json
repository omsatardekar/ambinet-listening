{
  "schema_version": "1.0",
  "encounter_id": "03146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 4.81,
      "duration_seconds": 4.1,
      "text": "Good morning, grab a seat. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.18,
      "end_seconds": 8.53,
      "duration_seconds": 2.35,
      "text": "It's mouth ulcers, mostly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.12,
      "end_seconds": 12.23,
      "duration_seconds": 2.11,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.15,
      "end_seconds": 20.94,
      "duration_seconds": 6.79,
      "text": "Well, I had sumatriptan at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.32,
      "end_seconds": 32.28,
      "duration_seconds": 2.96,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.53,
      "end_seconds": 37.17,
      "duration_seconds": 3.64,
      "text": "Ah, for five days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.85,
      "end_seconds": 41.46,
      "duration_seconds": 3.61,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.8,
      "end_seconds": 61.62,
      "duration_seconds": 15.82,
      "text": "Maybe a six out of ten on a bad day. Oh, and bloating when I slip up. I did have tiredness at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.52,
      "end_seconds": 65.7,
      "duration_seconds": 3.18,
      "text": "And what about bone pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.58,
      "end_seconds": 70.48,
      "duration_seconds": 2.9,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.1,
      "end_seconds": 75.35,
      "duration_seconds": 3.25,
      "text": "Any vomiting or weight loss at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.39,
      "end_seconds": 79.47,
      "duration_seconds": 2.08,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.73,
      "end_seconds": 84.1,
      "duration_seconds": 3.37,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.66,
      "end_seconds": 85.8,
      "duration_seconds": 1.14,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.93,
      "end_seconds": 104.87,
      "duration_seconds": 3.94,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.04,
      "end_seconds": 108.42,
      "duration_seconds": 2.38,
      "text": "Erm, my son has asthma."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.95,
      "end_seconds": 111.04,
      "duration_seconds": 2.09,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.73,
      "end_seconds": 118.54,
      "duration_seconds": 5.81,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.57,
      "end_seconds": 122.74,
      "duration_seconds": 2.17,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.42,
      "end_seconds": 125.91,
      "duration_seconds": 1.49,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.79,
      "end_seconds": 136.65,
      "duration_seconds": 9.86,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.02,
      "end_seconds": 140.51,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.93,
      "end_seconds": 144.77,
      "duration_seconds": 2.84,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.3,
      "end_seconds": 159.96,
      "duration_seconds": 11.66,
      "text": "Yes, I work in a bakery, early starts. I walk the dog every morning. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.68,
      "end_seconds": 164.7,
      "duration_seconds": 3.02,
      "text": "Alright, I'll do your observations first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.91,
      "end_seconds": 176.68,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.22,
      "end_seconds": 198.46,
      "duration_seconds": 7.24,
      "text": "Okay: pulse is 73 beats a minute, respiratory rate 16. And saturation 99 percent, pressure 125 over 78."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.29,
      "end_seconds": 201.37,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.81,
      "end_seconds": 206.05,
      "duration_seconds": 3.24,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.67,
      "end_seconds": 212.61,
      "duration_seconds": 3.94,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.31,
      "end_seconds": 216.12,
      "duration_seconds": 1.81,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.11,
      "end_seconds": 236.94,
      "duration_seconds": 5.83,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.62,
      "end_seconds": 241.81,
      "duration_seconds": 2.19,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.78,
      "end_seconds": 266.2,
      "duration_seconds": 14.42,
      "text": "So, based on the history and the examination, my working impression is coeliac disease on a gluten-free diet with some accidental exposure. It could also be iron deficiency, so we'll keep that open."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.34,
      "end_seconds": 271.31,
      "duration_seconds": 3.97,
      "text": "I mean, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 298.71,
      "duration_seconds": 25.95,
      "text": "I understand the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure, and we'll know more once the coeliac antibodies is back. I'm sending you for coeliac antibodies because of coeliac follow-up. That will help us see what's going on underneath and decide the next step. I'd like to see you again in twelve months."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.98,
      "end_seconds": 301.77,
      "duration_seconds": 1.79,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.68,
      "end_seconds": 306.23,
      "duration_seconds": 2.55,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.13,
      "end_seconds": 310.24,
      "duration_seconds": 3.11,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}