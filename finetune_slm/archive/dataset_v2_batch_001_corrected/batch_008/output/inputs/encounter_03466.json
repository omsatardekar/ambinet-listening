      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.06,
      "end_seconds": 168.01,
      "duration_seconds": 11.95,
      "text": "I'm on ramipril, 5 milligrams, every morning. It's simvastatin, 20 milligrams, at night for my cholesterol. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.88,
      "end_seconds": 170.56,
      "duration_seconds": 1.68,
      "text": "so, is that long-standing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.44,
      "end_seconds": 174.13,
      "duration_seconds": 1.69,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.09,
      "end_seconds": 178.14,
      "duration_seconds": 3.05,
      "text": "I'll just record a few vital signs."
