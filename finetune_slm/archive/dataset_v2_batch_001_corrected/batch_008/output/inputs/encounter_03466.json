    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.81,
      "end_seconds": 128.45,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
