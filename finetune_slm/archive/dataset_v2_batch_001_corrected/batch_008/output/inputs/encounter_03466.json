      "role": "PATIENT",
      "start_seconds": 84.99,
      "end_seconds": 87.01,
      "duration_seconds": 2.02,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.27,
      "end_seconds": 95.54,
      "duration_seconds": 7.27,
      "text": "Alright, high blood pressure and high cholesterol, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.98,
      "end_seconds": 100.02,
      "duration_seconds": 3.04,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.44,
      "end_seconds": 113.69,
      "duration_seconds": 3.25,
      "text": "Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.98,
      "end_seconds": 117.31,
      "duration_seconds": 2.33,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.11,
      "end_seconds": 120.45,
      "duration_seconds": 2.34,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.16,
      "end_seconds": 125.89,
      "duration_seconds": 3.73,
      "text": "No, I share a house with my brother"
