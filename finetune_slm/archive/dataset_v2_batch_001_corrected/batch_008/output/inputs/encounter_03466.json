      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.27,
      "end_seconds": 136.23,
      "duration_seconds": 3.96,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.62,
      "end_seconds": 154.43,
      "duration_seconds": 2.81,
      "text": "What's on your current medicine list?"
