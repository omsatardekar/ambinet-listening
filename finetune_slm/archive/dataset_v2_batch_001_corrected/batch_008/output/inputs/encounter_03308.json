{
  "schema_version": "1.0",
  "encounter_id": "03308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 3.46,
      "duration_seconds": 2.9,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.19,
      "end_seconds": 9.73,
      "duration_seconds": 4.54,
      "text": "Right, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.78,
      "end_seconds": 13.41,
      "duration_seconds": 2.63,
      "text": "Well, I've been having shaking."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.9,
      "end_seconds": 18.31,
      "duration_seconds": 3.41,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.12,
      "end_seconds": 23.32,
      "duration_seconds": 3.2,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.4,
      "end_seconds": 29.79,
      "duration_seconds": 5.39,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.5,
      "end_seconds": 44.94,
      "duration_seconds": 14.44,
      "text": "Maybe a five out of ten on a bad day. I'd say once or twice a day. And I've been feeling anxious and agitated as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.19,
      "end_seconds": 61.06,
      "duration_seconds": 2.87,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.47,
      "end_seconds": 74.74,
      "duration_seconds": 3.27,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.58,
      "end_seconds": 101.85,
      "duration_seconds": 8.27,
      "text": "Okay: saturation 96 percent, heart rate 115, BP is 116 over 76, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.63,
      "end_seconds": 105.73,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.48,
      "end_seconds": 110.13,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.68,
      "end_seconds": 132.89,
      "duration_seconds": 5.21,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.18,
      "end_seconds": 139.4,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.59,
      "end_seconds": 151.94,
      "duration_seconds": 4.35,
      "text": "A few quick ones: seeing things, vomiting blood or confusion?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.84,
      "end_seconds": 157.09,
      "duration_seconds": 3.25,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.77,
      "end_seconds": 160.83,
      "duration_seconds": 2.06,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.39,
      "end_seconds": 163.31,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.01,
      "end_seconds": 165.97,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.69,
      "end_seconds": 169.85,
      "duration_seconds": 3.16,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.77,
      "end_seconds": 179.81,
      "duration_seconds": 2.04,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.37,
      "end_seconds": 185.47,
      "duration_seconds": 4.1,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.45,
      "end_seconds": 189.27,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.97,
      "end_seconds": 194.37,
      "duration_seconds": 3.4,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.97,
      "end_seconds": 198.13,
      "duration_seconds": 2.16,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.13,
      "end_seconds": 205.16,
      "duration_seconds": 5.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.24,
      "end_seconds": 210.75,
      "duration_seconds": 4.51,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.57,
      "end_seconds": 215.62,
      "duration_seconds": 4.05,
      "text": "I'm allergic to kiwi, I get hives."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.25,
      "end_seconds": 220.92,
      "duration_seconds": 2.67,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.88,
      "end_seconds": 227.73,
      "duration_seconds": 4.85,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.38,
      "end_seconds": 245.68,
      "duration_seconds": 4.3,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.37,
      "end_seconds": 255.1,
      "duration_seconds": 5.73,
      "text": "I, I take sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.98,
      "end_seconds": 258.48,
      "duration_seconds": 2.5,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.92,
      "end_seconds": 261.32,
      "duration_seconds": 1.4,
      "text": "I have epilepsy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.45,
      "end_seconds": 271.24,
      "duration_seconds": 8.79,
      "text": "Yes, epilepsy is known to us, good to have that clear. Having listened and examined, my working impression is alcohol withdrawal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.52,
      "end_seconds": 274.43,
      "duration_seconds": 1.91,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.31,
      "end_seconds": 291.17,
      "duration_seconds": 14.86,
      "text": "Nothing I've seen today points to an emergency. It looks like alcohol withdrawal, but I'd like to confirm. So, to recap quickly. You've had shaking for about three months, and no confusion or vomiting blood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.53,
      "end_seconds": 293.23,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.03,
      "end_seconds": 324.97,
      "duration_seconds": 29.94,
      "text": "I want blood tests done, that's for alcohol withdrawal. What I'm giving you is thiamine, 100 milligrams, three times a day, long term. You take it by mouth. It's for alcohol-related deficiency. The pharmacy will go through the details again when you pick it up. Do not stop alcohol suddenly without medical support. I'd like you to see the alcohol liaison service as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.49,
      "end_seconds": 334.21,
      "duration_seconds": 7.72,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.28,
      "end_seconds": 339.13,
      "duration_seconds": 2.85,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.02,
      "end_seconds": 343.36,
      "duration_seconds": 2.34,
      "text": "We'll catch up in two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.69,
      "end_seconds": 346.5,
      "duration_seconds": 1.81,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.73,
      "end_seconds": 353.28,
      "duration_seconds": 5.55,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.15,
      "end_seconds": 359.33,
      "duration_seconds": 4.18,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}