{
  "schema_version": "1.0",
  "encounter_id": "03114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 5.84,
      "duration_seconds": 5.29,
      "text": "Hello, you know, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.81,
      "end_seconds": 12.79,
      "duration_seconds": 4.98,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.88,
      "end_seconds": 19.42,
      "duration_seconds": 5.54,
      "text": "I've been dealing with hearing better in a noisy room."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 28.1,
      "duration_seconds": 7.38,
      "text": "Can you tell me when it first started? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.97,
      "end_seconds": 35.9,
      "duration_seconds": 2.93,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.19,
      "end_seconds": 40.56,
      "duration_seconds": 3.37,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.4,
      "end_seconds": 44.87,
      "duration_seconds": 2.47,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 50.69,
      "duration_seconds": 2.74,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.71,
      "end_seconds": 57.56,
      "duration_seconds": 4.85,
      "text": "It usually comes with hearing getting worse in both ears."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.09,
      "end_seconds": 61.44,
      "duration_seconds": 3.35,
      "text": "Any ringing in the ears as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.33,
      "end_seconds": 63.37,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.98,
      "end_seconds": 67.8,
      "duration_seconds": 2.82,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.76,
      "end_seconds": 70.97,
      "duration_seconds": 1.21,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.03,
      "end_seconds": 74.71,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.78,
      "end_seconds": 78.64,
      "duration_seconds": 2.86,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 92.9,
      "duration_seconds": 3.55,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.59,
      "end_seconds": 99.61,
      "duration_seconds": 5.02,
      "text": "I have an underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.63,
      "end_seconds": 105.32,
      "duration_seconds": 4.69,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.25,
      "end_seconds": 119.25,
      "duration_seconds": 13.0,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.85,
      "end_seconds": 123.91,
      "duration_seconds": 4.06,
      "text": "Any facial weakness, vertigo, discharge or ear pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.81,
      "end_seconds": 127.53,
      "duration_seconds": 2.72,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.19,
      "end_seconds": 132.41,
      "duration_seconds": 4.22,
      "text": "So, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.6,
      "end_seconds": 135.73,
      "duration_seconds": 2.13,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.45,
      "end_seconds": 138.96,
      "duration_seconds": 2.51,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.55,
      "end_seconds": 144.14,
      "duration_seconds": 3.59,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.01,
      "end_seconds": 153.09,
      "duration_seconds": 4.08,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.3,
      "end_seconds": 168.25,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.55,
      "end_seconds": 190.87,
      "duration_seconds": 10.32,
      "text": "Okay: temperature 36.5, pulse is 68 beats a minute. And BP is 116 over 68, SpO2 99 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.61,
      "end_seconds": 198.28,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.91,
      "end_seconds": 202.57,
      "duration_seconds": 3.66,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 208.72,
      "duration_seconds": 4.09,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.54,
      "end_seconds": 217.94,
      "duration_seconds": 1.4,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.74,
      "end_seconds": 222.08,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 237.73,
      "duration_seconds": 6.59,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.38,
      "end_seconds": 244.16,
      "duration_seconds": 2.78,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.29,
      "end_seconds": 268.79,
      "duration_seconds": 10.5,
      "text": "Let me repeat that back to make sure. You've had hearing better in a noisy room for ten days, mild, and no discharge or vertigo."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.97,
      "end_seconds": 275.46,
      "duration_seconds": 1.49,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.62,
      "end_seconds": 311.78,
      "duration_seconds": 35.16,
      "text": "A CT scan of the ears is what I'd like next, for possible otosclerosis. I think a hearing test makes sense here, for hearing loss. A hearing aid or an operation are both options after the tests. Cut down on salt and fried food for now, it really does make a difference. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check after the tests."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.01,
      "end_seconds": 317.35,
      "duration_seconds": 4.34,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.56,
      "end_seconds": 322.06,
      "duration_seconds": 3.5,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.29,
      "end_seconds": 324.85,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}