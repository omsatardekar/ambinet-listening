{
  "schema_version": "1.0",
  "encounter_id": "03259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 4.24,
      "duration_seconds": 3.28,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.25,
      "end_seconds": 9.87,
      "duration_seconds": 4.62,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.74,
      "end_seconds": 18.04,
      "duration_seconds": 4.3,
      "text": "Doctor, um, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.07,
      "end_seconds": 23.57,
      "duration_seconds": 4.5,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.16,
      "end_seconds": 34.34,
      "duration_seconds": 7.18,
      "text": "Uh, doctor, it's being found cold and drowsy. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.48,
      "end_seconds": 39.61,
      "duration_seconds": 4.13,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.67,
      "end_seconds": 49.65,
      "duration_seconds": 2.98,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.4,
      "end_seconds": 76.37,
      "duration_seconds": 14.97,
      "text": "Okay: pulse is 82 beats a minute, SpO2 98 percent on room air, temperature 36.7, BP is 110 over 82, respiratory rate 14. So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.72,
      "end_seconds": 87.52,
      "duration_seconds": 9.8,
      "text": "I'd say five days. Actually, no, closer to three days. Oh, and confusion. Had that since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 91.67,
      "duration_seconds": 3.28,
      "text": "Have you had shivering that has stopped?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.15,
      "end_seconds": 100.21,
      "duration_seconds": 7.06,
      "text": "Yes, since last Tuesday. Erm, as for shivering that has stopped, I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.1,
      "end_seconds": 104.48,
      "duration_seconds": 3.38,
      "text": "Did you get fall, alcohol or head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.48,
      "end_seconds": 107.4,
      "duration_seconds": 1.92,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.1,
      "end_seconds": 110.69,
      "duration_seconds": 2.59,
      "text": "So, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.99,
      "end_seconds": 117.46,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.82,
      "end_seconds": 141.6,
      "duration_seconds": 7.78,
      "text": "Do you take any prescribed or over-the-counter medicines? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.77,
      "end_seconds": 145.59,
      "duration_seconds": 2.82,
      "text": "Pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.92,
      "end_seconds": 163.73,
      "duration_seconds": 1.81,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.76,
      "end_seconds": 168.62,
      "duration_seconds": 3.86,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.51,
      "end_seconds": 171.68,
      "duration_seconds": 2.17,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.79,
      "end_seconds": 177.05,
      "duration_seconds": 4.26,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.56,
      "end_seconds": 179.86,
      "duration_seconds": 1.3,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.36,
      "end_seconds": 184.53,
      "duration_seconds": 3.17,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 190.54,
      "duration_seconds": 4.83,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.57,
      "end_seconds": 194.82,
      "duration_seconds": 3.25,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.41,
      "end_seconds": 197.95,
      "duration_seconds": 2.54,
      "text": "So, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.9,
      "end_seconds": 203.45,
      "duration_seconds": 4.55,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.08,
      "end_seconds": 221.33,
      "duration_seconds": 5.25,
      "text": "Do you have any chronic illnesses? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.9,
      "end_seconds": 223.76,
      "duration_seconds": 1.86,
      "text": "I've got acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 225.23,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.72,
      "end_seconds": 231.9,
      "duration_seconds": 4.18,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.39,
      "end_seconds": 234.35,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.56,
      "end_seconds": 236.89,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 261.38,
      "duration_seconds": 6.57,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.27,
      "end_seconds": 276.85,
      "duration_seconds": 9.58,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. The most likely explanation is severe hypothermia. We shouldn't forget an overdose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.26,
      "end_seconds": 281.61,
      "duration_seconds": 3.35,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.49,
      "end_seconds": 295.41,
      "duration_seconds": 11.92,
      "text": "It's reasonable to be concerned, but right now severe hypothermia is my leading thought, not anything worse. I'd like to arrange an ECG for bradycardia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.07,
      "end_seconds": 301.46,
      "duration_seconds": 4.39,
      "text": "Mm, uh, where would I go for that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.59,
      "end_seconds": 306.25,
      "duration_seconds": 3.66,
      "text": "Let's book a blood sugar to look into hypothermia."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.7,
      "end_seconds": 308.77,
      "duration_seconds": 1.07,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.54,
      "end_seconds": 330.52,
      "duration_seconds": 20.98,
      "text": "Handle gently and warm slowly with warm blankets and warm fluids through the drip. I'd like you to see the emergency team as well, and I'll write the referral. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.13,
      "end_seconds": 333.23,
      "duration_seconds": 2.1,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.05,
      "end_seconds": 341.0,
      "duration_seconds": 2.95,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.27,
      "end_seconds": 346.52,
      "duration_seconds": 4.25,
      "text": "Hmm, okay, that makes sense. Thanks for explaining."
    }
  ]
}