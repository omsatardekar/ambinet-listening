{
  "schema_version": "1.0",
  "encounter_id": "03278",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.71,
      "end_seconds": 6.57,
      "duration_seconds": 5.86,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.74,
      "end_seconds": 11.78,
      "duration_seconds": 4.04,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.36,
      "end_seconds": 18.61,
      "duration_seconds": 5.25,
      "text": "Um, um, so... a limp. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.11,
      "end_seconds": 29.54,
      "duration_seconds": 9.43,
      "text": "Doctor, I've got the readings for you. Blood pressure 120 over 76, temperature 37.0, heart rate 80, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 34.59,
      "duration_seconds": 2.97,
      "text": "Okay, noted. Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.68,
      "end_seconds": 46.78,
      "duration_seconds": 10.1,
      "text": "Four weeks, I think... sorry, three weeks, I got that wrong. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.87,
      "end_seconds": 51.81,
      "duration_seconds": 2.94,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.47,
      "end_seconds": 53.95,
      "duration_seconds": 1.48,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.72,
      "end_seconds": 57.07,
      "duration_seconds": 2.35,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.68,
      "end_seconds": 68.71,
      "duration_seconds": 10.03,
      "text": "Hmm, it usually comes with night pain. Okay, so the night pain? That's been for two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.21,
      "end_seconds": 71.38,
      "duration_seconds": 2.17,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 74.54,
      "duration_seconds": 2.06,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.75,
      "end_seconds": 81.71,
      "duration_seconds": 5.96,
      "text": "Have you had a limp before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.58,
      "end_seconds": 87.55,
      "duration_seconds": 4.97,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.26,
      "end_seconds": 108.91,
      "duration_seconds": 2.65,
      "text": "Have you had any weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.56,
      "end_seconds": 112.72,
      "duration_seconds": 2.16,
      "text": "No. No weight loss."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.6,
      "end_seconds": 122.37,
      "duration_seconds": 3.77,
      "text": "Have you had any fever, fall or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.1,
      "end_seconds": 126.92,
      "duration_seconds": 3.82,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.96,
      "end_seconds": 132.69,
      "duration_seconds": 3.73,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.79,
      "end_seconds": 137.18,
      "duration_seconds": 2.39,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.03,
      "end_seconds": 140.52,
      "duration_seconds": 2.49,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.34,
      "end_seconds": 143.57,
      "duration_seconds": 2.23,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.64,
      "end_seconds": 156.69,
      "duration_seconds": 3.05,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.3,
      "end_seconds": 169.99,
      "duration_seconds": 11.69,
      "text": "I walk the dog every morning. I'm vegetarian and have been for years. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.83,
      "end_seconds": 175.04,
      "duration_seconds": 4.21,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.13,
      "end_seconds": 178.82,
      "duration_seconds": 2.69,
      "text": "Diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 180.03,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.8,
      "end_seconds": 183.33,
      "duration_seconds": 2.53,
      "text": "Paracetamol, four times a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 186.48,
      "duration_seconds": 2.38,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.72,
      "end_seconds": 195.5,
      "duration_seconds": 4.78,
      "text": "1 gram, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.01,
      "end_seconds": 198.37,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.94,
      "end_seconds": 202.18,
      "duration_seconds": 3.24,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.88,
      "end_seconds": 206.75,
      "duration_seconds": 3.87,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.78,
      "end_seconds": 212.45,
      "duration_seconds": 3.67,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.98,
      "end_seconds": 223.4,
      "duration_seconds": 10.42,
      "text": "Right, so arthritis in your knees is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.22,
      "end_seconds": 227.61,
      "duration_seconds": 3.39,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 232.79,
      "duration_seconds": 3.34,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.6,
      "end_seconds": 234.8,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.14,
      "end_seconds": 256.26,
      "duration_seconds": 6.12,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.24,
      "end_seconds": 262.82,
      "duration_seconds": 2.58,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.18,
      "end_seconds": 304.62,
      "duration_seconds": 24.44,
      "text": "Let me tell you where I've got to. This is probably hip osteoarthritis. We shouldn't forget a back problem. Let's get an X-ray of the hips, for hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. See me again in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 305.75,
      "end_seconds": 309.15,
      "duration_seconds": 3.4,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.0,
      "end_seconds": 311.95,
      "duration_seconds": 1.95,
      "text": "Right, goodbye for now."
    }
  ]
}