      "role": "DOCTOR",
      "start_seconds": 215.73,
      "end_seconds": 231.61,
      "duration_seconds": 15.88,
      "text": "Okay: height 168 centimetres, weight 70 kilos, pulse is 66 beats a minute. And temp 36.4 degrees, BP is 112 over 80, BMI works out to 24.8, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0030",
