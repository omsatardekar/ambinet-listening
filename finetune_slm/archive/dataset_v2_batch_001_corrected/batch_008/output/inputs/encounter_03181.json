{
  "schema_version": "1.0",
  "encounter_id": "03181",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 5.27,
      "duration_seconds": 4.73,
      "text": "Good morning, grab a seat. Is it your first time here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.23,
      "end_seconds": 10.3,
      "duration_seconds": 4.07,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.29,
      "end_seconds": 12.58,
      "duration_seconds": 1.29,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 20.87,
      "duration_seconds": 6.88,
      "text": "So, honestly, it's shoulder tip pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.23,
      "end_seconds": 30.08,
      "duration_seconds": 3.85,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.62,
      "end_seconds": 32.51,
      "duration_seconds": 1.89,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.05,
      "end_seconds": 36.83,
      "duration_seconds": 3.78,
      "text": "Mm-hmm. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.35,
      "end_seconds": 39.01,
      "duration_seconds": 1.66,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.62,
      "end_seconds": 54.89,
      "duration_seconds": 4.27,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.88,
      "end_seconds": 72.12,
      "duration_seconds": 3.24,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.18,
      "end_seconds": 101.34,
      "duration_seconds": 8.16,
      "text": "Okay: BP is 103 over 60, oxygen saturation is 98 percent, respiratory rate 17, pulse is 93 beats a minute."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.93,
      "end_seconds": 106.02,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.97,
      "end_seconds": 109.77,
      "duration_seconds": 1.8,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.44,
      "end_seconds": 113.59,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.22,
      "end_seconds": 139.93,
      "duration_seconds": 7.71,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.53,
      "end_seconds": 150.48,
      "duration_seconds": 5.95,
      "text": "Thank you, you can get dressed. Have you noticed vomiting, discharge or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.21,
      "end_seconds": 154.61,
      "duration_seconds": 2.4,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.51,
      "end_seconds": 159.32,
      "duration_seconds": 3.81,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.41,
      "end_seconds": 162.86,
      "duration_seconds": 1.45,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 168.28,
      "duration_seconds": 4.54,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.21,
      "end_seconds": 171.44,
      "duration_seconds": 2.23,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.3,
      "end_seconds": 176.68,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.34,
      "end_seconds": 178.85,
      "duration_seconds": 1.51,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.87,
      "end_seconds": 183.21,
      "duration_seconds": 3.34,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.88,
      "end_seconds": 191.05,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.65,
      "end_seconds": 194.42,
      "duration_seconds": 2.77,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.28,
      "end_seconds": 200.02,
      "duration_seconds": 4.74,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.38,
      "end_seconds": 216.62,
      "duration_seconds": 3.24,
      "text": "Right, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.82,
      "end_seconds": 218.91,
      "duration_seconds": 1.09,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.8,
      "end_seconds": 238.25,
      "duration_seconds": 4.45,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.66,
      "end_seconds": 243.12,
      "duration_seconds": 3.46,
      "text": "Yes, grass pollen. I get itchy eyes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.68,
      "end_seconds": 265.33,
      "duration_seconds": 8.65,
      "text": "Having listened and examined, this looks most like a ruptured ectopic pregnancy. Let's book a pregnancy test to look into collapse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.65,
      "end_seconds": 268.71,
      "duration_seconds": 2.06,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.78,
      "end_seconds": 275.28,
      "duration_seconds": 5.5,
      "text": "I am calling the emergency team, you need an operation now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.76,
      "end_seconds": 286.71,
      "duration_seconds": 10.95,
      "text": "Mm-hmm. I'd like you to see the emergency team as well, and I'll write the referral. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.53,
      "end_seconds": 290.89,
      "duration_seconds": 3.36,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.78,
      "end_seconds": 299.74,
      "duration_seconds": 2.96,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.47,
      "end_seconds": 306.63,
      "duration_seconds": 3.16,
      "text": "I think I understand everything. Thanks."
    }
  ]
}