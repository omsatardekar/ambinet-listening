{
  "schema_version": "1.0",
  "encounter_id": "03166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.24,
      "duration_seconds": 3.58,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 9.68,
      "duration_seconds": 4.16,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 26.5,
      "duration_seconds": 15.34,
      "text": "So, I've been coughing up large amounts of blood, doctor. Sorry, I know I'm rambling a bit. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.28,
      "end_seconds": 30.27,
      "duration_seconds": 2.99,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 43.03,
      "duration_seconds": 11.93,
      "text": "I've had it since this morning. I did try to ignore it for a while. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.58,
      "end_seconds": 53.71,
      "duration_seconds": 9.13,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.03,
      "end_seconds": 70.45,
      "duration_seconds": 15.42,
      "text": "It's a few times a day. Severe, really. My sister suggested writing things down, but I forgot. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 73.6,
      "duration_seconds": 2.53,
      "text": "Have you had a gurgling chest?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.64,
      "end_seconds": 78.34,
      "duration_seconds": 3.7,
      "text": "Mm, yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.87,
      "end_seconds": 79.79,
      "duration_seconds": 0.92,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.64,
      "end_seconds": 85.73,
      "duration_seconds": 4.09,
      "text": "I'd been feeling faint, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.53,
      "end_seconds": 98.76,
      "duration_seconds": 4.23,
      "text": "Okay, and what about fever, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 102.32,
      "duration_seconds": 2.31,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.17,
      "end_seconds": 106.56,
      "duration_seconds": 2.39,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.98,
      "end_seconds": 111.18,
      "duration_seconds": 3.2,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 115.18,
      "duration_seconds": 2.85,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.86,
      "end_seconds": 117.44,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.43,
      "end_seconds": 126.6,
      "duration_seconds": 3.17,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.35,
      "end_seconds": 130.55,
      "duration_seconds": 3.2,
      "text": "I've, I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 132.78,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.25,
      "end_seconds": 141.1,
      "duration_seconds": 6.85,
      "text": "I've had gout, yes. I have an underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.51,
      "end_seconds": 144.23,
      "duration_seconds": 1.72,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.06,
      "end_seconds": 152.73,
      "duration_seconds": 7.67,
      "text": "Alright, high cholesterol and an underactive thyroid, that matches what I have here. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.33,
      "end_seconds": 160.84,
      "duration_seconds": 6.51,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.78,
      "end_seconds": 174.78,
      "duration_seconds": 3.0,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.09,
      "end_seconds": 179.23,
      "duration_seconds": 3.14,
      "text": "Oh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.83,
      "end_seconds": 184.23,
      "duration_seconds": 4.4,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.9,
      "end_seconds": 196.9,
      "duration_seconds": 11.0,
      "text": "Nothing, I'm teetotal. I've never touched a cigarette. I do a yoga class on Thursdays. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.12,
      "end_seconds": 205.12,
      "duration_seconds": 7.0,
      "text": "Okay, what do you take on a normal day? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.04,
      "end_seconds": 217.1,
      "duration_seconds": 10.06,
      "text": "Allopurinol. I take it 100 milligrams, once a day for the gout. Thyroxine. I take it 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.89,
      "end_seconds": 220.96,
      "duration_seconds": 3.07,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.92,
      "end_seconds": 232.68,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.49,
      "end_seconds": 258.05,
      "duration_seconds": 8.56,
      "text": "Okay: temperature 37.1, saturation 94 percent, BP is 130 over 87, pulse 100, respiratory rate 23."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.17,
      "end_seconds": 261.33,
      "duration_seconds": 2.16,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.28,
      "end_seconds": 264.97,
      "duration_seconds": 2.69,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.7,
      "end_seconds": 270.34,
      "duration_seconds": 3.64,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.66,
      "end_seconds": 273.79,
      "duration_seconds": 2.13,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.18,
      "end_seconds": 292.55,
      "duration_seconds": 5.37,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.2,
      "end_seconds": 300.03,
      "duration_seconds": 1.83,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.66,
      "end_seconds": 337.15,
      "duration_seconds": 27.49,
      "text": "I'd like to arrange an urgent CT scan for massive haemoptysis. We'll begin with tranexamic acid, 1 gram, now, single dose. It's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Come back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.06,
      "end_seconds": 342.9,
      "duration_seconds": 3.84,
      "text": "Actually, good, thanks, I'll see you then."
    }
  ]
}