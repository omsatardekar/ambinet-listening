{
  "schema_version": "1.0",
  "encounter_id": "03095",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.53,
      "duration_seconds": 5.45,
      "text": "Let me think, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 11.66,
      "duration_seconds": 4.04,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.41,
      "end_seconds": 21.09,
      "duration_seconds": 8.68,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. We came because of dizziness on standing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.98,
      "end_seconds": 23.16,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.74,
      "end_seconds": 27.65,
      "duration_seconds": 2.91,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.75,
      "end_seconds": 33.83,
      "duration_seconds": 5.08,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.88,
      "end_seconds": 48.82,
      "duration_seconds": 12.94,
      "text": "It's worse with standing. Pretty moderate, if I'm being honest. Honestly, once or twice a day. And I've been feeling tired and weak as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.1,
      "end_seconds": 52.26,
      "duration_seconds": 2.16,
      "text": "Any darker skin as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.82,
      "end_seconds": 60.5,
      "duration_seconds": 6.68,
      "text": "Yeah. Two days, I'd say. With darker skin, I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.06,
      "end_seconds": 82.13,
      "duration_seconds": 3.07,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.51,
      "end_seconds": 85.95,
      "duration_seconds": 2.44,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.88,
      "end_seconds": 90.91,
      "duration_seconds": 4.03,
      "text": "Alright, did you get severe tummy pain or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.86,
      "end_seconds": 96.78,
      "duration_seconds": 3.92,
      "text": "No, no severe tummy pain or fainting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 100.35,
      "duration_seconds": 2.25,
      "text": "Has there been any vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.95,
      "end_seconds": 103.36,
      "duration_seconds": 2.41,
      "text": "Not at all, no vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 107.57,
      "end_seconds": 112.3,
      "duration_seconds": 4.73,
      "text": "Actually, doctor, I did notice vomiting. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.62,
      "end_seconds": 121.89,
      "duration_seconds": 8.27,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.32,
      "end_seconds": 131.0,
      "duration_seconds": 7.68,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.8,
      "end_seconds": 134.31,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.62,
      "end_seconds": 139.88,
      "duration_seconds": 2.26,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.61,
      "end_seconds": 144.15,
      "duration_seconds": 2.54,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.2,
      "end_seconds": 150.92,
      "duration_seconds": 4.72,
      "text": "So, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 155.4,
      "end_seconds": 159.22,
      "duration_seconds": 3.82,
      "text": "It's iron tablets, once a day, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.99,
      "end_seconds": 161.43,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.42,
      "end_seconds": 167.34,
      "duration_seconds": 3.92,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.37,
      "end_seconds": 171.78,
      "duration_seconds": 2.41,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.18,
      "end_seconds": 180.39,
      "duration_seconds": 4.21,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.87,
      "end_seconds": 184.24,
      "duration_seconds": 2.37,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.66,
      "end_seconds": 190.02,
      "duration_seconds": 4.36,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.24,
      "end_seconds": 193.32,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.92,
      "end_seconds": 197.93,
      "duration_seconds": 4.01,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.95,
      "end_seconds": 205.06,
      "duration_seconds": 2.11,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.81,
      "end_seconds": 211.17,
      "duration_seconds": 5.36,
      "text": "Yes, COPD. I've had low haemoglobin for about ten years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.31,
      "end_seconds": 222.08,
      "duration_seconds": 9.77,
      "text": "Right, so COPD and low haemoglobin are already on your record. We'll keep that in mind today. Right, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.12,
      "end_seconds": 225.9,
      "duration_seconds": 2.78,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.75,
      "end_seconds": 229.71,
      "duration_seconds": 2.96,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.78,
      "end_seconds": 237.07,
      "duration_seconds": 3.29,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.28,
      "end_seconds": 252.57,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.34,
      "end_seconds": 259.02,
      "duration_seconds": 2.68,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 260.65,
      "end_seconds": 269.95,
      "duration_seconds": 9.3,
      "text": "Here are the numbers, doctor. Heart rate 100, temp 36.7 degrees, pressure 99 over 66, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 272.76,
      "duration_seconds": 1.96,
      "text": "Okay, good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.96,
      "end_seconds": 278.39,
      "duration_seconds": 4.43,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.0,
      "end_seconds": 281.99,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.55,
      "end_seconds": 299.18,
      "duration_seconds": 9.63,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.99,
      "end_seconds": 305.37,
      "duration_seconds": 2.38,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.35,
      "end_seconds": 349.98,
      "duration_seconds": 33.63,
      "text": "I think a morning cortisol makes sense here, for possible adrenal insufficiency. I want a short synacthen test done, that's for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'm going to send a referral to the endocrine clinic. Book a review after the results."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.29,
      "end_seconds": 359.47,
      "duration_seconds": 5.18,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.1,
      "end_seconds": 363.54,
      "duration_seconds": 3.44,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.36,
      "end_seconds": 365.64,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}