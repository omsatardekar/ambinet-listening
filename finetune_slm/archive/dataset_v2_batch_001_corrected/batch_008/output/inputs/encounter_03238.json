{
  "schema_version": "1.0",
  "encounter_id": "03238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 8.79,
      "duration_seconds": 7.86,
      "text": "Sorry, what was I saying, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.51,
      "end_seconds": 14.31,
      "duration_seconds": 3.8,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.15,
      "end_seconds": 19.86,
      "duration_seconds": 4.71,
      "text": "Good morning, doctor. I came along to to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.04,
      "end_seconds": 24.4,
      "duration_seconds": 3.36,
      "text": "good that'll be useful. Pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.08,
      "end_seconds": 29.21,
      "duration_seconds": 4.13,
      "text": "I've been coughing up large amounts of blood"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.71,
      "end_seconds": 33.5,
      "duration_seconds": 2.79,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.01,
      "end_seconds": 42.45,
      "duration_seconds": 8.44,
      "text": "It's been going on for about a month. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.1,
      "end_seconds": 52.27,
      "duration_seconds": 8.17,
      "text": "can you describe it a bit more for me? How strong it is what the pattern is what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.28,
      "end_seconds": 59.68,
      "duration_seconds": 5.4,
      "text": "about a six out of ten. It's on and off"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.18,
      "end_seconds": 63.28,
      "duration_seconds": 2.1,
      "text": "have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.85,
      "end_seconds": 70.86,
      "duration_seconds": 6.01,
      "text": "right yes about the same about a month there's breathlessness as well"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.26,
      "end_seconds": 76.32,
      "duration_seconds": 4.06,
      "text": "And what about weight loss fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.0,
      "end_seconds": 86.17,
      "duration_seconds": 5.17,
      "text": "oh no weight loss fever or chest pain none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.12,
      "end_seconds": 90.55,
      "duration_seconds": 3.43,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.09,
      "end_seconds": 92.72,
      "duration_seconds": 1.63,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.91,
      "end_seconds": 98.28,
      "duration_seconds": 4.37,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.69,
      "end_seconds": 101.98,
      "duration_seconds": 2.29,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.55,
      "end_seconds": 105.03,
      "duration_seconds": 1.48,
      "text": "yes carry on"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.14,
      "end_seconds": 115.29,
      "duration_seconds": 9.15,
      "text": "I've had gout for about ten years now. I've had heart disease for about a year now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.13,
      "end_seconds": 117.31,
      "duration_seconds": 1.18,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.55,
      "end_seconds": 121.08,
      "duration_seconds": 2.53,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.2,
      "end_seconds": 130.3,
      "duration_seconds": 4.1,
      "text": "alright, gout, that matches what I have here"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.13,
      "end_seconds": 144.51,
      "duration_seconds": 2.38,
      "text": "Before we go further any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.47,
      "end_seconds": 148.28,
      "duration_seconds": 2.81,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 149.17,
      "end_seconds": 155.2,
      "duration_seconds": 6.03,
      "text": "I'm not sure that's right i seem to to recall a problem with naproxen"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.73,
      "end_seconds": 159.06,
      "duration_seconds": 2.33,
      "text": "really? I don't think so"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.05,
      "end_seconds": 167.7,
      "duration_seconds": 6.65,
      "text": "Alright, so that's unclear. I'll record what each of you said. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.93,
      "end_seconds": 176.59,
      "duration_seconds": 5.66,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.16,
      "end_seconds": 195.18,
      "duration_seconds": 2.02,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.39,
      "end_seconds": 205.93,
      "duration_seconds": 9.54,
      "text": "I'm on metoprolol, 50 milligrams, twice a day for my pressure. I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 207.05,
      "end_seconds": 216.51,
      "duration_seconds": 9.46,
      "text": "doctor, I think the last prescription for the febuxostat was 160 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.98,
      "end_seconds": 223.76,
      "duration_seconds": 3.78,
      "text": "I see is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.22,
      "end_seconds": 237.9,
      "duration_seconds": 12.68,
      "text": "I don't think I have it with me. I take apixaban, 5 milligrams, twice a day. I had losartan at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.11,
      "end_seconds": 247.29,
      "duration_seconds": 1.18,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.45,
      "end_seconds": 251.22,
      "duration_seconds": 2.77,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.88,
      "end_seconds": 253.73,
      "duration_seconds": 1.85,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.29,
      "end_seconds": 260.31,
      "duration_seconds": 5.02,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.28,
      "end_seconds": 265.23,
      "duration_seconds": 2.95,
      "text": "okay do you work outside the home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.07,
      "end_seconds": 270.47,
      "duration_seconds": 4.4,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.55,
      "end_seconds": 274.67,
      "duration_seconds": 2.12,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.63,
      "end_seconds": 280.71,
      "duration_seconds": 4.08,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.81,
      "end_seconds": 285.84,
      "duration_seconds": 4.03,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.09,
      "end_seconds": 299.34,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.08,
      "end_seconds": 333.73,
      "duration_seconds": 14.65,
      "text": "okay: respiratory rate 21 pulse is 93 beats a minute weight 83 kilos BMI works out to 24.5 pressure 122 over 80 temperature 37.3 oxygen saturation is 91 percent height 184 centimetres"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.59,
      "end_seconds": 337.73,
      "duration_seconds": 3.14,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.61,
      "end_seconds": 342.12,
      "duration_seconds": 3.51,
      "text": "Alright, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.42,
      "end_seconds": 347.83,
      "duration_seconds": 4.41,
      "text": "Let me look at the the area I'll be gentle."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.11,
      "end_seconds": 351.49,
      "duration_seconds": 2.38,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.61,
      "end_seconds": 373.28,
      "duration_seconds": 5.67,
      "text": "You are pale, breathing fast and and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.26,
      "end_seconds": 413.18,
      "duration_seconds": 33.92,
      "text": "All finished, thank you. Having listened and examined, it's hard to say. Life-threatening haemoptysis is one possibility and a lung tumour another, and I'd rather not commit yet. I want an urgent CT scan done, that's for massive haemoptysis. Let's get urgent blood tests, for bleeding. I'd like you to take tranexamic acid, 1 gram, now, single dose. It's for haemoptysis. Lie on the bleeding side and I am calling the emergency team."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.16,
      "end_seconds": 430.21,
      "duration_seconds": 15.05,
      "text": "Let's get you seen by the emergency team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.62,
      "end_seconds": 434.34,
      "duration_seconds": 2.72,
      "text": "Okay I'll look out for that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.95,
      "end_seconds": 440.84,
      "duration_seconds": 4.89,
      "text": "see me again straight away have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 441.82,
      "end_seconds": 444.71,
      "duration_seconds": 2.89,
      "text": "I think I understand everything. Thanks."
    }
  ]
}