{
  "schema_version": "1.0",
  "encounter_id": "03407",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.29,
      "duration_seconds": 4.43,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.36,
      "end_seconds": 11.86,
      "duration_seconds": 4.5,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.55,
      "end_seconds": 19.52,
      "duration_seconds": 5.97,
      "text": "I've been feeling tired and weak, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 24.88,
      "duration_seconds": 3.53,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.47,
      "end_seconds": 38.01,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 59.04,
      "duration_seconds": 7.47,
      "text": "Okay: saturation 96 percent, BP is 94 over 61, temp 37.0 degrees, heart rate 93."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.11,
      "end_seconds": 73.89,
      "duration_seconds": 3.78,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.89,
      "end_seconds": 85.46,
      "duration_seconds": 9.57,
      "text": "For three days, I'd say. Hmm, uh, and there's dizziness on standing as well, two days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.05,
      "end_seconds": 95.19,
      "duration_seconds": 9.14,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.26,
      "end_seconds": 107.64,
      "duration_seconds": 10.38,
      "text": "Yeah, a eight out of ten, I suppose. It's every other day. I notice it more with standing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.34,
      "end_seconds": 113.47,
      "duration_seconds": 5.13,
      "text": "Have you been feeling tired and weak at any time before this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.3,
      "end_seconds": 118.79,
      "duration_seconds": 4.49,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.3,
      "end_seconds": 120.94,
      "duration_seconds": 1.64,
      "text": "Any fainting or vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.44,
      "end_seconds": 126.9,
      "duration_seconds": 4.46,
      "text": "Erm, no fainting or vomiting, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.43,
      "end_seconds": 130.92,
      "duration_seconds": 2.49,
      "text": "Any severe tummy pain or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.3,
      "end_seconds": 136.21,
      "duration_seconds": 3.91,
      "text": "No, no severe tummy pain or fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.28,
      "end_seconds": 142.13,
      "duration_seconds": 3.85,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.13,
      "end_seconds": 148.75,
      "duration_seconds": 1.62,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.0,
      "end_seconds": 153.73,
      "duration_seconds": 3.73,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.97,
      "end_seconds": 156.47,
      "duration_seconds": 1.5,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.81,
      "end_seconds": 176.63,
      "duration_seconds": 3.82,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.29,
      "end_seconds": 182.75,
      "duration_seconds": 5.46,
      "text": "I've had COPD, yes. I have anxiety, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.3,
      "end_seconds": 192.52,
      "duration_seconds": 9.22,
      "text": "Okay, I can see COPD and anxiety in your file as well. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.39,
      "end_seconds": 197.17,
      "duration_seconds": 3.78,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.5,
      "end_seconds": 203.57,
      "duration_seconds": 5.07,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.68,
      "end_seconds": 228.63,
      "duration_seconds": 23.95,
      "text": "Tiotropium inhaler. I take it once a day. I did try to ignore it for a while. I didn't want to bother you but it keeps coming back. Escitalopram, 10 milligrams, once a day. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.53,
      "end_seconds": 232.17,
      "duration_seconds": 1.64,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.92,
      "end_seconds": 238.5,
      "duration_seconds": 5.58,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.27,
      "end_seconds": 242.35,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.13,
      "end_seconds": 247.55,
      "duration_seconds": 4.42,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.97,
      "end_seconds": 250.69,
      "duration_seconds": 1.72,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.35,
      "end_seconds": 255.48,
      "duration_seconds": 4.13,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.65,
      "end_seconds": 259.41,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.51,
      "end_seconds": 265.56,
      "duration_seconds": 4.05,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 270.99,
      "duration_seconds": 4.44,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.68,
      "end_seconds": 277.4,
      "duration_seconds": 4.72,
      "text": "I'm allergic to grass pollen, I get itchy eyes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.48,
      "end_seconds": 281.81,
      "duration_seconds": 3.33,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.65,
      "end_seconds": 285.02,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.21,
      "end_seconds": 308.87,
      "duration_seconds": 8.66,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.98,
      "end_seconds": 314.48,
      "duration_seconds": 2.5,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.24,
      "end_seconds": 363.98,
      "duration_seconds": 37.74,
      "text": "From what you've told me and what I found, I'd lean towards possible adrenal insufficiency. The reason I say that is that your story and my examination fit together. Let's book blood tests to look into possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'm not ordering a short synacthen test today. If things carry on in a month, we'll consider it. Book a review after the results."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.95,
      "end_seconds": 369.4,
      "duration_seconds": 3.45,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.05,
      "end_seconds": 373.48,
      "duration_seconds": 3.43,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.52,
      "end_seconds": 376.73,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}