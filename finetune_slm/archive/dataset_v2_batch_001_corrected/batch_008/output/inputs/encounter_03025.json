{
  "schema_version": "1.0",
  "encounter_id": "03025",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 2.89,
      "duration_seconds": 2.04,
      "text": "morning, come on through"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.89,
      "end_seconds": 9.0,
      "duration_seconds": 4.11,
      "text": "good morning, um, doctor, thank you"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.43,
      "end_seconds": 13.59,
      "duration_seconds": 3.16,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.86,
      "end_seconds": 25.1,
      "duration_seconds": 6.24,
      "text": "yes, that's no problem at all please sit so what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.26,
      "end_seconds": 30.4,
      "duration_seconds": 4.14,
      "text": "Well, I've been having a sudden severe tummy pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.62,
      "end_seconds": 33.61,
      "duration_seconds": 1.99,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.34,
      "end_seconds": 48.11,
      "duration_seconds": 13.77,
      "text": "It's been two days now. I thought it would sort itself out, but it hasn't. My neighbour said I should get it it looked at."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.09,
      "end_seconds": 51.36,
      "duration_seconds": 2.27,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.88,
      "end_seconds": 55.84,
      "duration_seconds": 2.96,
      "text": "I notice it more with movement."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.42,
      "end_seconds": 59.88,
      "duration_seconds": 2.46,
      "text": "have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.66,
      "end_seconds": 63.47,
      "duration_seconds": 2.81,
      "text": "Lying still helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.04,
      "end_seconds": 69.61,
      "duration_seconds": 5.57,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 69.71,
      "end_seconds": 76.95,
      "duration_seconds": 7.24,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.17,
      "end_seconds": 80.25,
      "duration_seconds": 2.08,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.83,
      "end_seconds": 86.95,
      "duration_seconds": 5.12,
      "text": "right, and shoulder tip pain as well, since Monday"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.53,
      "end_seconds": 93.42,
      "duration_seconds": 5.89,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.36,
      "end_seconds": 101.87,
      "duration_seconds": 7.51,
      "text": "It happens on and off. There was pain spreading all over yes but that went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.67,
      "end_seconds": 123.19,
      "duration_seconds": 3.52,
      "text": "are you taking anything regularly including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.24,
      "end_seconds": 142.13,
      "duration_seconds": 16.89,
      "text": "Yeah I take Asthalin inhaler when needed for my asthma. It's ibuprofen 600 milligrams three times a day. Erm I had pantoprazole at one point but I'm off it now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.53,
      "end_seconds": 147.14,
      "duration_seconds": 3.61,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.19,
      "end_seconds": 156.48,
      "duration_seconds": 7.29,
      "text": "My grandfather had a a stroke. Hmm, uh, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.19,
      "end_seconds": 162.58,
      "duration_seconds": 2.39,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.59,
      "end_seconds": 170.63,
      "duration_seconds": 7.04,
      "text": "Let me think uh yes I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.34,
      "end_seconds": 174.89,
      "duration_seconds": 2.55,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.83,
      "end_seconds": 183.68,
      "duration_seconds": 6.85,
      "text": "Asthma, for about ten years. Actually, I have acid reflux, for about ten years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.16,
      "end_seconds": 189.62,
      "duration_seconds": 4.46,
      "text": "okay I can see acid reflux in your file as well"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.19,
      "end_seconds": 209.92,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.04,
      "end_seconds": 214.97,
      "duration_seconds": 3.93,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.11,
      "end_seconds": 219.65,
      "duration_seconds": 3.54,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.62,
      "end_seconds": 223.91,
      "duration_seconds": 3.29,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.81,
      "end_seconds": 229.45,
      "duration_seconds": 4.64,
      "text": "Did you get blood in the vomit, fever or diarrhoea?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.21,
      "end_seconds": 235.16,
      "duration_seconds": 4.95,
      "text": "So, no, no blood in the vomit, fever or diarrhoea."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.85,
      "end_seconds": 239.35,
      "duration_seconds": 2.5,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.03,
      "end_seconds": 244.06,
      "duration_seconds": 3.03,
      "text": "no, um, skin's been fine"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 248.13,
      "duration_seconds": 2.12,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.22,
      "end_seconds": 251.69,
      "duration_seconds": 1.47,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 253.02,
      "end_seconds": 270.21,
      "duration_seconds": 17.19,
      "text": "okay, so the vitals from earlier pulse 113, SpO2 99 percent on room air weight 96 kilos, height 169 centimetres, temperature 36.7, BMI works out to 33.6, blood pressure 134 over 76, respiratory rate 18."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.48,
      "end_seconds": 274.18,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 279.66,
      "duration_seconds": 4.21,
      "text": "I'd like to check you over now if that's alright"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.09,
      "end_seconds": 282.91,
      "duration_seconds": 1.82,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.8,
      "end_seconds": 307.26,
      "duration_seconds": 7.46,
      "text": "your tummy is rigid like a board and very tender everywhere, and you are lying completely still"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.13,
      "end_seconds": 324.93,
      "duration_seconds": 12.8,
      "text": "good you can sit up again. So based on the the history and the examination this is probably a perforated stomach ulcer. I can't rule out pancreatitis yet"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.94,
      "end_seconds": 329.79,
      "duration_seconds": 3.85,
      "text": "Is it it dangerous, um, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.4,
      "end_seconds": 345.47,
      "duration_seconds": 14.07,
      "text": "I can't promise yet, but most people with a perforated stomach ulcer do well once it's treated properly. I'd like to arrange an erect chest X-ray for possible perforation."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 346.07,
      "end_seconds": 349.7,
      "duration_seconds": 3.63,
      "text": "the the earliest is Wednesday, 11:30 am"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.76,
      "end_seconds": 371.58,
      "duration_seconds": 19.82,
      "text": "I'd like to arrange a CT scan for possible perforation. Nothing to eat or drink you need an operation urgently. Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.38,
      "end_seconds": 375.75,
      "duration_seconds": 3.37,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}