{
  "schema_version": "1.0",
  "encounter_id": "03125",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.11,
      "duration_seconds": 5.84,
      "text": "Doctor? Hello, uh, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.35,
      "end_seconds": 13.08,
      "duration_seconds": 4.73,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.86,
      "end_seconds": 20.09,
      "duration_seconds": 6.23,
      "text": "Mainly I've been feeling anxious and agitated. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 23.83,
      "duration_seconds": 3.18,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.82,
      "end_seconds": 28.74,
      "duration_seconds": 2.92,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.78,
      "end_seconds": 33.0,
      "duration_seconds": 2.22,
      "text": "So, any shaking as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.45,
      "end_seconds": 37.28,
      "duration_seconds": 2.83,
      "text": "Yes, you know, I have."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.92,
      "end_seconds": 42.97,
      "duration_seconds": 3.05,
      "text": "And what about vomiting blood or confusion?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.5,
      "end_seconds": 48.87,
      "duration_seconds": 5.37,
      "text": "Hmm, I haven't had vomiting blood or confusion, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.56,
      "end_seconds": 51.56,
      "duration_seconds": 2.0,
      "text": "Any seeing things or seizure?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.9,
      "end_seconds": 56.55,
      "duration_seconds": 3.65,
      "text": "Hmm, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.11,
      "end_seconds": 59.43,
      "duration_seconds": 2.32,
      "text": "Understood. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.17,
      "end_seconds": 63.13,
      "duration_seconds": 2.96,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.87,
      "end_seconds": 68.24,
      "duration_seconds": 4.37,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.01,
      "end_seconds": 71.37,
      "duration_seconds": 2.36,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.54,
      "end_seconds": 82.83,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.85,
      "end_seconds": 87.58,
      "duration_seconds": 3.73,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.41,
      "end_seconds": 92.32,
      "duration_seconds": 2.91,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.9,
      "end_seconds": 96.86,
      "duration_seconds": 2.96,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.84,
      "end_seconds": 103.19,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.6,
      "end_seconds": 108.11,
      "duration_seconds": 3.51,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.69,
      "end_seconds": 116.37,
      "duration_seconds": 3.68,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.46,
      "end_seconds": 121.82,
      "duration_seconds": 2.36,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.12,
      "end_seconds": 139.17,
      "duration_seconds": 6.05,
      "text": "Any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.85,
      "end_seconds": 146.03,
      "duration_seconds": 3.18,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.69,
      "end_seconds": 151.49,
      "duration_seconds": 3.8,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.9,
      "end_seconds": 158.45,
      "duration_seconds": 5.55,
      "text": "It's heavy drinking until two days ago, stopped two days ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 162.48,
      "duration_seconds": 2.08,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.94,
      "end_seconds": 169.12,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.07,
      "end_seconds": 175.57,
      "duration_seconds": 4.5,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.31,
      "end_seconds": 190.86,
      "duration_seconds": 2.55,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 214.35,
      "duration_seconds": 8.92,
      "text": "Okay: respiratory rate 19, pulse is 126 beats a minute, blood pressure 112 over 81, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.38,
      "end_seconds": 219.9,
      "duration_seconds": 3.52,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.76,
      "end_seconds": 223.05,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.23,
      "end_seconds": 242.08,
      "duration_seconds": 5.85,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.94,
      "end_seconds": 249.91,
      "duration_seconds": 1.97,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.0,
      "end_seconds": 274.35,
      "duration_seconds": 9.35,
      "text": "So, based on the history and the examination, this looks most like alcohol withdrawal. I want blood tests done, that's for alcohol withdrawal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.68,
      "end_seconds": 276.86,
      "duration_seconds": 1.18,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.58,
      "end_seconds": 292.76,
      "duration_seconds": 15.18,
      "text": "We'll begin with chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. That's for alcohol withdrawal. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.33,
      "end_seconds": 297.11,
      "duration_seconds": 1.78,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.26,
      "end_seconds": 306.44,
      "duration_seconds": 8.18,
      "text": "Do not stop alcohol suddenly without medical support. I'm going to send a referral to the alcohol liaison service."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.48,
      "end_seconds": 309.18,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.22,
      "end_seconds": 320.55,
      "duration_seconds": 9.33,
      "text": "If the symptoms get worse, that's the point to come in urgently. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.95,
      "end_seconds": 324.25,
      "duration_seconds": 2.3,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.26,
      "end_seconds": 327.62,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}