{
  "schema_version": "1.0",
  "encounter_id": "03284",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.78,
      "duration_seconds": 4.43,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 11.67,
      "duration_seconds": 4.27,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 21.39,
      "duration_seconds": 8.57,
      "text": "It's sudden breathlessness five days after surgery. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.6,
      "end_seconds": 25.62,
      "duration_seconds": 4.02,
      "text": "I see, go ahead. How often do you get it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.35,
      "end_seconds": 43.95,
      "duration_seconds": 16.6,
      "text": "It happens a couple of times a week. Ah, I've also had sharp chest pain on breathing in. As for sharp chest pain on breathing in, mild, really. Oh, and a swollen calf."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.2,
      "end_seconds": 48.16,
      "duration_seconds": 2.96,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.07,
      "end_seconds": 50.66,
      "duration_seconds": 1.59,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.6,
      "end_seconds": 58.68,
      "duration_seconds": 6.08,
      "text": "Let me check a few things. Any coughing up blood, fever or wound problem?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.53,
      "end_seconds": 66.88,
      "duration_seconds": 6.35,
      "text": "No coughing up blood, fever or wound problem, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.5,
      "end_seconds": 72.73,
      "duration_seconds": 4.23,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.78,
      "end_seconds": 76.83,
      "duration_seconds": 2.05,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.74,
      "end_seconds": 89.37,
      "duration_seconds": 2.63,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.06,
      "end_seconds": 99.01,
      "duration_seconds": 8.95,
      "text": "Asthma, for about a year. I'd rather know what's going on than keep guessing. I've got heart disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 109.85,
      "duration_seconds": 8.9,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.61,
      "end_seconds": 114.51,
      "duration_seconds": 2.9,
      "text": "It's aspirin, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.69,
      "end_seconds": 117.7,
      "duration_seconds": 2.01,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 119.21,
      "duration_seconds": 0.98,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.79,
      "end_seconds": 130.95,
      "duration_seconds": 2.16,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.69,
      "end_seconds": 135.27,
      "duration_seconds": 3.58,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.13,
      "end_seconds": 139.24,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 143.04,
      "duration_seconds": 2.26,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 163.02,
      "duration_seconds": 2.51,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.82,
      "end_seconds": 169.84,
      "duration_seconds": 5.02,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.12,
      "end_seconds": 174.29,
      "duration_seconds": 3.17,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.56,
      "end_seconds": 189.98,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.74,
      "end_seconds": 220.91,
      "duration_seconds": 9.17,
      "text": "Okay: BP is 141 over 76, saturation 91 percent, pulse is 87 beats a minute. And temp 37.1 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.65,
      "end_seconds": 224.07,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.7,
      "end_seconds": 229.73,
      "duration_seconds": 4.03,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.1,
      "end_seconds": 234.67,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.52,
      "end_seconds": 237.79,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.78,
      "end_seconds": 250.97,
      "duration_seconds": 5.19,
      "text": "Your left calf is swollen and tender and your oxygen is low."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.7,
      "end_seconds": 255.06,
      "duration_seconds": 2.36,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.52,
      "end_seconds": 271.27,
      "duration_seconds": 13.75,
      "text": "Please sit back down. Let's get a CT pulmonary angiogram, for possible pulmonary embolus. I'm going to put you on enoxaparin, 1.5 mg per kg, once now, single dose. That's for possible clot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.89,
      "end_seconds": 278.42,
      "duration_seconds": 1.53,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.73,
      "end_seconds": 303.62,
      "duration_seconds": 18.89,
      "text": "Please go to hospital now, I will call ahead. A D-dimer is something we might do if this doesn't improve in a month. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.26,
      "end_seconds": 313.77,
      "duration_seconds": 8.51,
      "text": "So, I take the enoxaparin, 1.5 mg per kg, once now. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.74,
      "end_seconds": 318.36,
      "duration_seconds": 3.62,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.04,
      "end_seconds": 321.84,
      "duration_seconds": 1.8,
      "text": "That's clear, thanks."
    }
  ]
}