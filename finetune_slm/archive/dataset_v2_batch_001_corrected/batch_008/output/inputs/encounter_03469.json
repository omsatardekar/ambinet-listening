{
  "schema_version": "1.0",
  "encounter_id": "03469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 2.69,
      "duration_seconds": 1.68,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.08,
      "end_seconds": 6.94,
      "duration_seconds": 2.86,
      "text": "good morning, doctor, thank you"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.78,
      "end_seconds": 12.73,
      "duration_seconds": 3.95,
      "text": "okay, is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 20.46,
      "duration_seconds": 6.0,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.12,
      "end_seconds": 23.42,
      "duration_seconds": 1.3,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.46,
      "end_seconds": 45.08,
      "duration_seconds": 19.62,
      "text": "I wanted to get a severe headache for days looked at a neighbour of mine said I should see someone about it i'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 46.81,
      "end_seconds": 58.14,
      "duration_seconds": 11.33,
      "text": "Doctor, I've got the readings for you. Temperature 36.8, blood pressure 150 over 88. Pulse 72, respiratory rate 14, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 65.96,
      "duration_seconds": 6.33,
      "text": "Good, thank you. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.24,
      "end_seconds": 83.94,
      "duration_seconds": 12.7,
      "text": "Well, it's a couple of times a week. I notice it more with lying down. Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.69,
      "end_seconds": 90.8,
      "duration_seconds": 6.11,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 90.9,
      "end_seconds": 97.39,
      "duration_seconds": 6.49,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 103.24,
      "duration_seconds": 2.29,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.42,
      "end_seconds": 111.61,
      "duration_seconds": 4.19,
      "text": "I've also had drowsiness, for two months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 115.28,
      "duration_seconds": 2.95,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.03,
      "end_seconds": 118.09,
      "duration_seconds": 2.06,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.76,
      "end_seconds": 120.72,
      "duration_seconds": 1.96,
      "text": "has there been any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.91,
      "end_seconds": 125.15,
      "duration_seconds": 3.24,
      "text": "No, um, none, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.49,
      "end_seconds": 129.89,
      "duration_seconds": 3.4,
      "text": "Any weakness on one side or head injury?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.62,
      "end_seconds": 145.65,
      "duration_seconds": 14.03,
      "text": "No, you know, no weakness on one side, no head injury. I did have double vision at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.57,
      "end_seconds": 149.02,
      "duration_seconds": 2.45,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.37,
      "end_seconds": 152.48,
      "duration_seconds": 2.11,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.08,
      "end_seconds": 159.18,
      "duration_seconds": 5.1,
      "text": "what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.95,
      "end_seconds": 166.52,
      "duration_seconds": 5.57,
      "text": "I mean, I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.18,
      "end_seconds": 170.15,
      "duration_seconds": 2.97,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.73,
      "end_seconds": 178.19,
      "duration_seconds": 4.46,
      "text": "I have high blood pressure, for two years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.41,
      "end_seconds": 187.92,
      "duration_seconds": 8.51,
      "text": "Alright, high cholesterol and high blood pressure, that matches what I have here. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.3,
      "end_seconds": 196.6,
      "duration_seconds": 7.3,
      "text": "I, I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.47,
      "end_seconds": 203.46,
      "duration_seconds": 4.99,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.09,
      "end_seconds": 215.88,
      "duration_seconds": 7.79,
      "text": "Yes, naproxen, it gives me a rash. Yes, erythromycin. I get a rash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.81,
      "end_seconds": 224.78,
      "duration_seconds": 0.97,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.9,
      "end_seconds": 230.25,
      "duration_seconds": 4.35,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.72,
      "end_seconds": 233.75,
      "duration_seconds": 2.03,
      "text": "okay, and your job?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.08,
      "end_seconds": 238.6,
      "duration_seconds": 3.52,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 249.72,
      "duration_seconds": 2.26,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.82,
      "end_seconds": 258.66,
      "duration_seconds": 7.84,
      "text": "The contraceptive pill, daily. Hmm, before this I was on simvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.66,
      "end_seconds": 263.05,
      "duration_seconds": 3.39,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.87,
      "end_seconds": 269.29,
      "duration_seconds": 5.42,
      "text": "My grandmother had dementia. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.89,
      "end_seconds": 281.45,
      "duration_seconds": 10.56,
      "text": "Okay, so my impression from what you've said is this: I'd lean towards possible cerebral venous thrombosis. Raised pressure in the head is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.87,
      "end_seconds": 285.97,
      "duration_seconds": 3.1,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.65,
      "end_seconds": 302.66,
      "duration_seconds": 15.01,
      "text": "it's reasonable to be concerned, but right now possible cerebral venous thrombosis is my leading thought, not anything worse i'm going to to order an urgent CT venogram, for possible venous thrombosis"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.03,
      "end_seconds": 308.58,
      "duration_seconds": 4.55,
      "text": "We have a slot Friday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.93,
      "end_seconds": 312.67,
      "duration_seconds": 2.74,
      "text": "Friday, that works for me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.23,
      "end_seconds": 343.01,
      "duration_seconds": 29.78,
      "text": "I want an MRI of the head done, that's for papilloedema. It's a routine test and it'll give us a much clearer picture. Stop the pill, you need an urgent scan and admission. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. The neurology team would be the right next step, I'll refer you. Come back straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.98,
      "end_seconds": 347.03,
      "duration_seconds": 3.05,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.06,
      "end_seconds": 350.7,
      "duration_seconds": 1.64,
      "text": "have a good day"
    }
  ]
}