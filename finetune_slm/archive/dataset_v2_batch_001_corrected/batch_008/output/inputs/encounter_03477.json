{
  "schema_version": "1.0",
  "encounter_id": "03477",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 5.72,
      "duration_seconds": 4.52,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.18,
      "end_seconds": 11.29,
      "duration_seconds": 4.11,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.02,
      "end_seconds": 19.08,
      "duration_seconds": 6.06,
      "text": "Yeah, it's a bit tired sometimes. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 24.2,
      "duration_seconds": 4.62,
      "text": "Yes, carry on. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.05,
      "end_seconds": 34.83,
      "duration_seconds": 9.78,
      "text": "About a six out of ten. Brittle nails was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.53,
      "end_seconds": 40.95,
      "duration_seconds": 4.42,
      "text": "Let me check a few things. Any breathlessness or dizziness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.07,
      "end_seconds": 45.81,
      "duration_seconds": 3.74,
      "text": "No breathlessness or dizziness, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.75,
      "end_seconds": 51.27,
      "duration_seconds": 3.52,
      "text": "have you had any heavy periods or black stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.76,
      "end_seconds": 56.39,
      "duration_seconds": 3.63,
      "text": "No, no heavy periods or black stools."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.05,
      "end_seconds": 60.39,
      "duration_seconds": 3.34,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.99,
      "end_seconds": 62.55,
      "duration_seconds": 1.56,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.69,
      "end_seconds": 67.05,
      "duration_seconds": 3.36,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.67,
      "end_seconds": 77.73,
      "duration_seconds": 10.06,
      "text": "yes, I had my septum straightened, in my thirties. I've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.39,
      "end_seconds": 82.85,
      "duration_seconds": 3.46,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.56,
      "end_seconds": 92.6,
      "duration_seconds": 8.04,
      "text": "Years back I got stomach pain from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.13,
      "end_seconds": 106.96,
      "duration_seconds": 2.83,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.86,
      "end_seconds": 111.05,
      "duration_seconds": 2.19,
      "text": "Febuxostat, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.46,
      "end_seconds": 118.29,
      "duration_seconds": 2.83,
      "text": "Do you know the the dose?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.26,
      "end_seconds": 124.09,
      "duration_seconds": 4.83,
      "text": "80 milligrams. It's spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.43,
      "end_seconds": 147.57,
      "duration_seconds": 6.14,
      "text": "Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 158.78,
      "duration_seconds": 10.01,
      "text": "Lots of rice, lentils and some fruit. I swim twice a week. I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.09,
      "end_seconds": 165.24,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.03,
      "end_seconds": 170.2,
      "duration_seconds": 1.17,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.78,
      "end_seconds": 173.16,
      "duration_seconds": 1.38,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.88,
      "end_seconds": 175.59,
      "duration_seconds": 1.71,
      "text": "yes, heart failure"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 178.13,
      "duration_seconds": 1.22,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.14,
      "end_seconds": 199.15,
      "duration_seconds": 3.01,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.74,
      "end_seconds": 214.77,
      "duration_seconds": 2.03,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.34,
      "end_seconds": 237.99,
      "duration_seconds": 7.65,
      "text": "Okay: saturation 98 percent, pulse 66. And respiratory rate 16, blood pressure 115 over 77, temperature 36.9."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.09,
      "end_seconds": 241.36,
      "duration_seconds": 2.27,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 246.25,
      "duration_seconds": 3.61,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.48,
      "end_seconds": 251.24,
      "duration_seconds": 3.76,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.02,
      "end_seconds": 254.14,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.98,
      "end_seconds": 257.74,
      "duration_seconds": 1.76,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.35,
      "end_seconds": 273.89,
      "duration_seconds": 5.54,
      "text": "Your pulse and blood pressure are normal and the eyelids are a good colour."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.68,
      "end_seconds": 305.77,
      "duration_seconds": 26.09,
      "text": "Good, you can sit up again. So where does that leave us? My working impression is mildly low iron stores risk from diet. Let's get a B12 level, for vegetarian diet. That will help us see what's going on underneath and decide the next step. Eat pulses, leafy greens and vitamin-C rich foods with meals."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.76,
      "end_seconds": 310.49,
      "duration_seconds": 3.73,
      "text": "Can you send me for a ferritin level?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.88,
      "end_seconds": 326.9,
      "duration_seconds": 15.02,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.03,
      "end_seconds": 329.78,
      "duration_seconds": 1.75,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.6,
      "end_seconds": 335.64,
      "duration_seconds": 4.04,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.71,
      "end_seconds": 340.98,
      "duration_seconds": 3.27,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.55,
      "end_seconds": 343.46,
      "duration_seconds": 1.91,
      "text": "Have a good day."
    }
  ]
}