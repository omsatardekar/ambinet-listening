      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.15,
      "end_seconds": 77.45,
      "duration_seconds": 7.3,
      "text": "Sorry, uh, what was I saying, it feels mild to to me."
