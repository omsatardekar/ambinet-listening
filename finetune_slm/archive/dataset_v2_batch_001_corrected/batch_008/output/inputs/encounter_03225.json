      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.09,
      "end_seconds": 95.86,
      "duration_seconds": 5.77,
      "text": "Let me check a few things. Any vomiting or severe tummy pain?"
