      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.49,
      "end_seconds": 227.73,
      "duration_seconds": 5.24,
      "text": "Okay: temperature 36.9, pulse 94, BP is 97 over 65."
