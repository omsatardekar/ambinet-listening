    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.88,
      "end_seconds": 133.26,
      "duration_seconds": 2.38,
      "text": "Now some background about your lifestyle."
