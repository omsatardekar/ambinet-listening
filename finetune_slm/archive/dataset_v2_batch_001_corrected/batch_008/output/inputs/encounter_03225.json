    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.82,
      "end_seconds": 162.25,
      "duration_seconds": 4.43,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.54,
      "end_seconds": 167.59,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.3,
      "end_seconds": 173.85,
      "duration_seconds": 5.55,
      "text": "I've got thin bones. I have depression, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.9,
      "end_seconds": 184.92,
      "duration_seconds": 9.02,
      "text": "Okay, I can see thin bones in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.64,
      "end_seconds": 191.5,
      "duration_seconds": 5.86,
      "text": "Alendronate, 70 milligrams, once a week. Fluoxetine, 20 milligrams, every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.11,
      "end_seconds": 196.55,
      "duration_seconds": 3.44,
      "text": "Shall I check your blood pressure and pulse?"
