      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.65,
      "end_seconds": 233.06,
      "duration_seconds": 3.41,
      "text": "Could you come over to the couch, please?"
