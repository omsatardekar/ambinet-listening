    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 104.68,
      "duration_seconds": 3.22,
      "text": "Have you had any fainting or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.41,
      "end_seconds": 111.17,
      "duration_seconds": 4.76,
      "text": "I, I haven't had fainting or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.75,
      "end_seconds": 115.59,
      "duration_seconds": 2.84,
      "text": "Right, is your digestion otherwise okay?"
