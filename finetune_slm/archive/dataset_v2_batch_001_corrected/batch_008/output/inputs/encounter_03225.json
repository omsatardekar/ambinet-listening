      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.99,
      "end_seconds": 43.1,
      "duration_seconds": 3.11,
      "text": "Okay, does anything else come with it?"
