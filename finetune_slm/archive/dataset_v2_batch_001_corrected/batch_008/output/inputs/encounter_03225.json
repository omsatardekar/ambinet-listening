    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.11,
      "end_seconds": 99.67,
      "duration_seconds": 2.56,
      "text": "No, not a single one."
