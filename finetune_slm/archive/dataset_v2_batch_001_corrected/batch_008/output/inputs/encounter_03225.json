      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.49,
      "end_seconds": 151.48,
      "duration_seconds": 16.99,
      "text": "No, I've never smoked in my life. I drink a lot of tea and snack through the day. Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
