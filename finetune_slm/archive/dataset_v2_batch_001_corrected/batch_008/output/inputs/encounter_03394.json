{
  "schema_version": "1.0",
  "encounter_id": "03394",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 4.47,
      "duration_seconds": 3.51,
      "text": "Yeah, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.17,
      "end_seconds": 9.44,
      "duration_seconds": 4.27,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.67,
      "end_seconds": 14.09,
      "duration_seconds": 3.42,
      "text": "Oh, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.1,
      "end_seconds": 20.0,
      "duration_seconds": 4.9,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.39,
      "end_seconds": 30.54,
      "duration_seconds": 9.15,
      "text": "Um, um, so... severe burning. That's why I came. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.1,
      "end_seconds": 35.71,
      "duration_seconds": 3.61,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.66,
      "end_seconds": 40.83,
      "duration_seconds": 3.17,
      "text": "I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.34,
      "end_seconds": 45.35,
      "duration_seconds": 4.01,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.05,
      "end_seconds": 50.38,
      "duration_seconds": 4.33,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.48,
      "end_seconds": 63.19,
      "duration_seconds": 7.71,
      "text": "Mm, yes, somewhere around that. I've also had being unable to open it, for one week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.61,
      "end_seconds": 69.68,
      "duration_seconds": 5.07,
      "text": "Have you had a splash of cleaning fluid in your eye?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.72,
      "end_seconds": 72.74,
      "duration_seconds": 1.02,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.76,
      "end_seconds": 76.41,
      "duration_seconds": 2.65,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.94,
      "end_seconds": 87.09,
      "duration_seconds": 3.15,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 113.65,
      "duration_seconds": 10.66,
      "text": "Okay: temp 36.8 degrees, SpO2 99 percent on room air, BP is 110 over 70. And pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.04,
      "end_seconds": 120.43,
      "duration_seconds": 5.39,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.87,
      "end_seconds": 123.24,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.95,
      "end_seconds": 144.47,
      "duration_seconds": 8.52,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.21,
      "end_seconds": 146.27,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.08,
      "end_seconds": 155.16,
      "duration_seconds": 6.08,
      "text": "Good, you can sit up again. Any both eyes or head injury at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.15,
      "end_seconds": 162.72,
      "duration_seconds": 5.57,
      "text": "I, I haven't had both eyes or head injury, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.62,
      "end_seconds": 169.94,
      "duration_seconds": 3.32,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.52,
      "end_seconds": 172.79,
      "duration_seconds": 2.27,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.28,
      "end_seconds": 191.28,
      "duration_seconds": 4.0,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.11,
      "end_seconds": 206.77,
      "duration_seconds": 14.66,
      "text": "I have about eight cigarettes in a day. Lots of rice, lentils and some fruit. I swim twice a week. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.65,
      "end_seconds": 219.28,
      "duration_seconds": 3.63,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.16,
      "end_seconds": 225.17,
      "duration_seconds": 5.01,
      "text": "My grandmother had dementia. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.22,
      "end_seconds": 232.77,
      "duration_seconds": 2.55,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.44,
      "end_seconds": 243.69,
      "duration_seconds": 9.25,
      "text": "Sorry, um, what was I saying, I've had COPD for about a year now. Eczema, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.38,
      "end_seconds": 245.8,
      "duration_seconds": 1.42,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 257.7,
      "duration_seconds": 11.08,
      "text": "Okay, I can see COPD in your file as well. Do you react to any medicines or foods? Any allergies? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.65,
      "end_seconds": 271.14,
      "duration_seconds": 11.49,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.78,
      "end_seconds": 274.73,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.58,
      "end_seconds": 278.41,
      "duration_seconds": 2.83,
      "text": "It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 282.71,
      "end_seconds": 291.83,
      "duration_seconds": 9.12,
      "text": "Mm, it's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.71,
      "end_seconds": 295.79,
      "duration_seconds": 2.08,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.7,
      "end_seconds": 299.84,
      "duration_seconds": 3.14,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.49,
      "end_seconds": 305.04,
      "duration_seconds": 4.55,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.85,
      "end_seconds": 317.93,
      "duration_seconds": 12.08,
      "text": "From what you've told me and what I found, I'd lean towards an alkali chemical burn to the eye. Another possibility is a corneal abrasion."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.55,
      "end_seconds": 324.91,
      "duration_seconds": 3.36,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.64,
      "end_seconds": 342.37,
      "duration_seconds": 15.73,
      "text": "Nothing I've seen today points to an emergency. It looks like an alkali chemical burn to the eye, but I'd like to confirm. So, to recap quickly. You've had severe burning, and no head injury or both eyes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.39,
      "end_seconds": 344.09,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.0,
      "end_seconds": 363.56,
      "duration_seconds": 5.56,
      "text": "Let's book an urgent eye assessment to look into chemical eye injury."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.21,
      "end_seconds": 366.34,
      "duration_seconds": 2.13,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.83,
      "end_seconds": 396.37,
      "duration_seconds": 28.54,
      "text": "I'll request an urgent pH check, it'll help with chemical burn. That will help us see what's going on underneath and decide the next step. You'll be taking sterile saline irrigation, 2 litres, continuous, until pH neutral. That's for chemical eye burn. The pharmacy will go through the details again when you pick it up. I am washing the eye now, keep it open and do not stop."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.88,
      "end_seconds": 411.85,
      "duration_seconds": 13.97,
      "text": "The eye emergency service would be the right next step, I'll refer you. If the symptoms get worse, or you feel really unwell, please come to the emergency department. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.82,
      "end_seconds": 415.06,
      "duration_seconds": 2.24,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.67,
      "end_seconds": 421.75,
      "duration_seconds": 5.08,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.56,
      "end_seconds": 426.65,
      "duration_seconds": 4.09,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}