  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 3.39,
      "duration_seconds": 2.47,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.36,
      "end_seconds": 5.41,
      "duration_seconds": 1.05,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 7.95,
      "duration_seconds": 1.87,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.94,
      "end_seconds": 13.44,
      "duration_seconds": 4.5,
      "text": "Well, you know, I've been having wheeze at work."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.82,
      "end_seconds": 17.72,
      "duration_seconds": 2.9,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.01,
      "end_seconds": 32.91,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.93,
      "end_seconds": 63.67,
      "duration_seconds": 13.74,
      "text": "Okay: heart rate 82, SpO2 99 percent on room air, height 159 centimetres, weight 97 kilos, pressure 109 over 70, respiratory rate 18, temperature 36.5, BMI works out to 38.4."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 66.8,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.57,
      "end_seconds": 70.45,
      "duration_seconds": 2.88,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.53,
      "end_seconds": 85.9,
      "duration_seconds": 3.37,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.69,
      "end_seconds": 91.48,
      "duration_seconds": 3.79,
      "text": "It's been about two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.07,
      "end_seconds": 95.05,
      "duration_seconds": 1.98,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.63,
      "end_seconds": 100.93,
      "duration_seconds": 4.3,
      "text": "I notice it more with spray paint and work."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.42,
      "end_seconds": 106.97,
      "duration_seconds": 2.55,
      "text": "Any coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.54,
      "end_seconds": 111.84,
      "duration_seconds": 4.3,
      "text": "No coughing up blood or fever, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 116.29,
      "duration_seconds": 2.49,
      "text": "Any weight loss or ankle swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.63,
      "end_seconds": 122.56,
      "duration_seconds": 4.93,
      "text": "No weight loss or ankle swelling, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.62,
      "end_seconds": 127.96,
      "duration_seconds": 4.34,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.14,
      "end_seconds": 133.97,
      "duration_seconds": 4.83,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.48,
      "end_seconds": 142.69,
      "duration_seconds": 3.21,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.73,
      "end_seconds": 147.36,
      "duration_seconds": 3.63,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.13,
      "end_seconds": 154.07,
      "duration_seconds": 1.94,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.89,
      "end_seconds": 159.53,
      "duration_seconds": 3.64,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.18,
      "end_seconds": 163.02,
      "duration_seconds": 2.84,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.56,
      "end_seconds": 165.08,
      "duration_seconds": 1.52,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.01,
      "end_seconds": 170.99,
      "duration_seconds": 3.98,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.79,
      "end_seconds": 174.86,
      "duration_seconds": 2.07,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.27,
      "end_seconds": 191.2,
      "duration_seconds": 2.93,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.41,
      "end_seconds": 194.23,
      "duration_seconds": 1.82,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.38,
      "end_seconds": 213.94,
      "duration_seconds": 4.56,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.58,
      "end_seconds": 218.92,
      "duration_seconds": 4.34,
      "text": "Erm, uh, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.24,
      "end_seconds": 225.37,
      "duration_seconds": 4.13,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.66,
      "end_seconds": 227.9,
      "duration_seconds": 1.24,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 243.45,
      "duration_seconds": 5.03,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.1,
      "end_seconds": 248.65,
      "duration_seconds": 2.55,
      "text": "Right, please sit back down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.01,
      "end_seconds": 261.52,
      "duration_seconds": 5.51,
      "text": "Let me tell you where I've got to. This looks most like occupational asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.74,
      "end_seconds": 264.65,
      "duration_seconds": 1.91,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.89,
      "end_seconds": 276.96,
      "duration_seconds": 11.07,
      "text": "It's reasonable to be concerned, but right now occupational asthma is my leading thought, not anything worse. I want spirometry done, that's for wheeze."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.5,
      "end_seconds": 281.56,
      "duration_seconds": 3.06,
      "text": "Okay, uh, I'll do it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.64,
      "end_seconds": 313.89,
      "duration_seconds": 31.25,
      "text": "What I'm giving you is beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma. It's a commonly used medicine and most people tolerate it well. Record peak flows at work and at home for four weeks. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. So, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.65,
      "end_seconds": 318.21,
      "duration_seconds": 3.56,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.9,
      "end_seconds": 320.85,
      "duration_seconds": 1.95,
      "text": "So, look after yourself."
    }
  ]
}