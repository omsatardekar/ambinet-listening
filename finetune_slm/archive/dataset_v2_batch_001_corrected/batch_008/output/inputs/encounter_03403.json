{
  "schema_version": "1.0",
  "encounter_id": "03403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 6.03,
      "duration_seconds": 5.21,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.94,
      "end_seconds": 11.47,
      "duration_seconds": 4.53,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.49,
      "end_seconds": 20.06,
      "duration_seconds": 7.57,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.01,
      "end_seconds": 25.77,
      "duration_seconds": 4.76,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.04,
      "end_seconds": 34.36,
      "duration_seconds": 7.32,
      "text": "So, So the thing is, I've got a high sugar test in pregnancy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.45,
      "end_seconds": 38.65,
      "duration_seconds": 3.2,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 43.45,
      "duration_seconds": 3.65,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 48.07,
      "duration_seconds": 2.85,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.02,
      "end_seconds": 50.96,
      "duration_seconds": 0.94,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.97,
      "end_seconds": 56.3,
      "duration_seconds": 2.33,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.01,
      "end_seconds": 72.9,
      "duration_seconds": 15.89,
      "text": "When it starts I tend to get no symptoms as well. The no symptoms? That's been for about a month. There was a big baby on the scan, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.05,
      "end_seconds": 76.07,
      "duration_seconds": 2.02,
      "text": "So, any blurred vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.86,
      "end_seconds": 79.76,
      "duration_seconds": 1.9,
      "text": "No. No blurred vision."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.43,
      "end_seconds": 88.03,
      "duration_seconds": 7.6,
      "text": "Let me check a few things. Any thirst, passing a lot of urine or reduced baby movements?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.97,
      "end_seconds": 92.7,
      "duration_seconds": 3.73,
      "text": "Okay, so no, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.16,
      "end_seconds": 96.81,
      "duration_seconds": 3.65,
      "text": "Yes, carry on. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.82,
      "end_seconds": 100.79,
      "duration_seconds": 1.97,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.72,
      "end_seconds": 103.97,
      "duration_seconds": 2.25,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.96,
      "end_seconds": 107.07,
      "duration_seconds": 2.11,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.93,
      "end_seconds": 111.12,
      "duration_seconds": 3.19,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.85,
      "end_seconds": 125.96,
      "duration_seconds": 13.11,
      "text": "I have low haemoglobin, for two years. I've been reading about it online and it worried me. I've had high cholesterol for nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 135.7,
      "duration_seconds": 8.06,
      "text": "Alright, low haemoglobin and high cholesterol, that matches what I have here. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 145.8,
      "duration_seconds": 9.06,
      "text": "I've never touched a cigarette. I look after my grandchildren most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.89,
      "end_seconds": 151.92,
      "duration_seconds": 5.03,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.61,
      "end_seconds": 157.74,
      "duration_seconds": 5.13,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.37,
      "end_seconds": 160.71,
      "duration_seconds": 2.34,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 161.5,
      "end_seconds": 170.89,
      "duration_seconds": 9.39,
      "text": "Let me think, she takes iron tablets, once a day. She takes atorvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.91,
      "end_seconds": 175.02,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 175.55,
      "end_seconds": 180.27,
      "duration_seconds": 4.72,
      "text": "20 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.81,
      "end_seconds": 182.09,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.46,
      "end_seconds": 184.68,
      "duration_seconds": 1.22,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.68,
      "end_seconds": 203.13,
      "duration_seconds": 2.45,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 215.7,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 248.45,
      "duration_seconds": 10.8,
      "text": "Okay: respiratory rate 14, blood pressure 113 over 69, heart rate 80, temperature 36.8, height 173 centimetres, weight 95 kilos."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.35,
      "end_seconds": 255.67,
      "duration_seconds": 4.32,
      "text": "Right, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.59,
      "end_seconds": 257.82,
      "duration_seconds": 1.23,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.78,
      "end_seconds": 273.43,
      "duration_seconds": 5.65,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.15,
      "end_seconds": 280.18,
      "duration_seconds": 3.03,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.61,
      "end_seconds": 301.4,
      "duration_seconds": 7.79,
      "text": "Okay, thinking it through, I think we're dealing with gestational diabetes controllable with diet at this stage."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.35,
      "end_seconds": 304.73,
      "duration_seconds": 2.38,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.24,
      "end_seconds": 331.95,
      "duration_seconds": 22.71,
      "text": "It's reasonable to be concerned, but right now gestational diabetes controllable with diet is my leading thought, not anything worse. Just to be sure I understood. You've had a high sugar test in pregnancy, yesterday, mild, and no thirst or passing a lot of urine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.53,
      "end_seconds": 333.23,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.0,
      "end_seconds": 365.16,
      "duration_seconds": 15.16,
      "text": "I'm sending you for a glucose meter and diary because of gestational diabetes. It's a routine test and it'll give us a much clearer picture. A growth scan is what I'd like next, for gestational diabetes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.61,
      "end_seconds": 368.3,
      "duration_seconds": 1.69,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.74,
      "end_seconds": 388.71,
      "duration_seconds": 18.97,
      "text": "Replace sugary drinks and white starches with wholegrains and walk after meals. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. We'll refer you to the diabetes midwife."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.01,
      "end_seconds": 390.71,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.45,
      "end_seconds": 395.04,
      "duration_seconds": 2.59,
      "text": "See me again in two weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.36,
      "end_seconds": 399.49,
      "duration_seconds": 3.13,
      "text": "Okay, so okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.78,
      "end_seconds": 405.5,
      "duration_seconds": 4.72,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.4,
      "end_seconds": 409.22,
      "duration_seconds": 2.82,
      "text": "Thank you, um, that's helpful."
    }
  ]
}