{
  "schema_version": "1.0",
  "encounter_id": "03074",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 4.49,
      "duration_seconds": 3.15,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.31,
      "end_seconds": 9.96,
      "duration_seconds": 3.65,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.92,
      "end_seconds": 17.23,
      "duration_seconds": 5.31,
      "text": "Mainly I've been feeling tired and weak. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.28,
      "end_seconds": 22.8,
      "duration_seconds": 3.52,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.77,
      "end_seconds": 27.57,
      "duration_seconds": 2.8,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.42,
      "end_seconds": 31.97,
      "duration_seconds": 2.55,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.8,
      "end_seconds": 33.69,
      "duration_seconds": 0.89,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.84,
      "end_seconds": 37.45,
      "duration_seconds": 2.61,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.33,
      "end_seconds": 50.19,
      "duration_seconds": 2.86,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.4,
      "end_seconds": 82.86,
      "duration_seconds": 11.46,
      "text": "Okay: BMI works out to 33.1, BP is 96 over 64. And weight 90 kilos, heart rate 110, height 165 centimetres, respiratory rate 19."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.71,
      "end_seconds": 86.07,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.83,
      "end_seconds": 90.68,
      "duration_seconds": 3.85,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.24,
      "end_seconds": 97.06,
      "duration_seconds": 3.82,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.07,
      "end_seconds": 99.82,
      "duration_seconds": 1.75,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.4,
      "end_seconds": 123.22,
      "duration_seconds": 10.82,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.78,
      "end_seconds": 134.17,
      "duration_seconds": 6.39,
      "text": "You can sit up now. Did you get fever, severe tummy pain or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.93,
      "end_seconds": 140.21,
      "duration_seconds": 5.28,
      "text": "No fever, severe tummy pain or fainting, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 145.45,
      "duration_seconds": 3.68,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.07,
      "end_seconds": 150.04,
      "duration_seconds": 2.97,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.94,
      "end_seconds": 154.9,
      "duration_seconds": 2.96,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.59,
      "end_seconds": 158.07,
      "duration_seconds": 1.48,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.09,
      "end_seconds": 162.35,
      "duration_seconds": 3.26,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.54,
      "end_seconds": 167.5,
      "duration_seconds": 3.96,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.72,
      "end_seconds": 171.5,
      "duration_seconds": 2.78,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.72,
      "end_seconds": 175.93,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.93,
      "end_seconds": 179.92,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.65,
      "end_seconds": 185.25,
      "duration_seconds": 4.6,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.16,
      "end_seconds": 205.27,
      "duration_seconds": 3.11,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.79,
      "end_seconds": 208.28,
      "duration_seconds": 1.49,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.45,
      "end_seconds": 228.8,
      "duration_seconds": 4.35,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.93,
      "end_seconds": 233.28,
      "duration_seconds": 3.35,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.69,
      "end_seconds": 239.91,
      "duration_seconds": 5.22,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.62,
      "end_seconds": 243.18,
      "duration_seconds": 1.56,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.75,
      "end_seconds": 267.38,
      "duration_seconds": 9.63,
      "text": "Right, any allergies to tablets, food or anything in the environment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.17,
      "end_seconds": 274.78,
      "duration_seconds": 5.61,
      "text": "Not currently, um, but as a youngster diclofenac gave me wheezing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.3,
      "end_seconds": 305.29,
      "duration_seconds": 11.99,
      "text": "So where does that leave us? This is probably possible adrenal insufficiency. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.03,
      "end_seconds": 308.88,
      "duration_seconds": 2.85,
      "text": "Hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.68,
      "end_seconds": 334.74,
      "duration_seconds": 20.06,
      "text": "Nothing I've seen today points to an emergency. It looks like possible adrenal insufficiency, but I'd like to confirm. Let's get a morning cortisol, for possible adrenal insufficiency. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.77,
      "end_seconds": 339.31,
      "duration_seconds": 2.54,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.88,
      "end_seconds": 356.19,
      "duration_seconds": 16.31,
      "text": "Drink fluids and eat salty foods until the results, and come in if you vomit. Let's hold off on a short synacthen test for now, and if there's no change next month we can revisit it. Come back after the results."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.57,
      "end_seconds": 358.27,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.25,
      "end_seconds": 363.81,
      "duration_seconds": 3.56,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.8,
      "end_seconds": 368.54,
      "duration_seconds": 3.74,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.71,
      "end_seconds": 372.9,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
