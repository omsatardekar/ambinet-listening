{
  "schema_version": "1.0",
  "encounter_id": "03023",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 6.54,
      "duration_seconds": 5.19,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 12.23,
      "duration_seconds": 4.9,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.81,
      "end_seconds": 17.1,
      "duration_seconds": 4.29,
      "text": "So the thing is, I've got three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.97,
      "end_seconds": 21.38,
      "duration_seconds": 3.41,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.21,
      "end_seconds": 25.03,
      "duration_seconds": 2.82,
      "text": "It usually comes with irregular cycles."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.39,
      "end_seconds": 29.18,
      "duration_seconds": 2.79,
      "text": "Have you been feeling low and anxious?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.72,
      "end_seconds": 32.37,
      "duration_seconds": 2.65,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.91,
      "end_seconds": 37.55,
      "duration_seconds": 4.64,
      "text": "A few quick ones: clotting problem, fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.16,
      "end_seconds": 42.0,
      "duration_seconds": 2.84,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.95,
      "end_seconds": 47.21,
      "duration_seconds": 4.26,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.21,
      "end_seconds": 51.64,
      "duration_seconds": 3.43,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.65,
      "end_seconds": 55.06,
      "duration_seconds": 2.41,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.07,
      "end_seconds": 68.31,
      "duration_seconds": 12.24,
      "text": "High blood pressure, for two years. I kept putting it off, which I know isn't sensible. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.53,
      "end_seconds": 70.72,
      "duration_seconds": 1.19,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.23,
      "end_seconds": 74.54,
      "duration_seconds": 2.31,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 77.03,
      "duration_seconds": 1.77,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.95,
      "end_seconds": 84.69,
      "duration_seconds": 5.74,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.32,
      "end_seconds": 89.12,
      "duration_seconds": 2.8,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.4,
      "end_seconds": 94.4,
      "duration_seconds": 4.0,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.0,
      "end_seconds": 97.26,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.0,
      "end_seconds": 101.09,
      "duration_seconds": 3.09,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.88,
      "end_seconds": 104.93,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 110.74,
      "duration_seconds": 4.48,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.61,
      "end_seconds": 124.18,
      "duration_seconds": 2.57,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.42,
      "end_seconds": 130.34,
      "duration_seconds": 4.92,
      "text": "I take telmisartan, once a day for my pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.74,
      "end_seconds": 137.81,
      "duration_seconds": 2.07,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.55,
      "end_seconds": 147.93,
      "duration_seconds": 8.38,
      "text": "It's 40 milligrams. I had lisinopril at one point, um, but I'm off it now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.4,
      "end_seconds": 156.71,
      "duration_seconds": 4.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.2,
      "end_seconds": 161.67,
      "duration_seconds": 3.47,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.31,
      "end_seconds": 166.14,
      "duration_seconds": 3.83,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.92,
      "end_seconds": 170.73,
      "duration_seconds": 2.81,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.22,
      "end_seconds": 186.4,
      "duration_seconds": 3.18,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.55,
      "end_seconds": 198.2,
      "duration_seconds": 2.65,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.37,
      "end_seconds": 225.48,
      "duration_seconds": 11.11,
      "text": "Okay: BP is 128 over 74, temp 36.9 degrees, pulse is 72 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.06,
      "end_seconds": 229.13,
      "duration_seconds": 2.07,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.9,
      "end_seconds": 234.47,
      "duration_seconds": 3.57,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.3,
      "end_seconds": 239.66,
      "duration_seconds": 3.36,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.34,
      "end_seconds": 249.29,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.69,
      "end_seconds": 253.18,
      "duration_seconds": 2.49,
      "text": "Alright, I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.79,
      "end_seconds": 273.55,
      "duration_seconds": 1.76,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.64,
      "end_seconds": 287.05,
      "duration_seconds": 11.41,
      "text": "Good, you can sit up again. Putting it all together, my working impression is recurrent miscarriage needing investigation. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.05,
      "end_seconds": 293.85,
      "duration_seconds": 2.8,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.31,
      "end_seconds": 321.81,
      "duration_seconds": 26.5,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent miscarriage needing investigation, but I'd like to confirm. I'd like to arrange blood tests for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start. If the symptoms get worse, that's the point to come in urgently. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.62,
      "end_seconds": 324.74,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}