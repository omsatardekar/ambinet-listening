{
  "schema_version": "1.0",
  "encounter_id": "03384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.81,
      "duration_seconds": 3.55,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.63,
      "end_seconds": 9.42,
      "duration_seconds": 3.79,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.02,
      "end_seconds": 16.54,
      "duration_seconds": 6.52,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.29,
      "end_seconds": 24.67,
      "duration_seconds": 4.38,
      "text": "Alright, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.8,
      "end_seconds": 32.87,
      "duration_seconds": 7.07,
      "text": "It's, It's severe burning, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.89,
      "end_seconds": 37.76,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.71,
      "end_seconds": 43.85,
      "duration_seconds": 4.14,
      "text": "Right, ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.51,
      "end_seconds": 48.59,
      "duration_seconds": 2.08,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.07,
      "end_seconds": 62.05,
      "duration_seconds": 11.98,
      "text": "I'd say on and off. Oh, and a splash of cleaning fluid in my eye. Had that since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.69,
      "end_seconds": 66.62,
      "duration_seconds": 2.93,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.34,
      "end_seconds": 75.97,
      "duration_seconds": 8.63,
      "text": "I'd call it mild. I mean, I've also had being unable to open it, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.75,
      "end_seconds": 80.1,
      "duration_seconds": 3.35,
      "text": "Any head injury or both eyes at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 86.9,
      "duration_seconds": 4.84,
      "text": "I haven't had head injury or both eyes, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 93.26,
      "duration_seconds": 4.87,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.83,
      "end_seconds": 96.48,
      "duration_seconds": 1.65,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.17,
      "end_seconds": 100.84,
      "duration_seconds": 3.67,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.56,
      "end_seconds": 107.89,
      "duration_seconds": 5.33,
      "text": "Uh, I've had migraines for about ten years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 117.53,
      "duration_seconds": 8.64,
      "text": "Alright, migraines, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.12,
      "end_seconds": 125.09,
      "duration_seconds": 6.97,
      "text": "Right, I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.37,
      "end_seconds": 136.4,
      "duration_seconds": 3.03,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.14,
      "end_seconds": 148.54,
      "duration_seconds": 10.4,
      "text": "So, I had an operation for a hernia last spring. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.46,
      "end_seconds": 155.32,
      "duration_seconds": 4.86,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.1,
      "end_seconds": 175.78,
      "duration_seconds": 15.68,
      "text": "I gave up cigarettes last spring. I only drink at family occasions. I swim twice a week. Lots of rice, lentils and some fruit. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.89,
      "end_seconds": 179.83,
      "duration_seconds": 2.94,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.89,
      "end_seconds": 186.06,
      "duration_seconds": 5.17,
      "text": "Propranolol. I take it 40 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 191.29,
      "duration_seconds": 4.33,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.81,
      "end_seconds": 197.24,
      "duration_seconds": 5.43,
      "text": "So, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.69,
      "end_seconds": 215.92,
      "duration_seconds": 4.23,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.45,
      "end_seconds": 227.32,
      "duration_seconds": 2.87,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 258.86,
      "duration_seconds": 10.1,
      "text": "Okay: BP is 121 over 68, temperature is 36.5 degrees, respiratory rate 17, pulse is 67 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.32,
      "end_seconds": 261.83,
      "duration_seconds": 1.51,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.98,
      "end_seconds": 265.04,
      "duration_seconds": 2.06,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.15,
      "end_seconds": 271.39,
      "duration_seconds": 4.24,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.53,
      "end_seconds": 277.66,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.86,
      "end_seconds": 281.42,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.61,
      "end_seconds": 302.14,
      "duration_seconds": 8.53,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.97,
      "end_seconds": 307.6,
      "duration_seconds": 1.63,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.42,
      "end_seconds": 323.5,
      "duration_seconds": 8.08,
      "text": "Right, here's what I'm thinking. I think we're dealing with an alkali chemical burn to the eye at this stage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.44,
      "end_seconds": 329.01,
      "duration_seconds": 3.57,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.42,
      "end_seconds": 363.03,
      "duration_seconds": 32.61,
      "text": "It's reasonable to be concerned, but right now an alkali chemical burn to the eye is my leading thought, not anything worse. I want an urgent pH check done, that's for chemical burn. I'm going to put you on sterile saline irrigation, 2 litres, continuous, until pH neutral. That's for chemical eye burn. I am washing the eye now, keep it open and do not stop. I'm going to send a referral to the eye emergency service."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.92,
      "end_seconds": 377.95,
      "duration_seconds": 9.03,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.77,
      "end_seconds": 384.09,
      "duration_seconds": 2.32,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.73,
      "end_seconds": 387.09,
      "duration_seconds": 2.36,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.59,
      "end_seconds": 391.35,
      "duration_seconds": 3.76,
      "text": "Thank you, you know, doctor, goodbye."
    }
  ]
}