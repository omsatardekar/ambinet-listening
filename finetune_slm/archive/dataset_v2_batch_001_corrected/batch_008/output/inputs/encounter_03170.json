{
  "schema_version": "1.0",
  "encounter_id": "03170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 7.78,
      "duration_seconds": 6.84,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.56,
      "end_seconds": 12.2,
      "duration_seconds": 3.64,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.12,
      "end_seconds": 18.93,
      "duration_seconds": 5.81,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.34,
      "end_seconds": 27.21,
      "duration_seconds": 6.87,
      "text": "Honestly, it's shaking chills, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.91,
      "end_seconds": 31.21,
      "duration_seconds": 3.3,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.29,
      "end_seconds": 36.19,
      "duration_seconds": 3.9,
      "text": "I'd say two weeks, uh, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.05,
      "end_seconds": 46.0,
      "duration_seconds": 3.95,
      "text": "It, It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.92,
      "end_seconds": 52.66,
      "duration_seconds": 4.74,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.74,
      "end_seconds": 55.01,
      "duration_seconds": 1.27,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.07,
      "end_seconds": 64.76,
      "duration_seconds": 7.69,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.36,
      "end_seconds": 89.26,
      "duration_seconds": 22.9,
      "text": "Right, maybe a four out of ten on a bad day. It just comes and goes. I've also been feeling very weak, since last night. Yeah, as for feeling very weak, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 93.1,
      "duration_seconds": 2.66,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.53,
      "end_seconds": 102.41,
      "duration_seconds": 7.88,
      "text": "Right, yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.7,
      "end_seconds": 107.63,
      "duration_seconds": 3.93,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.46,
      "end_seconds": 111.06,
      "duration_seconds": 1.6,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.27,
      "end_seconds": 131.99,
      "duration_seconds": 2.72,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.82,
      "end_seconds": 137.37,
      "duration_seconds": 3.55,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.7,
      "end_seconds": 152.58,
      "duration_seconds": 2.88,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.43,
      "end_seconds": 158.34,
      "duration_seconds": 3.91,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.3,
      "end_seconds": 166.17,
      "duration_seconds": 2.87,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.02,
      "end_seconds": 172.09,
      "duration_seconds": 5.07,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.82,
      "end_seconds": 174.56,
      "duration_seconds": 1.74,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.52,
      "end_seconds": 183.05,
      "duration_seconds": 3.53,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.21,
      "end_seconds": 189.19,
      "duration_seconds": 1.98,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.81,
      "end_seconds": 197.36,
      "duration_seconds": 6.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.73,
      "end_seconds": 202.08,
      "duration_seconds": 3.35,
      "text": "Have you noticed cough, diarrhoea or rash?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.81,
      "end_seconds": 208.61,
      "duration_seconds": 5.8,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.43,
      "end_seconds": 214.08,
      "duration_seconds": 3.65,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.7,
      "end_seconds": 221.32,
      "duration_seconds": 3.62,
      "text": "No, um, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.03,
      "end_seconds": 228.56,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.61,
      "end_seconds": 242.45,
      "duration_seconds": 2.84,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.05,
      "end_seconds": 266.96,
      "duration_seconds": 9.91,
      "text": "Okay: weight 94 kilos, temperature is 36.5 degrees, saturation 99 percent, heart rate 99, pressure 104 over 59, height 182 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.74,
      "end_seconds": 271.82,
      "duration_seconds": 3.08,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 276.56,
      "duration_seconds": 3.69,
      "text": "Alright, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.41,
      "end_seconds": 281.77,
      "duration_seconds": 2.36,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.6,
      "end_seconds": 284.95,
      "duration_seconds": 2.35,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.28,
      "end_seconds": 304.66,
      "duration_seconds": 8.38,
      "text": "You are hot, shaking and your blood pressure is low, and you had chemotherapy nine days ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.1,
      "end_seconds": 310.2,
      "duration_seconds": 2.1,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.13,
      "end_seconds": 341.26,
      "duration_seconds": 15.13,
      "text": "Having listened and examined, I'd lean towards neutropenic sepsis. I want to be honest that this is an impression, not a final answer. Let's book urgent blood tests to look into neutropenic sepsis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.16,
      "end_seconds": 344.74,
      "duration_seconds": 1.58,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.49,
      "end_seconds": 358.36,
      "duration_seconds": 11.87,
      "text": "For this, piperacillin and tazobactam, 4.5 grams, now, single dose. It's for neutropenic sepsis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.04,
      "end_seconds": 361.7,
      "duration_seconds": 1.66,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.42,
      "end_seconds": 382.36,
      "duration_seconds": 19.94,
      "text": "This is an emergency, antibiotics are being given within the hour. Don't skip meals, and try to eat smaller portions more often through the day. I think the oncology team should see you too. I'd like to see you again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.37,
      "end_seconds": 385.19,
      "duration_seconds": 1.82,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.26,
      "end_seconds": 387.52,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}