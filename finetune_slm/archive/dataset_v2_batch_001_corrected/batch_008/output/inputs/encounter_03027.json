{
  "schema_version": "1.0",
  "encounter_id": "03027",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 8.87,
      "duration_seconds": 7.54,
      "text": "Hi, you know, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.66,
      "end_seconds": 14.59,
      "duration_seconds": 3.93,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.15,
      "end_seconds": 23.31,
      "duration_seconds": 8.16,
      "text": "Um, uh, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.71,
      "end_seconds": 32.48,
      "duration_seconds": 3.77,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.09,
      "end_seconds": 38.01,
      "duration_seconds": 3.92,
      "text": "Actually, we came because of fever and shivers."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 42.45,
      "duration_seconds": 2.82,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.37,
      "end_seconds": 46.19,
      "duration_seconds": 2.82,
      "text": "about... well, about a month"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.17,
      "end_seconds": 50.29,
      "duration_seconds": 3.12,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.89,
      "end_seconds": 54.31,
      "duration_seconds": 3.42,
      "text": "Right, it usually comes with confusion."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.7,
      "end_seconds": 59.19,
      "duration_seconds": 3.49,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.75,
      "end_seconds": 64.79,
      "duration_seconds": 5.04,
      "text": "Well, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.74,
      "end_seconds": 69.87,
      "duration_seconds": 3.13,
      "text": "Have you noticed back pain or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.36,
      "end_seconds": 75.62,
      "duration_seconds": 4.26,
      "text": "Let me think, no, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.96,
      "end_seconds": 80.32,
      "duration_seconds": 3.36,
      "text": "So, did you get fall or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.06,
      "end_seconds": 89.78,
      "duration_seconds": 3.72,
      "text": "ah, no, nothing to to report there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.83,
      "end_seconds": 96.68,
      "duration_seconds": 4.85,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.91,
      "end_seconds": 102.22,
      "duration_seconds": 4.31,
      "text": "actually, you know, no, all normal there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.07,
      "end_seconds": 106.44,
      "duration_seconds": 3.37,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.33,
      "end_seconds": 112.9,
      "duration_seconds": 5.57,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.28,
      "end_seconds": 125.98,
      "duration_seconds": 3.7,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.85,
      "end_seconds": 132.02,
      "duration_seconds": 4.17,
      "text": "Yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.04,
      "end_seconds": 138.23,
      "duration_seconds": 5.19,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.15,
      "end_seconds": 148.82,
      "duration_seconds": 6.67,
      "text": "ah, you know, I've had an enlarged prostate for about a year now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.95,
      "end_seconds": 155.37,
      "duration_seconds": 1.42,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.27,
      "end_seconds": 158.97,
      "duration_seconds": 2.7,
      "text": "I've, I've got high cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 163.29,
      "duration_seconds": 2.48,
      "text": "Yes, carry on. Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.56,
      "end_seconds": 167.63,
      "duration_seconds": 3.07,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.49,
      "end_seconds": 170.13,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.84,
      "end_seconds": 175.56,
      "duration_seconds": 4.72,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.34,
      "end_seconds": 178.39,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.03,
      "end_seconds": 183.04,
      "duration_seconds": 4.01,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.73,
      "end_seconds": 193.49,
      "duration_seconds": 4.76,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 197.92,
      "duration_seconds": 2.65,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.82,
      "end_seconds": 218.1,
      "duration_seconds": 2.28,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.88,
      "end_seconds": 226.34,
      "duration_seconds": 7.46,
      "text": "Tamsulosin, 0.4 milligrams, at night. A urinary catheter i take it in place"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.46,
      "end_seconds": 230.49,
      "duration_seconds": 3.03,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.87,
      "end_seconds": 238.42,
      "duration_seconds": 6.55,
      "text": "For about a year. Before this I was on atorvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.79,
      "end_seconds": 242.84,
      "duration_seconds": 3.05,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.41,
      "end_seconds": 249.22,
      "duration_seconds": 1.81,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.05,
      "end_seconds": 269.78,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.43,
      "end_seconds": 282.9,
      "duration_seconds": 2.47,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.82,
      "end_seconds": 301.56,
      "duration_seconds": 8.74,
      "text": "Okay: pulse is 100 beats a minute, saturation 97 percent. And temp 38.1 degrees, blood pressure 126 over 78."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.35,
      "end_seconds": 308.05,
      "duration_seconds": 4.7,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.19,
      "end_seconds": 310.6,
      "duration_seconds": 1.41,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.36,
      "end_seconds": 330.9,
      "duration_seconds": 6.54,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.78,
      "end_seconds": 349.59,
      "duration_seconds": 15.81,
      "text": "Okay, that's enough for me. Taking everything into account, I'd lean towards a catheter-related urinary infection. Let me repeat that back to make sure. You've had fever and shivers for about a month, and no vomiting or fall."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.54,
      "end_seconds": 354.61,
      "duration_seconds": 3.07,
      "text": "yes, you know, that's right"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.34,
      "end_seconds": 375.46,
      "duration_seconds": 20.12,
      "text": "Blood tests is what I'd like next, for fever i think a urine culture makes sense here, for possible urinary infection change the catheter and drink plenty keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.13,
      "end_seconds": 379.15,
      "duration_seconds": 2.02,
      "text": "that's fine by me"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.96,
      "end_seconds": 387.33,
      "duration_seconds": 6.37,
      "text": "Book a review in two days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.92,
      "end_seconds": 390.69,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    }
  ]
}