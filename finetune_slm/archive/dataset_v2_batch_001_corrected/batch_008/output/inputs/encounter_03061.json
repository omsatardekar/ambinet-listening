{
  "schema_version": "1.0",
  "encounter_id": "03061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 5.55,
      "duration_seconds": 4.25,
      "text": "Okay, welcome. Make yourself comfortable. Alright, what's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.65,
      "end_seconds": 10.77,
      "duration_seconds": 4.12,
      "text": "Um, so... confusion. That's why I came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.25,
      "end_seconds": 14.99,
      "duration_seconds": 2.74,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.13,
      "end_seconds": 23.55,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.89,
      "end_seconds": 42.89,
      "duration_seconds": 7.0,
      "text": "okay: heart rate 89, BP is 121 over 74, saturation 95 percent, temperature is 38.1 degrees"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.69,
      "end_seconds": 45.27,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.79,
      "end_seconds": 50.41,
      "duration_seconds": 3.62,
      "text": "I'll interpret them after the examination. Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.6,
      "end_seconds": 55.15,
      "duration_seconds": 3.55,
      "text": "Since this morning, that's when it began"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.72,
      "end_seconds": 59.09,
      "duration_seconds": 3.37,
      "text": "Ah. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.0,
      "end_seconds": 62.46,
      "duration_seconds": 1.46,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.86,
      "end_seconds": 76.71,
      "duration_seconds": 3.85,
      "text": "Any fall, cough or back pain at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.75,
      "end_seconds": 82.33,
      "duration_seconds": 4.58,
      "text": "I haven't had fall, cough or back pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.0,
      "end_seconds": 89.76,
      "duration_seconds": 2.76,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.94,
      "end_seconds": 96.4,
      "duration_seconds": 1.46,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.4,
      "end_seconds": 99.29,
      "duration_seconds": 0.89,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.34,
      "end_seconds": 104.12,
      "duration_seconds": 3.78,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.32,
      "end_seconds": 107.27,
      "duration_seconds": 1.95,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.32,
      "end_seconds": 115.18,
      "duration_seconds": 5.86,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.91,
      "end_seconds": 120.03,
      "duration_seconds": 3.12,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.57,
      "end_seconds": 126.01,
      "duration_seconds": 4.44,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.94,
      "end_seconds": 130.21,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.0,
      "end_seconds": 134.66,
      "duration_seconds": 3.66,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.52,
      "end_seconds": 137.89,
      "duration_seconds": 2.37,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.47,
      "end_seconds": 143.46,
      "duration_seconds": 3.99,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.43,
      "end_seconds": 149.42,
      "duration_seconds": 3.99,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.38,
      "end_seconds": 153.06,
      "duration_seconds": 1.68,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.01,
      "end_seconds": 167.84,
      "duration_seconds": 2.83,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.72,
      "end_seconds": 171.83,
      "duration_seconds": 3.11,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.76,
      "end_seconds": 177.79,
      "duration_seconds": 4.03,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.32,
      "end_seconds": 182.61,
      "duration_seconds": 3.29,
      "text": "Yes, erythromycin. I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.8,
      "end_seconds": 188.72,
      "duration_seconds": 3.92,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.56,
      "end_seconds": 193.2,
      "duration_seconds": 2.64,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 211.97,
      "duration_seconds": 6.35,
      "text": "the catheter bag has cloudy urine and there is tenderness above the pubic bone"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.43,
      "end_seconds": 216.12,
      "duration_seconds": 1.69,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.53,
      "end_seconds": 232.93,
      "duration_seconds": 7.4,
      "text": "So, based on the history and the examination, this is probably a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.88,
      "end_seconds": 237.18,
      "duration_seconds": 2.3,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 249.58,
      "duration_seconds": 11.32,
      "text": "I understand the worry. At the moment I'd say it's a catheter-related urinary infection, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.96,
      "end_seconds": 276.27,
      "duration_seconds": 14.31,
      "text": "Let's book blood tests to look into fever. It's a routine test and it'll give us a much clearer picture. I'm sending you for a urine culture because of possible urinary infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.85,
      "end_seconds": 278.5,
      "duration_seconds": 1.65,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.4,
      "end_seconds": 298.19,
      "duration_seconds": 17.79,
      "text": "For this, co-amoxiclav, 625 milligrams, three times a day, seven days. That's for catheter urinary infection. Change the catheter and drink plenty. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.78,
      "end_seconds": 300.81,
      "duration_seconds": 2.03,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.69,
      "end_seconds": 305.09,
      "duration_seconds": 2.4,
      "text": "Let's review you in two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.08,
      "end_seconds": 311.27,
      "duration_seconds": 5.19,
      "text": "Let me think, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.99,
      "end_seconds": 315.62,
      "duration_seconds": 3.63,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.78,
      "end_seconds": 321.34,
      "duration_seconds": 4.56,
      "text": "Uh, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.68,
      "end_seconds": 323.88,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}