{
  "schema_version": "1.0",
  "encounter_id": "03350",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 6.98,
      "duration_seconds": 5.73,
      "text": "Actually, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 13.19,
      "duration_seconds": 4.75,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.12,
      "end_seconds": 19.63,
      "duration_seconds": 4.51,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.11,
      "end_seconds": 24.92,
      "duration_seconds": 3.81,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 32.04,
      "duration_seconds": 6.48,
      "text": "So the thing is, I've got bloating when I slip up."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 40.12,
      "duration_seconds": 6.3,
      "text": "When was the first time you noticed it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 47.12,
      "duration_seconds": 6.32,
      "text": "About... well, ten days. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.65,
      "end_seconds": 58.2,
      "duration_seconds": 10.55,
      "text": "Right, right. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.82,
      "end_seconds": 66.53,
      "duration_seconds": 6.71,
      "text": "Mostly moderate. I notice it more with gluten. Oh, and tiredness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.92,
      "end_seconds": 74.92,
      "duration_seconds": 3.0,
      "text": "Any weight loss or vomiting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.59,
      "end_seconds": 80.57,
      "duration_seconds": 4.98,
      "text": "No weight loss or vomiting, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.51,
      "end_seconds": 85.79,
      "duration_seconds": 3.28,
      "text": "A few quick ones: diarrhoea or bone pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.67,
      "end_seconds": 90.77,
      "duration_seconds": 4.1,
      "text": "I haven't had diarrhoea or bone pain, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.55,
      "end_seconds": 95.49,
      "duration_seconds": 2.94,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.83,
      "end_seconds": 98.04,
      "duration_seconds": 1.21,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.72,
      "end_seconds": 104.11,
      "duration_seconds": 4.39,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.49,
      "end_seconds": 115.29,
      "duration_seconds": 9.8,
      "text": "Okay, um, so not currently, but as a youngster amoxicillin gave me a rash all over."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.46,
      "end_seconds": 123.83,
      "duration_seconds": 7.37,
      "text": "Any health conditions I should have on record? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.2,
      "end_seconds": 127.31,
      "duration_seconds": 2.11,
      "text": "I, I have diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.95,
      "end_seconds": 129.97,
      "duration_seconds": 1.02,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.9,
      "end_seconds": 138.81,
      "duration_seconds": 7.91,
      "text": "I've got heart disease. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.17,
      "end_seconds": 148.39,
      "duration_seconds": 4.22,
      "text": "Understood. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 149.09,
      "end_seconds": 165.57,
      "duration_seconds": 16.48,
      "text": "It's Glycomet, 500 milligrams, twice a day for my sugar, doctor. He is on metoprolol, 50 milligrams, twice a day for my heart, I give it to him."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 169.48,
      "duration_seconds": 2.85,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.32,
      "end_seconds": 177.5,
      "duration_seconds": 7.18,
      "text": "Well, yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.02,
      "end_seconds": 191.63,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.2,
      "end_seconds": 194.73,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.95,
      "end_seconds": 197.82,
      "duration_seconds": 1.87,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.91,
      "end_seconds": 204.92,
      "duration_seconds": 5.01,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.58,
      "end_seconds": 211.4,
      "duration_seconds": 4.82,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.42,
      "end_seconds": 216.58,
      "duration_seconds": 4.16,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.86,
      "end_seconds": 221.66,
      "duration_seconds": 3.8,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.88,
      "end_seconds": 238.85,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.09,
      "end_seconds": 243.24,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.67,
      "end_seconds": 264.37,
      "duration_seconds": 5.7,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.44,
      "end_seconds": 284.6,
      "duration_seconds": 16.16,
      "text": "That's all I needed to check. Right, here's what I'm thinking. It points towards coeliac disease on a gluten-free diet with some accidental exposure. It could also be iron deficiency, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.97,
      "end_seconds": 290.42,
      "duration_seconds": 2.45,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.08,
      "end_seconds": 303.02,
      "duration_seconds": 10.94,
      "text": "I understand the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.0,
      "end_seconds": 318.31,
      "duration_seconds": 6.31,
      "text": "For now, no new medicines or tests are needed. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.29,
      "end_seconds": 322.44,
      "duration_seconds": 2.15,
      "text": "Thank you, that's helpful."
    }
  ]
}