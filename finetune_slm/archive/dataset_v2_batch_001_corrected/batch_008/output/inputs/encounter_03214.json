{
  "schema_version": "1.0",
  "encounter_id": "03214",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 3.69,
      "duration_seconds": 2.68,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.57,
      "end_seconds": 10.96,
      "duration_seconds": 6.39,
      "text": "I mean, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.93,
      "end_seconds": 15.17,
      "duration_seconds": 2.24,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.61,
      "end_seconds": 22.95,
      "duration_seconds": 6.34,
      "text": "Mainly confusion. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.54,
      "end_seconds": 29.76,
      "duration_seconds": 3.22,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.43,
      "end_seconds": 33.41,
      "duration_seconds": 2.98,
      "text": "It's been like this since Friday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.93,
      "end_seconds": 37.65,
      "duration_seconds": 3.72,
      "text": "Yes. Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 48.08,
      "duration_seconds": 9.28,
      "text": "Fever and shivers goes along with it, most of the time. As for fever and shivers, I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.01,
      "end_seconds": 52.51,
      "duration_seconds": 2.5,
      "text": "Okay, did you notice any vomiting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.73,
      "end_seconds": 55.21,
      "duration_seconds": 1.48,
      "text": "Nope, no vomiting."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.79,
      "end_seconds": 59.55,
      "duration_seconds": 3.76,
      "text": "Okay, go on. Have you noticed fall or cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.52,
      "end_seconds": 63.84,
      "duration_seconds": 3.32,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.79,
      "end_seconds": 66.84,
      "duration_seconds": 2.05,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.27,
      "end_seconds": 72.48,
      "duration_seconds": 2.21,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.83,
      "end_seconds": 92.64,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 99.64,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.18,
      "end_seconds": 102.19,
      "duration_seconds": 2.01,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.92,
      "end_seconds": 105.71,
      "duration_seconds": 2.79,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.48,
      "end_seconds": 110.45,
      "duration_seconds": 3.97,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.56,
      "end_seconds": 119.51,
      "duration_seconds": 7.95,
      "text": "Yes, erythromycin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.76,
      "end_seconds": 125.59,
      "duration_seconds": 4.83,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 129.55,
      "duration_seconds": 2.16,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.39,
      "end_seconds": 134.2,
      "duration_seconds": 2.81,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.38,
      "end_seconds": 137.03,
      "duration_seconds": 1.65,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.2,
      "end_seconds": 150.41,
      "duration_seconds": 3.21,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.71,
      "end_seconds": 157.72,
      "duration_seconds": 6.01,
      "text": "Just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.76,
      "end_seconds": 162.66,
      "duration_seconds": 3.9,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.36,
      "end_seconds": 166.09,
      "duration_seconds": 1.73,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.96,
      "end_seconds": 169.94,
      "duration_seconds": 2.98,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.77,
      "end_seconds": 186.32,
      "duration_seconds": 5.55,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.71,
      "end_seconds": 194.23,
      "duration_seconds": 2.52,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.43,
      "end_seconds": 214.98,
      "duration_seconds": 6.55,
      "text": "Okay, thinking it through, the most likely explanation is a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.23,
      "end_seconds": 219.42,
      "duration_seconds": 3.19,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 229.68,
      "duration_seconds": 8.59,
      "text": "It's reasonable to be concerned, but right now a catheter-related urinary infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.79,
      "end_seconds": 250.2,
      "duration_seconds": 4.41,
      "text": "Blood tests is what I'd like next, for fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.88,
      "end_seconds": 257.45,
      "duration_seconds": 2.57,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.05,
      "end_seconds": 286.76,
      "duration_seconds": 28.71,
      "text": "Let's book a urine culture to look into possible urinary infection. I'm prescribing co-amoxiclav, 625 milligrams, three times a day, seven days. That's for catheter urinary infection. Change the catheter and drink plenty. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.84,
      "end_seconds": 290.52,
      "duration_seconds": 1.68,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.1,
      "end_seconds": 299.07,
      "duration_seconds": 7.97,
      "text": "I'd like you back in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.52,
      "end_seconds": 305.42,
      "duration_seconds": 4.9,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.04,
      "end_seconds": 308.3,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}