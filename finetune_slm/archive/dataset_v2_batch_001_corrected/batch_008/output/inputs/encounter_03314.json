{
  "schema_version": "1.0",
  "encounter_id": "03314",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 5.03,
      "duration_seconds": 4.43,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 10.94,
      "duration_seconds": 4.1,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.52,
      "end_seconds": 19.13,
      "duration_seconds": 7.61,
      "text": "Right, um, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 24.36,
      "duration_seconds": 4.06,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.11,
      "end_seconds": 37.41,
      "duration_seconds": 11.3,
      "text": "Actually, it's a splash of cleaning fluid in my eye, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.71,
      "end_seconds": 45.89,
      "duration_seconds": 3.18,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.62,
      "end_seconds": 52.49,
      "duration_seconds": 5.87,
      "text": "Actually, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.41,
      "end_seconds": 60.03,
      "duration_seconds": 6.62,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 60.13,
      "end_seconds": 67.18,
      "duration_seconds": 7.05,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.36,
      "end_seconds": 73.68,
      "duration_seconds": 5.32,
      "text": "So, later, thanks. Please go on. Okay, have you had blurred vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.44,
      "end_seconds": 76.61,
      "duration_seconds": 1.17,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.73,
      "end_seconds": 80.15,
      "duration_seconds": 2.42,
      "text": "Any both eyes or head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.06,
      "end_seconds": 95.0,
      "duration_seconds": 12.94,
      "text": "No, you know, no both eyes, no head injury. I did have severe burning at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.88,
      "end_seconds": 101.2,
      "duration_seconds": 4.32,
      "text": "Right, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.21,
      "end_seconds": 105.68,
      "duration_seconds": 2.47,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.98,
      "end_seconds": 108.65,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.58,
      "end_seconds": 111.63,
      "duration_seconds": 1.05,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.24,
      "end_seconds": 116.18,
      "duration_seconds": 3.94,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.22,
      "end_seconds": 121.49,
      "duration_seconds": 3.27,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.77,
      "end_seconds": 130.25,
      "duration_seconds": 7.48,
      "text": "Hold on, doctor, I think he reacted to diclofenac once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.02,
      "end_seconds": 133.63,
      "duration_seconds": 2.61,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.82,
      "end_seconds": 137.73,
      "duration_seconds": 2.91,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.68,
      "end_seconds": 151.03,
      "duration_seconds": 2.35,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.24,
      "end_seconds": 171.38,
      "duration_seconds": 17.14,
      "text": "COPD, for five years. A neighbour of mine said I should see someone about it. Heart failure, for two years. I have an irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.51,
      "end_seconds": 177.76,
      "duration_seconds": 1.25,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.34,
      "end_seconds": 181.89,
      "duration_seconds": 3.55,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.92,
      "end_seconds": 186.7,
      "duration_seconds": 2.78,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.89,
      "end_seconds": 191.1,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.63,
      "end_seconds": 196.09,
      "duration_seconds": 4.46,
      "text": "Right, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.11,
      "end_seconds": 201.36,
      "duration_seconds": 3.25,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 204.74,
      "duration_seconds": 2.42,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.97,
      "end_seconds": 217.21,
      "duration_seconds": 11.24,
      "text": "Tiotropium inhaler. I take it once a day for my chest. Yeah, I take spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 221.16,
      "end_seconds": 226.64,
      "duration_seconds": 5.48,
      "text": "Doctor, our chart from the last visit lists it as 50 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.69,
      "end_seconds": 232.05,
      "duration_seconds": 3.36,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.78,
      "end_seconds": 247.98,
      "duration_seconds": 14.2,
      "text": "Um, not with me. I'll bring it next time. I'm on something called apix... apixaban, 5 milligrams, maybe, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.46,
      "end_seconds": 254.11,
      "duration_seconds": 4.65,
      "text": "Okay, have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.31,
      "end_seconds": 259.46,
      "duration_seconds": 4.15,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.76,
      "end_seconds": 265.67,
      "duration_seconds": 2.91,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.63,
      "end_seconds": 271.57,
      "duration_seconds": 4.94,
      "text": "Mm, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 273.43,
      "end_seconds": 283.2,
      "duration_seconds": 9.77,
      "text": "Doctor, I've got the readings for you. Blood pressure 117 over 74, heart rate 73, saturation 98 percent, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.93,
      "end_seconds": 285.93,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.47,
      "end_seconds": 292.47,
      "duration_seconds": 4.0,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.26,
      "end_seconds": 304.81,
      "duration_seconds": 1.55,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.25,
      "end_seconds": 308.44,
      "duration_seconds": 2.19,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.03,
      "end_seconds": 328.4,
      "duration_seconds": 8.37,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.07,
      "end_seconds": 364.14,
      "duration_seconds": 31.07,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, my working impression is an alkali chemical burn to the eye. Another possibility is a corneal abrasion. I want an urgent eye assessment done, that's for chemical eye injury. I want an urgent pH check done, that's for chemical burn. What I'm giving you is sterile saline irrigation, 2 litres, continuous, until pH neutral. That's for chemical eye burn."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.74,
      "end_seconds": 379.24,
      "duration_seconds": 13.5,
      "text": "I am washing the eye now, keep it open and do not stop. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.59,
      "end_seconds": 383.81,
      "duration_seconds": 3.22,
      "text": "Yes, you know, will do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.22,
      "end_seconds": 391.2,
      "duration_seconds": 5.98,
      "text": "Let's review you straight away. So, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 392.97,
      "end_seconds": 394.67,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.14,
      "end_seconds": 397.56,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}