  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 7.67,
      "duration_seconds": 6.8,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.78,
      "end_seconds": 12.39,
      "duration_seconds": 3.61,
      "text": "thank you right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.55,
      "end_seconds": 20.19,
      "duration_seconds": 6.64,
      "text": "sorry, what was I saying, thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.7,
      "end_seconds": 24.98,
      "duration_seconds": 3.28,
      "text": "good, that'll be useful pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.56,
      "end_seconds": 35.47,
      "duration_seconds": 6.91,
      "text": "I wanted to get pain in my groin and hip looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.81,
      "end_seconds": 38.86,
      "duration_seconds": 2.05,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.6,
      "end_seconds": 42.41,
      "duration_seconds": 2.81,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.21,
      "end_seconds": 48.29,
      "duration_seconds": 5.08,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.79,
      "end_seconds": 52.23,
      "duration_seconds": 2.44,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.79,
      "end_seconds": 55.37,
      "duration_seconds": 2.58,
      "text": "Right, what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.14,
      "end_seconds": 58.39,
      "duration_seconds": 2.25,
      "text": "It's worse with walking."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.05,
      "end_seconds": 61.95,
      "duration_seconds": 2.9,
      "text": "is there something that settles it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.88,
      "end_seconds": 67.92,
      "duration_seconds": 4.04,
      "text": "only rest, uh, and it's not much"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.95,
      "end_seconds": 72.44,
      "duration_seconds": 3.49,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.17,
      "end_seconds": 74.27,
      "duration_seconds": 1.1,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.86,
      "end_seconds": 80.47,
      "duration_seconds": 5.61,
      "text": "I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 80.57,
      "end_seconds": 87.88,
      "duration_seconds": 7.31,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.16,
      "end_seconds": 91.3,
      "duration_seconds": 2.14,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.06,
      "end_seconds": 104.88,
      "duration_seconds": 12.82,
      "text": "Well, uh, as for limp, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 109.1,
      "duration_seconds": 3.29,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.28,
      "end_seconds": 118.7,
      "duration_seconds": 6.42,
      "text": "Hmm, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.38,
      "end_seconds": 121.67,
      "duration_seconds": 2.29,
      "text": "Any night pain as well?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.82,
      "end_seconds": 124.54,
      "duration_seconds": 1.72,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.87,
      "end_seconds": 128.62,
      "duration_seconds": 2.75,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.36,
      "end_seconds": 136.56,
      "duration_seconds": 6.2,
      "text": "it's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.03,
      "end_seconds": 145.13,
      "duration_seconds": 7.1,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.43,
      "end_seconds": 151.41,
      "duration_seconds": 4.98,
      "text": "it, It happens a few times a day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.49,
      "end_seconds": 156.14,
      "duration_seconds": 2.65,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.59,
      "end_seconds": 168.35,
      "duration_seconds": 7.76,
      "text": "so, you know, yes, I had a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.86,
      "end_seconds": 172.84,
      "duration_seconds": 2.98,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.35,
      "end_seconds": 177.07,
      "duration_seconds": 3.72,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.43,
      "end_seconds": 182.14,
      "duration_seconds": 3.71,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.99,
      "end_seconds": 188.6,
      "duration_seconds": 4.61,
      "text": "I've, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 192.16,
      "duration_seconds": 1.91,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.99,
      "end_seconds": 194.56,
      "duration_seconds": 1.57,
      "text": "I have depression"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.35,
      "end_seconds": 197.63,
      "duration_seconds": 1.28,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.41,
      "end_seconds": 214.26,
      "duration_seconds": 14.85,
      "text": "Sorry, um, what was I saying, I have an enlarged prostate, for nearly five years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.47,
      "end_seconds": 217.91,
      "duration_seconds": 2.44,
      "text": "Alright, is there anything more?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.95,
      "end_seconds": 223.02,
      "duration_seconds": 3.07,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.73,
      "end_seconds": 227.38,
      "duration_seconds": 3.65,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.74,
      "end_seconds": 248.12,
      "duration_seconds": 3.38,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.08,
      "end_seconds": 260.02,
      "duration_seconds": 6.94,
      "text": "um, my uncle has high cholesterol okay, so my sister had breast cancer"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.63,
      "end_seconds": 264.09,
      "duration_seconds": 3.46,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.35,
      "end_seconds": 271.74,
      "duration_seconds": 6.39,
      "text": "Sorry, what was I saying, I'm on diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 274.81,
      "end_seconds": 282.96,
      "duration_seconds": 8.15,
      "text": "He is supposed to take it when needed, but I can't say he always does."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.67,
      "end_seconds": 293.05,
      "duration_seconds": 8.38,
      "text": "it's a... um, um, I can't remember what it's called. It's a small white one"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.79,
      "end_seconds": 297.44,
      "duration_seconds": 2.65,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.32,
      "end_seconds": 317.66,
      "duration_seconds": 19.34,
      "text": "So, for my mood, I believe. My wife sets them out for me, I just take what I'm given. It's paracetamol, 1 gram, four times a day. Erm, I used to to take tamsulosin, but I stopped it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.16,
      "end_seconds": 329.05,
      "duration_seconds": 0.89,
      "text": "any fever?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.59,
      "end_seconds": 336.11,
      "duration_seconds": 5.52,
      "text": "So, um, not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 337.77,
      "end_seconds": 343.06,
      "duration_seconds": 5.29,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.35,
      "end_seconds": 358.38,
      "duration_seconds": 12.03,
      "text": "sorry, you know, what was I saying, no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.24,
      "end_seconds": 371.74,
      "duration_seconds": 11.5,
      "text": "alright, I'll note both what you've said and what you've noticed let me check a few things any numbness, fall or weight loss?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.21,
      "end_seconds": 387.05,
      "duration_seconds": 13.84,
      "text": "No, no numbness, no fall, no weight loss. I did have stiffness putting on socks at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.69,
      "end_seconds": 393.76,
      "duration_seconds": 5.07,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 399.3,
      "end_seconds": 403.02,
      "duration_seconds": 3.72,
      "text": "No, you know, that's all normal."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.53,
      "end_seconds": 406.88,
      "duration_seconds": 2.35,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.61,
      "end_seconds": 409.3,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 410.33,
      "end_seconds": 417.49,
      "duration_seconds": 7.16,
      "text": "Here are the numbers, doctor. Temperature 36.7, heart rate 80, BP is 117 over 73."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.81,
      "end_seconds": 419.76,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.28,
      "end_seconds": 426.03,
      "duration_seconds": 3.75,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.9,
      "end_seconds": 429.1,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.81,
      "end_seconds": 453.88,
      "duration_seconds": 7.07,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.92,
      "end_seconds": 470.87,
      "duration_seconds": 14.95,
      "text": "all finished, thank you. From what you've told me and what I found, I'm honestly not certain yet. It could be hip osteoarthritis, or it might be a back problem"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 475.27,
      "end_seconds": 478.96,
      "duration_seconds": 3.69,
      "text": "Right, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 480.09,
      "end_seconds": 492.82,
      "duration_seconds": 12.73,
      "text": "Nothing I've seen today points to an emergency. It looks like hip osteoarthritis, but I'd like to confirm. We should do an X-ray of the hips for hip pain."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 493.38,
      "end_seconds": 496.37,
      "duration_seconds": 2.99,
      "text": "Right, that's fine with me."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.11,
      "end_seconds": 499.45,
      "duration_seconds": 2.34,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 501.44,
      "end_seconds": 503.99,
      "duration_seconds": 2.55,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 505.61,
      "end_seconds": 506.9,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
