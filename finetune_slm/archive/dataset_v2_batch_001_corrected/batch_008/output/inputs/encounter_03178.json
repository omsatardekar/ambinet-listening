{
  "schema_version": "1.0",
  "encounter_id": "03178",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.69,
      "duration_seconds": 4.04,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 10.19,
      "duration_seconds": 4.03,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 16.26,
      "duration_seconds": 5.25,
      "text": "Um, so... wheeze at work. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.91,
      "end_seconds": 26.36,
      "duration_seconds": 4.45,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.92,
      "end_seconds": 29.8,
      "duration_seconds": 2.88,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.57,
      "end_seconds": 35.58,
      "duration_seconds": 5.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.59,
      "end_seconds": 43.63,
      "duration_seconds": 6.04,
      "text": "Um, I notice it more with spray paint. Honestly, every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.47,
      "end_seconds": 47.68,
      "duration_seconds": 3.21,
      "text": "Any a tight chest at work as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.74,
      "end_seconds": 51.91,
      "duration_seconds": 1.17,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.32,
      "end_seconds": 57.2,
      "duration_seconds": 3.88,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.39,
      "end_seconds": 70.07,
      "duration_seconds": 2.68,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 92.77,
      "duration_seconds": 10.72,
      "text": "Okay: heart rate 80, blood pressure 113 over 72, respiratory rate 16. And oxygen saturation is 97 percent, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.06,
      "end_seconds": 96.29,
      "duration_seconds": 2.23,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 101.02,
      "duration_seconds": 2.92,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.95,
      "end_seconds": 117.29,
      "duration_seconds": 1.34,
      "text": "Any ankle swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.87,
      "end_seconds": 121.72,
      "duration_seconds": 3.85,
      "text": "No, uh, none, no ankle swelling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.73,
      "end_seconds": 126.3,
      "duration_seconds": 2.57,
      "text": "Any fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.61,
      "end_seconds": 131.43,
      "duration_seconds": 3.82,
      "text": "No, no fever or coughing up blood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.54,
      "end_seconds": 135.88,
      "duration_seconds": 3.34,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.54,
      "end_seconds": 138.95,
      "duration_seconds": 1.41,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.02,
      "end_seconds": 142.96,
      "duration_seconds": 2.94,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.66,
      "end_seconds": 146.87,
      "duration_seconds": 2.21,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.5,
      "end_seconds": 151.63,
      "duration_seconds": 2.13,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.69,
      "end_seconds": 159.81,
      "duration_seconds": 7.12,
      "text": "Sorry, what was I saying, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.55,
      "end_seconds": 176.2,
      "duration_seconds": 2.65,
      "text": "Alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 182.13,
      "duration_seconds": 4.23,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 185.4,
      "duration_seconds": 1.86,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.31,
      "end_seconds": 190.51,
      "duration_seconds": 4.2,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.53,
      "end_seconds": 209.55,
      "duration_seconds": 4.02,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.32,
      "end_seconds": 212.35,
      "duration_seconds": 2.03,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.31,
      "end_seconds": 233.77,
      "duration_seconds": 2.46,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.75,
      "end_seconds": 240.42,
      "duration_seconds": 4.67,
      "text": "It's a reliever inhaler, 100 micrograms, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 245.4,
      "duration_seconds": 4.48,
      "text": "Understood. Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.74,
      "end_seconds": 251.78,
      "duration_seconds": 3.04,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.81,
      "end_seconds": 257.21,
      "duration_seconds": 3.4,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.18,
      "end_seconds": 265.67,
      "duration_seconds": 2.49,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.14,
      "end_seconds": 271.72,
      "duration_seconds": 4.58,
      "text": "So, based on your history, my working impression is occupational asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.41,
      "end_seconds": 275.11,
      "duration_seconds": 2.7,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.01,
      "end_seconds": 293.81,
      "duration_seconds": 16.8,
      "text": "It's reasonable to be concerned, but right now occupational asthma is my leading thought, not anything worse. Just to be sure I understood. You've had wheeze at work for about a week, and no coughing up blood or ankle swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.33,
      "end_seconds": 296.81,
      "duration_seconds": 1.48,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.02,
      "end_seconds": 335.9,
      "duration_seconds": 34.88,
      "text": "I'm sending you for spirometry because of wheeze. Let's get serial peak flow readings, for work-related wheeze. What I'm giving you is beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma. Record peak flows at work and at home for four weeks. I'd like you to see occupational health as well, and I'll write the referral. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.06,
      "end_seconds": 340.13,
      "duration_seconds": 3.07,
      "text": "Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.96,
      "end_seconds": 342.94,
      "duration_seconds": 1.98,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.83,
      "end_seconds": 346.49,
      "duration_seconds": 2.66,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.89,
      "end_seconds": 351.16,
      "duration_seconds": 3.27,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.09,
      "end_seconds": 354.45,
      "duration_seconds": 1.36,
      "text": "Take care now."
    }
  ]
}