  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 7.56,
      "duration_seconds": 6.43,
      "text": "Okay, hello, come in. Mind the step. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.12,
      "end_seconds": 11.24,
      "duration_seconds": 2.12,
      "text": "I've been feeling faint."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.34,
      "end_seconds": 15.78,
      "duration_seconds": 3.44,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.73,
      "end_seconds": 23.1,
      "duration_seconds": 6.37,
      "text": "Five days, I think... sorry, about four days, I got that wrong."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.15,
      "end_seconds": 26.9,
      "duration_seconds": 2.75,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.27,
      "end_seconds": 48.61,
      "duration_seconds": 20.34,
      "text": "Honestly, once or twice a day. Um, I've had shortness of breath too, for about two weeks. Yeah, and there's chest pain as well, one week now. With chest pain, about a eight out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.39,
      "end_seconds": 66.63,
      "duration_seconds": 7.24,
      "text": "Are there any allergies I should be aware of? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.52,
      "end_seconds": 69.15,
      "duration_seconds": 1.63,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.65,
      "end_seconds": 75.93,
      "duration_seconds": 4.28,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.07,
      "end_seconds": 80.51,
      "duration_seconds": 3.44,
      "text": "Well, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.52,
      "end_seconds": 83.96,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.02,
      "end_seconds": 90.38,
      "duration_seconds": 4.36,
      "text": "So, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.17,
      "end_seconds": 105.82,
      "duration_seconds": 3.65,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.31,
      "end_seconds": 111.01,
      "duration_seconds": 3.7,
      "text": "I take pantoprazole, 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.97,
      "end_seconds": 116.0,
      "duration_seconds": 4.03,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.43,
      "end_seconds": 120.02,
      "duration_seconds": 2.59,
      "text": "I've, I've got acid reflux."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.54,
      "end_seconds": 127.71,
      "duration_seconds": 7.17,
      "text": "I follow. Right, so acid reflux is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.79,
      "end_seconds": 144.12,
      "duration_seconds": 1.33,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.83,
      "end_seconds": 149.04,
      "duration_seconds": 4.21,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.54,
      "end_seconds": 151.92,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.66,
      "end_seconds": 159.78,
      "duration_seconds": 4.12,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.59,
      "end_seconds": 163.31,
      "duration_seconds": 1.72,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.83,
      "end_seconds": 168.89,
      "duration_seconds": 4.06,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.98,
      "end_seconds": 172.84,
      "duration_seconds": 2.86,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.74,
      "end_seconds": 177.66,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.04,
      "end_seconds": 182.81,
      "duration_seconds": 3.77,
      "text": "Any leg swelling, fever or cough at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.54,
      "end_seconds": 185.97,
      "duration_seconds": 2.43,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.08,
      "end_seconds": 189.13,
      "duration_seconds": 2.05,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.91,
      "end_seconds": 191.57,
      "duration_seconds": 1.66,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.11,
      "end_seconds": 196.26,
      "duration_seconds": 3.15,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.0,
      "end_seconds": 199.4,
      "duration_seconds": 2.4,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.92,
      "end_seconds": 211.81,
      "duration_seconds": 10.89,
      "text": "Okay, so the vitals from earlier. BP is 100 over 63, temperature is 37.0 degrees, respiratory rate 19, saturation 99 percent, pulse 109."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.4,
      "end_seconds": 213.1,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.12,
      "end_seconds": 218.66,
      "duration_seconds": 3.54,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.95,
      "end_seconds": 222.27,
      "duration_seconds": 2.32,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.5,
      "end_seconds": 241.01,
      "duration_seconds": 6.51,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.72,
      "end_seconds": 257.68,
      "duration_seconds": 12.96,
      "text": "That's the examination finished. Okay, so my impression is this: I'd lean towards possible cardiac tamponade. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.63,
      "end_seconds": 263.08,
      "duration_seconds": 4.45,
      "text": "Oh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.51,
      "end_seconds": 280.76,
      "duration_seconds": 16.25,
      "text": "It's reasonable to be concerned, but right now possible cardiac tamponade is my leading thought, not anything worse. Let me repeat that back to make sure. You've been feeling faint for about four days, and no cough or leg swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.7,
      "end_seconds": 283.63,
      "duration_seconds": 1.93,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.41,
      "end_seconds": 300.22,
      "duration_seconds": 14.81,
      "text": "I think an urgent echocardiogram makes sense here, for possible tamponade. You need an urgent heart scan and possibly a drain. I'm going to send a referral to the cardiology team."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.92,
      "end_seconds": 303.64,
      "duration_seconds": 1.72,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.54,
      "end_seconds": 320.54,
      "duration_seconds": 13.0,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again straight away. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.41,
      "end_seconds": 324.26,
      "duration_seconds": 2.85,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.04,
      "end_seconds": 326.22,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
