{
  "schema_version": "1.0",
  "encounter_id": "03004",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.05,
      "duration_seconds": 3.41,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 10.69,
      "duration_seconds": 4.87,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.4,
      "end_seconds": 14.65,
      "duration_seconds": 3.25,
      "text": "Well, I've been having three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 19.11,
      "duration_seconds": 3.57,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.85,
      "end_seconds": 23.75,
      "duration_seconds": 3.9,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.31,
      "end_seconds": 28.85,
      "duration_seconds": 3.54,
      "text": "Right, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.54,
      "end_seconds": 32.42,
      "duration_seconds": 1.88,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.76,
      "end_seconds": 36.38,
      "duration_seconds": 3.62,
      "text": "Okay, go on. Has there been irregular cycles too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.31,
      "end_seconds": 42.47,
      "duration_seconds": 5.16,
      "text": "Mm, yes. I've been feeling low and anxious too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.86,
      "end_seconds": 49.15,
      "duration_seconds": 6.29,
      "text": "I see, go ahead. Have you had any clotting problem, fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.72,
      "end_seconds": 54.91,
      "duration_seconds": 5.19,
      "text": "No, no clotting problem, fever or heavy bleeding now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.75,
      "end_seconds": 59.68,
      "duration_seconds": 2.93,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.74,
      "end_seconds": 63.34,
      "duration_seconds": 2.6,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.71,
      "end_seconds": 67.07,
      "duration_seconds": 2.36,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.17,
      "end_seconds": 70.72,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.94,
      "end_seconds": 88.89,
      "duration_seconds": 3.95,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.89,
      "end_seconds": 94.12,
      "duration_seconds": 4.23,
      "text": "Cat fur. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.21,
      "end_seconds": 101.47,
      "duration_seconds": 5.26,
      "text": "Has anyone ever diagnosed you with something? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.12,
      "end_seconds": 106.53,
      "duration_seconds": 3.41,
      "text": "I have COPD. I've got heart disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.72,
      "end_seconds": 111.64,
      "duration_seconds": 3.92,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.36,
      "end_seconds": 121.92,
      "duration_seconds": 8.56,
      "text": "I'm on Tiotropium inhaler, once a day for my chest. It's metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.45,
      "end_seconds": 127.84,
      "duration_seconds": 4.39,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.82,
      "end_seconds": 131.15,
      "duration_seconds": 2.33,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.68,
      "end_seconds": 147.6,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.86,
      "end_seconds": 166.63,
      "duration_seconds": 15.77,
      "text": "No, I've never smoked in my life. I only drink at family occasions. I'm a hairdresser, on my feet all day. I do a yoga class on Thursdays. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.05,
      "end_seconds": 183.81,
      "duration_seconds": 2.76,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.36,
      "end_seconds": 189.56,
      "duration_seconds": 5.2,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 194.45,
      "duration_seconds": 3.39,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.36,
      "end_seconds": 206.76,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 242.76,
      "duration_seconds": 15.0,
      "text": "Okay: height 160 centimetres, temp 36.8 degrees, BMI works out to 38.3, weight 98 kilos, BP is 122 over 73, SpO2 97 percent on room air, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.19,
      "end_seconds": 246.51,
      "duration_seconds": 2.32,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.19,
      "end_seconds": 251.12,
      "duration_seconds": 2.93,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.32,
      "end_seconds": 255.87,
      "duration_seconds": 3.55,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.4,
      "end_seconds": 258.34,
      "duration_seconds": 0.94,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 261.7,
      "duration_seconds": 1.44,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.88,
      "end_seconds": 277.81,
      "duration_seconds": 1.93,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.78,
      "end_seconds": 303.5,
      "duration_seconds": 22.72,
      "text": "All finished, thank you. Let me tell you where I've got to. I'd lean towards recurrent miscarriage needing investigation. The reason I say that is that your story and my examination fit together. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.44,
      "end_seconds": 306.9,
      "duration_seconds": 1.46,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.9,
      "end_seconds": 315.99,
      "duration_seconds": 7.09,
      "text": "For now, no new medicines or tests are needed. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.37,
      "end_seconds": 324.1,
      "duration_seconds": 2.73,
      "text": "Well, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.72,
      "end_seconds": 327.65,
      "duration_seconds": 1.93,
      "text": "Have a good day."
    }
  ]
