{
  "schema_version": "1.0",
  "encounter_id": "03397",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.38,
      "end_seconds": 7.96,
      "duration_seconds": 6.58,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.19,
      "end_seconds": 12.47,
      "duration_seconds": 3.28,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.06,
      "end_seconds": 19.73,
      "duration_seconds": 3.67,
      "text": "I've been dealing with darker skin."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.91,
      "end_seconds": 24.56,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.06,
      "end_seconds": 30.36,
      "duration_seconds": 4.3,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.02,
      "end_seconds": 35.05,
      "duration_seconds": 3.03,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.54,
      "end_seconds": 38.28,
      "duration_seconds": 1.74,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.68,
      "end_seconds": 42.43,
      "duration_seconds": 2.75,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.62,
      "end_seconds": 60.66,
      "duration_seconds": 13.04,
      "text": "When it starts I tend to get dizziness on standing as well. As for dizziness on standing, I notice it more with standing."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.68,
      "end_seconds": 70.89,
      "duration_seconds": 5.21,
      "text": "Have you had darker skin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.66,
      "end_seconds": 81.64,
      "duration_seconds": 8.98,
      "text": "Okay, um, so a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.7,
      "end_seconds": 91.74,
      "duration_seconds": 4.04,
      "text": "Any vomiting, severe tummy pain, fever or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.53,
      "end_seconds": 100.0,
      "duration_seconds": 6.47,
      "text": "Right, I haven't had vomiting, severe tummy pain, fever or fainting, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.82,
      "end_seconds": 107.69,
      "duration_seconds": 2.87,
      "text": "Okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.92,
      "end_seconds": 112.86,
      "duration_seconds": 3.94,
      "text": "Uh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.98,
      "end_seconds": 124.41,
      "duration_seconds": 4.43,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.41,
      "end_seconds": 128.89,
      "duration_seconds": 2.48,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 147.47,
      "duration_seconds": 2.36,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.99,
      "end_seconds": 153.69,
      "duration_seconds": 5.7,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.69,
      "end_seconds": 157.4,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.03,
      "end_seconds": 161.77,
      "duration_seconds": 2.74,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.68,
      "end_seconds": 167.4,
      "duration_seconds": 4.72,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.8,
      "end_seconds": 174.1,
      "duration_seconds": 5.3,
      "text": "Mm, it's furosemide, 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.96,
      "end_seconds": 177.26,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 182.56,
      "duration_seconds": 3.69,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.67,
      "end_seconds": 186.99,
      "duration_seconds": 3.32,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.16,
      "end_seconds": 193.33,
      "duration_seconds": 5.17,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.37,
      "end_seconds": 197.56,
      "duration_seconds": 2.19,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.78,
      "end_seconds": 201.61,
      "duration_seconds": 2.83,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.13,
      "end_seconds": 208.7,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.9,
      "end_seconds": 218.2,
      "duration_seconds": 4.3,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 230.1,
      "end_seconds": 240.85,
      "duration_seconds": 10.75,
      "text": "Okay, so the vitals from earlier. Weight 72 kilos, temp 36.4 degrees, heart rate 110, height 175 centimetres, BP is 103 over 60."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.44,
      "end_seconds": 243.14,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.31,
      "end_seconds": 249.59,
      "duration_seconds": 4.28,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.05,
      "end_seconds": 253.17,
      "duration_seconds": 2.12,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.36,
      "end_seconds": 280.04,
      "duration_seconds": 10.68,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.68,
      "end_seconds": 317.08,
      "duration_seconds": 34.4,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I'd lean towards possible adrenal insufficiency. That's my thinking for now, and it may change as we learn more. An underactive thyroid is still possible. I'll request a short synacthen test, it'll help with possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'd like you back after the results."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.79,
      "end_seconds": 322.74,
      "duration_seconds": 3.95,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.53,
      "end_seconds": 325.26,
      "duration_seconds": 1.73,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.11,
      "end_seconds": 332.59,
      "duration_seconds": 1.48,
      "text": "Goodbye for now."
    }
  ]
}