{
  "schema_version": "1.0",
  "encounter_id": "03487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 7.48,
      "duration_seconds": 6.32,
      "text": "Sorry, what was I saying, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 13.24,
      "duration_seconds": 4.36,
      "text": "So, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.42,
      "end_seconds": 23.33,
      "duration_seconds": 4.91,
      "text": "Well, I've been having vomiting once or twice."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 27.87,
      "duration_seconds": 3.36,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.27,
      "end_seconds": 31.72,
      "duration_seconds": 2.45,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.79,
      "end_seconds": 42.02,
      "duration_seconds": 8.23,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.71,
      "end_seconds": 50.23,
      "duration_seconds": 6.52,
      "text": "Hmm, um, it feels moderate to me. It's on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.23,
      "end_seconds": 59.21,
      "duration_seconds": 7.98,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 59.31,
      "end_seconds": 66.44,
      "duration_seconds": 7.13,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.7,
      "end_seconds": 69.82,
      "duration_seconds": 2.12,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.95,
      "end_seconds": 74.79,
      "duration_seconds": 2.84,
      "text": "And, And loose stools, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.01,
      "end_seconds": 79.48,
      "duration_seconds": 3.47,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.1,
      "end_seconds": 83.13,
      "duration_seconds": 3.03,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.5,
      "end_seconds": 89.76,
      "duration_seconds": 6.26,
      "text": "Understood. Have you had vomiting once or twice before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.74,
      "end_seconds": 97.8,
      "duration_seconds": 6.06,
      "text": "I, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.18,
      "end_seconds": 104.57,
      "duration_seconds": 5.39,
      "text": "Any high fever, no wet nappies or blood in the stool?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.79,
      "end_seconds": 123.99,
      "duration_seconds": 18.2,
      "text": "No, no high fever, no no wet nappies, no blood in the stool. I did have a mild tummy ache at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.43,
      "end_seconds": 128.44,
      "duration_seconds": 3.01,
      "text": "Okay, have you had any drowsiness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 134.36,
      "duration_seconds": 4.26,
      "text": "No, you know, I haven't had any drowsiness."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.21,
      "end_seconds": 137.99,
      "duration_seconds": 2.78,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.29,
      "end_seconds": 140.78,
      "duration_seconds": 1.49,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 143.04,
      "duration_seconds": 1.38,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.57,
      "end_seconds": 145.05,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.35,
      "end_seconds": 156.95,
      "duration_seconds": 3.6,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.29,
      "end_seconds": 173.11,
      "duration_seconds": 14.82,
      "text": "I'm, I'm on Seretide inhaler, twice a day for my asthma. I mean, um, I'm on something called warf... warfarin, 3 milligrams, maybe, in the evening."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.09,
      "end_seconds": 178.38,
      "duration_seconds": 4.29,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.3,
      "end_seconds": 187.33,
      "duration_seconds": 7.03,
      "text": "Actually, no, it's at home. Oral rehydration solution, after each loose stool."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.28,
      "end_seconds": 194.25,
      "duration_seconds": 1.97,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.62,
      "end_seconds": 203.15,
      "duration_seconds": 7.53,
      "text": "It's 1 sachet. Hmm, I'd been on bisoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 207.95,
      "duration_seconds": 4.01,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.46,
      "end_seconds": 212.52,
      "duration_seconds": 3.06,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.2,
      "end_seconds": 215.87,
      "duration_seconds": 2.67,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.46,
      "end_seconds": 227.88,
      "duration_seconds": 11.42,
      "text": "Hmm, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.07,
      "end_seconds": 230.27,
      "duration_seconds": 1.2,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.87,
      "end_seconds": 235.41,
      "duration_seconds": 4.54,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.45,
      "end_seconds": 239.22,
      "duration_seconds": 1.77,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.84,
      "end_seconds": 242.7,
      "duration_seconds": 1.86,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.0,
      "end_seconds": 245.95,
      "duration_seconds": 1.95,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.21,
      "end_seconds": 250.84,
      "duration_seconds": 3.63,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.25,
      "end_seconds": 254.55,
      "duration_seconds": 2.3,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.16,
      "end_seconds": 260.68,
      "duration_seconds": 5.52,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.77,
      "end_seconds": 275.82,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.93,
      "end_seconds": 281.79,
      "duration_seconds": 4.86,
      "text": "Yes, asthma. An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.28,
      "end_seconds": 290.15,
      "duration_seconds": 6.87,
      "text": "Okay, I can see asthma in your file as well. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.01,
      "end_seconds": 298.6,
      "duration_seconds": 6.59,
      "text": "Well, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 299.67,
      "end_seconds": 307.32,
      "duration_seconds": 7.65,
      "text": "Here are the numbers, doctor. Temperature is 36.9 degrees, pressure 125 over 81, pulse 70, saturation 97 percent."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.19,
      "end_seconds": 309.66,
      "duration_seconds": 1.47,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.59,
      "end_seconds": 313.99,
      "duration_seconds": 2.4,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.05,
      "end_seconds": 317.18,
      "duration_seconds": 1.13,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.23,
      "end_seconds": 320.2,
      "duration_seconds": 1.97,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.9,
      "end_seconds": 343.54,
      "duration_seconds": 4.64,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.64,
      "end_seconds": 358.16,
      "duration_seconds": 9.52,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, the most likely explanation is a mild stomach bug."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.92,
      "end_seconds": 362.19,
      "duration_seconds": 3.27,
      "text": "Oh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.49,
      "end_seconds": 384.8,
      "duration_seconds": 19.31,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. So, to recap quickly. You've had vomiting once or twice for six months, moderate, and no no wet nappies or drowsiness."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.78,
      "end_seconds": 392.72,
      "duration_seconds": 3.94,
      "text": "Right, you know, yes, you've got it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.21,
      "end_seconds": 420.39,
      "duration_seconds": 26.18,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if he stops drinking or becomes drowsy. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.93,
      "end_seconds": 424.9,
      "duration_seconds": 2.97,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.92,
      "end_seconds": 430.61,
      "duration_seconds": 4.69,
      "text": "I'd like to see you again if he is not drinking."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 431.95,
      "end_seconds": 435.83,
      "duration_seconds": 3.88,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.05,
      "end_seconds": 440.49,
      "duration_seconds": 3.44,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 441.92,
      "end_seconds": 445.67,
      "duration_seconds": 3.75,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.59,
      "end_seconds": 448.59,
      "duration_seconds": 2.0,
      "text": "So, look after yourself."
    }
  ]
}