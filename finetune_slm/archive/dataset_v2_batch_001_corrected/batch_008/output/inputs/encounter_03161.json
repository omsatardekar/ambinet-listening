{
  "schema_version": "1.0",
  "encounter_id": "03161",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.22,
      "duration_seconds": 3.87,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 9.85,
      "duration_seconds": 4.12,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.0,
      "end_seconds": 27.79,
      "duration_seconds": 16.79,
      "text": "Mainly vomiting once or twice. There's a couple of other things, but that's the main one. I'm hoping you can tell me something definite. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.48,
      "end_seconds": 32.21,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.22,
      "end_seconds": 41.62,
      "duration_seconds": 4.4,
      "text": "Well, it's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.59,
      "end_seconds": 45.96,
      "duration_seconds": 2.37,
      "text": "Has there been loose stools too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.75,
      "end_seconds": 50.13,
      "duration_seconds": 2.38,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.41,
      "end_seconds": 57.94,
      "duration_seconds": 7.53,
      "text": "Ah. Have you had vomiting once or twice before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.13,
      "end_seconds": 65.86,
      "duration_seconds": 6.73,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.94,
      "end_seconds": 81.36,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 86.7,
      "duration_seconds": 4.69,
      "text": "Right, uh, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.33,
      "end_seconds": 91.3,
      "duration_seconds": 3.97,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.89,
      "end_seconds": 93.16,
      "duration_seconds": 1.27,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.14,
      "end_seconds": 99.09,
      "duration_seconds": 4.95,
      "text": "Yes, depression is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.06,
      "end_seconds": 117.16,
      "duration_seconds": 3.1,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.07,
      "end_seconds": 131.43,
      "duration_seconds": 12.36,
      "text": "I walk the dog every morning. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 138.24,
      "duration_seconds": 4.88,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.04,
      "end_seconds": 146.18,
      "duration_seconds": 6.14,
      "text": "So, not currently, but as a youngster naproxen gave me a rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.31,
      "end_seconds": 162.39,
      "duration_seconds": 6.08,
      "text": "Have you had any drowsiness, no wet nappies or blood in the stool?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 167.55,
      "duration_seconds": 4.38,
      "text": "Mm, um, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.59,
      "end_seconds": 170.15,
      "duration_seconds": 1.56,
      "text": "How about high fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.02,
      "end_seconds": 175.7,
      "duration_seconds": 4.68,
      "text": "Not at all, you know, no high fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.39,
      "end_seconds": 177.71,
      "duration_seconds": 1.32,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.16,
      "end_seconds": 181.81,
      "duration_seconds": 2.65,
      "text": "Oh, no weakness or anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.35,
      "end_seconds": 187.5,
      "duration_seconds": 4.15,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.52,
      "end_seconds": 202.66,
      "duration_seconds": 2.14,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.46,
      "end_seconds": 229.36,
      "duration_seconds": 10.9,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 126 over 71, weight 65 kilos, height 161 centimetres, pulse 86, BMI works out to 25.1."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.31,
      "end_seconds": 231.77,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.28,
      "end_seconds": 235.49,
      "duration_seconds": 3.21,
      "text": "So, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.66,
      "end_seconds": 241.92,
      "duration_seconds": 4.26,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.05,
      "end_seconds": 247.03,
      "duration_seconds": 0.98,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.76,
      "end_seconds": 250.48,
      "duration_seconds": 1.72,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.45,
      "end_seconds": 275.1,
      "duration_seconds": 5.65,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.66,
      "end_seconds": 286.17,
      "duration_seconds": 6.51,
      "text": "You can relax now. Okay, thinking it through, this is probably a mild stomach bug."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.93,
      "end_seconds": 291.63,
      "duration_seconds": 3.7,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.09,
      "end_seconds": 309.94,
      "duration_seconds": 16.85,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. Small, frequent sips of fluid and keep him off nursery for two days after it stops."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.32,
      "end_seconds": 313.58,
      "duration_seconds": 3.26,
      "text": "Hm, okay. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.34,
      "end_seconds": 316.79,
      "duration_seconds": 2.45,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}