{
  "schema_version": "1.0",
  "encounter_id": "03227",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.4,
      "end_seconds": 2.97,
      "duration_seconds": 1.57,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.06,
      "end_seconds": 5.11,
      "duration_seconds": 1.05,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.05,
      "end_seconds": 10.03,
      "duration_seconds": 2.98,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.55,
      "end_seconds": 15.96,
      "duration_seconds": 5.41,
      "text": "So the thing is, I've got pain in my breastbone wound."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.89,
      "end_seconds": 20.26,
      "duration_seconds": 3.37,
      "text": "Alright, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.3,
      "end_seconds": 27.52,
      "duration_seconds": 3.22,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.27,
      "end_seconds": 34.37,
      "duration_seconds": 2.1,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.22,
      "end_seconds": 38.67,
      "duration_seconds": 2.45,
      "text": "Coughing definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.03,
      "end_seconds": 43.38,
      "duration_seconds": 3.35,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.37,
      "end_seconds": 50.66,
      "duration_seconds": 6.29,
      "text": "It usually comes with tiredness. Oh, the tiredness? That's been since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.21,
      "end_seconds": 67.58,
      "duration_seconds": 3.37,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.69,
      "end_seconds": 78.05,
      "duration_seconds": 9.36,
      "text": "I'm on aspirin, 75 milligrams, once a day for my heart. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.94,
      "end_seconds": 87.34,
      "duration_seconds": 5.4,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.18,
      "end_seconds": 107.25,
      "duration_seconds": 18.07,
      "text": "I've never touched a cigarette. I only drink at family occasions. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.56,
      "end_seconds": 125.35,
      "duration_seconds": 4.79,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.11,
      "end_seconds": 131.34,
      "duration_seconds": 2.23,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.08,
      "end_seconds": 134.99,
      "duration_seconds": 1.91,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.63,
      "end_seconds": 139.82,
      "duration_seconds": 2.19,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.35,
      "end_seconds": 145.04,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.14,
      "end_seconds": 150.74,
      "duration_seconds": 4.6,
      "text": "I have heart disease, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.43,
      "end_seconds": 157.43,
      "duration_seconds": 6.0,
      "text": "Okay, go on. Alright, heart disease, that matches what I have here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.21,
      "end_seconds": 172.53,
      "duration_seconds": 4.32,
      "text": "Let me check a few things. Any fever or breathlessness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.96,
      "end_seconds": 176.65,
      "duration_seconds": 2.69,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.6,
      "end_seconds": 181.04,
      "duration_seconds": 3.44,
      "text": "Okay, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.44,
      "end_seconds": 184.39,
      "duration_seconds": 1.95,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.31,
      "end_seconds": 189.41,
      "duration_seconds": 3.1,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.54,
      "end_seconds": 201.8,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.56,
      "end_seconds": 227.92,
      "duration_seconds": 10.36,
      "text": "Okay: heart rate 74, height 175 centimetres. And weight 80 kilos, BMI works out to 26.1, saturation 98 percent, blood pressure 126 over 78."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.52,
      "end_seconds": 232.96,
      "duration_seconds": 3.44,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.03,
      "end_seconds": 236.41,
      "duration_seconds": 2.38,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.68,
      "end_seconds": 242.8,
      "duration_seconds": 4.12,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.4,
      "end_seconds": 246.79,
      "duration_seconds": 2.39,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.12,
      "end_seconds": 267.58,
      "duration_seconds": 9.46,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.17,
      "end_seconds": 279.92,
      "duration_seconds": 9.75,
      "text": "Good, you can sit up again. Let me tell you where I've got to. This is probably recovering well after bypass surgery."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.85,
      "end_seconds": 288.74,
      "duration_seconds": 2.89,
      "text": "Is this serious, um, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.64,
      "end_seconds": 299.69,
      "duration_seconds": 9.05,
      "text": "It's reasonable to be concerned, but right now recovering well after bypass surgery is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.26,
      "end_seconds": 312.26,
      "duration_seconds": 3.0,
      "text": "Let's get blood tests, for post-operative review."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.13,
      "end_seconds": 316.31,
      "duration_seconds": 2.18,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.31,
      "end_seconds": 330.26,
      "duration_seconds": 12.95,
      "text": "Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I'd like you to see the cardiac rehabilitation team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.54,
      "end_seconds": 334.02,
      "duration_seconds": 2.48,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.8,
      "end_seconds": 343.47,
      "duration_seconds": 7.67,
      "text": "Come back or go to emergency straight away if the symptoms get worse. We'll catch up in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.53,
      "end_seconds": 346.92,
      "duration_seconds": 2.39,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.8,
      "end_seconds": 351.2,
      "duration_seconds": 2.4,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.93,
      "end_seconds": 356.12,
      "duration_seconds": 3.19,
      "text": "Great, thank you for your help."
    }
  ]
}