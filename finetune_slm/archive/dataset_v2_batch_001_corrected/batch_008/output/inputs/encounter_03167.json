{
  "schema_version": "1.0",
  "encounter_id": "03167",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 4.57,
      "duration_seconds": 3.48,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.29,
      "end_seconds": 7.48,
      "duration_seconds": 1.19,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 15.63,
      "duration_seconds": 3.96,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 26.45,
      "duration_seconds": 6.0,
      "text": "Yes, that's no problem at all. Please sit. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.88,
      "end_seconds": 36.53,
      "duration_seconds": 7.65,
      "text": "It's sudden severe pain in the lower tummy, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.34,
      "end_seconds": 38.96,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.23,
      "end_seconds": 47.48,
      "duration_seconds": 7.25,
      "text": "It's been like this since yesterday. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.74,
      "end_seconds": 51.38,
      "duration_seconds": 2.64,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.07,
      "end_seconds": 71.08,
      "duration_seconds": 15.01,
      "text": "It comes and goes. And there's shoulder tip pain as well, about three months now. Oh, and collapsing. About collapsing, about a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.32,
      "end_seconds": 79.8,
      "duration_seconds": 7.48,
      "text": "Have you had sudden severe pain in the lower tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.88,
      "end_seconds": 86.4,
      "duration_seconds": 5.52,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.95,
      "end_seconds": 107.03,
      "duration_seconds": 3.08,
      "text": "Have you noticed fever, vomiting or discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.08,
      "end_seconds": 112.45,
      "duration_seconds": 4.37,
      "text": "I haven't had fever, vomiting or discharge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.0,
      "end_seconds": 117.74,
      "duration_seconds": 3.74,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.76,
      "end_seconds": 122.46,
      "duration_seconds": 2.7,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.01,
      "end_seconds": 126.11,
      "duration_seconds": 2.1,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.56,
      "end_seconds": 130.14,
      "duration_seconds": 2.58,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.69,
      "end_seconds": 134.68,
      "duration_seconds": 2.99,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.36,
      "end_seconds": 140.19,
      "duration_seconds": 4.83,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.59,
      "end_seconds": 147.38,
      "duration_seconds": 2.79,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.23,
      "end_seconds": 151.8,
      "duration_seconds": 3.57,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.8,
      "end_seconds": 158.05,
      "duration_seconds": 5.25,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.27,
      "end_seconds": 170.05,
      "duration_seconds": 9.78,
      "text": "Years back I got a rash all over from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.48,
      "end_seconds": 175.42,
      "duration_seconds": 3.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.13,
      "end_seconds": 180.97,
      "duration_seconds": 4.84,
      "text": "Um, I have depression, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 189.18,
      "duration_seconds": 6.6,
      "text": "Okay, I can see depression in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 190.49,
      "end_seconds": 194.78,
      "duration_seconds": 4.29,
      "text": "She takes escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.1,
      "end_seconds": 197.4,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.71,
      "end_seconds": 201.59,
      "duration_seconds": 2.88,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.09,
      "end_seconds": 204.13,
      "duration_seconds": 2.04,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 212.75,
      "duration_seconds": 2.53,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.33,
      "end_seconds": 238.64,
      "duration_seconds": 9.31,
      "text": "Okay: blood pressure 93 over 65, temperature 36.5. And heart rate 96, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.53,
      "end_seconds": 242.6,
      "duration_seconds": 3.07,
      "text": "Ah, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.27,
      "end_seconds": 246.67,
      "duration_seconds": 2.4,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.1,
      "end_seconds": 253.37,
      "duration_seconds": 4.27,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.9,
      "end_seconds": 256.29,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.35,
      "end_seconds": 280.1,
      "duration_seconds": 7.75,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.55,
      "end_seconds": 294.46,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.21,
      "end_seconds": 300.96,
      "duration_seconds": 2.75,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.48,
      "end_seconds": 331.47,
      "duration_seconds": 20.99,
      "text": "So where does that leave us? I'd lean towards a ruptured ectopic pregnancy. I can't rule out a ruptured ovarian cyst yet. Let me repeat that back to make sure. You've had sudden severe pain in the lower tummy, since yesterday, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.1,
      "end_seconds": 334.72,
      "duration_seconds": 1.62,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.43,
      "end_seconds": 341.16,
      "duration_seconds": 3.73,
      "text": "I want a pregnancy test done, that's for collapse."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.33,
      "end_seconds": 344.97,
      "duration_seconds": 2.64,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.72,
      "end_seconds": 360.72,
      "duration_seconds": 15.0,
      "text": "I am calling the emergency team, you need an operation now. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.65,
      "end_seconds": 365.21,
      "duration_seconds": 3.56,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.42,
      "end_seconds": 368.97,
      "duration_seconds": 2.55,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.93,
      "end_seconds": 375.47,
      "duration_seconds": 4.54,
      "text": "No, um, that's all. Thanks a lot."
    }
  ]
}