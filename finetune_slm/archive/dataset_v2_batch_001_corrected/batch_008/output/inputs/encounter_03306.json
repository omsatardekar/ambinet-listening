{
  "schema_version": "1.0",
  "encounter_id": "03306",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 6.34,
      "duration_seconds": 4.95,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 11.75,
      "duration_seconds": 3.99,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.83,
      "end_seconds": 23.47,
      "duration_seconds": 9.64,
      "text": "Honestly, it's wheeze at work, and my family pushed me to come. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.44,
      "end_seconds": 28.36,
      "duration_seconds": 2.92,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.08,
      "end_seconds": 32.42,
      "duration_seconds": 3.34,
      "text": "Okay, so it's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.38,
      "end_seconds": 37.17,
      "duration_seconds": 2.79,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.27,
      "end_seconds": 39.74,
      "duration_seconds": 1.47,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.96,
      "end_seconds": 43.22,
      "duration_seconds": 2.26,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.36,
      "end_seconds": 46.94,
      "duration_seconds": 2.58,
      "text": "Work definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.38,
      "end_seconds": 50.78,
      "duration_seconds": 2.4,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 56.59,
      "duration_seconds": 4.35,
      "text": "It usually comes with a tight chest at work."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.83,
      "end_seconds": 61.88,
      "duration_seconds": 4.05,
      "text": "Any a cough that eases on holiday as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.95,
      "end_seconds": 75.61,
      "duration_seconds": 12.66,
      "text": "Yes, actually. With cough that eases on holiday, mostly severe. It's all the time. The tight chest at work? That's been for five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 79.41,
      "duration_seconds": 2.73,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.29,
      "end_seconds": 81.85,
      "duration_seconds": 1.56,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.79,
      "end_seconds": 87.65,
      "duration_seconds": 3.86,
      "text": "Did you get ankle swelling or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.73,
      "end_seconds": 90.64,
      "duration_seconds": 1.91,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.97,
      "end_seconds": 95.87,
      "duration_seconds": 3.9,
      "text": "Did you get fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.68,
      "end_seconds": 104.26,
      "duration_seconds": 3.58,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.05,
      "end_seconds": 108.05,
      "duration_seconds": 3.0,
      "text": "Okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.9,
      "end_seconds": 111.25,
      "duration_seconds": 2.35,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.08,
      "end_seconds": 115.76,
      "duration_seconds": 3.68,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.85,
      "end_seconds": 126.08,
      "duration_seconds": 9.23,
      "text": "I'm on metoprolol, 50 milligrams, twice a day for the heart rhythm. A reliever inhaler, 100 micrograms, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.95,
      "end_seconds": 131.59,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.94,
      "end_seconds": 134.81,
      "duration_seconds": 1.87,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.99,
      "end_seconds": 138.91,
      "duration_seconds": 2.92,
      "text": "So, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.03,
      "end_seconds": 149.33,
      "duration_seconds": 5.3,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 154.87,
      "duration_seconds": 3.66,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.03,
      "end_seconds": 158.85,
      "duration_seconds": 2.82,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.54,
      "end_seconds": 165.51,
      "duration_seconds": 4.97,
      "text": "Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.05,
      "end_seconds": 185.82,
      "duration_seconds": 2.77,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.83,
      "end_seconds": 190.26,
      "duration_seconds": 3.43,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.96,
      "end_seconds": 194.64,
      "duration_seconds": 2.68,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.6,
      "end_seconds": 200.08,
      "duration_seconds": 3.48,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.38,
      "end_seconds": 204.49,
      "duration_seconds": 3.11,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.84,
      "end_seconds": 216.31,
      "duration_seconds": 2.47,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 242.79,
      "duration_seconds": 9.61,
      "text": "Okay: respiratory rate 17, pulse is 69 beats a minute, saturation 97 percent, temperature 36.6, BP is 114 over 71."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.02,
      "end_seconds": 245.36,
      "duration_seconds": 1.34,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.37,
      "end_seconds": 249.16,
      "duration_seconds": 2.79,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.63,
      "end_seconds": 254.81,
      "duration_seconds": 4.18,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.72,
      "end_seconds": 258.96,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.06,
      "end_seconds": 280.63,
      "duration_seconds": 5.57,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.11,
      "end_seconds": 286.69,
      "duration_seconds": 2.58,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.02,
      "end_seconds": 306.92,
      "duration_seconds": 9.9,
      "text": "Okay, so my impression is this: It's hard to say. Occupational asthma is one possibility and COPD another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.8,
      "end_seconds": 323.64,
      "duration_seconds": 7.84,
      "text": "For now, no new medicines or tests are needed. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.11,
      "end_seconds": 328.74,
      "duration_seconds": 3.63,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}