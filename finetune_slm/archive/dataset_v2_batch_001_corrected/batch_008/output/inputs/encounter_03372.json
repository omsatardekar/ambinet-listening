{
  "schema_version": "1.0",
  "encounter_id": "03372",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.43,
      "duration_seconds": 3.63,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 10.77,
      "duration_seconds": 5.04,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.89,
      "end_seconds": 17.48,
      "duration_seconds": 5.59,
      "text": "Okay, so good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.33,
      "end_seconds": 22.82,
      "duration_seconds": 3.49,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.31,
      "end_seconds": 30.0,
      "duration_seconds": 5.69,
      "text": "She's been having sudden severe pain in the lower tummy, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.64,
      "end_seconds": 33.77,
      "duration_seconds": 3.13,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.82,
      "end_seconds": 39.42,
      "duration_seconds": 4.6,
      "text": "I'd say about a month, you know, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.15,
      "end_seconds": 46.13,
      "duration_seconds": 4.98,
      "text": "Hm, you know, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.77,
      "end_seconds": 52.05,
      "duration_seconds": 4.28,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.66,
      "end_seconds": 65.25,
      "duration_seconds": 11.59,
      "text": "Actually, yes, somewhere around that. And there's vaginal spotting as well, one week now. There was shoulder tip pain, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.83,
      "end_seconds": 77.66,
      "duration_seconds": 2.83,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.5,
      "end_seconds": 89.0,
      "duration_seconds": 3.5,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.42,
      "end_seconds": 109.83,
      "duration_seconds": 10.41,
      "text": "Okay: temperature is 37.0 degrees, BP is 92 over 60, pulse is 101 beats a minute. And saturation 96 percent, respiratory rate 20."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.54,
      "end_seconds": 112.63,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.76,
      "end_seconds": 117.87,
      "duration_seconds": 4.11,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.1,
      "end_seconds": 123.51,
      "duration_seconds": 4.41,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.69,
      "end_seconds": 125.9,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 149.72,
      "duration_seconds": 7.02,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.03,
      "end_seconds": 154.37,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.96,
      "end_seconds": 174.19,
      "duration_seconds": 3.23,
      "text": "A few quick ones: discharge, vomiting or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.01,
      "end_seconds": 179.54,
      "duration_seconds": 4.53,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.6,
      "end_seconds": 182.67,
      "duration_seconds": 2.07,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.67,
      "end_seconds": 184.74,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.2,
      "end_seconds": 190.62,
      "duration_seconds": 4.42,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.32,
      "end_seconds": 200.56,
      "duration_seconds": 5.24,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.74,
      "end_seconds": 204.13,
      "duration_seconds": 2.39,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.42,
      "end_seconds": 215.45,
      "duration_seconds": 10.03,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety. It's amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.3,
      "end_seconds": 226.36,
      "duration_seconds": 9.06,
      "text": "Hmm, she is supposed to take it once a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.1,
      "end_seconds": 231.37,
      "duration_seconds": 4.27,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.53,
      "end_seconds": 236.44,
      "duration_seconds": 3.91,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.96,
      "end_seconds": 239.86,
      "duration_seconds": 1.9,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.42,
      "end_seconds": 247.98,
      "duration_seconds": 4.56,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.38,
      "end_seconds": 252.45,
      "duration_seconds": 3.07,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.97,
      "end_seconds": 260.64,
      "duration_seconds": 3.67,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.87,
      "end_seconds": 271.97,
      "duration_seconds": 4.1,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.38,
      "end_seconds": 276.32,
      "duration_seconds": 2.94,
      "text": "Right, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.22,
      "end_seconds": 281.14,
      "duration_seconds": 2.92,
      "text": "Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.18,
      "end_seconds": 286.8,
      "duration_seconds": 4.62,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.56,
      "end_seconds": 290.82,
      "duration_seconds": 2.26,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.51,
      "end_seconds": 306.34,
      "duration_seconds": 14.83,
      "text": "I've had anxiety, yes. Well, um, I've had high blood pressure, yes. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.31,
      "end_seconds": 328.68,
      "duration_seconds": 21.37,
      "text": "I'll request urgent blood tests, it'll help with internal bleeding. I'm sending you for a pregnancy test because of collapse. I'd rather check than guess, and this is the quickest way to know more. I am calling the emergency team, you need an operation now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.23,
      "end_seconds": 340.56,
      "duration_seconds": 11.33,
      "text": "Yes, carry on. I'm going to send a referral to the emergency team. Let's review you straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.37,
      "end_seconds": 343.61,
      "duration_seconds": 2.24,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.95,
      "end_seconds": 346.39,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}