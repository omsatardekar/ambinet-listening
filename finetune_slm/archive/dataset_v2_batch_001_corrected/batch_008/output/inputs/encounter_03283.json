    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.65,
      "end_seconds": 137.45,
      "duration_seconds": 4.8,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.95,
      "end_seconds": 146.4,
      "duration_seconds": 3.45,
      "text": "no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.96,
      "end_seconds": 158.17,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.63,
      "end_seconds": 160.8,
      "duration_seconds": 1.17,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 182.4,
      "duration_seconds": 6.37,
      "text": "What conditions have you been treated for in the past? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 185.85,
      "duration_seconds": 2.21,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.39,
      "end_seconds": 194.57,
      "duration_seconds": 7.18,
      "text": "Okay, I can see heart failure in your file as well. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.2,
      "end_seconds": 211.06,
      "duration_seconds": 2.86,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.84,
      "end_seconds": 230.28,
      "duration_seconds": 8.44,
      "text": "Okay: oxygen saturation is 97 percent, pressure 118 over 70, temperature 36.8. And heart rate 80."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.38,
      "end_seconds": 232.9,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.41,
      "end_seconds": 236.06,
      "duration_seconds": 2.65,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.29,
      "end_seconds": 243.69,
      "duration_seconds": 5.4,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.65,
      "end_seconds": 247.02,
      "duration_seconds": 1.37,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.19,
      "end_seconds": 265.02,
      "duration_seconds": 1.83,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.91,
      "end_seconds": 268.58,
      "duration_seconds": 1.67,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.8,
      "end_seconds": 285.42,
      "duration_seconds": 11.62,
      "text": "That's the examination finished. Right, here's what I'm thinking. I'm honestly not certain yet. It could be recurrent miscarriage needing investigation, or it might be an antiphospholipid problem."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.64,
      "end_seconds": 311.05,
      "duration_seconds": 9.41,
      "text": "We should do blood tests for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.41,
      "end_seconds": 323.59,
      "duration_seconds": 12.18,
      "text": "I follow i think the recurrent miscarriage clinic should see you too if the symptoms get worse, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.54,
      "end_seconds": 326.52,
      "duration_seconds": 0.98,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.14,
      "end_seconds": 331.49,
      "duration_seconds": 4.35,
      "text": "Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
