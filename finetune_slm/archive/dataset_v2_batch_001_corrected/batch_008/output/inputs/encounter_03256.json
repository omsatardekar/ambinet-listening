{
  "schema_version": "1.0",
  "encounter_id": "03256",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 3.84,
      "duration_seconds": 3.28,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.23,
      "end_seconds": 9.7,
      "duration_seconds": 4.47,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.74,
      "end_seconds": 16.18,
      "duration_seconds": 5.44,
      "text": "Yeah, it's fever and shivers. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.74,
      "end_seconds": 19.96,
      "duration_seconds": 2.22,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.99,
      "end_seconds": 25.38,
      "duration_seconds": 3.39,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 30.14,
      "duration_seconds": 2.99,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.46,
      "end_seconds": 34.97,
      "duration_seconds": 3.51,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.79,
      "end_seconds": 39.43,
      "duration_seconds": 2.64,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.4,
      "end_seconds": 51.36,
      "duration_seconds": 10.96,
      "text": "When it starts I tend to get cloudy smelly urine as well. The cloudy smelly urine? That's been for one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.65,
      "end_seconds": 55.14,
      "duration_seconds": 2.49,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.02,
      "end_seconds": 58.97,
      "duration_seconds": 2.95,
      "text": "Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.5,
      "end_seconds": 71.24,
      "duration_seconds": 3.74,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 76.04,
      "duration_seconds": 2.85,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.58,
      "end_seconds": 78.97,
      "duration_seconds": 2.39,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.56,
      "end_seconds": 90.12,
      "duration_seconds": 10.56,
      "text": "I walk the dog every morning. I'm vegetarian and have been for years. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.6,
      "end_seconds": 94.9,
      "duration_seconds": 3.3,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.65,
      "end_seconds": 99.32,
      "duration_seconds": 2.67,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.18,
      "end_seconds": 116.13,
      "duration_seconds": 2.95,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 122.19,
      "duration_seconds": 5.42,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.7,
      "end_seconds": 135.65,
      "duration_seconds": 3.95,
      "text": "Did you get vomiting, fall or back pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.04,
      "end_seconds": 141.2,
      "duration_seconds": 2.16,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.52,
      "end_seconds": 143.43,
      "duration_seconds": 0.91,
      "text": "Any cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.24,
      "end_seconds": 149.67,
      "duration_seconds": 2.43,
      "text": "I haven't noticed any cough."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.94,
      "end_seconds": 152.53,
      "duration_seconds": 1.59,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.38,
      "end_seconds": 155.51,
      "duration_seconds": 1.13,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.49,
      "end_seconds": 162.6,
      "duration_seconds": 5.11,
      "text": "Alright, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.36,
      "end_seconds": 166.1,
      "duration_seconds": 1.74,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.8,
      "end_seconds": 170.57,
      "duration_seconds": 2.77,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.91,
      "end_seconds": 182.2,
      "duration_seconds": 2.29,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.39,
      "end_seconds": 215.62,
      "duration_seconds": 13.23,
      "text": "Okay: weight 66 kilos, temperature is 38.5 degrees. And heart rate 93, oxygen saturation is 97 percent, height 176 centimetres, BP is 104 over 67, respiratory rate 18."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.55,
      "end_seconds": 222.31,
      "duration_seconds": 3.76,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.75,
      "end_seconds": 225.29,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 228.37,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.56,
      "end_seconds": 252.02,
      "duration_seconds": 5.46,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.18,
      "end_seconds": 256.13,
      "duration_seconds": 1.95,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 278.36,
      "duration_seconds": 7.0,
      "text": "So, based on the history and the examination, this looks most like a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.41,
      "end_seconds": 283.6,
      "duration_seconds": 3.19,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.43,
      "end_seconds": 298.46,
      "duration_seconds": 14.03,
      "text": "It's reasonable to be concerned, but right now a catheter-related urinary infection is my leading thought, not anything worse. Let's get a urine culture, for possible urinary infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.98,
      "end_seconds": 301.68,
      "duration_seconds": 2.7,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.03,
      "end_seconds": 328.54,
      "duration_seconds": 25.51,
      "text": "I'm going to order blood tests, for fever. For this, co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with catheter urinary infection. Change the catheter and drink plenty. Do get help quickly if the symptoms get worse. Let's plan a check in two days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.91,
      "end_seconds": 332.4,
      "duration_seconds": 2.49,
      "text": "That's clear, uh, thanks."
    }
  ]
}