  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.66,
      "duration_seconds": 3.37,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 10.47,
      "duration_seconds": 4.56,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 20.57,
      "duration_seconds": 8.36,
      "text": "yeah, it's sudden severe pain in the lower tummy i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 25.6,
      "duration_seconds": 4.43,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 35.83,
      "duration_seconds": 2.23,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.49,
      "end_seconds": 55.47,
      "duration_seconds": 7.98,
      "text": "Okay: temperature 36.7, blood pressure 102 over 60. And SpO2 97 percent on room air, pulse 96."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.61,
      "end_seconds": 59.21,
      "duration_seconds": 2.6,
      "text": "Oh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.71,
      "end_seconds": 67.26,
      "duration_seconds": 7.55,
      "text": "Don't worry, we'll discuss it in a second. Alright, how long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.82,
      "end_seconds": 70.94,
      "duration_seconds": 3.12,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 75.45,
      "duration_seconds": 2.73,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.23,
      "end_seconds": 79.5,
      "duration_seconds": 3.27,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.08,
      "end_seconds": 84.6,
      "duration_seconds": 3.52,
      "text": "What about collapsing, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.52,
      "end_seconds": 87.47,
      "duration_seconds": 1.95,
      "text": "mm, um, yes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.85,
      "end_seconds": 103.55,
      "duration_seconds": 2.7,
      "text": "did you get vomiting or discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.15,
      "end_seconds": 107.71,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 111.98,
      "duration_seconds": 3.53,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.83,
      "end_seconds": 116.13,
      "duration_seconds": 3.3,
      "text": "No, um, none, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.81,
      "end_seconds": 119.83,
      "duration_seconds": 2.02,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 123.7,
      "duration_seconds": 2.27,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 127.56,
      "duration_seconds": 3.17,
      "text": "so, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.13,
      "end_seconds": 130.06,
      "duration_seconds": 1.93,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.52,
      "end_seconds": 152.47,
      "duration_seconds": 3.95,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 166.26,
      "duration_seconds": 12.51,
      "text": "It's bisoprolol, 2.5 milligrams, once a day. It's the not knowing that gets to me. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.78,
      "end_seconds": 182.12,
      "duration_seconds": 3.34,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.64,
      "end_seconds": 192.82,
      "duration_seconds": 10.18,
      "text": "I've never touched a cigarette. I hardly move around during the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 196.33,
      "duration_seconds": 2.58,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.54,
      "end_seconds": 206.06,
      "duration_seconds": 5.52,
      "text": "Ah, I have an irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.01,
      "end_seconds": 210.58,
      "duration_seconds": 3.57,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.89,
      "end_seconds": 217.06,
      "duration_seconds": 5.17,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.46,
      "end_seconds": 234.51,
      "duration_seconds": 4.05,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.46,
      "end_seconds": 237.9,
      "duration_seconds": 2.44,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 253.42,
      "duration_seconds": 14.09,
      "text": "So, based on your history, I can't pin this down yet. We're looking at a ruptured ectopic pregnancy or a ruptured ovarian cyst. I'll request a pregnancy test, it'll help with collapse."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.92,
      "end_seconds": 257.65,
      "duration_seconds": 2.73,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.98,
      "end_seconds": 269.93,
      "duration_seconds": 10.95,
      "text": "I am calling the emergency team, you need an operation now. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.59,
      "end_seconds": 273.1,
      "duration_seconds": 1.51,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.29,
      "end_seconds": 280.08,
      "duration_seconds": 5.79,
      "text": "one warning sign to remember: the symptoms get worse in that case don't wait"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.17,
      "end_seconds": 283.82,
      "duration_seconds": 1.65,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.97,
      "end_seconds": 287.39,
      "duration_seconds": 2.42,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.69,
      "end_seconds": 290.73,
      "duration_seconds": 2.04,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.57,
      "end_seconds": 297.8,
      "duration_seconds": 5.23,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.62,
      "end_seconds": 301.84,
      "duration_seconds": 3.22,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.35,
      "end_seconds": 304.62,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}