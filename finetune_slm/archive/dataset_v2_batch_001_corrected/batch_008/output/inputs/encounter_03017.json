{
  "schema_version": "1.0",
  "encounter_id": "03017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 2.99,
      "duration_seconds": 1.73,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.27,
      "end_seconds": 12.69,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.81,
      "end_seconds": 24.05,
      "duration_seconds": 10.24,
      "text": "I'm here because of bloating when I slip up. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.48,
      "end_seconds": 31.27,
      "duration_seconds": 2.79,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.08,
      "end_seconds": 39.01,
      "duration_seconds": 5.93,
      "text": "Probably about a month. Yeah. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.07,
      "end_seconds": 50.65,
      "duration_seconds": 10.58,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 66.72,
      "duration_seconds": 14.38,
      "text": "Only avoiding gluten, and it's not much. I'd give it a eight, out of ten. Gluten definitely sets it off. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.89,
      "end_seconds": 69.1,
      "duration_seconds": 1.21,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.04,
      "end_seconds": 72.48,
      "duration_seconds": 1.44,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.92,
      "end_seconds": 82.79,
      "duration_seconds": 3.87,
      "text": "And what about weight loss or bone pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.02,
      "end_seconds": 87.48,
      "duration_seconds": 3.46,
      "text": "Ah, no, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.89,
      "end_seconds": 92.5,
      "duration_seconds": 3.61,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.6,
      "end_seconds": 94.65,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.02,
      "end_seconds": 110.38,
      "duration_seconds": 4.36,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.36,
      "end_seconds": 123.83,
      "duration_seconds": 12.47,
      "text": "Yes, I work in a bakery, early starts. My husband and I live above the shop. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.55,
      "end_seconds": 130.49,
      "duration_seconds": 4.94,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.48,
      "end_seconds": 134.36,
      "duration_seconds": 2.88,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.56,
      "end_seconds": 138.08,
      "duration_seconds": 2.52,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.05,
      "end_seconds": 142.53,
      "duration_seconds": 3.48,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.41,
      "end_seconds": 145.56,
      "duration_seconds": 2.15,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.08,
      "end_seconds": 149.53,
      "duration_seconds": 2.45,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.98,
      "end_seconds": 160.86,
      "duration_seconds": 2.88,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.14,
      "end_seconds": 175.94,
      "duration_seconds": 2.8,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.27,
      "end_seconds": 204.86,
      "duration_seconds": 7.59,
      "text": "Okay: blood pressure 110 over 69, pulse is 68 beats a minute, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.93,
      "end_seconds": 210.03,
      "duration_seconds": 4.1,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.29,
      "end_seconds": 214.07,
      "duration_seconds": 2.78,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.11,
      "end_seconds": 229.04,
      "duration_seconds": 4.93,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.86,
      "end_seconds": 238.29,
      "duration_seconds": 1.43,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.71,
      "end_seconds": 245.27,
      "duration_seconds": 2.56,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.06,
      "end_seconds": 266.32,
      "duration_seconds": 8.26,
      "text": "Taking everything into account, my working impression is coeliac disease on a gluten-free diet with some accidental exposure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.93,
      "end_seconds": 270.86,
      "duration_seconds": 3.93,
      "text": "Right, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.33,
      "end_seconds": 297.79,
      "duration_seconds": 24.46,
      "text": "Nothing I've seen today points to an emergency. It looks like coeliac disease on a gluten-free diet with some accidental exposure, but I'd like to confirm. I want a blood count done, that's for coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.48,
      "end_seconds": 304.21,
      "duration_seconds": 5.73,
      "text": "Yeah, um, okay, that makes sense. Thanks for explaining."
    }
  ]
}