{
  "schema_version": "1.0",
  "encounter_id": "03298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 9.95,
      "duration_seconds": 9.3,
      "text": "Sorry, uh, what was I saying, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.85,
      "end_seconds": 15.89,
      "duration_seconds": 4.04,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.61,
      "end_seconds": 20.75,
      "duration_seconds": 4.14,
      "text": "Well, I've been having flakes on my shoulders."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.73,
      "end_seconds": 25.37,
      "duration_seconds": 3.64,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.85,
      "end_seconds": 32.2,
      "duration_seconds": 5.35,
      "text": "Well, you know, for about three months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 37.02,
      "duration_seconds": 3.92,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.56,
      "end_seconds": 39.37,
      "duration_seconds": 1.81,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 41.34,
      "duration_seconds": 1.71,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.43,
      "end_seconds": 57.56,
      "duration_seconds": 15.13,
      "text": "I've had a little redness too, you know, for two months. So, I've also had an itchy scalp. About itchy scalp, it happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.79,
      "end_seconds": 66.31,
      "duration_seconds": 6.52,
      "text": "Have you had flakes on your shoulders before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 80.51,
      "duration_seconds": 9.17,
      "text": "Yes, uh, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 93.14,
      "duration_seconds": 2.47,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.97,
      "end_seconds": 106.39,
      "duration_seconds": 3.42,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.31,
      "end_seconds": 127.16,
      "duration_seconds": 7.85,
      "text": "Okay: saturation 99 percent, heart rate 69, temp 36.5 degrees, blood pressure 115 over 69."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 131.95,
      "duration_seconds": 3.72,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.47,
      "end_seconds": 135.47,
      "duration_seconds": 2.0,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 152.83,
      "duration_seconds": 4.66,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.37,
      "end_seconds": 160.33,
      "duration_seconds": 1.96,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.88,
      "end_seconds": 173.95,
      "duration_seconds": 5.07,
      "text": "Right, have you noticed rash elsewhere, hair loss or pus?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.26,
      "end_seconds": 181.75,
      "duration_seconds": 6.49,
      "text": "So, you know, no, no rash elsewhere, hair loss or pus."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.51,
      "end_seconds": 184.22,
      "duration_seconds": 1.71,
      "text": "Any sign of pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.79,
      "end_seconds": 186.4,
      "duration_seconds": 1.61,
      "text": "No pain, thankfully."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.71,
      "end_seconds": 193.58,
      "duration_seconds": 2.87,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.59,
      "end_seconds": 199.63,
      "duration_seconds": 4.04,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 205.55,
      "duration_seconds": 2.12,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.51,
      "end_seconds": 214.9,
      "duration_seconds": 7.39,
      "text": "Mm, you know, I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.91,
      "end_seconds": 220.62,
      "duration_seconds": 4.71,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.15,
      "end_seconds": 225.4,
      "duration_seconds": 3.25,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.71,
      "end_seconds": 248.63,
      "duration_seconds": 4.92,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.16,
      "end_seconds": 263.48,
      "duration_seconds": 14.32,
      "text": "I'm a bus driver, so I sit for long hours. No, I share a house with my brother. I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.28,
      "end_seconds": 268.55,
      "duration_seconds": 4.27,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.62,
      "end_seconds": 271.82,
      "duration_seconds": 2.2,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.8,
      "end_seconds": 307.08,
      "duration_seconds": 34.28,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Right, here's what I'm thinking. I don't have a clear answer today: simple dandruff is possible, and so is seborrhoeic dermatitis. We'll begin with ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. Leave the shampoo on for five minutes before rinsing. I'd like you back if not better in a month."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.65,
      "end_seconds": 312.02,
      "duration_seconds": 3.37,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.12,
      "end_seconds": 319.56,
      "duration_seconds": 4.44,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.43,
      "end_seconds": 323.13,
      "duration_seconds": 1.7,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.44,
      "end_seconds": 329.17,
      "duration_seconds": 1.73,
      "text": "Okay, look after yourself."
    }
  ]
}