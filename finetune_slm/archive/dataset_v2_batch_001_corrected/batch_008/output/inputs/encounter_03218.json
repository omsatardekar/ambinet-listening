  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 5.3,
      "duration_seconds": 4.14,
      "text": "good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.63,
      "end_seconds": 11.79,
      "duration_seconds": 5.16,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.4,
      "end_seconds": 18.67,
      "duration_seconds": 6.27,
      "text": "hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.01,
      "end_seconds": 25.31,
      "duration_seconds": 5.3,
      "text": "Of course, please stay. It's helpful to to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.87,
      "end_seconds": 30.91,
      "duration_seconds": 5.04,
      "text": "Um, um, so... a limp. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.81,
      "end_seconds": 34.7,
      "duration_seconds": 2.89,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.69,
      "end_seconds": 38.5,
      "duration_seconds": 2.81,
      "text": "it's been three weeks now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.45,
      "end_seconds": 45.11,
      "duration_seconds": 4.66,
      "text": "okay give me more detail on it whatever comes to mind"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.35,
      "end_seconds": 52.31,
      "duration_seconds": 5.96,
      "text": "Only a stick, and it's not much. I'd call it it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.16,
      "end_seconds": 57.46,
      "duration_seconds": 4.3,
      "text": "any pain in your groin and hip as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.2,
      "end_seconds": 70.4,
      "duration_seconds": 12.2,
      "text": "Yes, about the same, two days. As for pain in my groin and hip, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 71.88,
      "duration_seconds": 0.96,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.27,
      "end_seconds": 83.78,
      "duration_seconds": 2.51,
      "text": "Any numbness, fever or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.86,
      "end_seconds": 88.33,
      "duration_seconds": 2.47,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.56,
      "end_seconds": 90.5,
      "duration_seconds": 1.94,
      "text": "Yes. What about fall?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.4,
      "end_seconds": 94.89,
      "duration_seconds": 2.49,
      "text": "not at all, no fall"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.56,
      "end_seconds": 99.12,
      "duration_seconds": 2.56,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.85,
      "end_seconds": 103.95,
      "duration_seconds": 3.1,
      "text": "yeah, no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.03,
      "end_seconds": 108.78,
      "duration_seconds": 2.75,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.58,
      "end_seconds": 111.85,
      "duration_seconds": 2.27,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.88,
      "end_seconds": 118.42,
      "duration_seconds": 4.54,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.25,
      "end_seconds": 123.6,
      "duration_seconds": 3.35,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.04,
      "end_seconds": 126.69,
      "duration_seconds": 1.65,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.61,
      "end_seconds": 132.64,
      "duration_seconds": 4.03,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.44,
      "end_seconds": 135.67,
      "duration_seconds": 2.23,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.51,
      "end_seconds": 139.85,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.03,
      "end_seconds": 143.76,
      "duration_seconds": 2.73,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 151.97,
      "duration_seconds": 5.3,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.56,
      "end_seconds": 156.01,
      "duration_seconds": 3.45,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.31,
      "end_seconds": 160.66,
      "duration_seconds": 3.35,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.25,
      "end_seconds": 170.36,
      "duration_seconds": 8.11,
      "text": "anything in your past medical history I should know? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.95,
      "end_seconds": 176.98,
      "duration_seconds": 5.03,
      "text": "I've had arthritis in my knees for about ten years now"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.66,
      "end_seconds": 183.7,
      "duration_seconds": 1.04,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.13,
      "end_seconds": 192.51,
      "duration_seconds": 1.38,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.86,
      "end_seconds": 195.78,
      "duration_seconds": 1.92,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.32,
      "end_seconds": 212.41,
      "duration_seconds": 3.09,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.8,
      "end_seconds": 216.93,
      "duration_seconds": 3.13,
      "text": "Um my son has asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.26,
      "end_seconds": 221.88,
      "duration_seconds": 3.62,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.92,
      "end_seconds": 231.83,
      "duration_seconds": 8.91,
      "text": "Diclofenac, 50 milligrams, when needed. I'm on something called para... paracetamol, 1 gram, maybe, four times a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.05,
      "end_seconds": 237.49,
      "duration_seconds": 4.44,
      "text": "did you happen to to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.37,
      "end_seconds": 242.45,
      "duration_seconds": 4.08,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.53,
      "end_seconds": 247.65,
      "duration_seconds": 3.12,
      "text": "Let's start with the the basic checks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.1,
      "end_seconds": 256.98,
      "duration_seconds": 2.88,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.33,
      "end_seconds": 286.91,
      "duration_seconds": 8.58,
      "text": "okay: pulse is 80 beats a minute, temperature is 36.5 degrees, BP is 116 over 76."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.85,
      "end_seconds": 289.26,
      "duration_seconds": 1.41,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.95,
      "end_seconds": 293.29,
      "duration_seconds": 3.34,
      "text": "We'll look at it it together shortly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.8,
      "end_seconds": 299.43,
      "duration_seconds": 3.63,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.29,
      "end_seconds": 304.22,
      "duration_seconds": 2.93,
      "text": "Okay raise your arm for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.92,
      "end_seconds": 319.02,
      "duration_seconds": 6.1,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.08,
      "end_seconds": 332.57,
      "duration_seconds": 9.49,
      "text": "please sit back down. From what you've told me and what I found, the most likely explanation is hip osteoarthritis"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.67,
      "end_seconds": 340.6,
      "duration_seconds": 2.93,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.35,
      "end_seconds": 353.66,
      "duration_seconds": 12.31,
      "text": "it's reasonable to be concerned, but right now hip osteoarthritis is my leading thought, not anything worse. We should do an X-ray of the hips for hip pain"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.33,
      "end_seconds": 355.44,
      "duration_seconds": 1.11,
      "text": "mm alright"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.32,
      "end_seconds": 366.31,
      "duration_seconds": 8.99,
      "text": "use a walking stick in the left hand and do gentle strengthening exercises i think the orthopaedic clinic should see you too"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.15,
      "end_seconds": 368.64,
      "duration_seconds": 1.49,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.97,
      "end_seconds": 382.03,
      "duration_seconds": 9.06,
      "text": "and please bring the latest prescription or the medicine boxes to the the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.66,
      "end_seconds": 386.96,
      "duration_seconds": 3.3,
      "text": "I know what to watch for"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.83,
      "end_seconds": 393.42,
      "duration_seconds": 5.59,
      "text": "come back or go to emergency straight away if the the symptoms get worse"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.02,
      "end_seconds": 396.55,
      "duration_seconds": 1.53,
      "text": "alright I follow"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.64,
      "end_seconds": 404.72,
      "duration_seconds": 7.08,
      "text": "let's plan a check in six weeks that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.61,
      "end_seconds": 409.38,
      "duration_seconds": 3.77,
      "text": "Right I'll do that. Thank you doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.2,
      "end_seconds": 412.59,
      "duration_seconds": 2.39,
      "text": "alright, have a good day"
    }
  ]
