{
  "schema_version": "1.0",
  "encounter_id": "03286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 3.13,
      "duration_seconds": 2.47,
      "text": "Good morning, grab a a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.96,
      "end_seconds": 10.0,
      "duration_seconds": 5.04,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.28,
      "end_seconds": 16.99,
      "duration_seconds": 5.71,
      "text": "Please do. Extra information is always welcome. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.54,
      "end_seconds": 28.71,
      "duration_seconds": 10.17,
      "text": "honestly, it's darker skin, and my family pushed me to come my neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 32.75,
      "duration_seconds": 3.15,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.54,
      "end_seconds": 37.28,
      "duration_seconds": 2.74,
      "text": "I've had it since last weekend"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.16,
      "end_seconds": 40.61,
      "duration_seconds": 2.45,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 44.8,
      "duration_seconds": 2.7,
      "text": "about a six out of ten"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.32,
      "end_seconds": 51.96,
      "duration_seconds": 6.64,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 52.06,
      "end_seconds": 58.09,
      "duration_seconds": 6.03,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.46,
      "end_seconds": 64.94,
      "duration_seconds": 2.48,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.85,
      "end_seconds": 70.02,
      "duration_seconds": 4.17,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.53,
      "end_seconds": 81.71,
      "duration_seconds": 10.18,
      "text": "As for dizziness on standing, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.59,
      "end_seconds": 87.81,
      "duration_seconds": 5.22,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.47,
      "end_seconds": 92.86,
      "duration_seconds": 3.39,
      "text": "mostly moderate. It's every other day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 94.18,
      "end_seconds": 96.14,
      "duration_seconds": 1.96,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.32,
      "end_seconds": 99.33,
      "duration_seconds": 2.01,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.0,
      "end_seconds": 102.56,
      "duration_seconds": 1.56,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.5,
      "end_seconds": 107.75,
      "duration_seconds": 4.25,
      "text": "Any severe tummy pain, fainting or vomiting at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.34,
      "end_seconds": 120.08,
      "duration_seconds": 11.74,
      "text": "no, no severe tummy pain, no fainting, no vomiting i was feeling tired and weak at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.2,
      "end_seconds": 125.57,
      "duration_seconds": 4.37,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.96,
      "end_seconds": 129.81,
      "duration_seconds": 2.85,
      "text": "No, that that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 144.93,
      "duration_seconds": 4.42,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.12,
      "end_seconds": 153.63,
      "duration_seconds": 3.51,
      "text": "I have gout. Depression, for two years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.29,
      "end_seconds": 156.83,
      "duration_seconds": 1.54,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.38,
      "end_seconds": 161.44,
      "duration_seconds": 4.06,
      "text": "I have thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.24,
      "end_seconds": 170.58,
      "duration_seconds": 7.34,
      "text": "Understood. Yes, gout is known to us, good to have that clear. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.11,
      "end_seconds": 175.64,
      "duration_seconds": 3.53,
      "text": "Allopurinol, 100 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.61,
      "end_seconds": 181.16,
      "duration_seconds": 4.55,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.47,
      "end_seconds": 189.75,
      "duration_seconds": 7.28,
      "text": "I mean, no, it's at home. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.67,
      "end_seconds": 200.84,
      "duration_seconds": 10.17,
      "text": "Erm, doctor, I think the last prescription for the alendronate was 140 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.91,
      "end_seconds": 208.66,
      "duration_seconds": 5.75,
      "text": "okay have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.34,
      "end_seconds": 213.88,
      "duration_seconds": 4.54,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.83,
      "end_seconds": 229.85,
      "duration_seconds": 4.02,
      "text": "So, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.54,
      "end_seconds": 237.78,
      "duration_seconds": 7.24,
      "text": "my father has Parkinson's disease. Uh, my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.46,
      "end_seconds": 242.1,
      "duration_seconds": 1.64,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.34,
      "end_seconds": 247.18,
      "duration_seconds": 3.84,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.38,
      "end_seconds": 253.22,
      "duration_seconds": 4.84,
      "text": "can I check a a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.91,
      "end_seconds": 264.3,
      "duration_seconds": 2.39,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.13,
      "end_seconds": 318.71,
      "duration_seconds": 35.58,
      "text": "Okay: BMI works out to 24.0, height 186 centimetres, pulse is 100 beats a minute. And pressure 101 over 65, SpO2 97 percent on room air, weight 83 kilos. So, based on your history, it fits best with possible adrenal insufficiency. Another possibility is an underactive thyroid. Blood tests is what I'd like next, for possible adrenal insufficiency. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 319.44,
      "end_seconds": 323.16,
      "duration_seconds": 3.72,
      "text": "I can book that for Friday at 3:30 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.37,
      "end_seconds": 347.79,
      "duration_seconds": 23.42,
      "text": "We should do a short synacthen test for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'll also refer you to the endocrine clinic. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.69,
      "end_seconds": 352.46,
      "duration_seconds": 2.77,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.22,
      "end_seconds": 362.56,
      "duration_seconds": 9.34,
      "text": "one warning sign to remember: the symptoms get worse. In that case don't wait. See me again after the results"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.31,
      "end_seconds": 365.01,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.23,
      "end_seconds": 369.44,
      "duration_seconds": 3.21,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 373.91,
      "end_seconds": 377.04,
      "duration_seconds": 3.13,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.57,
      "end_seconds": 381.87,
      "duration_seconds": 1.3,
      "text": "Goodbye for now."
    }
  ]
}