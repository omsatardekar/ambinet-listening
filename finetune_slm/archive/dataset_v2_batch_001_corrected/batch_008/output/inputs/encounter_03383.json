{
  "schema_version": "1.0",
  "encounter_id": "03383",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 4.62,
      "duration_seconds": 3.89,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.19,
      "end_seconds": 8.89,
      "duration_seconds": 3.7,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.55,
      "end_seconds": 16.7,
      "duration_seconds": 2.15,
      "text": "It's blurred vision, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.75,
      "end_seconds": 20.02,
      "duration_seconds": 2.27,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.95,
      "end_seconds": 23.58,
      "duration_seconds": 2.63,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.84,
      "end_seconds": 27.8,
      "duration_seconds": 3.96,
      "text": "Hm, okay. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.65,
      "end_seconds": 31.55,
      "duration_seconds": 1.9,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.64,
      "end_seconds": 37.81,
      "duration_seconds": 5.17,
      "text": "Any a splash of cleaning fluid in your eye as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.59,
      "end_seconds": 47.72,
      "duration_seconds": 8.13,
      "text": "Yes, um, for one week. With splash of cleaning fluid in my eye, mostly moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.44,
      "end_seconds": 54.92,
      "duration_seconds": 5.48,
      "text": "Have you had blurred vision before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.79,
      "end_seconds": 61.12,
      "duration_seconds": 5.33,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.06,
      "end_seconds": 66.98,
      "duration_seconds": 3.92,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.19,
      "end_seconds": 70.27,
      "duration_seconds": 2.08,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.92,
      "end_seconds": 74.72,
      "duration_seconds": 3.8,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 87.26,
      "duration_seconds": 11.25,
      "text": "Yeah, um, I've got COPD. I've been putting this off for weeks. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.91,
      "end_seconds": 90.8,
      "duration_seconds": 2.89,
      "text": "Alright, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.1,
      "end_seconds": 98.45,
      "duration_seconds": 6.35,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.81,
      "end_seconds": 111.98,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.79,
      "end_seconds": 119.49,
      "duration_seconds": 5.7,
      "text": "Yeah, I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 123.52,
      "duration_seconds": 2.73,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.43,
      "end_seconds": 126.5,
      "duration_seconds": 2.07,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.13,
      "end_seconds": 132.13,
      "duration_seconds": 4.0,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.65,
      "end_seconds": 135.87,
      "duration_seconds": 3.22,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.07,
      "end_seconds": 155.59,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.36,
      "end_seconds": 160.08,
      "duration_seconds": 3.72,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.32,
      "end_seconds": 167.08,
      "duration_seconds": 2.76,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.27,
      "end_seconds": 172.01,
      "duration_seconds": 3.74,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.99,
      "end_seconds": 175.09,
      "duration_seconds": 2.1,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 179.74,
      "duration_seconds": 3.88,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.59,
      "end_seconds": 199.83,
      "duration_seconds": 4.24,
      "text": "Alright, and what about both eyes or head injury?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.35,
      "end_seconds": 204.47,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.87,
      "end_seconds": 209.3,
      "duration_seconds": 4.43,
      "text": "I follow. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.09,
      "end_seconds": 214.47,
      "duration_seconds": 4.38,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.13,
      "end_seconds": 222.14,
      "duration_seconds": 4.01,
      "text": "Right, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.17,
      "end_seconds": 237.23,
      "duration_seconds": 3.06,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.12,
      "end_seconds": 264.95,
      "duration_seconds": 7.83,
      "text": "Okay: BP is 123 over 82, heart rate 83. And oxygen saturation is 98 percent, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.4,
      "end_seconds": 271.37,
      "duration_seconds": 3.97,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.89,
      "end_seconds": 274.72,
      "duration_seconds": 2.83,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.24,
      "end_seconds": 277.64,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.62,
      "end_seconds": 293.8,
      "duration_seconds": 7.18,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.63,
      "end_seconds": 297.02,
      "duration_seconds": 1.39,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.35,
      "end_seconds": 318.46,
      "duration_seconds": 17.11,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this looks most like an alkali chemical burn to the eye. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.03,
      "end_seconds": 321.74,
      "duration_seconds": 2.71,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.32,
      "end_seconds": 344.72,
      "duration_seconds": 19.4,
      "text": "I can't promise yet, but most people with an alkali chemical burn to the eye do well once it's treated properly. Let me just check I've got this right. You've had blurred vision for two days, moderate, and no both eyes or head injury."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.49,
      "end_seconds": 349.44,
      "duration_seconds": 2.95,
      "text": "Actually, that's what happened, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.67,
      "end_seconds": 355.86,
      "duration_seconds": 5.19,
      "text": "I'm sending you for an urgent pH check because of chemical burn."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 357.43,
      "end_seconds": 359.97,
      "duration_seconds": 2.54,
      "text": "The earliest is Monday, 9 am."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.54,
      "end_seconds": 363.72,
      "duration_seconds": 2.18,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.17,
      "end_seconds": 377.97,
      "duration_seconds": 12.8,
      "text": "I'm sending you for an urgent eye assessment because of chemical eye injury. I'll start you on sterile saline irrigation, 2 litres, continuous, until pH neutral. That's for chemical eye burn."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.9,
      "end_seconds": 379.97,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.83,
      "end_seconds": 404.26,
      "duration_seconds": 22.43,
      "text": "I am washing the eye now, keep it open and do not stop. Cut down on salt and fried food for now, it really does make a difference. I'm going to send a referral to the eye emergency service. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.83,
      "end_seconds": 412.33,
      "duration_seconds": 3.5,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.75,
      "end_seconds": 415.01,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}