  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 5.96,
      "duration_seconds": 4.86,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.43,
      "end_seconds": 11.44,
      "duration_seconds": 4.01,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.11,
      "end_seconds": 19.46,
      "duration_seconds": 5.35,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.3,
      "end_seconds": 25.35,
      "duration_seconds": 5.05,
      "text": "Doctor, it's dizziness on standing. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.84,
      "end_seconds": 29.86,
      "duration_seconds": 3.02,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.98,
      "end_seconds": 41.63,
      "duration_seconds": 3.65,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.17,
      "end_seconds": 71.7,
      "duration_seconds": 15.53,
      "text": "okay: BP is 101 over 63, SpO2 99 percent on room air, height 181 centimetres, temperature is 37.0 degrees, BMI works out to 16.2, heart rate 92, respiratory rate 18, weight 53 kilos"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.29,
      "end_seconds": 77.67,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.31,
      "end_seconds": 83.99,
      "duration_seconds": 4.68,
      "text": "I'll come back to the numbers when did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.72,
      "end_seconds": 89.93,
      "duration_seconds": 4.21,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.86,
      "end_seconds": 94.74,
      "duration_seconds": 2.88,
      "text": "Is it it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.57,
      "end_seconds": 98.74,
      "duration_seconds": 2.17,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 103.44,
      "duration_seconds": 3.51,
      "text": "is it bearing on you a a lot?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.01,
      "end_seconds": 106.48,
      "duration_seconds": 1.47,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.37,
      "end_seconds": 109.38,
      "duration_seconds": 2.01,
      "text": "have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.09,
      "end_seconds": 124.93,
      "duration_seconds": 13.84,
      "text": "Okay, so yes, standing. That makes it worse. I've also had darker skin. Oh, and craving salt. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 137.01,
      "duration_seconds": 4.04,
      "text": "Any fever, vomiting, fainting or severe tummy pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.14,
      "end_seconds": 140.82,
      "duration_seconds": 2.68,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.39,
      "end_seconds": 146.87,
      "duration_seconds": 4.48,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.59,
      "end_seconds": 149.55,
      "duration_seconds": 1.96,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 153.58,
      "duration_seconds": 2.37,
      "text": "So, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.57,
      "end_seconds": 155.68,
      "duration_seconds": 1.11,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.17,
      "end_seconds": 178.36,
      "duration_seconds": 8.19,
      "text": "Do you take any prescribed or over-the-counter medicines? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.38,
      "end_seconds": 182.92,
      "duration_seconds": 3.54,
      "text": "okay, so I take tamsulosin, at night"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.66,
      "end_seconds": 185.66,
      "duration_seconds": 2.0,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.62,
      "end_seconds": 189.86,
      "duration_seconds": 2.24,
      "text": "it's 0.4 milligrams"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.81,
      "end_seconds": 194.03,
      "duration_seconds": 2.22,
      "text": "when did you start it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.71,
      "end_seconds": 197.84,
      "duration_seconds": 2.13,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.84,
      "end_seconds": 204.62,
      "duration_seconds": 4.78,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.82,
      "end_seconds": 208.81,
      "duration_seconds": 2.99,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.54,
      "end_seconds": 212.59,
      "duration_seconds": 3.05,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.51,
      "end_seconds": 217.88,
      "duration_seconds": 4.37,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.87,
      "end_seconds": 221.06,
      "duration_seconds": 2.19,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.97,
      "end_seconds": 227.43,
      "duration_seconds": 4.46,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.26,
      "end_seconds": 231.94,
      "duration_seconds": 3.68,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 237.22,
      "duration_seconds": 3.71,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 240.56,
      "duration_seconds": 2.41,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.23,
      "end_seconds": 244.79,
      "duration_seconds": 3.56,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.28,
      "end_seconds": 250.31,
      "duration_seconds": 4.03,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.14,
      "end_seconds": 254.13,
      "duration_seconds": 1.99,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.63,
      "end_seconds": 255.51,
      "duration_seconds": 0.88,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.08,
      "end_seconds": 259.92,
      "duration_seconds": 2.84,
      "text": "I've had heart disease, yes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.04,
      "end_seconds": 266.18,
      "duration_seconds": 5.14,
      "text": "I'd like to to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.68,
      "end_seconds": 269.71,
      "duration_seconds": 2.03,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.89,
      "end_seconds": 292.38,
      "duration_seconds": 9.49,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.31,
      "end_seconds": 299.22,
      "duration_seconds": 2.91,
      "text": "so, you can sit up now"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.73,
      "end_seconds": 311.14,
      "duration_seconds": 4.41,
      "text": "taking everything into account, my working impression is possible adrenal insufficiency"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.87,
      "end_seconds": 315.98,
      "duration_seconds": 3.11,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.08,
      "end_seconds": 353.54,
      "duration_seconds": 35.46,
      "text": "nothing I've seen today points to an emergency it looks like possible adrenal insufficiency, but I'd like to confirm. A short synacthen test is what I'd like next, for possible adrenal insufficiency drink fluids and eat salty foods until the results, and come in if you vomit i'll also refer you to the endocrine clinic we'll catch up after the results tell me what you've taken from all that, so I can fill in any gaps"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.02,
      "end_seconds": 360.62,
      "duration_seconds": 5.6,
      "text": "so, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.43,
      "end_seconds": 366.09,
      "duration_seconds": 3.66,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.91,
      "end_seconds": 369.94,
      "duration_seconds": 3.03,
      "text": "thank you, um, doctor, goodbye"
    }
  ]
}