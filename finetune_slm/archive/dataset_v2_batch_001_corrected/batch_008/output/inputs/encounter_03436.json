  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 6.35,
      "duration_seconds": 5.15,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.55,
      "end_seconds": 11.54,
      "duration_seconds": 3.99,
      "text": "So, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.47,
      "end_seconds": 14.64,
      "duration_seconds": 2.17,
      "text": "Right, where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.63,
      "end_seconds": 20.19,
      "duration_seconds": 4.56,
      "text": "so, I've been feeling tired and weak, doctor"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.86,
      "end_seconds": 23.7,
      "duration_seconds": 1.84,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.45,
      "end_seconds": 28.48,
      "duration_seconds": 3.03,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.86,
      "end_seconds": 33.13,
      "duration_seconds": 3.27,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.89,
      "end_seconds": 50.49,
      "duration_seconds": 12.6,
      "text": "let me think, a six out of ten, I suppose so, I did have darker skin at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.92,
      "end_seconds": 71.07,
      "duration_seconds": 4.15,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.05,
      "end_seconds": 76.27,
      "duration_seconds": 3.22,
      "text": "Mm, I've had gout, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.69,
      "end_seconds": 78.55,
      "duration_seconds": 0.86,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.51,
      "end_seconds": 82.35,
      "duration_seconds": 2.84,
      "text": "Acid reflux, for two years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.34,
      "end_seconds": 99.02,
      "duration_seconds": 11.68,
      "text": "Yes, carry on. Right, so gout and acid reflux are already on your record. We'll keep that in mind today. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.79,
      "end_seconds": 111.13,
      "duration_seconds": 10.34,
      "text": "I'm on febuxostat, 80 milligrams, once a day for the gout it's omeprazole, 20 milligrams, once a day"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 115.18,
      "duration_seconds": 2.4,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.26,
      "end_seconds": 121.75,
      "duration_seconds": 4.49,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.16,
      "end_seconds": 128.54,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.21,
      "end_seconds": 135.87,
      "duration_seconds": 6.66,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.35,
      "end_seconds": 139.23,
      "duration_seconds": 1.88,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.29,
      "end_seconds": 145.42,
      "duration_seconds": 4.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.19,
      "end_seconds": 163.57,
      "duration_seconds": 4.38,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.56,
      "end_seconds": 168.41,
      "duration_seconds": 2.85,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.4,
      "end_seconds": 174.18,
      "duration_seconds": 3.78,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.47,
      "end_seconds": 179.45,
      "duration_seconds": 3.98,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.0,
      "end_seconds": 185.25,
      "duration_seconds": 4.25,
      "text": "A few quick ones: fainting, severe tummy pain or vomiting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.26,
      "end_seconds": 195.16,
      "duration_seconds": 4.9,
      "text": "Ah, no, no fainting, severe tummy pain or vomiting."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.61,
      "end_seconds": 199.04,
      "duration_seconds": 2.43,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.56,
      "end_seconds": 201.22,
      "duration_seconds": 1.66,
      "text": "no, no fever"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 207.21,
      "duration_seconds": 4.89,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.9,
      "end_seconds": 210.48,
      "duration_seconds": 2.58,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 214.31,
      "duration_seconds": 2.81,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.03,
      "end_seconds": 220.9,
      "duration_seconds": 1.87,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 226.34,
      "duration_seconds": 3.9,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.35,
      "end_seconds": 239.24,
      "duration_seconds": 2.89,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.35,
      "end_seconds": 256.34,
      "duration_seconds": 6.99,
      "text": "Okay: SpO2 96 percent on room air, temperature 37.0, BP is 96 over 63, pulse 112."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.0,
      "end_seconds": 258.56,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 263.03,
      "duration_seconds": 2.71,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.83,
      "end_seconds": 268.6,
      "duration_seconds": 3.77,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.65,
      "end_seconds": 283.27,
      "duration_seconds": 1.62,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.31,
      "end_seconds": 286.39,
      "duration_seconds": 2.08,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.18,
      "end_seconds": 306.91,
      "duration_seconds": 10.73,
      "text": "the creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.88,
      "end_seconds": 327.31,
      "duration_seconds": 14.43,
      "text": "Good, you can sit up again. Okay, so so my impression is this: It points towards possible adrenal insufficiency. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.61,
      "end_seconds": 330.63,
      "duration_seconds": 2.02,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.37,
      "end_seconds": 352.15,
      "duration_seconds": 19.78,
      "text": "It's reasonable to be concerned, but right now possible adrenal insufficiency is my leading thought, not anything worse. I'd like to arrange a short synacthen test for possible adrenal insufficiency. I think blood tests makes sense here, for possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.14,
      "end_seconds": 356.56,
      "duration_seconds": 3.42,
      "text": "mm, how long will it take?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.77,
      "end_seconds": 378.75,
      "duration_seconds": 20.98,
      "text": "Drink fluids and eat salty foods until the results, and come in if you vomit. I'm going to send a referral to the endocrine clinic. If it hasn't settled next month, we'd think about a morning cortisol, but not now. Book a review after the results. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.62,
      "end_seconds": 383.06,
      "duration_seconds": 3.44,
      "text": "Alright, uh, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.01,
      "end_seconds": 386.19,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
