      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.63,
      "end_seconds": 269.68,
      "duration_seconds": 3.05,
      "text": "I live with my elderly mother"
