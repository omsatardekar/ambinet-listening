      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.5,
      "end_seconds": 58.47,
      "duration_seconds": 14.97,
      "text": "I take tamsulosin, 0.4 milligrams, at night for the prostate. Seretide inhaler. I take it twice a day for my asthma. Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.8,
      "end_seconds": 59.75,
      "duration_seconds": 0.95,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.22,
      "end_seconds": 71.24,
      "duration_seconds": 2.02,
      "text": "Okay, since when exactly?"
