      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.54,
      "end_seconds": 28.91,
      "duration_seconds": 4.37,
      "text": "No I came last year for something else."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.06,
      "end_seconds": 31.87,
      "duration_seconds": 1.81,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.44,
      "end_seconds": 38.49,
      "duration_seconds": 6.05,
      "text": "Um so... sudden breathlessness five days after surgery. That's why I came."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.29,
      "end_seconds": 42.93,
      "duration_seconds": 3.64,
      "text": "are you taking anything regularly including from the pharmacy?"
