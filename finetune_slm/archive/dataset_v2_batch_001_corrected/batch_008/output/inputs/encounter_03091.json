      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.44,
      "end_seconds": 135.64,
      "duration_seconds": 4.2,
      "text": "any wound problem, fever or coughing up blood at all?"
