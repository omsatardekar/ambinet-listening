    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.74,
      "end_seconds": 265.77,
      "duration_seconds": 3.03,
      "text": "are you on your own at home?"
