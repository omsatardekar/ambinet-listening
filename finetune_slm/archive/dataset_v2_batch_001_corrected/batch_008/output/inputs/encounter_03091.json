    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.87,
      "end_seconds": 289.18,
      "duration_seconds": 4.31,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.21,
      "end_seconds": 303.62,
      "duration_seconds": 2.41,
      "text": "Okay this won't take long..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.64,
      "end_seconds": 328.77,
      "duration_seconds": 11.13,
      "text": "Okay: respiratory rate 23, oxygen saturation is 89 percent, BP is 120 over 73. And And temperature is 36.8 degrees, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.08,
      "end_seconds": 333.1,
      "duration_seconds": 2.02,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.13,
      "end_seconds": 336.58,
      "duration_seconds": 2.45,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.16,
      "end_seconds": 353.05,
      "duration_seconds": 4.89,
      "text": "Your left calf is swollen and tender and your oxygen is low."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.73,
      "end_seconds": 391.42,
      "duration_seconds": 35.69,
      "text": "please sit back down let me tell you where I've got to i think we're dealing with a possible blood clot in the lung after surgery at this stage we shouldn't forget a a chest infection we should do a D-dimer for possible clot i'm sending you for a CT pulmonary angiogram because of possible pulmonary embolus i'll start you on enoxaparin, 1.5 mg per kg, once now, single dose that's for possible clot"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.39,
      "end_seconds": 396.28,
      "duration_seconds": 3.89,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.01,
      "end_seconds": 409.05,
      "duration_seconds": 11.04,
      "text": "please go to hospital now, I will call ahead we'll catch up straight away right, that's the plan do you want to ask me anything?"
    },
