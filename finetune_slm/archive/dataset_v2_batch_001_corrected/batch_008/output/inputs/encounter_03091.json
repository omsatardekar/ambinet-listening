    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.34,
      "end_seconds": 274.22,
      "duration_seconds": 2.88,
      "text": "Okay, have you got any known allergies?"
