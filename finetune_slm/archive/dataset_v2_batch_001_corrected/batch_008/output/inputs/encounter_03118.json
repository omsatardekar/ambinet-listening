{
  "schema_version": "1.0",
  "encounter_id": "03118",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 2.7,
      "duration_seconds": 1.83,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.53,
      "end_seconds": 6.87,
      "duration_seconds": 2.34,
      "text": "Hello, uh, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.05,
      "end_seconds": 13.34,
      "duration_seconds": 3.29,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.9,
      "end_seconds": 22.33,
      "duration_seconds": 7.43,
      "text": "It's a high sugar test in pregnancy. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.22,
      "end_seconds": 27.36,
      "duration_seconds": 3.14,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.89,
      "end_seconds": 35.86,
      "duration_seconds": 2.97,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.84,
      "end_seconds": 41.97,
      "duration_seconds": 4.13,
      "text": "So, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.17,
      "end_seconds": 46.45,
      "duration_seconds": 3.28,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.2,
      "end_seconds": 51.04,
      "duration_seconds": 2.84,
      "text": "Has there been no symptoms too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.89,
      "end_seconds": 67.62,
      "duration_seconds": 15.73,
      "text": "Mm, uh, yes. About no symptoms, I'd give it a four, out of ten. I had a big baby on the scan before. That's settled now, um, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.78,
      "end_seconds": 75.58,
      "duration_seconds": 6.8,
      "text": "Have you had a high sugar test in pregnancy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 84.53,
      "duration_seconds": 7.81,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.24,
      "end_seconds": 87.94,
      "duration_seconds": 2.7,
      "text": "Have you had any blurred vision?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.55,
      "end_seconds": 91.5,
      "duration_seconds": 1.95,
      "text": "Definitely no blurred vision."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.47,
      "end_seconds": 100.27,
      "duration_seconds": 6.8,
      "text": "Have you had any passing a lot of urine, reduced baby movements or thirst?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.91,
      "end_seconds": 110.63,
      "duration_seconds": 8.72,
      "text": "No passing a lot of urine, reduced baby movements or thirst, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.65,
      "end_seconds": 113.94,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.0,
      "end_seconds": 117.33,
      "duration_seconds": 2.33,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.94,
      "end_seconds": 119.91,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.23,
      "end_seconds": 137.35,
      "duration_seconds": 15.12,
      "text": "Actually, I have arthritis in my knees, for about a year. I'd rather not end up on lots of tablets if I can avoid it. I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.48,
      "end_seconds": 149.97,
      "duration_seconds": 7.49,
      "text": "Alright, arthritis in your knees, that matches what I have here. Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.03,
      "end_seconds": 154.44,
      "duration_seconds": 3.41,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.44,
      "end_seconds": 158.76,
      "duration_seconds": 2.32,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.35,
      "end_seconds": 164.1,
      "duration_seconds": 4.75,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.21,
      "end_seconds": 175.32,
      "duration_seconds": 2.11,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.82,
      "end_seconds": 186.5,
      "duration_seconds": 10.68,
      "text": "I take alendronate, 70 milligrams, once a week. I mean, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.29,
      "duration_seconds": 2.06,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.4,
      "end_seconds": 206.81,
      "duration_seconds": 6.41,
      "text": "Ah, yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.4,
      "end_seconds": 212.47,
      "duration_seconds": 4.07,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.19,
      "end_seconds": 219.17,
      "duration_seconds": 5.98,
      "text": "Ah, my father has Parkinson's disease. My son has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 220.4,
      "end_seconds": 235.64,
      "duration_seconds": 15.24,
      "text": "Doctor, I've got the readings for you. Heart rate 67, weight 53 kilos, temperature 36.4. Height 179 centimetres, blood pressure 126 over 69, respiratory rate 16, BMI works out to 16.5."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.44,
      "end_seconds": 237.14,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 243.51,
      "duration_seconds": 3.74,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.45,
      "end_seconds": 245.67,
      "duration_seconds": 1.22,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.53,
      "end_seconds": 269.96,
      "duration_seconds": 5.43,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.28,
      "end_seconds": 277.07,
      "duration_seconds": 2.79,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.53,
      "end_seconds": 327.04,
      "duration_seconds": 33.51,
      "text": "Taking everything into account, the most likely explanation is gestational diabetes controllable with diet. I'd like to arrange a glucose meter and diary for gestational diabetes. I want a growth scan done, that's for gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals. I'll also refer you to the diabetes midwife. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.45,
      "end_seconds": 332.53,
      "duration_seconds": 2.08,
      "text": "Come back in two weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.94,
      "end_seconds": 334.64,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.42,
      "end_seconds": 342.69,
      "duration_seconds": 7.27,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.86,
      "end_seconds": 348.95,
      "duration_seconds": 5.09,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.22,
      "end_seconds": 354.21,
      "duration_seconds": 3.99,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.99,
      "end_seconds": 360.36,
      "duration_seconds": 4.37,
      "text": "Erm, um, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.17,
      "end_seconds": 363.49,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}