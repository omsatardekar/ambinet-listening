{
  "schema_version": "1.0",
  "encounter_id": "03479",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 10.22,
      "duration_seconds": 9.37,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.71,
      "end_seconds": 16.86,
      "duration_seconds": 5.15,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.67,
      "end_seconds": 23.21,
      "duration_seconds": 5.54,
      "text": "I've been dealing with pain in my breastbone wound."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.04,
      "end_seconds": 27.16,
      "duration_seconds": 3.12,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.04,
      "end_seconds": 31.35,
      "duration_seconds": 3.31,
      "text": "it's been like this since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 41.96,
      "duration_seconds": 8.86,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.57,
      "end_seconds": 56.54,
      "duration_seconds": 12.97,
      "text": "I get some relief from a pillow. It's moderate, honestly. I'd say a few times a day. Coughing definitely sets it it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.46,
      "end_seconds": 61.71,
      "duration_seconds": 3.25,
      "text": "What about tiredness, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.15,
      "end_seconds": 67.05,
      "duration_seconds": 3.9,
      "text": "so, yeah. Two weeks, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.37,
      "end_seconds": 71.63,
      "duration_seconds": 3.26,
      "text": "have you had a clicking in the breastbone?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.61,
      "end_seconds": 86.74,
      "duration_seconds": 13.13,
      "text": "Let me think, yeah. About a month, I'd say. I've also had swollen ankles, for ten days. With swollen ankles, about a four out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.26,
      "end_seconds": 103.7,
      "duration_seconds": 4.44,
      "text": "Any fever, chest pain on exertion or breathlessness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.57,
      "end_seconds": 108.75,
      "duration_seconds": 3.18,
      "text": "So, no, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 112.15,
      "duration_seconds": 2.34,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.77,
      "end_seconds": 118.61,
      "duration_seconds": 3.84,
      "text": "Yeah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.22,
      "end_seconds": 123.0,
      "duration_seconds": 2.78,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.84,
      "end_seconds": 127.44,
      "duration_seconds": 2.6,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.54,
      "end_seconds": 133.08,
      "duration_seconds": 4.54,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.19,
      "end_seconds": 137.73,
      "duration_seconds": 3.54,
      "text": "Yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 145.5,
      "duration_seconds": 5.71,
      "text": "Tell me your medicines, please. I ask cos it helps me narrow things down."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.25,
      "end_seconds": 152.84,
      "duration_seconds": 5.59,
      "text": "Erm, I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 155.48,
      "end_seconds": 161.34,
      "duration_seconds": 5.86,
      "text": "Doctor, our chart from the the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.21,
      "end_seconds": 166.85,
      "duration_seconds": 3.64,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.85,
      "end_seconds": 178.53,
      "duration_seconds": 9.68,
      "text": "Not with me. I'll bring it next time. Erm, I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.94,
      "end_seconds": 179.64,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.57,
      "end_seconds": 188.37,
      "duration_seconds": 6.8,
      "text": "I had metoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.43,
      "end_seconds": 192.62,
      "duration_seconds": 3.19,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.56,
      "end_seconds": 204.84,
      "duration_seconds": 11.28,
      "text": "um, I've got heart disease work has been very busy so I kept ignoring it i have eczema, for about a year"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.24,
      "end_seconds": 208.33,
      "duration_seconds": 2.09,
      "text": "okay, what's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.83,
      "end_seconds": 212.96,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.71,
      "end_seconds": 216.1,
      "duration_seconds": 2.39,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.22,
      "end_seconds": 222.93,
      "duration_seconds": 5.71,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.08,
      "end_seconds": 229.51,
      "duration_seconds": 3.43,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.94,
      "end_seconds": 233.88,
      "duration_seconds": 2.94,
      "text": "so, my son has asthma"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 251.88,
      "end_seconds": 260.4,
      "duration_seconds": 8.52,
      "text": "Here are the numbers, doctor. BP is 126 over 82, oxygen saturation is 97 percent, heart rate 82."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.16,
      "end_seconds": 262.67,
      "duration_seconds": 1.51,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.31,
      "end_seconds": 268.95,
      "duration_seconds": 4.64,
      "text": "alright, I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.95,
      "end_seconds": 281.1,
      "duration_seconds": 3.15,
      "text": "yes, you know, that's fine"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.62,
      "end_seconds": 284.78,
      "duration_seconds": 2.16,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.64,
      "end_seconds": 311.99,
      "duration_seconds": 8.35,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.87,
      "end_seconds": 328.68,
      "duration_seconds": 12.81,
      "text": "Please sit back down. So, based on the history and the examination, it points towards recovering well after bypass surgery. Another possibility is a leg wound infection."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 329.8,
      "end_seconds": 332.94,
      "duration_seconds": 3.14,
      "text": "we've already done an ECG this morning, doctor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.76,
      "end_seconds": 352.91,
      "duration_seconds": 18.15,
      "text": "great, that's useful. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 354.45,
      "end_seconds": 355.5,
      "duration_seconds": 1.05,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.13,
      "end_seconds": 362.4,
      "duration_seconds": 5.27,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.18,
      "end_seconds": 367.62,
      "duration_seconds": 3.44,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}