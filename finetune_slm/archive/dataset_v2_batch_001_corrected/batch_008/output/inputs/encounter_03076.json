{
  "schema_version": "1.0",
  "encounter_id": "03076",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 7.25,
      "duration_seconds": 5.86,
      "text": "So, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 12.28,
      "duration_seconds": 3.71,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.79,
      "end_seconds": 14.87,
      "duration_seconds": 2.08,
      "text": "I've been feeling faint."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.74,
      "end_seconds": 22.99,
      "duration_seconds": 4.25,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.59,
      "end_seconds": 33.49,
      "duration_seconds": 8.9,
      "text": "Gliclazide. I take it 80 milligrams, twice a day. I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.14,
      "end_seconds": 37.45,
      "duration_seconds": 3.31,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.44,
      "end_seconds": 41.64,
      "duration_seconds": 2.2,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.65,
      "end_seconds": 54.18,
      "duration_seconds": 10.53,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.7,
      "end_seconds": 73.47,
      "duration_seconds": 18.77,
      "text": "Pretty mild, if I'm being honest. It just comes and goes. Oh, and shortness of breath. That's been about the same, ten days. I mean, and a racing heart as well, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.06,
      "end_seconds": 79.37,
      "duration_seconds": 4.31,
      "text": "Have you been feeling faint at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.14,
      "end_seconds": 87.11,
      "duration_seconds": 5.97,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.44,
      "end_seconds": 92.43,
      "duration_seconds": 3.99,
      "text": "Okay, any leg swelling, fever or cough at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.28,
      "end_seconds": 97.41,
      "duration_seconds": 4.13,
      "text": "Yeah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.24,
      "end_seconds": 105.41,
      "duration_seconds": 2.17,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.47,
      "end_seconds": 107.58,
      "duration_seconds": 1.11,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.48,
      "end_seconds": 112.46,
      "duration_seconds": 2.98,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.32,
      "end_seconds": 116.49,
      "duration_seconds": 2.17,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.6,
      "end_seconds": 120.16,
      "duration_seconds": 2.56,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.1,
      "end_seconds": 123.88,
      "duration_seconds": 2.78,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.81,
      "end_seconds": 128.48,
      "duration_seconds": 2.67,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.2,
      "end_seconds": 144.57,
      "duration_seconds": 15.37,
      "text": "Okay, uh, so just a triple bypass, eight years ago. My family kept telling me to get it checked. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.29,
      "end_seconds": 161.27,
      "duration_seconds": 1.98,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.49,
      "end_seconds": 166.94,
      "duration_seconds": 4.45,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.72,
      "end_seconds": 170.31,
      "duration_seconds": 2.59,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.93,
      "end_seconds": 175.69,
      "duration_seconds": 4.76,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.07,
      "end_seconds": 189.15,
      "duration_seconds": 4.08,
      "text": "Alright, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.5,
      "end_seconds": 203.01,
      "duration_seconds": 12.51,
      "text": "Yes, diabetes. I've had heart disease, yes. I just want to get back to normal, really. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.03,
      "end_seconds": 206.42,
      "duration_seconds": 1.39,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.99,
      "end_seconds": 209.34,
      "duration_seconds": 2.35,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.22,
      "end_seconds": 219.93,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.35,
      "end_seconds": 238.7,
      "duration_seconds": 8.35,
      "text": "Okay: temperature is 36.5 degrees, BP is 98 over 63. And heart rate 93, saturation 97 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.93,
      "end_seconds": 243.55,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.77,
      "end_seconds": 247.68,
      "duration_seconds": 2.91,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 252.19,
      "duration_seconds": 2.44,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.69,
      "end_seconds": 255.96,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.17,
      "end_seconds": 279.79,
      "duration_seconds": 6.62,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.32,
      "end_seconds": 287.25,
      "duration_seconds": 1.93,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.82,
      "end_seconds": 333.9,
      "duration_seconds": 31.08,
      "text": "So, based on the history and the examination, my working impression is possible cardiac tamponade. I can't rule out a heart attack yet. I'd like to arrange an ECG for chest pain. Let's get an urgent echocardiogram, for possible tamponade. You need an urgent heart scan and possibly a drain. I think the cardiology team should see you too. Let's review you straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.3,
      "end_seconds": 339.68,
      "duration_seconds": 4.38,
      "text": "Let me think, I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.45,
      "end_seconds": 344.16,
      "duration_seconds": 2.71,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.0,
      "end_seconds": 348.3,
      "duration_seconds": 2.3,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.36,
      "end_seconds": 350.69,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}