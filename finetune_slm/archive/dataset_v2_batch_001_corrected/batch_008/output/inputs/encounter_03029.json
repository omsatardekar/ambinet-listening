{
  "schema_version": "1.0",
  "encounter_id": "03029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 3.06,
      "duration_seconds": 2.39,
      "text": "Good afternoon, um, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.65,
      "end_seconds": 7.79,
      "duration_seconds": 4.14,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.37,
      "end_seconds": 14.97,
      "duration_seconds": 6.6,
      "text": "Doctor, it's vomiting once or twice. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.48,
      "end_seconds": 19.77,
      "duration_seconds": 3.29,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.74,
      "end_seconds": 24.55,
      "duration_seconds": 3.81,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.54,
      "end_seconds": 31.2,
      "duration_seconds": 5.66,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.25,
      "end_seconds": 39.31,
      "duration_seconds": 6.06,
      "text": "It feels mild to me. I get some relief from sips of fluid."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.67,
      "end_seconds": 44.82,
      "duration_seconds": 4.15,
      "text": "What about a mild tummy ache, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.84,
      "end_seconds": 52.76,
      "duration_seconds": 6.92,
      "text": "Yes, I have. I had loose stools before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.47,
      "end_seconds": 56.7,
      "duration_seconds": 3.23,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.78,
      "end_seconds": 67.2,
      "duration_seconds": 2.42,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.62,
      "end_seconds": 89.63,
      "duration_seconds": 11.01,
      "text": "Okay: blood pressure 121 over 71, pulse 80. And weight 95 kilos, height 178 centimetres, BMI works out to 30.0, saturation 97 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.66,
      "end_seconds": 92.08,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.21,
      "end_seconds": 96.79,
      "duration_seconds": 3.58,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.94,
      "end_seconds": 101.82,
      "duration_seconds": 3.88,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.28,
      "end_seconds": 104.49,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.91,
      "end_seconds": 107.99,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.24,
      "end_seconds": 127.45,
      "duration_seconds": 5.21,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.59,
      "end_seconds": 133.81,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.66,
      "end_seconds": 148.14,
      "duration_seconds": 4.48,
      "text": "Any drowsiness, high fever or no wet nappies at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.37,
      "end_seconds": 154.77,
      "duration_seconds": 5.4,
      "text": "No drowsiness, high fever or no wet nappies, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.43,
      "end_seconds": 157.83,
      "duration_seconds": 2.4,
      "text": "Any blood in the stool?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.18,
      "end_seconds": 163.66,
      "duration_seconds": 4.48,
      "text": "Not at all, no blood in the stool."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.1,
      "end_seconds": 167.36,
      "duration_seconds": 3.26,
      "text": "I see, go ahead. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.74,
      "end_seconds": 174.75,
      "duration_seconds": 2.01,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.94,
      "end_seconds": 182.46,
      "duration_seconds": 6.52,
      "text": "What do you take on a normal day? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.44,
      "end_seconds": 187.93,
      "duration_seconds": 3.49,
      "text": "Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.72,
      "end_seconds": 193.2,
      "duration_seconds": 4.48,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.57,
      "end_seconds": 201.81,
      "duration_seconds": 7.24,
      "text": "No, it's at home. It's oral rehydration solution, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.83,
      "end_seconds": 207.98,
      "duration_seconds": 3.15,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.72,
      "end_seconds": 215.38,
      "duration_seconds": 1.66,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.75,
      "end_seconds": 218.86,
      "duration_seconds": 2.11,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.35,
      "end_seconds": 225.53,
      "duration_seconds": 5.18,
      "text": "I have anxiety. Heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.12,
      "end_seconds": 230.01,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.04,
      "end_seconds": 233.73,
      "duration_seconds": 1.69,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.23,
      "end_seconds": 248.58,
      "duration_seconds": 4.35,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.21,
      "end_seconds": 259.05,
      "duration_seconds": 9.84,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.6,
      "end_seconds": 263.39,
      "duration_seconds": 3.79,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.13,
      "end_seconds": 267.97,
      "duration_seconds": 3.84,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 272.59,
      "duration_seconds": 3.35,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.14,
      "end_seconds": 277.96,
      "duration_seconds": 3.82,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 282.18,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.21,
      "end_seconds": 288.48,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.44,
      "end_seconds": 322.48,
      "duration_seconds": 22.04,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If he stops drinking or becomes drowsy, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.09,
      "end_seconds": 325.8,
      "duration_seconds": 1.71,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.93,
      "end_seconds": 331.2,
      "duration_seconds": 4.27,
      "text": "Please come and see me if he is not drinking."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 332.25,
      "end_seconds": 335.69,
      "duration_seconds": 3.44,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.51,
      "end_seconds": 340.5,
      "duration_seconds": 3.99,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.96,
      "end_seconds": 343.74,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.76,
      "end_seconds": 346.32,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}