{
  "schema_version": "1.0",
  "encounter_id": "03099",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.0,
      "duration_seconds": 3.45,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 10.64,
      "duration_seconds": 4.81,
      "text": "Okay, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.82,
      "end_seconds": 30.82,
      "duration_seconds": 19.0,
      "text": "Mainly severe back pain. There's a couple of other things, but that's the main one. Sorry, I know I'm rambling a bit. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.42,
      "end_seconds": 34.91,
      "duration_seconds": 3.49,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.86,
      "end_seconds": 38.23,
      "duration_seconds": 2.37,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.82,
      "end_seconds": 45.58,
      "duration_seconds": 6.76,
      "text": "I see, go ahead. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.34,
      "end_seconds": 55.56,
      "duration_seconds": 8.22,
      "text": "It feels moderate to me. Honestly, on and off. I've had a fever too, for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.7,
      "end_seconds": 67.08,
      "duration_seconds": 4.38,
      "text": "Any recent fall, weight loss or chest pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.77,
      "end_seconds": 72.95,
      "duration_seconds": 5.18,
      "text": "No, um, no recent fall, weight loss or chest pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.79,
      "end_seconds": 76.48,
      "duration_seconds": 2.69,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.69,
      "end_seconds": 82.25,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.69,
      "end_seconds": 87.18,
      "duration_seconds": 2.49,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.24,
      "end_seconds": 89.41,
      "duration_seconds": 1.17,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.29,
      "end_seconds": 94.2,
      "duration_seconds": 3.91,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.27,
      "end_seconds": 98.17,
      "duration_seconds": 2.9,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.2,
      "end_seconds": 116.88,
      "duration_seconds": 4.68,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.66,
      "end_seconds": 119.77,
      "duration_seconds": 2.11,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.14,
      "end_seconds": 124.32,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.31,
      "end_seconds": 129.52,
      "duration_seconds": 3.21,
      "text": "No, um, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.48,
      "end_seconds": 151.97,
      "duration_seconds": 5.49,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.16,
      "end_seconds": 172.41,
      "duration_seconds": 19.25,
      "text": "I used to drink heavily but I stopped four years ago. No, I've never smoked in my life. My partner and our baby. I swim twice a week. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.93,
      "end_seconds": 189.7,
      "duration_seconds": 2.77,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.32,
      "end_seconds": 199.46,
      "duration_seconds": 2.14,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.51,
      "end_seconds": 219.45,
      "duration_seconds": 8.94,
      "text": "Okay: pulse is 107 beats a minute, respiratory rate 22. And saturation 97 percent, pressure 121 over 67."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.58,
      "end_seconds": 224.59,
      "duration_seconds": 4.01,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.62,
      "end_seconds": 228.24,
      "duration_seconds": 1.62,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.09,
      "end_seconds": 231.55,
      "duration_seconds": 1.46,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.92,
      "end_seconds": 251.68,
      "duration_seconds": 5.76,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.35,
      "end_seconds": 275.76,
      "duration_seconds": 18.41,
      "text": "Please sit back down. From what you've told me and what I found, it's hard to say. A possible spinal infection pressing on the nerves is one possibility and a slipped disc another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.95,
      "end_seconds": 282.7,
      "duration_seconds": 2.75,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.11,
      "end_seconds": 314.86,
      "duration_seconds": 30.75,
      "text": "I understand the worry. At the moment I'd say it's a possible spinal infection pressing on the nerves, and we'll know more once the an urgent MRI of the spine is back. Let's book an urgent MRI of the spine to look into possible epidural abscess. You are going to hospital now, this can cause permanent weakness. I'd like you to see the spinal team as well, and I'll write the referral. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.43,
      "end_seconds": 317.53,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.23,
      "end_seconds": 319.44,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}