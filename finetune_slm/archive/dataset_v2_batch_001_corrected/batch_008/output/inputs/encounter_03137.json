{
  "schema_version": "1.0",
  "encounter_id": "03137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.02,
      "duration_seconds": 4.43,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 11.0,
      "duration_seconds": 4.76,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.4,
      "end_seconds": 18.77,
      "duration_seconds": 6.37,
      "text": "Good afternoon, uh, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.35,
      "end_seconds": 25.03,
      "duration_seconds": 4.68,
      "text": "I wanted to get shoulder tip pain looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.58,
      "end_seconds": 29.84,
      "duration_seconds": 3.26,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.66,
      "end_seconds": 34.35,
      "duration_seconds": 2.69,
      "text": "It's been like this since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.13,
      "end_seconds": 39.9,
      "duration_seconds": 4.77,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.54,
      "end_seconds": 49.6,
      "duration_seconds": 8.06,
      "text": "Okay, uh, so it happens all the time. I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.16,
      "end_seconds": 55.12,
      "duration_seconds": 3.96,
      "text": "Has there been a sudden severe tummy pain too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.22,
      "end_seconds": 68.85,
      "duration_seconds": 12.63,
      "text": "Yes, for ten days. As for vomiting, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.75,
      "end_seconds": 71.97,
      "duration_seconds": 2.22,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.76,
      "end_seconds": 75.75,
      "duration_seconds": 1.99,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.59,
      "end_seconds": 96.49,
      "duration_seconds": 3.9,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 98.53,
      "end_seconds": 110.66,
      "duration_seconds": 12.13,
      "text": "It's Foracort inhaler, twice a day, doctor. It's pantoprazole, 40 milligrams, before breakfast, doctor. She takes ibuprofen, 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.42,
      "end_seconds": 117.26,
      "duration_seconds": 4.84,
      "text": "I was on omeprazole before. I stopped taking it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.27,
      "end_seconds": 121.13,
      "duration_seconds": 2.86,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.21,
      "end_seconds": 128.07,
      "duration_seconds": 4.86,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.18,
      "end_seconds": 131.77,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.94,
      "end_seconds": 141.26,
      "duration_seconds": 8.32,
      "text": "Yes, kiwi. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.77,
      "end_seconds": 146.14,
      "duration_seconds": 3.37,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.04,
      "end_seconds": 149.3,
      "duration_seconds": 2.26,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.4,
      "end_seconds": 154.49,
      "duration_seconds": 4.09,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.4,
      "end_seconds": 166.64,
      "duration_seconds": 11.24,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. I look after my grandchildren most days. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.09,
      "end_seconds": 185.37,
      "duration_seconds": 3.28,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.29,
      "end_seconds": 187.68,
      "duration_seconds": 1.39,
      "text": "I have asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.26,
      "end_seconds": 190.25,
      "duration_seconds": 0.99,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.57,
      "end_seconds": 194.95,
      "duration_seconds": 3.38,
      "text": "I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.87,
      "end_seconds": 215.85,
      "duration_seconds": 6.98,
      "text": "Let me check a few things. Any fever, diarrhoea or blood in the vomit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.28,
      "end_seconds": 223.75,
      "duration_seconds": 6.47,
      "text": "I haven't had fever, diarrhoea or blood in the vomit, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.84,
      "end_seconds": 227.37,
      "duration_seconds": 2.53,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.39,
      "end_seconds": 229.41,
      "duration_seconds": 1.02,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.97,
      "end_seconds": 231.29,
      "duration_seconds": 1.32,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.55,
      "end_seconds": 234.56,
      "duration_seconds": 2.01,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 235.79,
      "end_seconds": 246.47,
      "duration_seconds": 10.68,
      "text": "Here are the numbers, doctor. SpO2 97 percent on room air, pressure 113 over 72, temperature is 36.9 degrees, heart rate 126."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.46,
      "end_seconds": 249.56,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.41,
      "end_seconds": 256.49,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 260.82,
      "duration_seconds": 2.41,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.63,
      "end_seconds": 280.39,
      "duration_seconds": 7.76,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.39,
      "end_seconds": 296.27,
      "duration_seconds": 9.88,
      "text": "Okay, that's enough for me. Putting it all together, it fits best with a perforated stomach ulcer. Another possibility is pancreatitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.9,
      "end_seconds": 300.97,
      "duration_seconds": 3.07,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.06,
      "end_seconds": 339.25,
      "duration_seconds": 32.19,
      "text": "It's reasonable to be concerned, but right now a perforated stomach ulcer is my leading thought, not anything worse. I'm going to order urgent blood tests, for acute abdomen. I'm sending you for an erect chest X-ray because of possible perforation. Nothing to eat or drink, you need an operation urgently. A short walk every day, even twenty minutes, will help more than you'd think. I'm going to send a referral to the surgical team."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.12,
      "end_seconds": 346.42,
      "duration_seconds": 6.3,
      "text": "Please come and see me straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.96,
      "end_seconds": 350.92,
      "duration_seconds": 2.96,
      "text": "Erm, alright, thanks, take care."
    }
  ]
}