{
  "schema_version": "1.0",
  "encounter_id": "03437",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.31,
      "duration_seconds": 3.79,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 11.23,
      "duration_seconds": 5.15,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.27,
      "end_seconds": 23.15,
      "duration_seconds": 9.88,
      "text": "I've been coughing up large amounts of blood. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 26.91,
      "duration_seconds": 2.4,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.0,
      "end_seconds": 30.68,
      "duration_seconds": 1.68,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.58,
      "end_seconds": 39.82,
      "duration_seconds": 5.24,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.39,
      "end_seconds": 44.36,
      "duration_seconds": 2.97,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.99,
      "end_seconds": 49.35,
      "duration_seconds": 3.36,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.4,
      "end_seconds": 65.96,
      "duration_seconds": 15.56,
      "text": "It usually comes with a gurgling chest. The gurgling chest? That's been for three days. With gurgling chest, about a eight out of ten. I'd been feeling faint, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.88,
      "end_seconds": 79.88,
      "duration_seconds": 4.0,
      "text": "So, any weight loss, fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.78,
      "end_seconds": 83.18,
      "duration_seconds": 2.4,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 88.18,
      "duration_seconds": 4.07,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.67,
      "end_seconds": 91.94,
      "duration_seconds": 2.27,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.73,
      "end_seconds": 96.35,
      "duration_seconds": 2.62,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.76,
      "end_seconds": 98.75,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.42,
      "end_seconds": 104.1,
      "duration_seconds": 4.68,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 109.0,
      "duration_seconds": 3.98,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 121.63,
      "duration_seconds": 2.4,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.38,
      "end_seconds": 126.88,
      "duration_seconds": 4.5,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.95,
      "end_seconds": 133.91,
      "duration_seconds": 3.96,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.32,
      "end_seconds": 140.98,
      "duration_seconds": 5.66,
      "text": "Sorry, what was I saying, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.74,
      "end_seconds": 145.64,
      "duration_seconds": 2.9,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.3,
      "end_seconds": 150.61,
      "duration_seconds": 4.31,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.3,
      "end_seconds": 153.49,
      "duration_seconds": 2.19,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.59,
      "end_seconds": 159.92,
      "duration_seconds": 4.33,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.72,
      "end_seconds": 165.01,
      "duration_seconds": 4.29,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.39,
      "end_seconds": 173.72,
      "duration_seconds": 7.33,
      "text": "Asthma, for nearly five years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.05,
      "end_seconds": 178.16,
      "duration_seconds": 3.11,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 194.36,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.89,
      "end_seconds": 215.08,
      "duration_seconds": 11.19,
      "text": "Okay: heart rate 95, temperature is 37.3 degrees, respiratory rate 20, oxygen saturation is 90 percent, BP is 131 over 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.56,
      "end_seconds": 219.93,
      "duration_seconds": 2.37,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.52,
      "end_seconds": 222.16,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.74,
      "end_seconds": 224.96,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 241.18,
      "duration_seconds": 5.8,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.95,
      "end_seconds": 247.86,
      "duration_seconds": 1.91,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.46,
      "end_seconds": 267.58,
      "duration_seconds": 10.12,
      "text": "So, based on the history and the examination, I don't have a clear answer today: life-threatening haemoptysis is possible, and so is a lung tumour."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.69,
      "end_seconds": 271.94,
      "duration_seconds": 3.25,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.94,
      "end_seconds": 303.31,
      "duration_seconds": 29.37,
      "text": "I can't promise yet, but most people with life-threatening haemoptysis do well once it's treated properly. Let's book an urgent CT scan to look into massive haemoptysis. You'll be taking tranexamic acid, 1 gram, now, single dose. It's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. I think the emergency team should see you too. Come back straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.78,
      "end_seconds": 307.93,
      "duration_seconds": 3.15,
      "text": "Good, um, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.15,
      "end_seconds": 312.96,
      "duration_seconds": 3.81,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.19,
      "end_seconds": 317.21,
      "duration_seconds": 3.02,
      "text": "I think I understand everything. Thanks."
    }
  ]
}