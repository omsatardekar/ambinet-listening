{
  "schema_version": "1.0",
  "encounter_id": "03458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.27,
      "end_seconds": 10.58,
      "duration_seconds": 9.31,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.88,
      "end_seconds": 16.75,
      "duration_seconds": 4.87,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.84,
      "end_seconds": 21.0,
      "duration_seconds": 3.16,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.85,
      "end_seconds": 25.61,
      "duration_seconds": 2.76,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.77,
      "end_seconds": 43.63,
      "duration_seconds": 16.86,
      "text": "Mm, I've been dealing with vomiting once or twice. I didn't want to bother you but it keeps coming back. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.77,
      "end_seconds": 47.58,
      "duration_seconds": 2.81,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.13,
      "end_seconds": 61.38,
      "duration_seconds": 9.25,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.93,
      "end_seconds": 66.74,
      "duration_seconds": 4.81,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.69,
      "end_seconds": 70.67,
      "duration_seconds": 2.98,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 75.02,
      "duration_seconds": 3.95,
      "text": "Mm-hmm. Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.96,
      "end_seconds": 82.68,
      "duration_seconds": 6.72,
      "text": "A mild tummy ache goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.1,
      "end_seconds": 88.94,
      "duration_seconds": 5.84,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 89.04,
      "end_seconds": 95.91,
      "duration_seconds": 6.87,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.06,
      "end_seconds": 99.23,
      "duration_seconds": 2.17,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 106.47,
      "duration_seconds": 6.27,
      "text": "As for mild tummy ache, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 110.49,
      "end_seconds": 120.17,
      "duration_seconds": 9.68,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 97 percent, temperature 36.9, pulse 73, blood pressure 122 over 77."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.81,
      "end_seconds": 121.72,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.26,
      "end_seconds": 128.92,
      "duration_seconds": 4.66,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.48,
      "end_seconds": 130.18,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.17,
      "end_seconds": 133.69,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.78,
      "end_seconds": 156.97,
      "duration_seconds": 5.19,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.7,
      "end_seconds": 168.01,
      "duration_seconds": 5.31,
      "text": "Right, that's the examination finished. Alright, nothing like no wet nappies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.43,
      "end_seconds": 171.96,
      "duration_seconds": 2.53,
      "text": "Definitely no no wet nappies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.89,
      "end_seconds": 178.03,
      "duration_seconds": 5.14,
      "text": "Did you get blood in the stool, high fever or drowsiness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.81,
      "end_seconds": 196.3,
      "duration_seconds": 12.49,
      "text": "No, no blood in the stool, no high fever, no drowsiness. I did have loose stools at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.37,
      "end_seconds": 201.38,
      "duration_seconds": 4.01,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.16,
      "end_seconds": 204.4,
      "duration_seconds": 2.24,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.51,
      "end_seconds": 207.98,
      "duration_seconds": 2.47,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.21,
      "end_seconds": 211.52,
      "duration_seconds": 2.31,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.68,
      "end_seconds": 215.56,
      "duration_seconds": 2.88,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.81,
      "end_seconds": 224.21,
      "duration_seconds": 7.4,
      "text": "Okay, so just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.04,
      "end_seconds": 228.68,
      "duration_seconds": 2.64,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.15,
      "end_seconds": 246.93,
      "duration_seconds": 12.78,
      "text": "I have asthma. I've had anxiety for about a year now. I took the morning off to come in today. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.3,
      "end_seconds": 258.47,
      "duration_seconds": 8.17,
      "text": "Alright, asthma and anxiety, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 259.3,
      "end_seconds": 264.24,
      "duration_seconds": 4.94,
      "text": "He takes escitalopram, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.0,
      "end_seconds": 267.47,
      "duration_seconds": 2.47,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.07,
      "end_seconds": 281.36,
      "duration_seconds": 13.29,
      "text": "10 milligrams. He takes rosuvastatin, 10 milligrams, at night for my cholesterol. He is on oral rehydration solution, after each loose stool, I give it to him."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.98,
      "end_seconds": 284.3,
      "duration_seconds": 2.32,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 286.25,
      "end_seconds": 287.18,
      "duration_seconds": 0.93,
      "text": "1 sachet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 292.79,
      "duration_seconds": 3.9,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.86,
      "end_seconds": 300.04,
      "duration_seconds": 6.18,
      "text": "My daughter has type 1 diabetes. Right, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.46,
      "end_seconds": 306.85,
      "duration_seconds": 5.39,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 308.67,
      "end_seconds": 320.17,
      "duration_seconds": 11.5,
      "text": "Ah, um, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.74,
      "end_seconds": 330.53,
      "duration_seconds": 1.79,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 331.31,
      "end_seconds": 334.64,
      "duration_seconds": 3.33,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.04,
      "end_seconds": 337.27,
      "duration_seconds": 1.23,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.58,
      "end_seconds": 343.99,
      "duration_seconds": 4.41,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.64,
      "end_seconds": 352.42,
      "duration_seconds": 7.78,
      "text": "Having listened and examined, I think we're dealing with a mild stomach bug at this stage."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.24,
      "end_seconds": 380.21,
      "duration_seconds": 10.97,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. See me again if he is not drinking."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 382.02,
      "end_seconds": 386.0,
      "duration_seconds": 3.98,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.32,
      "end_seconds": 389.23,
      "duration_seconds": 1.91,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.11,
      "end_seconds": 392.65,
      "duration_seconds": 2.54,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.48,
      "end_seconds": 397.57,
      "duration_seconds": 3.09,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}