{
  "schema_version": "1.0",
  "encounter_id": "03333",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 7.69,
      "duration_seconds": 6.95,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.13,
      "end_seconds": 17.65,
      "duration_seconds": 4.52,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.94,
      "end_seconds": 24.74,
      "duration_seconds": 5.8,
      "text": "I've been dealing with pain in my groin and hip."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.31,
      "end_seconds": 28.96,
      "duration_seconds": 2.65,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.7,
      "end_seconds": 38.79,
      "duration_seconds": 9.09,
      "text": "I, I take naproxen, 250 milligrams, twice a day. It's hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.81,
      "end_seconds": 48.76,
      "duration_seconds": 2.95,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.21,
      "end_seconds": 54.85,
      "duration_seconds": 4.64,
      "text": "Hmm, I've had it for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.61,
      "end_seconds": 67.88,
      "duration_seconds": 10.27,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.36,
      "end_seconds": 81.86,
      "duration_seconds": 12.5,
      "text": "Right, pretty severe, if I'm being honest. It happens once or twice a day. I notice it more with walking."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.09,
      "end_seconds": 85.35,
      "duration_seconds": 2.26,
      "text": "Have you had night pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.68,
      "end_seconds": 92.69,
      "duration_seconds": 6.01,
      "text": "Mm, yes. So, as for night pain, it comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.13,
      "end_seconds": 95.95,
      "duration_seconds": 2.82,
      "text": "Yes, carry on. What about fall?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 98.16,
      "duration_seconds": 1.49,
      "text": "No. No fall."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.24,
      "end_seconds": 103.82,
      "duration_seconds": 3.58,
      "text": "Did you get weight loss, fever or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.23,
      "end_seconds": 107.85,
      "duration_seconds": 2.62,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.92,
      "end_seconds": 112.05,
      "duration_seconds": 2.13,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.21,
      "end_seconds": 115.81,
      "duration_seconds": 2.6,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 120.82,
      "duration_seconds": 2.93,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.15,
      "end_seconds": 123.77,
      "duration_seconds": 1.62,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.66,
      "end_seconds": 126.87,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.53,
      "end_seconds": 132.82,
      "duration_seconds": 5.29,
      "text": "Well, uh, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.17,
      "end_seconds": 143.81,
      "duration_seconds": 3.64,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.6,
      "end_seconds": 154.55,
      "duration_seconds": 8.95,
      "text": "Sorry, what was I saying, I've had arthritis in my knees for about ten years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.4,
      "end_seconds": 156.81,
      "duration_seconds": 1.41,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.62,
      "end_seconds": 161.1,
      "duration_seconds": 2.48,
      "text": "Eczema, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.73,
      "end_seconds": 165.08,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.62,
      "end_seconds": 171.24,
      "duration_seconds": 4.62,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.81,
      "end_seconds": 177.61,
      "duration_seconds": 1.8,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.95,
      "end_seconds": 186.87,
      "duration_seconds": 3.92,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.11,
      "end_seconds": 204.2,
      "duration_seconds": 4.09,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.77,
      "end_seconds": 209.81,
      "duration_seconds": 5.04,
      "text": "Yeah, uh, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 211.65,
      "end_seconds": 220.93,
      "duration_seconds": 9.28,
      "text": "Doctor, I've got the readings for you. Saturation 99 percent, pressure 108 over 69, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 222.76,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.95,
      "end_seconds": 229.48,
      "duration_seconds": 4.53,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 230.53,
      "end_seconds": 231.65,
      "duration_seconds": 1.12,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.41,
      "end_seconds": 236.65,
      "duration_seconds": 3.24,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.32,
      "end_seconds": 252.58,
      "duration_seconds": 7.26,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 270.51,
      "duration_seconds": 12.67,
      "text": "That's all I needed to check. Having listened and examined, this is probably hip osteoarthritis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.91,
      "end_seconds": 275.0,
      "duration_seconds": 3.09,
      "text": "I mean, will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.59,
      "end_seconds": 303.81,
      "duration_seconds": 27.22,
      "text": "I understand the worry. At the moment I'd say it's hip osteoarthritis, and we'll know more once the an X-ray of the hips is back. I'd like to arrange an X-ray of the hips for hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. I'll want another look in six weeks. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.71,
      "end_seconds": 307.95,
      "duration_seconds": 3.24,
      "text": "Mm, alright, thanks, take care."
    }
  ]
}