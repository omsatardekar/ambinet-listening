{
  "schema_version": "1.0",
  "encounter_id": "03343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 3.85,
      "duration_seconds": 3.28,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 10.43,
      "duration_seconds": 4.61,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.09,
      "end_seconds": 18.42,
      "duration_seconds": 6.33,
      "text": "Yeah, it's fever and shivers. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.21,
      "end_seconds": 23.1,
      "duration_seconds": 2.89,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.36,
      "end_seconds": 27.05,
      "duration_seconds": 2.69,
      "text": "it's been about three months now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.26,
      "end_seconds": 41.2,
      "duration_seconds": 10.94,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.38,
      "end_seconds": 50.85,
      "duration_seconds": 8.47,
      "text": "right, um, pretty moderate, if I'm being honest i'd say a couple of times a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.75,
      "end_seconds": 54.84,
      "duration_seconds": 3.09,
      "text": "Has there been cloudy smelly urine too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.46,
      "end_seconds": 60.34,
      "duration_seconds": 3.88,
      "text": "Let me think, yes, since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 65.14,
      "duration_seconds": 4.0,
      "text": "Did you get cough, vomiting, back pain or fall?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.8,
      "end_seconds": 73.91,
      "duration_seconds": 7.11,
      "text": "Okay, so no cough, vomiting, back pain or fall, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.82,
      "end_seconds": 78.24,
      "duration_seconds": 2.42,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.17,
      "end_seconds": 82.21,
      "duration_seconds": 2.04,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.45,
      "end_seconds": 84.85,
      "duration_seconds": 1.4,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 90.89,
      "duration_seconds": 4.37,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.92,
      "end_seconds": 96.12,
      "duration_seconds": 2.2,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.25,
      "end_seconds": 101.14,
      "duration_seconds": 3.89,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 108.15,
      "duration_seconds": 5.19,
      "text": "tell me your medicines, please i'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.46,
      "end_seconds": 117.88,
      "duration_seconds": 5.42,
      "text": "Hydrocortisone cream i take it when needed for the eczema"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.92,
      "end_seconds": 122.92,
      "duration_seconds": 4.0,
      "text": "right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.44,
      "end_seconds": 126.66,
      "duration_seconds": 3.22,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.45,
      "end_seconds": 132.42,
      "duration_seconds": 3.97,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.88,
      "end_seconds": 137.34,
      "duration_seconds": 1.46,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.74,
      "end_seconds": 156.68,
      "duration_seconds": 1.94,
      "text": "right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.08,
      "end_seconds": 161.27,
      "duration_seconds": 3.19,
      "text": "No, you know, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.63,
      "end_seconds": 178.18,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.73,
      "end_seconds": 190.16,
      "duration_seconds": 2.43,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.73,
      "end_seconds": 218.62,
      "duration_seconds": 8.89,
      "text": "okay: BP is 107 over 75, pulse 88. And SpO2 96 percent on room air, temp 38.1 degrees"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.27,
      "end_seconds": 222.37,
      "duration_seconds": 2.1,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.1,
      "end_seconds": 226.11,
      "duration_seconds": 2.01,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.5,
      "end_seconds": 230.89,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.66,
      "end_seconds": 233.61,
      "duration_seconds": 0.95,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.95,
      "end_seconds": 236.25,
      "duration_seconds": 1.3,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.73,
      "end_seconds": 255.51,
      "duration_seconds": 6.78,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.31,
      "end_seconds": 258.34,
      "duration_seconds": 1.03,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 264.14,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.45,
      "end_seconds": 286.87,
      "duration_seconds": 12.42,
      "text": "Okay, thinking it through, it points towards a catheter-related urinary infection. So, to recap quickly. You've had fever and shivers for about three months, moderate, and no fall or vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.92,
      "end_seconds": 294.55,
      "duration_seconds": 1.63,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.79,
      "end_seconds": 303.31,
      "duration_seconds": 7.52,
      "text": "I think blood tests makes sense here, for fever. Let's get a urine culture, for possible urinary infection"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.77,
      "end_seconds": 307.12,
      "duration_seconds": 2.35,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.42,
      "end_seconds": 327.79,
      "duration_seconds": 19.37,
      "text": "I'm prescribing co-amoxiclav, 625 milligrams, three times a day, seven days. That's for catheter urinary infection. Change the catheter and drink plenty. Come back or go to emergency straight away if the symptoms get worse. Book a review in two days."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.55,
      "end_seconds": 331.77,
      "duration_seconds": 2.22,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.6,
      "end_seconds": 334.97,
      "duration_seconds": 2.37,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.4,
      "end_seconds": 340.24,
      "duration_seconds": 3.84,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.12,
      "end_seconds": 342.46,
      "duration_seconds": 1.34,
      "text": "Goodbye for now."
    }
  ]
}