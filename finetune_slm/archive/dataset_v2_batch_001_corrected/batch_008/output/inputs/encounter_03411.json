  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.37,
      "duration_seconds": 3.01,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.37,
      "end_seconds": 10.94,
      "duration_seconds": 4.57,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.65,
      "end_seconds": 17.93,
      "duration_seconds": 5.28,
      "text": "Okay, so I've been dealing with a tight chest at work."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.17,
      "end_seconds": 22.19,
      "duration_seconds": 3.02,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.16,
      "end_seconds": 25.96,
      "duration_seconds": 1.8,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.81,
      "end_seconds": 35.91,
      "duration_seconds": 9.1,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.44,
      "end_seconds": 45.42,
      "duration_seconds": 7.98,
      "text": "I'd give it a three, out of ten. It's a couple of times a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.47,
      "end_seconds": 53.24,
      "duration_seconds": 2.77,
      "text": "Any wheeze at work as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.03,
      "end_seconds": 56.71,
      "duration_seconds": 2.68,
      "text": "Yes, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.74,
      "end_seconds": 67.58,
      "duration_seconds": 8.84,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.08,
      "end_seconds": 76.25,
      "duration_seconds": 7.17,
      "text": "Okay, so I notice it more with spray paint. Weekends away helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.68,
      "end_seconds": 98.59,
      "duration_seconds": 5.91,
      "text": "Let me check a few things. Any ankle swelling, fever or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.69,
      "end_seconds": 104.0,
      "duration_seconds": 3.31,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.45,
      "end_seconds": 109.9,
      "duration_seconds": 4.45,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.47,
      "end_seconds": 113.99,
      "duration_seconds": 2.52,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.84,
      "end_seconds": 118.16,
      "duration_seconds": 2.32,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.85,
      "end_seconds": 124.24,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.66,
      "end_seconds": 128.59,
      "duration_seconds": 2.93,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.57,
      "end_seconds": 134.92,
      "duration_seconds": 5.35,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.87,
      "end_seconds": 148.93,
      "duration_seconds": 4.06,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.57,
      "end_seconds": 158.78,
      "duration_seconds": 8.21,
      "text": "I have heart failure i told myself I'd wait and see, and here I am"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.7,
      "end_seconds": 168.53,
      "duration_seconds": 7.83,
      "text": "Can you list what you take, tablets, creams or inhalers? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.03,
      "end_seconds": 178.77,
      "duration_seconds": 9.74,
      "text": "Spironolactone, 25 milligrams, once a day for my heart i'm on a reliever inhaler, 100 micrograms, when needed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.4,
      "end_seconds": 202.65,
      "duration_seconds": 5.25,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.96,
      "end_seconds": 207.36,
      "duration_seconds": 3.4,
      "text": "yes, tramadol i get feeling very drowsy"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.9,
      "end_seconds": 210.96,
      "duration_seconds": 3.06,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.77,
      "end_seconds": 218.43,
      "duration_seconds": 6.66,
      "text": "Yes, I had a a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.34,
      "end_seconds": 223.05,
      "duration_seconds": 3.71,
      "text": "Right, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.06,
      "end_seconds": 234.87,
      "duration_seconds": 2.81,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.09,
      "end_seconds": 257.76,
      "duration_seconds": 9.67,
      "text": "okay: heart rate 66, saturation 98 percent and respiratory rate 18, BP is 115 over 79, temperature is 36.5 degrees"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.12,
      "end_seconds": 265.54,
      "duration_seconds": 5.42,
      "text": "I'll need to examine you for this, it it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 269.39,
      "duration_seconds": 2.83,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.84,
      "end_seconds": 287.63,
      "duration_seconds": 4.79,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.2,
      "end_seconds": 293.12,
      "duration_seconds": 1.92,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.75,
      "end_seconds": 336.78,
      "duration_seconds": 31.03,
      "text": "okay, thinking it through, this looks most like occupational asthma let's get serial peak flow readings, for work-related wheeze i'd like you to take beclometasone inhaler, 200 micrograms, twice a day, long term it's for asthma record peak flows at work and at home for four weeks please take the tablets with food so they don't upset your stomach i think occupational health should see you too"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.55,
      "end_seconds": 339.25,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.81,
      "end_seconds": 346.58,
      "duration_seconds": 6.77,
      "text": "Come back in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.26,
      "end_seconds": 354.72,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.54,
      "end_seconds": 357.71,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}