{
  "schema_version": "1.0",
  "encounter_id": "03362",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 6.03,
      "duration_seconds": 5.3,
      "text": "hi there, the chair's free, sit down. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.77,
      "end_seconds": 11.58,
      "duration_seconds": 3.81,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.53,
      "end_seconds": 15.17,
      "duration_seconds": 2.64,
      "text": "start wherever you like I'm listening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.38,
      "end_seconds": 28.39,
      "duration_seconds": 12.01,
      "text": "mainly collapsing. There's a couple of other things but that's the main one. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.16,
      "end_seconds": 34.1,
      "duration_seconds": 3.94,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.74,
      "end_seconds": 38.67,
      "duration_seconds": 2.93,
      "text": "I've had it for two months"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 43.4,
      "duration_seconds": 4.28,
      "text": "right, right. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.75,
      "end_seconds": 69.84,
      "duration_seconds": 25.09,
      "text": "a three out of ten, I suppose. As for sudden severe pain in the lower tummy, I honestly can't say when that began. It might have been last month or the month before. Oh, and shoulder tip pain. Had that since last weekend. And there's vaginal spotting as well, about three months now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.64,
      "end_seconds": 90.12,
      "duration_seconds": 2.48,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.3,
      "end_seconds": 104.42,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.07,
      "end_seconds": 129.38,
      "duration_seconds": 9.31,
      "text": "okay: respiratory rate 17, blood pressure 101 over 66. And temp 36.4 degrees, pulse is 95 beats a minute"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.82,
      "end_seconds": 132.38,
      "duration_seconds": 1.56,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.9,
      "end_seconds": 138.38,
      "duration_seconds": 4.48,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.88,
      "end_seconds": 142.72,
      "duration_seconds": 2.84,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.41,
      "end_seconds": 146.82,
      "duration_seconds": 2.41,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.3,
      "end_seconds": 167.2,
      "duration_seconds": 6.9,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.31,
      "end_seconds": 176.55,
      "duration_seconds": 5.24,
      "text": "You can relax now. So, did you get vomiting, discharge or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.88,
      "end_seconds": 185.87,
      "duration_seconds": 3.99,
      "text": "okay so no none of those at all"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.65,
      "end_seconds": 189.74,
      "duration_seconds": 2.09,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.78,
      "end_seconds": 192.89,
      "duration_seconds": 1.11,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.3,
      "end_seconds": 197.07,
      "duration_seconds": 2.77,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.51,
      "end_seconds": 222.63,
      "duration_seconds": 24.12,
      "text": "Uh, I've had an irregular heartbeat, yes. I have epilepsy, for about ten years. I did try to ignore it for a while. My family kept telling me to get it checked. I have heart disease. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 231.71,
      "duration_seconds": 4.91,
      "text": "okay, I can see epilepsy in your file as well"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 249.57,
      "duration_seconds": 1.68,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.31,
      "end_seconds": 253.52,
      "duration_seconds": 3.21,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.36,
      "end_seconds": 255.98,
      "duration_seconds": 1.62,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.52,
      "end_seconds": 258.88,
      "duration_seconds": 2.36,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.95,
      "end_seconds": 264.2,
      "duration_seconds": 3.25,
      "text": "alright did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.19,
      "end_seconds": 281.0,
      "duration_seconds": 14.81,
      "text": "sorry, what was I saying, I had two stents put in my heart three years ago it's a relief to to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.62,
      "end_seconds": 286.31,
      "duration_seconds": 3.69,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.14,
      "end_seconds": 292.99,
      "duration_seconds": 4.85,
      "text": "I'm on aspirin 75 milligrams maybe once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.58,
      "end_seconds": 297.86,
      "duration_seconds": 4.28,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.81,
      "end_seconds": 301.77,
      "duration_seconds": 1.96,
      "text": "no it's at home"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.36,
      "end_seconds": 306.32,
      "duration_seconds": 3.96,
      "text": "Any allergies to tablets food or anything in the environment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.14,
      "end_seconds": 310.53,
      "duration_seconds": 3.39,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.44,
      "end_seconds": 359.38,
      "duration_seconds": 35.94,
      "text": "From what you've told me and what I found, the most likely explanation is a ruptured ectopic pregnancy. It could also be a ruptured ovarian cyst, so we'll keep that open. I'll request urgent blood tests, it'll help with internal bleeding. I'd like to arrange a pregnancy test for collapse. That will help us see what's going on underneath and decide the next step. I am calling the emergency team, you need an operation now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.51,
      "end_seconds": 377.86,
      "duration_seconds": 14.35,
      "text": "Let's get you seen by the emergency team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.87,
      "end_seconds": 381.68,
      "duration_seconds": 1.81,
      "text": "thank you that's clear"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.73,
      "end_seconds": 388.52,
      "duration_seconds": 5.79,
      "text": "one warning sign to remember: the symptoms get worse. In that case don't wait"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.42,
      "end_seconds": 392.72,
      "duration_seconds": 2.3,
      "text": "Alright you know I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.62,
      "end_seconds": 396.34,
      "duration_seconds": 2.72,
      "text": "I'd like you back straight away"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.27,
      "end_seconds": 402.13,
      "duration_seconds": 3.86,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.99,
      "end_seconds": 406.34,
      "duration_seconds": 3.35,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.89,
      "end_seconds": 410.86,
      "duration_seconds": 3.97,
      "text": "Ah, um, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 412.81,
      "end_seconds": 414.04,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}