{
  "schema_version": "1.0",
  "encounter_id": "03158",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 3.51,
      "duration_seconds": 2.15,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.58,
      "end_seconds": 7.83,
      "duration_seconds": 3.25,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 10.36,
      "duration_seconds": 1.97,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.05,
      "end_seconds": 16.02,
      "duration_seconds": 3.97,
      "text": "I've been dealing with vomiting once or twice"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.29,
      "end_seconds": 19.3,
      "duration_seconds": 2.01,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.35,
      "end_seconds": 29.3,
      "duration_seconds": 7.95,
      "text": "It's alendronate, 70 milligrams, once a week. Oral rehydration solution, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.04,
      "end_seconds": 33.33,
      "duration_seconds": 3.29,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 40.42,
      "duration_seconds": 5.02,
      "text": "around two days... no wait, it's more like three days"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.18,
      "end_seconds": 46.85,
      "duration_seconds": 5.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.73,
      "end_seconds": 57.55,
      "duration_seconds": 8.82,
      "text": "Moderate, really. I'd say all the time. And And a mild tummy ache as well, um, since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.23,
      "end_seconds": 61.77,
      "duration_seconds": 3.54,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.55,
      "end_seconds": 68.78,
      "duration_seconds": 5.23,
      "text": "Erm, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.31,
      "end_seconds": 76.58,
      "duration_seconds": 6.27,
      "text": "okay, have you had any high fever, blood in the stool or drowsiness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.62,
      "end_seconds": 82.82,
      "duration_seconds": 5.2,
      "text": "no, no high fever, blood in the stool or drowsiness"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.84,
      "end_seconds": 87.49,
      "duration_seconds": 2.65,
      "text": "Any sign of no wet nappies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.28,
      "end_seconds": 91.69,
      "duration_seconds": 2.41,
      "text": "nope, no no wet nappies"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.74,
      "end_seconds": 96.82,
      "duration_seconds": 3.08,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.17,
      "end_seconds": 107.89,
      "duration_seconds": 4.72,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 121.9,
      "duration_seconds": 2.79,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.78,
      "end_seconds": 127.05,
      "duration_seconds": 3.27,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.03,
      "end_seconds": 129.31,
      "duration_seconds": 1.28,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.08,
      "end_seconds": 135.5,
      "duration_seconds": 4.42,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.11,
      "end_seconds": 138.05,
      "duration_seconds": 1.94,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.04,
      "end_seconds": 142.51,
      "duration_seconds": 2.47,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.64,
      "end_seconds": 149.93,
      "duration_seconds": 2.29,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.29,
      "end_seconds": 152.93,
      "duration_seconds": 1.64,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.52,
      "end_seconds": 174.33,
      "duration_seconds": 4.81,
      "text": "okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.73,
      "end_seconds": 178.54,
      "duration_seconds": 2.81,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.13,
      "end_seconds": 192.58,
      "duration_seconds": 2.45,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.9,
      "end_seconds": 204.08,
      "duration_seconds": 2.18,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.6,
      "end_seconds": 232.22,
      "duration_seconds": 10.62,
      "text": "Okay: pressure 110 over 70, pulse 65, oxygen saturation is 98 percent. And respiratory rate 16, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.55,
      "end_seconds": 238.68,
      "duration_seconds": 4.13,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.34,
      "end_seconds": 241.24,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.0,
      "end_seconds": 244.63,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.85,
      "end_seconds": 265.49,
      "duration_seconds": 5.64,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.77,
      "end_seconds": 272.28,
      "duration_seconds": 2.51,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.08,
      "end_seconds": 300.87,
      "duration_seconds": 20.79,
      "text": "Let me tell you where I've got to. I'd lean towards a mild stomach bug. Small, frequent sips of fluid and keep him off nursery for two days after it stops. Do get help quickly if he stops drinking or becomes drowsy. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.27,
      "end_seconds": 304.32,
      "duration_seconds": 2.05,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.39,
      "end_seconds": 306.68,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}