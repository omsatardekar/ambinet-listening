  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.91,
      "duration_seconds": 3.85,
      "text": "Actually, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.57,
      "end_seconds": 10.9,
      "duration_seconds": 4.33,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 16.68,
      "duration_seconds": 4.95,
      "text": "Sorry, what was I saying, I've been dealing with tiredness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.7,
      "end_seconds": 20.92,
      "duration_seconds": 3.22,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.85,
      "end_seconds": 24.92,
      "duration_seconds": 2.07,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.21,
      "end_seconds": 33.35,
      "duration_seconds": 3.14,
      "text": "Any a rash on your elbows as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.27,
      "end_seconds": 59.01,
      "duration_seconds": 24.74,
      "text": "Yeah, I've had that since this morning. About rash on my elbows, severe, I'd say. I've had bloating when I slip up too, for three days. Sorry, uh, what was I saying, about bloating when I slip up, yes, gluten. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.79,
      "end_seconds": 76.4,
      "duration_seconds": 1.61,
      "text": "Nothing like bone pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.15,
      "end_seconds": 80.5,
      "duration_seconds": 3.35,
      "text": "Not at all, no bone pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.03,
      "end_seconds": 84.8,
      "duration_seconds": 3.77,
      "text": "Sure. Any vomiting, weight loss or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.64,
      "end_seconds": 88.92,
      "duration_seconds": 3.28,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.62,
      "end_seconds": 93.75,
      "duration_seconds": 3.13,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.84,
      "end_seconds": 98.16,
      "duration_seconds": 2.32,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.35,
      "end_seconds": 102.97,
      "duration_seconds": 3.62,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.51,
      "end_seconds": 106.53,
      "duration_seconds": 2.02,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.39,
      "end_seconds": 112.17,
      "duration_seconds": 3.78,
      "text": "Right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.64,
      "end_seconds": 121.7,
      "duration_seconds": 5.06,
      "text": "I take Asthalin inhaler, when needed for my asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.85,
      "end_seconds": 125.34,
      "duration_seconds": 2.49,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.46,
      "end_seconds": 127.91,
      "duration_seconds": 1.45,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.71,
      "end_seconds": 131.28,
      "duration_seconds": 2.57,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.25,
      "end_seconds": 140.85,
      "duration_seconds": 4.6,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.63,
      "end_seconds": 144.98,
      "duration_seconds": 2.35,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 152.89,
      "duration_seconds": 3.92,
      "text": "I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 156.99,
      "duration_seconds": 2.92,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.44,
      "end_seconds": 173.02,
      "duration_seconds": 14.58,
      "text": "Nothing, I'm teetotal. I hardly move around during the day. No, I share a house with my brother. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.55,
      "end_seconds": 188.32,
      "duration_seconds": 2.77,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.16,
      "end_seconds": 204.53,
      "duration_seconds": 2.37,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.48,
      "end_seconds": 230.02,
      "duration_seconds": 8.54,
      "text": "Okay: pulse 69, pressure 121 over 71, temp 36.5 degrees. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.82,
      "end_seconds": 234.89,
      "duration_seconds": 2.07,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.09,
      "end_seconds": 236.79,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.11,
      "end_seconds": 241.33,
      "duration_seconds": 3.22,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.81,
      "end_seconds": 264.49,
      "duration_seconds": 4.68,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.71,
      "end_seconds": 281.15,
      "duration_seconds": 13.44,
      "text": "That's the examination finished. So where does that leave us? My working impression is coeliac disease on a gluten-free diet with some accidental exposure. We shouldn't forget iron deficiency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.93,
      "end_seconds": 284.98,
      "duration_seconds": 2.05,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.59,
      "end_seconds": 309.56,
      "duration_seconds": 19.97,
      "text": "I understand the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure, and we'll know more once the a blood count is back. Just to be sure I understood. You've had tiredness for two months, and no weight loss or diarrhoea."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.1,
      "end_seconds": 311.8,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.37,
      "end_seconds": 324.64,
      "duration_seconds": 5.27,
      "text": "I'm sending you for a blood count because of coeliac follow-up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.91,
      "end_seconds": 328.49,
      "duration_seconds": 2.58,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.75,
      "end_seconds": 354.25,
      "duration_seconds": 24.5,
      "text": "I'm sending you for coeliac antibodies because of coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. One warning sign to remember: the symptoms get worse. In that case don't wait. Come back in twelve months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.26,
      "end_seconds": 357.21,
      "duration_seconds": 1.95,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.12,
      "end_seconds": 359.52,
      "duration_seconds": 1.4,
      "text": "All the best."
    }
  ]
}