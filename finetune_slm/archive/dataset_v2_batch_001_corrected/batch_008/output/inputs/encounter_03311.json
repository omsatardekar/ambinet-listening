{
  "schema_version": "1.0",
  "encounter_id": "03311",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 2.64,
      "duration_seconds": 1.68,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.15,
      "end_seconds": 8.27,
      "duration_seconds": 4.12,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.47,
      "end_seconds": 16.5,
      "duration_seconds": 4.03,
      "text": "I'm here because of flakes on my shoulders."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.96,
      "end_seconds": 21.02,
      "duration_seconds": 3.06,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.31,
      "end_seconds": 25.44,
      "duration_seconds": 3.13,
      "text": "I've had it for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 34.9,
      "duration_seconds": 8.57,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 41.58,
      "duration_seconds": 5.54,
      "text": "About a six out of ten. Shampoo helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.38,
      "end_seconds": 53.74,
      "duration_seconds": 3.36,
      "text": "Have you noticed rash elsewhere or pus?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.57,
      "end_seconds": 57.6,
      "duration_seconds": 2.03,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.55,
      "end_seconds": 61.88,
      "duration_seconds": 3.33,
      "text": "Have you noticed pain or hair loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.5,
      "end_seconds": 66.95,
      "duration_seconds": 3.45,
      "text": "Hmm, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.08,
      "end_seconds": 70.44,
      "duration_seconds": 2.36,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.58,
      "end_seconds": 75.06,
      "duration_seconds": 3.48,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.82,
      "end_seconds": 79.77,
      "duration_seconds": 3.95,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.73,
      "end_seconds": 86.44,
      "duration_seconds": 3.71,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.52,
      "end_seconds": 91.66,
      "duration_seconds": 4.14,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.72,
      "end_seconds": 97.25,
      "duration_seconds": 4.53,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.1,
      "end_seconds": 101.83,
      "duration_seconds": 2.73,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.87,
      "end_seconds": 116.47,
      "duration_seconds": 13.6,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. My husband and I live above the shop. I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.53,
      "end_seconds": 133.01,
      "duration_seconds": 1.48,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.38,
      "end_seconds": 135.57,
      "duration_seconds": 1.19,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.61,
      "end_seconds": 138.8,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.15,
      "end_seconds": 144.5,
      "duration_seconds": 4.35,
      "text": "I've had COPD for about ten years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.51,
      "end_seconds": 154.31,
      "duration_seconds": 8.8,
      "text": "Yes, COPD is known to us, good to have that clear. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.37,
      "end_seconds": 166.52,
      "duration_seconds": 2.15,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.7,
      "end_seconds": 194.56,
      "duration_seconds": 11.86,
      "text": "Okay: oxygen saturation is 99 percent, height 175 centimetres, weight 84 kilos. And heart rate 72, respiratory rate 14, blood pressure 122 over 80."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.6,
      "end_seconds": 197.97,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.35,
      "end_seconds": 201.83,
      "duration_seconds": 2.48,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.76,
      "end_seconds": 206.87,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.03,
      "end_seconds": 225.05,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.33,
      "end_seconds": 227.52,
      "duration_seconds": 1.19,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.4,
      "end_seconds": 246.13,
      "duration_seconds": 4.73,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.07,
      "end_seconds": 254.83,
      "duration_seconds": 2.76,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.64,
      "end_seconds": 275.92,
      "duration_seconds": 7.28,
      "text": "From what you've told me and what I found, the most likely explanation is simple dandruff."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.28,
      "end_seconds": 280.75,
      "duration_seconds": 3.47,
      "text": "I mean, will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.08,
      "end_seconds": 294.15,
      "duration_seconds": 12.07,
      "text": "Nothing I've seen today points to an emergency. It looks like simple dandruff. Leave the shampoo on for five minutes before rinsing. Okay, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.22,
      "end_seconds": 298.76,
      "duration_seconds": 3.54,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.31,
      "end_seconds": 300.65,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}