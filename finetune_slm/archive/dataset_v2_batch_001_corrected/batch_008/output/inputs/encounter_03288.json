  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 2.9,
      "duration_seconds": 1.6,
      "text": "evening. Let's get started"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.47,
      "end_seconds": 5.63,
      "duration_seconds": 1.16,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 9.24,
      "duration_seconds": 2.57,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.12,
      "end_seconds": 19.33,
      "duration_seconds": 9.21,
      "text": "Mm, mainly bloating when I slip up. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.02,
      "end_seconds": 24.04,
      "duration_seconds": 3.02,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.91,
      "end_seconds": 30.47,
      "duration_seconds": 4.56,
      "text": "right, it's been four weeks, I'm fairly sure"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.04,
      "end_seconds": 36.8,
      "duration_seconds": 2.76,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.49,
      "end_seconds": 42.3,
      "duration_seconds": 3.81,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.97,
      "end_seconds": 45.36,
      "duration_seconds": 2.39,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.3,
      "end_seconds": 51.68,
      "duration_seconds": 4.38,
      "text": "No, uh, nothing as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.34,
      "end_seconds": 72.32,
      "duration_seconds": 1.98,
      "text": "alright, what's your work?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.9,
      "end_seconds": 77.75,
      "duration_seconds": 3.85,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.3,
      "end_seconds": 82.0,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.09,
      "end_seconds": 87.1,
      "duration_seconds": 4.01,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 91.41,
      "duration_seconds": 3.07,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.32,
      "end_seconds": 95.22,
      "duration_seconds": 2.9,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.1,
      "end_seconds": 99.23,
      "duration_seconds": 3.13,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.84,
      "end_seconds": 106.84,
      "duration_seconds": 4.0,
      "text": "I take mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.17,
      "end_seconds": 124.78,
      "duration_seconds": 2.61,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.85,
      "end_seconds": 132.04,
      "duration_seconds": 5.19,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.66,
      "end_seconds": 139.84,
      "duration_seconds": 6.18,
      "text": "what about your medical history? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.29,
      "end_seconds": 145.14,
      "duration_seconds": 3.85,
      "text": "I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.9,
      "end_seconds": 149.48,
      "duration_seconds": 3.58,
      "text": "Alright, depression, that matches what I have here."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 162.15,
      "duration_seconds": 2.36,
      "text": "Did you notice any vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.76,
      "end_seconds": 166.46,
      "duration_seconds": 2.7,
      "text": "not at all, no vomiting"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.65,
      "end_seconds": 172.28,
      "duration_seconds": 4.63,
      "text": "Let me check a few things. Any diarrhoea or bone pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.21,
      "end_seconds": 176.65,
      "duration_seconds": 3.44,
      "text": "No, no diarrhoea or bone pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.2,
      "end_seconds": 186.21,
      "duration_seconds": 4.01,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.81,
      "end_seconds": 195.29,
      "duration_seconds": 3.48,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.61,
      "end_seconds": 200.54,
      "duration_seconds": 3.93,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.76,
      "end_seconds": 212.15,
      "duration_seconds": 3.39,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.76,
      "end_seconds": 229.9,
      "duration_seconds": 7.14,
      "text": "Okay: pulse 70, height 159 centimetres, BP is 119 over 80, temperature 36.5, weight 63 kilos."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.95,
      "end_seconds": 235.02,
      "duration_seconds": 3.07,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 239.17,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.29,
      "end_seconds": 255.91,
      "duration_seconds": 5.62,
      "text": "your tummy is soft and your weight is stable on the scales"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.93,
      "end_seconds": 259.89,
      "duration_seconds": 1.96,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.4,
      "end_seconds": 286.58,
      "duration_seconds": 8.18,
      "text": "So where does that leave us? My working impression is coeliac disease on a gluten-free diet with some accidental exposure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.31,
      "end_seconds": 290.81,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.88,
      "end_seconds": 307.97,
      "duration_seconds": 16.09,
      "text": "I understand the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure, and we'll watch how it goes. Check labels carefully and use separate toasters and chopping boards."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.3,
      "end_seconds": 312.95,
      "duration_seconds": 4.65,
      "text": "Okay, go on. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.37,
      "end_seconds": 317.88,
      "duration_seconds": 3.51,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}