{
  "schema_version": "1.0",
  "encounter_id": "03120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 2.19,
      "duration_seconds": 1.53,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.26,
      "end_seconds": 7.57,
      "duration_seconds": 4.31,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.25,
      "end_seconds": 20.73,
      "duration_seconds": 12.48,
      "text": "Mainly shortness of breath. There's a couple of other things, but that's the main one. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.83,
      "end_seconds": 24.89,
      "duration_seconds": 3.06,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.15,
      "end_seconds": 30.57,
      "duration_seconds": 2.42,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.04,
      "end_seconds": 37.87,
      "duration_seconds": 5.83,
      "text": "Did it come on recently? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.79,
      "end_seconds": 42.25,
      "duration_seconds": 2.46,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.37,
      "end_seconds": 49.61,
      "duration_seconds": 2.24,
      "text": "Alright, does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.22,
      "end_seconds": 53.49,
      "duration_seconds": 3.27,
      "text": "It settles a little with sitting forward."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.55,
      "end_seconds": 57.19,
      "duration_seconds": 1.64,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.0,
      "end_seconds": 67.1,
      "duration_seconds": 8.1,
      "text": "Yes, lying flat. That makes it worse. I've been feeling faint too, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.01,
      "end_seconds": 72.19,
      "duration_seconds": 4.18,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.12,
      "end_seconds": 82.09,
      "duration_seconds": 4.97,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.67,
      "end_seconds": 103.18,
      "duration_seconds": 3.51,
      "text": "Any fever, leg swelling or cough at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.7,
      "end_seconds": 107.17,
      "duration_seconds": 2.47,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 110.53,
      "duration_seconds": 2.69,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.5,
      "end_seconds": 114.02,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.72,
      "end_seconds": 117.58,
      "duration_seconds": 2.86,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.93,
      "end_seconds": 121.51,
      "duration_seconds": 1.58,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.03,
      "end_seconds": 145.85,
      "duration_seconds": 6.82,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.02,
      "end_seconds": 150.2,
      "duration_seconds": 3.18,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.8,
      "end_seconds": 152.13,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.9,
      "end_seconds": 155.06,
      "duration_seconds": 2.16,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.79,
      "end_seconds": 159.69,
      "duration_seconds": 2.9,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.81,
      "end_seconds": 177.14,
      "duration_seconds": 16.33,
      "text": "I used to drink heavily but I stopped four years ago. No, I've never smoked in my life. Yes, I work in a bakery, early starts. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 182.08,
      "duration_seconds": 4.29,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.2,
      "end_seconds": 186.68,
      "duration_seconds": 3.48,
      "text": "Yes, naproxen. I get stomach pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.54,
      "end_seconds": 190.89,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.12,
      "end_seconds": 204.8,
      "duration_seconds": 1.68,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.02,
      "end_seconds": 208.09,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.33,
      "end_seconds": 227.6,
      "duration_seconds": 7.27,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.47,
      "end_seconds": 241.61,
      "duration_seconds": 8.14,
      "text": "All finished, thank you. Right, here's what I'm thinking. I think we're dealing with possible cardiac tamponade at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.48,
      "end_seconds": 244.72,
      "duration_seconds": 2.24,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.51,
      "end_seconds": 279.33,
      "duration_seconds": 32.82,
      "text": "Nothing I've seen today points to an emergency. It looks like possible cardiac tamponade, but I'd like to confirm. I want an urgent echocardiogram done, that's for possible tamponade. You need an urgent heart scan and possibly a drain. I'd like you to see the cardiology team as well, and I'll write the referral. I'm not ordering an ECG today. If things carry on in two weeks, we'll consider it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.85,
      "end_seconds": 295.93,
      "duration_seconds": 16.08,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Please come and see me straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.5,
      "end_seconds": 300.87,
      "duration_seconds": 4.37,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 306.92,
      "duration_seconds": 4.18,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.82,
      "end_seconds": 312.92,
      "duration_seconds": 2.1,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}