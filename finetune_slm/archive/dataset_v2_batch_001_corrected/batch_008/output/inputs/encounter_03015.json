{
  "schema_version": "1.0",
  "encounter_id": "03015",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.5,
      "end_seconds": 5.57,
      "duration_seconds": 5.07,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.43,
      "end_seconds": 11.62,
      "duration_seconds": 4.19,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.64,
      "end_seconds": 18.49,
      "duration_seconds": 5.85,
      "text": "I mean, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.46,
      "end_seconds": 25.42,
      "duration_seconds": 4.96,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.13,
      "end_seconds": 34.72,
      "duration_seconds": 7.59,
      "text": "It's a clicking in the breastbone. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.51,
      "end_seconds": 42.6,
      "duration_seconds": 3.09,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.66,
      "end_seconds": 53.79,
      "duration_seconds": 10.13,
      "text": "Probably one week. Yeah. It's the not knowing that gets to me. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.05,
      "end_seconds": 54.82,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.23,
      "end_seconds": 66.25,
      "duration_seconds": 10.02,
      "text": "I've also had swollen ankles, since last Tuesday. There was pain in my breastbone wound, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.18,
      "end_seconds": 84.47,
      "duration_seconds": 2.29,
      "text": "And breathlessness, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.5,
      "end_seconds": 87.92,
      "duration_seconds": 2.42,
      "text": "I haven't noticed any breathlessness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.19,
      "end_seconds": 95.39,
      "duration_seconds": 6.2,
      "text": "Let me check a few things. Any fever or chest pain on exertion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.21,
      "end_seconds": 102.42,
      "duration_seconds": 5.21,
      "text": "I haven't had fever or chest pain on exertion, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.76,
      "end_seconds": 105.07,
      "duration_seconds": 2.31,
      "text": "Right, right. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.67,
      "end_seconds": 108.92,
      "duration_seconds": 2.25,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.62,
      "end_seconds": 112.58,
      "duration_seconds": 2.96,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.91,
      "end_seconds": 121.95,
      "duration_seconds": 5.04,
      "text": "My father has Parkinson's disease. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.73,
      "end_seconds": 127.04,
      "duration_seconds": 4.31,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 128.52,
      "end_seconds": 134.55,
      "duration_seconds": 6.03,
      "text": "She takes metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.77,
      "end_seconds": 140.29,
      "duration_seconds": 2.52,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 141.54,
      "end_seconds": 142.91,
      "duration_seconds": 1.37,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.39,
      "end_seconds": 151.71,
      "duration_seconds": 3.32,
      "text": "Seretide inhaler I don't take anymore."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.84,
      "end_seconds": 157.3,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.48,
      "end_seconds": 163.8,
      "duration_seconds": 5.32,
      "text": "Yes, heart disease. Asthma, for five years. I have low haemoglobin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.81,
      "end_seconds": 171.87,
      "duration_seconds": 7.06,
      "text": "Okay, I can see asthma and low haemoglobin in your file as well. Who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.38,
      "end_seconds": 175.81,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.92,
      "end_seconds": 179.72,
      "duration_seconds": 2.8,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.57,
      "end_seconds": 185.62,
      "duration_seconds": 5.05,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.55,
      "end_seconds": 202.93,
      "duration_seconds": 3.38,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.45,
      "end_seconds": 212.32,
      "duration_seconds": 4.87,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.02,
      "end_seconds": 217.73,
      "duration_seconds": 3.71,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.03,
      "end_seconds": 228.09,
      "duration_seconds": 9.06,
      "text": "I had a reaction to trimethoprim when I was younger, itching, and I've avoided it since."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 228.96,
      "end_seconds": 238.82,
      "duration_seconds": 9.86,
      "text": "Here are the numbers, doctor. Temp 36.5 degrees, pulse is 68 beats a minute, pressure 111 over 81. Oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.9,
      "end_seconds": 241.6,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.29,
      "end_seconds": 246.91,
      "duration_seconds": 3.62,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.29,
      "end_seconds": 250.68,
      "duration_seconds": 2.39,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.15,
      "end_seconds": 278.87,
      "duration_seconds": 9.72,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.59,
      "end_seconds": 284.34,
      "duration_seconds": 1.75,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.99,
      "end_seconds": 312.27,
      "duration_seconds": 11.28,
      "text": "Right, here's what I'm thinking. It fits best with recovering well after bypass surgery. It could also be a leg wound infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.88,
      "end_seconds": 317.12,
      "duration_seconds": 3.24,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.31,
      "end_seconds": 328.21,
      "duration_seconds": 9.9,
      "text": "I understand the worry. At the moment I'd say it's recovering well after bypass surgery, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 331.77,
      "end_seconds": 335.2,
      "duration_seconds": 3.43,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.23,
      "end_seconds": 344.37,
      "duration_seconds": 8.14,
      "text": "Okay, I'll take a look at that. I'm going to order blood tests, for post-operative review."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.83,
      "end_seconds": 347.74,
      "duration_seconds": 1.91,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.53,
      "end_seconds": 364.36,
      "duration_seconds": 14.83,
      "text": "Walk daily, no heavy lifting for six weeks and no driving until you are cleared. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 365.2,
      "end_seconds": 367.35,
      "duration_seconds": 2.15,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.91,
      "end_seconds": 370.45,
      "duration_seconds": 2.54,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 372.19,
      "end_seconds": 375.33,
      "duration_seconds": 3.14,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}