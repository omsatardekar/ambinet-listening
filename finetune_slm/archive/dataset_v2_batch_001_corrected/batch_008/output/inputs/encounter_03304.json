{
  "schema_version": "1.0",
  "encounter_id": "03304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 2.87,
      "duration_seconds": 2.02,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.84,
      "end_seconds": 7.93,
      "duration_seconds": 3.09,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.73,
      "end_seconds": 16.34,
      "duration_seconds": 6.61,
      "text": "Hmm, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.02,
      "end_seconds": 23.1,
      "duration_seconds": 6.08,
      "text": "Of course, please stay. It's helpful to have you here. Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.47,
      "end_seconds": 30.86,
      "duration_seconds": 6.39,
      "text": "Right, doctor, it's nausea after the chemotherapy. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.95,
      "end_seconds": 36.24,
      "duration_seconds": 3.29,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.03,
      "end_seconds": 41.91,
      "duration_seconds": 3.88,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.7,
      "end_seconds": 50.36,
      "duration_seconds": 7.66,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.46,
      "end_seconds": 56.05,
      "duration_seconds": 5.59,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.07,
      "end_seconds": 59.79,
      "duration_seconds": 2.72,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.78,
      "end_seconds": 65.44,
      "duration_seconds": 4.66,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.1,
      "end_seconds": 72.65,
      "duration_seconds": 6.55,
      "text": "Oh, and numb fingertips. That's been about the same, about four days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.88,
      "end_seconds": 76.26,
      "duration_seconds": 2.38,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 89.84,
      "duration_seconds": 11.92,
      "text": "Mm, uh, yes, I had a mole taken off my arm, a few years ago. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.62,
      "end_seconds": 93.74,
      "duration_seconds": 2.12,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.26,
      "end_seconds": 103.93,
      "duration_seconds": 8.67,
      "text": "I've got COPD. I've had thin bones, yes. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.86,
      "end_seconds": 105.56,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.58,
      "end_seconds": 112.8,
      "duration_seconds": 6.22,
      "text": "Yes, depression. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.68,
      "end_seconds": 124.14,
      "duration_seconds": 10.46,
      "text": "Okay, I can see thin bones and depression in your file as well. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.75,
      "end_seconds": 134.47,
      "duration_seconds": 4.72,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.75,
      "end_seconds": 149.88,
      "duration_seconds": 6.13,
      "text": "Let's run through your medicines. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.71,
      "end_seconds": 156.01,
      "duration_seconds": 4.3,
      "text": "Hmm, I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.75,
      "end_seconds": 166.06,
      "duration_seconds": 8.31,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.4,
      "end_seconds": 170.35,
      "duration_seconds": 2.95,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.23,
      "end_seconds": 188.67,
      "duration_seconds": 13.44,
      "text": "For my mood, I believe. My wife sets them out for me, I just take what I'm given. I'm on ondansetron, 8 milligrams, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 194.75,
      "end_seconds": 204.43,
      "duration_seconds": 9.68,
      "text": "Doctor, I think the last prescription for the ondansetron was 16 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.31,
      "end_seconds": 209.22,
      "duration_seconds": 2.91,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.93,
      "end_seconds": 213.98,
      "duration_seconds": 4.05,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.47,
      "end_seconds": 223.21,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.03,
      "end_seconds": 228.88,
      "duration_seconds": 3.85,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.41,
      "end_seconds": 233.29,
      "duration_seconds": 2.88,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.05,
      "end_seconds": 239.63,
      "duration_seconds": 4.58,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.47,
      "end_seconds": 244.97,
      "duration_seconds": 4.5,
      "text": "Let me check a few things. Any breathlessness, shivering or bleeding?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.61,
      "end_seconds": 259.04,
      "duration_seconds": 12.43,
      "text": "No, no breathlessness, no shivering, no bleeding. I did have being very tired at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.94,
      "end_seconds": 261.33,
      "duration_seconds": 1.39,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.91,
      "end_seconds": 264.52,
      "duration_seconds": 1.61,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 270.04,
      "end_seconds": 274.55,
      "duration_seconds": 4.51,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.99,
      "end_seconds": 286.79,
      "duration_seconds": 6.8,
      "text": "Um, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.61,
      "end_seconds": 295.42,
      "duration_seconds": 7.81,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.3,
      "end_seconds": 301.34,
      "duration_seconds": 2.04,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.61,
      "end_seconds": 305.14,
      "duration_seconds": 2.53,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.19,
      "end_seconds": 310.81,
      "duration_seconds": 4.62,
      "text": "I mean, um, no, that's all fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.61,
      "end_seconds": 314.05,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.02,
      "end_seconds": 329.3,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.78,
      "end_seconds": 346.51,
      "duration_seconds": 6.73,
      "text": "Okay: blood pressure 116 over 76, saturation 99 percent, temp 36.8 degrees, pulse 80."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.84,
      "end_seconds": 351.28,
      "duration_seconds": 3.44,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.19,
      "end_seconds": 356.11,
      "duration_seconds": 2.92,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.49,
      "end_seconds": 377.26,
      "duration_seconds": 4.77,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.91,
      "end_seconds": 408.28,
      "duration_seconds": 28.37,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. It fits best with expected chemotherapy side effects. The reason I say that is that your story and my examination fit together. Another possibility is an infection. Stop me if I've got anything wrong. You've had nausea after the chemotherapy for about a week, and no shivering or breathlessness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.14,
      "end_seconds": 414.8,
      "duration_seconds": 1.66,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.67,
      "end_seconds": 437.04,
      "duration_seconds": 20.37,
      "text": "Call the chemotherapy helpline straight away if your temperature goes over 37.5. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 438.63,
      "end_seconds": 442.4,
      "duration_seconds": 3.77,
      "text": "Mm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.86,
      "end_seconds": 445.33,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}