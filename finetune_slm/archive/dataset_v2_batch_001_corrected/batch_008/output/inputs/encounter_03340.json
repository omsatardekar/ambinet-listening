{
  "schema_version": "1.0",
  "encounter_id": "03340",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.17,
      "duration_seconds": 5.16,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 11.54,
      "duration_seconds": 4.16,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 18.78,
      "duration_seconds": 5.75,
      "text": "I've been feeling faint. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.31,
      "end_seconds": 22.17,
      "duration_seconds": 2.86,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.45,
      "end_seconds": 31.44,
      "duration_seconds": 1.99,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.93,
      "end_seconds": 54.88,
      "duration_seconds": 7.95,
      "text": "okay: blood pressure 97 over 64, pulse 102, temperature 36.5. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.48,
      "end_seconds": 58.96,
      "duration_seconds": 3.48,
      "text": "it's been three days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.71,
      "end_seconds": 66.46,
      "duration_seconds": 2.75,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.37,
      "end_seconds": 71.55,
      "duration_seconds": 3.18,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.05,
      "end_seconds": 76.49,
      "duration_seconds": 4.44,
      "text": "I follow. Have you noticed leg swelling, cough or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.76,
      "end_seconds": 82.23,
      "duration_seconds": 4.47,
      "text": "I haven't had leg swelling, cough or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.63,
      "end_seconds": 87.43,
      "duration_seconds": 4.8,
      "text": "Yes, carry on. Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.2,
      "end_seconds": 91.32,
      "duration_seconds": 2.12,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.13,
      "end_seconds": 103.85,
      "duration_seconds": 3.72,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.89,
      "end_seconds": 113.85,
      "duration_seconds": 3.96,
      "text": "I have heart disease, for five years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.3,
      "end_seconds": 116.61,
      "duration_seconds": 1.31,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.92,
      "end_seconds": 136.62,
      "duration_seconds": 2.7,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.27,
      "end_seconds": 143.03,
      "duration_seconds": 5.76,
      "text": "I take metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.64,
      "end_seconds": 147.71,
      "duration_seconds": 3.07,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.68,
      "end_seconds": 155.44,
      "duration_seconds": 5.76,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.51,
      "end_seconds": 159.96,
      "duration_seconds": 2.45,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.46,
      "end_seconds": 163.82,
      "duration_seconds": 3.36,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.61,
      "end_seconds": 168.36,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.45,
      "end_seconds": 171.39,
      "duration_seconds": 1.94,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.32,
      "end_seconds": 176.58,
      "duration_seconds": 3.26,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.66,
      "end_seconds": 180.45,
      "duration_seconds": 1.79,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.26,
      "end_seconds": 187.16,
      "duration_seconds": 3.9,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.21,
      "end_seconds": 190.99,
      "duration_seconds": 1.78,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.91,
      "end_seconds": 193.2,
      "duration_seconds": 1.29,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 218.88,
      "duration_seconds": 7.52,
      "text": "your neck veins are swollen, the heart sounds are muffled and your blood pressure is low"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.07,
      "end_seconds": 225.46,
      "duration_seconds": 2.39,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.3,
      "end_seconds": 251.41,
      "duration_seconds": 14.11,
      "text": "Let me tell you where I've got to. It's hard to say. Possible cardiac tamponade is one possibility and a heart attack another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.43,
      "end_seconds": 256.66,
      "duration_seconds": 2.23,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.31,
      "end_seconds": 267.33,
      "duration_seconds": 10.02,
      "text": "I understand the worry. At the moment I'd say it's possible cardiac tamponade, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.2,
      "end_seconds": 297.61,
      "duration_seconds": 13.41,
      "text": "let's get an ECG, for chest pain you need an urgent heart scan and possibly a drain let's plan a check straight away anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.46,
      "end_seconds": 302.67,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.69,
      "end_seconds": 305.09,
      "duration_seconds": 1.4,
      "text": "All the best."
    }
  ]
}