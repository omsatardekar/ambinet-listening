{
  "schema_version": "1.0",
  "encounter_id": "03260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.91,
      "duration_seconds": 3.66,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.46,
      "end_seconds": 11.29,
      "duration_seconds": 4.83,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.04,
      "end_seconds": 15.43,
      "duration_seconds": 3.39,
      "text": "I've been feeling anxious and agitated."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.1,
      "end_seconds": 19.97,
      "duration_seconds": 2.87,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.22,
      "end_seconds": 37.24,
      "duration_seconds": 16.02,
      "text": "Six months, I think... sorry, about a month, I got that wrong. I've been reading about it online and it worried me. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.1,
      "end_seconds": 42.64,
      "duration_seconds": 3.54,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.85,
      "end_seconds": 47.76,
      "duration_seconds": 3.91,
      "text": "Yeah, about a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.31,
      "end_seconds": 51.72,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.78,
      "end_seconds": 65.21,
      "duration_seconds": 12.43,
      "text": "Being unable to sleep goes along with it, most of the time. Um, about being unable to sleep, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.88,
      "end_seconds": 69.46,
      "duration_seconds": 1.58,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.01,
      "end_seconds": 71.92,
      "duration_seconds": 1.91,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.62,
      "end_seconds": 76.46,
      "duration_seconds": 2.84,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.19,
      "end_seconds": 84.43,
      "duration_seconds": 6.24,
      "text": "It's mild, honestly. I've also had shaking, for five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.01,
      "end_seconds": 91.24,
      "duration_seconds": 5.23,
      "text": "Have you been feeling anxious and agitated at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.02,
      "end_seconds": 103.7,
      "duration_seconds": 8.68,
      "text": "So, yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.38,
      "end_seconds": 105.57,
      "duration_seconds": 1.19,
      "text": "What about confusion?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.44,
      "end_seconds": 109.19,
      "duration_seconds": 1.75,
      "text": "No, no confusion."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.52,
      "end_seconds": 114.56,
      "duration_seconds": 4.04,
      "text": "Did you get seizure, seeing things or vomiting blood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.07,
      "end_seconds": 118.57,
      "duration_seconds": 3.5,
      "text": "Oh, no, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 122.05,
      "duration_seconds": 2.42,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.63,
      "end_seconds": 129.9,
      "duration_seconds": 2.27,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.44,
      "end_seconds": 135.92,
      "duration_seconds": 4.48,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.87,
      "end_seconds": 143.79,
      "duration_seconds": 5.92,
      "text": "My cousin has psoriasis. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.76,
      "end_seconds": 148.38,
      "duration_seconds": 3.62,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.39,
      "end_seconds": 163.49,
      "duration_seconds": 14.1,
      "text": "Anxiety, for nearly five years. I took the morning off to come in today. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 165.79,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.37,
      "end_seconds": 183.56,
      "duration_seconds": 4.19,
      "text": "So, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.02,
      "end_seconds": 190.33,
      "duration_seconds": 5.31,
      "text": "I mean, I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.81,
      "end_seconds": 200.49,
      "duration_seconds": 4.68,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.04,
      "end_seconds": 213.49,
      "duration_seconds": 12.45,
      "text": "Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.99,
      "end_seconds": 232.71,
      "duration_seconds": 2.72,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.38,
      "end_seconds": 239.85,
      "duration_seconds": 6.47,
      "text": "So, I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.16,
      "end_seconds": 243.82,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.67,
      "end_seconds": 254.01,
      "duration_seconds": 3.34,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.27,
      "end_seconds": 276.47,
      "duration_seconds": 11.2,
      "text": "Okay: temp 36.9 degrees, respiratory rate 20, blood pressure 115 over 83, pulse is 113 beats a minute, saturation 97 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.52,
      "end_seconds": 279.07,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.55,
      "end_seconds": 287.18,
      "duration_seconds": 2.63,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.97,
      "end_seconds": 295.75,
      "duration_seconds": 5.78,
      "text": "Right, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.09,
      "end_seconds": 300.3,
      "duration_seconds": 3.21,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.73,
      "end_seconds": 315.9,
      "duration_seconds": 5.17,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.06,
      "end_seconds": 330.61,
      "duration_seconds": 12.55,
      "text": "Okay, that's enough for me. From what you've told me and what I found, it points towards alcohol withdrawal. It could also be an anxiety state, so we'll keep that open."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.2,
      "end_seconds": 353.83,
      "duration_seconds": 4.63,
      "text": "I'm sending you for blood tests because of alcohol withdrawal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 354.41,
      "end_seconds": 357.75,
      "duration_seconds": 3.34,
      "text": "I can book that for Thursday at 2 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.02,
      "end_seconds": 360.2,
      "duration_seconds": 1.18,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.98,
      "end_seconds": 381.42,
      "duration_seconds": 19.44,
      "text": "I'd like you to take chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. That's for alcohol withdrawal. Do not stop alcohol suddenly without medical support. Let's get you seen by the alcohol liaison service, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.27,
      "end_seconds": 385.18,
      "duration_seconds": 1.91,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.48,
      "end_seconds": 391.18,
      "duration_seconds": 4.7,
      "text": "Come back in two days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.03,
      "end_seconds": 393.91,
      "duration_seconds": 1.88,
      "text": "That's clear, thanks."
    }
  ]
}