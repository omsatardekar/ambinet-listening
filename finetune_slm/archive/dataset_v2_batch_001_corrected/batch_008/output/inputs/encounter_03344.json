{
  "schema_version": "1.0",
  "encounter_id": "03344",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.01,
      "duration_seconds": 4.13,
      "text": "So, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 12.85,
      "duration_seconds": 6.08,
      "text": "Okay, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.8,
      "end_seconds": 20.52,
      "duration_seconds": 5.72,
      "text": "Um, so... headaches most days. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.09,
      "end_seconds": 23.65,
      "duration_seconds": 2.56,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.22,
      "end_seconds": 38.13,
      "duration_seconds": 12.91,
      "text": "Propranolol, 40 milligrams, twice a day for the migraine prevention. Okay, you know, so I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.73,
      "end_seconds": 41.73,
      "duration_seconds": 3.0,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.26,
      "end_seconds": 44.3,
      "duration_seconds": 2.04,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.03,
      "end_seconds": 48.85,
      "duration_seconds": 3.82,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.25,
      "end_seconds": 57.72,
      "duration_seconds": 7.47,
      "text": "Mm, it's been five days now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.55,
      "end_seconds": 67.35,
      "duration_seconds": 7.8,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.2,
      "end_seconds": 71.88,
      "duration_seconds": 3.68,
      "text": "It's severe, honestly. Painkillers helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.19,
      "end_seconds": 75.27,
      "duration_seconds": 2.08,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.22,
      "end_seconds": 78.88,
      "duration_seconds": 1.66,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.65,
      "end_seconds": 83.39,
      "duration_seconds": 2.74,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.29,
      "end_seconds": 86.55,
      "duration_seconds": 2.26,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.3,
      "end_seconds": 92.81,
      "duration_seconds": 5.51,
      "text": "Have you had headaches most days before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.36,
      "end_seconds": 100.19,
      "duration_seconds": 6.83,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.63,
      "end_seconds": 106.53,
      "duration_seconds": 4.9,
      "text": "A few quick ones: fever, stiff neck or visual changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.95,
      "end_seconds": 111.64,
      "duration_seconds": 3.69,
      "text": "Right, no, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.41,
      "end_seconds": 114.74,
      "duration_seconds": 1.33,
      "text": "Nothing like weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.14,
      "end_seconds": 117.61,
      "duration_seconds": 1.47,
      "text": "Definitely no weakness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.33,
      "end_seconds": 123.86,
      "duration_seconds": 4.53,
      "text": "Right, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.03,
      "end_seconds": 128.05,
      "duration_seconds": 3.02,
      "text": "Um, no, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.05,
      "end_seconds": 131.39,
      "duration_seconds": 2.34,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.64,
      "end_seconds": 137.95,
      "duration_seconds": 5.31,
      "text": "Um, um, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.13,
      "end_seconds": 158.24,
      "duration_seconds": 4.11,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.43,
      "end_seconds": 169.03,
      "duration_seconds": 9.6,
      "text": "I work in accounts at a hospital. I swim twice a week. My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.31,
      "end_seconds": 184.71,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.84,
      "end_seconds": 191.7,
      "duration_seconds": 5.86,
      "text": "Sorry, what was I saying, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.66,
      "end_seconds": 194.92,
      "duration_seconds": 2.26,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.23,
      "end_seconds": 206.74,
      "duration_seconds": 8.51,
      "text": "Migraines, for about ten years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.53,
      "end_seconds": 213.49,
      "duration_seconds": 0.96,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.79,
      "end_seconds": 225.21,
      "duration_seconds": 10.42,
      "text": "Um, um, I've had asthma for nearly five years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.28,
      "end_seconds": 236.83,
      "duration_seconds": 9.55,
      "text": "Right, so migraines is already on your record. We'll keep that in mind today. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.84,
      "end_seconds": 241.89,
      "duration_seconds": 3.05,
      "text": "Yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 257.46,
      "duration_seconds": 2.79,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 271.38,
      "duration_seconds": 2.85,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.5,
      "end_seconds": 295.53,
      "duration_seconds": 9.03,
      "text": "Okay: pulse 69, temperature is 36.9 degrees. And SpO2 98 percent on room air, BP is 116 over 73."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.13,
      "end_seconds": 297.83,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.79,
      "end_seconds": 302.45,
      "duration_seconds": 2.66,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.77,
      "end_seconds": 309.02,
      "duration_seconds": 4.25,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.71,
      "end_seconds": 312.93,
      "duration_seconds": 2.22,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.32,
      "end_seconds": 316.67,
      "duration_seconds": 2.35,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.84,
      "end_seconds": 329.94,
      "duration_seconds": 2.1,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.99,
      "end_seconds": 370.11,
      "duration_seconds": 35.12,
      "text": "Good, you can sit up again. Okay, so my impression is this: I can't pin this down yet. We're looking at medication-overuse headache on a background of migraine or tension-type headache. I think a headache diary makes sense here, for daily headache. Let's use amitriptyline, 10 milligrams, at night, long term. You take it by mouth. It's for headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.14,
      "end_seconds": 384.04,
      "duration_seconds": 11.9,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.16,
      "end_seconds": 389.57,
      "duration_seconds": 4.41,
      "text": "Um, uh, thank you, doctor, goodbye."
    }
  ]
}