{
  "schema_version": "1.0",
  "encounter_id": "03309",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 4.71,
      "duration_seconds": 3.41,
      "text": "hello, sorry about the delay, do sit"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.54,
      "end_seconds": 7.47,
      "duration_seconds": 0.93,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 10.55,
      "duration_seconds": 1.8,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.13,
      "end_seconds": 18.5,
      "duration_seconds": 7.37,
      "text": "Mainly mouth ulcers. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.77,
      "end_seconds": 24.84,
      "duration_seconds": 2.07,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 30.23,
      "duration_seconds": 3.86,
      "text": "it's been going on for five days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.72,
      "end_seconds": 34.95,
      "duration_seconds": 3.23,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 48.36,
      "duration_seconds": 12.21,
      "text": "pretty moderate, if I'm being honest there's bloating when I slip up as well as for bloating when I slip up, mostly mild"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.04,
      "end_seconds": 52.19,
      "duration_seconds": 3.15,
      "text": "Have you had a rash on your elbows?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.75,
      "end_seconds": 61.77,
      "duration_seconds": 9.02,
      "text": "yes, for three weeks. Well, I did have tiredness at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.26,
      "end_seconds": 69.39,
      "duration_seconds": 6.13,
      "text": "Have you had mouth ulcers before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.99,
      "end_seconds": 79.68,
      "duration_seconds": 8.69,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 81.23,
      "end_seconds": 93.99,
      "duration_seconds": 12.76,
      "text": "Doctor I've got the readings for you. Pulse is 81 beats a minute BP is 123 over 68 BMI works out to 24.0 height 179 centimetres weight 77 kilos respiratory rate 15."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.7,
      "end_seconds": 100.67,
      "duration_seconds": 5.97,
      "text": "okay, noted let me check a few things any diarrhoea or bone pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.4,
      "end_seconds": 106.61,
      "duration_seconds": 4.21,
      "text": "I haven't had diarrhoea or bone pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.19,
      "end_seconds": 112.2,
      "duration_seconds": 5.01,
      "text": "Let me check a few things. Any vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.9,
      "end_seconds": 116.53,
      "duration_seconds": 2.63,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.14,
      "end_seconds": 122.14,
      "duration_seconds": 4.0,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.66,
      "end_seconds": 126.08,
      "duration_seconds": 2.42,
      "text": "no nothing with my heart"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.08,
      "end_seconds": 132.68,
      "duration_seconds": 2.6,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.74,
      "end_seconds": 136.21,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.01,
      "end_seconds": 157.52,
      "duration_seconds": 3.51,
      "text": "Let me ask about allergies anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.37,
      "end_seconds": 166.79,
      "duration_seconds": 7.42,
      "text": "Years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.59,
      "end_seconds": 168.45,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.09,
      "end_seconds": 172.46,
      "duration_seconds": 3.37,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.29,
      "end_seconds": 176.09,
      "duration_seconds": 2.8,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.61,
      "end_seconds": 181.23,
      "duration_seconds": 3.62,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.82,
      "end_seconds": 187.27,
      "duration_seconds": 2.45,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.07,
      "end_seconds": 191.76,
      "duration_seconds": 3.69,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.01,
      "end_seconds": 194.95,
      "duration_seconds": 1.94,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.86,
      "end_seconds": 200.91,
      "duration_seconds": 5.05,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.89,
      "end_seconds": 219.95,
      "duration_seconds": 3.06,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.33,
      "end_seconds": 229.53,
      "duration_seconds": 5.2,
      "text": "My sister had breast cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.25,
      "end_seconds": 234.35,
      "duration_seconds": 4.1,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.86,
      "end_seconds": 238.87,
      "duration_seconds": 3.01,
      "text": "I have gout, for five years"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.6,
      "end_seconds": 240.54,
      "duration_seconds": 0.94,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.33,
      "end_seconds": 242.73,
      "duration_seconds": 1.4,
      "text": "I have migraines"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.48,
      "end_seconds": 255.05,
      "duration_seconds": 6.57,
      "text": "hm, okay right, so migraines is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.89,
      "end_seconds": 274.88,
      "duration_seconds": 2.99,
      "text": "alright, tell me your medicines, please"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.8,
      "end_seconds": 281.44,
      "duration_seconds": 5.64,
      "text": "Yeah I take febuxostat once a day for the gout."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.98,
      "end_seconds": 285.01,
      "duration_seconds": 2.03,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.37,
      "end_seconds": 290.98,
      "duration_seconds": 4.61,
      "text": "It's 80 milligrams. It's sumatriptan 50 milligrams when needed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 291.58,
      "end_seconds": 296.72,
      "duration_seconds": 5.14,
      "text": "Doctor, our chart from the last visit lists it as 100 milligrams."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.28,
      "end_seconds": 302.37,
      "duration_seconds": 4.09,
      "text": "I see. Is the the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.5,
      "end_seconds": 307.99,
      "duration_seconds": 4.49,
      "text": "I don't think I have it with me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.59,
      "end_seconds": 322.9,
      "duration_seconds": 14.31,
      "text": "Let me tell you where I've got to. It points towards coeliac disease on a gluten-free diet with some accidental exposure. It could also be iron deficiency, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.75,
      "end_seconds": 327.54,
      "duration_seconds": 3.79,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.75,
      "end_seconds": 344.96,
      "duration_seconds": 16.21,
      "text": "I understand the the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure and we'll watch how it goes. Check labels carefully and use separate toasters and chopping boards."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.31,
      "end_seconds": 354.65,
      "duration_seconds": 9.34,
      "text": "yes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.29,
      "end_seconds": 360.49,
      "duration_seconds": 5.2,
      "text": "that's fine by me can you send me for coeliac antibodies?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.14,
      "end_seconds": 383.0,
      "duration_seconds": 20.86,
      "text": "I don't think that's needed at this stage, the history doesn't call for it if the symptoms get worse, or you feel really unwell, please come to the emergency department we'll catch up in twelve months i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.55,
      "end_seconds": 385.64,
      "duration_seconds": 2.09,
      "text": "thank you, doctor, goodbye"
    }
  ]
}