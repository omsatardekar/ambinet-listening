{
  "schema_version": "1.0",
  "encounter_id": "03291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 3.19,
      "duration_seconds": 2.25,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.53,
      "end_seconds": 5.58,
      "duration_seconds": 1.05,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.18,
      "end_seconds": 10.89,
      "duration_seconds": 3.71,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.89,
      "end_seconds": 17.84,
      "duration_seconds": 5.95,
      "text": "Please do. Extra information is always welcome. Okay, where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.56,
      "end_seconds": 23.13,
      "duration_seconds": 4.57,
      "text": "He's been having a clicking in the breastbone, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.14,
      "end_seconds": 25.54,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.51,
      "end_seconds": 32.24,
      "duration_seconds": 5.73,
      "text": "Three weeks, I think... sorry, about two weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.85,
      "end_seconds": 35.86,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.26,
      "end_seconds": 41.24,
      "duration_seconds": 3.98,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.8,
      "end_seconds": 47.9,
      "duration_seconds": 6.1,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 48.0,
      "end_seconds": 54.17,
      "duration_seconds": 6.17,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.32,
      "end_seconds": 58.47,
      "duration_seconds": 3.15,
      "text": "So, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.41,
      "end_seconds": 69.01,
      "duration_seconds": 9.6,
      "text": "I've also had tiredness, for two weeks. Oh, and pain in my breastbone wound. Had that since this morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 72.95,
      "duration_seconds": 1.88,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.75,
      "end_seconds": 77.47,
      "duration_seconds": 2.72,
      "text": "I notice it more with coughing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.02,
      "end_seconds": 85.24,
      "duration_seconds": 7.22,
      "text": "Mm-hmm. So, have you had a clicking in the breastbone before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.21,
      "end_seconds": 96.46,
      "duration_seconds": 7.25,
      "text": "I, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.0,
      "end_seconds": 117.33,
      "duration_seconds": 6.33,
      "text": "Let me check a few things. Any chest pain on exertion, breathlessness or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 130.04,
      "duration_seconds": 12.11,
      "text": "No, no chest pain on exertion, no breathlessness, no fever. I did have swollen ankles at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.61,
      "end_seconds": 136.07,
      "duration_seconds": 3.46,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.67,
      "end_seconds": 139.58,
      "duration_seconds": 1.91,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.61,
      "end_seconds": 145.67,
      "duration_seconds": 2.06,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.96,
      "end_seconds": 148.37,
      "duration_seconds": 1.41,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.6,
      "end_seconds": 161.53,
      "duration_seconds": 2.93,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.82,
      "end_seconds": 165.39,
      "duration_seconds": 2.57,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.52,
      "end_seconds": 168.61,
      "duration_seconds": 2.09,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.13,
      "end_seconds": 176.91,
      "duration_seconds": 6.78,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.57,
      "end_seconds": 180.05,
      "duration_seconds": 2.48,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.21,
      "end_seconds": 196.74,
      "duration_seconds": 15.53,
      "text": "For my heart, I believe. My son sets them out for me, I just take what I'm given. Um, I'm on glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.26,
      "end_seconds": 200.61,
      "duration_seconds": 2.35,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.5,
      "end_seconds": 205.76,
      "duration_seconds": 3.26,
      "text": "I've got heart disease. I've got diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.34,
      "end_seconds": 214.44,
      "duration_seconds": 8.1,
      "text": "I see, go ahead. Yes, heart disease is known to us, good to have that clear. What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.35,
      "end_seconds": 219.87,
      "duration_seconds": 4.52,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.33,
      "end_seconds": 224.69,
      "duration_seconds": 3.36,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.69,
      "end_seconds": 228.72,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.38,
      "end_seconds": 232.13,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.67,
      "end_seconds": 244.83,
      "duration_seconds": 12.16,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.96,
      "end_seconds": 248.52,
      "duration_seconds": 2.56,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 255.26,
      "duration_seconds": 4.81,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 256.44,
      "end_seconds": 266.55,
      "duration_seconds": 10.11,
      "text": "Here are the numbers, doctor. Pulse 81, respiratory rate 14. Temp 36.8 degrees, BP is 114 over 71, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 268.53,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.43,
      "end_seconds": 273.25,
      "duration_seconds": 2.82,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.35,
      "end_seconds": 275.49,
      "duration_seconds": 1.14,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.63,
      "end_seconds": 277.87,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.69,
      "end_seconds": 306.5,
      "duration_seconds": 9.81,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.87,
      "end_seconds": 323.12,
      "duration_seconds": 13.25,
      "text": "You can relax now. Taking everything into account, this is probably recovering well after bypass surgery. It could also be a leg wound infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.28,
      "end_seconds": 329.47,
      "duration_seconds": 2.19,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.17,
      "end_seconds": 355.16,
      "duration_seconds": 20.99,
      "text": "I can't promise yet, but most people with recovering well after bypass surgery do well once it's treated properly. Let me just check I've got this right. You've had a clicking in the breastbone for about two weeks, and no chest pain on exertion or fever."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.69,
      "end_seconds": 357.32,
      "duration_seconds": 1.63,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 358.54,
      "end_seconds": 362.19,
      "duration_seconds": 3.65,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.06,
      "end_seconds": 387.75,
      "duration_seconds": 23.69,
      "text": "Right, thank you. I'd like to arrange blood tests for post-operative review. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. We'll refer you to the cardiac rehabilitation team. Book a review in six weeks. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.16,
      "end_seconds": 394.65,
      "duration_seconds": 5.49,
      "text": "So, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.52,
      "end_seconds": 400.14,
      "duration_seconds": 3.62,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 400.86,
      "end_seconds": 405.49,
      "duration_seconds": 4.63,
      "text": "Mm, okay, that makes sense. Thanks for explaining."
    }
  ]
}