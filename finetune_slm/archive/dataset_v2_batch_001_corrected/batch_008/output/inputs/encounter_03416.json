{
  "schema_version": "1.0",
  "encounter_id": "03416",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 10.88,
      "duration_seconds": 9.49,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.6,
      "end_seconds": 15.68,
      "duration_seconds": 3.08,
      "text": "thank you right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.2,
      "end_seconds": 31.3,
      "duration_seconds": 9.1,
      "text": "It's a high sugar test in pregnancy. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.31,
      "end_seconds": 35.26,
      "duration_seconds": 2.95,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.32,
      "end_seconds": 55.89,
      "duration_seconds": 16.57,
      "text": "it's been about a month, I'm fairly sure i'm not great at remembering details, so bear with me work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.49,
      "end_seconds": 59.21,
      "duration_seconds": 2.72,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.87,
      "end_seconds": 62.2,
      "duration_seconds": 1.33,
      "text": "Mild, really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.5,
      "end_seconds": 69.38,
      "duration_seconds": 5.88,
      "text": "Right, what about a big baby on the scan, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.0,
      "end_seconds": 78.27,
      "duration_seconds": 8.27,
      "text": "Yeah, that too. Oh, and no symptoms. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.57,
      "end_seconds": 86.01,
      "duration_seconds": 6.44,
      "text": "Have you had a high sugar test in pregnancy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 96.22,
      "duration_seconds": 8.46,
      "text": "yes, you know, something like this happened last year, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 97.52,
      "end_seconds": 105.88,
      "duration_seconds": 8.36,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, temp 36.8 degrees, blood pressure 122 over 69. Heart rate 72."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.84,
      "end_seconds": 108.35,
      "duration_seconds": 1.51,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.84,
      "end_seconds": 112.13,
      "duration_seconds": 2.29,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.58,
      "end_seconds": 114.92,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.58,
      "end_seconds": 132.99,
      "duration_seconds": 5.41,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.87,
      "end_seconds": 151.57,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.54,
      "end_seconds": 161.34,
      "duration_seconds": 6.8,
      "text": "All finished, thank you. Alright, and what about blurred vision, reduced baby movements or thirst?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.4,
      "end_seconds": 166.08,
      "duration_seconds": 3.68,
      "text": "Hmm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.51,
      "end_seconds": 171.12,
      "duration_seconds": 4.61,
      "text": "I follow. Any sign of passing a lot of urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.73,
      "end_seconds": 177.16,
      "duration_seconds": 5.43,
      "text": "Not at all, no passing a lot of urine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.35,
      "end_seconds": 182.3,
      "duration_seconds": 3.95,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.36,
      "end_seconds": 186.84,
      "duration_seconds": 3.48,
      "text": "actually, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.86,
      "end_seconds": 189.16,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.44,
      "end_seconds": 193.69,
      "duration_seconds": 3.25,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.21,
      "end_seconds": 199.5,
      "duration_seconds": 4.29,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.44,
      "end_seconds": 206.56,
      "duration_seconds": 3.12,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.95,
      "end_seconds": 217.19,
      "duration_seconds": 3.24,
      "text": "right, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.55,
      "end_seconds": 229.61,
      "duration_seconds": 11.06,
      "text": "I've had COPD for about ten years now. I have acid reflux. I've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.61,
      "end_seconds": 235.64,
      "duration_seconds": 4.03,
      "text": "Yes, carry on. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.7,
      "end_seconds": 247.37,
      "duration_seconds": 10.67,
      "text": "I take Tiotropium inhaler, once a day for my chest. I'm on pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.82,
      "end_seconds": 252.46,
      "duration_seconds": 4.64,
      "text": "I see, go ahead. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.18,
      "end_seconds": 262.23,
      "duration_seconds": 9.05,
      "text": "I swim twice a week. I grab fast food at lunch most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.63,
      "end_seconds": 279.59,
      "duration_seconds": 2.96,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 280.56,
      "end_seconds": 285.97,
      "duration_seconds": 5.41,
      "text": "Um, um, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.03,
      "end_seconds": 292.42,
      "duration_seconds": 5.39,
      "text": "taking everything into account, I'd lean towards gestational diabetes controllable with diet"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.41,
      "end_seconds": 297.82,
      "duration_seconds": 3.41,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.16,
      "end_seconds": 320.9,
      "duration_seconds": 21.74,
      "text": "Nothing I've seen today points to an emergency. It looks like gestational diabetes controllable with diet, but I'd like to confirm. A glucose meter and diary is what I'd like next, for gestational diabetes. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.39,
      "end_seconds": 326.28,
      "duration_seconds": 3.89,
      "text": "hmm, when would that take place?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.03,
      "end_seconds": 331.92,
      "duration_seconds": 4.89,
      "text": "A growth scan is what I'd like next, for gestational diabetes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.49,
      "end_seconds": 338.86,
      "duration_seconds": 5.37,
      "text": "Let me think, uh, when would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.47,
      "end_seconds": 347.89,
      "duration_seconds": 8.42,
      "text": "Replace sugary drinks and white starches with wholegrains and walk after meals. Book a review in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.57,
      "end_seconds": 350.43,
      "duration_seconds": 1.86,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.57,
      "end_seconds": 355.65,
      "duration_seconds": 4.08,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.2,
      "end_seconds": 359.62,
      "duration_seconds": 3.42,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}