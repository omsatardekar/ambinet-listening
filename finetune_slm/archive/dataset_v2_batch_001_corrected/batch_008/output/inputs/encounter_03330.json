{
  "schema_version": "1.0",
  "encounter_id": "03330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 5.12,
      "duration_seconds": 4.4,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 12.55,
      "duration_seconds": 3.63,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.47,
      "end_seconds": 17.73,
      "duration_seconds": 4.26,
      "text": "So, I've been feeling anxious and agitated, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 20.39,
      "duration_seconds": 1.42,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.24,
      "end_seconds": 28.68,
      "duration_seconds": 6.44,
      "text": "It's been one week now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 33.11,
      "duration_seconds": 2.76,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.91,
      "end_seconds": 36.36,
      "duration_seconds": 2.45,
      "text": "It's, It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.85,
      "end_seconds": 37.8,
      "duration_seconds": 0.95,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 46.78,
      "duration_seconds": 7.98,
      "text": "And I've been sweating as well, for two days. With sweating, it's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.41,
      "end_seconds": 52.64,
      "duration_seconds": 5.23,
      "text": "Have you been feeling anxious and agitated at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.46,
      "end_seconds": 60.19,
      "duration_seconds": 5.73,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.99,
      "end_seconds": 64.86,
      "duration_seconds": 3.87,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.57,
      "end_seconds": 79.52,
      "duration_seconds": 13.95,
      "text": "I take aspirin, 75 milligrams, once a day. Heavy drinking until two days ago, stopped two days ago. Clopidogrel I don't take anymore."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.49,
      "end_seconds": 84.06,
      "duration_seconds": 2.57,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.04,
      "end_seconds": 91.29,
      "duration_seconds": 6.25,
      "text": "Right, uh, yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.81,
      "end_seconds": 101.47,
      "duration_seconds": 2.66,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 107.16,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.68,
      "end_seconds": 112.09,
      "duration_seconds": 3.41,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.84,
      "end_seconds": 116.31,
      "duration_seconds": 3.47,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.98,
      "end_seconds": 119.22,
      "duration_seconds": 2.24,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.42,
      "end_seconds": 127.75,
      "duration_seconds": 4.33,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.35,
      "end_seconds": 140.29,
      "duration_seconds": 3.94,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 144.8,
      "duration_seconds": 2.91,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.75,
      "end_seconds": 150.05,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.07,
      "end_seconds": 166.17,
      "duration_seconds": 15.1,
      "text": "Um, I've had heart disease for about a year now. I thought it would sort itself out, but it hasn't. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.49,
      "end_seconds": 187.85,
      "duration_seconds": 4.36,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.1,
      "end_seconds": 192.66,
      "duration_seconds": 3.56,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.3,
      "end_seconds": 195.12,
      "duration_seconds": 1.82,
      "text": "Nothing like seeing things?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.62,
      "end_seconds": 199.21,
      "duration_seconds": 2.59,
      "text": "No seeing things, thankfully."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.39,
      "end_seconds": 209.2,
      "duration_seconds": 5.81,
      "text": "Let me check a few things. Any confusion, vomiting blood or seizure?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.41,
      "end_seconds": 214.05,
      "duration_seconds": 3.64,
      "text": "Yeah, no, not a single one."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.02,
      "end_seconds": 219.95,
      "duration_seconds": 3.93,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.86,
      "end_seconds": 228.39,
      "duration_seconds": 6.53,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.91,
      "end_seconds": 231.65,
      "duration_seconds": 2.74,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.28,
      "end_seconds": 244.84,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.55,
      "end_seconds": 272.54,
      "duration_seconds": 6.99,
      "text": "Okay: pulse 116, blood pressure 123 over 85. And respiratory rate 19, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.77,
      "end_seconds": 275.29,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.08,
      "end_seconds": 278.87,
      "duration_seconds": 2.79,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.7,
      "end_seconds": 285.67,
      "duration_seconds": 3.97,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.65,
      "end_seconds": 290.14,
      "duration_seconds": 2.49,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.37,
      "end_seconds": 314.15,
      "duration_seconds": 5.78,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.27,
      "end_seconds": 348.6,
      "duration_seconds": 32.33,
      "text": "Good, you can sit up again. So where does that leave us? The most likely explanation is alcohol withdrawal. Let's get blood tests, for alcohol withdrawal. That will help us see what's going on underneath and decide the next step. I'm going to put you on chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. It's for alcohol withdrawal. The treatment will be thiamine, 100 milligrams, three times a day, long term. It's for alcohol-related deficiency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.85,
      "end_seconds": 368.17,
      "duration_seconds": 18.32,
      "text": "Do not stop alcohol suddenly without medical support. I'm going to send a referral to the alcohol liaison service. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.93,
      "end_seconds": 373.09,
      "duration_seconds": 4.16,
      "text": "No, you know, that's all. Thanks a lot."
    }
  ]
}