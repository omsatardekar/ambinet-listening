{
  "schema_version": "1.0",
  "encounter_id": "03468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.99,
      "end_seconds": 7.52,
      "duration_seconds": 6.53,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.79,
      "end_seconds": 12.4,
      "duration_seconds": 3.61,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.91,
      "end_seconds": 21.95,
      "duration_seconds": 8.04,
      "text": "Right, I've been feeling faint. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.12,
      "end_seconds": 24.69,
      "duration_seconds": 1.57,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.48,
      "end_seconds": 28.29,
      "duration_seconds": 2.81,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.19,
      "end_seconds": 31.66,
      "duration_seconds": 2.47,
      "text": "Any chest pain as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.36,
      "end_seconds": 34.49,
      "duration_seconds": 1.13,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.21,
      "end_seconds": 39.51,
      "duration_seconds": 3.3,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.0,
      "end_seconds": 55.85,
      "duration_seconds": 14.85,
      "text": "Only sitting forward, and it's not much. I've also had shortness of breath, for ten days. As for shortness of breath, it settles a little with sitting forward."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.38,
      "end_seconds": 61.04,
      "duration_seconds": 4.66,
      "text": "Have you been feeling faint at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.12,
      "end_seconds": 69.4,
      "duration_seconds": 7.28,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.95,
      "end_seconds": 90.76,
      "duration_seconds": 3.81,
      "text": "Have you had any fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.53,
      "end_seconds": 95.11,
      "duration_seconds": 2.58,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.68,
      "end_seconds": 98.72,
      "duration_seconds": 3.04,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 102.97,
      "duration_seconds": 2.39,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.05,
      "end_seconds": 107.65,
      "duration_seconds": 2.6,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.82,
      "end_seconds": 114.42,
      "duration_seconds": 5.6,
      "text": "I've had eczema for about a year now. Yes, depression."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.2,
      "end_seconds": 120.4,
      "duration_seconds": 4.2,
      "text": "Okay, I can see depression in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 129.97,
      "duration_seconds": 2.33,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.56,
      "end_seconds": 147.47,
      "duration_seconds": 15.91,
      "text": "It's hydrocortisone cream, when needed for the eczema. I told myself I'd wait and see, and here I am. I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.51,
      "end_seconds": 151.38,
      "duration_seconds": 1.87,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.93,
      "end_seconds": 156.38,
      "duration_seconds": 4.45,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.92,
      "end_seconds": 161.4,
      "duration_seconds": 1.48,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.87,
      "end_seconds": 166.5,
      "duration_seconds": 3.63,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.26,
      "end_seconds": 174.46,
      "duration_seconds": 2.2,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.21,
      "end_seconds": 180.1,
      "duration_seconds": 4.89,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.02,
      "end_seconds": 184.54,
      "duration_seconds": 2.52,
      "text": "Alright, who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.59,
      "end_seconds": 189.16,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.33,
      "end_seconds": 194.02,
      "duration_seconds": 3.69,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.31,
      "end_seconds": 201.34,
      "duration_seconds": 2.03,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.47,
      "end_seconds": 206.86,
      "duration_seconds": 4.39,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.55,
      "end_seconds": 213.38,
      "duration_seconds": 4.83,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 216.83,
      "end_seconds": 227.5,
      "duration_seconds": 10.67,
      "text": "Here are the numbers, doctor. Pulse is 104 beats a minute, BP is 101 over 57, temperature is 36.6 degrees, saturation 97 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.77,
      "end_seconds": 230.08,
      "duration_seconds": 1.31,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.63,
      "end_seconds": 236.7,
      "duration_seconds": 4.07,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.7,
      "end_seconds": 240.65,
      "duration_seconds": 1.95,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.64,
      "end_seconds": 244.03,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.81,
      "end_seconds": 258.7,
      "duration_seconds": 6.89,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.94,
      "end_seconds": 261.42,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.2,
      "end_seconds": 273.0,
      "duration_seconds": 8.8,
      "text": "That's the examination finished. Right, here's what I'm thinking. I'd lean towards possible cardiac tamponade. A heart attack is still possible."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 274.18,
      "end_seconds": 277.21,
      "duration_seconds": 3.03,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.35,
      "end_seconds": 287.62,
      "duration_seconds": 9.27,
      "text": "Nothing I've seen today points to an emergency. It looks like possible cardiac tamponade, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.64,
      "end_seconds": 337.6,
      "duration_seconds": 34.96,
      "text": "An ECG is what I'd like next, for chest pain. An urgent echocardiogram is what I'd like next, for possible tamponade. It's a routine test and it'll give us a much clearer picture. You need an urgent heart scan and possibly a drain. We'll refer you to the cardiology team. Come back or go to emergency straight away if the symptoms get worse. Come back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.72,
      "end_seconds": 343.7,
      "duration_seconds": 4.98,
      "text": "No, you know, that's all. Thanks a lot."
    }
  ]
}