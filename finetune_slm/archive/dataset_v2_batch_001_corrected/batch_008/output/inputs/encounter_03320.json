{
  "schema_version": "1.0",
  "encounter_id": "03320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 7.47,
      "duration_seconds": 6.77,
      "text": "Good morning. I've just opened your notes. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.89,
      "end_seconds": 13.55,
      "duration_seconds": 4.66,
      "text": "Doctor, it's shaking. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.0,
      "end_seconds": 20.86,
      "duration_seconds": 2.86,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.69,
      "end_seconds": 22.91,
      "duration_seconds": 1.22,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.21,
      "end_seconds": 27.06,
      "duration_seconds": 2.85,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.04,
      "end_seconds": 31.94,
      "duration_seconds": 2.9,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.32,
      "end_seconds": 36.18,
      "duration_seconds": 2.86,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 39.64,
      "duration_seconds": 2.07,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.11,
      "end_seconds": 44.79,
      "duration_seconds": 3.68,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 60.58,
      "duration_seconds": 14.96,
      "text": "A eight out of ten, I suppose. I've been feeling anxious and agitated too, for three weeks. As for feeling anxious and agitated, I'd say moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.26,
      "end_seconds": 74.19,
      "duration_seconds": 3.93,
      "text": "A few quick ones: confusion, vomiting blood or seizure?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 78.56,
      "duration_seconds": 2.51,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.74,
      "end_seconds": 83.54,
      "duration_seconds": 3.8,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.66,
      "end_seconds": 87.06,
      "duration_seconds": 2.4,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.0,
      "end_seconds": 91.83,
      "duration_seconds": 3.83,
      "text": "Okay, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.39,
      "end_seconds": 95.09,
      "duration_seconds": 1.7,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.48,
      "end_seconds": 107.97,
      "duration_seconds": 4.49,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.68,
      "end_seconds": 111.38,
      "duration_seconds": 2.7,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.43,
      "end_seconds": 129.6,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.61,
      "end_seconds": 133.9,
      "duration_seconds": 3.29,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.54,
      "end_seconds": 136.88,
      "duration_seconds": 2.34,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 143.97,
      "duration_seconds": 5.0,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.03,
      "end_seconds": 147.44,
      "duration_seconds": 1.41,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.33,
      "end_seconds": 151.53,
      "duration_seconds": 3.2,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.09,
      "end_seconds": 155.81,
      "duration_seconds": 2.72,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.56,
      "end_seconds": 159.73,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.49,
      "end_seconds": 164.85,
      "duration_seconds": 3.36,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.8,
      "end_seconds": 170.25,
      "duration_seconds": 3.45,
      "text": "Yeah, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.79,
      "end_seconds": 174.8,
      "duration_seconds": 3.01,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.25,
      "end_seconds": 184.32,
      "duration_seconds": 3.07,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.91,
      "end_seconds": 209.3,
      "duration_seconds": 7.39,
      "text": "Okay: pulse is 126 beats a minute, blood pressure 114 over 82, temperature 36.6."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.23,
      "end_seconds": 211.63,
      "duration_seconds": 1.4,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.02,
      "end_seconds": 220.31,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.5,
      "end_seconds": 224.04,
      "duration_seconds": 2.54,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.59,
      "end_seconds": 228.89,
      "duration_seconds": 3.3,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.32,
      "end_seconds": 253.23,
      "duration_seconds": 5.91,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 261.2,
      "duration_seconds": 2.9,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.93,
      "end_seconds": 309.92,
      "duration_seconds": 37.99,
      "text": "From what you've told me and what I found, it fits best with alcohol withdrawal. The reason I say that is that your story and my examination fit together. I'll request blood tests, it'll help with alcohol withdrawal. I'm prescribing thiamine, 100 milligrams, three times a day, long term. That should help with alcohol-related deficiency. Do not stop alcohol suddenly without medical support. Do get help quickly if the symptoms get worse. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.5,
      "end_seconds": 312.96,
      "duration_seconds": 2.46,
      "text": "Alright, thanks, take care."
    }
  ]
}