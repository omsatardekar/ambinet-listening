{
  "schema_version": "1.0",
  "encounter_id": "03472",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 3.66,
      "duration_seconds": 3.11,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.77,
      "end_seconds": 9.15,
      "duration_seconds": 4.38,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.1,
      "end_seconds": 25.18,
      "duration_seconds": 15.08,
      "text": "Well, good afternoon, doctor. I look after them so I thought I'd come. Let me think, she's been having a high sugar test in pregnancy, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.13,
      "end_seconds": 30.24,
      "duration_seconds": 3.11,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.82,
      "end_seconds": 36.9,
      "duration_seconds": 6.08,
      "text": "Erm, uh, it's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.65,
      "end_seconds": 41.14,
      "duration_seconds": 2.49,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.95,
      "end_seconds": 58.3,
      "duration_seconds": 16.35,
      "text": "Severe, really. Oh, and a big baby on the scan. That's been about the same, five days. And no symptoms, too. With no symptoms, about a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.57,
      "end_seconds": 60.29,
      "duration_seconds": 1.72,
      "text": "Yes. What about alcohol?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.32,
      "end_seconds": 71.13,
      "duration_seconds": 4.81,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.21,
      "end_seconds": 74.08,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.77,
      "end_seconds": 81.18,
      "duration_seconds": 3.41,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.84,
      "end_seconds": 84.11,
      "duration_seconds": 2.27,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.41,
      "end_seconds": 89.42,
      "duration_seconds": 4.01,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.45,
      "end_seconds": 93.97,
      "duration_seconds": 2.52,
      "text": "Right, do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 100.61,
      "duration_seconds": 4.93,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.47,
      "end_seconds": 105.39,
      "duration_seconds": 2.92,
      "text": "Okay, do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.99,
      "end_seconds": 111.72,
      "duration_seconds": 4.73,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.4,
      "end_seconds": 117.85,
      "duration_seconds": 4.45,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.6,
      "end_seconds": 122.05,
      "duration_seconds": 2.45,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.58,
      "end_seconds": 124.56,
      "duration_seconds": 0.98,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.5,
      "end_seconds": 140.17,
      "duration_seconds": 14.67,
      "text": "I have epilepsy, for five years. My family kept telling me to get it checked. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.71,
      "end_seconds": 159.04,
      "duration_seconds": 4.33,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.12,
      "end_seconds": 165.19,
      "duration_seconds": 4.07,
      "text": "Escitalopram, once a day for my mood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.99,
      "end_seconds": 169.76,
      "duration_seconds": 2.77,
      "text": "Alright, do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.38,
      "end_seconds": 182.81,
      "duration_seconds": 11.43,
      "text": "10 milligrams, I think that's what's on the box. Well, I take levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.45,
      "end_seconds": 186.51,
      "duration_seconds": 3.06,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.68,
      "end_seconds": 190.1,
      "duration_seconds": 2.42,
      "text": "About about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.52,
      "end_seconds": 194.25,
      "duration_seconds": 2.73,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.23,
      "end_seconds": 202.86,
      "duration_seconds": 7.63,
      "text": "Oh, just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.9,
      "end_seconds": 208.02,
      "duration_seconds": 4.12,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.92,
      "end_seconds": 224.55,
      "duration_seconds": 14.63,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.12,
      "end_seconds": 231.18,
      "duration_seconds": 6.06,
      "text": "A few quick ones: reduced baby movements or passing a lot of urine?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.21,
      "end_seconds": 235.74,
      "duration_seconds": 3.53,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.27,
      "end_seconds": 239.96,
      "duration_seconds": 3.69,
      "text": "Hm, okay. Any thirst or blurred vision at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.66,
      "end_seconds": 245.7,
      "duration_seconds": 5.04,
      "text": "Mm, no thirst or blurred vision, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 252.06,
      "duration_seconds": 2.84,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.58,
      "end_seconds": 254.35,
      "duration_seconds": 1.77,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.37,
      "end_seconds": 271.76,
      "duration_seconds": 4.39,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.0,
      "end_seconds": 285.97,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.27,
      "end_seconds": 311.18,
      "duration_seconds": 13.91,
      "text": "Okay: pressure 118 over 72, saturation 99 percent, heart rate 70, weight 52 kilos, temp 36.9 degrees, height 161 centimetres, BMI works out to 20.1, respiratory rate 14."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.97,
      "end_seconds": 319.05,
      "duration_seconds": 5.08,
      "text": "So, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.06,
      "end_seconds": 322.01,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.27,
      "end_seconds": 346.09,
      "duration_seconds": 5.82,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.96,
      "end_seconds": 352.18,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.82,
      "end_seconds": 376.81,
      "duration_seconds": 13.99,
      "text": "Okay, so my impression is this: This is probably gestational diabetes controllable with diet. I'd like you to see the diabetes midwife as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.65,
      "end_seconds": 379.37,
      "duration_seconds": 1.72,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.83,
      "end_seconds": 383.96,
      "duration_seconds": 3.13,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.3,
      "end_seconds": 388.71,
      "duration_seconds": 3.41,
      "text": "Right, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.18,
      "end_seconds": 392.01,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}