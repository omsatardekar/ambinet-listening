{
  "schema_version": "1.0",
  "encounter_id": "03321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 4.66,
      "duration_seconds": 3.57,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.17,
      "end_seconds": 8.24,
      "duration_seconds": 3.07,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.56,
      "end_seconds": 13.05,
      "duration_seconds": 3.49,
      "text": "Alright, was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.67,
      "end_seconds": 21.68,
      "duration_seconds": 4.01,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.75,
      "end_seconds": 26.34,
      "duration_seconds": 2.59,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.01,
      "end_seconds": 34.53,
      "duration_seconds": 7.52,
      "text": "It's bloating when I slip up. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.35,
      "end_seconds": 40.75,
      "duration_seconds": 4.4,
      "text": "When did this begin? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.68,
      "end_seconds": 46.18,
      "duration_seconds": 3.5,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 58.39,
      "duration_seconds": 10.12,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 63.54,
      "duration_seconds": 4.23,
      "text": "Mostly moderate. Avoiding gluten helps a a bit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.36,
      "end_seconds": 67.32,
      "duration_seconds": 1.96,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.23,
      "end_seconds": 81.94,
      "duration_seconds": 13.71,
      "text": "When it starts I tend to to get a rash on my elbows as well. The rash on my elbows? That's been since this morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.97,
      "end_seconds": 97.88,
      "duration_seconds": 2.91,
      "text": "Any vomiting, bone pain or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.52,
      "end_seconds": 102.34,
      "duration_seconds": 2.82,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 104.99,
      "duration_seconds": 2.4,
      "text": "sure anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.11,
      "end_seconds": 107.8,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.23,
      "end_seconds": 127.07,
      "duration_seconds": 2.84,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.9,
      "end_seconds": 130.59,
      "duration_seconds": 1.69,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.39,
      "end_seconds": 153.88,
      "duration_seconds": 4.49,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.08,
      "end_seconds": 159.79,
      "duration_seconds": 4.71,
      "text": "no, you know, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 162.16,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.74,
      "end_seconds": 166.46,
      "duration_seconds": 2.72,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.17,
      "end_seconds": 173.52,
      "duration_seconds": 1.35,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.31,
      "end_seconds": 179.9,
      "duration_seconds": 4.59,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.1,
      "end_seconds": 182.73,
      "duration_seconds": 1.63,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.45,
      "end_seconds": 187.87,
      "duration_seconds": 3.42,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.85,
      "end_seconds": 194.18,
      "duration_seconds": 5.33,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.16,
      "end_seconds": 199.18,
      "duration_seconds": 3.02,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.05,
      "end_seconds": 203.92,
      "duration_seconds": 3.87,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.16,
      "end_seconds": 217.48,
      "duration_seconds": 2.32,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.78,
      "end_seconds": 236.54,
      "duration_seconds": 9.76,
      "text": "Okay: respiratory rate 18, saturation 97 percent, BP is 127 over 68, heart rate 70, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.47,
      "end_seconds": 238.82,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.69,
      "end_seconds": 243.56,
      "duration_seconds": 3.87,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 249.11,
      "duration_seconds": 4.46,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.48,
      "end_seconds": 258.95,
      "duration_seconds": 1.47,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.86,
      "end_seconds": 261.34,
      "duration_seconds": 1.48,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.11,
      "end_seconds": 283.9,
      "duration_seconds": 4.79,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.75,
      "end_seconds": 306.02,
      "duration_seconds": 16.27,
      "text": "thank you, you can get dressed. Having listened and examined, I don't have a clear answer today: coeliac disease on a gluten-free diet with some accidental exposure is possible, and so is iron deficiency"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.59,
      "end_seconds": 310.45,
      "duration_seconds": 2.86,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.48,
      "end_seconds": 348.98,
      "duration_seconds": 36.5,
      "text": "it's reasonable to be concerned, but right now coeliac disease on a gluten-free diet with some accidental exposure is my leading thought, not anything worse. Coeliac antibodies is what I'd like next, for coeliac follow-up. Check labels carefully and use separate toasters and chopping boards. A blood count is something we might do if this doesn't improve in a month. Book a review in twelve months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.03,
      "end_seconds": 355.57,
      "duration_seconds": 4.54,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}