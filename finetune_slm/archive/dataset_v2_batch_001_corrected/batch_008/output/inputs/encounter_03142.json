{
  "schema_version": "1.0",
  "encounter_id": "03142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 2.65,
      "duration_seconds": 1.65,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.34,
      "end_seconds": 8.41,
      "duration_seconds": 4.07,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.83,
      "end_seconds": 21.61,
      "duration_seconds": 8.78,
      "text": "Actually, it's a high sugar test in pregnancy. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.23,
      "end_seconds": 25.77,
      "duration_seconds": 3.54,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.6,
      "end_seconds": 30.7,
      "duration_seconds": 4.1,
      "text": "Uh, I've had it for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.35,
      "end_seconds": 34.31,
      "duration_seconds": 1.96,
      "text": "Any no symptoms as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.04,
      "end_seconds": 46.58,
      "duration_seconds": 11.54,
      "text": "Yes, about the same, two months. About no symptoms, moderate, really. Oh, and a big baby on the scan. Had that since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.97,
      "end_seconds": 51.25,
      "duration_seconds": 3.28,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.04,
      "end_seconds": 54.89,
      "duration_seconds": 1.85,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.89,
      "end_seconds": 58.05,
      "duration_seconds": 2.16,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.68,
      "end_seconds": 63.33,
      "duration_seconds": 3.65,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.65,
      "end_seconds": 68.4,
      "duration_seconds": 3.75,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.98,
      "end_seconds": 77.17,
      "duration_seconds": 7.19,
      "text": "I'm on something called lans... lansoprazole, 30 milligrams, maybe, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.71,
      "end_seconds": 82.71,
      "duration_seconds": 5.0,
      "text": "So, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.18,
      "end_seconds": 90.97,
      "duration_seconds": 6.79,
      "text": "No, it's at home. Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.39,
      "end_seconds": 109.87,
      "duration_seconds": 2.48,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.93,
      "end_seconds": 122.55,
      "duration_seconds": 11.62,
      "text": "I have acid reflux. I've had anxiety for about ten years now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 128.64,
      "duration_seconds": 5.18,
      "text": "Okay, I can see anxiety in your file as well. What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.04,
      "end_seconds": 134.59,
      "duration_seconds": 4.55,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.19,
      "end_seconds": 139.04,
      "duration_seconds": 1.85,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.77,
      "end_seconds": 144.57,
      "duration_seconds": 3.8,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.02,
      "end_seconds": 158.41,
      "duration_seconds": 4.39,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.99,
      "end_seconds": 166.38,
      "duration_seconds": 3.39,
      "text": "I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.47,
      "end_seconds": 169.87,
      "duration_seconds": 2.4,
      "text": "Any passing a lot of urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.55,
      "end_seconds": 176.37,
      "duration_seconds": 4.82,
      "text": "I haven't noticed any passing a lot of urine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.73,
      "end_seconds": 182.49,
      "duration_seconds": 4.76,
      "text": "And what about thirst, reduced baby movements or blurred vision?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.3,
      "end_seconds": 189.48,
      "duration_seconds": 6.18,
      "text": "No thirst, reduced baby movements or blurred vision, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.08,
      "end_seconds": 194.08,
      "duration_seconds": 3.0,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.03,
      "end_seconds": 197.09,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.23,
      "end_seconds": 203.4,
      "duration_seconds": 4.17,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.88,
      "end_seconds": 213.31,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.06,
      "end_seconds": 245.08,
      "duration_seconds": 20.02,
      "text": "Okay: BP is 112 over 69, temperature is 36.8 degrees, saturation 98 percent, pulse is 74 beats a minute. Listening to the whole story, my working impression is gestational diabetes controllable with diet. The reason I say that is that the way you describe it fits together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.66,
      "end_seconds": 248.69,
      "duration_seconds": 2.03,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.34,
      "end_seconds": 257.53,
      "duration_seconds": 8.19,
      "text": "I can't promise yet, but most people with gestational diabetes controllable with diet do well once it's treated properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.78,
      "end_seconds": 279.72,
      "duration_seconds": 14.94,
      "text": "I'm sending you for a growth scan because of gestational diabetes. That will help us see what's going on underneath and decide the next step. I'm sending you for a glucose meter and diary because of gestational diabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.63,
      "end_seconds": 286.95,
      "duration_seconds": 2.32,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.08,
      "end_seconds": 306.54,
      "duration_seconds": 18.46,
      "text": "Replace sugary drinks and white starches with wholegrains and walk after meals. The diabetes midwife would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.36,
      "end_seconds": 310.73,
      "duration_seconds": 3.37,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 319.7,
      "duration_seconds": 8.21,
      "text": "See me again in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.25,
      "end_seconds": 323.53,
      "duration_seconds": 2.28,
      "text": "Thank you, that's helpful."
    }
  ]
}