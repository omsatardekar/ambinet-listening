  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 3.35,
      "duration_seconds": 2.46,
      "text": "alright, evening let's get started"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.14,
      "end_seconds": 5.31,
      "duration_seconds": 1.17,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.74,
      "end_seconds": 7.93,
      "duration_seconds": 1.19,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.76,
      "end_seconds": 17.65,
      "duration_seconds": 8.89,
      "text": "I'm here because of a cough that eases on holiday. Sorry, you know, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.71,
      "end_seconds": 22.62,
      "duration_seconds": 2.91,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.44,
      "end_seconds": 25.74,
      "duration_seconds": 2.3,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.88,
      "end_seconds": 30.18,
      "duration_seconds": 3.3,
      "text": "Have you had itchy eyes at work?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.76,
      "end_seconds": 44.94,
      "duration_seconds": 14.18,
      "text": "Yeah, I've had that since last night. With itchy eyes at work, maybe a eight out of ten on a bad day. It happens every other day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.54,
      "end_seconds": 51.92,
      "duration_seconds": 6.38,
      "text": "Have you had a cough that eases on holiday before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 60.28,
      "duration_seconds": 6.63,
      "text": "I, I had a a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.08,
      "end_seconds": 67.95,
      "duration_seconds": 5.87,
      "text": "Let me check a few things. Any ankle swelling, fever or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.99,
      "end_seconds": 76.04,
      "duration_seconds": 6.05,
      "text": "Um, no ankle swelling, fever or weight loss, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.91,
      "end_seconds": 81.25,
      "duration_seconds": 3.34,
      "text": "and coughing up blood, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.2,
      "end_seconds": 86.34,
      "duration_seconds": 3.14,
      "text": "no, none, no coughing up blood"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.92,
      "end_seconds": 89.46,
      "duration_seconds": 1.54,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.81,
      "end_seconds": 94.75,
      "duration_seconds": 1.94,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.65,
      "end_seconds": 100.04,
      "duration_seconds": 4.39,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.27,
      "end_seconds": 103.33,
      "duration_seconds": 2.06,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.12,
      "end_seconds": 120.48,
      "duration_seconds": 4.36,
      "text": "are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.78,
      "end_seconds": 126.43,
      "duration_seconds": 4.65,
      "text": "A reliever inhaler. I take it it when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.06,
      "end_seconds": 130.48,
      "duration_seconds": 2.42,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.84,
      "end_seconds": 136.18,
      "duration_seconds": 4.34,
      "text": "100 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.71,
      "end_seconds": 147.34,
      "duration_seconds": 2.63,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.24,
      "end_seconds": 160.56,
      "duration_seconds": 7.32,
      "text": "Diabetes, for nearly five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.22,
      "end_seconds": 163.16,
      "duration_seconds": 0.94,
      "text": "I follow"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.91,
      "end_seconds": 182.37,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.47,
      "end_seconds": 185.93,
      "duration_seconds": 2.46,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.1,
      "end_seconds": 191.34,
      "duration_seconds": 4.24,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.93,
      "end_seconds": 196.93,
      "duration_seconds": 5.0,
      "text": "I don't think I have any, uh, no"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 201.08,
      "duration_seconds": 2.07,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.04,
      "end_seconds": 206.11,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.45,
      "end_seconds": 210.73,
      "duration_seconds": 3.28,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.11,
      "end_seconds": 215.09,
      "duration_seconds": 2.98,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.96,
      "end_seconds": 219.34,
      "duration_seconds": 2.38,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.78,
      "end_seconds": 231.2,
      "duration_seconds": 2.42,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.75,
      "end_seconds": 257.11,
      "duration_seconds": 9.36,
      "text": "okay: temp 36.9 degrees, pulse is 68 beats a minute, pressure 112 over 70, saturation 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.55,
      "end_seconds": 260.84,
      "duration_seconds": 2.29,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 263.94,
      "duration_seconds": 2.46,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.42,
      "end_seconds": 268.4,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.16,
      "end_seconds": 272.61,
      "duration_seconds": 2.45,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.83,
      "end_seconds": 288.63,
      "duration_seconds": 4.8,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.38,
      "end_seconds": 301.73,
      "duration_seconds": 7.35,
      "text": "okay, please sit back down today I'm not changing anything i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.66,
      "end_seconds": 306.76,
      "duration_seconds": 3.1,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
