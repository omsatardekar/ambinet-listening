{
  "schema_version": "1.0",
  "encounter_id": "03303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 7.61,
      "duration_seconds": 6.63,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.89,
      "end_seconds": 13.19,
      "duration_seconds": 4.3,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.57,
      "end_seconds": 18.98,
      "duration_seconds": 4.41,
      "text": "So the thing is, I've got wheeze at work."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.54,
      "end_seconds": 20.91,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.29,
      "end_seconds": 24.77,
      "duration_seconds": 2.48,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.58,
      "end_seconds": 28.99,
      "duration_seconds": 2.41,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.62,
      "end_seconds": 48.85,
      "duration_seconds": 18.23,
      "text": "It happens every other day. I've had a cough that eases on holiday too, for about two weeks. Uh, and there's a tight chest at work as well, about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.75,
      "end_seconds": 56.3,
      "duration_seconds": 5.55,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.96,
      "end_seconds": 59.27,
      "duration_seconds": 2.31,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.57,
      "end_seconds": 63.99,
      "duration_seconds": 4.42,
      "text": "Sure. Any weight loss, coughing up blood or ankle swelling?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.05,
      "end_seconds": 67.28,
      "duration_seconds": 2.23,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.7,
      "end_seconds": 71.11,
      "duration_seconds": 2.41,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.63,
      "end_seconds": 73.12,
      "duration_seconds": 1.49,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.68,
      "end_seconds": 78.69,
      "duration_seconds": 4.01,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.3,
      "end_seconds": 81.84,
      "duration_seconds": 1.54,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.8,
      "end_seconds": 85.24,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.9,
      "end_seconds": 89.64,
      "duration_seconds": 2.74,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.55,
      "end_seconds": 92.55,
      "duration_seconds": 1.0,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.35,
      "end_seconds": 95.91,
      "duration_seconds": 1.56,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.88,
      "end_seconds": 102.73,
      "duration_seconds": 5.85,
      "text": "Mm, okay. Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 115.19,
      "duration_seconds": 5.13,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.77,
      "end_seconds": 129.66,
      "duration_seconds": 13.89,
      "text": "I quit smoking around ten years ago. My husband and I live above the shop. I walk the dog every morning. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.43,
      "end_seconds": 134.75,
      "duration_seconds": 3.32,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.91,
      "end_seconds": 138.65,
      "duration_seconds": 2.74,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.44,
      "end_seconds": 142.92,
      "duration_seconds": 2.48,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.81,
      "end_seconds": 148.6,
      "duration_seconds": 3.79,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.1,
      "end_seconds": 165.21,
      "duration_seconds": 2.11,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.93,
      "end_seconds": 181.95,
      "duration_seconds": 13.02,
      "text": "Furosemide. I take it 40 milligrams, every morning for the fluid. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.7,
      "end_seconds": 186.46,
      "duration_seconds": 2.76,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.56,
      "end_seconds": 192.3,
      "duration_seconds": 3.74,
      "text": "Two years now. It's gliclazide, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 196.0,
      "duration_seconds": 2.27,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.0,
      "end_seconds": 199.5,
      "duration_seconds": 1.5,
      "text": "It's 80 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.73,
      "end_seconds": 203.71,
      "duration_seconds": 2.98,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.37,
      "end_seconds": 206.21,
      "duration_seconds": 1.84,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.65,
      "end_seconds": 214.59,
      "duration_seconds": 2.94,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.5,
      "end_seconds": 225.64,
      "duration_seconds": 2.14,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 255.66,
      "duration_seconds": 9.07,
      "text": "Okay: pulse is 66 beats a minute, oxygen saturation is 99 percent, BP is 121 over 77. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.8,
      "end_seconds": 262.78,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.9,
      "end_seconds": 266.25,
      "duration_seconds": 2.35,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.38,
      "end_seconds": 272.02,
      "duration_seconds": 3.64,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.46,
      "end_seconds": 277.06,
      "duration_seconds": 1.6,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.0,
      "end_seconds": 282.38,
      "duration_seconds": 3.38,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.26,
      "end_seconds": 296.77,
      "duration_seconds": 5.51,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.06,
      "end_seconds": 309.34,
      "duration_seconds": 9.28,
      "text": "Good, you can sit up again. Taking everything into account, I can't pin this down yet. We're looking at occupational asthma or COPD."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.2,
      "end_seconds": 332.7,
      "duration_seconds": 12.5,
      "text": "Let's get spirometry, for wheeze. Let's get serial peak flow readings, for work-related wheeze. Let's use beclometasone inhaler, 200 micrograms, twice a day, long term. It's for asthma."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.47,
      "end_seconds": 337.6,
      "duration_seconds": 3.13,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.99,
      "end_seconds": 346.89,
      "duration_seconds": 7.9,
      "text": "Record peak flows at work and at home for four weeks. We'll refer you to occupational health."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.42,
      "end_seconds": 350.1,
      "duration_seconds": 1.68,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.83,
      "end_seconds": 360.06,
      "duration_seconds": 9.23,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. See me again in four weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.48,
      "end_seconds": 363.1,
      "duration_seconds": 1.62,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.73,
      "end_seconds": 367.21,
      "duration_seconds": 3.48,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.64,
      "end_seconds": 374.06,
      "duration_seconds": 2.42,
      "text": "Alright, thanks, take care."
    }
  ]
}