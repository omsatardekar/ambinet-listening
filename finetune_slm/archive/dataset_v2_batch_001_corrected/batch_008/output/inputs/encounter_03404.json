{
  "schema_version": "1.0",
  "encounter_id": "03404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 5.66,
      "duration_seconds": 4.29,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.22,
      "end_seconds": 10.24,
      "duration_seconds": 4.02,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 15.84,
      "duration_seconds": 4.83,
      "text": "So the thing is, I've got vomiting once or twice."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.8,
      "end_seconds": 21.0,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.67,
      "end_seconds": 24.84,
      "duration_seconds": 3.17,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.28,
      "end_seconds": 28.06,
      "duration_seconds": 1.78,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.72,
      "end_seconds": 31.69,
      "duration_seconds": 2.97,
      "text": "Sips of fluid helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.09,
      "end_seconds": 35.29,
      "duration_seconds": 2.2,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.04,
      "end_seconds": 52.94,
      "duration_seconds": 15.9,
      "text": "Mm, when it starts I tend to get a mild tummy ache as well. About mild tummy ache, it feels severe to me. I've also had loose stools, for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 62.56,
      "end_seconds": 76.37,
      "duration_seconds": 13.81,
      "text": "Here are the numbers, doctor. Temp 36.7 degrees, SpO2 99 percent on room air, pulse 76, weight 64 kilos, blood pressure 121 over 76, respiratory rate 16, height 175 centimetres."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.4,
      "end_seconds": 79.1,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.33,
      "end_seconds": 83.95,
      "duration_seconds": 3.62,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.77,
      "end_seconds": 99.82,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.26,
      "end_seconds": 102.44,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.81,
      "end_seconds": 116.82,
      "duration_seconds": 5.01,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.1,
      "end_seconds": 128.82,
      "duration_seconds": 8.72,
      "text": "Thank you, you can get dressed. Any drowsiness, high fever, no wet nappies or blood in the stool?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.94,
      "end_seconds": 132.77,
      "duration_seconds": 2.83,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.22,
      "end_seconds": 140.0,
      "duration_seconds": 2.78,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.53,
      "end_seconds": 142.05,
      "duration_seconds": 1.52,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.73,
      "end_seconds": 145.04,
      "duration_seconds": 2.31,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.55,
      "end_seconds": 147.2,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.13,
      "end_seconds": 153.68,
      "duration_seconds": 4.55,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 157.46,
      "duration_seconds": 2.45,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.82,
      "end_seconds": 161.29,
      "duration_seconds": 2.47,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.77,
      "end_seconds": 175.07,
      "duration_seconds": 12.3,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.44,
      "end_seconds": 180.84,
      "duration_seconds": 4.4,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.44,
      "end_seconds": 201.31,
      "duration_seconds": 18.87,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. Not much, I mostly stay in these days. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.52,
      "end_seconds": 206.04,
      "duration_seconds": 3.52,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.69,
      "end_seconds": 212.0,
      "duration_seconds": 5.31,
      "text": "Yes, arthritis in my knees. I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 214.88,
      "duration_seconds": 1.21,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.78,
      "end_seconds": 219.13,
      "duration_seconds": 2.35,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.98,
      "end_seconds": 223.87,
      "duration_seconds": 3.89,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.68,
      "end_seconds": 227.32,
      "duration_seconds": 2.64,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.9,
      "end_seconds": 233.42,
      "duration_seconds": 4.52,
      "text": "Well, I take paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 234.78,
      "end_seconds": 239.85,
      "duration_seconds": 5.07,
      "text": "Doctor, our chart from the last visit lists it as 1300 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.54,
      "end_seconds": 249.18,
      "duration_seconds": 5.64,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.24,
      "end_seconds": 262.74,
      "duration_seconds": 12.5,
      "text": "No, I left it at home. Eltroxin, 100 micrograms, every morning for my thyroid. Oral rehydration solution. I take it 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.26,
      "end_seconds": 271.3,
      "duration_seconds": 8.04,
      "text": "Okay, thinking it through, I think we're dealing with a mild stomach bug at this stage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.13,
      "end_seconds": 322.23,
      "duration_seconds": 32.1,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back if he is not drinking. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.53,
      "end_seconds": 325.62,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.19,
      "end_seconds": 331.46,
      "duration_seconds": 1.27,
      "text": "Look after yourself."
    }
  ]
}