{
  "schema_version": "1.0",
  "encounter_id": "03010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 2.53,
      "duration_seconds": 1.77,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.1,
      "end_seconds": 8.52,
      "duration_seconds": 4.42,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.33,
      "end_seconds": 17.75,
      "duration_seconds": 7.42,
      "text": "Ah, it's shortness of breath. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.33,
      "end_seconds": 22.64,
      "duration_seconds": 3.31,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 31.32,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.98,
      "end_seconds": 51.63,
      "duration_seconds": 9.65,
      "text": "Okay: BP is 103 over 60, pulse is 99 beats a minute, respiratory rate 19, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.69,
      "end_seconds": 55.38,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.28,
      "end_seconds": 60.6,
      "duration_seconds": 4.32,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.5,
      "end_seconds": 71.45,
      "duration_seconds": 2.95,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.45,
      "end_seconds": 75.64,
      "duration_seconds": 2.19,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.85,
      "end_seconds": 84.35,
      "duration_seconds": 8.5,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.99,
      "end_seconds": 93.22,
      "duration_seconds": 7.23,
      "text": "I get some relief from sitting forward. It happens a few times a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.04,
      "end_seconds": 98.47,
      "duration_seconds": 3.43,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.45,
      "end_seconds": 115.85,
      "duration_seconds": 16.4,
      "text": "Oh, it usually comes with a racing heart. About racing heart, severe, I'd say. And, And there's chest pain as well, um, two days now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.77,
      "end_seconds": 119.2,
      "duration_seconds": 2.43,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.93,
      "end_seconds": 123.55,
      "duration_seconds": 2.62,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.72,
      "end_seconds": 128.34,
      "duration_seconds": 3.62,
      "text": "And what about cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.15,
      "end_seconds": 132.61,
      "duration_seconds": 2.46,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.88,
      "end_seconds": 136.63,
      "duration_seconds": 2.75,
      "text": "So, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.56,
      "end_seconds": 143.11,
      "duration_seconds": 1.55,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.99,
      "end_seconds": 147.45,
      "duration_seconds": 2.46,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.32,
      "end_seconds": 151.02,
      "duration_seconds": 2.7,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.5,
      "end_seconds": 154.74,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.61,
      "end_seconds": 160.24,
      "duration_seconds": 4.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.43,
      "end_seconds": 167.34,
      "duration_seconds": 2.91,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.68,
      "end_seconds": 174.6,
      "duration_seconds": 5.92,
      "text": "Sorry, what was I saying, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.3,
      "end_seconds": 181.45,
      "duration_seconds": 5.15,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 186.88,
      "duration_seconds": 4.6,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.93,
      "end_seconds": 193.62,
      "duration_seconds": 4.69,
      "text": "So, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.54,
      "end_seconds": 202.54,
      "duration_seconds": 8.0,
      "text": "Hmm, you know, I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.61,
      "end_seconds": 204.31,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.69,
      "end_seconds": 221.06,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.83,
      "end_seconds": 224.07,
      "duration_seconds": 1.24,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.83,
      "end_seconds": 227.59,
      "duration_seconds": 2.76,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.52,
      "end_seconds": 233.12,
      "duration_seconds": 3.6,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.17,
      "end_seconds": 239.31,
      "duration_seconds": 4.14,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 243.05,
      "duration_seconds": 2.13,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.5,
      "end_seconds": 262.97,
      "duration_seconds": 6.47,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.9,
      "end_seconds": 270.96,
      "duration_seconds": 3.06,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.44,
      "end_seconds": 302.2,
      "duration_seconds": 15.76,
      "text": "Let me tell you where I've got to. This looks most like possible cardiac tamponade. Let's book an ECG to look into chest pain. Let's book an urgent echocardiogram to look into possible tamponade."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.54,
      "end_seconds": 306.86,
      "duration_seconds": 3.32,
      "text": "Yeah, how long will it take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.19,
      "end_seconds": 316.93,
      "duration_seconds": 8.74,
      "text": "You need an urgent heart scan and possibly a drain. I think the cardiology team should see you too."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.95,
      "end_seconds": 318.65,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.86,
      "end_seconds": 326.27,
      "duration_seconds": 4.41,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.15,
      "end_seconds": 330.44,
      "duration_seconds": 2.29,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.45,
      "end_seconds": 333.62,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
