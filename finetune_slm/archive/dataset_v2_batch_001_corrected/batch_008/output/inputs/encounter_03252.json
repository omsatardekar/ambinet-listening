{
  "schema_version": "1.0",
  "encounter_id": "03252",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.7,
      "end_seconds": 8.64,
      "duration_seconds": 7.94,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.18,
      "end_seconds": 13.76,
      "duration_seconds": 4.58,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.7,
      "end_seconds": 28.07,
      "duration_seconds": 13.37,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come. It's severe back pain, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.22,
      "end_seconds": 30.7,
      "duration_seconds": 1.48,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.08,
      "end_seconds": 46.81,
      "duration_seconds": 14.73,
      "text": "Sorry, what was I saying, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 59.1,
      "duration_seconds": 10.61,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.04,
      "end_seconds": 67.77,
      "duration_seconds": 7.73,
      "text": "It's mild, honestly. I'd say a few times a day. And trouble passing urine, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.84,
      "end_seconds": 71.38,
      "duration_seconds": 2.54,
      "text": "So, have you had a fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.95,
      "end_seconds": 77.42,
      "duration_seconds": 4.47,
      "text": "Yeah, uh, I've had that since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 81.18,
      "duration_seconds": 3.18,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.09,
      "end_seconds": 85.48,
      "duration_seconds": 2.39,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.85,
      "end_seconds": 93.21,
      "duration_seconds": 7.36,
      "text": "Yes, carry on. So, have you had any recent fall, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 94.95,
      "end_seconds": 98.97,
      "duration_seconds": 4.02,
      "text": "No, um, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.23,
      "end_seconds": 104.81,
      "duration_seconds": 2.58,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 109.16,
      "duration_seconds": 2.7,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 111.7,
      "duration_seconds": 1.94,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 113.44,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.75,
      "end_seconds": 119.09,
      "duration_seconds": 4.34,
      "text": "So, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.02,
      "end_seconds": 124.08,
      "duration_seconds": 3.06,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.7,
      "end_seconds": 129.63,
      "duration_seconds": 3.93,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.25,
      "end_seconds": 133.26,
      "duration_seconds": 3.01,
      "text": "Diabetes, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.19,
      "end_seconds": 153.51,
      "duration_seconds": 3.32,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.06,
      "end_seconds": 160.22,
      "duration_seconds": 5.16,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.42,
      "end_seconds": 163.56,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.21,
      "end_seconds": 169.27,
      "duration_seconds": 4.06,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.86,
      "end_seconds": 179.36,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.07,
      "end_seconds": 185.27,
      "duration_seconds": 2.2,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.82,
      "end_seconds": 188.89,
      "duration_seconds": 3.07,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.72,
      "end_seconds": 196.43,
      "duration_seconds": 5.71,
      "text": "Uh, uh, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.06,
      "end_seconds": 208.02,
      "duration_seconds": 9.96,
      "text": "Actually, I remember he had some kind of reaction to diclofenac before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.22,
      "end_seconds": 215.04,
      "duration_seconds": 5.82,
      "text": "Uh, uh, maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.34,
      "end_seconds": 225.86,
      "duration_seconds": 9.52,
      "text": "Alright, so that's unclear. I'll record what each of you said. Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.49,
      "end_seconds": 234.05,
      "duration_seconds": 6.56,
      "text": "Erm, I take glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 236.0,
      "end_seconds": 240.99,
      "duration_seconds": 4.99,
      "text": "Doctor, our chart from the last visit lists it as 4 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.06,
      "end_seconds": 247.9,
      "duration_seconds": 4.84,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.0,
      "end_seconds": 254.58,
      "duration_seconds": 5.58,
      "text": "No, I left it at home. It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.01,
      "end_seconds": 256.51,
      "duration_seconds": 1.5,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 258.29,
      "end_seconds": 268.33,
      "duration_seconds": 10.04,
      "text": "Doctor, I've got the readings for you. Pressure 112 over 80, heart rate 89, temperature 39.2. Oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.62,
      "end_seconds": 281.23,
      "duration_seconds": 11.61,
      "text": "Okay, noted. Listening to the whole story, my working impression is a possible spinal infection pressing on the nerves. I'd also keep a slipped disc in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.2,
      "end_seconds": 305.66,
      "duration_seconds": 12.46,
      "text": "I want urgent blood tests done, that's for possible spinal infection. I think an urgent MRI of the spine makes sense here, for possible epidural abscess."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.55,
      "end_seconds": 311.48,
      "duration_seconds": 3.93,
      "text": "Uh, where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.93,
      "end_seconds": 330.33,
      "duration_seconds": 17.4,
      "text": "You are going to hospital now, this can cause permanent weakness. I'll also refer you to the spinal team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 331.97,
      "end_seconds": 333.64,
      "duration_seconds": 1.67,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.92,
      "end_seconds": 343.91,
      "duration_seconds": 8.99,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.05,
      "end_seconds": 346.77,
      "duration_seconds": 1.72,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.03,
      "end_seconds": 357.23,
      "duration_seconds": 7.2,
      "text": "I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.75,
      "end_seconds": 366.09,
      "duration_seconds": 4.34,
      "text": "Erm, you know, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.91,
      "end_seconds": 371.63,
      "duration_seconds": 1.72,
      "text": "So, take care now."
    }
  ]
}