{
  "schema_version": "1.0",
  "encounter_id": "03104",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.01,
      "duration_seconds": 2.91,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.4,
      "end_seconds": 9.65,
      "duration_seconds": 4.25,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.58,
      "end_seconds": 16.86,
      "duration_seconds": 5.28,
      "text": "I wanted to get a bit tired sometimes looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 24.09,
      "duration_seconds": 6.58,
      "text": "What's the timeline, when did it begin? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.79,
      "end_seconds": 34.23,
      "duration_seconds": 8.44,
      "text": "Ever since... since last Tuesday, really. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 37.98,
      "duration_seconds": 3.15,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.58,
      "end_seconds": 44.02,
      "duration_seconds": 4.44,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.38,
      "end_seconds": 49.75,
      "duration_seconds": 2.37,
      "text": "Have you had being vegetarian?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 53.31,
      "duration_seconds": 1.82,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.47,
      "end_seconds": 72.85,
      "duration_seconds": 4.38,
      "text": "A few quick ones: black stools, heavy periods or breathlessness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.96,
      "end_seconds": 78.15,
      "duration_seconds": 4.19,
      "text": "No, no black stools, heavy periods or breathlessness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.02,
      "end_seconds": 81.38,
      "duration_seconds": 2.36,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.09,
      "end_seconds": 85.66,
      "duration_seconds": 3.57,
      "text": "I mean, no, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.42,
      "end_seconds": 89.83,
      "duration_seconds": 2.41,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.94,
      "end_seconds": 94.95,
      "duration_seconds": 2.01,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.65,
      "end_seconds": 108.13,
      "duration_seconds": 3.48,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.77,
      "end_seconds": 113.87,
      "duration_seconds": 4.1,
      "text": "I'm on febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.4,
      "end_seconds": 134.33,
      "duration_seconds": 2.93,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.29,
      "end_seconds": 140.94,
      "duration_seconds": 1.65,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.93,
      "end_seconds": 152.69,
      "duration_seconds": 1.76,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.74,
      "end_seconds": 156.02,
      "duration_seconds": 2.28,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.48,
      "end_seconds": 161.01,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.99,
      "end_seconds": 169.83,
      "duration_seconds": 3.84,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.87,
      "end_seconds": 175.6,
      "duration_seconds": 3.73,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.8,
      "end_seconds": 180.06,
      "duration_seconds": 3.26,
      "text": "I have gout, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.36,
      "end_seconds": 187.62,
      "duration_seconds": 5.26,
      "text": "Understood. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.46,
      "end_seconds": 189.96,
      "duration_seconds": 1.5,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.62,
      "end_seconds": 193.77,
      "duration_seconds": 2.15,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.34,
      "end_seconds": 205.86,
      "duration_seconds": 2.52,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.93,
      "end_seconds": 227.54,
      "duration_seconds": 9.61,
      "text": "Okay: pulse is 81 beats a minute, respiratory rate 15, saturation 98 percent, BP is 124 over 81, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.04,
      "end_seconds": 230.52,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.16,
      "end_seconds": 234.75,
      "duration_seconds": 2.59,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.24,
      "end_seconds": 242.06,
      "duration_seconds": 4.82,
      "text": "Okay, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.24,
      "end_seconds": 244.17,
      "duration_seconds": 0.93,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.62,
      "end_seconds": 247.46,
      "duration_seconds": 1.84,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.29,
      "end_seconds": 264.93,
      "duration_seconds": 5.64,
      "text": "Your pulse and blood pressure are normal and the eyelids are a good colour."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.35,
      "end_seconds": 278.78,
      "duration_seconds": 8.43,
      "text": "Okay, that's enough for me. So where does that leave us? This is probably mildly low iron stores risk from diet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.48,
      "end_seconds": 282.77,
      "duration_seconds": 3.29,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.6,
      "end_seconds": 298.72,
      "duration_seconds": 14.12,
      "text": "It's reasonable to be concerned, but right now mildly low iron stores risk from diet is my leading thought, not anything worse. Let's get a ferritin level, for tiredness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.97,
      "end_seconds": 301.87,
      "duration_seconds": 1.9,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.73,
      "end_seconds": 318.13,
      "duration_seconds": 14.4,
      "text": "Eat pulses, leafy greens and vitamin-C rich foods with meals. If it hasn't settled in a month, we'd think about a B12 level, but not now. Please come and see me after the results."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.82,
      "end_seconds": 321.05,
      "duration_seconds": 2.23,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.82,
      "end_seconds": 324.71,
      "duration_seconds": 2.89,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.66,
      "end_seconds": 328.5,
      "duration_seconds": 2.84,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.09,
      "end_seconds": 330.57,
      "duration_seconds": 1.48,
      "text": "Goodbye for now."
    }
  ]
