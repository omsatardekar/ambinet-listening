{
  "schema_version": "1.0",
  "encounter_id": "03221",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.41,
      "duration_seconds": 3.23,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.23,
      "end_seconds": 8.43,
      "duration_seconds": 2.2,
      "text": "hi, um, thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.28,
      "end_seconds": 12.3,
      "duration_seconds": 2.02,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.33,
      "end_seconds": 17.97,
      "duration_seconds": 3.64,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.55,
      "end_seconds": 21.59,
      "duration_seconds": 3.04,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.6,
      "end_seconds": 30.68,
      "duration_seconds": 7.08,
      "text": "Mainly chest pain. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.03,
      "end_seconds": 35.11,
      "duration_seconds": 3.08,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.37,
      "end_seconds": 49.32,
      "duration_seconds": 12.95,
      "text": "Since last night, that's when it began. And shortness of breath, too. With shortness of breath, I notice it more with lying flat."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.62,
      "end_seconds": 50.32,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.55,
      "end_seconds": 62.84,
      "duration_seconds": 2.29,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.55,
      "end_seconds": 67.71,
      "duration_seconds": 3.16,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.94,
      "end_seconds": 73.39,
      "duration_seconds": 4.45,
      "text": "let me check a few things any cough or leg swelling?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.21,
      "end_seconds": 80.0,
      "duration_seconds": 4.79,
      "text": "Oh, uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 85.09,
      "duration_seconds": 3.31,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.3,
      "end_seconds": 91.25,
      "duration_seconds": 4.95,
      "text": "Sorry, what was I saying, I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.07,
      "end_seconds": 95.56,
      "duration_seconds": 2.49,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.23,
      "end_seconds": 101.36,
      "duration_seconds": 4.13,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.68,
      "end_seconds": 104.5,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.03,
      "end_seconds": 111.29,
      "duration_seconds": 2.26,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.15,
      "end_seconds": 114.33,
      "duration_seconds": 1.18,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.88,
      "end_seconds": 118.95,
      "duration_seconds": 3.07,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.22,
      "end_seconds": 138.35,
      "duration_seconds": 5.13,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.3,
      "end_seconds": 145.45,
      "duration_seconds": 5.15,
      "text": "I take furosemide, 40 milligrams, every morning for the fluid"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.49,
      "end_seconds": 156.89,
      "duration_seconds": 2.4,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.53,
      "end_seconds": 171.87,
      "duration_seconds": 12.34,
      "text": "I've had heart failure, yes. Sorry, I know I'm rambling a bit. My family kept telling me to get it it checked."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 174.36,
      "duration_seconds": 1.43,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.44,
      "end_seconds": 177.59,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.21,
      "end_seconds": 182.5,
      "duration_seconds": 4.29,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.43,
      "end_seconds": 191.03,
      "duration_seconds": 6.6,
      "text": "Oh, not currently, but as a youngster naproxen gave me stomach pain."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.88,
      "end_seconds": 195.85,
      "duration_seconds": 2.97,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.13,
      "end_seconds": 211.63,
      "duration_seconds": 2.5,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.49,
      "end_seconds": 230.52,
      "duration_seconds": 6.03,
      "text": "Okay: heart rate 100, temperature is 37.0 degrees, BP is 103 over 62."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 236.1,
      "duration_seconds": 2.92,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.83,
      "end_seconds": 237.73,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 239.74,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.62,
      "end_seconds": 259.11,
      "duration_seconds": 7.49,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.67,
      "end_seconds": 270.59,
      "duration_seconds": 7.92,
      "text": "that's all I needed to check. Putting it all together, this is probably possible cardiac tamponade"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.05,
      "end_seconds": 277.29,
      "duration_seconds": 5.24,
      "text": "Uh, you know, is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.75,
      "end_seconds": 290.67,
      "duration_seconds": 11.92,
      "text": "I understand the worry. At the moment I'd say it's possible cardiac tamponade, and and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.38,
      "end_seconds": 316.88,
      "duration_seconds": 13.5,
      "text": "I'd like to to arrange an ECG for chest pain. I'd like to arrange an urgent echocardiogram for possible tamponade. You need an urgent heart scan and possibly a drain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.36,
      "end_seconds": 327.62,
      "duration_seconds": 10.26,
      "text": "Ah. I'm going to send a referral to the cardiology team. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.53,
      "end_seconds": 331.18,
      "duration_seconds": 1.65,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.41,
      "end_seconds": 342.37,
      "duration_seconds": 4.96,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.21,
      "end_seconds": 347.18,
      "duration_seconds": 2.97,
      "text": "I think I understand everything. Thanks."
    }
  ]
}