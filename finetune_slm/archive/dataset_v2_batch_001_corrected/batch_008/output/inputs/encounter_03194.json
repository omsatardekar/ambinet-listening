{
  "schema_version": "1.0",
  "encounter_id": "03194",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 4.21,
      "duration_seconds": 3.33,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 9.54,
      "duration_seconds": 4.75,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.13,
      "end_seconds": 18.86,
      "duration_seconds": 7.73,
      "text": "so the thing is, I've got shaking i did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 22.47,
      "duration_seconds": 1.65,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 27.13,
      "duration_seconds": 3.94,
      "text": "It's been three weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.92,
      "end_seconds": 31.95,
      "duration_seconds": 3.03,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.08,
      "end_seconds": 44.37,
      "duration_seconds": 9.29,
      "text": "About a five out of ten. And being unable to sleep, too. I've been feeling anxious and agitated too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.24,
      "end_seconds": 49.9,
      "duration_seconds": 3.66,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.96,
      "end_seconds": 64.55,
      "duration_seconds": 2.59,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.39,
      "end_seconds": 86.6,
      "duration_seconds": 9.21,
      "text": "Okay: pulse is 114 beats a minute, saturation 97 percent, respiratory rate 20, pressure 117 over 71, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.73,
      "end_seconds": 89.65,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.36,
      "end_seconds": 93.21,
      "duration_seconds": 2.85,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.99,
      "end_seconds": 101.41,
      "duration_seconds": 5.42,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.71,
      "end_seconds": 112.41,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.77,
      "end_seconds": 115.82,
      "duration_seconds": 2.05,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.06,
      "end_seconds": 133.64,
      "duration_seconds": 5.58,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.49,
      "end_seconds": 139.49,
      "duration_seconds": 3.0,
      "text": "You can relax now. Alright, any seizure?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.23,
      "end_seconds": 142.88,
      "duration_seconds": 2.65,
      "text": "Not at all, no seizure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 149.48,
      "duration_seconds": 5.89,
      "text": "Let me check a few things. Any vomiting blood, confusion or seeing things?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.09,
      "end_seconds": 155.5,
      "duration_seconds": 4.41,
      "text": "No, no vomiting blood, confusion or seeing things."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.85,
      "end_seconds": 163.39,
      "duration_seconds": 3.54,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.39,
      "end_seconds": 165.38,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 169.5,
      "duration_seconds": 3.23,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.71,
      "end_seconds": 173.52,
      "duration_seconds": 2.81,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.08,
      "end_seconds": 179.07,
      "duration_seconds": 3.99,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.87,
      "end_seconds": 183.73,
      "duration_seconds": 2.86,
      "text": "I have epilepsy, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.43,
      "end_seconds": 187.82,
      "duration_seconds": 2.39,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.55,
      "end_seconds": 195.28,
      "duration_seconds": 5.73,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.05,
      "end_seconds": 199.02,
      "duration_seconds": 1.97,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.59,
      "end_seconds": 212.23,
      "duration_seconds": 11.64,
      "text": "Levetiracetam. I take it 500 milligrams, twice a day. I'm on heavy drinking until two days ago, stopped two days ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 217.04,
      "duration_seconds": 3.26,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.61,
      "end_seconds": 220.59,
      "duration_seconds": 1.98,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 241.14,
      "duration_seconds": 2.57,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.17,
      "end_seconds": 243.8,
      "duration_seconds": 1.63,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.67,
      "end_seconds": 261.95,
      "duration_seconds": 1.28,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.51,
      "end_seconds": 266.5,
      "duration_seconds": 2.99,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.18,
      "end_seconds": 268.52,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.71,
      "end_seconds": 272.79,
      "duration_seconds": 3.08,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.97,
      "end_seconds": 277.99,
      "duration_seconds": 4.02,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.33,
      "end_seconds": 285.66,
      "duration_seconds": 3.33,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.38,
      "end_seconds": 289.11,
      "duration_seconds": 2.73,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.79,
      "end_seconds": 294.91,
      "duration_seconds": 5.12,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.6,
      "end_seconds": 306.29,
      "duration_seconds": 9.69,
      "text": "Let me tell you where I've got to. This looks most like alcohol withdrawal. I can't rule out an anxiety state yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.05,
      "end_seconds": 309.19,
      "duration_seconds": 2.14,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.95,
      "end_seconds": 342.81,
      "duration_seconds": 32.86,
      "text": "I understand the worry. At the moment I'd say it's alcohol withdrawal, and we'll know more once the blood tests is back. We should do blood tests for alcohol withdrawal. Let's use thiamine, 100 milligrams, three times a day, long term. That's for alcohol-related deficiency. What I'm giving you is chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. That's for alcohol withdrawal. Do not stop alcohol suddenly without medical support."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.71,
      "end_seconds": 353.06,
      "duration_seconds": 8.35,
      "text": "We'll refer you to the alcohol liaison service. Let's review you in two days. Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.79,
      "end_seconds": 358.24,
      "duration_seconds": 3.45,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.09,
      "end_seconds": 360.42,
      "duration_seconds": 1.33,
      "text": "take care now"
    }
  ]
}