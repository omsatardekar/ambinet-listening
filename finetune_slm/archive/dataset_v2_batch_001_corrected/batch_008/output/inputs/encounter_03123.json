{
  "schema_version": "1.0",
  "encounter_id": "03123",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.01,
      "duration_seconds": 3.34,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.39,
      "end_seconds": 9.94,
      "duration_seconds": 4.55,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 16.6,
      "duration_seconds": 5.84,
      "text": "Honestly, it's shaking, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.12,
      "end_seconds": 19.98,
      "duration_seconds": 2.86,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.25,
      "end_seconds": 29.58,
      "duration_seconds": 8.33,
      "text": "It's been about two weeks, I'm fairly sure. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.98,
      "end_seconds": 33.94,
      "duration_seconds": 3.96,
      "text": "Ah. Right, how often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.48,
      "end_seconds": 39.77,
      "duration_seconds": 4.29,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.95,
      "end_seconds": 45.7,
      "duration_seconds": 4.75,
      "text": "And what about vomiting blood, seeing things, confusion or seizure?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 53.44,
      "duration_seconds": 6.34,
      "text": "No vomiting blood, seeing things, confusion or seizure, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.18,
      "end_seconds": 57.55,
      "duration_seconds": 3.37,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.05,
      "end_seconds": 60.0,
      "duration_seconds": 1.95,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.57,
      "end_seconds": 64.11,
      "duration_seconds": 2.54,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.72,
      "end_seconds": 67.47,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.56,
      "end_seconds": 72.99,
      "duration_seconds": 3.43,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.9,
      "end_seconds": 79.37,
      "duration_seconds": 4.47,
      "text": "Um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.9,
      "end_seconds": 94.18,
      "duration_seconds": 2.28,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.73,
      "end_seconds": 97.96,
      "duration_seconds": 3.23,
      "text": "So, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.99,
      "end_seconds": 101.56,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.81,
      "end_seconds": 105.11,
      "duration_seconds": 2.3,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.25,
      "end_seconds": 110.19,
      "duration_seconds": 3.94,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.9,
      "end_seconds": 114.47,
      "duration_seconds": 3.57,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.9,
      "end_seconds": 135.17,
      "duration_seconds": 3.27,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.09,
      "end_seconds": 141.85,
      "duration_seconds": 4.76,
      "text": "Okay, so no, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.53,
      "end_seconds": 145.42,
      "duration_seconds": 2.89,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.07,
      "end_seconds": 158.32,
      "duration_seconds": 2.25,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 187.16,
      "duration_seconds": 15.01,
      "text": "Okay: BP is 130 over 74, temperature is 37.0 degrees. And SpO2 96 percent on room air, height 185 centimetres, pulse 109, weight 57 kilos, BMI works out to 16.7."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.03,
      "end_seconds": 192.42,
      "duration_seconds": 2.39,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.98,
      "end_seconds": 195.45,
      "duration_seconds": 1.47,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.19,
      "end_seconds": 198.55,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 221.23,
      "duration_seconds": 5.91,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.79,
      "end_seconds": 228.65,
      "duration_seconds": 1.86,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.54,
      "end_seconds": 252.09,
      "duration_seconds": 7.55,
      "text": "Okay, so my impression is this: I think we're dealing with alcohol withdrawal at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.67,
      "end_seconds": 266.15,
      "duration_seconds": 3.48,
      "text": "Let's get blood tests, for alcohol withdrawal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.5,
      "end_seconds": 274.15,
      "duration_seconds": 2.65,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.3,
      "end_seconds": 301.01,
      "duration_seconds": 25.71,
      "text": "You'll be taking thiamine, 100 milligrams, three times a day, long term. It's for alcohol-related deficiency. Do not stop alcohol suddenly without medical support. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back in two days. Okay, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.8,
      "end_seconds": 312.68,
      "duration_seconds": 10.88,
      "text": "So, I take the thiamine, 100 milligrams, three times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.77,
      "end_seconds": 320.2,
      "duration_seconds": 5.43,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.37,
      "end_seconds": 325.48,
      "duration_seconds": 4.11,
      "text": "Actually, no, that's all. Thanks a lot."
    }
  ]
}