{
  "schema_version": "1.0",
  "encounter_id": "03152",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 4.01,
      "duration_seconds": 3.42,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.68,
      "end_seconds": 10.2,
      "duration_seconds": 4.52,
      "text": "Let me think, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.89,
      "end_seconds": 12.64,
      "duration_seconds": 1.75,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.36,
      "end_seconds": 18.21,
      "duration_seconds": 3.85,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.17,
      "end_seconds": 20.83,
      "duration_seconds": 1.66,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.75,
      "end_seconds": 34.18,
      "duration_seconds": 7.43,
      "text": "I've been dealing with a sudden severe tummy pain. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.78,
      "end_seconds": 37.79,
      "duration_seconds": 3.01,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.41,
      "end_seconds": 53.96,
      "duration_seconds": 14.55,
      "text": "It's been going on for five days. I kept putting it off, which I know isn't sensible. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.58,
      "end_seconds": 64.61,
      "duration_seconds": 9.03,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.74,
      "end_seconds": 71.39,
      "duration_seconds": 5.65,
      "text": "It, It just comes and goes. It's worse with movement."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.01,
      "end_seconds": 75.49,
      "duration_seconds": 2.48,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.76,
      "end_seconds": 85.28,
      "duration_seconds": 8.52,
      "text": "When it starts I tend to get vomiting as well. The vomiting? That's been for about three months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 92.07,
      "duration_seconds": 5.66,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.83,
      "end_seconds": 95.55,
      "duration_seconds": 2.72,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.31,
      "end_seconds": 119.0,
      "duration_seconds": 4.69,
      "text": "Have you had any blood in the vomit, diarrhoea or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.06,
      "end_seconds": 124.0,
      "duration_seconds": 2.94,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.03,
      "end_seconds": 128.88,
      "duration_seconds": 2.85,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.4,
      "end_seconds": 132.42,
      "duration_seconds": 2.02,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.67,
      "end_seconds": 136.08,
      "duration_seconds": 2.41,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.9,
      "end_seconds": 140.41,
      "duration_seconds": 3.51,
      "text": "Actually, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.88,
      "end_seconds": 146.28,
      "duration_seconds": 4.4,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.63,
      "end_seconds": 151.07,
      "duration_seconds": 3.44,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.47,
      "end_seconds": 169.14,
      "duration_seconds": 2.67,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.13,
      "end_seconds": 173.4,
      "duration_seconds": 2.27,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.53,
      "end_seconds": 176.8,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.58,
      "end_seconds": 184.02,
      "duration_seconds": 5.44,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.47,
      "end_seconds": 187.46,
      "duration_seconds": 1.99,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 192.04,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.06,
      "end_seconds": 195.36,
      "duration_seconds": 2.3,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.09,
      "end_seconds": 199.6,
      "duration_seconds": 2.51,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.68,
      "end_seconds": 214.85,
      "duration_seconds": 7.17,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.33,
      "end_seconds": 220.81,
      "duration_seconds": 2.48,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.84,
      "end_seconds": 244.05,
      "duration_seconds": 11.21,
      "text": "Okay, so my impression is this: This looks most like a perforated stomach ulcer. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.32,
      "end_seconds": 247.44,
      "duration_seconds": 2.12,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 266.04,
      "duration_seconds": 17.62,
      "text": "Nothing I've seen today points to an emergency. It looks like a perforated stomach ulcer, but I'd like to confirm. So, to recap quickly. You've had a sudden severe tummy pain for five days, and no fever or diarrhoea."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.95,
      "end_seconds": 268.57,
      "duration_seconds": 1.62,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.29,
      "end_seconds": 273.89,
      "duration_seconds": 4.6,
      "text": "Let's book urgent blood tests to look into acute abdomen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.86,
      "end_seconds": 280.29,
      "duration_seconds": 1.43,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.02,
      "end_seconds": 301.2,
      "duration_seconds": 20.18,
      "text": "Nothing to eat or drink, you need an operation urgently. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll also refer you to the surgical team. See me again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.36,
      "end_seconds": 303.06,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.18,
      "end_seconds": 308.15,
      "duration_seconds": 3.97,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.18,
      "end_seconds": 312.88,
      "duration_seconds": 3.7,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}