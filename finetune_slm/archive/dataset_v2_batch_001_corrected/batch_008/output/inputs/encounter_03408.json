  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.25,
      "duration_seconds": 3.4,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 9.63,
      "duration_seconds": 3.63,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 19.21,
      "duration_seconds": 7.71,
      "text": "Mainly a fever. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 26.77,
      "duration_seconds": 5.6,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.53,
      "end_seconds": 38.76,
      "duration_seconds": 8.23,
      "text": "honestly, on and off. Pretty severe, if I'm being honest. I've also had severe back pain"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 42.07,
      "duration_seconds": 2.75,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.44,
      "end_seconds": 55.09,
      "duration_seconds": 11.65,
      "text": "Um, about a seven out of ten. Sorry, what was I saying, I had trouble passing urine before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.72,
      "end_seconds": 59.39,
      "duration_seconds": 2.67,
      "text": "has there been any recent fall?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.1,
      "end_seconds": 64.01,
      "duration_seconds": 2.91,
      "text": "No, none, no recent fall."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.97,
      "end_seconds": 69.97,
      "duration_seconds": 4.0,
      "text": "A few quick ones: weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.56,
      "end_seconds": 74.91,
      "duration_seconds": 4.35,
      "text": "I haven't had weight loss or chest pain, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.62,
      "end_seconds": 78.36,
      "duration_seconds": 1.74,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.88,
      "end_seconds": 79.81,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.56,
      "end_seconds": 85.97,
      "duration_seconds": 5.41,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.31,
      "end_seconds": 89.76,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.81,
      "end_seconds": 93.61,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.27,
      "end_seconds": 97.51,
      "duration_seconds": 2.24,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 101.34,
      "duration_seconds": 2.59,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.6,
      "end_seconds": 108.54,
      "duration_seconds": 5.94,
      "text": "I've got diabetes. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.04,
      "end_seconds": 117.68,
      "duration_seconds": 8.64,
      "text": "Sure. Okay, I can see diabetes in your file as well. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.76,
      "end_seconds": 124.11,
      "duration_seconds": 4.35,
      "text": "Gliclazide. I take it 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 125.25,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.33,
      "end_seconds": 129.7,
      "duration_seconds": 2.37,
      "text": "It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.22,
      "end_seconds": 147.03,
      "duration_seconds": 3.81,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.05,
      "end_seconds": 153.83,
      "duration_seconds": 5.78,
      "text": "Amoxicillin. I come out in... well, a rash all over."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.35,
      "end_seconds": 174.7,
      "duration_seconds": 3.35,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.73,
      "end_seconds": 179.23,
      "duration_seconds": 3.5,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.61,
      "end_seconds": 184.25,
      "duration_seconds": 3.64,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.09,
      "end_seconds": 188.41,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.92,
      "end_seconds": 195.4,
      "duration_seconds": 1.48,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.86,
      "end_seconds": 203.38,
      "duration_seconds": 4.52,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.27,
      "end_seconds": 207.53,
      "duration_seconds": 2.26,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.96,
      "end_seconds": 218.31,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.3,
      "end_seconds": 247.01,
      "duration_seconds": 7.71,
      "text": "Okay: blood pressure 118 over 75, temperature is 38.5 degrees, oxygen saturation is 98 percent, pulse 92."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.85,
      "end_seconds": 250.36,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.76,
      "end_seconds": 254.2,
      "duration_seconds": 2.44,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.78,
      "end_seconds": 260.85,
      "duration_seconds": 4.07,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.52,
      "end_seconds": 279.47,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.31,
      "end_seconds": 283.56,
      "duration_seconds": 3.25,
      "text": "right, take a deep breath for me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.84,
      "end_seconds": 302.91,
      "duration_seconds": 6.07,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.43,
      "end_seconds": 340.77,
      "duration_seconds": 34.34,
      "text": "Okay, that's enough for me. I want an urgent MRI of the spine done, that's for possible epidural abscess. You are going to hospital now, this can cause permanent weakness. Please take the tablets with food so they don't upset your stomach. I'm not ordering urgent blood tests today. If things carry on in a month, we'll consider it. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.27,
      "end_seconds": 349.78,
      "duration_seconds": 7.51,
      "text": "Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.28,
      "end_seconds": 352.57,
      "duration_seconds": 2.29,
      "text": "Thank you, that's helpful."
    }
  ]
}