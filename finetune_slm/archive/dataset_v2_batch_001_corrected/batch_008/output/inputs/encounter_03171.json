{
  "schema_version": "1.0",
  "encounter_id": "03171",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 4.0,
      "duration_seconds": 3.41,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.28,
      "end_seconds": 6.49,
      "duration_seconds": 1.21,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.63,
      "end_seconds": 14.46,
      "duration_seconds": 6.83,
      "text": "Yeah, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.59,
      "end_seconds": 18.34,
      "duration_seconds": 2.75,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.01,
      "end_seconds": 28.15,
      "duration_seconds": 8.14,
      "text": "Mm, uh, doctor, it's shortness of breath. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 31.39,
      "duration_seconds": 1.57,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.13,
      "end_seconds": 34.7,
      "duration_seconds": 2.57,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.02,
      "end_seconds": 37.93,
      "duration_seconds": 2.91,
      "text": "Yes. How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.11,
      "end_seconds": 44.7,
      "duration_seconds": 1.59,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.01,
      "end_seconds": 48.32,
      "duration_seconds": 2.31,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.99,
      "end_seconds": 66.73,
      "duration_seconds": 17.74,
      "text": "When it starts I tend to get chest pain as well. Yeah, as for racing heart, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 70.84,
      "duration_seconds": 3.04,
      "text": "So, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.38,
      "end_seconds": 74.33,
      "duration_seconds": 2.95,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 77.65,
      "duration_seconds": 2.71,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.43,
      "end_seconds": 85.53,
      "duration_seconds": 6.1,
      "text": "Um, you know, about a three out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.22,
      "end_seconds": 88.6,
      "duration_seconds": 2.38,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.75,
      "end_seconds": 91.26,
      "duration_seconds": 1.51,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.6,
      "end_seconds": 95.36,
      "duration_seconds": 2.76,
      "text": "And what about cough or leg swelling?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.72,
      "end_seconds": 103.26,
      "duration_seconds": 6.54,
      "text": "So, uh, I haven't had cough or leg swelling, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.86,
      "end_seconds": 107.09,
      "duration_seconds": 3.23,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.86,
      "end_seconds": 112.58,
      "duration_seconds": 3.72,
      "text": "I mean, I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.53,
      "end_seconds": 116.44,
      "duration_seconds": 2.91,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.67,
      "end_seconds": 123.38,
      "duration_seconds": 5.71,
      "text": "Right, just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.42,
      "end_seconds": 126.8,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 128.34,
      "end_seconds": 135.87,
      "duration_seconds": 7.53,
      "text": "She is on metoprolol, 50 milligrams, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 149.31,
      "duration_seconds": 4.91,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.88,
      "end_seconds": 153.53,
      "duration_seconds": 3.65,
      "text": "Erm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 157.22,
      "duration_seconds": 2.75,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.5,
      "end_seconds": 169.33,
      "duration_seconds": 10.83,
      "text": "I've got heart disease. I didn't want to make a fuss, you know. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.43,
      "end_seconds": 177.12,
      "duration_seconds": 6.69,
      "text": "Right, right. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.05,
      "end_seconds": 189.06,
      "duration_seconds": 9.01,
      "text": "I walk the dog every morning. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.9,
      "end_seconds": 198.76,
      "duration_seconds": 3.86,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.66,
      "end_seconds": 209.05,
      "duration_seconds": 2.39,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 230.27,
      "duration_seconds": 6.94,
      "text": "Okay: pressure 101 over 61, saturation 99 percent, pulse is 94 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.06,
      "end_seconds": 257.71,
      "duration_seconds": 12.65,
      "text": "Let me tell you where I've got to. I'm honestly not certain yet. It could be possible cardiac tamponade, or it might be a heart attack."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.59,
      "end_seconds": 291.74,
      "duration_seconds": 16.15,
      "text": "I'm going to order an ECG, for chest pain. You need an urgent heart scan and possibly a drain. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.41,
      "end_seconds": 295.24,
      "duration_seconds": 1.83,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.02,
      "end_seconds": 304.29,
      "duration_seconds": 3.27,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.24,
      "end_seconds": 309.35,
      "duration_seconds": 4.11,
      "text": "Erm, um, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.93,
      "end_seconds": 315.09,
      "duration_seconds": 5.16,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.89,
      "end_seconds": 317.96,
      "duration_seconds": 2.07,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.79,
      "end_seconds": 320.57,
      "duration_seconds": 1.78,
      "text": "Have a good day."
    }
  ]
}