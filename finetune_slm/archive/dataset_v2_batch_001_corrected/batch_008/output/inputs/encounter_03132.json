{
  "schema_version": "1.0",
  "encounter_id": "03132",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.31,
      "duration_seconds": 3.01,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 15.06,
      "duration_seconds": 5.38,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.75,
      "end_seconds": 24.56,
      "duration_seconds": 7.81,
      "text": "Doctor, I'm just here to help with the details. We came because of severe back pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.07,
      "end_seconds": 27.34,
      "duration_seconds": 2.27,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.67,
      "end_seconds": 39.43,
      "duration_seconds": 10.76,
      "text": "Uh, she is on metformin, 500 milligrams, twice a day, I give it to her. She takes injecting drugs, recent."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 43.98,
      "duration_seconds": 2.89,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 45.39,
      "end_seconds": 47.53,
      "duration_seconds": 2.14,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.23,
      "end_seconds": 51.72,
      "duration_seconds": 3.49,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.76,
      "end_seconds": 57.34,
      "duration_seconds": 3.58,
      "text": "Ah, I've had it since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.35,
      "end_seconds": 62.75,
      "duration_seconds": 3.4,
      "text": "Right, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.4,
      "end_seconds": 65.81,
      "duration_seconds": 2.41,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.72,
      "end_seconds": 71.2,
      "duration_seconds": 3.48,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.2,
      "end_seconds": 79.41,
      "duration_seconds": 6.21,
      "text": "I'd say severe. Ah, there's trouble passing urine as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.57,
      "end_seconds": 84.0,
      "duration_seconds": 3.43,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.08,
      "end_seconds": 99.76,
      "duration_seconds": 13.68,
      "text": "About a five out of ten. And weakness in the legs, too. As for weakness in the legs, I'd call it moderate."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.3,
      "end_seconds": 104.34,
      "duration_seconds": 4.04,
      "text": "And what about chest pain, weight loss or recent fall?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.62,
      "end_seconds": 108.24,
      "duration_seconds": 2.62,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.32,
      "end_seconds": 114.03,
      "duration_seconds": 3.71,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.07,
      "end_seconds": 119.84,
      "duration_seconds": 4.77,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.82,
      "end_seconds": 123.67,
      "duration_seconds": 2.85,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.18,
      "end_seconds": 126.32,
      "duration_seconds": 1.14,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.31,
      "end_seconds": 130.01,
      "duration_seconds": 1.7,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.65,
      "end_seconds": 135.39,
      "duration_seconds": 1.74,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.45,
      "end_seconds": 142.73,
      "duration_seconds": 5.28,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.33,
      "end_seconds": 147.91,
      "duration_seconds": 4.58,
      "text": "Let me think, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.9,
      "end_seconds": 154.74,
      "duration_seconds": 4.84,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.64,
      "end_seconds": 160.17,
      "duration_seconds": 3.53,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.59,
      "end_seconds": 173.34,
      "duration_seconds": 5.75,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.62,
      "end_seconds": 196.63,
      "duration_seconds": 22.01,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. My partner and our baby. I'm a hairdresser, on my feet all day. I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.08,
      "end_seconds": 217.84,
      "duration_seconds": 2.76,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.06,
      "end_seconds": 220.8,
      "duration_seconds": 1.74,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.39,
      "end_seconds": 226.03,
      "duration_seconds": 4.64,
      "text": "Mm-hmm. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.74,
      "end_seconds": 240.5,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.76,
      "end_seconds": 267.19,
      "duration_seconds": 8.43,
      "text": "Okay: respiratory rate 22, pulse 105, SpO2 96 percent on room air, pressure 121 over 72, temp 39.2 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.29,
      "end_seconds": 272.47,
      "duration_seconds": 3.18,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.04,
      "end_seconds": 276.37,
      "duration_seconds": 2.33,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.22,
      "end_seconds": 283.2,
      "duration_seconds": 4.98,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.38,
      "end_seconds": 286.32,
      "duration_seconds": 1.94,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.67,
      "end_seconds": 310.75,
      "duration_seconds": 6.08,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.89,
      "end_seconds": 314.58,
      "duration_seconds": 1.69,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.75,
      "end_seconds": 340.11,
      "duration_seconds": 11.36,
      "text": "Okay, thinking it through, the most likely explanation is a possible spinal infection pressing on the nerves. Another possibility is a slipped disc."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.0,
      "end_seconds": 345.13,
      "duration_seconds": 3.13,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.07,
      "end_seconds": 378.41,
      "duration_seconds": 31.34,
      "text": "It's reasonable to be concerned, but right now a possible spinal infection pressing on the nerves is my leading thought, not anything worse. I'm sending you for urgent blood tests because of possible spinal infection. I'm sending you for an urgent MRI of the spine because of possible epidural abscess. You are going to hospital now, this can cause permanent weakness. We'll refer you to the spinal team. See me again straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.06,
      "end_seconds": 382.71,
      "duration_seconds": 2.65,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.37,
      "end_seconds": 387.32,
      "duration_seconds": 1.95,
      "text": "That's clear, thanks."
    }
  ]
}