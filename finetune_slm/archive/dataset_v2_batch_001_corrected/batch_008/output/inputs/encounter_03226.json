{
  "schema_version": "1.0",
  "encounter_id": "03226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 7.04,
      "duration_seconds": 5.8,
      "text": "Right, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.03,
      "end_seconds": 11.57,
      "duration_seconds": 3.54,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.77,
      "end_seconds": 19.81,
      "duration_seconds": 7.04,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 24.13,
      "duration_seconds": 3.31,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.83,
      "end_seconds": 27.96,
      "duration_seconds": 3.13,
      "text": "Well, I've been having a limp."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.62,
      "end_seconds": 32.94,
      "duration_seconds": 3.32,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.42,
      "end_seconds": 45.52,
      "duration_seconds": 11.1,
      "text": "Ah, it's been about a week, I'm fairly sure. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 49.25,
      "duration_seconds": 3.21,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.23,
      "end_seconds": 52.0,
      "duration_seconds": 1.77,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.99,
      "end_seconds": 60.34,
      "duration_seconds": 3.35,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.15,
      "end_seconds": 72.7,
      "duration_seconds": 10.55,
      "text": "Night pain goes along with it, most of the time. The night pain? That's been for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.24,
      "end_seconds": 76.74,
      "duration_seconds": 3.5,
      "text": "So, any numbness, weight loss, fall or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.36,
      "end_seconds": 80.5,
      "duration_seconds": 3.14,
      "text": "Erm, none of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.82,
      "end_seconds": 84.77,
      "duration_seconds": 2.95,
      "text": "Right, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.81,
      "end_seconds": 87.8,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.67,
      "end_seconds": 93.85,
      "duration_seconds": 5.18,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.85,
      "end_seconds": 103.84,
      "duration_seconds": 4.99,
      "text": "Sorry, what was I saying, no, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 109.18,
      "duration_seconds": 3.37,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.57,
      "end_seconds": 113.47,
      "duration_seconds": 2.9,
      "text": "Right, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.62,
      "end_seconds": 123.85,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.25,
      "end_seconds": 129.62,
      "duration_seconds": 4.37,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.41,
      "end_seconds": 133.32,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.89,
      "end_seconds": 136.39,
      "duration_seconds": 2.5,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.18,
      "end_seconds": 140.96,
      "duration_seconds": 2.78,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.54,
      "end_seconds": 145.86,
      "duration_seconds": 4.32,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.94,
      "end_seconds": 151.44,
      "duration_seconds": 2.5,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.35,
      "end_seconds": 156.21,
      "duration_seconds": 3.86,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.24,
      "end_seconds": 167.23,
      "duration_seconds": 1.99,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.16,
      "end_seconds": 173.77,
      "duration_seconds": 5.61,
      "text": "Yeah, I have arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.91,
      "end_seconds": 190.93,
      "duration_seconds": 13.02,
      "text": "Sure. Right, so arthritis in your knees is already on your record. We'll keep that in mind today. Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.52,
      "end_seconds": 197.7,
      "duration_seconds": 6.18,
      "text": "Hmm, you know, I'm on naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.3,
      "end_seconds": 202.79,
      "duration_seconds": 4.49,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.45,
      "end_seconds": 208.15,
      "duration_seconds": 4.7,
      "text": "Okay, so no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.19,
      "end_seconds": 212.72,
      "duration_seconds": 2.53,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.85,
      "end_seconds": 224.0,
      "duration_seconds": 2.15,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.34,
      "end_seconds": 246.04,
      "duration_seconds": 7.7,
      "text": "Okay: respiratory rate 18, pulse 78, temp 36.7 degrees, BP is 115 over 69, saturation 98 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.59,
      "end_seconds": 249.83,
      "duration_seconds": 3.24,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.68,
      "end_seconds": 255.41,
      "duration_seconds": 3.73,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.93,
      "end_seconds": 260.64,
      "duration_seconds": 3.71,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.32,
      "end_seconds": 263.34,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.17,
      "end_seconds": 267.3,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.86,
      "end_seconds": 287.01,
      "duration_seconds": 6.15,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.07,
      "end_seconds": 300.17,
      "duration_seconds": 11.1,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: I'd lean towards hip osteoarthritis. I can't rule out a back problem yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.28,
      "end_seconds": 313.18,
      "duration_seconds": 5.9,
      "text": "I'm sending you for an X-ray of the hips because of hip pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.43,
      "end_seconds": 317.97,
      "duration_seconds": 3.54,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.51,
      "end_seconds": 340.66,
      "duration_seconds": 22.15,
      "text": "Use a walking stick in the left hand and do gentle strengthening exercises. We'll refer you to the orthopaedic clinic. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.2,
      "end_seconds": 345.87,
      "duration_seconds": 4.67,
      "text": "Great, uh, thank you for your help."
    }
  ]
}