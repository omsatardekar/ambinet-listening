{
  "schema_version": "1.0",
  "encounter_id": "03134",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.04,
      "end_seconds": 8.8,
      "duration_seconds": 7.76,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.43,
      "end_seconds": 13.75,
      "duration_seconds": 4.32,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.44,
      "end_seconds": 20.93,
      "duration_seconds": 5.49,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.28,
      "end_seconds": 26.76,
      "duration_seconds": 3.48,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.54,
      "end_seconds": 33.51,
      "duration_seconds": 4.97,
      "text": "So, I'm here because of a sudden severe tummy pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.08,
      "end_seconds": 35.26,
      "duration_seconds": 1.18,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 38.14,
      "duration_seconds": 1.86,
      "text": "probably five days. Yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.45,
      "end_seconds": 43.42,
      "duration_seconds": 1.97,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.42,
      "end_seconds": 48.56,
      "duration_seconds": 3.14,
      "text": "I notice it more with movement."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.48,
      "end_seconds": 51.24,
      "duration_seconds": 1.76,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.32,
      "end_seconds": 57.53,
      "duration_seconds": 4.21,
      "text": "I mean, it settles a little with lying still"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.08,
      "end_seconds": 64.76,
      "duration_seconds": 6.68,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 64.86,
      "end_seconds": 71.42,
      "duration_seconds": 6.56,
      "text": "Tell the doctor about the other thing, uh, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.05,
      "end_seconds": 75.71,
      "duration_seconds": 2.66,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.71,
      "end_seconds": 82.28,
      "duration_seconds": 1.57,
      "text": "Any vomiting as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.52,
      "end_seconds": 84.56,
      "duration_seconds": 1.04,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.24,
      "end_seconds": 89.19,
      "duration_seconds": 2.95,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.27,
      "end_seconds": 92.34,
      "duration_seconds": 1.07,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 92.99,
      "end_seconds": 95.82,
      "duration_seconds": 2.83,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.71,
      "end_seconds": 110.63,
      "duration_seconds": 6.92,
      "text": "Do you take any prescribed or over-the-counter medicines? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.26,
      "end_seconds": 116.36,
      "duration_seconds": 4.1,
      "text": "Fluoxetine i take it 20 milligrams, every morning"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 118.02,
      "end_seconds": 123.37,
      "duration_seconds": 5.35,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 128.7,
      "duration_seconds": 4.15,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.23,
      "end_seconds": 144.57,
      "duration_seconds": 11.34,
      "text": "I don't think I have it with me. Warfarin, 3 milligrams, in the evening. I'm on ibuprofen, 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 148.24,
      "duration_seconds": 2.9,
      "text": "Right, any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.81,
      "end_seconds": 156.39,
      "duration_seconds": 6.58,
      "text": "Right, um, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 162.85,
      "duration_seconds": 4.39,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.12,
      "end_seconds": 169.71,
      "duration_seconds": 5.59,
      "text": "I've got depression. I have thin bones, for about a year"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.05,
      "end_seconds": 175.5,
      "duration_seconds": 1.45,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.27,
      "end_seconds": 180.63,
      "duration_seconds": 3.36,
      "text": "An irregular heartbeat, for about ten years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.79,
      "end_seconds": 193.74,
      "duration_seconds": 7.95,
      "text": "okay, I can see an irregular heartbeat in your file as well have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.17,
      "end_seconds": 204.32,
      "duration_seconds": 9.15,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.68,
      "end_seconds": 209.89,
      "duration_seconds": 4.21,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.49,
      "end_seconds": 215.74,
      "duration_seconds": 5.25,
      "text": "my cousin has psoriasis um, my grandmother had dementia"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.65,
      "end_seconds": 218.0,
      "duration_seconds": 1.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.52,
      "end_seconds": 222.45,
      "duration_seconds": 2.93,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.83,
      "end_seconds": 225.71,
      "duration_seconds": 1.88,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.45,
      "end_seconds": 230.65,
      "duration_seconds": 3.2,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.03,
      "end_seconds": 234.16,
      "duration_seconds": 2.13,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.69,
      "end_seconds": 240.06,
      "duration_seconds": 5.37,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.13,
      "end_seconds": 245.24,
      "duration_seconds": 3.11,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.95,
      "end_seconds": 250.55,
      "duration_seconds": 3.6,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.82,
      "end_seconds": 255.82,
      "duration_seconds": 4.0,
      "text": "Any diarrhoea, blood in the vomit or fever?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.26,
      "end_seconds": 271.69,
      "duration_seconds": 14.43,
      "text": "no, uh, no diarrhoea, no blood in the vomit, no fever. I did have shoulder tip pain at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 276.21,
      "duration_seconds": 3.7,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 278.46,
      "end_seconds": 280.58,
      "duration_seconds": 2.12,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 281.22,
      "end_seconds": 298.93,
      "duration_seconds": 17.71,
      "text": "Okay, so the vitals from earlier. Pulse is 123 beats a minute, respiratory rate 16. Blood pressure 132 over 76, saturation 99 percent, height 173 centimetres, temp 36.7 degrees, BMI works out to 19.4, weight 58 kilos."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.07,
      "end_seconds": 300.77,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.59,
      "end_seconds": 307.08,
      "duration_seconds": 4.49,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.92,
      "end_seconds": 310.26,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.15,
      "end_seconds": 328.41,
      "duration_seconds": 8.26,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.07,
      "end_seconds": 332.79,
      "duration_seconds": 1.72,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.37,
      "end_seconds": 382.45,
      "duration_seconds": 34.08,
      "text": "Okay, thinking it through, it fits best with a perforated stomach ulcer. I can't rule out pancreatitis yet. I'll request a CT scan, it'll help with possible perforation. I'm sending you for urgent blood tests because of acute abdomen. Nothing to eat or drink, you need an operation urgently. And please bring the latest prescription or the the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.54,
      "end_seconds": 401.95,
      "duration_seconds": 17.41,
      "text": "I'm not ordering an erect chest X-ray today. If things carry on in two weeks, we'll consider it. Let's review you straight away. How would you describe the plan, so so we're on the same page?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.99,
      "end_seconds": 407.67,
      "duration_seconds": 4.68,
      "text": "so, I come back straight away is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.26,
      "end_seconds": 414.1,
      "duration_seconds": 4.84,
      "text": "Alright, yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.82,
      "end_seconds": 418.89,
      "duration_seconds": 3.07,
      "text": "Great, thank you for your help."
    }
  ]
}