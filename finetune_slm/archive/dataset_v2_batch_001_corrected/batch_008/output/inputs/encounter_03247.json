{
  "schema_version": "1.0",
  "encounter_id": "03247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.92,
      "duration_seconds": 4.39,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.59,
      "end_seconds": 10.47,
      "duration_seconds": 4.88,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.25,
      "end_seconds": 17.61,
      "duration_seconds": 6.36,
      "text": "Um, so... a high sugar test in pregnancy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.68,
      "end_seconds": 22.52,
      "duration_seconds": 2.84,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.83,
      "end_seconds": 30.31,
      "duration_seconds": 6.48,
      "text": "Um, I'd say ten days. Actually, no, closer to two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.89,
      "end_seconds": 34.65,
      "duration_seconds": 3.76,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.44,
      "end_seconds": 49.41,
      "duration_seconds": 13.97,
      "text": "Severe, really. I mean, as for no symptoms, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 53.66,
      "duration_seconds": 3.52,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.34,
      "end_seconds": 58.42,
      "duration_seconds": 3.08,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 64.59,
      "duration_seconds": 4.96,
      "text": "What about a big baby on the scan, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.32,
      "end_seconds": 79.17,
      "duration_seconds": 9.85,
      "text": "Yeah. Five days, I'd say. Well, um, as for big baby on the scan, moderate, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.6,
      "end_seconds": 84.11,
      "duration_seconds": 3.51,
      "text": "Has there been any passing a lot of urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.71,
      "end_seconds": 89.35,
      "duration_seconds": 3.64,
      "text": "Definitely no passing a lot of urine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.06,
      "end_seconds": 95.19,
      "duration_seconds": 4.13,
      "text": "Did you get thirst, blurred vision or reduced baby movements?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.33,
      "end_seconds": 98.51,
      "duration_seconds": 2.18,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.12,
      "end_seconds": 105.07,
      "duration_seconds": 1.95,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.22,
      "end_seconds": 110.1,
      "duration_seconds": 3.88,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.59,
      "end_seconds": 114.31,
      "duration_seconds": 2.72,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.07,
      "end_seconds": 118.88,
      "duration_seconds": 2.81,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.04,
      "end_seconds": 124.45,
      "duration_seconds": 4.41,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.05,
      "end_seconds": 128.92,
      "duration_seconds": 3.87,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.79,
      "end_seconds": 132.22,
      "duration_seconds": 2.43,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.28,
      "end_seconds": 137.31,
      "duration_seconds": 4.03,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.6,
      "end_seconds": 149.11,
      "duration_seconds": 3.51,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.38,
      "end_seconds": 158.21,
      "duration_seconds": 4.83,
      "text": "I've had diabetes for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.11,
      "end_seconds": 161.67,
      "duration_seconds": 1.56,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.3,
      "end_seconds": 166.99,
      "duration_seconds": 3.69,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 169.09,
      "duration_seconds": 1.31,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.29,
      "end_seconds": 171.95,
      "duration_seconds": 1.66,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.86,
      "end_seconds": 182.15,
      "duration_seconds": 8.29,
      "text": "Mm, okay. Alright, eczema, that matches what I have here. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.13,
      "end_seconds": 187.78,
      "duration_seconds": 4.65,
      "text": "My father has Parkinson's disease. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.33,
      "end_seconds": 191.54,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.52,
      "end_seconds": 214.55,
      "duration_seconds": 21.03,
      "text": "Glycomet. I take it 500 milligrams, twice a day for my sugar. Diclofenac, 50 milligrams, when needed for the joint pain. Hydrocortisone cream. I take it when needed. Uh, I used to take glibenclamide, but I stopped it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.19,
      "end_seconds": 229.17,
      "duration_seconds": 1.98,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.77,
      "end_seconds": 232.59,
      "duration_seconds": 2.82,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 234.87,
      "duration_seconds": 1.26,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.58,
      "end_seconds": 240.9,
      "duration_seconds": 4.32,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.26,
      "end_seconds": 245.08,
      "duration_seconds": 2.82,
      "text": "So, do you get out much?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.22,
      "end_seconds": 250.28,
      "duration_seconds": 4.06,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.07,
      "end_seconds": 254.59,
      "duration_seconds": 3.52,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.87,
      "end_seconds": 267.82,
      "duration_seconds": 2.95,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.37,
      "end_seconds": 296.2,
      "duration_seconds": 10.83,
      "text": "Okay: weight 77 kilos, height 155 centimetres, blood pressure 118 over 69, temperature 36.7, BMI works out to 32.0, pulse 74."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.92,
      "end_seconds": 303.42,
      "duration_seconds": 4.5,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.32,
      "end_seconds": 307.1,
      "duration_seconds": 2.78,
      "text": "Okay, raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.88,
      "end_seconds": 323.61,
      "duration_seconds": 4.73,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.05,
      "end_seconds": 331.59,
      "duration_seconds": 2.54,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.27,
      "end_seconds": 349.23,
      "duration_seconds": 6.96,
      "text": "Okay, so my impression is this: My working impression is gestational diabetes controllable with diet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.18,
      "end_seconds": 354.74,
      "duration_seconds": 3.56,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.76,
      "end_seconds": 376.64,
      "duration_seconds": 20.88,
      "text": "I can't promise yet, but most people with gestational diabetes controllable with diet do well once it's treated properly. I'm going to order a glucose meter and diary, for gestational diabetes. A growth scan is what I'd like next, for gestational diabetes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.02,
      "end_seconds": 384.58,
      "duration_seconds": 3.56,
      "text": "Well, where would I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.59,
      "end_seconds": 402.78,
      "duration_seconds": 16.19,
      "text": "Replace sugary drinks and white starches with wholegrains and walk after meals. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again in two weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.4,
      "end_seconds": 407.09,
      "duration_seconds": 3.69,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.97,
      "end_seconds": 412.33,
      "duration_seconds": 3.36,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.71,
      "end_seconds": 422.36,
      "duration_seconds": 6.65,
      "text": "Sorry, what was I saying, good, thanks, I'll see you then."
    }
  ]
}