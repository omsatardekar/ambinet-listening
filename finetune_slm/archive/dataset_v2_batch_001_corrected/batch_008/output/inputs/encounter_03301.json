  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.49,
      "duration_seconds": 4.63,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.49,
      "end_seconds": 10.66,
      "duration_seconds": 4.17,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 15.49,
      "duration_seconds": 3.81,
      "text": "So, I'm here because of three early losses."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.87,
      "end_seconds": 25.66,
      "duration_seconds": 5.79,
      "text": "How long has this been bothering you? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.67,
      "end_seconds": 30.85,
      "duration_seconds": 4.18,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.4,
      "end_seconds": 37.28,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.06,
      "end_seconds": 40.99,
      "duration_seconds": 1.93,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 45.02,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.02,
      "end_seconds": 49.4,
      "duration_seconds": 3.38,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.05,
      "end_seconds": 53.01,
      "duration_seconds": 2.96,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.7,
      "end_seconds": 56.32,
      "duration_seconds": 1.62,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.57,
      "end_seconds": 73.58,
      "duration_seconds": 4.01,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.67,
      "end_seconds": 78.82,
      "duration_seconds": 3.15,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.57,
      "end_seconds": 93.61,
      "duration_seconds": 4.04,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.04,
      "end_seconds": 107.02,
      "duration_seconds": 11.98,
      "text": "My husband and I live above the shop. I work in accounts at a hospital. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 113.93,
      "duration_seconds": 5.16,
      "text": "A few quick ones: clotting problem, heavy bleeding now or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.72,
      "end_seconds": 120.61,
      "duration_seconds": 4.89,
      "text": "No, no clotting problem, heavy bleeding now or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.67,
      "end_seconds": 125.59,
      "duration_seconds": 3.92,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 128.44,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.52,
      "end_seconds": 133.66,
      "duration_seconds": 3.14,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.78,
      "end_seconds": 148.34,
      "duration_seconds": 2.56,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.31,
      "end_seconds": 171.71,
      "duration_seconds": 9.4,
      "text": "Okay: temperature is 36.5 degrees, pulse is 75 beats a minute, blood pressure 115 over 79, saturation 98 percent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.2,
      "end_seconds": 176.59,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 179.41,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 189.1,
      "duration_seconds": 1.67,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 195.76,
      "duration_seconds": 2.53,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.79,
      "end_seconds": 218.8,
      "duration_seconds": 7.01,
      "text": "From what you've told me and what I found, it fits best with recurrent miscarriage needing investigation."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.39,
      "end_seconds": 223.99,
      "duration_seconds": 3.6,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.54,
      "end_seconds": 239.37,
      "duration_seconds": 9.83,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.23,
      "end_seconds": 270.36,
      "duration_seconds": 13.13,
      "text": "We should do blood tests for recurrent miscarriage. I'm going to order a pelvic ultrasound, for recurrent miscarriage. We will arrange specialist care so the next pregnancy is looked after from the start."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.87,
      "end_seconds": 278.92,
      "duration_seconds": 8.05,
      "text": "Understood. I'd like you to see the recurrent miscarriage clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.78,
      "end_seconds": 281.48,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.18,
      "end_seconds": 285.93,
      "duration_seconds": 3.75,
      "text": "Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.29,
      "end_seconds": 288.79,
      "duration_seconds": 1.5,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.57,
      "end_seconds": 297.52,
      "duration_seconds": 7.95,
      "text": "I'd like to see you again after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.73,
      "end_seconds": 302.53,
      "duration_seconds": 3.8,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.96,
      "end_seconds": 305.15,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
