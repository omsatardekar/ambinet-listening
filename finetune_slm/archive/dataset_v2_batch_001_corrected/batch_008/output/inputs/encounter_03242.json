{
  "schema_version": "1.0",
  "encounter_id": "03242",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.67,
      "duration_seconds": 3.72,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.23,
      "end_seconds": 10.29,
      "duration_seconds": 5.06,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 16.99,
      "duration_seconds": 5.32,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.68,
      "end_seconds": 23.7,
      "duration_seconds": 6.02,
      "text": "Let me think, I've been dealing with vomiting once or twice."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.52,
      "end_seconds": 28.39,
      "duration_seconds": 2.87,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.9,
      "end_seconds": 38.93,
      "duration_seconds": 10.03,
      "text": "It's tamsulosin, 0.4 milligrams, at night for the prostate, doctor. He takes oral rehydration solution, 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.39,
      "end_seconds": 42.79,
      "duration_seconds": 3.4,
      "text": "Mm-hmm. Okay, did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.43,
      "end_seconds": 47.21,
      "duration_seconds": 2.78,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.58,
      "end_seconds": 56.24,
      "duration_seconds": 8.66,
      "text": "Right, right. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 74.2,
      "duration_seconds": 16.01,
      "text": "Mild, really. It's all the time. I wasn't sure whether to come in at all, to be honest. Oh, and loose stools. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.85,
      "end_seconds": 95.01,
      "duration_seconds": 5.16,
      "text": "Any no wet nappies, drowsiness, high fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.44,
      "end_seconds": 99.95,
      "duration_seconds": 3.51,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 103.42,
      "duration_seconds": 1.96,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.22,
      "end_seconds": 108.01,
      "duration_seconds": 3.79,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.6,
      "end_seconds": 113.75,
      "duration_seconds": 5.15,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.14,
      "end_seconds": 118.33,
      "duration_seconds": 3.19,
      "text": "Okay, so no, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 122.2,
      "duration_seconds": 2.57,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.95,
      "end_seconds": 126.34,
      "duration_seconds": 2.39,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.57,
      "end_seconds": 140.49,
      "duration_seconds": 12.92,
      "text": "Right, right. Yes, an enlarged prostate is known to us, good to have that clear. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.26,
      "end_seconds": 153.1,
      "duration_seconds": 11.84,
      "text": "I do a yoga class on Thursdays. No, I share a house with my brother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.43,
      "end_seconds": 167.34,
      "duration_seconds": 3.91,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.2,
      "end_seconds": 180.03,
      "duration_seconds": 2.83,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.59,
      "end_seconds": 203.69,
      "duration_seconds": 9.1,
      "text": "Okay: pulse is 81 beats a minute, pressure 117 over 73. And respiratory rate 16, temp 36.6 degrees, saturation 97 percent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.69,
      "end_seconds": 212.0,
      "duration_seconds": 2.31,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.15,
      "end_seconds": 215.73,
      "duration_seconds": 2.58,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.66,
      "end_seconds": 219.8,
      "duration_seconds": 2.14,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.83,
      "end_seconds": 233.75,
      "duration_seconds": 0.92,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.37,
      "end_seconds": 237.39,
      "duration_seconds": 2.02,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.41,
      "end_seconds": 255.49,
      "duration_seconds": 5.08,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.3,
      "end_seconds": 275.13,
      "duration_seconds": 14.83,
      "text": "Good, you can sit up again. Let me tell you where I've got to. This looks most like a mild stomach bug. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.21,
      "end_seconds": 279.56,
      "duration_seconds": 2.35,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.41,
      "end_seconds": 310.75,
      "duration_seconds": 29.34,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. Small, frequent sips of fluid and keep him off nursery for two days after it stops. If he stops drinking or becomes drowsy, or you feel really unwell, please come to the emergency department. I'd like you back if he is not drinking. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.59,
      "end_seconds": 314.73,
      "duration_seconds": 3.14,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.47,
      "end_seconds": 317.25,
      "duration_seconds": 1.78,
      "text": "Have a good day."
    }
  ]
}