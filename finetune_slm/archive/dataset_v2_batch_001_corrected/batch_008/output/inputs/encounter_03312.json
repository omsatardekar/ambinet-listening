{
  "schema_version": "1.0",
  "encounter_id": "03312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.35,
      "duration_seconds": 3.56,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.15,
      "end_seconds": 9.85,
      "duration_seconds": 4.7,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.45,
      "end_seconds": 23.9,
      "duration_seconds": 12.45,
      "text": "Honestly, it's being sick, and my family pushed me to come. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.86,
      "end_seconds": 29.61,
      "duration_seconds": 3.75,
      "text": "when was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.91,
      "end_seconds": 34.34,
      "duration_seconds": 3.43,
      "text": "hmm, for ten days, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.87,
      "end_seconds": 43.11,
      "duration_seconds": 8.24,
      "text": "Yes. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.92,
      "end_seconds": 49.03,
      "duration_seconds": 5.11,
      "text": "It happens every other day. Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.03,
      "end_seconds": 57.85,
      "duration_seconds": 3.82,
      "text": "has there been any weakness on one side?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.73,
      "end_seconds": 63.48,
      "duration_seconds": 3.75,
      "text": "Not at all, no weakness on one side."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.55,
      "end_seconds": 68.5,
      "duration_seconds": 3.95,
      "text": "have you had any fever or head injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.2,
      "end_seconds": 75.12,
      "duration_seconds": 5.92,
      "text": "So, um, no fever or head injury, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.96,
      "end_seconds": 79.6,
      "duration_seconds": 3.64,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.94,
      "end_seconds": 86.45,
      "duration_seconds": 1.51,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 109.58,
      "duration_seconds": 4.92,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 114.49,
      "duration_seconds": 3.08,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.03,
      "end_seconds": 116.5,
      "duration_seconds": 1.47,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.12,
      "end_seconds": 120.39,
      "duration_seconds": 3.27,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.19,
      "end_seconds": 124.52,
      "duration_seconds": 2.33,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 130.44,
      "duration_seconds": 3.88,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.81,
      "end_seconds": 144.82,
      "duration_seconds": 5.01,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.85,
      "end_seconds": 150.56,
      "duration_seconds": 3.71,
      "text": "I'm allergic to kiwi, I get hives."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.65,
      "end_seconds": 154.43,
      "duration_seconds": 2.78,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.88,
      "end_seconds": 157.65,
      "duration_seconds": 1.77,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.95,
      "end_seconds": 174.65,
      "duration_seconds": 2.7,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.31,
      "end_seconds": 184.41,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 202.04,
      "duration_seconds": 7.69,
      "text": "Okay: temperature 36.4, heart rate 81, saturation 97 percent, respiratory rate 16, pressure 172 over 95."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.21,
      "end_seconds": 205.29,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.99,
      "end_seconds": 208.85,
      "duration_seconds": 2.86,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.38,
      "end_seconds": 215.8,
      "duration_seconds": 4.42,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.82,
      "end_seconds": 218.82,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.81,
      "end_seconds": 221.73,
      "duration_seconds": 1.92,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.56,
      "end_seconds": 242.42,
      "duration_seconds": 4.86,
      "text": "the optic discs look swollen and and you are drowsy"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.0,
      "end_seconds": 246.92,
      "duration_seconds": 1.92,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.03,
      "end_seconds": 278.54,
      "duration_seconds": 23.51,
      "text": "Having listened and examined, it fits best with possible cerebral venous thrombosis. That's my thinking for now, and it may change as we learn more. I'd like to arrange an urgent CT venogram for possible venous thrombosis. The result will help us decide whether anything more is needed. I'm going to order an MRI of the head, for papilloedema."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.69,
      "end_seconds": 282.56,
      "duration_seconds": 2.87,
      "text": "Yeah, how long will it take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.25,
      "end_seconds": 293.85,
      "duration_seconds": 9.6,
      "text": "Stop the pill, you need an urgent scan and admission. I'm going to send a referral to the neurology team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.14,
      "end_seconds": 298.38,
      "duration_seconds": 3.24,
      "text": "Mm, sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.09,
      "end_seconds": 306.12,
      "duration_seconds": 6.03,
      "text": "one warning sign to remember: the symptoms get worse. In that case don't wait"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.1,
      "end_seconds": 309.81,
      "duration_seconds": 1.71,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.58,
      "end_seconds": 317.89,
      "duration_seconds": 6.31,
      "text": "Let's review you straight away. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.69,
      "end_seconds": 323.17,
      "duration_seconds": 3.48,
      "text": "Great, thank you for your help."
    }
  ]
}