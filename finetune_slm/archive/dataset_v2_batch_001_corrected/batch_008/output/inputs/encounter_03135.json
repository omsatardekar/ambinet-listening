{
  "schema_version": "1.0",
  "encounter_id": "03135",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.94,
      "duration_seconds": 2.96,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.49,
      "end_seconds": 10.6,
      "duration_seconds": 6.11,
      "text": "sorry, what was I saying, good morning, doctor, thank you"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.71,
      "end_seconds": 18.9,
      "duration_seconds": 7.19,
      "text": "I mean, morning, doctor. I'll stay and and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.89,
      "end_seconds": 25.44,
      "duration_seconds": 5.55,
      "text": "please do extra information is always welcome what do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.1,
      "end_seconds": 38.05,
      "duration_seconds": 10.95,
      "text": "ah, um, it's a pearly bump on my nose that bleeds, doctor. He didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.28,
      "end_seconds": 42.42,
      "duration_seconds": 3.14,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 47.77,
      "duration_seconds": 4.67,
      "text": "Uh, uh, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.33,
      "end_seconds": 53.29,
      "duration_seconds": 4.96,
      "text": "um, I think it's been nearer five days, actually"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 59.39,
      "duration_seconds": 4.0,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.37,
      "end_seconds": 65.98,
      "duration_seconds": 4.61,
      "text": "Right, you know, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.48,
      "end_seconds": 69.91,
      "duration_seconds": 3.43,
      "text": "Hm, okay. What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 73.67,
      "duration_seconds": 3.18,
      "text": "It's, It's worse with washing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.26,
      "end_seconds": 82.43,
      "duration_seconds": 8.17,
      "text": "Hmm, um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 82.53,
      "end_seconds": 88.74,
      "duration_seconds": 6.21,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.65,
      "end_seconds": 92.97,
      "duration_seconds": 2.32,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.19,
      "end_seconds": 97.77,
      "duration_seconds": 3.58,
      "text": "Well, um, there's crusting as well."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.73,
      "end_seconds": 101.52,
      "duration_seconds": 2.79,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.03,
      "end_seconds": 103.6,
      "duration_seconds": 1.57,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.92,
      "end_seconds": 104.62,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.01,
      "end_seconds": 120.97,
      "duration_seconds": 14.96,
      "text": "Well, uh, as for sore that won't heal, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 125.66,
      "duration_seconds": 2.54,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.71,
      "end_seconds": 136.05,
      "duration_seconds": 4.34,
      "text": "Well, a five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 137.83,
      "end_seconds": 140.47,
      "duration_seconds": 2.64,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.45,
      "end_seconds": 145.82,
      "duration_seconds": 4.37,
      "text": "have you noticed family history of skin cancer or swollen glands?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.43,
      "end_seconds": 154.39,
      "duration_seconds": 6.96,
      "text": "no, uh, no family history of skin cancer or swollen glands"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.08,
      "end_seconds": 162.65,
      "duration_seconds": 2.57,
      "text": "Any pain or other new lumps?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.34,
      "end_seconds": 167.77,
      "duration_seconds": 4.43,
      "text": "well, no, none of those at all"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.66,
      "end_seconds": 173.12,
      "duration_seconds": 3.46,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.64,
      "end_seconds": 177.1,
      "duration_seconds": 2.46,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 181.38,
      "duration_seconds": 2.88,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.16,
      "end_seconds": 190.08,
      "duration_seconds": 3.92,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.62,
      "end_seconds": 207.07,
      "duration_seconds": 2.45,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.13,
      "end_seconds": 211.65,
      "duration_seconds": 3.52,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.25,
      "end_seconds": 216.19,
      "duration_seconds": 2.94,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.81,
      "end_seconds": 220.86,
      "duration_seconds": 4.05,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.45,
      "end_seconds": 225.86,
      "duration_seconds": 3.41,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.95,
      "end_seconds": 230.66,
      "duration_seconds": 2.71,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.65,
      "end_seconds": 244.08,
      "duration_seconds": 3.43,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.09,
      "end_seconds": 253.8,
      "duration_seconds": 7.71,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.56,
      "end_seconds": 258.17,
      "duration_seconds": 2.61,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.56,
      "end_seconds": 275.14,
      "duration_seconds": 15.58,
      "text": "For the gout, I believe. My son sets them out for me, I just take what I'm given. Aspirin. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 276.41,
      "end_seconds": 286.8,
      "duration_seconds": 10.39,
      "text": "Hmm, he is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.59,
      "end_seconds": 291.0,
      "duration_seconds": 2.41,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.12,
      "end_seconds": 293.62,
      "duration_seconds": 1.5,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.0,
      "end_seconds": 298.94,
      "duration_seconds": 0.94,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.05,
      "end_seconds": 334.54,
      "duration_seconds": 32.49,
      "text": "I've had heart disease for five years now. I looked a few things up online, um, and that probably didn't help. A neighbour of mine said I should see someone about it. I've had high cholesterol for about ten years now. I just want to get back to normal, really. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.42,
      "end_seconds": 338.53,
      "duration_seconds": 3.11,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.49,
      "end_seconds": 346.17,
      "duration_seconds": 6.68,
      "text": "My father has Parkinson's disease. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 347.81,
      "end_seconds": 358.77,
      "duration_seconds": 10.96,
      "text": "okay, so the vitals from earlier blood pressure 109 over 75, pulse is 69 beats a minute, temperature is 36.4 degrees, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.84,
      "end_seconds": 361.27,
      "duration_seconds": 1.43,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.48,
      "end_seconds": 367.51,
      "duration_seconds": 5.03,
      "text": "so, I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.02,
      "end_seconds": 371.91,
      "duration_seconds": 2.89,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.82,
      "end_seconds": 374.09,
      "duration_seconds": 1.27,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.01,
      "end_seconds": 399.3,
      "duration_seconds": 8.29,
      "text": "there is a pearly nodule with fine surface vessels and a central dip on the side of the nose"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.97,
      "end_seconds": 424.32,
      "duration_seconds": 19.35,
      "text": "Thank you, you can get dressed. Having listened and examined, it points towards a likely basal cell carcinoma. That's my thinking for now, and it may change as we learn more. I can't rule out a squamous cell carcinoma yet."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.74,
      "end_seconds": 430.77,
      "duration_seconds": 5.03,
      "text": "Uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 431.61,
      "end_seconds": 444.48,
      "duration_seconds": 12.87,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely basal cell carcinoma, but I'd like to confirm. I'm going to order a dermoscopy, for suspicious lesion."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 445.09,
      "end_seconds": 447.53,
      "duration_seconds": 2.44,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.42,
      "end_seconds": 452.75,
      "duration_seconds": 4.33,
      "text": "I'll request a skin biopsy, it'll help with suspicious lesion"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 454.3,
      "end_seconds": 455.78,
      "duration_seconds": 1.48,
      "text": "does it hurt?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.8,
      "end_seconds": 477.05,
      "duration_seconds": 19.25,
      "text": "please use a high-factor sunscreen and a hat. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'm going to send a referral to the skin cancer clinic"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 478.55,
      "end_seconds": 479.25,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 481.21,
      "end_seconds": 493.55,
      "duration_seconds": 12.34,
      "text": "Do get help quickly if the symptoms get worse. I'd like to to see you again after the biopsy. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 494.43,
      "end_seconds": 498.39,
      "duration_seconds": 3.96,
      "text": "oh, no, that's all. Thanks a lot"
    }
  ]
}