{
  "schema_version": "1.0",
  "encounter_id": "03093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.17,
      "duration_seconds": 3.17,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 10.75,
      "duration_seconds": 5.21,
      "text": "Right, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.85,
      "end_seconds": 15.44,
      "duration_seconds": 3.59,
      "text": "it's a sudden severe tummy pain, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.48,
      "end_seconds": 20.33,
      "duration_seconds": 2.85,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.52,
      "end_seconds": 26.06,
      "duration_seconds": 2.54,
      "text": "No I'm not on anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.18,
      "end_seconds": 28.97,
      "duration_seconds": 1.79,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.73,
      "end_seconds": 32.17,
      "duration_seconds": 2.44,
      "text": "about... well, about a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.9,
      "end_seconds": 37.03,
      "duration_seconds": 3.13,
      "text": "is it it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.95,
      "end_seconds": 42.24,
      "duration_seconds": 4.29,
      "text": "um yes movement that that makes it worse"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.15,
      "end_seconds": 47.81,
      "duration_seconds": 4.66,
      "text": "Alright, and what about fever, blood in the vomit or diarrhoea?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.92,
      "end_seconds": 54.21,
      "duration_seconds": 3.29,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.04,
      "end_seconds": 59.83,
      "duration_seconds": 4.79,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.15,
      "end_seconds": 63.25,
      "duration_seconds": 2.1,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.74,
      "end_seconds": 83.16,
      "duration_seconds": 7.42,
      "text": "Do you have any medical conditions I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 86.99,
      "duration_seconds": 3.01,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.35,
      "end_seconds": 91.1,
      "duration_seconds": 2.75,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.68,
      "end_seconds": 105.77,
      "duration_seconds": 13.09,
      "text": "Not much, I mostly stay in these days. Yes, I work in a bakery, early starts. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.2,
      "end_seconds": 112.05,
      "duration_seconds": 4.85,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.14,
      "end_seconds": 118.65,
      "duration_seconds": 4.51,
      "text": "Grass pollen i come out in... well, sneezing"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.62,
      "end_seconds": 134.14,
      "duration_seconds": 2.52,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.71,
      "end_seconds": 142.73,
      "duration_seconds": 2.02,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.19,
      "end_seconds": 168.21,
      "duration_seconds": 10.02,
      "text": "Okay: pressure 120 over 84, respiratory rate 16, temp 36.9 degrees. And SpO2 98 percent on room air, heart rate 112."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.25,
      "end_seconds": 174.22,
      "duration_seconds": 3.97,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.36,
      "end_seconds": 191.27,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.2,
      "end_seconds": 194.02,
      "duration_seconds": 1.82,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.17,
      "end_seconds": 218.96,
      "duration_seconds": 6.79,
      "text": "your tummy is rigid like a board and very tender everywhere, and you are lying completely still"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 236.36,
      "duration_seconds": 11.93,
      "text": "you can relax now okay thinking it through I don't have a clear answer today: a perforated stomach ulcer is possible and so is pancreatitis"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.19,
      "end_seconds": 241.51,
      "duration_seconds": 3.32,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 255.6,
      "duration_seconds": 12.25,
      "text": "I understand the worry. At the moment I'd say it's a perforated stomach ulcer and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.06,
      "end_seconds": 274.5,
      "duration_seconds": 7.44,
      "text": "We should do urgent blood tests for acute abdomen. We should do an erect chest X-ray for possible perforation."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.16,
      "end_seconds": 276.72,
      "duration_seconds": 1.56,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.76,
      "end_seconds": 297.92,
      "duration_seconds": 20.16,
      "text": "Nothing to eat or drink you need an operation urgently. Make sure you're drinking plenty of fluids two to three litres a day if you can and get proper rest. I'd like you to see the surgical team as well and I'll write the referral."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.19,
      "end_seconds": 300.59,
      "duration_seconds": 1.4,
      "text": "alright thank you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.37,
      "end_seconds": 307.66,
      "duration_seconds": 6.29,
      "text": "I'd like you back straight away does all of that that make sense?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.11,
      "end_seconds": 314.09,
      "duration_seconds": 3.98,
      "text": "right, I'll do that. Thank you, doctor"
    }
  ]
}