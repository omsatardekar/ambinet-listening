{
  "schema_version": "1.0",
  "encounter_id": "03359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.34,
      "duration_seconds": 2.83,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.91,
      "end_seconds": 7.56,
      "duration_seconds": 3.65,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.34,
      "end_seconds": 20.64,
      "duration_seconds": 12.3,
      "text": "Hmm, doctor, I'll sit in if that's okay, I know what's been happening. She's been coughing up large amounts of blood, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.4,
      "end_seconds": 23.64,
      "duration_seconds": 2.24,
      "text": "So, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.76,
      "end_seconds": 27.43,
      "duration_seconds": 2.67,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.17,
      "end_seconds": 32.3,
      "duration_seconds": 4.13,
      "text": "Oh, it was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.16,
      "end_seconds": 37.24,
      "duration_seconds": 4.08,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.22,
      "end_seconds": 39.39,
      "duration_seconds": 1.17,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.12,
      "end_seconds": 44.73,
      "duration_seconds": 4.61,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.25,
      "end_seconds": 53.9,
      "duration_seconds": 8.65,
      "text": "It's once or twice a day. I'd give it a four, you know, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.85,
      "end_seconds": 57.11,
      "duration_seconds": 2.26,
      "text": "Has there been breathlessness too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.73,
      "end_seconds": 74.24,
      "duration_seconds": 15.51,
      "text": "Yes, actually. As for breathlessness, I'd say every other day. And I've been feeling faint as well, you know, for about four days. About feeling faint, moderate, really. I'd say all the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.14,
      "end_seconds": 82.53,
      "duration_seconds": 6.39,
      "text": "Have you been coughing up large amounts of blood at any time before this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.6,
      "end_seconds": 90.19,
      "duration_seconds": 5.59,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.38,
      "end_seconds": 102.56,
      "duration_seconds": 3.18,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.3,
      "end_seconds": 116.08,
      "duration_seconds": 2.78,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.86,
      "end_seconds": 137.09,
      "duration_seconds": 10.23,
      "text": "Okay: heart rate 103, temperature is 37.2 degrees, SpO2 91 percent on room air. And BP is 128 over 83, respiratory rate 21."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.17,
      "end_seconds": 140.8,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.49,
      "end_seconds": 144.37,
      "duration_seconds": 2.88,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 150.82,
      "duration_seconds": 4.54,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.73,
      "end_seconds": 165.14,
      "duration_seconds": 1.41,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.9,
      "end_seconds": 168.69,
      "duration_seconds": 1.79,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.72,
      "end_seconds": 181.95,
      "duration_seconds": 5.23,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.75,
      "end_seconds": 193.21,
      "duration_seconds": 6.46,
      "text": "Thank you, you can get dressed. Right, any weight loss, fever or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.75,
      "end_seconds": 196.71,
      "duration_seconds": 2.96,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.69,
      "end_seconds": 201.23,
      "duration_seconds": 2.54,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.94,
      "end_seconds": 205.78,
      "duration_seconds": 2.84,
      "text": "Well, no, that's all fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.67,
      "end_seconds": 210.37,
      "duration_seconds": 2.7,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.18,
      "end_seconds": 214.05,
      "duration_seconds": 2.87,
      "text": "No, um, skin's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.57,
      "end_seconds": 217.44,
      "duration_seconds": 2.87,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.07,
      "end_seconds": 223.13,
      "duration_seconds": 4.06,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.73,
      "end_seconds": 225.83,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.59,
      "end_seconds": 231.77,
      "duration_seconds": 5.18,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.28,
      "end_seconds": 235.4,
      "duration_seconds": 2.12,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.56,
      "end_seconds": 240.97,
      "duration_seconds": 4.41,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.36,
      "end_seconds": 246.22,
      "duration_seconds": 3.86,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.03,
      "end_seconds": 250.49,
      "duration_seconds": 3.46,
      "text": "Hydrocortisone cream. I take it when needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.51,
      "end_seconds": 255.41,
      "duration_seconds": 2.9,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.73,
      "end_seconds": 258.67,
      "duration_seconds": 1.94,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.26,
      "end_seconds": 272.25,
      "duration_seconds": 2.99,
      "text": "Alright, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.96,
      "end_seconds": 280.1,
      "duration_seconds": 4.14,
      "text": "Right, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.93,
      "end_seconds": 285.24,
      "duration_seconds": 4.31,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.15,
      "end_seconds": 288.58,
      "duration_seconds": 1.43,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.62,
      "end_seconds": 310.83,
      "duration_seconds": 21.21,
      "text": "Having listened and examined, my working impression is life-threatening haemoptysis. I want to be honest that this is an impression, not a final answer. I want urgent blood tests done, that's for bleeding. I want an urgent CT scan done, that's for massive haemoptysis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.8,
      "end_seconds": 314.43,
      "duration_seconds": 1.63,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.38,
      "end_seconds": 340.4,
      "duration_seconds": 24.02,
      "text": "For this, tranexamic acid, 1 gram, now, single dose. It's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look straight away. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.43,
      "end_seconds": 345.77,
      "duration_seconds": 3.34,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.32,
      "end_seconds": 348.53,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}