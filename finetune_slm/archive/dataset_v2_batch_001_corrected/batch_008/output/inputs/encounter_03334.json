{
  "schema_version": "1.0",
  "encounter_id": "03334",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 3.44,
      "duration_seconds": 2.12,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.09,
      "end_seconds": 6.33,
      "duration_seconds": 1.24,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 9.01,
      "duration_seconds": 1.81,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.01,
      "end_seconds": 18.97,
      "duration_seconds": 8.96,
      "text": "It's tiredness. I thought I'd wait, you know, but it hasn't gone. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.96,
      "end_seconds": 24.27,
      "duration_seconds": 3.31,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.28,
      "end_seconds": 28.53,
      "duration_seconds": 3.25,
      "text": "Hmm, it's been ten days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.61,
      "end_seconds": 44.59,
      "duration_seconds": 2.98,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.49,
      "end_seconds": 49.31,
      "duration_seconds": 2.82,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.25,
      "end_seconds": 55.56,
      "duration_seconds": 4.31,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.58,
      "end_seconds": 58.24,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.03,
      "end_seconds": 75.85,
      "duration_seconds": 1.82,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.36,
      "end_seconds": 77.89,
      "duration_seconds": 1.53,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.26,
      "end_seconds": 93.81,
      "duration_seconds": 4.55,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.18,
      "end_seconds": 97.51,
      "duration_seconds": 2.33,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.31,
      "end_seconds": 100.76,
      "duration_seconds": 1.45,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.03,
      "end_seconds": 105.83,
      "duration_seconds": 3.8,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.78,
      "end_seconds": 112.03,
      "duration_seconds": 1.25,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.87,
      "end_seconds": 116.45,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.42,
      "end_seconds": 119.69,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.56,
      "end_seconds": 127.1,
      "duration_seconds": 5.54,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.75,
      "end_seconds": 134.73,
      "duration_seconds": 1.98,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.64,
      "end_seconds": 140.96,
      "duration_seconds": 4.32,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.53,
      "end_seconds": 149.06,
      "duration_seconds": 6.53,
      "text": "Let me check a few things. Any chest pain on exertion, breathlessness or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.98,
      "end_seconds": 153.38,
      "duration_seconds": 3.4,
      "text": "I mean, none of those, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.22,
      "end_seconds": 156.29,
      "duration_seconds": 2.07,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.16,
      "end_seconds": 159.17,
      "duration_seconds": 1.01,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.67,
      "end_seconds": 182.4,
      "duration_seconds": 4.73,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.97,
      "end_seconds": 192.31,
      "duration_seconds": 2.34,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 213.88,
      "duration_seconds": 8.77,
      "text": "Okay: pulse 83, temp 36.6 degrees, blood pressure 108 over 75, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.59,
      "end_seconds": 218.07,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.7,
      "end_seconds": 221.9,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.05,
      "end_seconds": 248.81,
      "duration_seconds": 9.76,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.26,
      "end_seconds": 265.82,
      "duration_seconds": 11.56,
      "text": "Please sit back down. From what you've told me and what I found, it points towards recovering well after bypass surgery. We should do an ECG for post-operative review."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.84,
      "end_seconds": 269.07,
      "duration_seconds": 1.23,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.29,
      "end_seconds": 303.15,
      "duration_seconds": 32.86,
      "text": "I'd like to arrange blood tests for post-operative review. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I'd like you to see the cardiac rehabilitation team as well, and I'll write the referral. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Book a review in six weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.24,
      "end_seconds": 307.59,
      "duration_seconds": 3.35,
      "text": "Mm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.11,
      "end_seconds": 311.04,
      "duration_seconds": 1.93,
      "text": "Alright, all the best."
    }
  ]
}