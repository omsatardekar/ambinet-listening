{
  "schema_version": "1.0",
  "encounter_id": "03494",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 4.27,
      "duration_seconds": 3.4,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.12,
      "end_seconds": 13.53,
      "duration_seconds": 5.41,
      "text": "Alright, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.51,
      "end_seconds": 24.19,
      "duration_seconds": 9.68,
      "text": "Um, so... sudden severe pain in the lower tummy. That's why I came. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.86,
      "end_seconds": 29.08,
      "duration_seconds": 3.22,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.46,
      "end_seconds": 39.65,
      "duration_seconds": 9.19,
      "text": "It's been like this since yesterday. Okay, so I've also had vaginal spotting, since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.44,
      "end_seconds": 61.5,
      "duration_seconds": 3.06,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 76.59,
      "duration_seconds": 3.05,
      "text": "Alright, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 110.68,
      "duration_seconds": 18.6,
      "text": "Okay: SpO2 99 percent on room air, respiratory rate 18, height 160 centimetres, blood pressure 103 over 57, BMI works out to 27.0, weight 69 kilos, temperature 36.4, pulse is 112 beats a minute."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 116.66,
      "duration_seconds": 3.1,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.64,
      "end_seconds": 120.18,
      "duration_seconds": 2.54,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.01,
      "end_seconds": 144.5,
      "duration_seconds": 6.49,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.76,
      "end_seconds": 158.32,
      "duration_seconds": 1.56,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.78,
      "end_seconds": 165.15,
      "duration_seconds": 2.37,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.85,
      "end_seconds": 177.85,
      "duration_seconds": 2.0,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.63,
      "end_seconds": 181.71,
      "duration_seconds": 2.08,
      "text": "No, none, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.27,
      "end_seconds": 185.04,
      "duration_seconds": 1.77,
      "text": "Any vomiting or discharge?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.08,
      "end_seconds": 188.71,
      "duration_seconds": 2.63,
      "text": "No, no vomiting or discharge."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.75,
      "end_seconds": 194.7,
      "duration_seconds": 3.95,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.34,
      "end_seconds": 199.7,
      "duration_seconds": 4.36,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.29,
      "end_seconds": 205.39,
      "duration_seconds": 4.1,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.2,
      "end_seconds": 212.33,
      "duration_seconds": 3.13,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.21,
      "end_seconds": 215.86,
      "duration_seconds": 2.65,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.91,
      "end_seconds": 219.58,
      "duration_seconds": 1.67,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.53,
      "end_seconds": 224.76,
      "duration_seconds": 4.23,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.65,
      "end_seconds": 229.03,
      "duration_seconds": 3.38,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 232.39,
      "duration_seconds": 1.78,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.36,
      "end_seconds": 239.14,
      "duration_seconds": 4.78,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 245.83,
      "duration_seconds": 4.79,
      "text": "Have you got any known allergies? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.78,
      "end_seconds": 249.75,
      "duration_seconds": 2.97,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 254.21,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.82,
      "end_seconds": 257.92,
      "duration_seconds": 3.1,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.59,
      "end_seconds": 264.17,
      "duration_seconds": 5.58,
      "text": "Okay, thinking it through, it points towards a ruptured ectopic pregnancy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.86,
      "end_seconds": 284.15,
      "duration_seconds": 3.29,
      "text": "We should do a pregnancy test for collapse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 286.03,
      "end_seconds": 289.65,
      "duration_seconds": 3.62,
      "text": "I can book that for Monday at 9 am."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.67,
      "end_seconds": 304.8,
      "duration_seconds": 14.13,
      "text": "I am calling the emergency team, you need an operation now. The emergency team would be the right next step, I'll refer you. See me again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.41,
      "end_seconds": 309.75,
      "duration_seconds": 3.34,
      "text": "I think I understand everything. Thanks."
    }
  ]
}