{
  "schema_version": "1.0",
  "encounter_id": "03060",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 5.34,
      "duration_seconds": 4.74,
      "text": "Well hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.41,
      "end_seconds": 11.31,
      "duration_seconds": 3.9,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.83,
      "end_seconds": 15.52,
      "duration_seconds": 3.69,
      "text": "it's vomiting once or twice, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.34,
      "end_seconds": 20.56,
      "duration_seconds": 3.22,
      "text": "right what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.71,
      "end_seconds": 25.71,
      "duration_seconds": 4.0,
      "text": "Lansoprazole, 30 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 32.54,
      "duration_seconds": 3.58,
      "text": "alright, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.63,
      "end_seconds": 38.87,
      "duration_seconds": 4.24,
      "text": "Uh, uh, no, it's at home."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.93,
      "end_seconds": 44.15,
      "duration_seconds": 4.22,
      "text": "Okay how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.7,
      "end_seconds": 48.05,
      "duration_seconds": 3.35,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.64,
      "end_seconds": 56.44,
      "duration_seconds": 7.8,
      "text": "Can you describe it a bit more for me? How strong it is what the pattern is what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.41,
      "end_seconds": 67.0,
      "duration_seconds": 9.59,
      "text": "Honestly, all the time. A seven out of ten, I suppose. Oh, and a mild tummy ache."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.38,
      "end_seconds": 70.87,
      "duration_seconds": 2.49,
      "text": "Has there been loose stools too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.32,
      "end_seconds": 79.07,
      "duration_seconds": 6.75,
      "text": "Yes, actually. Sorry, what was I saying, about loose stools, moderate, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.85,
      "end_seconds": 86.37,
      "duration_seconds": 6.52,
      "text": "have you had any no wet nappies, drowsiness, high fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.4,
      "end_seconds": 89.58,
      "duration_seconds": 2.18,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.11,
      "end_seconds": 94.51,
      "duration_seconds": 3.4,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.27,
      "end_seconds": 101.41,
      "duration_seconds": 6.14,
      "text": "sorry uh what was I saying nothing on the skin no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.63,
      "end_seconds": 116.51,
      "duration_seconds": 2.88,
      "text": "okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.2,
      "end_seconds": 120.05,
      "duration_seconds": 2.85,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.37,
      "end_seconds": 123.55,
      "duration_seconds": 2.18,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.05,
      "end_seconds": 128.14,
      "duration_seconds": 4.09,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.67,
      "end_seconds": 133.97,
      "duration_seconds": 4.3,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.76,
      "end_seconds": 139.07,
      "duration_seconds": 4.31,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.03,
      "end_seconds": 142.32,
      "duration_seconds": 2.29,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.92,
      "end_seconds": 153.8,
      "duration_seconds": 9.88,
      "text": "just a wisdom tooth extraction under sedation, five years ago i did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.84,
      "end_seconds": 160.74,
      "duration_seconds": 4.9,
      "text": "do you react to to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.02,
      "end_seconds": 169.35,
      "duration_seconds": 7.33,
      "text": "years back I got a rash from naproxen so I stay away from it now"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.11,
      "end_seconds": 172.89,
      "duration_seconds": 2.78,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.44,
      "end_seconds": 175.41,
      "duration_seconds": 1.97,
      "text": "I've got acid reflux"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.76,
      "end_seconds": 180.74,
      "duration_seconds": 3.98,
      "text": "alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.6,
      "end_seconds": 183.6,
      "duration_seconds": 2.0,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.54,
      "end_seconds": 203.08,
      "duration_seconds": 3.54,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.45,
      "end_seconds": 211.97,
      "duration_seconds": 2.52,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.82,
      "end_seconds": 235.64,
      "duration_seconds": 2.82,
      "text": "Okay: pressure 128 over 72 pulse 65."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.05,
      "end_seconds": 238.68,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.26,
      "end_seconds": 241.9,
      "duration_seconds": 2.64,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.86,
      "end_seconds": 248.59,
      "duration_seconds": 3.73,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.33,
      "end_seconds": 255.81,
      "duration_seconds": 1.48,
      "text": "Yes that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.33,
      "end_seconds": 259.69,
      "duration_seconds": 2.36,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.14,
      "end_seconds": 276.62,
      "duration_seconds": 5.48,
      "text": "he is alert, drinking, with moist lips and a soft tummy"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.07,
      "end_seconds": 284.63,
      "duration_seconds": 2.56,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.56,
      "end_seconds": 325.31,
      "duration_seconds": 21.75,
      "text": "okay thinking it through I think we're dealing with a mild stomach bug at this stage. Small frequent sips of fluid and keep him off nursery for two days after it stops. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.02,
      "end_seconds": 331.66,
      "duration_seconds": 1.64,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.49,
      "end_seconds": 340.71,
      "duration_seconds": 8.22,
      "text": "Let's plan a check if he is not drinking. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.03,
      "end_seconds": 346.35,
      "duration_seconds": 4.32,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.27,
      "end_seconds": 349.17,
      "duration_seconds": 1.9,
      "text": "all the the best"
    }
  ]
}