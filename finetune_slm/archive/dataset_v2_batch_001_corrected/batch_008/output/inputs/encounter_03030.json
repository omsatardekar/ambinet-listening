{
  "schema_version": "1.0",
  "encounter_id": "03030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.69,
      "duration_seconds": 5.33,
      "text": "Yeah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.08,
      "end_seconds": 12.13,
      "duration_seconds": 4.05,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.71,
      "end_seconds": 17.66,
      "duration_seconds": 4.95,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.72,
      "end_seconds": 24.0,
      "duration_seconds": 5.28,
      "text": "It's a pearly bump on my nose that bleeds, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.1,
      "end_seconds": 28.54,
      "duration_seconds": 3.44,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.14,
      "end_seconds": 32.62,
      "duration_seconds": 2.48,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.57,
      "end_seconds": 38.67,
      "duration_seconds": 4.1,
      "text": "Ah, hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.9,
      "end_seconds": 43.96,
      "duration_seconds": 4.06,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 47.26,
      "duration_seconds": 2.17,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.22,
      "end_seconds": 51.49,
      "duration_seconds": 3.27,
      "text": "What about crusting, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 59.08,
      "duration_seconds": 6.03,
      "text": "Yeah, that too. About crusting, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.79,
      "end_seconds": 66.27,
      "duration_seconds": 5.48,
      "text": "What about a sore that won't heal, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.79,
      "end_seconds": 68.48,
      "duration_seconds": 1.69,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.33,
      "end_seconds": 81.37,
      "duration_seconds": 5.04,
      "text": "Let me check a few things. Any swollen glands or pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.39,
      "end_seconds": 84.63,
      "duration_seconds": 2.24,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.12,
      "end_seconds": 91.84,
      "duration_seconds": 5.72,
      "text": "A few quick ones: family history of skin cancer or other new lumps?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.65,
      "end_seconds": 100.6,
      "duration_seconds": 6.95,
      "text": "No family history of skin cancer or other new lumps, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.83,
      "end_seconds": 103.94,
      "duration_seconds": 2.11,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.89,
      "end_seconds": 107.07,
      "duration_seconds": 2.18,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.71,
      "end_seconds": 110.41,
      "duration_seconds": 2.7,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.27,
      "end_seconds": 115.33,
      "duration_seconds": 4.06,
      "text": "Erm, I have COPD, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.86,
      "end_seconds": 118.2,
      "duration_seconds": 1.34,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.46,
      "end_seconds": 121.28,
      "duration_seconds": 1.82,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 131.24,
      "duration_seconds": 8.13,
      "text": "Mm, okay. Alright, COPD, that matches what I have here. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.09,
      "end_seconds": 142.69,
      "duration_seconds": 10.6,
      "text": "I walk the dog every morning. My husband and I live above the shop. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.22,
      "end_seconds": 161.96,
      "duration_seconds": 3.74,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.02,
      "end_seconds": 167.59,
      "duration_seconds": 3.57,
      "text": "I mean, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.31,
      "end_seconds": 172.87,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.34,
      "end_seconds": 182.6,
      "duration_seconds": 8.26,
      "text": "It's Tiotropium inhaler, once a day. I'm, I'm on furosemide, 40 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.97,
      "end_seconds": 191.93,
      "duration_seconds": 3.96,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.81,
      "end_seconds": 196.94,
      "duration_seconds": 4.13,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.76,
      "end_seconds": 214.12,
      "duration_seconds": 4.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.04,
      "end_seconds": 219.64,
      "duration_seconds": 3.6,
      "text": "Walnuts. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.51,
      "end_seconds": 222.99,
      "duration_seconds": 2.48,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.34,
      "end_seconds": 231.9,
      "duration_seconds": 2.56,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.73,
      "end_seconds": 255.75,
      "duration_seconds": 5.02,
      "text": "Okay: temperature 36.6, pressure 127 over 81, pulse 68."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.66,
      "end_seconds": 262.31,
      "duration_seconds": 3.65,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.92,
      "end_seconds": 263.85,
      "duration_seconds": 0.93,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.66,
      "end_seconds": 268.28,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.63,
      "end_seconds": 293.06,
      "duration_seconds": 7.43,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.61,
      "end_seconds": 295.56,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.13,
      "end_seconds": 313.67,
      "duration_seconds": 13.54,
      "text": "That's the examination finished. Right, here's what I'm thinking. I think we're dealing with a likely basal cell carcinoma at this stage. Another possibility is a squamous cell carcinoma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.34,
      "end_seconds": 315.97,
      "duration_seconds": 1.63,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.89,
      "end_seconds": 344.05,
      "duration_seconds": 26.16,
      "text": "It's reasonable to be concerned, but right now a likely basal cell carcinoma is my leading thought, not anything worse. I'm going to order a dermoscopy, for suspicious lesion. I'd like to arrange a skin biopsy for suspicious lesion. Please use a high-factor sunscreen and a hat. Let's get you seen by the skin cancer clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.86,
      "end_seconds": 352.99,
      "duration_seconds": 8.13,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.56,
      "end_seconds": 357.42,
      "duration_seconds": 2.86,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.14,
      "end_seconds": 363.52,
      "duration_seconds": 5.38,
      "text": "I'd like you back after the biopsy. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.08,
      "end_seconds": 366.6,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.81,
      "end_seconds": 368.98,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}