{
  "schema_version": "1.0",
  "encounter_id": "03059",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 8.84,
      "duration_seconds": 7.7,
      "text": "Sorry, what was I saying, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 14.1,
      "duration_seconds": 4.08,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 21.72,
      "duration_seconds": 7.12,
      "text": "Yeah, um, it's fever and shivers. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.52,
      "end_seconds": 28.28,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.8,
      "end_seconds": 33.25,
      "duration_seconds": 3.45,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.25,
      "end_seconds": 41.92,
      "duration_seconds": 7.67,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.06,
      "end_seconds": 49.67,
      "duration_seconds": 6.61,
      "text": "Um, it's every other day. I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.82,
      "end_seconds": 55.24,
      "duration_seconds": 4.42,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.14,
      "end_seconds": 61.51,
      "duration_seconds": 4.37,
      "text": "Hmm, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.35,
      "end_seconds": 65.41,
      "duration_seconds": 2.06,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.2,
      "end_seconds": 67.35,
      "duration_seconds": 1.15,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.71,
      "end_seconds": 82.16,
      "duration_seconds": 2.45,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.89,
      "end_seconds": 86.71,
      "duration_seconds": 3.82,
      "text": "A urinary catheter. I take it in place."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.16,
      "end_seconds": 103.84,
      "duration_seconds": 2.68,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.21,
      "end_seconds": 108.84,
      "duration_seconds": 3.63,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.12,
      "end_seconds": 112.36,
      "duration_seconds": 2.24,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.31,
      "end_seconds": 117.14,
      "duration_seconds": 3.83,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.29,
      "end_seconds": 119.56,
      "duration_seconds": 1.27,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.24,
      "end_seconds": 125.23,
      "duration_seconds": 3.99,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.39,
      "end_seconds": 140.04,
      "duration_seconds": 4.65,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.92,
      "end_seconds": 144.98,
      "duration_seconds": 3.06,
      "text": "I mean, no, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.34,
      "end_seconds": 148.3,
      "duration_seconds": 1.96,
      "text": "Any sign of cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.11,
      "end_seconds": 151.41,
      "duration_seconds": 2.3,
      "text": "I haven't noticed any cough."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.77,
      "end_seconds": 156.98,
      "duration_seconds": 5.21,
      "text": "I see, go ahead. Have you noticed back pain, fall or vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.95,
      "end_seconds": 163.39,
      "duration_seconds": 4.44,
      "text": "No back pain, fall or vomiting, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.35,
      "end_seconds": 166.78,
      "duration_seconds": 2.43,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.32,
      "end_seconds": 170.51,
      "duration_seconds": 2.19,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.14,
      "end_seconds": 174.32,
      "duration_seconds": 3.18,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.7,
      "end_seconds": 184.87,
      "duration_seconds": 3.17,
      "text": "Alright, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.98,
      "end_seconds": 203.58,
      "duration_seconds": 7.6,
      "text": "Okay: respiratory rate 22, heart rate 97, temp 38.2 degrees. And blood pressure 124 over 73."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.77,
      "end_seconds": 207.83,
      "duration_seconds": 2.06,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.8,
      "end_seconds": 210.86,
      "duration_seconds": 1.06,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.72,
      "end_seconds": 215.79,
      "duration_seconds": 3.07,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.85,
      "end_seconds": 232.65,
      "duration_seconds": 6.8,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.24,
      "end_seconds": 235.26,
      "duration_seconds": 1.02,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.21,
      "end_seconds": 240.85,
      "duration_seconds": 1.64,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.76,
      "end_seconds": 279.55,
      "duration_seconds": 23.79,
      "text": "So, based on the history and the examination, it fits best with a catheter-related urinary infection. I'm going to order a urine culture, for possible urinary infection. It's a routine test and it'll give us a much clearer picture. I'll start you on co-amoxiclav, 625 milligrams, three times a day, seven days. That should help with catheter urinary infection."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.66,
      "end_seconds": 283.75,
      "duration_seconds": 3.09,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.76,
      "end_seconds": 299.79,
      "duration_seconds": 15.03,
      "text": "Change the catheter and drink plenty. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review in two days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.4,
      "end_seconds": 304.71,
      "duration_seconds": 3.31,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}