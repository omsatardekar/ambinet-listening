{
  "schema_version": "1.0",
  "encounter_id": "03463",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.25,
      "duration_seconds": 4.04,
      "text": "Well, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.3,
      "end_seconds": 11.26,
      "duration_seconds": 3.96,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 19.12,
      "duration_seconds": 6.99,
      "text": "It's pain in my breastbone wound. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.31,
      "end_seconds": 23.6,
      "duration_seconds": 3.29,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.24,
      "end_seconds": 28.96,
      "duration_seconds": 4.72,
      "text": "Uh, it's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.52,
      "end_seconds": 33.71,
      "duration_seconds": 4.19,
      "text": "Hm, okay. Alright, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 38.2,
      "duration_seconds": 3.13,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.89,
      "end_seconds": 41.01,
      "duration_seconds": 2.12,
      "text": "Any swollen ankles as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.57,
      "end_seconds": 50.28,
      "duration_seconds": 8.71,
      "text": "Yes, since Friday. With swollen ankles, it comes and goes. It settles a little with feet up."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.72,
      "end_seconds": 54.2,
      "duration_seconds": 2.48,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.21,
      "end_seconds": 67.8,
      "duration_seconds": 2.59,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.31,
      "end_seconds": 94.34,
      "duration_seconds": 10.03,
      "text": "Okay: pressure 118 over 80, oxygen saturation is 99 percent, pulse is 71 beats a minute. And respiratory rate 15, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.28,
      "end_seconds": 96.63,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.16,
      "end_seconds": 101.54,
      "duration_seconds": 3.38,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.52,
      "end_seconds": 107.91,
      "duration_seconds": 4.39,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.88,
      "end_seconds": 126.55,
      "duration_seconds": 1.67,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.43,
      "end_seconds": 128.73,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.57,
      "end_seconds": 153.98,
      "duration_seconds": 8.41,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.69,
      "end_seconds": 160.38,
      "duration_seconds": 1.69,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.83,
      "end_seconds": 174.55,
      "duration_seconds": 4.72,
      "text": "Any chest pain on exertion, fever or breathlessness at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.64,
      "end_seconds": 180.02,
      "duration_seconds": 4.38,
      "text": "No, no chest pain on exertion, fever or breathlessness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 185.04,
      "duration_seconds": 3.27,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.72,
      "end_seconds": 187.65,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.21,
      "end_seconds": 195.35,
      "duration_seconds": 4.14,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.32,
      "end_seconds": 199.76,
      "duration_seconds": 2.44,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.27,
      "end_seconds": 203.0,
      "duration_seconds": 2.73,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.19,
      "end_seconds": 215.08,
      "duration_seconds": 10.89,
      "text": "I hardly move around during the day. I work in accounts at a hospital. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.63,
      "end_seconds": 219.81,
      "duration_seconds": 3.18,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.65,
      "end_seconds": 223.22,
      "duration_seconds": 1.57,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.53,
      "end_seconds": 229.37,
      "duration_seconds": 4.84,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.42,
      "end_seconds": 235.51,
      "duration_seconds": 4.09,
      "text": "Hmm, yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.44,
      "end_seconds": 239.73,
      "duration_seconds": 3.29,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.79,
      "end_seconds": 250.64,
      "duration_seconds": 9.85,
      "text": "It's aspirin, 75 milligrams, once a day. I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.55,
      "end_seconds": 252.92,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.62,
      "end_seconds": 257.7,
      "duration_seconds": 3.08,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.77,
      "end_seconds": 295.34,
      "duration_seconds": 21.57,
      "text": "Having listened and examined, I think we're dealing with recovering well after bypass surgery at this stage. We shouldn't forget a leg wound infection. Let me just check I've got this right. You've had pain in your breastbone wound for about four days, severe, and no chest pain on exertion or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.2,
      "end_seconds": 297.9,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.68,
      "end_seconds": 303.56,
      "duration_seconds": 3.88,
      "text": "I'd like to arrange blood tests for post-operative review."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.2,
      "end_seconds": 308.38,
      "duration_seconds": 4.18,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.92,
      "end_seconds": 311.63,
      "duration_seconds": 2.71,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.35,
      "end_seconds": 334.96,
      "duration_seconds": 22.61,
      "text": "I'd like to arrange an ECG for post-operative review. That will help us see what's going on underneath and decide the next step. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I'd like to see you again in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.71,
      "end_seconds": 339.1,
      "duration_seconds": 3.39,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.97,
      "end_seconds": 342.74,
      "duration_seconds": 1.77,
      "text": "Right, all the best."
    }
  ]
}