      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 10.98,
      "duration_seconds": 4.1,
      "text": "okay, come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.82,
      "end_seconds": 17.37,
      "duration_seconds": 5.55,
      "text": "Um, so... shortness of breath. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.51,
      "end_seconds": 21.55,
      "duration_seconds": 3.04,
      "text": "How long has it been like this?"
