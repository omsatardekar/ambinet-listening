{
  "schema_version": "1.0",
  "encounter_id": "03208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 2.41,
      "duration_seconds": 1.74,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.01,
      "end_seconds": 8.8,
      "duration_seconds": 4.79,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.37,
      "end_seconds": 26.69,
      "duration_seconds": 16.32,
      "text": "I've been feeling tired and weak, and I wanted to get it checked. I wasn't sure whether to come in at all, to be honest. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 28.13,
      "end_seconds": 35.17,
      "duration_seconds": 7.04,
      "text": "Doctor, I've got the readings for you. BP is 104 over 56, saturation 96 percent, pulse 95."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.87,
      "end_seconds": 37.21,
      "duration_seconds": 1.34,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.08,
      "end_seconds": 50.86,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.06,
      "end_seconds": 66.38,
      "duration_seconds": 14.32,
      "text": "It's been going on for six months. I just want to get back to normal, really. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.04,
      "end_seconds": 69.78,
      "duration_seconds": 2.74,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.74,
      "end_seconds": 77.32,
      "duration_seconds": 3.58,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.0,
      "end_seconds": 81.86,
      "duration_seconds": 2.86,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.84,
      "end_seconds": 108.66,
      "duration_seconds": 24.82,
      "text": "When it starts I tend to get craving salt as well. Erm, and dizziness on standing as well, since Friday. As for dizziness on standing, mostly mild. I'd say once or twice a day. So, the craving salt? That's been for about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.24,
      "end_seconds": 114.13,
      "duration_seconds": 4.89,
      "text": "Have you had any fainting, fever or severe tummy pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.0,
      "end_seconds": 119.84,
      "duration_seconds": 4.84,
      "text": "No fainting, fever or severe tummy pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.34,
      "end_seconds": 122.59,
      "duration_seconds": 1.25,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.22,
      "end_seconds": 126.04,
      "duration_seconds": 1.82,
      "text": "No, no vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.1,
      "end_seconds": 131.04,
      "duration_seconds": 2.94,
      "text": "Alright, has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.98,
      "end_seconds": 134.93,
      "duration_seconds": 1.95,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.63,
      "end_seconds": 156.91,
      "duration_seconds": 4.28,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.64,
      "end_seconds": 160.33,
      "duration_seconds": 2.69,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.88,
      "end_seconds": 166.07,
      "duration_seconds": 4.19,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 170.65,
      "duration_seconds": 3.01,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.52,
      "end_seconds": 189.29,
      "duration_seconds": 2.77,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.6,
      "end_seconds": 195.37,
      "duration_seconds": 4.77,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.28,
      "end_seconds": 201.41,
      "duration_seconds": 2.13,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.29,
      "end_seconds": 207.53,
      "duration_seconds": 4.24,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.47,
      "end_seconds": 211.98,
      "duration_seconds": 2.51,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.86,
      "end_seconds": 217.23,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.3,
      "end_seconds": 222.71,
      "duration_seconds": 3.41,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.26,
      "end_seconds": 232.19,
      "duration_seconds": 8.93,
      "text": "Yes, thin bones. I've got an underactive thyroid. My sister suggested writing things down, um, but I forgot."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.72,
      "end_seconds": 233.42,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.17,
      "end_seconds": 240.23,
      "duration_seconds": 5.06,
      "text": "Yes, heart disease. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.51,
      "end_seconds": 253.51,
      "duration_seconds": 8.0,
      "text": "Yes. What do you take on a normal day? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.35,
      "end_seconds": 263.24,
      "duration_seconds": 6.89,
      "text": "Actually, it's alendronate, 70 milligrams, once a week. Thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.79,
      "end_seconds": 264.49,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.23,
      "end_seconds": 270.54,
      "duration_seconds": 4.31,
      "text": "Clopidogrel. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.31,
      "end_seconds": 274.24,
      "duration_seconds": 2.93,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.81,
      "end_seconds": 281.43,
      "duration_seconds": 5.62,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.57,
      "end_seconds": 285.24,
      "duration_seconds": 2.67,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.25,
      "end_seconds": 287.67,
      "duration_seconds": 1.42,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.07,
      "end_seconds": 291.16,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.15,
      "end_seconds": 309.64,
      "duration_seconds": 9.49,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.98,
      "end_seconds": 333.05,
      "duration_seconds": 19.07,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. It points towards possible adrenal insufficiency. That's my thinking for now, and it may change as we learn more. I think a morning cortisol makes sense here, for possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.81,
      "end_seconds": 337.74,
      "duration_seconds": 2.93,
      "text": "Erm, how long will it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.96,
      "end_seconds": 360.0,
      "duration_seconds": 17.04,
      "text": "Drink fluids and eat salty foods until the results, and come in if you vomit. Let's get you seen by the endocrine clinic, I'll arrange the letter. Come back after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.17,
      "end_seconds": 367.32,
      "duration_seconds": 3.15,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.21,
      "end_seconds": 370.44,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}