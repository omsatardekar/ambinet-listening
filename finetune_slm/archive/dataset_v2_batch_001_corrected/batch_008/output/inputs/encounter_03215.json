{
  "schema_version": "1.0",
  "encounter_id": "03215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.95,
      "duration_seconds": 4.09,
      "text": "Morning, um, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 11.09,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.6,
      "end_seconds": 22.96,
      "duration_seconds": 11.36,
      "text": "It's hearing better in a noisy room, mostly. I'm hoping you can tell me something definite. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.33,
      "end_seconds": 26.35,
      "duration_seconds": 2.02,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.12,
      "end_seconds": 40.39,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.32,
      "end_seconds": 69.52,
      "duration_seconds": 9.2,
      "text": "Okay: pulse 66, pressure 123 over 68, oxygen saturation is 99 percent, respiratory rate 14, temperature 36.6."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.89,
      "end_seconds": 72.32,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.26,
      "end_seconds": 76.86,
      "duration_seconds": 2.6,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.7,
      "end_seconds": 96.09,
      "duration_seconds": 1.39,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.1,
      "end_seconds": 100.4,
      "duration_seconds": 2.3,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 105.51,
      "duration_seconds": 3.22,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.4,
      "end_seconds": 110.34,
      "duration_seconds": 2.94,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.9,
      "end_seconds": 114.3,
      "duration_seconds": 3.4,
      "text": "Any facial weakness, vertigo or ear pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.29,
      "end_seconds": 122.65,
      "duration_seconds": 4.36,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.1,
      "end_seconds": 129.23,
      "duration_seconds": 2.13,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.93,
      "end_seconds": 132.33,
      "duration_seconds": 2.4,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.31,
      "end_seconds": 140.31,
      "duration_seconds": 3.0,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.91,
      "end_seconds": 143.43,
      "duration_seconds": 1.52,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 148.57,
      "duration_seconds": 3.5,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.62,
      "end_seconds": 152.6,
      "duration_seconds": 2.98,
      "text": "Thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.66,
      "end_seconds": 163.86,
      "duration_seconds": 9.2,
      "text": "Okay, I can see thin bones in your file as well. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.46,
      "end_seconds": 167.98,
      "duration_seconds": 3.52,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.33,
      "end_seconds": 177.74,
      "duration_seconds": 2.41,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.18,
      "end_seconds": 181.44,
      "duration_seconds": 2.26,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.68,
      "end_seconds": 185.14,
      "duration_seconds": 2.46,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.32,
      "end_seconds": 191.63,
      "duration_seconds": 5.31,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.65,
      "end_seconds": 195.16,
      "duration_seconds": 2.51,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.0,
      "end_seconds": 198.61,
      "duration_seconds": 1.61,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.27,
      "end_seconds": 202.68,
      "duration_seconds": 2.41,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.31,
      "end_seconds": 207.15,
      "duration_seconds": 2.84,
      "text": "I'm on alendronate, once a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.71,
      "end_seconds": 210.74,
      "duration_seconds": 3.03,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.24,
      "end_seconds": 213.23,
      "duration_seconds": 0.99,
      "text": "70 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.78,
      "end_seconds": 219.76,
      "duration_seconds": 4.98,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.24,
      "end_seconds": 238.62,
      "duration_seconds": 1.38,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.83,
      "end_seconds": 241.1,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.82,
      "end_seconds": 266.15,
      "duration_seconds": 7.33,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.42,
      "end_seconds": 270.1,
      "duration_seconds": 1.68,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.89,
      "end_seconds": 319.22,
      "duration_seconds": 38.33,
      "text": "Right, here's what I'm thinking. It's hard to say. A conductive hearing loss, possibly otosclerosis is one possibility and wax another, and I'd rather not commit yet. I'm going to order a hearing test, for hearing loss. The result will help us decide whether anything more is needed. A hearing aid or an operation are both options after the tests. Let's get you seen by the ENT clinic, I'll arrange the letter. We'll catch up after the tests."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.84,
      "end_seconds": 323.91,
      "duration_seconds": 4.07,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.83,
      "end_seconds": 327.01,
      "duration_seconds": 2.18,
      "text": "Alright, thanks, take care."
    }
  ]
}