{
  "schema_version": "1.0",
  "encounter_id": "03058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 5.6,
      "duration_seconds": 4.35,
      "text": "Welcome. Make yourself comfortable. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.22,
      "end_seconds": 13.95,
      "duration_seconds": 7.73,
      "text": "It's flakes on my shoulders. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.7,
      "end_seconds": 17.99,
      "duration_seconds": 2.29,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.81,
      "end_seconds": 25.6,
      "duration_seconds": 5.79,
      "text": "Let me think, uh, ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.61,
      "end_seconds": 31.33,
      "duration_seconds": 2.72,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.67,
      "end_seconds": 36.36,
      "duration_seconds": 3.69,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 40.63,
      "duration_seconds": 2.73,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.27,
      "end_seconds": 48.12,
      "duration_seconds": 6.85,
      "text": "It settles a little with shampoo. Oh, and a little redness."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.97,
      "end_seconds": 64.45,
      "duration_seconds": 3.48,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.22,
      "end_seconds": 77.59,
      "duration_seconds": 2.37,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.91,
      "end_seconds": 96.39,
      "duration_seconds": 8.48,
      "text": "Okay: saturation 98 percent, pulse is 84 beats a minute. And respiratory rate 16, BP is 120 over 79."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.48,
      "end_seconds": 100.06,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.0,
      "end_seconds": 103.69,
      "duration_seconds": 2.69,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.23,
      "end_seconds": 108.71,
      "duration_seconds": 3.48,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.7,
      "end_seconds": 112.85,
      "duration_seconds": 2.15,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.94,
      "end_seconds": 127.74,
      "duration_seconds": 5.8,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.44,
      "end_seconds": 136.73,
      "duration_seconds": 6.29,
      "text": "Okay, that's the examination finished. And what about hair loss, pain, rash elsewhere or pus?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.73,
      "end_seconds": 143.91,
      "duration_seconds": 5.18,
      "text": "Let me think, no, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.41,
      "end_seconds": 146.55,
      "duration_seconds": 2.14,
      "text": "Sure. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.25,
      "end_seconds": 149.29,
      "duration_seconds": 1.04,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.43,
      "end_seconds": 153.43,
      "duration_seconds": 3.0,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.2,
      "end_seconds": 158.23,
      "duration_seconds": 3.03,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.36,
      "end_seconds": 168.93,
      "duration_seconds": 3.57,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.07,
      "end_seconds": 182.24,
      "duration_seconds": 12.17,
      "text": "My husband and I live above the shop. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 199.75,
      "duration_seconds": 2.46,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.33,
      "end_seconds": 211.67,
      "duration_seconds": 8.34,
      "text": "Oh, you know, I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.77,
      "end_seconds": 215.89,
      "duration_seconds": 3.12,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.78,
      "end_seconds": 222.91,
      "duration_seconds": 5.13,
      "text": "Well, I take Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.91,
      "end_seconds": 227.3,
      "duration_seconds": 2.39,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.08,
      "end_seconds": 233.77,
      "duration_seconds": 5.69,
      "text": "About a year now. An anti-dandruff shampoo, twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.82,
      "end_seconds": 237.19,
      "duration_seconds": 2.37,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.21,
      "end_seconds": 243.34,
      "duration_seconds": 4.13,
      "text": "I have an underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.19,
      "end_seconds": 252.76,
      "duration_seconds": 7.57,
      "text": "Are there any allergies I should be aware of? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.03,
      "end_seconds": 257.14,
      "duration_seconds": 3.11,
      "text": "Yeah, I've never had an allergy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.22,
      "end_seconds": 289.66,
      "duration_seconds": 27.44,
      "text": "Okay, so my impression is this: I'm honestly not certain yet. It could be simple dandruff, or it might be seborrhoeic dermatitis. I'm going to put you on ketoconazole shampoo, 2%, twice a week, four weeks. That should help with dandruff. I'll put all of this in writing so you don't have to remember it. Leave the shampoo on for five minutes before rinsing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.26,
      "end_seconds": 303.53,
      "duration_seconds": 12.27,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'll want another look if not better in a month."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.76,
      "end_seconds": 308.41,
      "duration_seconds": 3.65,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 313.61,
      "duration_seconds": 4.02,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.16,
      "end_seconds": 327.13,
      "duration_seconds": 11.97,
      "text": "So, I take the ketoconazole shampoo, 2%, twice a week and come back if not better in a month. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.68,
      "end_seconds": 333.66,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.47,
      "end_seconds": 341.09,
      "duration_seconds": 5.62,
      "text": "Erm, um, good, thanks, I'll see you then."
    }
  ]
}