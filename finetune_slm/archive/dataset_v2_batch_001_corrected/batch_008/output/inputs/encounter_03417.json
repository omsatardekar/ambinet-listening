{
  "schema_version": "1.0",
  "encounter_id": "03417",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 6.67,
      "duration_seconds": 5.72,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 12.59,
      "duration_seconds": 5.4,
      "text": "Right, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.11,
      "end_seconds": 18.01,
      "duration_seconds": 4.9,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.19,
      "end_seconds": 25.77,
      "duration_seconds": 3.58,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.41,
      "end_seconds": 31.08,
      "duration_seconds": 4.67,
      "text": "We came because of a severe headache for days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 31.59,
      "end_seconds": 38.84,
      "duration_seconds": 7.25,
      "text": "Here are the numbers, doctor. BP is 147 over 104, heart rate 86, temperature 36.4."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.86,
      "end_seconds": 45.45,
      "duration_seconds": 4.59,
      "text": "Okay, noted. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 50.3,
      "duration_seconds": 3.2,
      "text": "I've had it for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.77,
      "end_seconds": 54.69,
      "duration_seconds": 2.92,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.27,
      "end_seconds": 58.6,
      "duration_seconds": 2.33,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.29,
      "end_seconds": 64.85,
      "duration_seconds": 2.56,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.36,
      "end_seconds": 69.23,
      "duration_seconds": 3.87,
      "text": "yes, lying down that makes it worse"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.15,
      "end_seconds": 73.92,
      "duration_seconds": 3.77,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.87,
      "end_seconds": 84.89,
      "duration_seconds": 10.02,
      "text": "A eight out of ten, I suppose. There's drowsiness as well. About drowsiness, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.72,
      "end_seconds": 90.06,
      "duration_seconds": 3.34,
      "text": "What about double vision, have you noticed that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.73,
      "end_seconds": 105.53,
      "duration_seconds": 13.8,
      "text": "Mm, yes. As for double vision, about a eight out of ten. And there's being sick as well, one week now. With being sick, mild, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 112.78,
      "duration_seconds": 5.74,
      "text": "have you had any head injury, weakness on one side or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.1,
      "end_seconds": 117.42,
      "duration_seconds": 3.32,
      "text": "no, nothing to to report there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.49,
      "end_seconds": 123.31,
      "duration_seconds": 3.82,
      "text": "Alright, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.46,
      "end_seconds": 127.39,
      "duration_seconds": 2.93,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.1,
      "end_seconds": 131.56,
      "duration_seconds": 3.46,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 140.42,
      "duration_seconds": 4.43,
      "text": "I'm on escitalopram, 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 141.05,
      "end_seconds": 149.47,
      "duration_seconds": 8.42,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.56,
      "end_seconds": 153.44,
      "duration_seconds": 2.88,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.77,
      "end_seconds": 165.26,
      "duration_seconds": 10.49,
      "text": "Not with me. I'll bring it next time. Furosemide, 40 milligrams, every morning. The contraceptive pill. I take it daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.12,
      "end_seconds": 168.23,
      "duration_seconds": 2.11,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 170.25,
      "end_seconds": 174.01,
      "duration_seconds": 3.76,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.02,
      "end_seconds": 179.02,
      "duration_seconds": 3.0,
      "text": "Alright, do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.45,
      "end_seconds": 184.15,
      "duration_seconds": 3.7,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.92,
      "end_seconds": 189.45,
      "duration_seconds": 3.53,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.62,
      "end_seconds": 197.97,
      "duration_seconds": 7.35,
      "text": "I've had anxiety for nearly five years now. I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.66,
      "end_seconds": 209.31,
      "duration_seconds": 2.65,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.54,
      "end_seconds": 213.88,
      "duration_seconds": 3.34,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 215.33,
      "end_seconds": 222.29,
      "duration_seconds": 6.96,
      "text": "I'm not sure that's right. I seem to recall a problem with erythromycin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.11,
      "end_seconds": 225.37,
      "duration_seconds": 2.26,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.07,
      "end_seconds": 231.49,
      "duration_seconds": 5.42,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 243.35,
      "duration_seconds": 2.44,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.76,
      "end_seconds": 256.65,
      "duration_seconds": 11.89,
      "text": "yes, I had a mole taken off my arm, a few years ago i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.64,
      "end_seconds": 261.08,
      "duration_seconds": 2.44,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.87,
      "end_seconds": 264.16,
      "duration_seconds": 1.29,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.03,
      "end_seconds": 282.87,
      "duration_seconds": 3.84,
      "text": "the optic discs look swollen and you are drowsy"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.59,
      "end_seconds": 287.44,
      "duration_seconds": 1.85,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.52,
      "end_seconds": 310.52,
      "duration_seconds": 11.0,
      "text": "I want an MRI of the head done, that's for papilloedema. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 311.36,
      "end_seconds": 313.52,
      "duration_seconds": 2.16,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.73,
      "end_seconds": 326.81,
      "duration_seconds": 12.08,
      "text": "let's get an urgent CT venogram, for possible venous thrombosis. Stop the pill, you need an urgent scan and admission. I'm going to send a referral to the neurology team"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.55,
      "end_seconds": 329.35,
      "duration_seconds": 1.8,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.57,
      "end_seconds": 340.07,
      "duration_seconds": 9.5,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.39,
      "end_seconds": 344.37,
      "duration_seconds": 2.98,
      "text": "I mean, thank you, that's clear."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.27,
      "end_seconds": 348.31,
      "duration_seconds": 2.04,
      "text": "we'll catch up straight away"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.09,
      "end_seconds": 349.79,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.18,
      "end_seconds": 353.75,
      "duration_seconds": 2.57,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 354.79,
      "end_seconds": 358.65,
      "duration_seconds": 3.86,
      "text": "Great, you know, thank you for your help."
    }
  ]
}