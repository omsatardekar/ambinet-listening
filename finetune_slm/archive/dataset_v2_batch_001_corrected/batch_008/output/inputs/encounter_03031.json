{
  "schema_version": "1.0",
  "encounter_id": "03031",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.14,
      "duration_seconds": 4.32,
      "text": "Hello, you know, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.54,
      "end_seconds": 13.51,
      "duration_seconds": 3.97,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.88,
      "end_seconds": 28.6,
      "duration_seconds": 12.72,
      "text": "Honestly, you know, it's shaking chills, and my family pushed me to come. I had a sore mouth before. That's settled now, you know, though."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.65,
      "end_seconds": 34.34,
      "duration_seconds": 3.69,
      "text": "Have you had any diarrhoea, rash or cough?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.41,
      "end_seconds": 40.55,
      "duration_seconds": 4.14,
      "text": "No diarrhoea, rash or cough, none of it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.21,
      "end_seconds": 43.42,
      "duration_seconds": 2.21,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.22,
      "end_seconds": 47.11,
      "duration_seconds": 1.89,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.86,
      "end_seconds": 52.98,
      "duration_seconds": 4.12,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.91,
      "end_seconds": 56.57,
      "duration_seconds": 1.66,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.78,
      "end_seconds": 60.86,
      "duration_seconds": 3.08,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.37,
      "end_seconds": 63.32,
      "duration_seconds": 1.95,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.34,
      "end_seconds": 76.74,
      "duration_seconds": 3.4,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.51,
      "end_seconds": 81.95,
      "duration_seconds": 4.44,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.98,
      "end_seconds": 99.22,
      "duration_seconds": 3.24,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.24,
      "end_seconds": 109.78,
      "duration_seconds": 9.54,
      "text": "I'm on metoprolol, 50 milligrams, twice a day. I, I take mirtazapine, 15 milligrams, at night for my mood."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.66,
      "end_seconds": 115.3,
      "duration_seconds": 3.64,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.98,
      "end_seconds": 119.41,
      "duration_seconds": 2.43,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.72,
      "end_seconds": 124.44,
      "duration_seconds": 3.72,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.18,
      "end_seconds": 129.07,
      "duration_seconds": 3.89,
      "text": "I have heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.87,
      "end_seconds": 134.8,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.45,
      "end_seconds": 139.13,
      "duration_seconds": 3.68,
      "text": "I've had depression for five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 143.93,
      "duration_seconds": 3.56,
      "text": "Yes, carry on. Have you retired yet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.54,
      "end_seconds": 149.65,
      "duration_seconds": 5.11,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.53,
      "end_seconds": 153.3,
      "duration_seconds": 2.77,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.02,
      "end_seconds": 157.5,
      "duration_seconds": 3.48,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.9,
      "end_seconds": 162.71,
      "duration_seconds": 3.81,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.35,
      "end_seconds": 166.63,
      "duration_seconds": 3.28,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.2,
      "end_seconds": 170.07,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 184.3,
      "duration_seconds": 2.79,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.99,
      "end_seconds": 212.42,
      "duration_seconds": 6.43,
      "text": "Okay: pulse 106, respiratory rate 18, BP is 93 over 58, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.4,
      "end_seconds": 214.89,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.4,
      "end_seconds": 230.27,
      "duration_seconds": 13.87,
      "text": "We'll look at it together shortly. From what you've told me, I think we're dealing with neutropenic sepsis at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.1,
      "end_seconds": 234.25,
      "duration_seconds": 3.15,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.99,
      "end_seconds": 242.44,
      "duration_seconds": 7.45,
      "text": "It's reasonable to be concerned, but right now neutropenic sepsis is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.53,
      "end_seconds": 260.46,
      "duration_seconds": 4.93,
      "text": "I'll request urgent blood tests, it'll help with neutropenic sepsis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 264.82,
      "end_seconds": 269.02,
      "duration_seconds": 4.2,
      "text": "We have a slot Thursday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.9,
      "end_seconds": 286.43,
      "duration_seconds": 16.53,
      "text": "For this, piperacillin and tazobactam, 4.5 grams, now, single dose. It's for neutropenic sepsis. This is an emergency, antibiotics are being given within the hour. I'm going to send a referral to the oncology team. See me again straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.28,
      "end_seconds": 290.21,
      "duration_seconds": 1.93,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.08,
      "end_seconds": 295.61,
      "duration_seconds": 3.53,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.73,
      "end_seconds": 298.48,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.46,
      "end_seconds": 300.7,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}