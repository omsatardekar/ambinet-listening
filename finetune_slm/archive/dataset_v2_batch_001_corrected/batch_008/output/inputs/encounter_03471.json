{
  "schema_version": "1.0",
  "encounter_id": "03471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.46,
      "duration_seconds": 3.61,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.23,
      "end_seconds": 8.99,
      "duration_seconds": 3.76,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.31,
      "end_seconds": 13.5,
      "duration_seconds": 3.19,
      "text": "I'm here because of shoulder tip pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.04,
      "end_seconds": 17.93,
      "duration_seconds": 2.89,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.57,
      "end_seconds": 33.23,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.74,
      "end_seconds": 63.72,
      "duration_seconds": 12.98,
      "text": "Okay: oxygen saturation is 97 percent, blood pressure 133 over 78, temperature is 36.5 degrees, pulse 116. Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.22,
      "end_seconds": 76.19,
      "duration_seconds": 10.97,
      "text": "About... well, two months. Oh, and a sudden severe tummy pain. With sudden severe tummy pain, only lying still, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.01,
      "end_seconds": 86.01,
      "duration_seconds": 6.0,
      "text": "Let me check a few things. Any fever, blood in the vomit or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 91.45,
      "duration_seconds": 2.14,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.88,
      "end_seconds": 95.02,
      "duration_seconds": 2.14,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.76,
      "end_seconds": 98.74,
      "duration_seconds": 1.98,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.08,
      "end_seconds": 118.92,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.81,
      "end_seconds": 125.7,
      "duration_seconds": 4.89,
      "text": "Ibuprofen. I take it 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.8,
      "end_seconds": 130.96,
      "duration_seconds": 3.16,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.49,
      "end_seconds": 134.6,
      "duration_seconds": 2.11,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.08,
      "end_seconds": 145.72,
      "duration_seconds": 3.64,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.3,
      "end_seconds": 150.14,
      "duration_seconds": 2.84,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.0,
      "end_seconds": 155.4,
      "duration_seconds": 3.4,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.9,
      "end_seconds": 160.83,
      "duration_seconds": 4.93,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.47,
      "end_seconds": 175.05,
      "duration_seconds": 2.58,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.45,
      "end_seconds": 186.55,
      "duration_seconds": 10.1,
      "text": "I grab fast food at lunch most days. I live with my elderly mother. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.34,
      "end_seconds": 192.64,
      "duration_seconds": 4.3,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.58,
      "end_seconds": 203.53,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.99,
      "end_seconds": 207.16,
      "duration_seconds": 2.17,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.61,
      "end_seconds": 225.72,
      "duration_seconds": 8.11,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 238.75,
      "duration_seconds": 10.27,
      "text": "That's all I needed to check. Let me tell you where I've got to. It fits best with a perforated stomach ulcer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.88,
      "end_seconds": 241.8,
      "duration_seconds": 1.92,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.55,
      "end_seconds": 257.29,
      "duration_seconds": 13.74,
      "text": "It's reasonable to be concerned, but right now a perforated stomach ulcer is my leading thought, not anything worse. I'll request urgent blood tests, it'll help with acute abdomen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.37,
      "end_seconds": 259.99,
      "duration_seconds": 1.62,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.89,
      "end_seconds": 273.74,
      "duration_seconds": 11.85,
      "text": "Nothing to eat or drink, you need an operation urgently. I'm going to send a referral to the surgical team. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.65,
      "end_seconds": 277.24,
      "duration_seconds": 1.59,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.87,
      "end_seconds": 279.82,
      "duration_seconds": 1.95,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.65,
      "end_seconds": 284.8,
      "duration_seconds": 3.15,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.71,
      "end_seconds": 295.4,
      "duration_seconds": 8.69,
      "text": "Okay, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.08,
      "end_seconds": 305.64,
      "duration_seconds": 4.56,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.38,
      "end_seconds": 313.84,
      "duration_seconds": 6.46,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.04,
      "end_seconds": 317.01,
      "duration_seconds": 1.97,
      "text": "Thank you, that's helpful."
    }
  ]
}