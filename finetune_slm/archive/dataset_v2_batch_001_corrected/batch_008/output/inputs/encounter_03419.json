{
  "schema_version": "1.0",
  "encounter_id": "03419",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.47,
      "duration_seconds": 3.43,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 11.16,
      "duration_seconds": 4.84,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.31,
      "end_seconds": 17.18,
      "duration_seconds": 4.87,
      "text": "I wanted to get a swollen calf looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.94,
      "end_seconds": 23.68,
      "duration_seconds": 4.74,
      "text": "When did this begin? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.66,
      "end_seconds": 28.1,
      "duration_seconds": 3.44,
      "text": "for about a week, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.06,
      "end_seconds": 31.89,
      "duration_seconds": 2.83,
      "text": "how frequently does it it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 36.09,
      "duration_seconds": 3.38,
      "text": "honestly, a few times a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.66,
      "end_seconds": 42.85,
      "duration_seconds": 6.19,
      "text": "Let me check a few things. Any wound problem, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.81,
      "end_seconds": 48.1,
      "duration_seconds": 4.29,
      "text": "no no wound problem coughing up blood or fever"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.05,
      "end_seconds": 52.05,
      "duration_seconds": 3.0,
      "text": "how are your joints any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.23,
      "end_seconds": 54.83,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.15,
      "end_seconds": 60.52,
      "duration_seconds": 4.37,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.35,
      "end_seconds": 63.42,
      "duration_seconds": 2.07,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 78.24,
      "duration_seconds": 3.51,
      "text": "What about your parents brothers or sisters any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.07,
      "end_seconds": 82.85,
      "duration_seconds": 2.78,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.68,
      "end_seconds": 88.47,
      "duration_seconds": 4.79,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.99,
      "end_seconds": 93.3,
      "duration_seconds": 3.31,
      "text": "No, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 105.1,
      "duration_seconds": 4.14,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.4,
      "end_seconds": 122.23,
      "duration_seconds": 15.83,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. Lots of rice, lentils and some fruit. I work in accounts at a hospital. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.07,
      "end_seconds": 126.39,
      "duration_seconds": 3.32,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.87,
      "end_seconds": 130.75,
      "duration_seconds": 2.88,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.17,
      "end_seconds": 152.0,
      "duration_seconds": 2.83,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.86,
      "end_seconds": 156.89,
      "duration_seconds": 3.03,
      "text": "nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.02,
      "end_seconds": 160.48,
      "duration_seconds": 2.46,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.77,
      "end_seconds": 164.46,
      "duration_seconds": 2.69,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.05,
      "end_seconds": 185.63,
      "duration_seconds": 5.58,
      "text": "Your left calf is swollen and tender and your oxygen is low."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.86,
      "end_seconds": 192.73,
      "duration_seconds": 1.87,
      "text": "all finished thank you"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.41,
      "end_seconds": 216.1,
      "duration_seconds": 11.69,
      "text": "Let me tell you where I've got to. I can't pin this down yet. We're looking at a possible blood clot in the lung after surgery or a chest infection."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.94,
      "end_seconds": 219.99,
      "duration_seconds": 2.05,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.77,
      "end_seconds": 248.4,
      "duration_seconds": 23.63,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible blood clot in the lung after surgery, but I'd like to confirm. Let me repeat that back to make sure. You've had a swollen calf for about a week, and no coughing up blood or wound problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 252.33,
      "duration_seconds": 1.88,
      "text": "that's what happened yes"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.4,
      "end_seconds": 264.26,
      "duration_seconds": 10.86,
      "text": "I want a D-dimer done that's for possible clot. The treatment will be enoxaparin 1.5 mg per kg once now single dose. It's for possible clot."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.75,
      "end_seconds": 268.65,
      "duration_seconds": 2.9,
      "text": "Alright I'll pick it up today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.69,
      "end_seconds": 285.0,
      "duration_seconds": 14.31,
      "text": "Please go to hospital now I will call ahead. The emergency team would be the right next step I'll refer you. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.94,
      "end_seconds": 287.31,
      "duration_seconds": 1.37,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.03,
      "end_seconds": 292.37,
      "duration_seconds": 4.34,
      "text": "see me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.33,
      "end_seconds": 300.63,
      "duration_seconds": 3.3,
      "text": "ah good thanks I'll see you then"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.76,
      "end_seconds": 305.16,
      "duration_seconds": 1.4,
      "text": "See you soon."
    }
  ]
}