{
  "schema_version": "1.0",
  "encounter_id": "03445",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 4.03,
      "duration_seconds": 3.53,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 10.3,
      "duration_seconds": 4.77,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.35,
      "end_seconds": 16.28,
      "duration_seconds": 4.93,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.66,
      "end_seconds": 21.55,
      "duration_seconds": 3.89,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.62,
      "end_seconds": 27.07,
      "duration_seconds": 3.45,
      "text": "She's been having three early losses, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.69,
      "end_seconds": 29.75,
      "duration_seconds": 2.06,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.93,
      "end_seconds": 33.68,
      "duration_seconds": 2.75,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.25,
      "end_seconds": 44.82,
      "duration_seconds": 3.57,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.94,
      "end_seconds": 48.31,
      "duration_seconds": 2.37,
      "text": "Ah, I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.14,
      "end_seconds": 51.55,
      "duration_seconds": 2.41,
      "text": "Has there been irregular cycles too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.14,
      "end_seconds": 61.67,
      "duration_seconds": 8.53,
      "text": "Yes, about the same, two weeks. I've also been feeling low and anxious, for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.98,
      "end_seconds": 65.8,
      "duration_seconds": 2.82,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.79,
      "end_seconds": 67.78,
      "duration_seconds": 0.99,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.29,
      "end_seconds": 73.32,
      "duration_seconds": 5.03,
      "text": "I see, go ahead. And heavy bleeding now, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.29,
      "end_seconds": 76.67,
      "duration_seconds": 2.38,
      "text": "No heavy bleeding now, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.53,
      "end_seconds": 81.13,
      "duration_seconds": 3.6,
      "text": "Have you had any fever or clotting problem?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.38,
      "end_seconds": 84.65,
      "duration_seconds": 2.27,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.42,
      "end_seconds": 88.66,
      "duration_seconds": 3.24,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.62,
      "end_seconds": 95.08,
      "duration_seconds": 4.46,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.65,
      "end_seconds": 98.7,
      "duration_seconds": 3.05,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.99,
      "end_seconds": 102.64,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.05,
      "end_seconds": 107.37,
      "duration_seconds": 3.32,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.23,
      "end_seconds": 122.78,
      "duration_seconds": 14.55,
      "text": "I used to drink heavily but I stopped four years ago. I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.71,
      "end_seconds": 126.88,
      "duration_seconds": 3.17,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.08,
      "end_seconds": 131.99,
      "duration_seconds": 3.91,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.51,
      "end_seconds": 152.92,
      "duration_seconds": 5.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 157.4,
      "duration_seconds": 3.65,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.36,
      "end_seconds": 162.71,
      "duration_seconds": 4.35,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 165.6,
      "duration_seconds": 2.32,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.15,
      "end_seconds": 169.54,
      "duration_seconds": 2.39,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.0,
      "end_seconds": 180.69,
      "duration_seconds": 2.69,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.73,
      "end_seconds": 213.39,
      "duration_seconds": 15.66,
      "text": "Okay: height 172 centimetres, temperature is 36.7 degrees, respiratory rate 18, SpO2 97 percent on room air, pulse is 81 beats a minute, BMI works out to 23.7, weight 70 kilos, pressure 113 over 73."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.54,
      "end_seconds": 216.19,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.51,
      "end_seconds": 219.85,
      "duration_seconds": 2.34,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.29,
      "end_seconds": 226.44,
      "duration_seconds": 4.15,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 229.16,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.93,
      "end_seconds": 247.49,
      "duration_seconds": 1.56,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 252.15,
      "duration_seconds": 1.78,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.03,
      "end_seconds": 280.91,
      "duration_seconds": 11.88,
      "text": "From what you've told me and what I found, I don't have a clear answer today: recurrent miscarriage needing investigation is possible, and so is an antiphospholipid problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.24,
      "end_seconds": 285.91,
      "duration_seconds": 3.67,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.81,
      "end_seconds": 304.72,
      "duration_seconds": 17.91,
      "text": "Nothing I've seen today points to an emergency. It looks like recurrent miscarriage needing investigation, but I'd like to confirm. I'd like to arrange blood tests for recurrent miscarriage. I think a pelvic ultrasound makes sense here, for recurrent miscarriage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.35,
      "end_seconds": 306.74,
      "duration_seconds": 1.39,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.0,
      "end_seconds": 333.57,
      "duration_seconds": 25.57,
      "text": "We will arrange specialist care so the next pregnancy is looked after from the start. Don't skip meals, and try to eat smaller portions more often through the day. I'm going to send a referral to the recurrent miscarriage clinic. I'd like to see you again after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.56,
      "end_seconds": 339.75,
      "duration_seconds": 5.19,
      "text": "Let me think, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.84,
      "end_seconds": 342.06,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}