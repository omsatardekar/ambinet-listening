{
  "schema_version": "1.0",
  "encounter_id": "03013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 2.77,
      "duration_seconds": 1.72,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.62,
      "end_seconds": 8.64,
      "duration_seconds": 4.02,
      "text": "Ah, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.46,
      "end_seconds": 11.7,
      "duration_seconds": 1.24,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.6,
      "end_seconds": 20.22,
      "duration_seconds": 6.62,
      "text": "Um, so... pain in my breastbone wound. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 23.84,
      "duration_seconds": 2.19,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.52,
      "end_seconds": 36.06,
      "duration_seconds": 11.54,
      "text": "Around about a month... no wait, it's more like two months. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.94,
      "end_seconds": 48.92,
      "duration_seconds": 7.98,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.86,
      "end_seconds": 62.97,
      "duration_seconds": 12.11,
      "text": "Maybe a eight out of ten on a bad day. I get some relief from a pillow. Yes, coughing. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.91,
      "end_seconds": 70.84,
      "duration_seconds": 2.93,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.69,
      "end_seconds": 76.17,
      "duration_seconds": 4.48,
      "text": "When it starts I tend to get tiredness as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.85,
      "end_seconds": 80.83,
      "duration_seconds": 2.98,
      "text": "Okay, any swollen ankles as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.76,
      "end_seconds": 86.33,
      "duration_seconds": 3.57,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.16,
      "end_seconds": 90.94,
      "duration_seconds": 3.78,
      "text": "Has there been any chest pain on exertion?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.66,
      "end_seconds": 98.54,
      "duration_seconds": 6.88,
      "text": "actually, um, not that I've noticed, no chest pain on exertion"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.13,
      "end_seconds": 103.72,
      "duration_seconds": 4.59,
      "text": "Let me check a few things. Any fever or breathlessness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.51,
      "end_seconds": 109.47,
      "duration_seconds": 3.96,
      "text": "no fever or breathlessness, none of it"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.43,
      "end_seconds": 116.15,
      "duration_seconds": 4.72,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.9,
      "end_seconds": 124.78,
      "duration_seconds": 2.88,
      "text": "Uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.48,
      "end_seconds": 133.33,
      "duration_seconds": 3.85,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.88,
      "end_seconds": 137.51,
      "duration_seconds": 3.63,
      "text": "I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.56,
      "end_seconds": 139.26,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.33,
      "end_seconds": 151.28,
      "duration_seconds": 1.95,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.95,
      "end_seconds": 158.39,
      "duration_seconds": 5.44,
      "text": "just my appendix taken out, when I was in my twenties"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 164.58,
      "duration_seconds": 4.32,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.01,
      "end_seconds": 178.42,
      "duration_seconds": 12.41,
      "text": "Oh, I take aspirin, 75 milligrams, once a day for my heart. Well, uh, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.46,
      "end_seconds": 188.57,
      "duration_seconds": 5.11,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.83,
      "end_seconds": 202.2,
      "duration_seconds": 12.37,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. I hardly move around during the day. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.42,
      "end_seconds": 208.76,
      "duration_seconds": 5.34,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.29,
      "end_seconds": 213.55,
      "duration_seconds": 3.26,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 230.53,
      "end_seconds": 235.56,
      "duration_seconds": 5.03,
      "text": "Okay, so the vitals from earlier. Heart rate 76, pressure 121 over 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.26,
      "end_seconds": 238.19,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.4,
      "end_seconds": 241.64,
      "duration_seconds": 2.24,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.78,
      "end_seconds": 244.85,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.34,
      "end_seconds": 268.95,
      "duration_seconds": 8.61,
      "text": "The chest wound has healed, the breastbone is stable, and and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.48,
      "end_seconds": 274.34,
      "duration_seconds": 1.86,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.86,
      "end_seconds": 296.67,
      "duration_seconds": 5.81,
      "text": "putting it all together, this is probably recovering well after bypass surgery"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.77,
      "end_seconds": 300.63,
      "duration_seconds": 2.86,
      "text": "hmm, will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.23,
      "end_seconds": 310.71,
      "duration_seconds": 9.48,
      "text": "I can't promise yet, but most people with recovering well after bypass surgery do well once it's treated properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 311.91,
      "end_seconds": 315.44,
      "duration_seconds": 3.53,
      "text": "I've already done an ECG, it's ready for you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.08,
      "end_seconds": 334.73,
      "duration_seconds": 18.65,
      "text": "Right, thank you. I'll request blood tests, it'll help with post-operative review. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I'm gonna send a referral to the cardiac rehabilitation team. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 337.64,
      "duration_seconds": 2.15,
      "text": "thank you, that's helpful"
    }
  ]
}