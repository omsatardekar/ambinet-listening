{
  "schema_version": "1.0",
  "encounter_id": "03012",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 5.92,
      "duration_seconds": 5.12,
      "text": "Actually, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 11.85,
      "duration_seconds": 4.52,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.34,
      "end_seconds": 18.68,
      "duration_seconds": 5.34,
      "text": "Well, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.79,
      "end_seconds": 23.39,
      "duration_seconds": 3.6,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.98,
      "end_seconds": 27.25,
      "duration_seconds": 3.27,
      "text": "Oh, I've been dealing with collapsing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 28.59,
      "end_seconds": 40.82,
      "duration_seconds": 12.23,
      "text": "Okay, so the vitals from earlier. Respiratory rate 20, temperature is 36.8 degrees. Blood pressure 93 over 60, heart rate 96, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.79,
      "end_seconds": 43.79,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.47,
      "end_seconds": 64.35,
      "duration_seconds": 2.88,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.74,
      "end_seconds": 70.28,
      "duration_seconds": 4.54,
      "text": "Mm, it's been going on for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.98,
      "end_seconds": 73.77,
      "duration_seconds": 2.79,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.91,
      "end_seconds": 83.16,
      "duration_seconds": 8.25,
      "text": "Uh, um, when it starts I tend to get vaginal spotting as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 90.59,
      "duration_seconds": 7.0,
      "text": "Oh, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 90.69,
      "end_seconds": 96.89,
      "duration_seconds": 6.2,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.26,
      "end_seconds": 100.39,
      "duration_seconds": 2.13,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.23,
      "end_seconds": 118.8,
      "duration_seconds": 17.57,
      "text": "Hmm, the vaginal spotting? That's been for three weeks. Let me think, I did have sudden severe pain in the lower tummy at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 120.75,
      "end_seconds": 123.03,
      "duration_seconds": 2.28,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.66,
      "end_seconds": 125.93,
      "duration_seconds": 1.27,
      "text": "What about vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.95,
      "end_seconds": 129.55,
      "duration_seconds": 2.6,
      "text": "No, um, no vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.59,
      "end_seconds": 133.17,
      "duration_seconds": 2.58,
      "text": "And what about fever or discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.84,
      "end_seconds": 140.06,
      "duration_seconds": 5.22,
      "text": "No, uh, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.09,
      "end_seconds": 145.71,
      "duration_seconds": 3.62,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 151.4,
      "duration_seconds": 4.63,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.39,
      "end_seconds": 155.71,
      "duration_seconds": 2.32,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.51,
      "end_seconds": 169.75,
      "duration_seconds": 13.24,
      "text": "I take glibenclamide, 5 milligrams, before breakfast. Hmm, um, I'm on escitalopram, 10 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.82,
      "end_seconds": 175.39,
      "duration_seconds": 3.57,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.26,
      "end_seconds": 188.08,
      "duration_seconds": 10.82,
      "text": "Not with me. I'll bring it next time. Right, you know, it's Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 189.06,
      "end_seconds": 196.84,
      "duration_seconds": 7.78,
      "text": "She is supposed to take it every morning, but I can't say she always does."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.56,
      "end_seconds": 200.63,
      "duration_seconds": 3.07,
      "text": "It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 206.45,
      "duration_seconds": 4.58,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.76,
      "end_seconds": 215.58,
      "duration_seconds": 4.82,
      "text": "Okay, so yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.33,
      "end_seconds": 221.45,
      "duration_seconds": 4.12,
      "text": "Alright, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.28,
      "end_seconds": 239.29,
      "duration_seconds": 16.01,
      "text": "Yes, diabetes. I've had depression, yes. My family kept telling me to get it checked. An underactive thyroid, for five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.35,
      "end_seconds": 242.69,
      "duration_seconds": 1.34,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.42,
      "end_seconds": 248.99,
      "duration_seconds": 5.57,
      "text": "Okay, so I've had COPD for about ten years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.65,
      "end_seconds": 253.35,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.1,
      "end_seconds": 259.12,
      "duration_seconds": 5.02,
      "text": "I have heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.87,
      "end_seconds": 269.31,
      "duration_seconds": 8.44,
      "text": "Right, so depression and COPD are already on your record. We'll keep that in mind today. Any smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.79,
      "end_seconds": 274.53,
      "duration_seconds": 3.74,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.87,
      "end_seconds": 277.91,
      "duration_seconds": 2.04,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.55,
      "end_seconds": 280.22,
      "duration_seconds": 1.67,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 283.86,
      "duration_seconds": 2.4,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.67,
      "end_seconds": 288.72,
      "duration_seconds": 4.05,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.02,
      "end_seconds": 292.98,
      "duration_seconds": 2.96,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.95,
      "end_seconds": 299.87,
      "duration_seconds": 5.92,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.26,
      "end_seconds": 303.96,
      "duration_seconds": 2.7,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.54,
      "end_seconds": 308.63,
      "duration_seconds": 3.09,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.86,
      "end_seconds": 313.41,
      "duration_seconds": 2.55,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.57,
      "end_seconds": 317.0,
      "duration_seconds": 2.43,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.53,
      "end_seconds": 333.09,
      "duration_seconds": 7.56,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.11,
      "end_seconds": 339.5,
      "duration_seconds": 2.39,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 351.61,
      "end_seconds": 355.3,
      "duration_seconds": 3.69,
      "text": "I've already done a pregnancy test, it's ready for you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.01,
      "end_seconds": 392.2,
      "duration_seconds": 36.19,
      "text": "Great, that's useful. I want urgent blood tests done, that's for internal bleeding. I am calling the emergency team, you need an operation now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Let's get you seen by the emergency team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.97,
      "end_seconds": 396.16,
      "duration_seconds": 2.19,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.84,
      "end_seconds": 398.54,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.39,
      "end_seconds": 404.72,
      "duration_seconds": 4.33,
      "text": "Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.34,
      "end_seconds": 408.94,
      "duration_seconds": 3.6,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}