{
  "schema_version": "1.0",
  "encounter_id": "03421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 7.57,
      "duration_seconds": 6.44,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 12.86,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.11,
      "end_seconds": 23.91,
      "duration_seconds": 9.8,
      "text": "Yeah, mainly being found cold and drowsy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.35,
      "end_seconds": 27.57,
      "duration_seconds": 2.22,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.38,
      "end_seconds": 32.18,
      "duration_seconds": 2.8,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.82,
      "end_seconds": 35.59,
      "duration_seconds": 2.77,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.32,
      "end_seconds": 53.17,
      "duration_seconds": 15.85,
      "text": "It usually comes with shivering that has stopped. About shivering that has stopped, I'd give it a three, out of ten. There was confusion, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.97,
      "end_seconds": 58.71,
      "duration_seconds": 3.74,
      "text": "Have you had any head injury, alcohol or fall?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.11,
      "end_seconds": 66.51,
      "duration_seconds": 6.4,
      "text": "Let me think, no head injury, alcohol or fall, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.18,
      "end_seconds": 70.34,
      "duration_seconds": 3.16,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.18,
      "end_seconds": 74.53,
      "duration_seconds": 2.35,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.44,
      "end_seconds": 78.89,
      "duration_seconds": 2.45,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 86.39,
      "duration_seconds": 5.99,
      "text": "It's something called glic... gliclazide, 80 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.76,
      "end_seconds": 95.8,
      "duration_seconds": 3.04,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 99.43,
      "duration_seconds": 2.08,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.62,
      "end_seconds": 103.03,
      "duration_seconds": 2.41,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.98,
      "end_seconds": 120.58,
      "duration_seconds": 15.6,
      "text": "I only drink at family occasions. Lots of rice, lentils and some fruit. I do a yoga class on Thursdays. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.75,
      "end_seconds": 139.08,
      "duration_seconds": 4.33,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.79,
      "end_seconds": 146.31,
      "duration_seconds": 6.52,
      "text": "Sorry, what was I saying, I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.08,
      "end_seconds": 149.54,
      "duration_seconds": 2.46,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.58,
      "end_seconds": 153.41,
      "duration_seconds": 1.83,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.48,
      "end_seconds": 155.53,
      "duration_seconds": 1.05,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.62,
      "end_seconds": 159.91,
      "duration_seconds": 3.29,
      "text": "I've, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 168.38,
      "duration_seconds": 7.47,
      "text": "Alright, COPD, that matches what I have here. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.69,
      "end_seconds": 178.44,
      "duration_seconds": 2.75,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.34,
      "end_seconds": 199.22,
      "duration_seconds": 6.88,
      "text": "Okay: temperature 36.5, oxygen saturation is 99 percent, BP is 119 over 80. And pulse 83."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.91,
      "end_seconds": 203.86,
      "duration_seconds": 2.95,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.0,
      "end_seconds": 207.6,
      "duration_seconds": 2.6,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.92,
      "end_seconds": 222.36,
      "duration_seconds": 6.44,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.62,
      "end_seconds": 226.47,
      "duration_seconds": 1.85,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.2,
      "end_seconds": 247.36,
      "duration_seconds": 7.16,
      "text": "So where does that leave us? This is probably severe hypothermia. Hypoglycaemia is also on my list."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.88,
      "end_seconds": 284.49,
      "duration_seconds": 20.61,
      "text": "I'm going to order a blood sugar, for hypothermia. That will help us see what's going on underneath and decide the next step. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.34,
      "end_seconds": 290.63,
      "duration_seconds": 4.29,
      "text": "So, I know what to watch for."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.14,
      "end_seconds": 295.83,
      "duration_seconds": 4.69,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.83,
      "end_seconds": 299.77,
      "duration_seconds": 1.94,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.07,
      "end_seconds": 302.85,
      "duration_seconds": 1.78,
      "text": "So, all the best."
    }
  ]
}