    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.16,
      "end_seconds": 87.08,
      "duration_seconds": 3.92,
      "text": "sure have you noticed diarrhoea or bone pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.85,
      "end_seconds": 92.12,
      "duration_seconds": 4.27,
      "text": "I haven't had diarrhoea or bone pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.01,
      "end_seconds": 97.03,
      "duration_seconds": 3.02,
      "text": "have you noticed weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.98,
      "end_seconds": 100.93,
      "duration_seconds": 1.95,
      "text": "none of those no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.08,
      "end_seconds": 106.83,
      "duration_seconds": 1.75,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.9,
      "end_seconds": 109.41,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.7,
      "end_seconds": 127.11,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.13,
      "end_seconds": 130.97,
      "duration_seconds": 2.84,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 143.86,
      "duration_seconds": 3.35,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.29,
      "end_seconds": 149.91,
      "duration_seconds": 4.62,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.06,
      "end_seconds": 153.47,
      "duration_seconds": 2.41,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.74,
      "end_seconds": 162.15,
      "duration_seconds": 3.41,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.67,
      "end_seconds": 167.38,
      "duration_seconds": 4.71,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.38,
      "end_seconds": 175.62,
      "duration_seconds": 7.24,
      "text": "I have high blood pressure for about a year right I've had heart disease yes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.26,
      "end_seconds": 180.56,
      "duration_seconds": 3.3,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.12,
      "end_seconds": 186.22,
      "duration_seconds": 5.1,
      "text": "No, um, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.19,
      "end_seconds": 190.27,
      "duration_seconds": 3.08,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.0,
      "end_seconds": 198.06,
      "duration_seconds": 6.06,
      "text": "Yes, you know, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.63,
      "end_seconds": 201.37,
      "duration_seconds": 2.74,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.54,
      "end_seconds": 217.2,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.59,
      "end_seconds": 241.31,
      "duration_seconds": 8.72,
      "text": "Okay: blood pressure 119 over 74, temperature 36.7, pulse is 71 beats a minute, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 245.94,
      "duration_seconds": 3.48,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.74,
      "end_seconds": 263.44,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.67,
      "end_seconds": 267.12,
      "duration_seconds": 2.45,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.86,
      "end_seconds": 287.71,
      "duration_seconds": 5.85,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.46,
      "end_seconds": 303.84,
      "duration_seconds": 10.38,
      "text": "you can sit up now okay, thinking it through, I'd lean towards coeliac disease on a gluten-free diet with some accidental exposure"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.35,
      "end_seconds": 306.26,
      "duration_seconds": 1.91,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.82,
      "end_seconds": 326.28,
      "duration_seconds": 18.46,
      "text": "I understand the worry. At the moment I'd say it's coeliac disease on a gluten-free diet with some accidental exposure, and we'll know more once the coeliac antibodies is back. coeliac antibodies is what I'd like next, for coeliac follow-up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.55,
      "end_seconds": 334.07,
      "duration_seconds": 2.52,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.98,
      "end_seconds": 342.33,
      "duration_seconds": 7.35,
      "text": "check labels carefully and use separate toasters and chopping boards we'll refer you to the dietitian"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.21,
      "end_seconds": 345.69,
      "duration_seconds": 1.48,
      "text": "Alright thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.99,
      "end_seconds": 351.76,
      "duration_seconds": 4.77,
      "text": "let's review you in twelve months have I covered everything you wanted?"
    },
