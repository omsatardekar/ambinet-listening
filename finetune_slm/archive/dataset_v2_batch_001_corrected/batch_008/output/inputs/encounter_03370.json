      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.26,
      "end_seconds": 355.96,
      "duration_seconds": 2.7,
      "text": "Hmm alright thanks take care."
    },
