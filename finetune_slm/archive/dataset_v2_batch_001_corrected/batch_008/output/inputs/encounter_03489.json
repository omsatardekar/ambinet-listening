{
  "schema_version": "1.0",
  "encounter_id": "03489",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 6.37,
      "duration_seconds": 5.79,
      "text": "Afternoon, thanks for coming in. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.41,
      "end_seconds": 17.66,
      "duration_seconds": 9.25,
      "text": "Mainly sudden breathlessness five days after surgery. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.03,
      "end_seconds": 20.24,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.76,
      "end_seconds": 36.8,
      "duration_seconds": 16.04,
      "text": "Ever since... since last night, really. There's sharp chest pain on breathing in as well. As for sharp chest pain on breathing in, it happens all the time."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.05,
      "end_seconds": 44.46,
      "duration_seconds": 2.41,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.34,
      "end_seconds": 48.96,
      "duration_seconds": 3.62,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.37,
      "end_seconds": 52.7,
      "duration_seconds": 2.33,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.28,
      "end_seconds": 59.12,
      "duration_seconds": 5.84,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 79.67,
      "duration_seconds": 3.95,
      "text": "Right, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.18,
      "end_seconds": 85.74,
      "duration_seconds": 5.56,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.49,
      "end_seconds": 108.5,
      "duration_seconds": 4.01,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.07,
      "end_seconds": 111.88,
      "duration_seconds": 2.81,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.7,
      "end_seconds": 115.53,
      "duration_seconds": 2.83,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.13,
      "end_seconds": 118.84,
      "duration_seconds": 1.71,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.35,
      "end_seconds": 133.41,
      "duration_seconds": 4.06,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.87,
      "end_seconds": 136.33,
      "duration_seconds": 1.46,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.88,
      "end_seconds": 145.42,
      "duration_seconds": 3.54,
      "text": "Any coughing up blood or wound problem at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.51,
      "end_seconds": 151.97,
      "duration_seconds": 2.46,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.85,
      "end_seconds": 160.38,
      "duration_seconds": 2.53,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.05,
      "end_seconds": 163.75,
      "duration_seconds": 1.7,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 168.64,
      "duration_seconds": 3.45,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.31,
      "end_seconds": 172.0,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.92,
      "end_seconds": 176.21,
      "duration_seconds": 2.29,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.33,
      "end_seconds": 182.28,
      "duration_seconds": 2.95,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.77,
      "end_seconds": 202.26,
      "duration_seconds": 2.49,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.1,
      "end_seconds": 218.21,
      "duration_seconds": 3.11,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.65,
      "end_seconds": 242.18,
      "duration_seconds": 11.53,
      "text": "Okay: pulse is 91 beats a minute, temperature is 36.8 degrees, blood pressure 127 over 77, SpO2 93 percent on room air."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.45,
      "end_seconds": 247.89,
      "duration_seconds": 4.44,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.09,
      "end_seconds": 251.51,
      "duration_seconds": 2.42,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.79,
      "end_seconds": 264.66,
      "duration_seconds": 4.87,
      "text": "Your left calf is swollen and tender and your oxygen is low."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.17,
      "end_seconds": 269.51,
      "duration_seconds": 1.34,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.01,
      "end_seconds": 309.24,
      "duration_seconds": 35.23,
      "text": "You can relax now. Putting it all together, it points towards a possible blood clot in the lung after surgery. I'm sending you for a D-dimer because of possible clot. That will help us see what's going on underneath and decide the next step. I'll start you on enoxaparin, 1.5 mg per kg, once now, single dose. It's for possible clot. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.97,
      "end_seconds": 329.9,
      "duration_seconds": 14.93,
      "text": "Please go to hospital now, I will call ahead. Please don't wait if the symptoms get worse. That's when to be seen urgently. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.53,
      "end_seconds": 334.54,
      "duration_seconds": 4.01,
      "text": "Right, okay, that makes sense. Thanks for explaining."
    }
  ]
}