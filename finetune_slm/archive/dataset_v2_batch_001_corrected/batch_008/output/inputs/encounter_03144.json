{
  "schema_version": "1.0",
  "encounter_id": "03144",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.94,
      "end_seconds": 4.33,
      "duration_seconds": 3.39,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.7,
      "end_seconds": 9.14,
      "duration_seconds": 3.44,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.52,
      "end_seconds": 16.84,
      "duration_seconds": 6.32,
      "text": "Good, that'll be useful. Pull up a chair. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.64,
      "end_seconds": 25.69,
      "duration_seconds": 3.05,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.41,
      "end_seconds": 28.52,
      "duration_seconds": 2.11,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 29.64,
      "end_seconds": 35.18,
      "duration_seconds": 5.54,
      "text": "She's been having a cough that eases on holiday, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.74,
      "end_seconds": 39.11,
      "duration_seconds": 3.37,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.04,
      "end_seconds": 51.18,
      "duration_seconds": 11.14,
      "text": "Oh, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 61.85,
      "duration_seconds": 9.96,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.93,
      "end_seconds": 73.96,
      "duration_seconds": 11.03,
      "text": "I mean, it sort of comes and goes. Severe, really. Oh, there was wheeze at work, yes, but that went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.08,
      "end_seconds": 77.57,
      "duration_seconds": 2.49,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 92.73,
      "duration_seconds": 2.47,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 124.1,
      "duration_seconds": 11.17,
      "text": "Okay: respiratory rate 17, temperature is 37.0 degrees, pulse is 82 beats a minute, saturation 97 percent, BP is 109 over 71."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 129.92,
      "duration_seconds": 3.9,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.37,
      "end_seconds": 134.58,
      "duration_seconds": 3.21,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.95,
      "end_seconds": 152.19,
      "duration_seconds": 5.24,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.01,
      "end_seconds": 155.23,
      "duration_seconds": 1.22,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.33,
      "end_seconds": 167.64,
      "duration_seconds": 7.31,
      "text": "That's the examination finished. Alright, any coughing up blood, weight loss or ankle swelling at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.08,
      "end_seconds": 172.77,
      "duration_seconds": 3.69,
      "text": "Uh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.54,
      "end_seconds": 176.34,
      "duration_seconds": 1.8,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.45,
      "end_seconds": 180.22,
      "duration_seconds": 2.77,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.07,
      "end_seconds": 188.6,
      "duration_seconds": 4.53,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.3,
      "end_seconds": 192.04,
      "duration_seconds": 2.74,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.73,
      "end_seconds": 197.0,
      "duration_seconds": 3.27,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.05,
      "end_seconds": 217.3,
      "duration_seconds": 19.25,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. Yes, I work in a bakery, early starts. No, I share a house with my brother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.4,
      "end_seconds": 219.59,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.25,
      "end_seconds": 225.86,
      "duration_seconds": 1.61,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.59,
      "end_seconds": 230.86,
      "duration_seconds": 4.27,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.79,
      "end_seconds": 235.8,
      "duration_seconds": 4.01,
      "text": "Escitalopram, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.86,
      "end_seconds": 239.0,
      "duration_seconds": 2.14,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.7,
      "end_seconds": 242.27,
      "duration_seconds": 1.57,
      "text": "It's 10 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 247.13,
      "duration_seconds": 4.04,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.38,
      "end_seconds": 256.13,
      "duration_seconds": 7.75,
      "text": "I was told I'm allergic to kiwi, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.02,
      "end_seconds": 277.24,
      "duration_seconds": 2.22,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 278.44,
      "end_seconds": 281.46,
      "duration_seconds": 3.02,
      "text": "Anxiety, for about a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.32,
      "end_seconds": 286.89,
      "duration_seconds": 4.57,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.22,
      "end_seconds": 301.88,
      "duration_seconds": 4.66,
      "text": "Taking everything into account, this looks most like occupational asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 303.78,
      "end_seconds": 308.84,
      "duration_seconds": 5.06,
      "text": "Uh, um, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.25,
      "end_seconds": 319.01,
      "duration_seconds": 8.76,
      "text": "Nothing I've seen today points to an emergency. It looks like occupational asthma, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.62,
      "end_seconds": 338.08,
      "duration_seconds": 6.46,
      "text": "We should do spirometry for wheeze. We should do serial peak flow readings for work-related wheeze."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.57,
      "end_seconds": 342.14,
      "duration_seconds": 2.57,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.09,
      "end_seconds": 372.62,
      "duration_seconds": 29.53,
      "text": "I'm prescribing beclometasone inhaler, 200 micrograms, twice a day, long term. It's for asthma. The pharmacy will go through the details again when you pick it up. Record peak flows at work and at home for four weeks. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Let's get you seen by occupational health, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.51,
      "end_seconds": 382.29,
      "duration_seconds": 7.78,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again in four weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 384.07,
      "end_seconds": 386.87,
      "duration_seconds": 2.8,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.46,
      "end_seconds": 396.67,
      "duration_seconds": 8.21,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 397.55,
      "end_seconds": 408.64,
      "duration_seconds": 11.09,
      "text": "So, I take the beclometasone inhaler, 200 micrograms, twice a day and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.59,
      "end_seconds": 415.41,
      "duration_seconds": 3.82,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 417.41,
      "end_seconds": 421.67,
      "duration_seconds": 4.26,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.65,
      "end_seconds": 424.93,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}