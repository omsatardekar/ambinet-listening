{
  "schema_version": "1.0",
  "encounter_id": "03200",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 2.61,
      "duration_seconds": 1.76,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.32,
      "end_seconds": 10.36,
      "duration_seconds": 5.04,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.13,
      "end_seconds": 18.03,
      "duration_seconds": 5.9,
      "text": "Honestly, it's chest pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.26,
      "end_seconds": 22.71,
      "duration_seconds": 3.45,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.19,
      "end_seconds": 26.25,
      "duration_seconds": 2.06,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.31,
      "end_seconds": 29.68,
      "duration_seconds": 2.37,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.07,
      "end_seconds": 33.89,
      "duration_seconds": 2.82,
      "text": "Sitting forward helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.12,
      "end_seconds": 52.38,
      "duration_seconds": 3.26,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.23,
      "end_seconds": 62.59,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.18,
      "end_seconds": 82.56,
      "duration_seconds": 7.38,
      "text": "Okay: oxygen saturation is 98 percent, pulse 100. And BP is 92 over 58, temperature 37.0."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.31,
      "end_seconds": 86.51,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.05,
      "end_seconds": 89.81,
      "duration_seconds": 2.76,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.44,
      "end_seconds": 94.43,
      "duration_seconds": 2.99,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.6,
      "end_seconds": 96.89,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.57,
      "end_seconds": 116.17,
      "duration_seconds": 6.6,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.31,
      "end_seconds": 125.43,
      "duration_seconds": 5.12,
      "text": "Thank you, you can get dressed. Have you had any cough?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.1,
      "end_seconds": 130.34,
      "duration_seconds": 3.24,
      "text": "No, I haven't had any cough."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.87,
      "end_seconds": 134.15,
      "duration_seconds": 3.28,
      "text": "Alright, and what about leg swelling or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.6,
      "end_seconds": 140.14,
      "duration_seconds": 2.54,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.47,
      "end_seconds": 144.14,
      "duration_seconds": 2.67,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.65,
      "end_seconds": 145.64,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.78,
      "end_seconds": 148.87,
      "duration_seconds": 2.09,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.75,
      "end_seconds": 151.09,
      "duration_seconds": 1.34,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.4,
      "end_seconds": 156.78,
      "duration_seconds": 4.38,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.33,
      "end_seconds": 160.9,
      "duration_seconds": 2.57,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.56,
      "end_seconds": 166.27,
      "duration_seconds": 3.71,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.2,
      "end_seconds": 174.54,
      "duration_seconds": 3.34,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.29,
      "end_seconds": 178.0,
      "duration_seconds": 2.71,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 182.99,
      "duration_seconds": 4.12,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.46,
      "end_seconds": 205.44,
      "duration_seconds": 3.98,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.32,
      "end_seconds": 209.35,
      "duration_seconds": 3.03,
      "text": "Thin bones, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.27,
      "end_seconds": 222.92,
      "duration_seconds": 11.65,
      "text": "Alright, thin bones, that matches what I have here. Do you take any prescribed or over-the-counter medicines? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.74,
      "end_seconds": 228.03,
      "duration_seconds": 4.29,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.98,
      "end_seconds": 248.37,
      "duration_seconds": 5.39,
      "text": "Okay, thinking it through, my working impression is possible cardiac tamponade."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.43,
      "end_seconds": 275.04,
      "duration_seconds": 17.61,
      "text": "I want an ECG done, that's for chest pain. I'd rather check than guess, and this is the quickest way to know more. I want an urgent echocardiogram done, that's for possible tamponade. You need an urgent heart scan and possibly a drain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.63,
      "end_seconds": 282.79,
      "duration_seconds": 7.16,
      "text": "I see, go ahead. Let's get you seen by the cardiology team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.43,
      "end_seconds": 284.9,
      "duration_seconds": 1.47,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.89,
      "end_seconds": 292.64,
      "duration_seconds": 5.75,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.77,
      "end_seconds": 295.55,
      "duration_seconds": 1.78,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.46,
      "end_seconds": 298.55,
      "duration_seconds": 2.09,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.02,
      "end_seconds": 306.25,
      "duration_seconds": 2.23,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.12,
      "end_seconds": 311.41,
      "duration_seconds": 3.29,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.41,
      "end_seconds": 317.7,
      "duration_seconds": 4.29,
      "text": "No, you know, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.39,
      "end_seconds": 319.56,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}