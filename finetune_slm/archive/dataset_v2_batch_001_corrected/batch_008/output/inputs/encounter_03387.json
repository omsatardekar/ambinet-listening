{
  "schema_version": "1.0",
  "encounter_id": "03387",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.44,
      "duration_seconds": 5.74,
      "text": "Okay, so hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.36,
      "end_seconds": 12.61,
      "duration_seconds": 4.25,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.26,
      "end_seconds": 20.69,
      "duration_seconds": 7.43,
      "text": "Let me think, uh, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.14,
      "end_seconds": 26.94,
      "duration_seconds": 4.8,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.13,
      "end_seconds": 35.12,
      "duration_seconds": 6.99,
      "text": "Okay, so doctor, it's hearing getting worse in both ears. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.23,
      "end_seconds": 38.6,
      "duration_seconds": 2.37,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.44,
      "end_seconds": 43.86,
      "duration_seconds": 4.42,
      "text": "I take sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 44.43,
      "end_seconds": 50.99,
      "duration_seconds": 6.56,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.94,
      "end_seconds": 63.75,
      "duration_seconds": 10.81,
      "text": "I'm on Asthalin inhaler, when needed for my asthma. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.62,
      "end_seconds": 69.35,
      "duration_seconds": 3.73,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.39,
      "end_seconds": 75.68,
      "duration_seconds": 4.29,
      "text": "About three days, um, give or take."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.54,
      "end_seconds": 81.18,
      "duration_seconds": 3.64,
      "text": "It was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.87,
      "end_seconds": 86.1,
      "duration_seconds": 4.23,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.78,
      "end_seconds": 89.6,
      "duration_seconds": 1.82,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.2,
      "end_seconds": 92.7,
      "duration_seconds": 2.5,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.46,
      "end_seconds": 97.58,
      "duration_seconds": 3.12,
      "text": "It, It feels moderate to me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 104.75,
      "duration_seconds": 3.29,
      "text": "Have you had ringing in the ears?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.69,
      "end_seconds": 107.79,
      "duration_seconds": 1.1,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.33,
      "end_seconds": 111.2,
      "duration_seconds": 2.87,
      "text": "Has there been no dizziness too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.01,
      "end_seconds": 128.5,
      "duration_seconds": 15.49,
      "text": "Yes, you know, for five days. I've, I've also had hearing better in a noisy room, for four weeks. With hearing better in a noisy room, a five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.76,
      "end_seconds": 137.77,
      "duration_seconds": 5.01,
      "text": "Okay, a few quick ones: discharge, facial weakness or ear pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.56,
      "end_seconds": 145.35,
      "duration_seconds": 5.79,
      "text": "No discharge, facial weakness or ear pain, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.3,
      "end_seconds": 150.02,
      "duration_seconds": 2.72,
      "text": "Right, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 154.19,
      "duration_seconds": 2.53,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.03,
      "end_seconds": 156.3,
      "duration_seconds": 1.27,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.45,
      "end_seconds": 164.04,
      "duration_seconds": 3.59,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.41,
      "end_seconds": 168.87,
      "duration_seconds": 3.46,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 174.61,
      "duration_seconds": 3.91,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.12,
      "end_seconds": 193.28,
      "duration_seconds": 4.16,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.64,
      "end_seconds": 200.39,
      "duration_seconds": 5.75,
      "text": "Diabetes, for five years. Well, I have asthma, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.48,
      "end_seconds": 213.23,
      "duration_seconds": 10.75,
      "text": "Right, so diabetes and asthma are already on your record. We'll keep that in mind today. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.29,
      "end_seconds": 215.89,
      "duration_seconds": 1.6,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.27,
      "end_seconds": 225.93,
      "duration_seconds": 8.66,
      "text": "Actually, I remember he had some kind of reaction to tramadol before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.6,
      "end_seconds": 228.51,
      "duration_seconds": 1.91,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.91,
      "end_seconds": 236.76,
      "duration_seconds": 2.85,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.28,
      "end_seconds": 249.19,
      "duration_seconds": 2.91,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 257.75,
      "duration_seconds": 2.49,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.46,
      "end_seconds": 283.23,
      "duration_seconds": 6.77,
      "text": "Okay: pressure 128 over 70, pulse is 84 beats a minute, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.97,
      "end_seconds": 285.57,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.2,
      "end_seconds": 288.66,
      "duration_seconds": 2.46,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.88,
      "end_seconds": 293.41,
      "duration_seconds": 3.53,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.78,
      "end_seconds": 296.91,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.16,
      "end_seconds": 300.81,
      "duration_seconds": 2.65,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.17,
      "end_seconds": 322.35,
      "duration_seconds": 6.18,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.74,
      "end_seconds": 328.35,
      "duration_seconds": 2.61,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.47,
      "end_seconds": 359.99,
      "duration_seconds": 17.52,
      "text": "Putting it all together, I can't pin this down yet. We're looking at a conductive hearing loss, possibly otosclerosis or wax. Stop me if I've got anything wrong. You've had hearing getting worse in both ears, moderate, and no facial weakness or discharge."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.72,
      "end_seconds": 363.21,
      "duration_seconds": 1.49,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.11,
      "end_seconds": 369.68,
      "duration_seconds": 5.57,
      "text": "I want a CT scan of the ears done, that's for possible otosclerosis."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.63,
      "end_seconds": 374.99,
      "duration_seconds": 3.36,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.67,
      "end_seconds": 394.61,
      "duration_seconds": 17.94,
      "text": "I think a hearing test makes sense here, for hearing loss. A hearing aid or an operation are both options after the tests. Come back or go to emergency straight away if the symptoms get worse. Please come and see me after the tests."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.5,
      "end_seconds": 397.69,
      "duration_seconds": 2.19,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.26,
      "end_seconds": 403.35,
      "duration_seconds": 4.09,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.92,
      "end_seconds": 407.31,
      "duration_seconds": 3.39,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.84,
      "end_seconds": 410.27,
      "duration_seconds": 1.43,
      "text": "All the best."
    }
  ]
}