{
  "schema_version": "1.0",
  "encounter_id": "03045",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 5.26,
      "duration_seconds": 4.58,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.1,
      "end_seconds": 10.14,
      "duration_seconds": 4.04,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.39,
      "end_seconds": 17.06,
      "duration_seconds": 5.67,
      "text": "Mainly I've been feeling tired and weak. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.0,
      "end_seconds": 26.13,
      "duration_seconds": 7.13,
      "text": "What's on your current medicine list? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.56,
      "end_seconds": 30.24,
      "duration_seconds": 2.68,
      "text": "I take Thyronorm, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.08,
      "end_seconds": 34.07,
      "duration_seconds": 1.99,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.95,
      "end_seconds": 41.25,
      "duration_seconds": 6.3,
      "text": "It's 50 micrograms. Omeprazole. I take it 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.35,
      "end_seconds": 45.98,
      "duration_seconds": 2.63,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.4,
      "end_seconds": 49.19,
      "duration_seconds": 1.79,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 66.65,
      "duration_seconds": 3.22,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.63,
      "end_seconds": 74.55,
      "duration_seconds": 6.92,
      "text": "About... well, about a month. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.27,
      "end_seconds": 79.18,
      "duration_seconds": 2.91,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.66,
      "end_seconds": 85.54,
      "duration_seconds": 2.88,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 88.76,
      "duration_seconds": 2.35,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.19,
      "end_seconds": 97.96,
      "duration_seconds": 7.77,
      "text": "It usually comes with dizziness on standing. As for dizziness on standing, severe, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.68,
      "end_seconds": 101.03,
      "duration_seconds": 2.35,
      "text": "Has there been craving salt too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.36,
      "end_seconds": 105.22,
      "duration_seconds": 2.86,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.29,
      "end_seconds": 115.37,
      "duration_seconds": 7.08,
      "text": "Let me check a few things. Any severe tummy pain, fever, vomiting or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.15,
      "end_seconds": 118.23,
      "duration_seconds": 2.08,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.78,
      "end_seconds": 121.82,
      "duration_seconds": 2.04,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.29,
      "end_seconds": 124.86,
      "duration_seconds": 1.57,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.15,
      "end_seconds": 130.04,
      "duration_seconds": 3.89,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.21,
      "end_seconds": 136.04,
      "duration_seconds": 4.83,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.11,
      "end_seconds": 140.27,
      "duration_seconds": 3.16,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.96,
      "end_seconds": 148.48,
      "duration_seconds": 6.52,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.82,
      "end_seconds": 155.6,
      "duration_seconds": 5.78,
      "text": "Right, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.35,
      "end_seconds": 174.51,
      "duration_seconds": 17.16,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. Yes, I work in a bakery, early starts. My partner and our baby. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.43,
      "end_seconds": 179.71,
      "duration_seconds": 4.28,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.33,
      "end_seconds": 183.2,
      "duration_seconds": 2.87,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.24,
      "end_seconds": 194.45,
      "duration_seconds": 3.21,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.14,
      "end_seconds": 197.02,
      "duration_seconds": 1.88,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.97,
      "end_seconds": 202.26,
      "duration_seconds": 4.29,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.38,
      "end_seconds": 209.67,
      "duration_seconds": 6.29,
      "text": "Yes, an underactive thyroid. Acid reflux, for about ten years. Yes, heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.54,
      "end_seconds": 214.8,
      "duration_seconds": 4.26,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.46,
      "end_seconds": 224.88,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 243.39,
      "duration_seconds": 8.36,
      "text": "Okay: oxygen saturation is 97 percent, temp 37.0 degrees, heart rate 106, pressure 100 over 56."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.98,
      "end_seconds": 249.39,
      "duration_seconds": 3.41,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.95,
      "end_seconds": 254.58,
      "duration_seconds": 1.63,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.86,
      "end_seconds": 257.98,
      "duration_seconds": 2.12,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.95,
      "end_seconds": 277.78,
      "duration_seconds": 9.83,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.3,
      "end_seconds": 284.99,
      "duration_seconds": 2.69,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.9,
      "end_seconds": 304.23,
      "duration_seconds": 7.33,
      "text": "Having listened and examined, it points towards possible adrenal insufficiency. An underactive thyroid is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.72,
      "end_seconds": 307.7,
      "duration_seconds": 1.98,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.99,
      "end_seconds": 328.96,
      "duration_seconds": 19.97,
      "text": "It's reasonable to be concerned, but right now possible adrenal insufficiency is my leading thought, not anything worse. I want a short synacthen test done, that's for possible adrenal insufficiency. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.67,
      "end_seconds": 332.26,
      "duration_seconds": 1.59,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.1,
      "end_seconds": 364.25,
      "duration_seconds": 31.15,
      "text": "I want blood tests done, that's for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. I'd like you to see the endocrine clinic as well, and I'll write the referral. I'd like to see you again after the results. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.89,
      "end_seconds": 371.35,
      "duration_seconds": 6.46,
      "text": "So, um, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.31,
      "end_seconds": 378.15,
      "duration_seconds": 4.84,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.12,
      "end_seconds": 383.43,
      "duration_seconds": 3.31,
      "text": "Great, thank you for your help."
    }
  ]
}