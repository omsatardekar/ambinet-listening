{
  "schema_version": "1.0",
  "encounter_id": "03051",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 3.75,
      "duration_seconds": 2.86,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.88,
      "end_seconds": 8.37,
      "duration_seconds": 3.49,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.87,
      "end_seconds": 11.75,
      "duration_seconds": 2.88,
      "text": "Well, I've been having tiredness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.25,
      "end_seconds": 19.41,
      "duration_seconds": 3.16,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.28,
      "end_seconds": 32.24,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.03,
      "end_seconds": 56.11,
      "duration_seconds": 7.08,
      "text": "Okay: oxygen saturation is 97 percent, pulse 67, temperature 36.4. And pressure 108 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.19,
      "end_seconds": 58.86,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.63,
      "end_seconds": 67.52,
      "duration_seconds": 6.89,
      "text": "Don't worry, we'll discuss it in a second. Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.44,
      "end_seconds": 72.06,
      "duration_seconds": 2.62,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.14,
      "end_seconds": 77.16,
      "duration_seconds": 3.02,
      "text": "So, is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.27,
      "end_seconds": 89.37,
      "duration_seconds": 11.1,
      "text": "Pain in my breastbone wound goes along with it, most of the time. The pain in my breastbone wound? That's been for four weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.61,
      "end_seconds": 94.23,
      "duration_seconds": 3.62,
      "text": "Any breathlessness, fever or chest pain on exertion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.0,
      "end_seconds": 100.53,
      "duration_seconds": 4.53,
      "text": "No, no breathlessness, fever or chest pain on exertion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.34,
      "end_seconds": 104.5,
      "duration_seconds": 2.16,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.69,
      "end_seconds": 106.8,
      "duration_seconds": 1.11,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.93,
      "end_seconds": 110.99,
      "duration_seconds": 3.06,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.62,
      "end_seconds": 115.91,
      "duration_seconds": 4.29,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.69,
      "end_seconds": 122.37,
      "duration_seconds": 4.68,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.09,
      "end_seconds": 129.73,
      "duration_seconds": 4.64,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.62,
      "end_seconds": 147.08,
      "duration_seconds": 4.46,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.45,
      "end_seconds": 159.14,
      "duration_seconds": 10.69,
      "text": "I'm a hairdresser, on my feet all day. I swim twice a week. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.05,
      "end_seconds": 179.69,
      "duration_seconds": 2.64,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.39,
      "end_seconds": 182.71,
      "duration_seconds": 2.32,
      "text": "Clopidogrel, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.58,
      "end_seconds": 185.74,
      "duration_seconds": 2.16,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.37,
      "end_seconds": 191.37,
      "duration_seconds": 5.0,
      "text": "75 milligrams. Lansoprazole. I take it 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.87,
      "end_seconds": 208.15,
      "duration_seconds": 4.28,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.46,
      "end_seconds": 215.14,
      "duration_seconds": 5.68,
      "text": "I have heart disease, for about ten years. I have acid reflux."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.16,
      "end_seconds": 223.97,
      "duration_seconds": 6.81,
      "text": "Right, right. Alright, heart disease and acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.45,
      "end_seconds": 227.65,
      "duration_seconds": 2.2,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.5,
      "end_seconds": 230.07,
      "duration_seconds": 1.57,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.54,
      "end_seconds": 246.31,
      "duration_seconds": 8.77,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.18,
      "end_seconds": 251.41,
      "duration_seconds": 2.23,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.32,
      "end_seconds": 302.9,
      "duration_seconds": 35.58,
      "text": "Putting it all together, I can't pin this down yet. We're looking at recovering well after bypass surgery or a leg wound infection. We should do an ECG for post-operative review. It's a routine test and it'll give us a much clearer picture. I'm going to order blood tests, for post-operative review. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I'm going to send a referral to the cardiac rehabilitation team."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.66,
      "end_seconds": 306.1,
      "duration_seconds": 2.44,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.1,
      "end_seconds": 314.24,
      "duration_seconds": 6.14,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.65,
      "end_seconds": 318.55,
      "duration_seconds": 2.9,
      "text": "I mean, that's fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.16,
      "end_seconds": 321.54,
      "duration_seconds": 2.38,
      "text": "We'll catch up in six weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.49,
      "end_seconds": 324.19,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.44,
      "end_seconds": 329.72,
      "duration_seconds": 4.28,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.1,
      "end_seconds": 334.45,
      "duration_seconds": 3.35,
      "text": "Great, thank you for your help."
    }
  ]
}