{
  "schema_version": "1.0",
  "encounter_id": "03079",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.31,
      "duration_seconds": 5.07,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.29,
      "end_seconds": 12.89,
      "duration_seconds": 4.6,
      "text": "not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.45,
      "end_seconds": 19.67,
      "duration_seconds": 5.22,
      "text": "So, I've been coughing up large amounts of blood, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.37,
      "end_seconds": 21.97,
      "duration_seconds": 1.6,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.04,
      "end_seconds": 25.8,
      "duration_seconds": 2.76,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.76,
      "end_seconds": 29.36,
      "duration_seconds": 2.6,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.87,
      "end_seconds": 33.55,
      "duration_seconds": 2.68,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.15,
      "end_seconds": 37.79,
      "duration_seconds": 2.64,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.49,
      "end_seconds": 51.43,
      "duration_seconds": 1.94,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.36,
      "end_seconds": 80.72,
      "duration_seconds": 10.36,
      "text": "Okay: temperature 37.1, blood pressure 121 over 76, heart rate 88. And respiratory rate 25, SpO2 92 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.05,
      "end_seconds": 83.68,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.19,
      "end_seconds": 86.64,
      "duration_seconds": 2.45,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.34,
      "end_seconds": 91.69,
      "duration_seconds": 2.35,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.35,
      "end_seconds": 95.18,
      "duration_seconds": 1.83,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.16,
      "end_seconds": 119.46,
      "duration_seconds": 6.3,
      "text": "you are pale, breathing fast and bringing up fresh blood with every cough"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.48,
      "end_seconds": 124.32,
      "duration_seconds": 1.84,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.39,
      "end_seconds": 140.78,
      "duration_seconds": 2.39,
      "text": "Any sign of weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.18,
      "end_seconds": 145.06,
      "duration_seconds": 2.88,
      "text": "no, none, no weight loss"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.2,
      "end_seconds": 150.78,
      "duration_seconds": 4.58,
      "text": "let me check a few things. Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.72,
      "end_seconds": 157.9,
      "duration_seconds": 3.18,
      "text": "No, no chest pain or fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.69,
      "end_seconds": 161.69,
      "duration_seconds": 3.0,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.53,
      "end_seconds": 164.6,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.38,
      "end_seconds": 169.26,
      "duration_seconds": 2.88,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.94,
      "end_seconds": 174.87,
      "duration_seconds": 3.93,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.94,
      "end_seconds": 181.6,
      "duration_seconds": 5.66,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.96,
      "end_seconds": 186.58,
      "duration_seconds": 3.62,
      "text": "No, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.1,
      "end_seconds": 189.04,
      "duration_seconds": 0.94,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.11,
      "end_seconds": 194.4,
      "duration_seconds": 4.29,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.23,
      "end_seconds": 197.59,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.42,
      "end_seconds": 205.39,
      "duration_seconds": 2.97,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.27,
      "end_seconds": 208.25,
      "duration_seconds": 1.98,
      "text": "Alright, and your job?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.0,
      "end_seconds": 212.17,
      "duration_seconds": 3.17,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.97,
      "end_seconds": 223.31,
      "duration_seconds": 3.34,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.93,
      "end_seconds": 225.01,
      "duration_seconds": 1.08,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.95,
      "end_seconds": 234.98,
      "duration_seconds": 8.03,
      "text": "Do you have any medical conditions I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.43,
      "end_seconds": 242.12,
      "duration_seconds": 5.69,
      "text": "Let me think, you know, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.75,
      "end_seconds": 271.21,
      "duration_seconds": 10.46,
      "text": "putting it all together, I think we're dealing with life-threatening haemoptysis at this stage. I think an urgent CT scan makes sense here, for massive haemoptysis"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.81,
      "end_seconds": 273.95,
      "duration_seconds": 2.14,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.98,
      "end_seconds": 282.9,
      "duration_seconds": 7.92,
      "text": "I'd like you to take tranexamic acid, 1 gram, now, single dose. That should help with haemoptysis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.58,
      "end_seconds": 286.35,
      "duration_seconds": 1.77,
      "text": "okay, I understand"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.25,
      "end_seconds": 308.35,
      "duration_seconds": 21.1,
      "text": "lie on the bleeding side and I am calling the emergency team. I'd like you to see the emergency team as well, and I'll write the referral. Please don't wait if the symptoms get worse. That's when to be seen urgently. We'll catch up straight away"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.82,
      "end_seconds": 312.15,
      "duration_seconds": 2.33,
      "text": "good, I'll return then"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.22,
      "end_seconds": 320.96,
      "duration_seconds": 3.74,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.59,
      "end_seconds": 325.0,
      "duration_seconds": 3.41,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.8,
      "end_seconds": 327.98,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
}