{
  "schema_version": "1.0",
  "encounter_id": "03192",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.66,
      "duration_seconds": 2.68,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.49,
      "end_seconds": 6.61,
      "duration_seconds": 1.12,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.98,
      "end_seconds": 16.41,
      "duration_seconds": 8.43,
      "text": "Let me think, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.64,
      "end_seconds": 28.82,
      "duration_seconds": 7.18,
      "text": "Okay, please do. Extra information is always welcome. Alright, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.7,
      "end_seconds": 36.33,
      "duration_seconds": 6.63,
      "text": "Um, you know, so... fever and shivers. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.6,
      "end_seconds": 40.99,
      "duration_seconds": 3.39,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 46.38,
      "duration_seconds": 3.37,
      "text": "I've had it for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.37,
      "end_seconds": 56.24,
      "duration_seconds": 8.87,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.93,
      "end_seconds": 62.77,
      "duration_seconds": 5.84,
      "text": "Pretty moderate, if I'm being honest. Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.43,
      "end_seconds": 71.53,
      "duration_seconds": 8.1,
      "text": "And, And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.63,
      "end_seconds": 77.59,
      "duration_seconds": 5.96,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.49,
      "end_seconds": 82.04,
      "duration_seconds": 3.55,
      "text": "Um, I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 86.82,
      "duration_seconds": 2.71,
      "text": "Any cloudy smelly urine as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.28,
      "end_seconds": 92.3,
      "duration_seconds": 4.02,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.84,
      "end_seconds": 96.52,
      "duration_seconds": 3.68,
      "text": "Has there been pain in the lower tummy too?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.17,
      "end_seconds": 102.44,
      "duration_seconds": 5.27,
      "text": "Mm, yes. With pain in the lower tummy, mostly moderate."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.86,
      "end_seconds": 116.59,
      "duration_seconds": 3.73,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.98,
      "end_seconds": 125.07,
      "duration_seconds": 7.09,
      "text": "I've had epilepsy for two years now. Heart failure, for two years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.42,
      "end_seconds": 127.26,
      "duration_seconds": 0.84,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.2,
      "end_seconds": 132.99,
      "duration_seconds": 3.79,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.08,
      "end_seconds": 138.77,
      "duration_seconds": 2.69,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.67,
      "end_seconds": 143.07,
      "duration_seconds": 2.4,
      "text": "Right, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.61,
      "end_seconds": 148.36,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.25,
      "end_seconds": 152.48,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.56,
      "end_seconds": 157.71,
      "duration_seconds": 3.15,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.0,
      "end_seconds": 162.17,
      "duration_seconds": 3.17,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.14,
      "end_seconds": 169.1,
      "duration_seconds": 5.96,
      "text": "Sodium valproate. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 173.73,
      "end_seconds": 184.13,
      "duration_seconds": 10.4,
      "text": "Let me think, uh, she is supposed to take it twice a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.67,
      "end_seconds": 209.23,
      "duration_seconds": 19.56,
      "text": "It's a urinary catheter, in place. I've been putting this off for weeks. I'd rather know what's going on than keep guessing. I'd been on furosemide, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.69,
      "end_seconds": 215.49,
      "duration_seconds": 4.8,
      "text": "Let me check a few things. Any cough, vomiting or back pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.59,
      "end_seconds": 228.77,
      "duration_seconds": 12.18,
      "text": "Oh, no, no cough, no vomiting, no back pain. I did have confusion at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 232.12,
      "duration_seconds": 1.96,
      "text": "Did you notice any fall?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.17,
      "end_seconds": 236.83,
      "duration_seconds": 3.66,
      "text": "Not that I've noticed, no fall."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.75,
      "end_seconds": 241.66,
      "duration_seconds": 3.91,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.14,
      "end_seconds": 246.16,
      "duration_seconds": 3.02,
      "text": "Ah, no, all normal there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.09,
      "end_seconds": 248.79,
      "duration_seconds": 1.7,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.39,
      "end_seconds": 251.98,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.66,
      "end_seconds": 257.28,
      "duration_seconds": 3.62,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.89,
      "end_seconds": 267.65,
      "duration_seconds": 1.76,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.5,
      "end_seconds": 270.97,
      "duration_seconds": 1.47,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.94,
      "end_seconds": 286.77,
      "duration_seconds": 5.83,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.55,
      "end_seconds": 301.77,
      "duration_seconds": 11.22,
      "text": "You can relax now. Taking everything into account, the most likely explanation is a catheter-related urinary infection. I'd also keep urosepsis in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.82,
      "end_seconds": 305.96,
      "duration_seconds": 3.14,
      "text": "Is this serious, um, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 344.56,
      "duration_seconds": 37.15,
      "text": "I can't promise yet, but most people with a catheter-related urinary infection do well once it's treated properly. I'll request a urine culture, it'll help with possible urinary infection. I'd like to arrange blood tests for fever. I'd like you to take co-amoxiclav, 625 milligrams, three times a day, seven days. That's for catheter urinary infection. Change the catheter and drink plenty. Book a review in two days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.54,
      "end_seconds": 350.33,
      "duration_seconds": 3.79,
      "text": "Mm, great, thank you for your help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.03,
      "end_seconds": 353.89,
      "duration_seconds": 1.86,
      "text": "So, all the best."
    }
  ]
}