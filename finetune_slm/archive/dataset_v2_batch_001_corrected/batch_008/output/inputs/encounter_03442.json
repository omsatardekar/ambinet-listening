{
  "schema_version": "1.0",
  "encounter_id": "03442",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 6.0,
      "duration_seconds": 5.15,
      "text": "Erm, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.86,
      "end_seconds": 17.0,
      "duration_seconds": 5.14,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.91,
      "end_seconds": 26.3,
      "duration_seconds": 8.39,
      "text": "I, I wanted to get a pearly bump on my nose that bleeds looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.95,
      "end_seconds": 31.22,
      "duration_seconds": 4.27,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.48,
      "end_seconds": 36.71,
      "duration_seconds": 4.23,
      "text": "It's aspirin, 75 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.47,
      "end_seconds": 41.8,
      "duration_seconds": 4.33,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.24,
      "end_seconds": 56.72,
      "duration_seconds": 13.48,
      "text": "Mm, no, it's at home. I'm on Tiotropium inhaler, once a day for my chest. Before this I was on metoprolol; that's been stopped."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.46,
      "end_seconds": 60.18,
      "duration_seconds": 2.72,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.47,
      "end_seconds": 64.23,
      "duration_seconds": 2.76,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.88,
      "end_seconds": 67.09,
      "duration_seconds": 2.21,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.69,
      "end_seconds": 76.81,
      "duration_seconds": 8.12,
      "text": "Uh, yes, washing. That makes it worse. Oh, and a sore that won't heal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.6,
      "end_seconds": 81.66,
      "duration_seconds": 4.06,
      "text": "So, what about crusting, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.27,
      "end_seconds": 86.26,
      "duration_seconds": 3.99,
      "text": "Yeah, that too. With crusting, severe, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.58,
      "end_seconds": 94.7,
      "duration_seconds": 7.12,
      "text": "Any family history of skin cancer, pain, swollen glands or other new lumps at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.22,
      "end_seconds": 98.87,
      "duration_seconds": 2.65,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 102.78,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.22,
      "end_seconds": 108.72,
      "duration_seconds": 2.5,
      "text": "Oh, no problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.76,
      "end_seconds": 113.67,
      "duration_seconds": 3.91,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.04,
      "end_seconds": 116.6,
      "duration_seconds": 1.56,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.14,
      "end_seconds": 121.04,
      "duration_seconds": 3.9,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.04,
      "end_seconds": 127.24,
      "duration_seconds": 5.2,
      "text": "Let me think, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.38,
      "end_seconds": 148.7,
      "duration_seconds": 3.32,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.1,
      "end_seconds": 153.5,
      "duration_seconds": 3.4,
      "text": "Heart disease, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.1,
      "end_seconds": 156.49,
      "duration_seconds": 1.39,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.78,
      "end_seconds": 160.26,
      "duration_seconds": 2.48,
      "text": "COPD, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.22,
      "end_seconds": 166.23,
      "duration_seconds": 5.01,
      "text": "Alright, heart disease and COPD, that matches what I have here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.59,
      "end_seconds": 178.52,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.95,
      "end_seconds": 183.19,
      "duration_seconds": 3.24,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 186.23,
      "duration_seconds": 1.6,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.03,
      "end_seconds": 190.98,
      "duration_seconds": 3.95,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.79,
      "end_seconds": 212.83,
      "duration_seconds": 3.04,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.46,
      "end_seconds": 218.38,
      "duration_seconds": 3.92,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.31,
      "end_seconds": 223.26,
      "duration_seconds": 2.95,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.14,
      "end_seconds": 236.46,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 257.25,
      "duration_seconds": 6.31,
      "text": "Okay: saturation 99 percent, pulse 85, temp 36.6 degrees, BP is 115 over 78."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.2,
      "end_seconds": 260.82,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.93,
      "end_seconds": 264.38,
      "duration_seconds": 2.45,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 268.89,
      "duration_seconds": 2.34,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.98,
      "end_seconds": 272.72,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.25,
      "end_seconds": 276.73,
      "duration_seconds": 2.48,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.4,
      "end_seconds": 295.68,
      "duration_seconds": 8.28,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.88,
      "end_seconds": 310.3,
      "duration_seconds": 10.42,
      "text": "You can relax now. Okay, so my impression is this: My working impression is a likely basal cell carcinoma. A squamous cell carcinoma is still possible."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.99,
      "end_seconds": 312.97,
      "duration_seconds": 1.98,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.08,
      "end_seconds": 336.81,
      "duration_seconds": 22.73,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely basal cell carcinoma. Please use a high-factor sunscreen and a hat. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.62,
      "end_seconds": 341.69,
      "duration_seconds": 3.07,
      "text": "So, alright, thanks, take care."
    }
  ]
}