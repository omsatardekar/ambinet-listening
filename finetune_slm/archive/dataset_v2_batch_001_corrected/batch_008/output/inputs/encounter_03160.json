{
  "schema_version": "1.0",
  "encounter_id": "03160",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 4.07,
      "duration_seconds": 3.28,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.63,
      "end_seconds": 7.7,
      "duration_seconds": 3.07,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.28,
      "end_seconds": 9.66,
      "duration_seconds": 1.38,
      "text": "was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 17.2,
      "duration_seconds": 5.49,
      "text": "Not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.28,
      "end_seconds": 22.09,
      "duration_seconds": 2.81,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.93,
      "end_seconds": 29.09,
      "duration_seconds": 6.16,
      "text": "Erm, I wanted to get headaches most days looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.42,
      "end_seconds": 33.43,
      "duration_seconds": 3.01,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.02,
      "end_seconds": 39.47,
      "duration_seconds": 4.45,
      "text": "Since last Tuesday, that's when it it began."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.23,
      "end_seconds": 50.03,
      "duration_seconds": 8.8,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.75,
      "end_seconds": 64.14,
      "duration_seconds": 12.39,
      "text": "I get some relief from painkillers. It's every other day. Oh, and light sensitivity. That's been about the same, three days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.99,
      "end_seconds": 69.53,
      "duration_seconds": 3.54,
      "text": "Okay, have you had taking painkillers every day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.27,
      "end_seconds": 79.86,
      "duration_seconds": 9.59,
      "text": "I mean, yeah. Two days, I'd say. I was feeling sick at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.9,
      "end_seconds": 83.4,
      "duration_seconds": 2.5,
      "text": "Have you had any visual changes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 88.05,
      "duration_seconds": 3.89,
      "text": "Actually, I haven't noticed any visual changes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.8,
      "end_seconds": 93.87,
      "duration_seconds": 4.07,
      "text": "have you had any weakness, fever or stiff neck?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.87,
      "end_seconds": 97.88,
      "duration_seconds": 3.01,
      "text": "Actually, none of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.84,
      "end_seconds": 102.28,
      "duration_seconds": 2.44,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.46,
      "end_seconds": 105.18,
      "duration_seconds": 1.72,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.76,
      "end_seconds": 109.0,
      "duration_seconds": 2.24,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.25,
      "end_seconds": 130.37,
      "duration_seconds": 15.12,
      "text": "Sumatriptan, 50 milligrams, when needed for my migraines. Warfarin. I take it 3 milligrams, in the evening. I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 131.8,
      "end_seconds": 136.93,
      "duration_seconds": 5.13,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.41,
      "end_seconds": 142.34,
      "duration_seconds": 3.93,
      "text": "right do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.34,
      "end_seconds": 147.45,
      "duration_seconds": 4.11,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 170.1,
      "duration_seconds": 5.12,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.0,
      "end_seconds": 176.22,
      "duration_seconds": 4.22,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.83,
      "end_seconds": 181.31,
      "duration_seconds": 4.48,
      "text": "Right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.99,
      "end_seconds": 187.04,
      "duration_seconds": 5.05,
      "text": "My aunt has rheumatoid arthritis. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.16,
      "end_seconds": 192.41,
      "duration_seconds": 4.25,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.51,
      "end_seconds": 195.81,
      "duration_seconds": 2.3,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.85,
      "end_seconds": 197.69,
      "duration_seconds": 0.84,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.21,
      "end_seconds": 215.27,
      "duration_seconds": 16.06,
      "text": "An irregular heartbeat, for about a year. Let me think, I've had diabetes, yes. I looked a few things up online, and and that probably didn't help."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.09,
      "end_seconds": 229.18,
      "duration_seconds": 12.09,
      "text": "Yes, carry on. Right, so migraines and an irregular heartbeat are already on your record. We'll keep that in mind today. How are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.06,
      "end_seconds": 234.94,
      "duration_seconds": 4.88,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 239.12,
      "duration_seconds": 2.91,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.83,
      "end_seconds": 244.04,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.55,
      "end_seconds": 248.11,
      "duration_seconds": 2.56,
      "text": "okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.75,
      "end_seconds": 251.2,
      "duration_seconds": 2.45,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.62,
      "end_seconds": 264.72,
      "duration_seconds": 3.1,
      "text": "okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.25,
      "end_seconds": 273.3,
      "duration_seconds": 8.05,
      "text": "Hmm, you know, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 288.76,
      "end_seconds": 299.15,
      "duration_seconds": 10.39,
      "text": "okay, so the vitals from earlier. BP is 116 over 68, temp 36.4 degrees, oxygen saturation is 97 percent, respiratory rate 16, heart rate 69."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.21,
      "end_seconds": 302.91,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.02,
      "end_seconds": 308.09,
      "duration_seconds": 4.07,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.45,
      "end_seconds": 310.93,
      "duration_seconds": 1.48,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.6,
      "end_seconds": 329.89,
      "duration_seconds": 2.29,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.2,
      "end_seconds": 349.35,
      "duration_seconds": 17.15,
      "text": "Alright, you can sit up now. Putting it all together, my working impression is medication-overuse headache on a background of migraine. I want to be honest that this is an impression, not a final answer. Another possibility is tension-type headache."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.15,
      "end_seconds": 355.24,
      "duration_seconds": 4.09,
      "text": "actually, uh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.65,
      "end_seconds": 376.0,
      "duration_seconds": 14.35,
      "text": "nothing I've seen today points to an emergency it looks like medication-overuse headache on a background of migraine, but I'd like to confirm i think a headache diary makes sense here, for daily headache"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.26,
      "end_seconds": 379.52,
      "duration_seconds": 2.26,
      "text": "Right, you know, understood."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.99,
      "end_seconds": 413.0,
      "duration_seconds": 32.01,
      "text": "I'd like you to take amitriptyline, 10 milligrams, at night, long term. That's for headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.69,
      "end_seconds": 418.01,
      "duration_seconds": 4.32,
      "text": "Erm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.84,
      "end_seconds": 420.89,
      "duration_seconds": 2.05,
      "text": "Alright, all the best."
    }
  ]
}