{
  "schema_version": "1.0",
  "encounter_id": "03473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 8.19,
      "duration_seconds": 6.9,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.17,
      "end_seconds": 14.62,
      "duration_seconds": 5.45,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.34,
      "end_seconds": 24.59,
      "duration_seconds": 7.25,
      "text": "It's nausea after the chemotherapy. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.5,
      "end_seconds": 28.94,
      "duration_seconds": 3.44,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.49,
      "end_seconds": 45.39,
      "duration_seconds": 15.9,
      "text": "Probably about four days. Yeah. I'd rather not end up on lots of tablets if I can avoid it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.04,
      "end_seconds": 61.32,
      "duration_seconds": 14.28,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.28,
      "end_seconds": 68.83,
      "duration_seconds": 6.55,
      "text": "It's once or twice a day. A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.85,
      "end_seconds": 73.11,
      "duration_seconds": 3.26,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.61,
      "end_seconds": 78.72,
      "duration_seconds": 5.11,
      "text": "Being very tired goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.24,
      "end_seconds": 84.66,
      "duration_seconds": 4.42,
      "text": "So, what about numb fingertips, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 88.15,
      "duration_seconds": 2.49,
      "text": "Yeah. One week, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.74,
      "end_seconds": 94.46,
      "duration_seconds": 4.72,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.58,
      "end_seconds": 98.77,
      "duration_seconds": 3.19,
      "text": "Moderate, really. Rest helps a bit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.4,
      "end_seconds": 116.59,
      "duration_seconds": 2.19,
      "text": "Have you had any breathlessness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.17,
      "end_seconds": 121.58,
      "duration_seconds": 3.41,
      "text": "Uh, no, none, no breathlessness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.65,
      "end_seconds": 126.49,
      "duration_seconds": 2.84,
      "text": "Have you noticed fever, shivering or bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.27,
      "end_seconds": 131.14,
      "duration_seconds": 2.87,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.04,
      "end_seconds": 133.9,
      "duration_seconds": 1.86,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.9,
      "end_seconds": 137.88,
      "duration_seconds": 1.98,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.19,
      "end_seconds": 143.1,
      "duration_seconds": 3.91,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.22,
      "end_seconds": 148.18,
      "duration_seconds": 3.96,
      "text": "Sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.87,
      "end_seconds": 152.6,
      "duration_seconds": 2.73,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.59,
      "end_seconds": 157.53,
      "duration_seconds": 2.94,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.17,
      "end_seconds": 159.97,
      "duration_seconds": 1.8,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.79,
      "end_seconds": 163.43,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.29,
      "end_seconds": 166.52,
      "duration_seconds": 1.23,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.2,
      "end_seconds": 170.53,
      "duration_seconds": 3.33,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.95,
      "end_seconds": 173.93,
      "duration_seconds": 1.98,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.91,
      "end_seconds": 179.62,
      "duration_seconds": 3.71,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.54,
      "end_seconds": 183.6,
      "duration_seconds": 3.06,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.82,
      "end_seconds": 192.02,
      "duration_seconds": 5.2,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.7,
      "end_seconds": 195.45,
      "duration_seconds": 1.75,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.34,
      "end_seconds": 200.31,
      "duration_seconds": 3.97,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.36,
      "end_seconds": 206.81,
      "duration_seconds": 4.45,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.07,
      "end_seconds": 214.77,
      "duration_seconds": 2.7,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.1,
      "end_seconds": 221.69,
      "duration_seconds": 2.59,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.75,
      "end_seconds": 224.83,
      "duration_seconds": 1.08,
      "text": "Yes, migraines."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 226.93,
      "end_seconds": 236.6,
      "duration_seconds": 9.67,
      "text": "Here are the numbers, doctor. SpO2 97 percent on room air, temp 36.7 degrees. BP is 116 over 69, pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.01,
      "end_seconds": 239.94,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.85,
      "end_seconds": 245.09,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.97,
      "end_seconds": 248.22,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.26,
      "end_seconds": 266.09,
      "duration_seconds": 4.83,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.0,
      "end_seconds": 271.66,
      "duration_seconds": 2.66,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.28,
      "end_seconds": 298.92,
      "duration_seconds": 8.64,
      "text": "Taking everything into account, it fits best with expected chemotherapy side effects. I'd also keep an infection in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.63,
      "end_seconds": 317.54,
      "duration_seconds": 9.91,
      "text": "Call the chemotherapy helpline straight away if your temperature goes over 37.5. So, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.54,
      "end_seconds": 322.05,
      "duration_seconds": 3.51,
      "text": "Well, no, that's all. Thanks a lot."
    }
  ]
}