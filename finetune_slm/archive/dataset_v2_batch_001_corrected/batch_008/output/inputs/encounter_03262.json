{
  "schema_version": "1.0",
  "encounter_id": "03262",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.06,
      "duration_seconds": 2.92,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.98,
      "end_seconds": 10.51,
      "duration_seconds": 4.53,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.26,
      "end_seconds": 16.95,
      "duration_seconds": 4.69,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.95,
      "end_seconds": 21.75,
      "duration_seconds": 3.8,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.97,
      "end_seconds": 26.01,
      "duration_seconds": 3.04,
      "text": "She's been having been sweating, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 29.61,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.1,
      "end_seconds": 43.16,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.57,
      "end_seconds": 68.65,
      "duration_seconds": 11.08,
      "text": "Okay: temp 36.6 degrees, saturation 97 percent, respiratory rate 19, pulse is 108 beats a minute, BP is 127 over 71."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.6,
      "end_seconds": 73.15,
      "duration_seconds": 2.55,
      "text": "Mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.9,
      "end_seconds": 76.37,
      "duration_seconds": 2.47,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.21,
      "end_seconds": 89.14,
      "duration_seconds": 3.93,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.4,
      "end_seconds": 92.89,
      "duration_seconds": 2.49,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.11,
      "end_seconds": 93.81,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.31,
      "end_seconds": 101.7,
      "duration_seconds": 6.39,
      "text": "And I've been feeling anxious and agitated as well, for three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.33,
      "end_seconds": 106.73,
      "duration_seconds": 4.4,
      "text": "Have you noticed vomiting blood, seizure, confusion or seeing things?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.13,
      "end_seconds": 114.74,
      "duration_seconds": 5.61,
      "text": "Mm, no, no vomiting blood, seizure, confusion or seeing things."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.67,
      "end_seconds": 117.82,
      "duration_seconds": 2.15,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.95,
      "end_seconds": 120.92,
      "duration_seconds": 1.97,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.56,
      "end_seconds": 124.4,
      "duration_seconds": 2.84,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.49,
      "end_seconds": 130.16,
      "duration_seconds": 4.67,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.96,
      "end_seconds": 147.06,
      "duration_seconds": 8.1,
      "text": "Are there any allergies I should be aware of? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.01,
      "end_seconds": 150.39,
      "duration_seconds": 2.38,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.11,
      "end_seconds": 165.04,
      "duration_seconds": 3.93,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.78,
      "end_seconds": 178.62,
      "duration_seconds": 12.84,
      "text": "Seretide inhaler, twice a day for my asthma. Omeprazole. I take it 20 milligrams, once a day. Aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.92,
      "end_seconds": 186.44,
      "duration_seconds": 7.52,
      "text": "I see, go ahead. Right, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.17,
      "end_seconds": 191.59,
      "duration_seconds": 3.42,
      "text": "I've got asthma. I have acid reflux."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.56,
      "end_seconds": 194.0,
      "duration_seconds": 1.44,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.85,
      "end_seconds": 209.67,
      "duration_seconds": 11.82,
      "text": "Um, you know, I have heart disease. I'd rather know what's going on than keep guessing. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.91,
      "end_seconds": 214.73,
      "duration_seconds": 3.82,
      "text": "Alright, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.51,
      "end_seconds": 227.58,
      "duration_seconds": 12.07,
      "text": "Yes, I work in a bakery, early starts. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.92,
      "end_seconds": 233.98,
      "duration_seconds": 4.06,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.15,
      "end_seconds": 237.6,
      "duration_seconds": 2.45,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.81,
      "end_seconds": 251.81,
      "duration_seconds": 5.0,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.46,
      "end_seconds": 293.46,
      "duration_seconds": 37.0,
      "text": "That's all I needed to check. Putting it all together, this looks most like alcohol withdrawal. Let's get blood tests, for alcohol withdrawal. I'll start you on chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. That should help with alcohol withdrawal. What I'm giving you is thiamine, 100 milligrams, three times a day, long term. You take it by mouth. That should help with alcohol-related deficiency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.0,
      "end_seconds": 311.8,
      "duration_seconds": 14.8,
      "text": "Do not stop alcohol suddenly without medical support. I'd like you to see the alcohol liaison service as well, and I'll write the referral. I'd like you back in two days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.19,
      "end_seconds": 315.23,
      "duration_seconds": 2.04,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.77,
      "end_seconds": 318.19,
      "duration_seconds": 1.42,
      "text": "Take care now."
    }
  ]
}