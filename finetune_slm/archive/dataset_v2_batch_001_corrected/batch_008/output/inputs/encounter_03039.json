{
  "schema_version": "1.0",
  "encounter_id": "03039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.77,
      "duration_seconds": 3.78,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.43,
      "end_seconds": 13.95,
      "duration_seconds": 4.52,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.72,
      "end_seconds": 21.64,
      "duration_seconds": 6.92,
      "text": "Um, so... a high sugar test in pregnancy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.89,
      "end_seconds": 25.35,
      "duration_seconds": 2.46,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.17,
      "end_seconds": 31.47,
      "duration_seconds": 4.3,
      "text": "It's been going on for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 35.38,
      "duration_seconds": 3.01,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.79,
      "end_seconds": 42.25,
      "duration_seconds": 5.46,
      "text": "Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.7,
      "end_seconds": 53.56,
      "duration_seconds": 2.86,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.28,
      "end_seconds": 68.33,
      "duration_seconds": 2.05,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.38,
      "end_seconds": 83.56,
      "duration_seconds": 6.18,
      "text": "Okay: temperature 36.9, respiratory rate 16. And pulse 67, blood pressure 117 over 74."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.2,
      "end_seconds": 88.7,
      "duration_seconds": 2.5,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.79,
      "end_seconds": 91.77,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.64,
      "end_seconds": 95.12,
      "duration_seconds": 1.48,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.83,
      "end_seconds": 116.17,
      "duration_seconds": 5.34,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.49,
      "end_seconds": 120.68,
      "duration_seconds": 2.19,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.55,
      "end_seconds": 133.41,
      "duration_seconds": 4.86,
      "text": "A few quick ones: passing a lot of urine or blurred vision?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.24,
      "end_seconds": 140.72,
      "duration_seconds": 5.48,
      "text": "I haven't had passing a lot of urine or blurred vision, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.41,
      "end_seconds": 144.89,
      "duration_seconds": 3.48,
      "text": "Have you noticed reduced baby movements or thirst?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.94,
      "end_seconds": 149.39,
      "duration_seconds": 3.45,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.43,
      "end_seconds": 153.98,
      "duration_seconds": 3.55,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 156.53,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.51,
      "end_seconds": 177.37,
      "duration_seconds": 2.86,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.25,
      "end_seconds": 181.63,
      "duration_seconds": 2.38,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.53,
      "end_seconds": 185.66,
      "duration_seconds": 3.13,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.43,
      "end_seconds": 192.12,
      "duration_seconds": 4.69,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.08,
      "end_seconds": 196.73,
      "duration_seconds": 2.65,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.15,
      "end_seconds": 201.53,
      "duration_seconds": 3.38,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.33,
      "end_seconds": 205.45,
      "duration_seconds": 3.12,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.22,
      "end_seconds": 210.89,
      "duration_seconds": 4.67,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.48,
      "end_seconds": 217.34,
      "duration_seconds": 4.86,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.78,
      "end_seconds": 221.2,
      "duration_seconds": 2.42,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.33,
      "end_seconds": 226.72,
      "duration_seconds": 4.39,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.3,
      "end_seconds": 230.52,
      "duration_seconds": 2.22,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 237.83,
      "duration_seconds": 5.69,
      "text": "Taking everything into account, it fits best with gestational diabetes controllable with diet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.89,
      "end_seconds": 243.13,
      "duration_seconds": 4.24,
      "text": "Hmm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.9,
      "end_seconds": 254.88,
      "duration_seconds": 10.98,
      "text": "I understand the worry. At the moment I'd say it's gestational diabetes controllable with diet, and we'll know more once the a growth scan is back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.2,
      "end_seconds": 292.68,
      "duration_seconds": 26.48,
      "text": "A growth scan is what I'd like next, for gestational diabetes. I'd like to arrange a glucose meter and diary for gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals. Don't skip meals, and try to eat smaller portions more often through the day. Let's get you seen by the diabetes midwife, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.31,
      "end_seconds": 295.88,
      "duration_seconds": 1.57,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.42,
      "end_seconds": 311.82,
      "duration_seconds": 14.4,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.26,
      "end_seconds": 316.13,
      "duration_seconds": 2.87,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}