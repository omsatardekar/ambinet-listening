{
  "schema_version": "1.0",
  "encounter_id": "03448",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.68,
      "duration_seconds": 3.51,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.34,
      "end_seconds": 9.33,
      "duration_seconds": 3.99,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.84,
      "end_seconds": 16.86,
      "duration_seconds": 6.02,
      "text": "I've been feeling tired and weak, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.66,
      "end_seconds": 21.4,
      "duration_seconds": 3.74,
      "text": "Right, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.28,
      "end_seconds": 28.3,
      "duration_seconds": 3.02,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.71,
      "end_seconds": 32.63,
      "duration_seconds": 2.92,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.41,
      "end_seconds": 43.47,
      "duration_seconds": 10.06,
      "text": "When it starts I tend to get craving salt as well. The craving salt? That's been for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 50.09,
      "duration_seconds": 4.93,
      "text": "So, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.79,
      "end_seconds": 59.35,
      "duration_seconds": 4.56,
      "text": "I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.04,
      "end_seconds": 62.48,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.43,
      "end_seconds": 65.68,
      "duration_seconds": 1.25,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.34,
      "end_seconds": 86.3,
      "duration_seconds": 6.96,
      "text": "Right, what's on your current medicine list? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.57,
      "end_seconds": 92.8,
      "duration_seconds": 5.23,
      "text": "I'm on hydrochlorothiazide, 12.5 milligrams, every morning for my pressure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.02,
      "end_seconds": 98.79,
      "duration_seconds": 4.77,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.33,
      "end_seconds": 103.09,
      "duration_seconds": 2.76,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.43,
      "end_seconds": 122.29,
      "duration_seconds": 1.86,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.83,
      "end_seconds": 128.29,
      "duration_seconds": 4.46,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.08,
      "end_seconds": 130.42,
      "duration_seconds": 1.34,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 135.49,
      "duration_seconds": 3.58,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 138.71,
      "duration_seconds": 1.67,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.89,
      "end_seconds": 142.36,
      "duration_seconds": 2.47,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.78,
      "end_seconds": 162.49,
      "duration_seconds": 3.71,
      "text": "Have you noticed severe tummy pain, fever or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.53,
      "end_seconds": 167.39,
      "duration_seconds": 3.86,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.82,
      "end_seconds": 176.64,
      "duration_seconds": 3.82,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.45,
      "end_seconds": 179.82,
      "duration_seconds": 1.37,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.55,
      "end_seconds": 182.57,
      "duration_seconds": 2.02,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 194.81,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.82,
      "end_seconds": 218.3,
      "duration_seconds": 14.48,
      "text": "Okay: blood pressure 104 over 56, temperature is 36.4 degrees, pulse 108, SpO2 96 percent on room air, respiratory rate 20, weight 69 kilos, height 183 centimetres."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.01,
      "end_seconds": 225.06,
      "duration_seconds": 4.05,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.25,
      "end_seconds": 227.2,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.89,
      "end_seconds": 231.75,
      "duration_seconds": 2.86,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.34,
      "end_seconds": 259.77,
      "duration_seconds": 9.43,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.08,
      "end_seconds": 272.96,
      "duration_seconds": 7.88,
      "text": "Please sit back down. Let me tell you where I've got to. It fits best with possible adrenal insufficiency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.59,
      "end_seconds": 277.33,
      "duration_seconds": 2.74,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.02,
      "end_seconds": 290.04,
      "duration_seconds": 11.02,
      "text": "I understand the worry. At the moment I'd say it's possible adrenal insufficiency, and we'll know more once the a morning cortisol is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.63,
      "end_seconds": 326.43,
      "duration_seconds": 18.8,
      "text": "I'll request a morning cortisol, it'll help with possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. The endocrine clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.14,
      "end_seconds": 329.95,
      "duration_seconds": 2.81,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.23,
      "end_seconds": 334.6,
      "duration_seconds": 3.37,
      "text": "I'll want another look after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.81,
      "end_seconds": 337.46,
      "duration_seconds": 1.65,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.1,
      "end_seconds": 340.48,
      "duration_seconds": 2.38,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.7,
      "end_seconds": 344.67,
      "duration_seconds": 2.97,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}