{
  "schema_version": "1.0",
  "encounter_id": "03474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.11,
      "duration_seconds": 3.52,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.14,
      "end_seconds": 9.3,
      "duration_seconds": 4.16,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.1,
      "end_seconds": 15.98,
      "duration_seconds": 4.88,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.82,
      "end_seconds": 19.43,
      "duration_seconds": 2.61,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.64,
      "end_seconds": 26.36,
      "duration_seconds": 3.72,
      "text": "He's been having vomiting once or twice, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.85,
      "end_seconds": 31.1,
      "duration_seconds": 3.25,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.66,
      "end_seconds": 35.15,
      "duration_seconds": 2.49,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.08,
      "end_seconds": 41.26,
      "duration_seconds": 4.18,
      "text": "Uh, hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.84,
      "end_seconds": 45.91,
      "duration_seconds": 4.07,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.49,
      "end_seconds": 52.49,
      "duration_seconds": 2.0,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.77,
      "end_seconds": 55.49,
      "duration_seconds": 2.72,
      "text": "I follow. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.43,
      "end_seconds": 63.18,
      "duration_seconds": 4.75,
      "text": "Loose stools goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.25,
      "end_seconds": 67.54,
      "duration_seconds": 3.29,
      "text": "Has there been a mild tummy ache too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.05,
      "end_seconds": 81.54,
      "duration_seconds": 13.49,
      "text": "Yes, uh, for about four days. The loose stools? That's been since Monday. Hmm, with loose stools, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.57,
      "end_seconds": 87.22,
      "duration_seconds": 4.65,
      "text": "Right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.52,
      "end_seconds": 101.99,
      "duration_seconds": 2.47,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.38,
      "end_seconds": 125.66,
      "duration_seconds": 8.28,
      "text": "Okay: temperature 36.9, oxygen saturation is 98 percent, blood pressure 115 over 81. And respiratory rate 18, pulse 77."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.59,
      "end_seconds": 129.96,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.89,
      "end_seconds": 134.25,
      "duration_seconds": 3.36,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.33,
      "end_seconds": 139.98,
      "duration_seconds": 3.65,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.9,
      "end_seconds": 143.32,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.4,
      "end_seconds": 160.73,
      "duration_seconds": 5.33,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.37,
      "end_seconds": 165.95,
      "duration_seconds": 2.58,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.88,
      "end_seconds": 182.66,
      "duration_seconds": 2.78,
      "text": "Nothing like blood in the stool?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.5,
      "end_seconds": 189.26,
      "duration_seconds": 4.76,
      "text": "No, I haven't had any blood in the stool."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.78,
      "end_seconds": 195.23,
      "duration_seconds": 5.45,
      "text": "Mm, okay. And what about drowsiness, high fever or no wet nappies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.68,
      "end_seconds": 201.47,
      "duration_seconds": 4.79,
      "text": "No, no drowsiness, high fever or no wet nappies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.38,
      "end_seconds": 210.31,
      "duration_seconds": 3.93,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.26,
      "end_seconds": 213.62,
      "duration_seconds": 1.36,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 217.3,
      "duration_seconds": 1.98,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.46,
      "end_seconds": 222.27,
      "duration_seconds": 3.81,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.15,
      "end_seconds": 224.36,
      "duration_seconds": 1.21,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.71,
      "end_seconds": 229.19,
      "duration_seconds": 3.48,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.22,
      "end_seconds": 232.5,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.12,
      "end_seconds": 240.22,
      "duration_seconds": 6.1,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.83,
      "end_seconds": 244.62,
      "duration_seconds": 3.79,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 245.31,
      "end_seconds": 248.27,
      "duration_seconds": 2.96,
      "text": "It's clopidogrel, once a day, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.34,
      "end_seconds": 252.51,
      "duration_seconds": 2.17,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.31,
      "end_seconds": 262.74,
      "duration_seconds": 8.43,
      "text": "75 milligrams. He is on oral rehydration solution, after each loose stool, I give it to him."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.62,
      "end_seconds": 266.62,
      "duration_seconds": 2.0,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.37,
      "end_seconds": 272.56,
      "duration_seconds": 4.19,
      "text": "1 sachet, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.13,
      "end_seconds": 278.14,
      "duration_seconds": 4.01,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.25,
      "end_seconds": 286.07,
      "duration_seconds": 3.82,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.91,
      "end_seconds": 303.33,
      "duration_seconds": 3.42,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.34,
      "end_seconds": 307.11,
      "duration_seconds": 2.77,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.33,
      "end_seconds": 314.83,
      "duration_seconds": 6.5,
      "text": "So, based on the history and the examination, I'd lean towards a mild stomach bug."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.81,
      "end_seconds": 342.19,
      "duration_seconds": 17.38,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. Don't skip meals, and try to eat smaller portions more often through the day. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.03,
      "end_seconds": 347.78,
      "duration_seconds": 3.75,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}