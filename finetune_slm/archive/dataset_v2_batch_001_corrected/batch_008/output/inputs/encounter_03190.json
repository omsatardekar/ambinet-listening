{
  "schema_version": "1.0",
  "encounter_id": "03190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 6.04,
      "duration_seconds": 5.37,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 11.07,
      "duration_seconds": 3.73,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.58,
      "end_seconds": 19.4,
      "duration_seconds": 6.82,
      "text": "Sorry, what was I saying, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.66,
      "end_seconds": 25.95,
      "duration_seconds": 5.29,
      "text": "I'm here because of hearing getting worse in both ears."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.38,
      "end_seconds": 30.15,
      "duration_seconds": 2.77,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.32,
      "end_seconds": 39.3,
      "duration_seconds": 7.98,
      "text": "Ever since... since Monday, really. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.16,
      "end_seconds": 45.32,
      "duration_seconds": 4.16,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.49,
      "end_seconds": 54.92,
      "duration_seconds": 6.43,
      "text": "I'd say moderate. Let me think, I've also had ringing in the ears."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.86,
      "end_seconds": 61.15,
      "duration_seconds": 5.29,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.6,
      "end_seconds": 72.35,
      "duration_seconds": 9.75,
      "text": "It's on and off. I've had hearing better in a noisy room too, for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.26,
      "end_seconds": 88.1,
      "duration_seconds": 3.84,
      "text": "Right, any discharge, ear pain or facial weakness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.98,
      "end_seconds": 93.94,
      "duration_seconds": 3.96,
      "text": "no, no discharge, ear pain or facial weakness"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.14,
      "end_seconds": 97.73,
      "duration_seconds": 2.59,
      "text": "And vertigo, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.56,
      "end_seconds": 100.98,
      "duration_seconds": 1.42,
      "text": "Definitely no vertigo."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.6,
      "end_seconds": 106.09,
      "duration_seconds": 3.49,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.95,
      "end_seconds": 110.87,
      "duration_seconds": 2.92,
      "text": "Right, no, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.08,
      "end_seconds": 114.04,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.54,
      "end_seconds": 120.78,
      "duration_seconds": 5.24,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.89,
      "end_seconds": 123.61,
      "duration_seconds": 1.72,
      "text": "and and your job?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.7,
      "end_seconds": 128.43,
      "duration_seconds": 3.73,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.22,
      "end_seconds": 133.68,
      "duration_seconds": 4.46,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 134.41,
      "end_seconds": 142.22,
      "duration_seconds": 7.81,
      "text": "He takes alendronate, 70 milligrams, once a week. He takes naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.24,
      "end_seconds": 147.9,
      "duration_seconds": 3.66,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.54,
      "end_seconds": 150.41,
      "duration_seconds": 1.87,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.76,
      "end_seconds": 152.46,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.32,
      "end_seconds": 162.07,
      "duration_seconds": 7.75,
      "text": "I've got arthritis in my knees. I have an irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.8,
      "end_seconds": 173.62,
      "duration_seconds": 10.82,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.51,
      "end_seconds": 182.54,
      "duration_seconds": 5.03,
      "text": "My sister had breast cancer. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.74,
      "end_seconds": 196.6,
      "duration_seconds": 2.86,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.03,
      "end_seconds": 200.26,
      "duration_seconds": 2.23,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.81,
      "end_seconds": 206.08,
      "duration_seconds": 5.27,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.1,
      "end_seconds": 218.73,
      "duration_seconds": 10.63,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.27,
      "end_seconds": 223.79,
      "duration_seconds": 4.52,
      "text": "Let me get the readings out of the the way."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.8,
      "end_seconds": 239.1,
      "duration_seconds": 2.3,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.63,
      "end_seconds": 265.6,
      "duration_seconds": 7.97,
      "text": "Okay: temperature is 36.6 degrees, pulse 66, saturation 99 percent. And BP is 114 over 68."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.35,
      "end_seconds": 270.22,
      "duration_seconds": 2.87,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.36,
      "end_seconds": 273.97,
      "duration_seconds": 2.61,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.73,
      "end_seconds": 294.9,
      "duration_seconds": 7.17,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.23,
      "end_seconds": 314.47,
      "duration_seconds": 17.24,
      "text": "All finished, thank you. Putting it all together, this is probably a conductive hearing loss, possibly otosclerosis. The reason I say that is that your story and my examination fit together. It could also be wax, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.42,
      "end_seconds": 330.34,
      "duration_seconds": 7.92,
      "text": "A hearing aid or an operation are both options after the tests. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.7,
      "end_seconds": 334.88,
      "duration_seconds": 3.18,
      "text": "Um, thank you, that's helpful."
    }
  ]
}