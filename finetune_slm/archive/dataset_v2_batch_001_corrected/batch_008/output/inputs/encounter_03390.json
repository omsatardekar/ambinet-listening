{
  "schema_version": "1.0",
  "encounter_id": "03390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.64,
      "duration_seconds": 4.35,
      "text": "Hi doctor, uh, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 11.44,
      "duration_seconds": 4.44,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.55,
      "end_seconds": 22.25,
      "duration_seconds": 9.7,
      "text": "Sorry, what was I saying, doctor, it's pain in my breastbone wound. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.24,
      "end_seconds": 27.95,
      "duration_seconds": 1.71,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.82,
      "end_seconds": 33.51,
      "duration_seconds": 3.69,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.12,
      "end_seconds": 36.66,
      "duration_seconds": 2.54,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 53.8,
      "duration_seconds": 16.23,
      "text": "Mild, I'd say. Oh, and a clicking in the breastbone. That's been about the same, about a month. I've, I've also had tiredness, for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.05,
      "end_seconds": 73.99,
      "duration_seconds": 4.94,
      "text": "Have you noticed chest pain on exertion, breathlessness or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.06,
      "end_seconds": 78.27,
      "duration_seconds": 3.21,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.75,
      "end_seconds": 82.94,
      "duration_seconds": 4.19,
      "text": "Mm-hmm. Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.69,
      "end_seconds": 84.78,
      "duration_seconds": 1.09,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.81,
      "end_seconds": 89.3,
      "duration_seconds": 2.49,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.27,
      "end_seconds": 93.66,
      "duration_seconds": 2.39,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.62,
      "end_seconds": 100.38,
      "duration_seconds": 4.76,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.92,
      "end_seconds": 107.17,
      "duration_seconds": 6.25,
      "text": "I've had heart disease, yes. Yes, thin bones. I've got heart failure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.19,
      "end_seconds": 118.74,
      "duration_seconds": 8.55,
      "text": "Right, so heart disease is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.21,
      "end_seconds": 123.32,
      "duration_seconds": 3.11,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.25,
      "end_seconds": 139.12,
      "duration_seconds": 1.87,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.93,
      "end_seconds": 144.9,
      "duration_seconds": 1.97,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.26,
      "end_seconds": 147.49,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.82,
      "end_seconds": 153.21,
      "duration_seconds": 4.39,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.09,
      "end_seconds": 157.39,
      "duration_seconds": 1.3,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.11,
      "end_seconds": 161.39,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.12,
      "end_seconds": 167.06,
      "duration_seconds": 3.94,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.0,
      "end_seconds": 172.67,
      "duration_seconds": 3.67,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 177.28,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.76,
      "end_seconds": 187.22,
      "duration_seconds": 8.46,
      "text": "Aspirin, 75 milligrams, once a day. Yeah, I'm on alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.81,
      "end_seconds": 191.06,
      "duration_seconds": 2.25,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.72,
      "end_seconds": 202.15,
      "duration_seconds": 9.43,
      "text": "70 milligrams, I think that's what's on the box. Oh, I'm on spironolactone, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 205.88,
      "duration_seconds": 2.21,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.41,
      "end_seconds": 210.45,
      "duration_seconds": 1.04,
      "text": "25 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.34,
      "end_seconds": 214.52,
      "duration_seconds": 3.18,
      "text": "Okay, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.99,
      "end_seconds": 218.18,
      "duration_seconds": 2.19,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.45,
      "end_seconds": 223.36,
      "duration_seconds": 3.91,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.38,
      "end_seconds": 233.1,
      "duration_seconds": 3.72,
      "text": "So, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 242.48,
      "end_seconds": 251.8,
      "duration_seconds": 9.32,
      "text": "Here are the numbers, doctor. Pulse is 68 beats a minute, saturation 99 percent, pressure 124 over 74, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.84,
      "end_seconds": 254.78,
      "duration_seconds": 1.94,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 260.9,
      "duration_seconds": 3.42,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.49,
      "end_seconds": 262.71,
      "duration_seconds": 1.22,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.67,
      "end_seconds": 267.86,
      "duration_seconds": 3.19,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.72,
      "end_seconds": 294.31,
      "duration_seconds": 8.59,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.18,
      "end_seconds": 317.96,
      "duration_seconds": 17.78,
      "text": "Please sit back down. Putting it all together, I'd lean towards recovering well after bypass surgery. The reason I say that is that your story and my examination fit together. It could also be a leg wound infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 320.05,
      "end_seconds": 326.25,
      "duration_seconds": 6.2,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.24,
      "end_seconds": 351.76,
      "duration_seconds": 24.52,
      "text": "Right, thank you. I'm sending you for blood tests because of post-operative review. Walk daily, no heavy lifting for six weeks and no driving until you are cleared. I think the cardiac rehabilitation team should see you too. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.59,
      "end_seconds": 356.02,
      "duration_seconds": 3.43,
      "text": "Um, alright, I'll be back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.27,
      "end_seconds": 362.62,
      "duration_seconds": 5.35,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.71,
      "end_seconds": 374.75,
      "duration_seconds": 7.04,
      "text": "So, you know, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.07,
      "end_seconds": 380.45,
      "duration_seconds": 4.38,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.1,
      "end_seconds": 383.57,
      "duration_seconds": 2.47,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.21,
      "end_seconds": 385.49,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}