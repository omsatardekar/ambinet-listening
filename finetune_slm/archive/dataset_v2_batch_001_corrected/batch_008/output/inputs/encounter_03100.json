      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.67,
      "end_seconds": 288.89,
      "duration_seconds": 5.22,
      "text": "replace sugary drinks and white starches with wholegrains and walk after meals"
    },
