  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 3.94,
      "duration_seconds": 2.99,
      "text": "hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 10.15,
      "duration_seconds": 4.93,
      "text": "Of course leave it it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 20.0,
      "duration_seconds": 8.06,
      "text": "I've been coughing up large amounts of blood i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 24.23,
      "duration_seconds": 2.58,
      "text": "right, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.06,
      "end_seconds": 38.47,
      "duration_seconds": 12.41,
      "text": "I've had it for four weeks. I told myself I'd wait and see, and here I am. And a gurgling chest as well, since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 39.97,
      "duration_seconds": 0.91,
      "text": "hm okay"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.51,
      "end_seconds": 47.62,
      "duration_seconds": 6.11,
      "text": "I've also had breathlessness. I've been feeling faint too, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.33,
      "end_seconds": 54.86,
      "duration_seconds": 5.53,
      "text": "Have you been coughing up large amounts of blood at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.58,
      "end_seconds": 61.62,
      "duration_seconds": 6.04,
      "text": "I had a similar thing about six months ago. It It went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.77,
      "end_seconds": 67.65,
      "duration_seconds": 4.88,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.07,
      "end_seconds": 80.66,
      "duration_seconds": 11.59,
      "text": "I swim twice a week. I retired from the post office two years ago. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.28,
      "end_seconds": 85.34,
      "duration_seconds": 3.06,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.73,
      "end_seconds": 92.2,
      "duration_seconds": 5.47,
      "text": "I've got thin bones i have diabetes, for about ten years"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.54,
      "end_seconds": 94.5,
      "duration_seconds": 0.96,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.19,
      "end_seconds": 99.31,
      "duration_seconds": 3.12,
      "text": "High blood pressure, for two years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.06,
      "end_seconds": 104.36,
      "duration_seconds": 1.3,
      "text": "okay, what else?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.16,
      "end_seconds": 107.71,
      "duration_seconds": 2.55,
      "text": "Gout, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.79,
      "end_seconds": 109.98,
      "duration_seconds": 1.19,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.08,
      "end_seconds": 116.43,
      "duration_seconds": 5.35,
      "text": "alright thin bones and diabetes that matches what I have here"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.5,
      "end_seconds": 133.63,
      "duration_seconds": 4.13,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.7,
      "end_seconds": 140.55,
      "duration_seconds": 5.85,
      "text": "I take metformin 500 milligrams twice a day i'm on ramipril every morning"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.61,
      "end_seconds": 144.86,
      "duration_seconds": 2.25,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.23,
      "end_seconds": 155.42,
      "duration_seconds": 9.19,
      "text": "5 milligrams. It's allopurinol, 100 milligrams, once a day. Before this I was on valsartan; that's been stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.33,
      "end_seconds": 163.36,
      "duration_seconds": 7.03,
      "text": "do you react to any medicines or foods? Any allergies? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.08,
      "end_seconds": 177.33,
      "duration_seconds": 12.25,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.11,
      "end_seconds": 181.42,
      "duration_seconds": 3.31,
      "text": "any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.4,
      "end_seconds": 189.61,
      "duration_seconds": 6.21,
      "text": "I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 206.04,
      "duration_seconds": 1.74,
      "text": "Any sign of fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.7,
      "end_seconds": 208.44,
      "duration_seconds": 1.74,
      "text": "no fever, thankfully"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.91,
      "end_seconds": 214.01,
      "duration_seconds": 4.1,
      "text": "Have you had any chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.02,
      "end_seconds": 217.14,
      "duration_seconds": 2.12,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.65,
      "end_seconds": 222.09,
      "duration_seconds": 3.44,
      "text": "so, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.78,
      "end_seconds": 227.73,
      "duration_seconds": 4.95,
      "text": "My heart's been fine as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.23,
      "end_seconds": 231.69,
      "duration_seconds": 2.46,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.29,
      "end_seconds": 233.98,
      "duration_seconds": 1.69,
      "text": "nothing unusual no"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.47,
      "end_seconds": 261.92,
      "duration_seconds": 10.45,
      "text": "so, based on your history, it's hard to say. Life-threatening haemoptysis is one possibility and a lung tumour another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.91,
      "end_seconds": 266.87,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.91,
      "end_seconds": 283.16,
      "duration_seconds": 14.25,
      "text": "I understand the worry. At the moment I'd say it's life-threatening haemoptysis, and we'll know more once the an urgent CT scan is back. We should do an urgent CT scan for massive haemoptysis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.9,
      "end_seconds": 286.49,
      "duration_seconds": 1.59,
      "text": "does it hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.32,
      "end_seconds": 319.34,
      "duration_seconds": 32.02,
      "text": "I'm sending you for urgent blood tests because of bleeding let's use tranexamic acid, 1 gram, now, single dose it's for haemoptysis lie on the bleeding side and I am calling the emergency team try to get to bed and wake up at the same time each day, and keep your phone away from the bed the emergency team would be the right next step, I'll refer you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.65,
      "end_seconds": 328.23,
      "duration_seconds": 7.58,
      "text": "the thing that would worry me is if the symptoms get worse. If that happens, go to emergency"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.33,
      "end_seconds": 332.15,
      "duration_seconds": 1.82,
      "text": "Thank you that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.47,
      "end_seconds": 340.2,
      "duration_seconds": 6.73,
      "text": "please come and see me straight away i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.23,
      "end_seconds": 346.35,
      "duration_seconds": 4.12,
      "text": "okay, that that makes sense thanks for explaining"
    }
  ]
