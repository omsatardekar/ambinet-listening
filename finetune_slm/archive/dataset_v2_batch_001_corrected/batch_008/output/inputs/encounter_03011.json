{
  "schema_version": "1.0",
  "encounter_id": "03011",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 3.42,
      "duration_seconds": 2.86,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.48,
      "end_seconds": 8.57,
      "duration_seconds": 3.09,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.51,
      "end_seconds": 13.91,
      "duration_seconds": 4.4,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.84,
      "end_seconds": 16.54,
      "duration_seconds": 1.7,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.36,
      "end_seconds": 21.37,
      "duration_seconds": 4.01,
      "text": "She's been having pain spreading all over, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.39,
      "end_seconds": 24.75,
      "duration_seconds": 2.36,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.71,
      "end_seconds": 32.11,
      "duration_seconds": 6.4,
      "text": "She is on Foracort inhaler, twice a day, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.56,
      "end_seconds": 33.26,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.04,
      "end_seconds": 43.63,
      "duration_seconds": 5.59,
      "text": "I had Seretide inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.02,
      "end_seconds": 61.06,
      "duration_seconds": 3.04,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.7,
      "end_seconds": 72.97,
      "duration_seconds": 10.27,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.41,
      "end_seconds": 77.39,
      "duration_seconds": 3.98,
      "text": "Hm, okay. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.64,
      "end_seconds": 80.17,
      "duration_seconds": 1.53,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.57,
      "end_seconds": 84.11,
      "duration_seconds": 3.54,
      "text": "Mm, okay. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.22,
      "end_seconds": 98.02,
      "duration_seconds": 12.8,
      "text": "Shoulder tip pain goes along with it, most of the time. About shoulder tip pain, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.54,
      "end_seconds": 103.2,
      "duration_seconds": 3.66,
      "text": "And what about diarrhoea or blood in the vomit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.59,
      "end_seconds": 106.96,
      "duration_seconds": 2.37,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.09,
      "end_seconds": 110.13,
      "duration_seconds": 2.04,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.83,
      "end_seconds": 116.25,
      "duration_seconds": 1.42,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.47,
      "end_seconds": 119.96,
      "duration_seconds": 3.49,
      "text": "Sure. Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.86,
      "end_seconds": 123.26,
      "duration_seconds": 1.4,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.27,
      "end_seconds": 128.14,
      "duration_seconds": 2.87,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.24,
      "end_seconds": 131.88,
      "duration_seconds": 2.64,
      "text": "Asthma, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 140.27,
      "duration_seconds": 6.74,
      "text": "Okay, I can see asthma in your file as well. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.61,
      "end_seconds": 145.0,
      "duration_seconds": 3.39,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.42,
      "end_seconds": 149.32,
      "duration_seconds": 2.9,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.29,
      "end_seconds": 154.51,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.31,
      "end_seconds": 157.41,
      "duration_seconds": 2.1,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.99,
      "end_seconds": 162.05,
      "duration_seconds": 4.06,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.37,
      "end_seconds": 169.28,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.93,
      "end_seconds": 173.69,
      "duration_seconds": 2.76,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.54,
      "end_seconds": 187.86,
      "duration_seconds": 5.32,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.74,
      "end_seconds": 191.84,
      "duration_seconds": 3.1,
      "text": "Yes, tramadol, it gives me vomiting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.86,
      "end_seconds": 195.82,
      "duration_seconds": 2.96,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.91,
      "end_seconds": 207.24,
      "duration_seconds": 2.33,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.85,
      "end_seconds": 234.9,
      "duration_seconds": 6.05,
      "text": "Okay: BP is 114 over 78, pulse 119, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.28,
      "end_seconds": 241.56,
      "duration_seconds": 4.28,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.5,
      "end_seconds": 243.77,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.7,
      "end_seconds": 268.43,
      "duration_seconds": 6.73,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.15,
      "end_seconds": 274.61,
      "duration_seconds": 2.46,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.73,
      "end_seconds": 299.62,
      "duration_seconds": 7.89,
      "text": "Okay, thinking it through, this looks most like a perforated stomach ulcer. We shouldn't forget pancreatitis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.89,
      "end_seconds": 304.19,
      "duration_seconds": 3.3,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.2,
      "end_seconds": 320.88,
      "duration_seconds": 15.68,
      "text": "I understand the worry. At the moment I'd say it's a perforated stomach ulcer, and we'll know more once the urgent blood tests is back. We should do urgent blood tests for acute abdomen."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.79,
      "end_seconds": 322.96,
      "duration_seconds": 1.17,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.9,
      "end_seconds": 345.94,
      "duration_seconds": 22.04,
      "text": "Nothing to eat or drink, you need an operation urgently. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you to see the surgical team as well, and I'll write the referral. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.76,
      "end_seconds": 352.19,
      "duration_seconds": 4.43,
      "text": "No, um, that's all. Thanks a lot."
    }
  ]
}