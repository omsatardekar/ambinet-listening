{
  "schema_version": "1.0",
  "encounter_id": "03335",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 4.36,
      "duration_seconds": 3.44,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.37,
      "end_seconds": 10.12,
      "duration_seconds": 3.75,
      "text": "Okay, so good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.95,
      "end_seconds": 14.44,
      "duration_seconds": 2.49,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.04,
      "end_seconds": 19.63,
      "duration_seconds": 4.59,
      "text": "I wanted to get severe back pain looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 24.43,
      "duration_seconds": 3.33,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.35,
      "end_seconds": 28.33,
      "duration_seconds": 1.98,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.61,
      "end_seconds": 32.8,
      "duration_seconds": 3.19,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.23,
      "end_seconds": 39.71,
      "duration_seconds": 5.48,
      "text": "I'd say mild. I've also had a fever, for two days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.06,
      "end_seconds": 49.19,
      "duration_seconds": 6.13,
      "text": "Have you had severe back pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.78,
      "end_seconds": 55.85,
      "duration_seconds": 5.07,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.41,
      "end_seconds": 64.06,
      "duration_seconds": 4.65,
      "text": "Did you get chest pain, recent fall or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.8,
      "end_seconds": 68.55,
      "duration_seconds": 2.75,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.77,
      "end_seconds": 71.74,
      "duration_seconds": 1.97,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.84,
      "end_seconds": 77.35,
      "duration_seconds": 3.51,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.46,
      "end_seconds": 83.54,
      "duration_seconds": 4.08,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.6,
      "end_seconds": 87.23,
      "duration_seconds": 1.63,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.76,
      "end_seconds": 98.09,
      "duration_seconds": 9.33,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.98,
      "end_seconds": 105.16,
      "duration_seconds": 6.18,
      "text": "Metformin. I take it 500 milligrams, twice a day. It's injecting drugs, recent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.98,
      "end_seconds": 115.88,
      "duration_seconds": 1.9,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.08,
      "end_seconds": 121.15,
      "duration_seconds": 4.07,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 124.5,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.17,
      "end_seconds": 130.88,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.89,
      "end_seconds": 135.71,
      "duration_seconds": 2.82,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.17,
      "end_seconds": 143.14,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 155.7,
      "duration_seconds": 4.94,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.9,
      "end_seconds": 159.92,
      "duration_seconds": 3.02,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 163.47,
      "duration_seconds": 2.97,
      "text": "So, any surgery in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.77,
      "end_seconds": 169.87,
      "duration_seconds": 5.1,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.94,
      "end_seconds": 176.85,
      "duration_seconds": 2.91,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.42,
      "end_seconds": 187.68,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.36,
      "end_seconds": 208.73,
      "duration_seconds": 7.37,
      "text": "Okay: temperature is 38.2 degrees, pressure 107 over 72, oxygen saturation is 95 percent. And pulse 88."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.28,
      "end_seconds": 212.67,
      "duration_seconds": 2.39,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 217.14,
      "duration_seconds": 2.82,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.62,
      "end_seconds": 237.52,
      "duration_seconds": 5.9,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.71,
      "end_seconds": 239.79,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.46,
      "end_seconds": 265.89,
      "duration_seconds": 22.43,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. I think we're dealing with a possible spinal infection pressing on the nerves at this stage. The reason I say that is that your story and my examination fit together. We shouldn't forget a slipped disc."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.95,
      "end_seconds": 269.48,
      "duration_seconds": 1.53,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.15,
      "end_seconds": 284.75,
      "duration_seconds": 14.6,
      "text": "I understand the worry. At the moment I'd say it's a possible spinal infection pressing on the nerves, and we'll know more once the an urgent MRI of the spine is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.07,
      "end_seconds": 320.73,
      "duration_seconds": 27.66,
      "text": "I'd like to arrange an urgent MRI of the spine for possible epidural abscess. I'll request urgent blood tests, it'll help with possible spinal infection. You are going to hospital now, this can cause permanent weakness. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'm going to send a referral to the spinal team."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.0,
      "end_seconds": 322.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.27,
      "end_seconds": 340.23,
      "duration_seconds": 15.96,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.2,
      "end_seconds": 345.3,
      "duration_seconds": 3.1,
      "text": "Mm, thank you, doctor, goodbye."
    }
  ]
}