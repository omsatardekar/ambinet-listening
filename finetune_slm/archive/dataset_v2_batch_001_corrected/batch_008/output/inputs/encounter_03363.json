{
  "schema_version": "1.0",
  "encounter_id": "03363",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.01,
      "end_seconds": 6.05,
      "duration_seconds": 5.04,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 12.24,
      "duration_seconds": 4.25,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.2,
      "end_seconds": 20.17,
      "duration_seconds": 5.97,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.25,
      "end_seconds": 30.7,
      "duration_seconds": 5.45,
      "text": "erm, doctor, it's darker skin it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 32.17,
      "end_seconds": 45.72,
      "duration_seconds": 13.55,
      "text": "okay, so the vitals from earlier blood pressure 99 over 58, temperature is 36.5 degrees, BMI works out to 28.7. Saturation 99 percent, height 175 centimetres, heart rate 103, weight 88 kilos"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.06,
      "end_seconds": 53.94,
      "duration_seconds": 4.88,
      "text": "Good, thank you. How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.19,
      "end_seconds": 57.86,
      "duration_seconds": 2.67,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.62,
      "end_seconds": 62.43,
      "duration_seconds": 2.81,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.15,
      "end_seconds": 65.82,
      "duration_seconds": 2.67,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.05,
      "end_seconds": 67.03,
      "duration_seconds": 0.98,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.48,
      "end_seconds": 74.7,
      "duration_seconds": 7.22,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 74.8,
      "end_seconds": 79.76,
      "duration_seconds": 4.96,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.26,
      "end_seconds": 85.1,
      "duration_seconds": 2.84,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.62,
      "end_seconds": 89.75,
      "duration_seconds": 4.13,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.37,
      "end_seconds": 96.14,
      "duration_seconds": 5.77,
      "text": "Oh, and craving salt. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_6",
      "role": "UNKNOWN",
      "start_seconds": 96.71,
      "end_seconds": 99.03,
      "duration_seconds": 2.32,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.67,
      "end_seconds": 104.6,
      "duration_seconds": 4.93,
      "text": "Right, have you had any fever or severe tummy pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.35,
      "end_seconds": 117.7,
      "duration_seconds": 11.35,
      "text": "No, no fever, no severe tummy pain. I was feeling tired and weak at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.13,
      "end_seconds": 121.55,
      "duration_seconds": 2.42,
      "text": "And fainting, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.45,
      "end_seconds": 125.09,
      "duration_seconds": 1.64,
      "text": "Definitely no fainting."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.13,
      "end_seconds": 128.31,
      "duration_seconds": 2.18,
      "text": "has there been any vomiting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.85,
      "end_seconds": 132.82,
      "duration_seconds": 2.97,
      "text": "No, I haven't had any vomiting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 134.36,
      "end_seconds": 141.2,
      "duration_seconds": 6.84,
      "text": "actually, you know, doctor, I did notice vomiting. He doesn't always say"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.1,
      "end_seconds": 149.71,
      "duration_seconds": 6.61,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.28,
      "end_seconds": 158.0,
      "duration_seconds": 7.72,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.15,
      "end_seconds": 162.55,
      "duration_seconds": 1.4,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.09,
      "end_seconds": 165.51,
      "duration_seconds": 2.42,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.2,
      "end_seconds": 169.59,
      "duration_seconds": 2.39,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.84,
      "end_seconds": 181.38,
      "duration_seconds": 2.54,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.42,
      "end_seconds": 190.01,
      "duration_seconds": 6.59,
      "text": "I've got migraines. I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.91,
      "end_seconds": 191.61,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.47,
      "end_seconds": 195.84,
      "duration_seconds": 3.37,
      "text": "I have eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.38,
      "end_seconds": 207.59,
      "duration_seconds": 11.21,
      "text": "Mm, okay. Okay, I can see migraines and high blood pressure in your file as well. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.61,
      "end_seconds": 215.94,
      "duration_seconds": 7.33,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.52,
      "end_seconds": 219.99,
      "duration_seconds": 2.47,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.45,
      "end_seconds": 236.32,
      "duration_seconds": 14.87,
      "text": "For my migraines, I believe. My husband sets them out for me, I just take what I'm given. I'm on valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 239.01,
      "duration_seconds": 1.29,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.03,
      "end_seconds": 245.67,
      "duration_seconds": 5.64,
      "text": "About nearly five years. I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.31,
      "end_seconds": 250.73,
      "duration_seconds": 3.42,
      "text": "right, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.5,
      "end_seconds": 253.66,
      "duration_seconds": 2.16,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.66,
      "end_seconds": 263.94,
      "duration_seconds": 5.28,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.81,
      "end_seconds": 279.13,
      "duration_seconds": 13.32,
      "text": "Nothing, I'm teetotal. I quit smoking around ten years ago. I work in accounts at a hospital. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.09,
      "end_seconds": 283.78,
      "duration_seconds": 3.69,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.33,
      "end_seconds": 288.06,
      "duration_seconds": 2.73,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.66,
      "end_seconds": 292.86,
      "duration_seconds": 3.2,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.93,
      "end_seconds": 301.24,
      "duration_seconds": 6.31,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.49,
      "end_seconds": 309.55,
      "duration_seconds": 7.06,
      "text": "Let me ask about allergies, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.93,
      "end_seconds": 312.57,
      "duration_seconds": 1.64,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.34,
      "end_seconds": 319.53,
      "duration_seconds": 4.19,
      "text": "Okay, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.5,
      "end_seconds": 323.67,
      "duration_seconds": 2.17,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.58,
      "end_seconds": 342.18,
      "duration_seconds": 9.6,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.27,
      "end_seconds": 349.32,
      "duration_seconds": 3.05,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.23,
      "end_seconds": 375.89,
      "duration_seconds": 7.66,
      "text": "taking everything into account, I'd lean towards possible adrenal insufficiency we shouldn't forget an underactive thyroid"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 377.68,
      "end_seconds": 380.39,
      "duration_seconds": 2.71,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.98,
      "end_seconds": 398.6,
      "duration_seconds": 16.62,
      "text": "It's reasonable to be concerned, but right now possible adrenal insufficiency is my leading thought, not anything worse. Let me repeat that back to make sure. You've had darker skin for three weeks, severe, and no severe tummy pain."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 399.98,
      "end_seconds": 400.68,
      "duration_seconds": 0.7,
      "text": "exactly"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.26,
      "end_seconds": 409.58,
      "duration_seconds": 8.32,
      "text": "let's book blood tests to look into possible adrenal insufficiency. I'll request a morning cortisol, it'll help with possible adrenal insufficiency"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.08,
      "end_seconds": 413.54,
      "duration_seconds": 2.46,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.44,
      "end_seconds": 428.11,
      "duration_seconds": 12.67,
      "text": "I think a short synacthen test makes sense here, for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.38,
      "end_seconds": 436.26,
      "duration_seconds": 7.88,
      "text": "Ah. I'd like you to see the endocrine clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 437.16,
      "end_seconds": 437.86,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.47,
      "end_seconds": 442.79,
      "duration_seconds": 3.32,
      "text": "book a a review after the results"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 446.21,
      "end_seconds": 446.91,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.38,
      "end_seconds": 451.21,
      "duration_seconds": 2.83,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 452.92,
      "end_seconds": 456.15,
      "duration_seconds": 3.23,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.25,
      "end_seconds": 458.42,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}