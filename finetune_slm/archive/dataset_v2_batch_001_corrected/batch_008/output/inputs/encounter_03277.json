{
  "schema_version": "1.0",
  "encounter_id": "03277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.31,
      "duration_seconds": 3.05,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.86,
      "end_seconds": 9.0,
      "duration_seconds": 4.14,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.97,
      "end_seconds": 14.97,
      "duration_seconds": 4.0,
      "text": "I've been coughing up large amounts of blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.37,
      "end_seconds": 17.59,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.42,
      "end_seconds": 22.43,
      "duration_seconds": 3.01,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.69,
      "end_seconds": 26.27,
      "duration_seconds": 2.58,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 30.45,
      "duration_seconds": 2.22,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.16,
      "end_seconds": 35.86,
      "duration_seconds": 4.7,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.11,
      "end_seconds": 44.92,
      "duration_seconds": 7.81,
      "text": "I was told I'm allergic to plasters, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.03,
      "end_seconds": 53.55,
      "duration_seconds": 3.52,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.52,
      "end_seconds": 61.0,
      "duration_seconds": 5.48,
      "text": "I'm on escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.89,
      "end_seconds": 66.42,
      "duration_seconds": 2.53,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.27,
      "end_seconds": 74.99,
      "duration_seconds": 6.72,
      "text": "I have depression. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.09,
      "end_seconds": 76.99,
      "duration_seconds": 0.9,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.26,
      "end_seconds": 99.04,
      "duration_seconds": 3.78,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.55,
      "end_seconds": 102.89,
      "duration_seconds": 2.34,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.47,
      "end_seconds": 124.24,
      "duration_seconds": 4.77,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.06,
      "end_seconds": 141.85,
      "duration_seconds": 13.79,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.98,
      "end_seconds": 164.92,
      "duration_seconds": 4.94,
      "text": "So, have you had any fever, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.65,
      "end_seconds": 171.93,
      "duration_seconds": 6.28,
      "text": "Uh, I haven't had fever, chest pain or weight loss, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.96,
      "end_seconds": 175.42,
      "duration_seconds": 2.46,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.06,
      "end_seconds": 178.7,
      "duration_seconds": 1.64,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.95,
      "end_seconds": 182.41,
      "duration_seconds": 2.46,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.11,
      "end_seconds": 199.13,
      "duration_seconds": 3.02,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.6,
      "end_seconds": 217.76,
      "duration_seconds": 6.16,
      "text": "Okay: respiratory rate 24, pulse 102, blood pressure 135 over 77. And saturation 91 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.02,
      "end_seconds": 223.71,
      "duration_seconds": 3.69,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.03,
      "end_seconds": 228.57,
      "duration_seconds": 1.54,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.22,
      "end_seconds": 232.01,
      "duration_seconds": 1.79,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.59,
      "end_seconds": 246.96,
      "duration_seconds": 5.37,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.72,
      "end_seconds": 248.71,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.51,
      "end_seconds": 256.43,
      "duration_seconds": 1.92,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.22,
      "end_seconds": 286.99,
      "duration_seconds": 18.77,
      "text": "Putting it all together, this looks most like life-threatening haemoptysis. We should do urgent blood tests for bleeding. The result will help us decide whether anything more is needed. I'm sending you for an urgent CT scan because of massive haemoptysis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.98,
      "end_seconds": 291.23,
      "duration_seconds": 2.25,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.68,
      "end_seconds": 298.87,
      "duration_seconds": 6.19,
      "text": "I'm prescribing tranexamic acid, 1 gram, now, single dose. That's for haemoptysis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.45,
      "end_seconds": 300.93,
      "duration_seconds": 1.48,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.77,
      "end_seconds": 315.24,
      "duration_seconds": 12.47,
      "text": "Lie on the bleeding side and I am calling the emergency team. If the symptoms get worse, that's the point to come in urgently. See me again straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.38,
      "end_seconds": 319.32,
      "duration_seconds": 2.94,
      "text": "I mean, that's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.15,
      "end_seconds": 326.88,
      "duration_seconds": 6.73,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.51,
      "end_seconds": 336.62,
      "duration_seconds": 9.11,
      "text": "So, I take the tranexamic acid, 1 gram, now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.14,
      "end_seconds": 342.53,
      "duration_seconds": 4.39,
      "text": "So, yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.83,
      "end_seconds": 347.07,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    }
  ]
}