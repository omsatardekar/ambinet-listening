{
  "schema_version": "1.0",
  "encounter_id": "03098",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 7.31,
      "duration_seconds": 6.31,
      "text": "Well, you know, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.92,
      "end_seconds": 12.15,
      "duration_seconds": 4.23,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.68,
      "end_seconds": 18.83,
      "duration_seconds": 5.15,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.49,
      "duration_seconds": 3.3,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.77,
      "end_seconds": 34.33,
      "duration_seconds": 9.56,
      "text": "Okay, so it's a sudden severe tummy pain, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.13,
      "end_seconds": 38.05,
      "duration_seconds": 2.92,
      "text": "What about vomiting, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.87,
      "end_seconds": 49.3,
      "duration_seconds": 9.43,
      "text": "Ah, yeah. Two weeks, I'd say. I've had shoulder tip pain too, for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.08,
      "end_seconds": 54.58,
      "duration_seconds": 3.5,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.65,
      "end_seconds": 61.73,
      "duration_seconds": 6.08,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.13,
      "end_seconds": 63.21,
      "duration_seconds": 1.08,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.87,
      "end_seconds": 84.79,
      "duration_seconds": 4.92,
      "text": "Do you have any long-term conditions? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.82,
      "end_seconds": 92.75,
      "duration_seconds": 5.93,
      "text": "Let me think, uh, I've had epilepsy for two years now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.02,
      "end_seconds": 99.88,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.31,
      "end_seconds": 105.16,
      "duration_seconds": 3.85,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.27,
      "end_seconds": 109.01,
      "duration_seconds": 2.74,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.88,
      "end_seconds": 116.16,
      "duration_seconds": 6.28,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.1,
      "end_seconds": 119.68,
      "duration_seconds": 1.58,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.14,
      "end_seconds": 125.86,
      "duration_seconds": 4.72,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.9,
      "end_seconds": 137.16,
      "duration_seconds": 2.26,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.45,
      "end_seconds": 144.54,
      "duration_seconds": 6.09,
      "text": "Lamotrigine. I take it 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.35,
      "end_seconds": 148.32,
      "duration_seconds": 2.97,
      "text": "roughly how long on that that one?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 151.17,
      "duration_seconds": 1.97,
      "text": "about nearly five years"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.73,
      "end_seconds": 152.7,
      "duration_seconds": 0.97,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 161.97,
      "duration_seconds": 7.81,
      "text": "right, I'm on something called ibup... ibuprofen, 600 milligrams, maybe, three times a day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.16,
      "end_seconds": 167.83,
      "duration_seconds": 4.67,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.66,
      "end_seconds": 176.98,
      "duration_seconds": 3.32,
      "text": "No, uh, it's at home."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.78,
      "end_seconds": 184.24,
      "duration_seconds": 4.46,
      "text": "a few quick ones: diarrhoea, fever or blood in the vomit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.71,
      "end_seconds": 189.28,
      "duration_seconds": 3.57,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.01,
      "end_seconds": 193.6,
      "duration_seconds": 2.59,
      "text": "Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.37,
      "end_seconds": 196.58,
      "duration_seconds": 1.21,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.61,
      "end_seconds": 201.64,
      "duration_seconds": 4.03,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.37,
      "end_seconds": 212.39,
      "duration_seconds": 5.02,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.11,
      "end_seconds": 232.69,
      "duration_seconds": 2.58,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.1,
      "end_seconds": 248.74,
      "duration_seconds": 2.64,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.48,
      "end_seconds": 283.21,
      "duration_seconds": 12.73,
      "text": "Okay: pulse is 121 beats a minute, temperature is 36.5 degrees. And pressure 136 over 74, SpO2 99 percent on room air, respiratory rate 19."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.95,
      "end_seconds": 286.42,
      "duration_seconds": 2.47,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.48,
      "end_seconds": 291.97,
      "duration_seconds": 3.49,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.12,
      "end_seconds": 296.56,
      "duration_seconds": 2.44,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.76,
      "end_seconds": 300.43,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.93,
      "end_seconds": 318.21,
      "duration_seconds": 8.28,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.28,
      "end_seconds": 349.4,
      "duration_seconds": 29.12,
      "text": "All finished, thank you. Taking everything into account, I'd lean towards a perforated stomach ulcer. Let's book a CT scan to look into possible perforation. Nothing to eat or drink, you need an operation urgently. Please take the tablets with food so they don't upset your stomach. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.87,
      "end_seconds": 363.85,
      "duration_seconds": 12.98,
      "text": "I, I'll remember that. Sorry, you know, what was I saying, could I get an erect chest X-ray done? A friend had it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.62,
      "end_seconds": 377.37,
      "duration_seconds": 12.75,
      "text": "not at this point, no it isn't indicated yet one warning sign to remember: the the symptoms get worse in that case don't wait i'll want another look straight away"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.75,
      "end_seconds": 382.12,
      "duration_seconds": 3.37,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.7,
      "end_seconds": 388.72,
      "duration_seconds": 6.02,
      "text": "Right, that's the plan. Do you want to to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.6,
      "end_seconds": 393.08,
      "duration_seconds": 3.48,
      "text": "Great, thank you for your help."
    }
  ]
}