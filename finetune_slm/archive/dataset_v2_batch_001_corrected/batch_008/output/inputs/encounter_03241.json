{
  "schema_version": "1.0",
  "encounter_id": "03241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.83,
      "duration_seconds": 5.22,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.89,
      "end_seconds": 13.16,
      "duration_seconds": 5.27,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.04,
      "end_seconds": 21.58,
      "duration_seconds": 6.54,
      "text": "honestly, it's taking painkillers every day, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.14,
      "end_seconds": 25.38,
      "duration_seconds": 3.24,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.54,
      "end_seconds": 29.98,
      "duration_seconds": 3.44,
      "text": "I've had it it since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.5,
      "end_seconds": 34.14,
      "duration_seconds": 3.64,
      "text": "I see, go ahead. How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 38.36,
      "duration_seconds": 2.91,
      "text": "Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.43,
      "end_seconds": 42.32,
      "duration_seconds": 2.89,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.02,
      "end_seconds": 45.56,
      "duration_seconds": 1.54,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.57,
      "end_seconds": 48.79,
      "duration_seconds": 2.22,
      "text": "any light sensitivity as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.33,
      "end_seconds": 55.07,
      "duration_seconds": 4.74,
      "text": "yes, actually i've also been feeling sick, for three days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.61,
      "end_seconds": 65.59,
      "duration_seconds": 6.98,
      "text": "Have you had taking painkillers every day before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.58,
      "end_seconds": 75.51,
      "duration_seconds": 7.93,
      "text": "well, I had a similar thing a couple of years ago. It went away"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 79.73,
      "duration_seconds": 2.5,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 87.03,
      "duration_seconds": 6.47,
      "text": "Sorry, what was I saying, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.96,
      "end_seconds": 97.29,
      "duration_seconds": 2.33,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.87,
      "end_seconds": 101.45,
      "duration_seconds": 3.58,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.45,
      "end_seconds": 106.39,
      "duration_seconds": 2.94,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.89,
      "end_seconds": 111.52,
      "duration_seconds": 3.63,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.33,
      "end_seconds": 114.88,
      "duration_seconds": 2.55,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.83,
      "end_seconds": 119.96,
      "duration_seconds": 3.13,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.65,
      "end_seconds": 124.85,
      "duration_seconds": 4.2,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.93,
      "end_seconds": 133.33,
      "duration_seconds": 5.4,
      "text": "Propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.05,
      "end_seconds": 151.41,
      "duration_seconds": 2.36,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.83,
      "end_seconds": 156.96,
      "duration_seconds": 4.13,
      "text": "I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.99,
      "end_seconds": 164.47,
      "duration_seconds": 6.48,
      "text": "Sure. Let me check a few things. Any stiff neck, fever or visual changes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.49,
      "end_seconds": 169.04,
      "duration_seconds": 2.55,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.13,
      "end_seconds": 171.3,
      "duration_seconds": 1.17,
      "text": "what about weakness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.82,
      "end_seconds": 176.31,
      "duration_seconds": 1.49,
      "text": "definitely no weakness"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.1,
      "end_seconds": 180.74,
      "duration_seconds": 3.64,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.83,
      "end_seconds": 185.61,
      "duration_seconds": 2.78,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.87,
      "end_seconds": 189.43,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.13,
      "end_seconds": 191.7,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.09,
      "end_seconds": 213.24,
      "duration_seconds": 3.15,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.32,
      "end_seconds": 228.97,
      "duration_seconds": 2.65,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.4,
      "end_seconds": 247.66,
      "duration_seconds": 7.26,
      "text": "Okay: BP is 111 over 74, pulse is 75 beats a a minute, saturation 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.21,
      "end_seconds": 252.78,
      "duration_seconds": 3.57,
      "text": "mm, you know, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 258.0,
      "duration_seconds": 3.19,
      "text": "okay, I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.44,
      "end_seconds": 263.03,
      "duration_seconds": 2.59,
      "text": "okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.25,
      "end_seconds": 266.26,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.04,
      "end_seconds": 278.24,
      "duration_seconds": 2.2,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.17,
      "end_seconds": 298.04,
      "duration_seconds": 15.87,
      "text": "Thank you, you can get dressed. Having listened and examined, the most likely explanation is medication-overuse headache on a background of migraine. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.49,
      "end_seconds": 301.31,
      "duration_seconds": 1.82,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.4,
      "end_seconds": 317.33,
      "duration_seconds": 13.93,
      "text": "nothing I've seen today points to an emergency. It looks like medication-overuse headache on a background of migraine, but I'd like to confirm. I'd like to arrange a headache diary for daily headache"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.67,
      "end_seconds": 324.05,
      "duration_seconds": 5.38,
      "text": "We have a slot Friday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.95,
      "end_seconds": 329.21,
      "duration_seconds": 2.26,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.27,
      "end_seconds": 361.9,
      "duration_seconds": 30.63,
      "text": "For this, amitriptyline, 10 milligrams, at night, long term. You take it by mouth. It's for headache prevention. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.13,
      "end_seconds": 366.14,
      "duration_seconds": 3.01,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.18,
      "end_seconds": 368.51,
      "duration_seconds": 1.33,
      "text": "Take care now."
    }
  ]
}