{
  "schema_version": "1.0",
  "encounter_id": "03249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.71,
      "duration_seconds": 3.32,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.5,
      "end_seconds": 10.01,
      "duration_seconds": 4.51,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.56,
      "end_seconds": 16.73,
      "duration_seconds": 6.17,
      "text": "Mainly I've been coughing up large amounts of blood. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.21,
      "end_seconds": 21.6,
      "duration_seconds": 3.39,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.37,
      "end_seconds": 26.45,
      "duration_seconds": 4.08,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.5,
      "end_seconds": 30.31,
      "duration_seconds": 2.81,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.85,
      "end_seconds": 36.08,
      "duration_seconds": 2.23,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.43,
      "end_seconds": 39.28,
      "duration_seconds": 2.85,
      "text": "Yes. Have you had a gurgling chest?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.13,
      "end_seconds": 52.26,
      "duration_seconds": 8.13,
      "text": "Yes, for about a month. Oh, and breathlessness. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.54,
      "end_seconds": 59.57,
      "duration_seconds": 6.03,
      "text": "Have you been coughing up large amounts of blood at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.53,
      "end_seconds": 66.54,
      "duration_seconds": 5.01,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.22,
      "end_seconds": 69.22,
      "duration_seconds": 2.0,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 85.03,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.38,
      "end_seconds": 102.16,
      "duration_seconds": 7.78,
      "text": "Okay: pulse 90, respiratory rate 24. And saturation 94 percent, blood pressure 119 over 78, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.38,
      "end_seconds": 107.28,
      "duration_seconds": 3.9,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.84,
      "end_seconds": 110.89,
      "duration_seconds": 2.05,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.55,
      "end_seconds": 127.89,
      "duration_seconds": 5.34,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.39,
      "end_seconds": 137.14,
      "duration_seconds": 5.75,
      "text": "All finished, thank you. Have you had any chest pain, fever or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.74,
      "end_seconds": 143.06,
      "duration_seconds": 5.32,
      "text": "No, uh, no chest pain, fever or weight loss."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.29,
      "end_seconds": 146.75,
      "duration_seconds": 2.46,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.05,
      "end_seconds": 150.68,
      "duration_seconds": 2.63,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.67,
      "end_seconds": 155.1,
      "duration_seconds": 3.43,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.3,
      "end_seconds": 158.85,
      "duration_seconds": 2.55,
      "text": "Erm, I move fine otherwise."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.22,
      "end_seconds": 163.8,
      "duration_seconds": 3.58,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.74,
      "end_seconds": 170.09,
      "duration_seconds": 5.35,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.16,
      "end_seconds": 188.31,
      "duration_seconds": 4.15,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.1,
      "end_seconds": 193.87,
      "duration_seconds": 4.77,
      "text": "Eltroxin, 100 micrograms, every morning. Gliclazide, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.6,
      "end_seconds": 199.63,
      "duration_seconds": 2.03,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.55,
      "end_seconds": 204.55,
      "duration_seconds": 1.0,
      "text": "80 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 208.91,
      "duration_seconds": 3.6,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.02,
      "end_seconds": 213.19,
      "duration_seconds": 3.17,
      "text": "An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.38,
      "end_seconds": 218.24,
      "duration_seconds": 1.86,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.21,
      "end_seconds": 222.58,
      "duration_seconds": 2.37,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.5,
      "end_seconds": 226.98,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.89,
      "end_seconds": 232.79,
      "duration_seconds": 3.9,
      "text": "Yes, walnuts, it gives me my lips swelling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.26,
      "end_seconds": 250.61,
      "duration_seconds": 3.35,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.45,
      "end_seconds": 261.57,
      "duration_seconds": 10.12,
      "text": "I only drink at family occasions. I'm vegetarian and have been for years. I swim twice a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.29,
      "end_seconds": 313.6,
      "duration_seconds": 33.31,
      "text": "Right, here's what I'm thinking. My working impression is life-threatening haemoptysis. I'm going to order urgent blood tests, for bleeding. I'll request an urgent CT scan, it'll help with massive haemoptysis. We'll begin with tranexamic acid, 1 gram, now, single dose. That should help with haemoptysis. Lie on the bleeding side and I am calling the emergency team. Come back or go to emergency straight away if the symptoms get worse. See me again straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.48,
      "end_seconds": 319.98,
      "duration_seconds": 4.5,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.2,
      "end_seconds": 325.63,
      "duration_seconds": 4.43,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}