{
  "schema_version": "1.0",
  "encounter_id": "03036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 5.76,
      "duration_seconds": 4.61,
      "text": "Morning, come on through. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.68,
      "end_seconds": 10.34,
      "duration_seconds": 3.66,
      "text": "I've been coughing up large amounts of blood"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.85,
      "end_seconds": 14.26,
      "duration_seconds": 3.41,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.8,
      "end_seconds": 32.43,
      "duration_seconds": 16.63,
      "text": "maybe a five out of ten on a bad day and there's breathlessness as well, about three months now. A gurgling chest was there, you know, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.35,
      "end_seconds": 40.99,
      "duration_seconds": 6.64,
      "text": "have you been coughing up large amounts of blood at any time before this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.44,
      "end_seconds": 49.88,
      "duration_seconds": 7.44,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 65.33,
      "end_seconds": 76.29,
      "duration_seconds": 10.96,
      "text": "doctor, I've got the readings for you. Heart rate 87, respiratory rate 23, temp 37.6 degrees, BP is 134 over 77, saturation 91 percent"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 78.6,
      "duration_seconds": 0.94,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.57,
      "end_seconds": 84.06,
      "duration_seconds": 3.49,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.87,
      "end_seconds": 88.23,
      "duration_seconds": 1.36,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.67,
      "end_seconds": 91.75,
      "duration_seconds": 2.08,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.56,
      "end_seconds": 114.96,
      "duration_seconds": 6.4,
      "text": "You are pale, breathing fast and bringing up fresh blood with every cough."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.67,
      "end_seconds": 122.72,
      "duration_seconds": 3.05,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 144.61,
      "duration_seconds": 3.85,
      "text": "did you get weight loss, fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.81,
      "end_seconds": 149.06,
      "duration_seconds": 3.25,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.77,
      "end_seconds": 157.02,
      "duration_seconds": 3.25,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.77,
      "end_seconds": 161.1,
      "duration_seconds": 2.33,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.34,
      "end_seconds": 166.76,
      "duration_seconds": 4.42,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.44,
      "end_seconds": 168.87,
      "duration_seconds": 1.43,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.68,
      "end_seconds": 172.35,
      "duration_seconds": 2.67,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.26,
      "end_seconds": 174.75,
      "duration_seconds": 1.49,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.68,
      "end_seconds": 179.49,
      "duration_seconds": 2.81,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.82,
      "end_seconds": 184.67,
      "duration_seconds": 3.85,
      "text": "I've, I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.52,
      "end_seconds": 190.22,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.94,
      "end_seconds": 194.91,
      "duration_seconds": 3.97,
      "text": "I have heart disease, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.71,
      "end_seconds": 205.75,
      "duration_seconds": 10.04,
      "text": "Yes, an irregular heartbeat and heart disease are known to us, good to have that clear. now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.31,
      "end_seconds": 217.07,
      "duration_seconds": 10.76,
      "text": "I grab fast food at lunch most days. My partner and our baby. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 223.04,
      "duration_seconds": 4.6,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.77,
      "end_seconds": 229.84,
      "duration_seconds": 5.07,
      "text": "Diclofenac i come out in... well, swelling of my lips"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.41,
      "end_seconds": 236.72,
      "duration_seconds": 5.31,
      "text": "Let's run through your medicines. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.86,
      "end_seconds": 249.74,
      "duration_seconds": 11.88,
      "text": "I take bisoprolol, 2.5 milligrams, once a day. My sister suggested writing things down, but I forgot. It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.02,
      "end_seconds": 279.55,
      "duration_seconds": 11.53,
      "text": "From what you've told me and what I found, I think we're dealing with life-threatening haemoptysis at this stage. We shouldn't forget a lung tumour."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.71,
      "end_seconds": 284.55,
      "duration_seconds": 3.84,
      "text": "Actually, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.17,
      "end_seconds": 301.18,
      "duration_seconds": 16.01,
      "text": "I can't promise yet, but most people with life-threatening haemoptysis do well once it's treated properly. So, to recap quickly. You've been coughing up large amounts of blood, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.45,
      "end_seconds": 304.88,
      "duration_seconds": 2.43,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.82,
      "end_seconds": 331.53,
      "duration_seconds": 24.71,
      "text": "I'll request urgent blood tests, it'll help with bleeding. I want an urgent CT scan done, that's for massive haemoptysis. I'm going to put you on tranexamic acid, 1 gram, now, single dose. That's for haemoptysis. Lie on the bleeding side and I am calling the emergency team. See me again straight away"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.84,
      "end_seconds": 335.19,
      "duration_seconds": 2.35,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.17,
      "end_seconds": 341.95,
      "duration_seconds": 5.78,
      "text": "Can you run through the plan with me quickly, just to to be certain?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.76,
      "end_seconds": 353.21,
      "duration_seconds": 10.45,
      "text": "So, um, I take the tranexamic acid, 1 gram, now and come back straight away. Is that that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.83,
      "end_seconds": 359.93,
      "duration_seconds": 5.1,
      "text": "Yes, exactly right. Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.73,
      "end_seconds": 363.79,
      "duration_seconds": 2.06,
      "text": "Alright, thanks, take care."
    }
  ]
}