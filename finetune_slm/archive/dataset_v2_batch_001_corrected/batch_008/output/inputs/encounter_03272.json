      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 232.27,
      "end_seconds": 241.27,
      "duration_seconds": 9.0,
      "text": "here are the numbers doctor bP is 119 over 75 pulse is 77 beats a minute SpO2 98 percent on room air temperature 36.4."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
