    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.31,
      "end_seconds": 126.36,
      "duration_seconds": 3.05,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.08,
      "end_seconds": 129.93,
