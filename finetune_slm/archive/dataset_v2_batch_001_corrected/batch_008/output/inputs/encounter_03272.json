      "role": "PATIENT",
      "start_seconds": 192.87,
      "end_seconds": 198.11,
      "duration_seconds": 5.24,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.65,
      "end_seconds": 204.13,
      "duration_seconds": 4.48,
      "text": "did you get stiff neck weakness fever or visual changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.52,
      "end_seconds": 209.93,
      "duration_seconds": 3.41,
      "text": "No I haven't had any of them."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 213.51,
      "duration_seconds": 2.94,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.02,
      "end_seconds": 216.96,
      "duration_seconds": 1.94,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.06,
      "end_seconds": 221.31,
      "duration_seconds": 2.25,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.07,
      "end_seconds": 223.26,
      "duration_seconds": 1.19,
