{
  "schema_version": "1.0",
  "encounter_id": "03203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.14,
      "duration_seconds": 2.88,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.87,
      "end_seconds": 9.91,
      "duration_seconds": 5.04,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.3,
      "end_seconds": 16.6,
      "duration_seconds": 5.3,
      "text": "I'm here because of a red sore wound after my operation."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.31,
      "end_seconds": 21.31,
      "duration_seconds": 3.0,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.59,
      "end_seconds": 29.91,
      "duration_seconds": 3.32,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.74,
      "end_seconds": 34.93,
      "duration_seconds": 4.19,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.57,
      "end_seconds": 37.14,
      "duration_seconds": 1.57,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 41.63,
      "duration_seconds": 2.82,
      "text": "So, have you had a temperature?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.83,
      "end_seconds": 53.1,
      "duration_seconds": 10.27,
      "text": "Yeah. About three months, I'd say. With temperature, I'd say severe. And pain around the wound as well, since last weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.63,
      "end_seconds": 64.61,
      "duration_seconds": 9.98,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it it better or worse"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 72.95,
      "duration_seconds": 7.05,
      "text": "I'd give it a five, out of ten. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.43,
      "end_seconds": 89.5,
      "duration_seconds": 4.07,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.28,
      "end_seconds": 93.72,
      "duration_seconds": 2.44,
      "text": "Acid reflux, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.62,
      "end_seconds": 98.95,
      "duration_seconds": 3.33,
      "text": "mm-hmm what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.53,
      "end_seconds": 104.5,
      "duration_seconds": 4.97,
      "text": "Omeprazole. I take it it once a day for the reflux."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.79,
      "end_seconds": 108.18,
      "duration_seconds": 2.39,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.35,
      "end_seconds": 119.56,
      "duration_seconds": 5.21,
      "text": "It's 20 milligrams. I take paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 126.37,
      "duration_seconds": 5.63,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.1,
      "end_seconds": 142.98,
      "duration_seconds": 15.88,
      "text": "No, I've never smoked in my life. I drink a lot of tea and snack through the day. Yes, I work in a bakery, early starts. I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.09,
      "end_seconds": 154.52,
      "duration_seconds": 3.43,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.53,
      "end_seconds": 159.25,
      "duration_seconds": 3.72,
      "text": "Cat fur. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.84,
      "end_seconds": 171.76,
      "duration_seconds": 1.92,
      "text": "Any sign of breathlessness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.35,
      "end_seconds": 174.13,
      "duration_seconds": 1.78,
      "text": "Nope, no breathlessness."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.01,
      "end_seconds": 180.7,
      "duration_seconds": 4.69,
      "text": "A few quick ones: calf pain, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.67,
      "end_seconds": 188.84,
      "duration_seconds": 6.17,
      "text": "Well, I haven't had calf pain, vomiting or chest pain, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.13,
      "end_seconds": 192.12,
      "duration_seconds": 1.99,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.63,
      "end_seconds": 199.28,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.75,
      "end_seconds": 205.22,
      "duration_seconds": 4.47,
      "text": "Any pins and and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.94,
      "end_seconds": 207.39,
      "duration_seconds": 1.45,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.06,
      "end_seconds": 212.48,
      "duration_seconds": 4.42,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.4,
      "end_seconds": 225.88,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.97,
      "end_seconds": 253.09,
      "duration_seconds": 9.12,
      "text": "Okay: pulse is 106 beats a minute, temperature 38.5, pressure 117 over 69, oxygen saturation is 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 258.19,
      "duration_seconds": 3.45,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.02,
      "end_seconds": 261.45,
      "duration_seconds": 2.43,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.69,
      "end_seconds": 276.34,
      "duration_seconds": 7.65,
      "text": "The lower part of the wound is red, hot and weeping pus, and the edges have not come together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.59,
      "end_seconds": 290.46,
      "duration_seconds": 9.87,
      "text": "That's the examination finished. Having listened and examined, this is probably a surgical wound infection. We shouldn't forget a stitch abscess."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.21,
      "end_seconds": 297.4,
      "duration_seconds": 2.19,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 326.65,
      "duration_seconds": 27.36,
      "text": "it's reasonable to be concerned, but right now a surgical wound infection is my leading thought, not anything worse i'll request a wound swab, it'll help with wound infection i'm sending you for blood tests cos of wound infection i'd like you to take flucloxacillin, 500 milligrams, four times a day, seven days you take it by mouth it's for wound infection"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.75,
      "end_seconds": 332.85,
      "duration_seconds": 5.1,
      "text": "Oh, can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.99,
      "end_seconds": 344.19,
      "duration_seconds": 10.2,
      "text": "Keep it clean and dry and use fresh dressings daily. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.3,
      "end_seconds": 347.39,
      "duration_seconds": 2.09,
      "text": "that's fine by me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.73,
      "end_seconds": 350.77,
      "duration_seconds": 2.04,
      "text": "come back in two days"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.7,
      "end_seconds": 353.4,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.0,
      "end_seconds": 356.65,
      "duration_seconds": 2.65,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.38,
      "end_seconds": 360.09,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    }
  ]
}