{
  "schema_version": "1.0",
  "encounter_id": "03072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 6.63,
      "duration_seconds": 5.55,
      "text": "Hmm, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 11.91,
      "duration_seconds": 4.29,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.85,
      "end_seconds": 18.45,
      "duration_seconds": 5.6,
      "text": "Um, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.99,
      "end_seconds": 24.06,
      "duration_seconds": 4.07,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.3,
      "end_seconds": 33.67,
      "duration_seconds": 8.37,
      "text": "Let me think, doctor, it's a tight chest at work. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.17,
      "end_seconds": 37.92,
      "duration_seconds": 2.75,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.65,
      "end_seconds": 42.44,
      "duration_seconds": 2.79,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 45.67,
      "end_seconds": 49.91,
      "duration_seconds": 4.24,
      "text": "Ah, hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.17,
      "end_seconds": 55.8,
      "duration_seconds": 4.63,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.4,
      "end_seconds": 58.74,
      "duration_seconds": 1.34,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.62,
      "end_seconds": 64.47,
      "duration_seconds": 3.85,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.71,
      "end_seconds": 80.6,
      "duration_seconds": 14.89,
      "text": "I, I'd call it severe. Oh, and itchy eyes at work. That's been about the same, five days. I've had wheeze at work too, for about four days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.22,
      "end_seconds": 86.04,
      "duration_seconds": 4.82,
      "text": "What about a cough that eases on holiday, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.77,
      "end_seconds": 91.54,
      "duration_seconds": 3.77,
      "text": "Yeah, yeah. Five days, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.7,
      "end_seconds": 97.77,
      "duration_seconds": 2.07,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.86,
      "end_seconds": 102.67,
      "duration_seconds": 3.81,
      "text": "Not at all, um, no fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 103.92,
      "end_seconds": 109.86,
      "duration_seconds": 5.94,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.9,
      "end_seconds": 118.18,
      "duration_seconds": 7.28,
      "text": "No, uh, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.97,
      "end_seconds": 129.33,
      "duration_seconds": 10.36,
      "text": "Alright, I'll note both what you've said and what you've noticed. A few quick ones: weight loss, ankle swelling or coughing up blood?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.82,
      "end_seconds": 135.58,
      "duration_seconds": 4.76,
      "text": "Okay, uh, so no, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.86,
      "end_seconds": 140.5,
      "duration_seconds": 3.64,
      "text": "Right, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.27,
      "end_seconds": 144.06,
      "duration_seconds": 1.79,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.25,
      "end_seconds": 153.78,
      "duration_seconds": 5.53,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.7,
      "end_seconds": 157.59,
      "duration_seconds": 2.89,
      "text": "Well, no, that's all normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.17,
      "end_seconds": 163.11,
      "duration_seconds": 3.94,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 166.31,
      "end_seconds": 171.2,
      "duration_seconds": 4.89,
      "text": "He takes simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.54,
      "end_seconds": 175.71,
      "duration_seconds": 3.17,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.0,
      "end_seconds": 190.31,
      "duration_seconds": 13.31,
      "text": "For two months. It's metoprolol, 50 milligrams, twice a day for my heart, doctor. It's tamsulosin, 0.4 milligrams, at night, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.16,
      "end_seconds": 196.04,
      "duration_seconds": 3.88,
      "text": "Right, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.67,
      "end_seconds": 201.11,
      "duration_seconds": 4.44,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.05,
      "end_seconds": 206.46,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.54,
      "end_seconds": 211.23,
      "duration_seconds": 2.69,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 228.73,
      "duration_seconds": 5.4,
      "text": "Do you have any long-term conditions? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.55,
      "end_seconds": 237.13,
      "duration_seconds": 7.58,
      "text": "High cholesterol, for nearly five years. I've, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 239.04,
      "duration_seconds": 1.39,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.5,
      "end_seconds": 250.56,
      "duration_seconds": 10.06,
      "text": "I've had an enlarged prostate, yes. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.07,
      "end_seconds": 261.29,
      "duration_seconds": 10.22,
      "text": "Alright, high cholesterol and heart disease, that matches what I have here. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.3,
      "end_seconds": 267.7,
      "duration_seconds": 4.4,
      "text": "Okay, so no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.63,
      "end_seconds": 285.84,
      "duration_seconds": 1.21,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.61,
      "end_seconds": 290.61,
      "duration_seconds": 3.0,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.38,
      "end_seconds": 297.84,
      "duration_seconds": 2.46,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.48,
      "end_seconds": 302.39,
      "duration_seconds": 3.91,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.08,
      "end_seconds": 306.21,
      "duration_seconds": 2.13,
      "text": "So, have you retired yet?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.21,
      "end_seconds": 312.71,
      "duration_seconds": 5.5,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.5,
      "end_seconds": 329.78,
      "duration_seconds": 3.28,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.29,
      "end_seconds": 342.96,
      "duration_seconds": 2.67,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.84,
      "end_seconds": 370.19,
      "duration_seconds": 8.35,
      "text": "Okay: blood pressure 128 over 72, saturation 99 percent, respiratory rate 15, temp 36.9 degrees, heart rate 82."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.67,
      "end_seconds": 373.23,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.2,
      "end_seconds": 376.22,
      "duration_seconds": 2.02,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.23,
      "end_seconds": 381.36,
      "duration_seconds": 4.13,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.24,
      "end_seconds": 383.42,
      "duration_seconds": 1.18,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.03,
      "end_seconds": 399.25,
      "duration_seconds": 5.22,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.21,
      "end_seconds": 429.7,
      "duration_seconds": 25.49,
      "text": "Please sit back down. We should do serial peak flow readings for work-related wheeze. I think spirometry makes sense here, for wheeze. I'd like you to take beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma. Record peak flows at work and at home for four weeks. I'm going to send a referral to occupational health."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.66,
      "end_seconds": 431.36,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.23,
      "end_seconds": 439.58,
      "duration_seconds": 6.35,
      "text": "I'll want another look in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.52,
      "end_seconds": 444.25,
      "duration_seconds": 3.73,
      "text": "Erm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.68,
      "end_seconds": 447.6,
      "duration_seconds": 1.92,
      "text": "So, goodbye for now."
    }
  ]
}