{
  "schema_version": "1.0",
  "encounter_id": "03351",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.56,
      "duration_seconds": 3.3,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.7,
      "end_seconds": 10.3,
      "duration_seconds": 4.6,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.44,
      "end_seconds": 24.76,
      "duration_seconds": 8.32,
      "text": "Mainly wheeze at work. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.09,
      "end_seconds": 29.96,
      "duration_seconds": 3.87,
      "text": "Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.98,
      "end_seconds": 38.11,
      "duration_seconds": 2.13,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.96,
      "end_seconds": 40.64,
      "duration_seconds": 1.68,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.52,
      "end_seconds": 45.4,
      "duration_seconds": 3.88,
      "text": "It settles a little with weekends away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 49.38,
      "duration_seconds": 3.34,
      "text": "So, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.54,
      "end_seconds": 56.3,
      "duration_seconds": 5.76,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.58,
      "end_seconds": 75.13,
      "duration_seconds": 3.55,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.7,
      "end_seconds": 79.24,
      "duration_seconds": 3.54,
      "text": "So, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.91,
      "end_seconds": 90.85,
      "duration_seconds": 2.94,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 96.03,
      "duration_seconds": 4.41,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.82,
      "end_seconds": 100.18,
      "duration_seconds": 2.36,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 107.94,
      "duration_seconds": 3.63,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.93,
      "end_seconds": 112.99,
      "duration_seconds": 3.06,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.76,
      "end_seconds": 118.69,
      "duration_seconds": 3.93,
      "text": "I mean, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.97,
      "end_seconds": 123.41,
      "duration_seconds": 3.44,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.29,
      "end_seconds": 128.01,
      "duration_seconds": 3.72,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.68,
      "end_seconds": 133.4,
      "duration_seconds": 4.72,
      "text": "And what about coughing up blood, ankle swelling or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.42,
      "end_seconds": 140.81,
      "duration_seconds": 6.39,
      "text": "No coughing up blood, ankle swelling or fever, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.27,
      "end_seconds": 146.11,
      "duration_seconds": 3.84,
      "text": "Right, have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.85,
      "end_seconds": 148.99,
      "duration_seconds": 2.14,
      "text": "No weight loss, thankfully."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 153.48,
      "duration_seconds": 2.72,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.89,
      "end_seconds": 159.37,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.94,
      "end_seconds": 174.98,
      "duration_seconds": 3.04,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.28,
      "end_seconds": 186.74,
      "duration_seconds": 2.46,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.51,
      "end_seconds": 218.21,
      "duration_seconds": 9.7,
      "text": "Okay: oxygen saturation is 98 percent, respiratory rate 16, pulse is 83 beats a minute, blood pressure 108 over 78."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.27,
      "end_seconds": 224.53,
      "duration_seconds": 4.26,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.77,
      "end_seconds": 227.33,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.63,
      "end_seconds": 246.94,
      "duration_seconds": 5.31,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.22,
      "end_seconds": 253.11,
      "duration_seconds": 1.89,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.15,
      "end_seconds": 278.53,
      "duration_seconds": 10.38,
      "text": "From what you've told me and what I found, I don't have a clear answer today: occupational asthma is possible, and so is COPD."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.44,
      "end_seconds": 281.4,
      "duration_seconds": 1.96,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.34,
      "end_seconds": 317.87,
      "duration_seconds": 35.53,
      "text": "I can't promise yet, but most people with occupational asthma do well once it's treated properly. Let's book spirometry to look into wheeze. Let's get serial peak flow readings, for work-related wheeze. The result will help us decide whether anything more is needed. Let's use beclometasone inhaler, 200 micrograms, twice a day, long term. It's for asthma. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.13,
      "end_seconds": 321.28,
      "duration_seconds": 2.15,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.81,
      "end_seconds": 340.93,
      "duration_seconds": 19.12,
      "text": "Record peak flows at work and at home for four weeks. One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.39,
      "end_seconds": 347.27,
      "duration_seconds": 2.88,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.16,
      "end_seconds": 349.4,
      "duration_seconds": 1.24,
      "text": "Take care now."
    }
  ]
}