{
  "schema_version": "1.0",
  "encounter_id": "03128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 2.5,
      "duration_seconds": 1.8,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.26,
      "end_seconds": 8.77,
      "duration_seconds": 4.51,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.2,
      "end_seconds": 15.15,
      "duration_seconds": 4.95,
      "text": "Right, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.64,
      "end_seconds": 19.58,
      "duration_seconds": 2.94,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.93,
      "end_seconds": 32.0,
      "duration_seconds": 11.07,
      "text": "Mainly sudden severe pain in the lower tummy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.84,
      "end_seconds": 34.25,
      "duration_seconds": 1.41,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.69,
      "end_seconds": 37.89,
      "duration_seconds": 2.2,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.54,
      "end_seconds": 40.96,
      "duration_seconds": 2.42,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.71,
      "end_seconds": 51.83,
      "duration_seconds": 9.12,
      "text": "Let me think, when it starts I tend to get shoulder tip pain as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.13,
      "end_seconds": 57.12,
      "duration_seconds": 3.99,
      "text": "What about vaginal spotting, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.09,
      "end_seconds": 75.91,
      "duration_seconds": 17.82,
      "text": "Yes, uh, since this morning. Oh, and collapsing. Um, you know, with collapsing, maybe a four out of ten on a bad day. Erm, the shoulder tip pain? That's been for two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.74,
      "end_seconds": 81.12,
      "duration_seconds": 3.38,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.43,
      "end_seconds": 86.48,
      "duration_seconds": 4.05,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.23,
      "end_seconds": 89.8,
      "duration_seconds": 2.57,
      "text": "Any discharge, fever or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.35,
      "end_seconds": 95.32,
      "duration_seconds": 4.97,
      "text": "No discharge, fever or vomiting, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.29,
      "end_seconds": 98.23,
      "duration_seconds": 1.94,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 100.13,
      "duration_seconds": 1.01,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.16,
      "end_seconds": 120.07,
      "duration_seconds": 2.91,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.33,
      "end_seconds": 133.22,
      "duration_seconds": 11.89,
      "text": "Uh, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.15,
      "end_seconds": 147.82,
      "duration_seconds": 3.67,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.23,
      "end_seconds": 169.82,
      "duration_seconds": 20.59,
      "text": "No, I've never smoked in my life. I only drink at family occasions. No, I share a house with my brother. I grab fast food at lunch most days. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.93,
      "end_seconds": 173.57,
      "duration_seconds": 2.64,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.58,
      "end_seconds": 193.25,
      "duration_seconds": 17.67,
      "text": "I, I had keyhole surgery on my gallbladder two years back. I didn't want to bother you but it keeps coming back. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.92,
      "end_seconds": 207.36,
      "duration_seconds": 2.44,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.41,
      "end_seconds": 218.58,
      "duration_seconds": 10.17,
      "text": "Rosuvastatin, 10 milligrams, at night. I take propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 219.98,
      "end_seconds": 229.24,
      "duration_seconds": 9.26,
      "text": "Doctor, I think the last prescription for the propranolol was 80 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 235.74,
      "duration_seconds": 5.62,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.47,
      "end_seconds": 241.77,
      "duration_seconds": 5.3,
      "text": "Yeah, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.87,
      "end_seconds": 245.2,
      "duration_seconds": 2.33,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.2,
      "end_seconds": 251.07,
      "duration_seconds": 2.87,
      "text": "Yes, high cholesterol. Yes, migraines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.34,
      "end_seconds": 258.95,
      "duration_seconds": 6.61,
      "text": "Alright, migraines, that matches what I have here. Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.78,
      "end_seconds": 270.34,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.43,
      "end_seconds": 294.06,
      "duration_seconds": 7.63,
      "text": "Okay: temperature 37.1, oxygen saturation is 99 percent, pulse 108, BP is 103 over 60."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.71,
      "end_seconds": 297.17,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.62,
      "end_seconds": 304.56,
      "duration_seconds": 2.94,
      "text": "Okay, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.38,
      "end_seconds": 309.71,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.86,
      "end_seconds": 312.93,
      "duration_seconds": 2.07,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.49,
      "end_seconds": 329.37,
      "duration_seconds": 6.88,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.28,
      "end_seconds": 347.03,
      "duration_seconds": 11.75,
      "text": "You can sit up now. So where does that leave us? It points towards a ruptured ectopic pregnancy. A ruptured ovarian cyst is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.09,
      "end_seconds": 353.65,
      "duration_seconds": 5.56,
      "text": "Sorry, what was I saying, will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.72,
      "end_seconds": 376.53,
      "duration_seconds": 17.81,
      "text": "I can't promise yet, but most people with a ruptured ectopic pregnancy do well once it's treated properly. Stop me if I've got anything wrong. You've had sudden severe pain in the lower tummy for ten days, and no fever or discharge."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.34,
      "end_seconds": 380.14,
      "duration_seconds": 2.8,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.7,
      "end_seconds": 384.75,
      "duration_seconds": 4.05,
      "text": "Let's get urgent blood tests, for internal bleeding."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.23,
      "end_seconds": 388.21,
      "duration_seconds": 1.98,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.25,
      "end_seconds": 407.08,
      "duration_seconds": 16.83,
      "text": "I think a pregnancy test makes sense here, for collapse. I am calling the emergency team, you need an operation now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.27,
      "end_seconds": 412.34,
      "duration_seconds": 4.07,
      "text": "Actually, uh, thank you, that's clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.85,
      "end_seconds": 419.54,
      "duration_seconds": 6.69,
      "text": "Come back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.56,
      "end_seconds": 427.34,
      "duration_seconds": 6.78,
      "text": "Sorry, what was I saying, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.03,
      "end_seconds": 431.24,
      "duration_seconds": 1.21,
      "text": "Take care now."
    }
  ]
}