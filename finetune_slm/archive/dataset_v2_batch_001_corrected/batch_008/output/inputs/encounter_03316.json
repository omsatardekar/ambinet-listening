    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.6,
      "end_seconds": 231.5,
      "duration_seconds": 3.9,
      "text": "Right, let's have a proper look at you."
