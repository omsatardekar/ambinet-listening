      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.99,
      "end_seconds": 225.41,
      "duration_seconds": 2.42,
      "text": "we'll go over that shortly"
