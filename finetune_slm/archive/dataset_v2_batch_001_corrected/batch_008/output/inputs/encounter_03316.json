    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.74,
      "end_seconds": 235.5,
      "duration_seconds": 2.76,
      "text": "stay as you are for a moment"
