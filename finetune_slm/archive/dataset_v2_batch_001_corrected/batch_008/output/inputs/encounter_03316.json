      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.84,
      "end_seconds": 300.24,
      "duration_seconds": 19.4,
      "text": "Nothing I've seen today points to an emergency. It looks like gestational diabetes controllable with diet. Let me just check I've got this right. You've had a high sugar test in pregnancy for about four days, and no passing a lot of urine or reduced baby movements."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.01,
      "end_seconds": 302.71,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.72,
      "end_seconds": 317.04,
      "duration_seconds": 12.32,
      "text": "Replace sugary drinks and white starches with wholegrains and walk after meals. I'd like you back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.11,
      "end_seconds": 319.63,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    }
