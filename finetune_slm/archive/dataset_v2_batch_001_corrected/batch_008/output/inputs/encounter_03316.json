      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 155.24,
      "duration_seconds": 6.66,
      "text": "What's on your current medicine list? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.44,
      "end_seconds": 162.18,
      "duration_seconds": 5.74,
      "text": "I take carvedilol, 6.25 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.41,
      "end_seconds": 177.45,
      "duration_seconds": 4.04,
      "text": "Okay, shall I check your blood pressure and pulse?"
