      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.65,
      "end_seconds": 217.91,
      "duration_seconds": 15.26,
      "text": "Okay: temperature 36.9, height 173 centimetres, pulse is 83 beats a minute. And blood pressure 113 over 69, BMI works out to 26.4, weight 79 kilos, SpO2 97 percent on room air, respiratory rate 15."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.2,
      "end_seconds": 222.47,
      "duration_seconds": 3.27,
      "text": "Is that alright, you know, doctor?"
