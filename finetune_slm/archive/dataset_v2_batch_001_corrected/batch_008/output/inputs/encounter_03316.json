      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.9,
      "end_seconds": 138.43,
      "duration_seconds": 5.53,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
