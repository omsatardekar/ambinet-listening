    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.55,
      "end_seconds": 252.96,
      "duration_seconds": 5.41,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.23,
      "end_seconds": 275.24,
      "duration_seconds": 17.01,
      "text": "thank you, you can get dressed so where does that leave us? I'd lean towards gestational diabetes controllable with diet i want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.88,
      "end_seconds": 279.0,
      "duration_seconds": 2.12,
      "text": "Is this serious, doctor?"
