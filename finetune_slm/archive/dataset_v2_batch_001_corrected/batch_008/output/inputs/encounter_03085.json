{
  "schema_version": "1.0",
  "encounter_id": "03085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 5.81,
      "duration_seconds": 5.14,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.41,
      "end_seconds": 10.85,
      "duration_seconds": 4.44,
      "text": "Okay, so hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.51,
      "end_seconds": 18.44,
      "duration_seconds": 5.93,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.35,
      "end_seconds": 22.89,
      "duration_seconds": 3.54,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.23,
      "end_seconds": 31.86,
      "duration_seconds": 7.63,
      "text": "It's, It's being sick, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.22,
      "end_seconds": 38.18,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.61,
      "end_seconds": 43.87,
      "duration_seconds": 4.26,
      "text": "It's escitalopram, 10 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.4,
      "end_seconds": 48.24,
      "duration_seconds": 2.84,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.28,
      "end_seconds": 68.54,
      "duration_seconds": 18.26,
      "text": "Um, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many. And a severe headache for days, too. About severe headache for days, it's on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.74,
      "end_seconds": 88.65,
      "duration_seconds": 5.91,
      "text": "A few quick ones: head injury, fever or weakness on one side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.82,
      "end_seconds": 95.38,
      "duration_seconds": 3.56,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.71,
      "end_seconds": 98.52,
      "duration_seconds": 2.81,
      "text": "Sure. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.53,
      "end_seconds": 102.7,
      "duration_seconds": 2.17,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.89,
      "end_seconds": 120.95,
      "duration_seconds": 3.06,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.49,
      "end_seconds": 125.45,
      "duration_seconds": 3.96,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.41,
      "end_seconds": 129.22,
      "duration_seconds": 1.81,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.92,
      "end_seconds": 134.16,
      "duration_seconds": 3.24,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.21,
      "end_seconds": 138.05,
      "duration_seconds": 1.84,
      "text": "So, what's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.39,
      "end_seconds": 143.62,
      "duration_seconds": 4.23,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.3,
      "end_seconds": 149.12,
      "duration_seconds": 3.82,
      "text": "Right, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.48,
      "end_seconds": 159.59,
      "duration_seconds": 9.11,
      "text": "Okay, so yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.17,
      "end_seconds": 165.14,
      "duration_seconds": 3.97,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.4,
      "end_seconds": 175.63,
      "duration_seconds": 6.23,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.72,
      "end_seconds": 181.24,
      "duration_seconds": 4.52,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.96,
      "end_seconds": 187.31,
      "duration_seconds": 4.35,
      "text": "I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.18,
      "end_seconds": 205.69,
      "duration_seconds": 3.51,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.65,
      "end_seconds": 219.68,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.09,
      "end_seconds": 247.72,
      "duration_seconds": 10.63,
      "text": "Okay: pressure 169 over 89, respiratory rate 18. And SpO2 99 percent on room air, temperature is 36.6 degrees, pulse is 87 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.46,
      "end_seconds": 250.93,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 254.62,
      "duration_seconds": 2.92,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.76,
      "end_seconds": 260.73,
      "duration_seconds": 3.97,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.1,
      "end_seconds": 264.5,
      "duration_seconds": 2.4,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.51,
      "end_seconds": 279.83,
      "duration_seconds": 4.32,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.97,
      "end_seconds": 291.15,
      "duration_seconds": 8.18,
      "text": "Alright, good, you can sit up again. Having listened and examined, I'd lean towards possible cerebral venous thrombosis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.11,
      "end_seconds": 296.14,
      "duration_seconds": 4.03,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.92,
      "end_seconds": 331.41,
      "duration_seconds": 34.49,
      "text": "It's reasonable to be concerned, but right now possible cerebral venous thrombosis is my leading thought, not anything worse. I think an urgent CT venogram makes sense here, for possible venous thrombosis. I'd like to arrange an MRI of the head for papilloedema. Stop the pill, you need an urgent scan and admission. The neurology team would be the right next step, I'll refer you. Let's review you straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.54,
      "end_seconds": 337.11,
      "duration_seconds": 4.57,
      "text": "Okay, uh, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.5,
      "end_seconds": 339.98,
      "duration_seconds": 1.48,
      "text": "Look after yourself."
    }
  ]
}