{
  "schema_version": "1.0",
  "encounter_id": "03499",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 3.95,
      "duration_seconds": 3.26,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.6,
      "end_seconds": 10.85,
      "duration_seconds": 5.25,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 18.95,
      "duration_seconds": 6.01,
      "text": "Honestly, it's severe back pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.55,
      "end_seconds": 23.77,
      "duration_seconds": 4.22,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 26.59,
      "duration_seconds": 2.24,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.44,
      "end_seconds": 31.33,
      "duration_seconds": 3.89,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.37,
      "end_seconds": 38.16,
      "duration_seconds": 4.79,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.85,
      "end_seconds": 45.05,
      "duration_seconds": 2.2,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.05,
      "end_seconds": 57.12,
      "duration_seconds": 9.07,
      "text": "A fever goes along with it, most of the time. About fever, it comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.44,
      "end_seconds": 60.83,
      "duration_seconds": 2.39,
      "text": "Any trouble passing urine as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.56,
      "end_seconds": 65.06,
      "duration_seconds": 3.5,
      "text": "Yeah, yes, about the same, six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.79,
      "end_seconds": 69.61,
      "duration_seconds": 3.82,
      "text": "Alright, did you get recent fall or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 78.67,
      "duration_seconds": 4.48,
      "text": "Uh, no, no recent fall or chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.6,
      "end_seconds": 85.06,
      "duration_seconds": 4.46,
      "text": "Alright, have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.06,
      "end_seconds": 88.81,
      "duration_seconds": 2.75,
      "text": "No, none, no weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.56,
      "end_seconds": 93.37,
      "duration_seconds": 2.81,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.77,
      "end_seconds": 98.68,
      "duration_seconds": 3.91,
      "text": "No, you know, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.56,
      "end_seconds": 101.97,
      "duration_seconds": 1.41,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.98,
      "end_seconds": 105.36,
      "duration_seconds": 2.38,
      "text": "Actually, no weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.09,
      "end_seconds": 109.47,
      "duration_seconds": 3.38,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.34,
      "end_seconds": 117.02,
      "duration_seconds": 5.68,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.55,
      "end_seconds": 121.08,
      "duration_seconds": 2.53,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.71,
      "end_seconds": 143.94,
      "duration_seconds": 21.23,
      "text": "It's sitagliptin, 100 milligrams, once a day for my sugar. Though honestly, some days I forget to take it. Naproxen. I take it 250 milligrams, twice a day. Oh, I had gliclazide at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.61,
      "end_seconds": 148.3,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.46,
      "end_seconds": 151.75,
      "duration_seconds": 2.29,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.01,
      "end_seconds": 154.52,
      "duration_seconds": 1.51,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.6,
      "end_seconds": 163.86,
      "duration_seconds": 7.26,
      "text": "I've got arthritis in my knees. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.04,
      "end_seconds": 173.47,
      "duration_seconds": 8.43,
      "text": "Right, so diabetes and arthritis in your knees are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.7,
      "end_seconds": 188.59,
      "duration_seconds": 1.89,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.45,
      "end_seconds": 191.97,
      "duration_seconds": 2.52,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.39,
      "end_seconds": 195.74,
      "duration_seconds": 2.35,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.49,
      "end_seconds": 200.24,
      "duration_seconds": 3.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.46,
      "end_seconds": 218.38,
      "duration_seconds": 4.92,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.2,
      "end_seconds": 229.53,
      "duration_seconds": 10.33,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.56,
      "end_seconds": 232.9,
      "duration_seconds": 2.34,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.63,
      "end_seconds": 244.95,
      "duration_seconds": 2.32,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.08,
      "end_seconds": 265.12,
      "duration_seconds": 8.04,
      "text": "Okay: heart rate 103, SpO2 98 percent on room air, BP is 119 over 68, temp 39.2 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.09,
      "end_seconds": 271.13,
      "duration_seconds": 4.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.95,
      "end_seconds": 274.2,
      "duration_seconds": 1.25,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.88,
      "end_seconds": 293.72,
      "duration_seconds": 5.84,
      "text": "Your spine is extremely tender at one level and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.53,
      "end_seconds": 300.5,
      "duration_seconds": 1.97,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.56,
      "end_seconds": 324.51,
      "duration_seconds": 15.95,
      "text": "So, based on the history and the examination, this looks most like a possible spinal infection pressing on the nerves. Another possibility is a slipped disc. Let's book an urgent MRI of the spine to look into possible epidural abscess."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.77,
      "end_seconds": 326.87,
      "duration_seconds": 1.1,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.36,
      "end_seconds": 342.13,
      "duration_seconds": 13.77,
      "text": "Let's book urgent blood tests to look into possible spinal infection. You are going to hospital now, this can cause permanent weakness. I'll also refer you to the spinal team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.99,
      "end_seconds": 346.46,
      "duration_seconds": 2.47,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.44,
      "end_seconds": 357.68,
      "duration_seconds": 9.24,
      "text": "One warning sign to remember: the symptoms get worse. In that case don't wait. Book a review straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.57,
      "end_seconds": 363.77,
      "duration_seconds": 2.2,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.07,
      "end_seconds": 369.78,
      "duration_seconds": 4.71,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.96,
      "end_seconds": 373.26,
      "duration_seconds": 2.3,
      "text": "Alright, thanks, take care."
    }
  ]
}