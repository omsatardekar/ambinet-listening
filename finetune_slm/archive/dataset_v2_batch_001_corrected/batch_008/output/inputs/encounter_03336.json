{
  "schema_version": "1.0",
  "encounter_id": "03336",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 3.16,
      "duration_seconds": 2.55,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.97,
      "end_seconds": 7.89,
      "duration_seconds": 2.92,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.91,
      "end_seconds": 15.95,
      "duration_seconds": 3.04,
      "text": "So, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.55,
      "end_seconds": 19.86,
      "duration_seconds": 3.31,
      "text": "I've been dealing with fever and shivers."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 23.8,
      "duration_seconds": 3.14,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.83,
      "end_seconds": 27.88,
      "duration_seconds": 3.05,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.51,
      "end_seconds": 34.71,
      "duration_seconds": 3.2,
      "text": "So, any cloudy smelly urine as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.43,
      "end_seconds": 39.66,
      "duration_seconds": 3.23,
      "text": "Yes, about the same, one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.86,
      "end_seconds": 50.33,
      "duration_seconds": 4.47,
      "text": "A few quick ones: back pain, cough or fall?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.85,
      "end_seconds": 56.78,
      "duration_seconds": 4.93,
      "text": "Um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.76,
      "end_seconds": 60.78,
      "duration_seconds": 2.02,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.58,
      "end_seconds": 64.78,
      "duration_seconds": 2.2,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.45,
      "end_seconds": 70.98,
      "duration_seconds": 4.53,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.94,
      "end_seconds": 74.41,
      "duration_seconds": 1.47,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.47,
      "end_seconds": 84.61,
      "duration_seconds": 3.14,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.87,
      "end_seconds": 89.68,
      "duration_seconds": 3.81,
      "text": "I'm on paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.23,
      "end_seconds": 104.27,
      "duration_seconds": 5.04,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.74,
      "end_seconds": 121.25,
      "duration_seconds": 12.51,
      "text": "I used to drink heavily but I stopped four years ago. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.22,
      "end_seconds": 134.97,
      "duration_seconds": 3.75,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.09,
      "end_seconds": 138.82,
      "duration_seconds": 2.73,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.03,
      "end_seconds": 146.46,
      "duration_seconds": 6.43,
      "text": "So, yes, arthritis in your knees is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.74,
      "end_seconds": 166.18,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.0,
      "end_seconds": 169.9,
      "duration_seconds": 2.9,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.28,
      "end_seconds": 174.39,
      "duration_seconds": 3.11,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.12,
      "end_seconds": 187.21,
      "duration_seconds": 2.09,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.49,
      "end_seconds": 217.58,
      "duration_seconds": 10.09,
      "text": "Okay: weight 82 kilos, saturation 97 percent, height 183 centimetres, pulse is 104 beats a minute, blood pressure 109 over 79."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.61,
      "end_seconds": 221.49,
      "duration_seconds": 2.88,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.77,
      "end_seconds": 223.78,
      "duration_seconds": 1.01,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.76,
      "end_seconds": 229.13,
      "duration_seconds": 3.37,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.07,
      "end_seconds": 251.53,
      "duration_seconds": 6.46,
      "text": "The catheter bag has cloudy urine and there is tenderness above the pubic bone."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.1,
      "end_seconds": 262.51,
      "duration_seconds": 8.41,
      "text": "Okay, good, you can sit up again. So where does that leave us? This is probably a catheter-related urinary infection."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.31,
      "end_seconds": 267.42,
      "duration_seconds": 3.11,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.3,
      "end_seconds": 285.64,
      "duration_seconds": 17.34,
      "text": "I understand the worry. At the moment I'd say it's a catheter-related urinary infection, and we'll know more once the a urine culture is back. I'd like to arrange a urine culture for possible urinary infection."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.28,
      "end_seconds": 288.87,
      "duration_seconds": 2.59,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.35,
      "end_seconds": 308.43,
      "duration_seconds": 18.08,
      "text": "I'm going to put you on co-amoxiclav, 625 milligrams, three times a day, seven days. You take it by mouth. It's for catheter urinary infection. Change the catheter and drink plenty. See me again in two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.14,
      "end_seconds": 310.84,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.74,
      "end_seconds": 316.57,
      "duration_seconds": 3.83,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.41,
      "end_seconds": 321.44,
      "duration_seconds": 3.03,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.2,
      "end_seconds": 323.49,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}