      "role": "PATIENT",
      "start_seconds": 52.5,
      "end_seconds": 58.12,
      "duration_seconds": 5.62,
      "text": "I had a wisdom tooth extraction under sedation five years ago"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.42,
      "end_seconds": 69.84,
