      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.54,
      "end_seconds": 22.14,
      "duration_seconds": 8.6,
      "text": "Honestly, it's hearing getting worse in both ears, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.05,
      "end_seconds": 27.18,
      "duration_seconds": 4.13,
      "text": "Alright, is it it bearing on you a lot?"
