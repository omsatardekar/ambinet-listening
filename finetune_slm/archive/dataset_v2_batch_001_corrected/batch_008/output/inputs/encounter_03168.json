      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.09,
      "end_seconds": 128.88,
      "duration_seconds": 8.79,
      "text": "Sumatriptan i take it 50 milligrams, when needed yeah, I was on propranolol before i stopped taking it"
    },
