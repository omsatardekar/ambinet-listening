    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.03,
      "end_seconds": 137.6,
      "duration_seconds": 2.57,
      "text": "No, none that I've noticed."
