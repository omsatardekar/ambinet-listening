    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.08,
      "end_seconds": 80.32,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.83,
      "end_seconds": 86.12,
      "duration_seconds": 4.29,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.22,
      "end_seconds": 93.03,
      "duration_seconds": 4.81,
      "text": "What conditions have you been treated for in the past?"
