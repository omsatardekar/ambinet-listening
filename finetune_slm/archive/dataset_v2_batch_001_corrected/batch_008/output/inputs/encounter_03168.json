      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.16,
      "end_seconds": 132.99,
      "duration_seconds": 2.83,
      "text": "Have you had any vertigo or discharge?"
