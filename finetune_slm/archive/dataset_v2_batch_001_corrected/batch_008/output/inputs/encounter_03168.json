    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.19,
      "end_seconds": 98.28,
      "duration_seconds": 2.09,
      "text": "I've had migraines, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.72,
      "end_seconds": 104.87,
      "duration_seconds": 5.15,
      "text": "Mm-hmm. Okay, I can see migraines in your file as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.94,
      "end_seconds": 119.17,
      "duration_seconds": 7.23,
      "text": "Are you taking anything regularly, including from the pharmacy? I'm asking so that we don't miss anything."
