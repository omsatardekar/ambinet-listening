      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 50.78,
      "duration_seconds": 2.16,
      "text": "Anything surgical in your history?"
