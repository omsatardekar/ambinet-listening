    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.22,
      "end_seconds": 32.56,
      "duration_seconds": 3.34,
      "text": "A seven out of ten, I suppose."
