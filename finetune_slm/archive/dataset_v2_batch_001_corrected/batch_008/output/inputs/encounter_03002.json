{
  "schema_version": "1.0",
  "encounter_id": "03002",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.53,
      "duration_seconds": 5.4,
      "text": "Yeah, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.07,
      "end_seconds": 11.33,
      "duration_seconds": 4.26,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.65,
      "end_seconds": 16.9,
      "duration_seconds": 4.25,
      "text": "Yeah, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 25.47,
      "duration_seconds": 3.79,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.48,
      "end_seconds": 35.66,
      "duration_seconds": 8.18,
      "text": "It's bloating when I slip up, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.13,
      "end_seconds": 43.29,
      "duration_seconds": 3.16,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.11,
      "end_seconds": 46.09,
      "duration_seconds": 1.98,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.99,
      "end_seconds": 52.36,
      "duration_seconds": 5.37,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.7,
      "end_seconds": 81.35,
      "duration_seconds": 27.65,
      "text": "Ah, uh, yes, gluten. That makes it worse. Only avoiding gluten, and it's not much. I'm hoping you can tell me something definite. Oh, and mouth ulcers. Had that since last night. About mouth ulcers, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.16,
      "end_seconds": 84.73,
      "duration_seconds": 2.57,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.55,
      "end_seconds": 100.05,
      "duration_seconds": 2.5,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.43,
      "end_seconds": 125.98,
      "duration_seconds": 7.55,
      "text": "Okay: respiratory rate 16, pressure 108 over 68, pulse 82, oxygen saturation is 97 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.96,
      "end_seconds": 130.47,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.97,
      "end_seconds": 134.97,
      "duration_seconds": 3.0,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.39,
      "end_seconds": 148.65,
      "duration_seconds": 5.26,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 153.59,
      "duration_seconds": 2.56,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.19,
      "end_seconds": 169.17,
      "duration_seconds": 4.98,
      "text": "A few quick ones: weight loss, vomiting or bone pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.67,
      "end_seconds": 175.51,
      "duration_seconds": 4.84,
      "text": "No, no weight loss, vomiting or bone pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.1,
      "end_seconds": 179.39,
      "duration_seconds": 2.29,
      "text": "And diarrhoea, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.16,
      "end_seconds": 182.98,
      "duration_seconds": 1.82,
      "text": "No. No diarrhoea."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.26,
      "end_seconds": 186.11,
      "duration_seconds": 1.85,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.45,
      "end_seconds": 190.05,
      "duration_seconds": 2.6,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.86,
      "end_seconds": 208.49,
      "duration_seconds": 3.63,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.16,
      "end_seconds": 214.2,
      "duration_seconds": 4.04,
      "text": "Ah, he takes Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.52,
      "end_seconds": 225.67,
      "duration_seconds": 2.15,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.6,
      "end_seconds": 233.07,
      "duration_seconds": 5.47,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.3,
      "end_seconds": 236.46,
      "duration_seconds": 2.16,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.32,
      "end_seconds": 242.9,
      "duration_seconds": 4.58,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.46,
      "end_seconds": 247.98,
      "duration_seconds": 3.52,
      "text": "Okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.6,
      "end_seconds": 255.41,
      "duration_seconds": 5.81,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 258.51,
      "duration_seconds": 2.14,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.46,
      "end_seconds": 260.76,
      "duration_seconds": 1.3,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.5,
      "end_seconds": 274.24,
      "duration_seconds": 11.74,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.56,
      "end_seconds": 277.77,
      "duration_seconds": 2.21,
      "text": "Cat fur, I'd say."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.84,
      "end_seconds": 291.58,
      "duration_seconds": 12.74,
      "text": "Right, here's what I'm thinking. The most likely explanation is coeliac disease on a gluten-free diet with some accidental exposure. I'd also keep iron deficiency in mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.31,
      "end_seconds": 296.46,
      "duration_seconds": 3.15,
      "text": "So, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.45,
      "end_seconds": 312.6,
      "duration_seconds": 15.15,
      "text": "It's reasonable to be concerned, but right now coeliac disease on a gluten-free diet with some accidental exposure is my leading thought, not anything worse. Let's get coeliac antibodies, for coeliac follow-up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.52,
      "end_seconds": 316.83,
      "duration_seconds": 2.31,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.75,
      "end_seconds": 322.2,
      "duration_seconds": 3.45,
      "text": "Let's get a blood count, for coeliac follow-up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.04,
      "end_seconds": 328.85,
      "duration_seconds": 5.81,
      "text": "Let me think, you know, where would I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.1,
      "end_seconds": 342.4,
      "duration_seconds": 12.3,
      "text": "Check labels carefully and use separate toasters and chopping boards. One warning sign to remember: the symptoms get worse. In that case don't wait. I'd like you back in twelve months."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.18,
      "end_seconds": 347.24,
      "duration_seconds": 4.06,
      "text": "I, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.95,
      "end_seconds": 351.52,
      "duration_seconds": 3.57,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.04,
      "end_seconds": 355.12,
      "duration_seconds": 3.08,
      "text": "Erm, thank you, that's helpful."
    }
  ]
}