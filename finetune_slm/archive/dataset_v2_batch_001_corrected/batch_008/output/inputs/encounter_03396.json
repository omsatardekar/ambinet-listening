{
  "schema_version": "1.0",
  "encounter_id": "03396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 3.93,
      "duration_seconds": 2.98,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.8,
      "end_seconds": 8.58,
      "duration_seconds": 3.78,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.92,
      "end_seconds": 16.55,
      "duration_seconds": 6.63,
      "text": "Doctor, it's vomiting once or twice. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.45,
      "end_seconds": 21.44,
      "duration_seconds": 2.99,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.85,
      "end_seconds": 25.27,
      "duration_seconds": 2.42,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 30.89,
      "duration_seconds": 4.56,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.91,
      "end_seconds": 41.2,
      "duration_seconds": 9.29,
      "text": "It settles a little with sips of fluid. Mild, I'd say. And a mild tummy ache, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.5,
      "end_seconds": 45.92,
      "duration_seconds": 3.42,
      "text": "Okay, has there been loose stools too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.55,
      "end_seconds": 49.49,
      "duration_seconds": 2.94,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.17,
      "end_seconds": 70.49,
      "duration_seconds": 3.32,
      "text": "Any sign of blood in the stool?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.04,
      "end_seconds": 75.1,
      "duration_seconds": 3.06,
      "text": "No, no blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.66,
      "end_seconds": 80.25,
      "duration_seconds": 4.59,
      "text": "A few quick ones: high fever, drowsiness or no wet nappies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.81,
      "end_seconds": 87.05,
      "duration_seconds": 5.24,
      "text": "I haven't had high fever, drowsiness or no wet nappies, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.09,
      "end_seconds": 91.59,
      "duration_seconds": 3.5,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.17,
      "end_seconds": 94.55,
      "duration_seconds": 1.38,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.28,
      "end_seconds": 97.79,
      "duration_seconds": 2.51,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 101.97,
      "duration_seconds": 2.15,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.68,
      "end_seconds": 109.58,
      "duration_seconds": 3.9,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.69,
      "end_seconds": 122.3,
      "duration_seconds": 11.61,
      "text": "I've never touched a cigarette. I swim twice a week. I live with my elderly mother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.97,
      "end_seconds": 135.14,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.37,
      "end_seconds": 137.44,
      "duration_seconds": 1.07,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.39,
      "end_seconds": 142.87,
      "duration_seconds": 4.48,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.78,
      "end_seconds": 147.8,
      "duration_seconds": 4.02,
      "text": "I'm on sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.61,
      "end_seconds": 150.95,
      "duration_seconds": 2.34,
      "text": "Alright, and for how long?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.43,
      "end_seconds": 164.48,
      "duration_seconds": 12.05,
      "text": "Nearly five years now. Lansoprazole. I take it 30 milligrams, before breakfast. Oral rehydration solution. I take it 1 sachet, after each loose stool."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.5,
      "end_seconds": 170.54,
      "duration_seconds": 4.04,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.78,
      "end_seconds": 174.07,
      "duration_seconds": 2.29,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.79,
      "end_seconds": 180.5,
      "duration_seconds": 4.71,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.11,
      "end_seconds": 182.48,
      "duration_seconds": 1.37,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.93,
      "end_seconds": 188.43,
      "duration_seconds": 4.5,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.46,
      "end_seconds": 196.74,
      "duration_seconds": 6.28,
      "text": "I have migraines. I have acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 205.8,
      "duration_seconds": 7.98,
      "text": "I follow. Alright, migraines, that matches what I have here. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.15,
      "end_seconds": 214.45,
      "duration_seconds": 2.3,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.45,
      "end_seconds": 233.73,
      "duration_seconds": 10.28,
      "text": "Okay: SpO2 99 percent on room air, respiratory rate 17, temp 36.6 degrees. And heart rate 72, BP is 112 over 77."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.15,
      "end_seconds": 236.8,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.0,
      "end_seconds": 240.6,
      "duration_seconds": 2.6,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.44,
      "end_seconds": 247.07,
      "duration_seconds": 3.63,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 250.08,
      "duration_seconds": 1.66,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.04,
      "end_seconds": 263.85,
      "duration_seconds": 4.81,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.91,
      "end_seconds": 288.18,
      "duration_seconds": 20.27,
      "text": "That's all I needed to check. Okay, thinking it through, I'd lean towards a mild stomach bug. Let me repeat that back to make sure. You've had vomiting once or twice for about four days, mild, and no drowsiness or high fever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.46,
      "end_seconds": 291.26,
      "duration_seconds": 1.8,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.08,
      "end_seconds": 316.3,
      "duration_seconds": 12.22,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops. We'll catch up if he is not drinking. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.34,
      "end_seconds": 318.84,
      "duration_seconds": 1.5,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.72,
      "end_seconds": 322.66,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}