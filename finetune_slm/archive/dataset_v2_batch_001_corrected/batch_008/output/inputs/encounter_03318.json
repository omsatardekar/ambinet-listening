{
  "schema_version": "1.0",
  "encounter_id": "03318",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 2.32,
      "duration_seconds": 1.61,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.0,
      "end_seconds": 7.2,
      "duration_seconds": 4.2,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.83,
      "end_seconds": 11.16,
      "duration_seconds": 3.33,
      "text": "I've been feeling tired and weak."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.97,
      "end_seconds": 18.81,
      "duration_seconds": 2.84,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.16,
      "end_seconds": 33.51,
      "duration_seconds": 3.35,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 62.7,
      "duration_seconds": 16.54,
      "text": "Okay: pulse is 111 beats a minute, BMI works out to 20.3, BP is 97 over 60, temp 37.0 degrees, respiratory rate 18, height 172 centimetres, weight 60 kilos. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.2,
      "end_seconds": 72.5,
      "duration_seconds": 3.3,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.73,
      "end_seconds": 74.11,
      "duration_seconds": 1.38,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.73,
      "end_seconds": 80.32,
      "duration_seconds": 4.59,
      "text": "And craving salt as well, since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 85.02,
      "duration_seconds": 2.89,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.99,
      "end_seconds": 91.78,
      "duration_seconds": 4.79,
      "text": "Mm, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 97.24,
      "duration_seconds": 3.4,
      "text": "Have you noticed fainting, vomiting or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.37,
      "end_seconds": 100.29,
      "duration_seconds": 1.92,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.86,
      "end_seconds": 104.97,
      "duration_seconds": 3.11,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.33,
      "end_seconds": 107.84,
      "duration_seconds": 1.51,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.24,
      "end_seconds": 113.17,
      "duration_seconds": 3.93,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.62,
      "end_seconds": 116.42,
      "duration_seconds": 1.8,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.28,
      "end_seconds": 123.07,
      "duration_seconds": 4.79,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.7,
      "end_seconds": 126.34,
      "duration_seconds": 2.64,
      "text": "Mm, no allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.26,
      "end_seconds": 129.61,
      "duration_seconds": 2.35,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.14,
      "end_seconds": 139.75,
      "duration_seconds": 5.61,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.91,
      "end_seconds": 143.9,
      "duration_seconds": 2.99,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.89,
      "end_seconds": 148.31,
      "duration_seconds": 3.42,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.7,
      "end_seconds": 151.28,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.66,
      "end_seconds": 156.25,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.04,
      "end_seconds": 159.82,
      "duration_seconds": 2.78,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.32,
      "end_seconds": 165.24,
      "duration_seconds": 3.92,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 180.13,
      "duration_seconds": 4.4,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.74,
      "end_seconds": 187.68,
      "duration_seconds": 5.94,
      "text": "I take escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.5,
      "end_seconds": 203.1,
      "duration_seconds": 2.6,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.79,
      "end_seconds": 208.31,
      "duration_seconds": 3.52,
      "text": "I've had depression for five years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.4,
      "end_seconds": 216.95,
      "duration_seconds": 6.55,
      "text": "Hm, okay. Right, so depression is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.46,
      "end_seconds": 222.95,
      "duration_seconds": 4.49,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.93,
      "end_seconds": 243.59,
      "duration_seconds": 1.66,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.6,
      "end_seconds": 246.57,
      "duration_seconds": 1.97,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.53,
      "end_seconds": 275.34,
      "duration_seconds": 9.81,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 281.8,
      "duration_seconds": 2.0,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.55,
      "end_seconds": 321.38,
      "duration_seconds": 30.83,
      "text": "Let me tell you where I've got to. It fits best with possible adrenal insufficiency. Let's get a morning cortisol, for possible adrenal insufficiency. Drink fluids and eat salty foods until the results, and come in if you vomit. We'll refer you to the endocrine clinic. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'd like you back after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.44,
      "end_seconds": 325.24,
      "duration_seconds": 2.8,
      "text": "Well, alright, thanks, take care."
    }
  ]
}