      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.43,
      "end_seconds": 62.12,
      "duration_seconds": 2.69,
      "text": "I've had it for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.8,
      "end_seconds": 66.1,
      "duration_seconds": 3.3,
      "text": "How much trouble does it give you?"
