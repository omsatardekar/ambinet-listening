      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 201.42,
      "duration_seconds": 1.21,
      "text": "okay what else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.99,
      "end_seconds": 209.68,
      "duration_seconds": 6.69,
      "text": "Right, so epilepsy is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.92,
      "end_seconds": 221.41,
      "duration_seconds": 4.49,
      "text": "Any allergies to to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.34,
      "end_seconds": 231.86,
      "duration_seconds": 8.52,
      "text": "Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.89,
      "end_seconds": 236.65,
      "duration_seconds": 3.76,
      "text": "so, time for your numbers, if that's okay"
