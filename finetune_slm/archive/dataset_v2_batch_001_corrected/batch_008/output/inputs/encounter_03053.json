    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.35,
      "end_seconds": 311.19,
      "duration_seconds": 10.84,
      "text": "The creases in your palms and your scars are darker than they should be and your blood pressure drops when you stand."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.09,
      "end_seconds": 318.84,
      "duration_seconds": 2.75,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.82,
      "end_seconds": 367.99,
      "duration_seconds": 35.17,
      "text": "so where does that leave us? It's hard to say. Possible adrenal insufficiency is one possibility and an underactive thyroid another and I'd rather not commit yet i'm going to to order a morning cortisol for Possible adrenal insufficiency drink fluids and eat salty foods until the results and come in if you vomit cut down on salt and fried food for now it really does make a difference i think the endocrine clinic should see you too"
    },
    {
