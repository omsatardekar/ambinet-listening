    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.56,
      "end_seconds": 144.92,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother"
