      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.03,
      "end_seconds": 268.89,
      "duration_seconds": 5.86,
      "text": "okay: heart rate 112, temperature 37.0, blood pressure 103 over 58."
