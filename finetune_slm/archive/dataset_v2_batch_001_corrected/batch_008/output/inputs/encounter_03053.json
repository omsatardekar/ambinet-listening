    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.62,
      "end_seconds": 68.35,
      "duration_seconds": 1.73,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.77,
      "end_seconds": 72.79,
      "duration_seconds": 4.02,
      "text": "right, right does anything else come with it?"
