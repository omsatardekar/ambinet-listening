    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.91,
      "end_seconds": 150.21,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
