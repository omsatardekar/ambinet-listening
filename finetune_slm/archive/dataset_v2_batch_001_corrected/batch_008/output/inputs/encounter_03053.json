    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.83,
      "end_seconds": 55.3,
      "duration_seconds": 8.47,
      "text": "About two years. It's sodium valproate, 500 milligrams, twice a day for the fits, doctor."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.53,
      "end_seconds": 58.56,
      "duration_seconds": 2.03,
      "text": "Did it come on recently?"
