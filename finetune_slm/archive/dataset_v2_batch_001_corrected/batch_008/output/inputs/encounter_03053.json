    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.22,
      "end_seconds": 84.56,
      "duration_seconds": 10.34,
      "text": "when it starts I tend to get dizziness on standing as well about dizziness on standing, standing definitely sets it off"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.3,
      "end_seconds": 90.76,
      "duration_seconds": 5.46,
      "text": "So, have you had darker skin before, or is this the first time?"
