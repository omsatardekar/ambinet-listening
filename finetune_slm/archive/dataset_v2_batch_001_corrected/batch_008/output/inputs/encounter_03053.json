    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.23,
      "end_seconds": 139.61,
      "duration_seconds": 3.38,
      "text": "are you on your own at home?"
