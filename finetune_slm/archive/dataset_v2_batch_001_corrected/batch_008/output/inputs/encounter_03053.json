      "role": "DOCTOR",
      "start_seconds": 272.62,
      "end_seconds": 276.42,
      "duration_seconds": 3.8,
      "text": "they help me see the whole picture more shortly"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.79,
      "end_seconds": 282.4,
      "duration_seconds": 4.61,
      "text": "right now I'm going to do a a short physical check"
