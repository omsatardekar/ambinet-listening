      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.01,
      "end_seconds": 199.54,
      "duration_seconds": 6.53,
      "text": "I have diabetes for nearly five years. I have epilepsy for about a year"
