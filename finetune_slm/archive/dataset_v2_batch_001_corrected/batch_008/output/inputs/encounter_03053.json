    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.7,
      "end_seconds": 21.9,
      "duration_seconds": 6.2,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.2,
      "end_seconds": 28.08,
      "duration_seconds": 4.88,
      "text": "Of course please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.15,
      "end_seconds": 34.08,
      "duration_seconds": 4.93,
      "text": "um, so... darker skin that's why I came"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.48,
      "end_seconds": 37.86,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines please."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.26,
      "end_seconds": 42.99,
      "duration_seconds": 3.73,
      "text": "He takes metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.76,
      "end_seconds": 45.98,
      "duration_seconds": 2.22,
      "text": "When did you start it?"
