    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.97,
      "end_seconds": 97.06,
      "duration_seconds": 5.09,
      "text": "I had a similar thing last year. It It went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.32,
      "end_seconds": 103.1,
      "duration_seconds": 4.78,
      "text": "Have you noticed fainting, vomiting, severe tummy pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.85,
      "end_seconds": 110.03,
      "duration_seconds": 6.18,
      "text": "no fainting, vomiting, severe tummy pain or fever, none of it"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.46,
      "end_seconds": 114.28,
      "duration_seconds": 2.82,
      "text": "okay, is your digestion otherwise okay?"
