{
  "schema_version": "1.0",
  "encounter_id": "03498",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 3.11,
      "duration_seconds": 2.05,
      "text": "Good morning grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.5,
      "end_seconds": 7.95,
      "duration_seconds": 3.45,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.64,
      "end_seconds": 13.51,
      "duration_seconds": 3.87,
      "text": "Mm doctor thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.97,
      "end_seconds": 21.32,
      "duration_seconds": 6.35,
      "text": "Please do. Extra information is always welcome. Is it your first time here?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.28,
      "end_seconds": 28.82,
      "duration_seconds": 5.54,
      "text": "oh, no, I came last year for something else"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 31.29,
      "duration_seconds": 1.95,
      "text": "Okay, what's the problem?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 33.09,
      "end_seconds": 39.01,
      "duration_seconds": 5.92,
      "text": "Yeah, uh, doctor, it's been sweating. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.26,
      "end_seconds": 41.93,
      "duration_seconds": 1.67,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.75,
      "end_seconds": 47.42,
      "duration_seconds": 4.67,
      "text": "about about a month, uh, give or take"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.21,
      "end_seconds": 52.63,
      "duration_seconds": 4.42,
      "text": "Well, it was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.57,
      "end_seconds": 58.69,
      "duration_seconds": 4.12,
      "text": "okay, so roughly one to two months is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.61,
      "end_seconds": 63.64,
      "duration_seconds": 3.03,
      "text": "um that sounds about right"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.44,
      "end_seconds": 69.14,
      "duration_seconds": 3.7,
      "text": "Alright, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.76,
      "end_seconds": 73.69,
      "duration_seconds": 3.93,
      "text": "about a a three out of ten"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.47,
      "end_seconds": 76.84,
      "duration_seconds": 2.37,
      "text": "how often do you get it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.85,
      "end_seconds": 81.37,
      "duration_seconds": 3.52,
      "text": "honestly, once or twice a day"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.1,
      "end_seconds": 90.17,
      "duration_seconds": 8.07,
      "text": "Actually, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 90.27,
      "end_seconds": 95.63,
      "duration_seconds": 5.36,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.96,
      "end_seconds": 103.58,
      "duration_seconds": 6.62,
      "text": "I was getting to that! Oh, and shaking. Had that since Friday"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.43,
      "end_seconds": 108.24,
      "duration_seconds": 2.81,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.2,
      "end_seconds": 111.75,
      "duration_seconds": 2.55,
      "text": "I'd say on and off"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.1,
      "end_seconds": 116.92,
      "duration_seconds": 3.82,
      "text": "so, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.34,
      "end_seconds": 123.48,
      "duration_seconds": 5.14,
      "text": "uh, you know, pretty mild, if I'm being honest"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.41,
      "end_seconds": 129.71,
      "duration_seconds": 4.3,
      "text": "Have you been sweating at any time before this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.17,
      "end_seconds": 137.25,
      "duration_seconds": 6.08,
      "text": "I, I had a similar thing last year it went away"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.2,
      "end_seconds": 140.36,
      "duration_seconds": 2.16,
      "text": "tell me your medicines please"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.85,
      "end_seconds": 158.75,
      "duration_seconds": 16.9,
      "text": "Allopurinol, 100 milligrams, once a day for the gout. I kept putting it off, which I know isn't sensible. Metoprolol, 50 milligrams, twice a day for my heart"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 163.25,
      "duration_seconds": 3.44,
      "text": "how long has that that been going on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.52,
      "end_seconds": 169.65,
      "duration_seconds": 2.13,
      "text": "about about a year"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.93,
      "end_seconds": 179.58,
      "duration_seconds": 8.65,
      "text": "Oh, it's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.09,
      "end_seconds": 183.08,
      "duration_seconds": 2.99,
      "text": "Okay do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.13,
      "end_seconds": 202.71,
      "duration_seconds": 17.58,
      "text": "let me think, for the joint pain, I believe my daughter sets them out for me, I just take what I'm given i take amlodipine, 5 milligrams, once a day"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 205.79,
      "duration_seconds": 2.08,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.66,
      "end_seconds": 213.86,
      "duration_seconds": 6.2,
      "text": "ah, uh, I had my tonsils removed as a teenager"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.74,
      "end_seconds": 218.6,
      "duration_seconds": 2.86,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.2,
      "end_seconds": 223.85,
      "duration_seconds": 3.65,
      "text": "I have gout, for about a year"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.88,
      "end_seconds": 227.88,
      "duration_seconds": 2.0,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.59,
      "end_seconds": 238.3,
      "duration_seconds": 8.71,
      "text": "I have heart disease. Yes arthritis in my knees. I I have high blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.12,
      "end_seconds": 245.85,
      "duration_seconds": 6.73,
      "text": "mm okay. Alright heart disease and high blood pressure that matches what I have here"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.09,
      "end_seconds": 258.92,
      "duration_seconds": 4.83,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.39,
      "end_seconds": 264.14,
      "duration_seconds": 3.75,
      "text": "no, I'm not allergic to to anything"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 265.01,
      "end_seconds": 273.65,
      "duration_seconds": 8.64,
      "text": "Actually, I remember he had some kinda reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.57,
      "end_seconds": 279.62,
      "duration_seconds": 4.05,
      "text": "hmm, you know, I don't remember that"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.38,
      "end_seconds": 285.75,
      "duration_seconds": 5.37,
      "text": "right, fair enough, I'll write down both versions. Do you live by yourself?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.51,
      "end_seconds": 292.51,
      "duration_seconds": 5.0,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.41,
      "end_seconds": 299.26,
      "duration_seconds": 3.85,
      "text": "Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.5,
      "end_seconds": 304.66,
      "duration_seconds": 4.16,
      "text": "my brother has epilepsy. My grandmother had dementia"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.93,
      "end_seconds": 324.44,
      "duration_seconds": 3.51,
      "text": "Have you noticed seeing things, confusion or seizure?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.05,
      "end_seconds": 341.08,
      "duration_seconds": 16.03,
      "text": "yeah, you know, no, no seeing things, no confusion, no seizure i did have being unable to sleep at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.77,
      "end_seconds": 344.44,
      "duration_seconds": 1.67,
      "text": "what about vomiting blood?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.31,
      "end_seconds": 347.35,
      "duration_seconds": 2.04,
      "text": "no no vomiting blood"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.86,
      "end_seconds": 351.33,
      "duration_seconds": 2.47,
      "text": "Okay is your chest okay generally?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.14,
      "end_seconds": 353.86,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.96,
      "end_seconds": 358.19,
      "duration_seconds": 3.23,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.36,
      "end_seconds": 370.36,
      "duration_seconds": 3.0,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 389.2,
      "end_seconds": 397.09,
      "duration_seconds": 7.89,
      "text": "okay: respiratory rate 20, pulse is 115 beats a minute, BP is 126 over 83, temperature 37.0."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.12,
      "end_seconds": 400.72,
      "duration_seconds": 1.6,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.34,
      "end_seconds": 403.76,
      "duration_seconds": 2.42,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.41,
      "end_seconds": 409.33,
      "duration_seconds": 3.92,
      "text": "I'll examine you in a a second make yourself comfortable."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 411.11,
      "end_seconds": 412.11,
      "duration_seconds": 1.0,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 413.29,
      "end_seconds": 414.62,
      "duration_seconds": 1.33,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 430.46,
      "end_seconds": 436.32,
      "duration_seconds": 5.86,
      "text": "you have a coarse tremor a a fast pulse and you are sweating"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 440.88,
      "end_seconds": 451.71,
      "duration_seconds": 10.83,
      "text": "Good, you can sit up again. Let me tell you where I've got to. This looks most like alcohol withdrawal. An anxiety state is still possible."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 453.42,
      "end_seconds": 455.87,
      "duration_seconds": 2.45,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 456.39,
      "end_seconds": 471.6,
      "duration_seconds": 15.21,
      "text": "It's reasonable to be concerned, but right now alcohol withdrawal is my leading thought, not anything worse. Let me repeat that back to make sure. You've been sweating, and no seeing things or vomiting blood."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 473.04,
      "end_seconds": 474.78,
      "duration_seconds": 1.74,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 475.34,
      "end_seconds": 479.84,
      "duration_seconds": 4.5,
      "text": "I'm sending you for blood tests because of alcohol withdrawal."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 481.01,
      "end_seconds": 485.22,
      "duration_seconds": 4.21,
      "text": "I can book that for Tuesday at 3:30 pm"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 486.87,
      "end_seconds": 507.81,
      "duration_seconds": 20.94,
      "text": "We'll begin with chlordiazepoxide 20 milligrams four times a day reducing over five days. It's for alcohol withdrawal. We'll begin with thiamine 100 milligrams three times a day long term. It's for alcohol-related deficiency. Do not stop alcohol suddenly without medical support. I think the the alcohol liaison service should see you too."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 512.36,
      "end_seconds": 516.91,
      "duration_seconds": 4.55,
      "text": "so, um, sure, where do I go?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 518.19,
      "end_seconds": 524.37,
      "duration_seconds": 6.18,
      "text": "One warning sign to to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 525.36,
      "end_seconds": 527.23,
      "duration_seconds": 1.87,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 528.89,
      "end_seconds": 535.6,
      "duration_seconds": 6.71,
      "text": "Come back in two days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 537.68,
      "end_seconds": 539.52,
      "duration_seconds": 1.84,
      "text": "That's clear thanks."
    }
  ]
}