  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.63,
      "duration_seconds": 4.3,
      "text": "Hmm, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.81,
      "duration_seconds": 3.99,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.48,
      "end_seconds": 18.55,
      "duration_seconds": 6.07,
      "text": "Sorry, what was I saying, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 21.74,
      "duration_seconds": 2.54,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.04,
      "end_seconds": 31.37,
      "duration_seconds": 8.33,
      "text": "It's a pearly bump on my nose that bleeds, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.36,
      "end_seconds": 35.48,
      "duration_seconds": 2.12,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.27,
      "end_seconds": 39.39,
      "duration_seconds": 3.12,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.14,
      "end_seconds": 45.77,
      "duration_seconds": 4.63,
      "text": "I think it's been nearer two weeks, um, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.82,
      "end_seconds": 51.4,
      "duration_seconds": 4.58,
      "text": "okay, so roughly one to two weeks is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 55.66,
      "duration_seconds": 2.74,
      "text": "That That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.33,
      "end_seconds": 57.98,
      "duration_seconds": 1.65,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.0,
      "end_seconds": 64.96,
      "duration_seconds": 4.96,
      "text": "So, washing definitely sets it off. Oh, and crusting."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.74,
      "end_seconds": 69.13,
      "duration_seconds": 3.39,
      "text": "any a sore that won't heal as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.01,
      "end_seconds": 73.28,
      "duration_seconds": 2.27,
      "text": "Yes, for two days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.12,
      "end_seconds": 78.55,
      "duration_seconds": 3.43,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 80.18,
      "duration_seconds": 1.03,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 88.52,
      "duration_seconds": 6.59,
      "text": "Have you had any other new lumps, family history of skin cancer, swollen glands or pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.01,
      "end_seconds": 97.22,
      "duration_seconds": 7.21,
      "text": "No, no other new lumps, family history of skin cancer, swollen glands or pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.9,
      "end_seconds": 102.7,
      "duration_seconds": 3.8,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.03,
      "end_seconds": 109.46,
      "duration_seconds": 5.43,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.57,
      "end_seconds": 111.99,
      "duration_seconds": 1.42,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.64,
      "end_seconds": 116.59,
      "duration_seconds": 2.95,
      "text": "Erm, no, that's all normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.03,
      "end_seconds": 136.68,
      "duration_seconds": 6.65,
      "text": "What do you take on a normal day? I ask cos it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.3,
      "end_seconds": 141.71,
      "duration_seconds": 3.41,
      "text": "I take lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 143.39,
      "end_seconds": 153.93,
      "duration_seconds": 10.54,
      "text": "Doctor, um, I think the last prescription for the lansoprazole was 15 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 158.61,
      "duration_seconds": 4.08,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.45,
      "end_seconds": 171.37,
      "duration_seconds": 11.92,
      "text": "sorry, um, what was I saying, not with me. I'll bring it next time. I take hydrocortisone cream, when needed for the eczema"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 187.25,
      "duration_seconds": 3.15,
      "text": "okay, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.95,
      "end_seconds": 193.31,
      "duration_seconds": 5.36,
      "text": "okay, so I've had acid reflux, yes i've had eczema, yes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.2,
      "end_seconds": 203.58,
      "duration_seconds": 9.38,
      "text": "Right, right. Yes, acid reflux is known to us, good to have that clear. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.19,
      "end_seconds": 206.53,
      "duration_seconds": 2.34,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.19,
      "end_seconds": 218.2,
      "duration_seconds": 7.01,
      "text": "Any allergies to tablets, food or anything in the environment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.69,
      "end_seconds": 229.85,
      "duration_seconds": 10.16,
      "text": "I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.28,
      "end_seconds": 244.62,
      "duration_seconds": 3.34,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.33,
      "end_seconds": 257.31,
      "duration_seconds": 11.98,
      "text": "I gave up cigarettes last spring. I do a yoga class on Thursdays. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.0,
      "end_seconds": 260.87,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.33,
      "end_seconds": 277.23,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.64,
      "end_seconds": 305.23,
      "duration_seconds": 11.59,
      "text": "Okay: temp 36.8 degrees, respiratory rate 15, blood pressure 122 over 74, pulse is 70 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.36,
      "end_seconds": 309.8,
      "duration_seconds": 3.44,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.73,
      "end_seconds": 313.55,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.35,
      "end_seconds": 331.77,
      "duration_seconds": 8.42,
      "text": "there is a pearly nodule with fine surface vessels and a central dip on the side of the nose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.54,
      "end_seconds": 348.3,
      "duration_seconds": 12.76,
      "text": "you can relax now from what you've told me and what I found, the most likely explanation is a likely basal cell carcinoma i can't rule out a squamous cell carcinoma yet"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.52,
      "end_seconds": 352.83,
      "duration_seconds": 3.31,
      "text": "yeah, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.62,
      "end_seconds": 378.86,
      "duration_seconds": 25.24,
      "text": "I understand the worry. At the moment I'd say it's a likely basal cell carcinoma, and we'll know more once the a skin biopsy is back. Stop me if I've got anything wrong. You've had a pearly bump on your nose that bleeds, and no family history of skin cancer or swollen glands."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.12,
      "end_seconds": 385.82,
      "duration_seconds": 0.7,
      "text": "exactly"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.62,
      "end_seconds": 421.1,
      "duration_seconds": 33.48,
      "text": "I'll request a skin biopsy, it'll help with suspicious lesion i'll request a dermoscopy, it'll help with suspicious lesion the result will help us decide whether anything more is needed please use a high-factor sunscreen and a hat if you smoke, this is a good moment to think about stopping, and we can help you with that let's get you seen by the skin cancer clinic, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.6,
      "end_seconds": 432.43,
      "duration_seconds": 9.83,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.0,
      "end_seconds": 439.61,
      "duration_seconds": 1.61,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.36,
      "end_seconds": 450.99,
      "duration_seconds": 10.63,
      "text": "If the symptoms get worse, that's the point to come in urgently. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.96,
      "end_seconds": 456.94,
      "duration_seconds": 3.98,
      "text": "okay, that makes sense. Thanks for explaining"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.74,
      "end_seconds": 460.18,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}