{
  "schema_version": "1.0",
  "encounter_id": "03138",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 5.89,
      "duration_seconds": 5.16,
      "text": "Um, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.91,
      "end_seconds": 13.3,
      "duration_seconds": 5.39,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.47,
      "end_seconds": 20.54,
      "duration_seconds": 6.07,
      "text": "Honestly, it's flakes on my shoulders, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.28,
      "end_seconds": 25.64,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.71,
      "end_seconds": 32.28,
      "duration_seconds": 2.57,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.61,
      "end_seconds": 37.2,
      "duration_seconds": 3.59,
      "text": "Right, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.0,
      "end_seconds": 42.24,
      "duration_seconds": 3.24,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.98,
      "end_seconds": 46.3,
      "duration_seconds": 3.32,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.99,
      "end_seconds": 60.44,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.46,
      "end_seconds": 91.53,
      "duration_seconds": 14.07,
      "text": "Okay: weight 54 kilos, height 180 centimetres, temperature is 36.7 degrees, pressure 119 over 78, oxygen saturation is 99 percent, BMI works out to 16.7, heart rate 64."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.47,
      "end_seconds": 94.98,
      "duration_seconds": 1.51,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.92,
      "end_seconds": 99.56,
      "duration_seconds": 3.64,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.24,
      "end_seconds": 105.27,
      "duration_seconds": 3.03,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.27,
      "end_seconds": 108.2,
      "duration_seconds": 0.93,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.99,
      "end_seconds": 112.12,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 129.33,
      "duration_seconds": 5.89,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.05,
      "end_seconds": 130.75,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.87,
      "end_seconds": 139.08,
      "duration_seconds": 3.21,
      "text": "You can relax now. Nothing like hair loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.18,
      "end_seconds": 145.4,
      "duration_seconds": 2.22,
      "text": "No, no hair loss."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.37,
      "end_seconds": 152.11,
      "duration_seconds": 5.74,
      "text": "Let me check a few things. Any pain, pus or rash elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.19,
      "end_seconds": 156.71,
      "duration_seconds": 2.52,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.27,
      "end_seconds": 161.79,
      "duration_seconds": 4.52,
      "text": "Mm-hmm. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.34,
      "end_seconds": 164.73,
      "duration_seconds": 2.39,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.52,
      "end_seconds": 177.88,
      "duration_seconds": 3.36,
      "text": "Okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.63,
      "end_seconds": 183.38,
      "duration_seconds": 4.75,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.36,
      "end_seconds": 186.74,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.44,
      "end_seconds": 192.77,
      "duration_seconds": 5.33,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.62,
      "end_seconds": 196.85,
      "duration_seconds": 2.23,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.53,
      "end_seconds": 201.66,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.22,
      "end_seconds": 222.77,
      "duration_seconds": 4.55,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.52,
      "end_seconds": 234.23,
      "duration_seconds": 6.71,
      "text": "Not currently, but as a youngster amoxicillin gave me a rash all over."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 247.59,
      "duration_seconds": 4.24,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.65,
      "end_seconds": 251.67,
      "duration_seconds": 3.02,
      "text": "An anti-dandruff shampoo, twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.88,
      "end_seconds": 265.81,
      "duration_seconds": 2.93,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.61,
      "end_seconds": 269.8,
      "duration_seconds": 2.19,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.71,
      "end_seconds": 274.43,
      "duration_seconds": 3.72,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.37,
      "end_seconds": 278.05,
      "duration_seconds": 1.68,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.52,
      "end_seconds": 304.15,
      "duration_seconds": 24.63,
      "text": "Let me tell you where I've got to. It's hard to say. Simple dandruff is one possibility and seborrhoeic dermatitis another, and I'd rather not commit yet. Let's use ketoconazole shampoo, 2%, twice a week, four weeks. That should help with dandruff. Leave the shampoo on for five minutes before rinsing. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.4,
      "end_seconds": 307.63,
      "duration_seconds": 2.23,
      "text": "Thank you, that's helpful."
    }
  ]
}