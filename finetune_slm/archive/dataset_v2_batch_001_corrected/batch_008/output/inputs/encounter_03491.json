{
  "schema_version": "1.0",
  "encounter_id": "03491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.74,
      "duration_seconds": 4.1,
      "text": "actually, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 9.77,
      "duration_seconds": 3.7,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.13,
      "end_seconds": 17.36,
      "duration_seconds": 6.23,
      "text": "Let me think morning doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.86,
      "end_seconds": 21.78,
      "duration_seconds": 3.92,
      "text": "good that'll be useful pull up a chair"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.55,
      "end_seconds": 30.33,
      "duration_seconds": 2.78,
      "text": "I'm here because of shaking"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.95,
      "end_seconds": 33.23,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.73,
      "end_seconds": 35.57,
      "duration_seconds": 1.84,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 39.96,
      "duration_seconds": 2.93,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.5,
      "end_seconds": 51.71,
      "duration_seconds": 11.21,
      "text": "It usually comes with being unable to sleep. And I've been feeling anxious and agitated as well, for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.66,
      "end_seconds": 57.51,
      "duration_seconds": 1.85,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.25,
      "end_seconds": 61.54,
      "duration_seconds": 2.29,
      "text": "Yeah. Three days I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.67,
      "end_seconds": 67.22,
      "duration_seconds": 4.55,
      "text": "have you had shaking before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.18,
      "end_seconds": 76.08,
      "duration_seconds": 6.9,
      "text": "right, I had a similar thing a couple of years ago. It went away"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.76,
      "end_seconds": 93.76,
      "duration_seconds": 3.0,
      "text": "any seeing things vomiting blood or seizure?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.32,
      "end_seconds": 98.39,
      "duration_seconds": 3.07,
      "text": "nope you know nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.97,
      "end_seconds": 101.23,
      "duration_seconds": 2.26,
      "text": "have you had any confusion?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.05,
      "end_seconds": 103.68,
      "duration_seconds": 1.63,
      "text": "no confusion, thankfully"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.39,
      "end_seconds": 108.05,
      "duration_seconds": 2.66,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.2,
      "end_seconds": 110.95,
      "duration_seconds": 1.75,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.77,
      "end_seconds": 113.75,
      "duration_seconds": 1.98,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.08,
      "end_seconds": 120.23,
      "duration_seconds": 5.15,
      "text": "yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.19,
      "end_seconds": 135.36,
      "duration_seconds": 3.17,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.74,
      "end_seconds": 141.28,
      "duration_seconds": 4.54,
      "text": "My father had bowel cancer. My son has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.28,
      "end_seconds": 148.22,
      "duration_seconds": 4.94,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.04,
      "end_seconds": 152.98,
      "duration_seconds": 2.94,
      "text": "it's diclofenac 50 milligrams when needed"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 154.39,
      "end_seconds": 162.62,
      "duration_seconds": 8.23,
      "text": "he is supposed to take it when needed, but I can't say he always does"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.21,
      "end_seconds": 170.06,
      "duration_seconds": 5.85,
      "text": "It's thyroxine, 75 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.0,
      "end_seconds": 175.56,
      "duration_seconds": 3.56,
      "text": "is the packet here, or the the prescription?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.14,
      "end_seconds": 179.16,
      "duration_seconds": 3.02,
      "text": "no, you know, it's at home"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 188.21,
      "duration_seconds": 7.42,
      "text": "any health conditions I should have on record? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.71,
      "end_seconds": 202.89,
      "duration_seconds": 9.18,
      "text": "Arthritis in my knees, for two years work has been very busy so I kept ignoring it"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.9,
      "end_seconds": 206.75,
      "duration_seconds": 1.85,
      "text": "I see, go ahead"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.15,
      "end_seconds": 210.95,
      "duration_seconds": 2.8,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.54,
      "end_seconds": 224.6,
      "duration_seconds": 12.06,
      "text": "Sure. Yes, arthritis in your knees and an underactive thyroid are known to to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.93,
      "end_seconds": 230.65,
      "duration_seconds": 4.72,
      "text": "Yeah, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.9,
      "end_seconds": 248.82,
      "duration_seconds": 1.92,
      "text": "alright and your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.7,
      "end_seconds": 256.0,
      "duration_seconds": 3.3,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.06,
      "end_seconds": 259.5,
      "duration_seconds": 2.44,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.08,
      "end_seconds": 265.44,
      "duration_seconds": 4.36,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.95,
      "end_seconds": 270.14,
      "duration_seconds": 3.19,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.02,
      "end_seconds": 286.38,
      "duration_seconds": 2.36,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.85,
      "end_seconds": 305.39,
      "duration_seconds": 9.54,
      "text": "Okay: oxygen saturation is 97 percent BP is 126 over 73 temperature 36.7. And pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.13,
      "end_seconds": 307.62,
      "duration_seconds": 1.49,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.29,
      "end_seconds": 317.01,
      "duration_seconds": 3.72,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.47,
      "end_seconds": 322.3,
      "duration_seconds": 3.83,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.25,
      "end_seconds": 324.98,
      "duration_seconds": 1.73,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.44,
      "end_seconds": 340.25,
      "duration_seconds": 5.81,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.66,
      "end_seconds": 357.85,
      "duration_seconds": 14.19,
      "text": "that's the examination finished. Okay, thinking it through, this looks most like alcohol withdrawal. An anxiety state is still possible. So, to recap quickly. You've had shaking for six months, and no confusion or seizure"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.73,
      "end_seconds": 360.61,
      "duration_seconds": 1.88,
      "text": "yes you've got it"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.68,
      "end_seconds": 375.44,
      "duration_seconds": 13.76,
      "text": "Let's book blood tests to look into alcohol withdrawal. For this, chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. That should help with alcohol withdrawal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.23,
      "end_seconds": 377.77,
      "duration_seconds": 1.54,
      "text": "Thank you doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.76,
      "end_seconds": 393.7,
      "duration_seconds": 14.94,
      "text": "Do not stop alcohol suddenly without medical support. I think the alcohol liaison service should see you too. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.62,
      "end_seconds": 398.72,
      "duration_seconds": 3.1,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.16,
      "end_seconds": 407.32,
      "duration_seconds": 7.16,
      "text": "If the symptoms get worse that's the point to come in urgently. Let's review you in two days."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.83,
      "end_seconds": 410.71,
      "duration_seconds": 1.88,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.06,
      "end_seconds": 416.6,
      "duration_seconds": 4.54,
      "text": "Right that's the plan. Do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.64,
      "end_seconds": 421.48,
      "duration_seconds": 3.84,
      "text": "Right, I think I understand everything. Thanks."
    }
  ]
}