{
  "schema_version": "1.0",
  "encounter_id": "03393",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 10.26,
      "duration_seconds": 9.69,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.23,
      "end_seconds": 17.32,
      "duration_seconds": 5.09,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.03,
      "end_seconds": 24.56,
      "duration_seconds": 6.53,
      "text": "Well, doctor, it's a bit tired sometimes. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.25,
      "end_seconds": 29.13,
      "duration_seconds": 2.88,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.05,
      "end_seconds": 31.97,
      "duration_seconds": 1.92,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.76,
      "end_seconds": 36.1,
      "duration_seconds": 3.34,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.02,
      "end_seconds": 40.82,
      "duration_seconds": 2.8,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 45.31,
      "duration_seconds": 3.19,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.16,
      "end_seconds": 51.71,
      "duration_seconds": 5.55,
      "text": "When it starts I tend to get brittle nails as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.3,
      "end_seconds": 54.98,
      "duration_seconds": 2.68,
      "text": "Has there been being vegetarian too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.94,
      "end_seconds": 59.15,
      "duration_seconds": 3.21,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.9,
      "end_seconds": 64.2,
      "duration_seconds": 3.3,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.81,
      "end_seconds": 67.5,
      "duration_seconds": 1.69,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.18,
      "end_seconds": 74.82,
      "duration_seconds": 5.64,
      "text": "have you had a bit tired sometimes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 86.81,
      "duration_seconds": 9.96,
      "text": "Yeah, yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 88.79,
      "end_seconds": 100.66,
      "duration_seconds": 11.87,
      "text": "Here are the numbers, doctor. Pulse is 75 beats a minute, blood pressure 124 over 82, temperature is 36.6 degrees, SpO2 97 percent on room air, respiratory rate 18."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.15,
      "end_seconds": 103.74,
      "duration_seconds": 1.59,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.12,
      "end_seconds": 110.65,
      "duration_seconds": 4.53,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.43,
      "end_seconds": 113.64,
      "duration_seconds": 1.21,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.35,
      "end_seconds": 132.03,
      "duration_seconds": 5.68,
      "text": "Your pulse and blood pressure are normal and the eyelids are a good colour."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.19,
      "end_seconds": 136.82,
      "duration_seconds": 2.63,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.52,
      "end_seconds": 157.51,
      "duration_seconds": 4.99,
      "text": "Let me check a few things. Any black stools or dizziness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.32,
      "end_seconds": 161.63,
      "duration_seconds": 2.31,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.21,
      "end_seconds": 166.48,
      "duration_seconds": 4.27,
      "text": "Let me check a few things. Any heavy periods or breathlessness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.98,
      "end_seconds": 171.79,
      "duration_seconds": 3.81,
      "text": "I haven't had heavy periods or breathlessness, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.05,
      "end_seconds": 176.12,
      "duration_seconds": 3.07,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.26,
      "end_seconds": 180.88,
      "duration_seconds": 3.62,
      "text": "so, you know, I move fine otherwise"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.78,
      "end_seconds": 187.62,
      "duration_seconds": 5.84,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.64,
      "end_seconds": 191.84,
      "duration_seconds": 2.2,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.9,
      "end_seconds": 195.66,
      "duration_seconds": 2.76,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.78,
      "end_seconds": 204.35,
      "duration_seconds": 7.57,
      "text": "I had my tonsils removed as a teenager. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.23,
      "end_seconds": 209.12,
      "duration_seconds": 3.89,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.07,
      "end_seconds": 213.46,
      "duration_seconds": 3.39,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.66,
      "end_seconds": 225.03,
      "duration_seconds": 2.37,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.85,
      "end_seconds": 231.0,
      "duration_seconds": 4.15,
      "text": "I take febuxostat, 80 milligrams, once a day"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.48,
      "end_seconds": 235.06,
      "duration_seconds": 2.58,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.01,
      "end_seconds": 244.67,
      "duration_seconds": 7.66,
      "text": "about six months right, I had allopurinol at one point, but I'm off it now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.18,
      "end_seconds": 247.8,
      "duration_seconds": 2.62,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.79,
      "end_seconds": 267.97,
      "duration_seconds": 14.18,
      "text": "I'm a hairdresser, on my feet all day. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.54,
      "end_seconds": 272.53,
      "duration_seconds": 3.99,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.81,
      "end_seconds": 280.2,
      "duration_seconds": 2.39,
      "text": "I, I have gout."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.17,
      "end_seconds": 284.37,
      "duration_seconds": 3.2,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 285.73,
      "end_seconds": 288.2,
      "duration_seconds": 2.47,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.53,
      "end_seconds": 315.08,
      "duration_seconds": 10.55,
      "text": "Taking everything into account, it points towards mildly low iron stores risk from diet. Eat pulses, leafy greens and vitamin-C rich foods with meals."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.51,
      "end_seconds": 323.07,
      "duration_seconds": 7.56,
      "text": "sure if the symptoms get worse, or you feel really unwell, please come to the emergency department"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.35,
      "end_seconds": 329.84,
      "duration_seconds": 1.49,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.83,
      "end_seconds": 337.3,
      "duration_seconds": 6.47,
      "text": "Let's review you after the results. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.19,
      "end_seconds": 341.66,
      "duration_seconds": 3.47,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.34,
      "end_seconds": 343.78,
      "duration_seconds": 1.44,
      "text": "Goodbye for now."
    }
  ]
}