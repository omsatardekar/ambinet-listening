{
  "schema_version": "1.0",
  "encounter_id": "03096",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 5.08,
      "duration_seconds": 4.07,
      "text": "come in, have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.99,
      "end_seconds": 9.24,
      "duration_seconds": 3.25,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.58,
      "end_seconds": 16.09,
      "duration_seconds": 5.51,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.29,
      "end_seconds": 20.34,
      "duration_seconds": 3.05,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.63,
      "end_seconds": 28.13,
      "duration_seconds": 6.5,
      "text": "Um, uh, so... flakes on my shoulders. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.58,
      "end_seconds": 31.2,
      "duration_seconds": 1.62,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.65,
      "end_seconds": 36.03,
      "duration_seconds": 3.38,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.06,
      "end_seconds": 39.42,
      "duration_seconds": 2.36,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.06,
      "end_seconds": 50.9,
      "duration_seconds": 6.84,
      "text": "It feels mild to me. Oh, you know, and an itchy scalp."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.34,
      "end_seconds": 55.67,
      "duration_seconds": 3.33,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.65,
      "end_seconds": 59.73,
      "duration_seconds": 3.08,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.85,
      "end_seconds": 63.54,
      "duration_seconds": 2.69,
      "text": "any a little redness as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.31,
      "end_seconds": 66.55,
      "duration_seconds": 1.24,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 73.58,
      "duration_seconds": 4.29,
      "text": "Any rash elsewhere, pus, hair loss or pain at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.53,
      "end_seconds": 78.82,
      "duration_seconds": 3.29,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.38,
      "end_seconds": 84.76,
      "duration_seconds": 2.38,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.5,
      "end_seconds": 89.09,
      "duration_seconds": 3.59,
      "text": "Uh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.01,
      "end_seconds": 111.64,
      "duration_seconds": 3.63,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.23,
      "end_seconds": 118.31,
      "duration_seconds": 6.08,
      "text": "Mm, he takes alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.97,
      "end_seconds": 129.59,
      "duration_seconds": 1.62,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.52,
      "end_seconds": 136.3,
      "duration_seconds": 5.78,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.19,
      "end_seconds": 141.53,
      "duration_seconds": 3.34,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.8,
      "end_seconds": 146.03,
      "duration_seconds": 3.23,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 149.68,
      "duration_seconds": 2.82,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.95,
      "end_seconds": 154.18,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.29,
      "end_seconds": 158.67,
      "duration_seconds": 3.38,
      "text": "right, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.0,
      "end_seconds": 164.61,
      "duration_seconds": 4.61,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.2,
      "end_seconds": 169.44,
      "duration_seconds": 3.24,
      "text": "okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.64,
      "end_seconds": 174.14,
      "duration_seconds": 1.5,
      "text": "yes, thin bones"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.19,
      "end_seconds": 179.62,
      "duration_seconds": 4.43,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.93,
      "end_seconds": 183.41,
      "duration_seconds": 2.48,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.1,
      "end_seconds": 186.92,
      "duration_seconds": 2.82,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.96,
      "end_seconds": 205.26,
      "duration_seconds": 12.3,
      "text": "Yes, I had a mole taken off my arm, a few years ago. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.29,
      "end_seconds": 215.37,
      "duration_seconds": 3.08,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.41,
      "end_seconds": 228.52,
      "duration_seconds": 2.11,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.45,
      "end_seconds": 251.43,
      "duration_seconds": 8.98,
      "text": "Okay: oxygen saturation is 99 percent, pressure 116 over 68, heart rate 78. And And temperature 36.7."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.84,
      "end_seconds": 254.29,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.9,
      "end_seconds": 258.2,
      "duration_seconds": 2.3,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.43,
      "end_seconds": 263.51,
      "duration_seconds": 3.08,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 267.64,
      "duration_seconds": 2.82,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.07,
      "end_seconds": 281.18,
      "duration_seconds": 5.11,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.94,
      "end_seconds": 297.33,
      "duration_seconds": 11.39,
      "text": "So, that's all I needed to check. From what you've told me and what I found, the most likely explanation is simple dandruff."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.42,
      "end_seconds": 302.47,
      "duration_seconds": 3.05,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.47,
      "end_seconds": 329.2,
      "duration_seconds": 24.73,
      "text": "I understand the worry. At the moment I'd say it's simple dandruff, and we'll watch how it goes. I'm prescribing ketoconazole shampoo, 2%, twice a week, four weeks. That's for dandruff. Leave the shampoo on for five minutes before rinsing. Please come and see me if not better in a month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.34,
      "end_seconds": 333.83,
      "duration_seconds": 3.49,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.85,
      "end_seconds": 336.17,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}