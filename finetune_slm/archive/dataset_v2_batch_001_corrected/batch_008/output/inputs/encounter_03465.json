{
  "schema_version": "1.0",
  "encounter_id": "03465",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 5.35,
      "duration_seconds": 4.44,
      "text": "Let me think, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.77,
      "end_seconds": 11.47,
      "duration_seconds": 4.7,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.37,
      "end_seconds": 24.08,
      "duration_seconds": 10.71,
      "text": "Thank you for fitting us in, doctor. Oh, it's a high sugar test in pregnancy, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.02,
      "end_seconds": 28.74,
      "duration_seconds": 3.72,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 41.58,
      "duration_seconds": 2.26,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 64.43,
      "duration_seconds": 7.8,
      "text": "Okay: SpO2 98 percent on room air, pulse is 77 beats a minute, pressure 118 over 68."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.57,
      "end_seconds": 67.5,
      "duration_seconds": 1.93,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.89,
      "end_seconds": 79.0,
      "duration_seconds": 7.11,
      "text": "They help me see the whole picture, more shortly. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.33,
      "end_seconds": 85.48,
      "duration_seconds": 5.15,
      "text": "Sorry, what was I saying, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 87.12,
      "end_seconds": 91.75,
      "duration_seconds": 4.63,
      "text": "Well, I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.2,
      "end_seconds": 98.18,
      "duration_seconds": 4.98,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.83,
      "end_seconds": 106.01,
      "duration_seconds": 7.18,
      "text": "Yeah, roughly. Oh, and no symptoms. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.87,
      "end_seconds": 113.23,
      "duration_seconds": 6.36,
      "text": "Have you had a high sugar test in pregnancy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.33,
      "end_seconds": 120.84,
      "duration_seconds": 5.51,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.23,
      "end_seconds": 125.96,
      "duration_seconds": 3.73,
      "text": "Okay, did you get blurred vision or thirst?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.83,
      "end_seconds": 141.53,
      "duration_seconds": 13.7,
      "text": "No, no blurred vision, no thirst. I did have a big baby on the scan at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 148.31,
      "duration_seconds": 4.84,
      "text": "Did you get passing a lot of urine or reduced baby movements?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.57,
      "end_seconds": 152.71,
      "duration_seconds": 3.14,
      "text": "Nope, you know, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.31,
      "end_seconds": 156.74,
      "duration_seconds": 3.43,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.64,
      "end_seconds": 159.45,
      "duration_seconds": 1.81,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 163.33,
      "duration_seconds": 2.82,
      "text": "Okay, what about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.07,
      "end_seconds": 171.39,
      "duration_seconds": 7.32,
      "text": "Yes, acid reflux. Yes, an underactive thyroid. I have eczema, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 181.64,
      "duration_seconds": 8.2,
      "text": "Alright, acid reflux and an underactive thyroid, that matches what I have here. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.53,
      "end_seconds": 190.23,
      "duration_seconds": 6.7,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.06,
      "end_seconds": 194.01,
      "duration_seconds": 2.95,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.55,
      "end_seconds": 200.92,
      "duration_seconds": 6.37,
      "text": "Wheat. I come out in... well, bloating. Actually, yes, I'm allergic to tramadol."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 204.01,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.03,
      "end_seconds": 209.8,
      "duration_seconds": 4.77,
      "text": "Omeprazole. I take it once a day for the reflux."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.95,
      "end_seconds": 217.97,
      "duration_seconds": 3.02,
      "text": "Right, do you know the dose?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.88,
      "end_seconds": 226.03,
      "duration_seconds": 6.15,
      "text": "It's 20 milligrams. Eltroxin. I take it 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 229.3,
      "duration_seconds": 1.3,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.62,
      "end_seconds": 233.66,
      "duration_seconds": 3.04,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.6,
      "end_seconds": 236.66,
      "duration_seconds": 2.06,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.34,
      "end_seconds": 241.48,
      "duration_seconds": 4.14,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.75,
      "end_seconds": 249.49,
      "duration_seconds": 2.74,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.39,
      "end_seconds": 254.68,
      "duration_seconds": 4.29,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.86,
      "end_seconds": 274.73,
      "duration_seconds": 2.87,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.36,
      "end_seconds": 280.46,
      "duration_seconds": 5.1,
      "text": "My grandfather had a stroke. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.14,
      "end_seconds": 291.94,
      "duration_seconds": 7.8,
      "text": "Let me tell you where I've got to. The most likely explanation is gestational diabetes controllable with diet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.84,
      "end_seconds": 295.95,
      "duration_seconds": 2.11,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.51,
      "end_seconds": 317.9,
      "duration_seconds": 21.39,
      "text": "Nothing I've seen today points to an emergency. It looks like gestational diabetes controllable with diet, but I'd like to confirm. Stop me if I've got anything wrong. You've had a high sugar test in pregnancy, and no passing a lot of urine or blurred vision."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.17,
      "end_seconds": 321.53,
      "duration_seconds": 2.36,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.43,
      "end_seconds": 339.64,
      "duration_seconds": 5.21,
      "text": "I'm going to order a glucose meter and diary, for gestational diabetes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 340.46,
      "end_seconds": 343.1,
      "duration_seconds": 2.64,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.17,
      "end_seconds": 358.62,
      "duration_seconds": 10.45,
      "text": "Let's book a growth scan to look into gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.19,
      "end_seconds": 371.55,
      "duration_seconds": 12.36,
      "text": "Okay, go on. If you smoke, this is a good moment to think about stopping, and we can help you with that. I'll also refer you to the diabetes midwife."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.43,
      "end_seconds": 373.13,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.62,
      "end_seconds": 388.57,
      "duration_seconds": 13.95,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Please come and see me in two weeks. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.79,
      "end_seconds": 397.23,
      "duration_seconds": 5.44,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.04,
      "end_seconds": 403.98,
      "duration_seconds": 5.94,
      "text": "Yes, exactly right. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.26,
      "end_seconds": 409.29,
      "duration_seconds": 4.03,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}