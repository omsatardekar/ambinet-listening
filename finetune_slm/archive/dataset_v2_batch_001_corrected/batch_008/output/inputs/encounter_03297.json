{
  "schema_version": "1.0",
  "encounter_id": "03297",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.73,
      "end_seconds": 6.23,
      "duration_seconds": 5.5,
      "text": "afternoon, doctor. They're in and comfortable, and I have the measurements ready"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 9.9,
      "duration_seconds": 3.06,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.73,
      "end_seconds": 16.74,
      "duration_seconds": 6.01,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 17.82,
      "end_seconds": 30.09,
      "duration_seconds": 12.27,
      "text": "Um, you know, so... pain in my breastbone wound. That's why I came. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.62,
      "end_seconds": 34.22,
      "duration_seconds": 3.6,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.62,
      "end_seconds": 46.87,
      "duration_seconds": 11.25,
      "text": "Sorry, what was I saying, it's been like this since last weekend. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.6,
      "end_seconds": 58.01,
      "duration_seconds": 10.41,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.5,
      "end_seconds": 66.19,
      "duration_seconds": 6.69,
      "text": "Yes, coughing. That makes it worse. Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.96,
      "end_seconds": 75.66,
      "duration_seconds": 8.7,
      "text": "right, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 75.76,
      "end_seconds": 83.01,
      "duration_seconds": 7.25,
      "text": "Tell the doctor about the other thing, uh, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.57,
      "end_seconds": 100.37,
      "duration_seconds": 15.8,
      "text": "Actually, I was getting to that! As for tiredness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 103.71,
      "duration_seconds": 2.76,
      "text": "Mm-hmm. Any swollen ankles as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.06,
      "end_seconds": 113.58,
      "duration_seconds": 3.52,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 115.34,
      "end_seconds": 120.39,
      "duration_seconds": 5.05,
      "text": "Okay, so the vitals from earlier. Pulse 71, blood pressure 121 over 80."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.97,
      "end_seconds": 123.35,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.2,
      "end_seconds": 129.61,
      "duration_seconds": 4.41,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.47,
      "end_seconds": 134.29,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.72,
      "end_seconds": 156.48,
      "duration_seconds": 9.76,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.5,
      "end_seconds": 171.77,
      "duration_seconds": 2.27,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.71,
      "end_seconds": 182.29,
      "duration_seconds": 5.58,
      "text": "Thank you, you can get dressed. And fever, any of that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.37,
      "end_seconds": 184.97,
      "duration_seconds": 1.6,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.71,
      "end_seconds": 191.77,
      "duration_seconds": 5.06,
      "text": "Let me check a few things. Any chest pain on exertion or breathlessness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.81,
      "end_seconds": 213.97,
      "duration_seconds": 17.16,
      "text": "Actually, um, no, no chest pain on exertion, no breathlessness. I did have a clicking in the breastbone at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.25,
      "end_seconds": 218.32,
      "duration_seconds": 3.07,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.1,
      "end_seconds": 223.13,
      "duration_seconds": 4.03,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.93,
      "end_seconds": 226.7,
      "duration_seconds": 2.77,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.18,
      "end_seconds": 232.37,
      "duration_seconds": 4.19,
      "text": "hmm, nothing on the skin, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.3,
      "end_seconds": 234.86,
      "duration_seconds": 1.56,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.53,
      "end_seconds": 239.27,
      "duration_seconds": 3.74,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.37,
      "end_seconds": 244.46,
      "duration_seconds": 4.09,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.63,
      "end_seconds": 249.89,
      "duration_seconds": 4.26,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.5,
      "end_seconds": 255.05,
      "duration_seconds": 4.55,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.67,
      "end_seconds": 260.45,
      "duration_seconds": 3.78,
      "text": "um, I've never had an allergy"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 261.19,
      "end_seconds": 271.02,
      "duration_seconds": 9.83,
      "text": "Actually, uh, I remember he had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.65,
      "end_seconds": 274.92,
      "duration_seconds": 3.27,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.46,
      "end_seconds": 281.13,
      "duration_seconds": 5.67,
      "text": "Okay, I'll note both of those. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 286.81,
      "end_seconds": 300.79,
      "duration_seconds": 13.98,
      "text": "He is on metoprolol, 50 milligrams, twice a day, I give it to him. It's iron tablets, once a day for my blood count, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 302.16,
      "end_seconds": 304.69,
      "duration_seconds": 2.53,
      "text": "Clopidogrel I don't take anymore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.45,
      "end_seconds": 309.38,
      "duration_seconds": 3.93,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.99,
      "end_seconds": 318.11,
      "duration_seconds": 7.12,
      "text": "my mother had a a stroke so, my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.02,
      "end_seconds": 339.6,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.41,
      "end_seconds": 352.62,
      "duration_seconds": 11.21,
      "text": "Hmm, I've had heart disease for about a year now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.1,
      "end_seconds": 354.8,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 355.87,
      "end_seconds": 362.34,
      "duration_seconds": 6.47,
      "text": "I have diabetes, for about a year. Low haemoglobin, for two years"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.53,
      "end_seconds": 378.73,
      "duration_seconds": 15.2,
      "text": "Mm-hmm. Okay, I can see diabetes in your file as well. Okay, so my impression is this: This is probably recovering well after bypass surgery. A leg wound infection is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.01,
      "end_seconds": 382.54,
      "duration_seconds": 2.53,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.55,
      "end_seconds": 393.13,
      "duration_seconds": 8.58,
      "text": "It's reasonable to be concerned, but right now recovering well after bypass surgery is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 394.09,
      "end_seconds": 397.57,
      "duration_seconds": 3.48,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.8,
      "end_seconds": 414.94,
      "duration_seconds": 16.14,
      "text": "good, thanks for doing that i'd like to arrange blood tests for post-operative review walk daily, no heavy lifting for six weeks and no driving until you are cleared we'll catch up in six weeks"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.73,
      "end_seconds": 417.35,
      "duration_seconds": 1.62,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.79,
      "end_seconds": 421.62,
      "duration_seconds": 2.83,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.47,
      "end_seconds": 425.42,
      "duration_seconds": 2.95,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.24,
      "end_seconds": 428.42,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}