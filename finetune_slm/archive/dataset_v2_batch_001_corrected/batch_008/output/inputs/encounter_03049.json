{
  "schema_version": "1.0",
  "encounter_id": "03049",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.25,
      "duration_seconds": 2.86,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.78,
      "end_seconds": 8.42,
      "duration_seconds": 3.64,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.97,
      "end_seconds": 15.71,
      "duration_seconds": 6.74,
      "text": "Actually, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.29,
      "end_seconds": 21.35,
      "duration_seconds": 4.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.02,
      "end_seconds": 29.38,
      "duration_seconds": 3.36,
      "text": "She's been having wheeze at work, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.57,
      "end_seconds": 32.37,
      "duration_seconds": 1.8,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.45,
      "end_seconds": 36.86,
      "duration_seconds": 3.41,
      "text": "Um, around three days, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.66,
      "end_seconds": 43.86,
      "duration_seconds": 5.2,
      "text": "I think it's been nearer five days, uh, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.92,
      "end_seconds": 50.8,
      "duration_seconds": 4.88,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.38,
      "end_seconds": 54.29,
      "duration_seconds": 1.91,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.07,
      "end_seconds": 65.15,
      "duration_seconds": 9.08,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.08,
      "end_seconds": 87.36,
      "duration_seconds": 21.28,
      "text": "Mm, yes, work and spray paint. That makes it worse. I'd say severe. Oh, and itchy eyes at work. As for cough that eases on holiday, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.83,
      "end_seconds": 91.22,
      "duration_seconds": 2.39,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.32,
      "end_seconds": 103.63,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 132.03,
      "duration_seconds": 8.91,
      "text": "Okay: SpO2 97 percent on room air, heart rate 79, BP is 118 over 75, respiratory rate 18."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 134.27,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 138.16,
      "duration_seconds": 3.28,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.6,
      "end_seconds": 145.1,
      "duration_seconds": 4.5,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 149.82,
      "duration_seconds": 2.95,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.04,
      "end_seconds": 164.72,
      "duration_seconds": 4.68,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.39,
      "end_seconds": 176.16,
      "duration_seconds": 6.77,
      "text": "You can relax now. Any weight loss, coughing up blood or fever at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.44,
      "end_seconds": 179.96,
      "duration_seconds": 2.52,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.43,
      "end_seconds": 184.78,
      "duration_seconds": 3.35,
      "text": "Have you had ankle swelling, by any chance?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.51,
      "end_seconds": 194.9,
      "duration_seconds": 4.39,
      "text": "Okay, so not at all, no ankle swelling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.19,
      "end_seconds": 199.13,
      "duration_seconds": 3.94,
      "text": "Yes, carry on. Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.45,
      "end_seconds": 201.44,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.12,
      "end_seconds": 216.3,
      "duration_seconds": 5.18,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.29,
      "end_seconds": 232.33,
      "duration_seconds": 14.04,
      "text": "I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 253.87,
      "duration_seconds": 2.93,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.86,
      "end_seconds": 257.1,
      "duration_seconds": 2.24,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.79,
      "end_seconds": 260.0,
      "duration_seconds": 2.21,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.26,
      "end_seconds": 266.7,
      "duration_seconds": 5.44,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 271.58,
      "duration_seconds": 3.48,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.28,
      "end_seconds": 279.24,
      "duration_seconds": 2.96,
      "text": "Yes, acid reflux. I have gout."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.02,
      "end_seconds": 282.01,
      "duration_seconds": 0.99,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.22,
      "end_seconds": 285.3,
      "duration_seconds": 2.08,
      "text": "I have low haemoglobin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.35,
      "end_seconds": 287.3,
      "duration_seconds": 0.95,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.85,
      "end_seconds": 300.23,
      "duration_seconds": 2.38,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.01,
      "end_seconds": 305.53,
      "duration_seconds": 3.52,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.36,
      "end_seconds": 310.69,
      "duration_seconds": 4.33,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.3,
      "end_seconds": 315.89,
      "duration_seconds": 4.59,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.61,
      "end_seconds": 322.95,
      "duration_seconds": 3.34,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.7,
      "end_seconds": 341.38,
      "duration_seconds": 16.68,
      "text": "Two years now. It's allopurinol, 100 milligrams, once a day. It's iron tablets, once a day. It's something called a re... a reliever inhaler, 100 micrograms, maybe, when needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.16,
      "end_seconds": 347.56,
      "duration_seconds": 4.4,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.31,
      "end_seconds": 352.77,
      "duration_seconds": 3.46,
      "text": "No, you know, it's at home."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.32,
      "end_seconds": 377.65,
      "duration_seconds": 24.33,
      "text": "Let me tell you where I've got to. I'd lean towards occupational asthma. It could also be COPD, so we'll keep that open. I'd like to arrange spirometry for wheeze. I'll request serial peak flow readings, it'll help with work-related wheeze. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.28,
      "end_seconds": 381.03,
      "duration_seconds": 2.75,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.47,
      "end_seconds": 412.95,
      "duration_seconds": 30.48,
      "text": "Let's use beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma. Record peak flows at work and at home for four weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like you back in four weeks. Okay, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.92,
      "end_seconds": 424.1,
      "duration_seconds": 10.18,
      "text": "So, I take the beclometasone inhaler, 200 micrograms, twice a day and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.62,
      "end_seconds": 430.09,
      "duration_seconds": 4.47,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.51,
      "end_seconds": 434.38,
      "duration_seconds": 2.87,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.03,
      "end_seconds": 437.46,
      "duration_seconds": 1.43,
      "text": "Take care now."
    }
  ]
}