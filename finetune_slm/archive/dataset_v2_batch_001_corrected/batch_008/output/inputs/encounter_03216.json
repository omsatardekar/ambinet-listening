      "role": "DOCTOR",
      "start_seconds": 136.4,
      "end_seconds": 138.75,
      "duration_seconds": 2.35,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.53,
      "end_seconds": 148.56,
      "duration_seconds": 4.03,
      "text": "No, I share a house with my brother."
