    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.55,
      "end_seconds": 151.18,
      "duration_seconds": 1.63,
      "text": "How active are you?"
