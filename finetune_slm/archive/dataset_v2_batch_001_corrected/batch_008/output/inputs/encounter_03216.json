      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.34,
      "end_seconds": 96.98,
      "duration_seconds": 3.64,
      "text": "No, um, no fever or fainting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.8,
      "end_seconds": 100.35,
      "duration_seconds": 2.55,
      "text": "Right, is your mobility otherwise okay?"
