      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.29,
      "end_seconds": 41.66,
      "duration_seconds": 3.37,
      "text": "Ah. Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.71,
      "end_seconds": 53.79,
      "duration_seconds": 10.08,
      "text": "When it starts I tend to get darker skin as well. The darker skin? That's been for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.8,
      "end_seconds": 59.44,
      "duration_seconds": 3.64,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.43,
      "end_seconds": 62.68,
      "duration_seconds": 2.25,
      "text": "It's, It's mild, honestly."
