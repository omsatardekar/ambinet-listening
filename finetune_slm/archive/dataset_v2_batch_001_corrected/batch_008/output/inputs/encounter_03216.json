    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 105.8,
      "duration_seconds": 1.53,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.44,
      "end_seconds": 108.61,
