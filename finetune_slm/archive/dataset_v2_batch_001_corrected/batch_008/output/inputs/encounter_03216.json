    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.0,
      "end_seconds": 85.53,
      "duration_seconds": 3.53,
      "text": "No, no vomiting or severe tummy pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.04,
      "end_seconds": 89.38,
      "duration_seconds": 2.34,
      "text": "Did you get fever or fainting?"
