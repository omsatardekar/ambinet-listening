  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.19,
      "duration_seconds": 5.01,
      "text": "Uh, um, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 12.21,
      "duration_seconds": 4.67,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.91,
      "end_seconds": 21.05,
      "duration_seconds": 7.14,
      "text": "It's a bit tired sometimes. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.41,
      "end_seconds": 25.62,
      "duration_seconds": 3.21,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.15,
      "end_seconds": 41.95,
      "duration_seconds": 14.8,
      "text": "For two days, I'd say. It's a relief to finally sit down and talk about it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.54,
      "end_seconds": 47.86,
      "duration_seconds": 5.32,
      "text": "I see, go ahead. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.57,
      "end_seconds": 57.79,
      "duration_seconds": 9.22,
      "text": "Mm, I'd call it severe. Ah, um, and there's being vegetarian as well, two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.04,
      "end_seconds": 58.74,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.28,
      "end_seconds": 61.88,
      "duration_seconds": 2.6,
      "text": "I've also had brittle nails."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.68,
      "end_seconds": 65.86,
      "duration_seconds": 2.18,
      "text": "Any black stools or breathlessness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.45,
      "end_seconds": 72.22,
      "duration_seconds": 4.77,
      "text": "I haven't had black stools or breathlessness, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.4,
      "end_seconds": 76.44,
      "duration_seconds": 3.04,
      "text": "Any dizziness or heavy periods at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.29,
      "end_seconds": 83.02,
      "duration_seconds": 4.73,
      "text": "Actually, no dizziness or heavy periods, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.06,
      "end_seconds": 87.15,
      "duration_seconds": 2.09,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.73,
      "end_seconds": 91.06,
      "duration_seconds": 2.33,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.61,
      "end_seconds": 96.43,
      "duration_seconds": 3.82,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 101.02,
      "duration_seconds": 3.04,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.4,
      "end_seconds": 106.36,
      "duration_seconds": 3.96,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.05,
      "end_seconds": 111.2,
      "duration_seconds": 4.15,
      "text": "I have depression, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.59,
      "end_seconds": 125.43,
      "duration_seconds": 1.84,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.27,
      "end_seconds": 127.93,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.89,
      "end_seconds": 132.34,
      "duration_seconds": 3.45,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.9,
      "end_seconds": 138.19,
      "duration_seconds": 5.29,
      "text": "Escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.19,
      "end_seconds": 143.92,
      "duration_seconds": 4.73,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.75,
      "end_seconds": 150.12,
      "duration_seconds": 4.37,
      "text": "I'm allergic to tramadol, I get vomiting."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 155.77,
      "duration_seconds": 4.85,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.61,
      "end_seconds": 169.5,
      "duration_seconds": 11.89,
      "text": "No, I share a house with my brother. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.14,
      "end_seconds": 175.13,
      "duration_seconds": 2.99,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.08,
      "end_seconds": 184.26,
      "duration_seconds": 2.18,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.56,
      "end_seconds": 201.98,
      "duration_seconds": 8.42,
      "text": "Okay: respiratory rate 17, pulse 86, saturation 97 percent. And temp 36.7 degrees, BP is 122 over 70."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.83,
      "end_seconds": 204.53,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.91,
      "end_seconds": 208.12,
      "duration_seconds": 2.21,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.22,
      "end_seconds": 212.25,
      "duration_seconds": 3.03,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.99,
      "end_seconds": 216.29,
      "duration_seconds": 2.3,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.43,
      "end_seconds": 230.96,
      "duration_seconds": 5.53,
      "text": "Your pulse and blood pressure are normal and the eyelids are a good colour."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.22,
      "end_seconds": 236.85,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.81,
      "end_seconds": 259.97,
      "duration_seconds": 7.16,
      "text": "Taking everything into account, it fits best with mildly low iron stores risk from diet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.1,
      "end_seconds": 264.16,
      "duration_seconds": 3.06,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.81,
      "end_seconds": 274.29,
      "duration_seconds": 9.48,
      "text": "Nothing I've seen today points to an emergency. It looks like mildly low iron stores risk from diet, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.88,
      "end_seconds": 293.25,
      "duration_seconds": 4.37,
      "text": "I'm sending you for a B12 level because of vegetarian diet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.66,
      "end_seconds": 299.05,
      "duration_seconds": 3.39,
      "text": "Well, do I need to prepare?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.82,
      "end_seconds": 305.53,
      "duration_seconds": 4.71,
      "text": "Eat pulses, leafy greens and vitamin-C rich foods with meals."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.13,
      "end_seconds": 318.65,
      "duration_seconds": 12.52,
      "text": "Right, right. I'm not ordering a ferritin level today. If things carry on in a month, we'll consider it. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.95,
      "end_seconds": 321.82,
      "duration_seconds": 1.87,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.38,
      "end_seconds": 331.04,
      "duration_seconds": 7.66,
      "text": "I'd like you back after the results. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.64,
      "end_seconds": 334.92,
      "duration_seconds": 3.28,
      "text": "Um, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.85,
      "end_seconds": 337.54,
      "duration_seconds": 1.69,
      "text": "Alright, see you soon."
    }
  ]
