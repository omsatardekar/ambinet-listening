  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 3.94,
      "duration_seconds": 3.14,
      "text": "hello, good to see you. Please sit"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.57,
      "end_seconds": 8.89,
      "duration_seconds": 3.32,
      "text": "hello. I hope I'm not late"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.96,
      "end_seconds": 12.36,
      "duration_seconds": 1.4,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.88,
      "end_seconds": 22.87,
      "duration_seconds": 9.99,
      "text": "um, so... nausea after the chemotherapy that's why I came i just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.3,
      "end_seconds": 26.24,
      "duration_seconds": 1.94,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.83,
      "end_seconds": 36.85,
      "duration_seconds": 10.02,
      "text": "probably ten days yeah i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.72,
      "end_seconds": 44.06,
      "duration_seconds": 5.34,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.83,
      "end_seconds": 56.34,
      "duration_seconds": 10.51,
      "text": "It happens a few times a day. Severe, I'd say. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.87,
      "end_seconds": 59.34,
      "duration_seconds": 2.47,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.24,
      "end_seconds": 66.72,
      "duration_seconds": 6.48,
      "text": "Being very tired goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.37,
      "end_seconds": 69.72,
      "duration_seconds": 2.35,
      "text": "Any numb fingertips as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.74,
      "end_seconds": 86.22,
      "duration_seconds": 15.48,
      "text": "Mm, yes. Mm, uh, as for numb fingertips, I'd give it a eight, out of ten. Well, the being very tired? That's been for five days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.76,
      "end_seconds": 89.56,
      "duration_seconds": 2.8,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.52,
      "end_seconds": 105.09,
      "duration_seconds": 2.57,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 121.59,
      "duration_seconds": 6.99,
      "text": "Okay: pressure 111 over 69, temperature 36.5, pulse is 72 beats a minute."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.59,
      "end_seconds": 124.08,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.11,
      "end_seconds": 128.93,
      "duration_seconds": 2.82,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.46,
      "end_seconds": 135.11,
      "duration_seconds": 3.65,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.22,
      "end_seconds": 139.28,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.55,
      "end_seconds": 143.61,
      "duration_seconds": 3.06,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.25,
      "end_seconds": 163.41,
      "duration_seconds": 5.16,
      "text": "Your mouth has two shallow ulcers and there is no fever today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.55,
      "end_seconds": 171.25,
      "duration_seconds": 5.7,
      "text": "Okay, that's enough for me. Any breathlessness, shivering, fever or bleeding at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.56,
      "end_seconds": 177.77,
      "duration_seconds": 5.21,
      "text": "No breathlessness, shivering, fever or bleeding, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.93,
      "end_seconds": 182.37,
      "duration_seconds": 3.44,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.47,
      "end_seconds": 188.55,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.77,
      "end_seconds": 191.91,
      "duration_seconds": 2.14,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.84,
      "end_seconds": 196.18,
      "duration_seconds": 3.34,
      "text": "Okay, so no problems with breathing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.84,
      "end_seconds": 210.67,
      "duration_seconds": 3.83,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.84,
      "end_seconds": 224.56,
      "duration_seconds": 12.72,
      "text": "I take losartan, 50 milligrams, once a day for my blood pressure. I thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.06,
      "end_seconds": 228.58,
      "duration_seconds": 2.52,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.65,
      "end_seconds": 232.35,
      "duration_seconds": 1.7,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.56,
      "end_seconds": 241.54,
      "duration_seconds": 3.98,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.67,
      "end_seconds": 247.75,
      "duration_seconds": 5.08,
      "text": "I've had high blood pressure for five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.25,
      "end_seconds": 250.68,
      "duration_seconds": 1.43,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.45,
      "end_seconds": 269.38,
      "duration_seconds": 3.93,
      "text": "A A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.7,
      "end_seconds": 286.25,
      "duration_seconds": 15.55,
      "text": "I drink a lot of tea and snack through the day. I do a yoga class on Thursdays. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.86,
      "end_seconds": 291.35,
      "duration_seconds": 4.49,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.07,
      "end_seconds": 298.35,
      "duration_seconds": 5.28,
      "text": "Um, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.33,
      "end_seconds": 317.88,
      "duration_seconds": 3.55,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.74,
      "end_seconds": 321.72,
      "duration_seconds": 2.98,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.98,
      "end_seconds": 333.28,
      "duration_seconds": 10.3,
      "text": "From what you've told me and what I found, it points towards expected chemotherapy side effects. I'd also keep an infection in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.43,
      "end_seconds": 340.29,
      "duration_seconds": 2.86,
      "text": "ah, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.1,
      "end_seconds": 357.05,
      "duration_seconds": 15.95,
      "text": "Nothing I've seen today points to an emergency. It looks like expected chemotherapy side effects. For now, no new medicines or tests are needed. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.76,
      "end_seconds": 362.55,
      "duration_seconds": 3.79,
      "text": "Let me think, thank you, doctor, goodbye."
    }
  ]
}