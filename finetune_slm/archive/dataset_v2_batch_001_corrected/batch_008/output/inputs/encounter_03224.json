{
  "schema_version": "1.0",
  "encounter_id": "03224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 6.81,
      "duration_seconds": 5.64,
      "text": "Hmm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.9,
      "end_seconds": 12.02,
      "duration_seconds": 4.12,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.88,
      "end_seconds": 22.13,
      "duration_seconds": 8.25,
      "text": "I wanted to get a pearly bump on my nose that bleeds looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.5,
      "end_seconds": 26.42,
      "duration_seconds": 2.92,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.01,
      "end_seconds": 29.59,
      "duration_seconds": 2.58,
      "text": "Nothing regular, uh, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.49,
      "end_seconds": 33.01,
      "duration_seconds": 2.52,
      "text": "Right, does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.24,
      "end_seconds": 36.66,
      "duration_seconds": 2.42,
      "text": "It's worse with washing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.42,
      "end_seconds": 40.14,
      "duration_seconds": 2.72,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.77,
      "end_seconds": 44.3,
      "duration_seconds": 2.53,
      "text": "It usually comes with crusting."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 49.98,
      "duration_seconds": 3.77,
      "text": "Any a sore that won't heal as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.5,
      "end_seconds": 57.89,
      "duration_seconds": 6.39,
      "text": "Yeah, that too. The, The crusting? That's been for ten days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.91,
      "end_seconds": 63.1,
      "duration_seconds": 3.19,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.14,
      "end_seconds": 66.84,
      "duration_seconds": 2.7,
      "text": "It's, It's mild, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.0,
      "end_seconds": 87.88,
      "duration_seconds": 2.88,
      "text": "Did you notice any swollen glands?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.74,
      "end_seconds": 92.44,
      "duration_seconds": 3.7,
      "text": "No, I haven't had any swollen glands."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.95,
      "end_seconds": 100.44,
      "duration_seconds": 6.49,
      "text": "Have you had any family history of skin cancer, pain or other new lumps?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.39,
      "end_seconds": 103.86,
      "duration_seconds": 2.47,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.68,
      "end_seconds": 108.78,
      "duration_seconds": 3.1,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.81,
      "end_seconds": 114.66,
      "duration_seconds": 3.85,
      "text": "Erm, um, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.11,
      "end_seconds": 123.75,
      "duration_seconds": 3.64,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.13,
      "end_seconds": 128.29,
      "duration_seconds": 3.16,
      "text": "Okay, so no, that's all normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.13,
      "end_seconds": 133.47,
      "duration_seconds": 4.34,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.76,
      "end_seconds": 137.01,
      "duration_seconds": 2.25,
      "text": "Cat fur, I'd say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.33,
      "end_seconds": 141.15,
      "duration_seconds": 2.82,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.03,
      "end_seconds": 144.67,
      "duration_seconds": 1.64,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.27,
      "end_seconds": 150.86,
      "duration_seconds": 4.59,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.95,
      "end_seconds": 155.11,
      "duration_seconds": 2.16,
      "text": "Anxiety, for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.41,
      "end_seconds": 164.02,
      "duration_seconds": 5.61,
      "text": "Alright, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.89,
      "end_seconds": 180.48,
      "duration_seconds": 15.59,
      "text": "I gave up cigarettes last spring. No, I share a house with my brother. Not much, I mostly stay in these days. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.17,
      "end_seconds": 185.12,
      "duration_seconds": 2.95,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.82,
      "end_seconds": 196.88,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.06,
      "end_seconds": 214.22,
      "duration_seconds": 6.16,
      "text": "Okay: BP is 108 over 68, saturation 99 percent, respiratory rate 18, pulse 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.41,
      "end_seconds": 220.57,
      "duration_seconds": 4.16,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.71,
      "end_seconds": 224.04,
      "duration_seconds": 2.33,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.76,
      "end_seconds": 241.57,
      "duration_seconds": 7.81,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.7,
      "end_seconds": 245.99,
      "duration_seconds": 2.29,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 282.16,
      "duration_seconds": 21.84,
      "text": "So where does that leave us? This looks most like a likely basal cell carcinoma. I'd also keep a squamous cell carcinoma in mind. We should do a dermoscopy for suspicious lesion. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.05,
      "end_seconds": 288.26,
      "duration_seconds": 3.21,
      "text": "Ah, when would that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.51,
      "end_seconds": 293.42,
      "duration_seconds": 3.91,
      "text": "Let's get a skin biopsy, for suspicious lesion."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.29,
      "end_seconds": 295.95,
      "duration_seconds": 1.66,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.42,
      "end_seconds": 309.99,
      "duration_seconds": 12.57,
      "text": "Please use a high-factor sunscreen and a hat. Do get help quickly if the symptoms get worse. Let's plan a check after the biopsy. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.25,
      "end_seconds": 315.46,
      "duration_seconds": 2.21,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.3,
      "end_seconds": 319.19,
      "duration_seconds": 1.89,
      "text": "Have a good day."
    }
  ]
}