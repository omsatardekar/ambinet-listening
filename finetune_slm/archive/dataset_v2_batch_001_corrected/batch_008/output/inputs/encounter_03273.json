{
  "schema_version": "1.0",
  "encounter_id": "03273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 6.24,
      "duration_seconds": 5.2,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 11.98,
      "duration_seconds": 4.73,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.31,
      "end_seconds": 20.07,
      "duration_seconds": 6.76,
      "text": "I wanted to to get pain in my groin and hip looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.32,
      "end_seconds": 24.19,
      "duration_seconds": 2.87,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.57,
      "end_seconds": 36.78,
      "duration_seconds": 11.21,
      "text": "I'm on paracetamol, 1 gram, four times a day. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.34,
      "end_seconds": 40.13,
      "duration_seconds": 2.79,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.87,
      "end_seconds": 45.03,
      "duration_seconds": 3.16,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.23,
      "end_seconds": 56.68,
      "duration_seconds": 10.45,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.13,
      "end_seconds": 67.83,
      "duration_seconds": 9.7,
      "text": "Rest helps a bit. I notice it more with walking. And there's night pain as well, three weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.3,
      "end_seconds": 85.3,
      "duration_seconds": 4.0,
      "text": "Have you had any weight loss, numbness or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.89,
      "end_seconds": 92.22,
      "duration_seconds": 5.33,
      "text": "I haven't had weight loss, numbness or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.06,
      "end_seconds": 96.81,
      "duration_seconds": 2.75,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.83,
      "end_seconds": 100.33,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.54,
      "end_seconds": 109.73,
      "duration_seconds": 8.19,
      "text": "Do you have any medical conditions I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.75,
      "end_seconds": 113.5,
      "duration_seconds": 1.75,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 119.82,
      "duration_seconds": 4.96,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.36,
      "end_seconds": 121.82,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.65,
      "end_seconds": 138.82,
      "duration_seconds": 1.17,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.84,
      "end_seconds": 142.75,
      "duration_seconds": 2.91,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.87,
      "end_seconds": 158.04,
      "duration_seconds": 3.17,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.97,
      "end_seconds": 161.96,
      "duration_seconds": 1.99,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.77,
      "end_seconds": 166.16,
      "duration_seconds": 2.39,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 184.22,
      "duration_seconds": 16.43,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I'm a plumber, lots of bending and kneeling. My partner and our baby. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.08,
      "end_seconds": 189.03,
      "duration_seconds": 2.95,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.98,
      "end_seconds": 201.63,
      "duration_seconds": 2.65,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.49,
      "end_seconds": 235.58,
      "duration_seconds": 13.09,
      "text": "Okay: height 167 centimetres, BP is 127 over 74, oxygen saturation is 99 percent, pulse is 69 beats a minute, weight 77 kilos, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.14,
      "end_seconds": 239.25,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.73,
      "end_seconds": 244.35,
      "duration_seconds": 3.62,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.24,
      "end_seconds": 250.21,
      "duration_seconds": 2.97,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.97,
      "end_seconds": 253.16,
      "duration_seconds": 1.19,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.05,
      "end_seconds": 257.34,
      "duration_seconds": 2.29,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.95,
      "end_seconds": 272.59,
      "duration_seconds": 6.64,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.69,
      "end_seconds": 278.35,
      "duration_seconds": 1.66,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.59,
      "end_seconds": 332.07,
      "duration_seconds": 35.48,
      "text": "Okay, so my impression is this: It fits best with hip osteoarthritis. I'd like to arrange an X-ray of the hips for hip pain. Let's use naproxen, 250 milligrams, twice a day with food, two weeks. That should help with hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. I'd like you back in six weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.13,
      "end_seconds": 334.94,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.87,
      "end_seconds": 338.49,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}