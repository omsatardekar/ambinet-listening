{
  "schema_version": "1.0",
  "encounter_id": "03400",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 2.73,
      "duration_seconds": 1.51,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.32,
      "end_seconds": 7.69,
      "duration_seconds": 4.37,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.71,
      "end_seconds": 13.08,
      "duration_seconds": 3.37,
      "text": "I've been dealing with headaches most days."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.1,
      "end_seconds": 21.56,
      "duration_seconds": 6.46,
      "text": "can you tell me when it first started? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.34,
      "end_seconds": 24.74,
      "duration_seconds": 2.4,
      "text": "it's been one week now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 30.95,
      "duration_seconds": 5.07,
      "text": "Did you get weakness, visual changes, fever or stiff neck?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.73,
      "end_seconds": 34.01,
      "duration_seconds": 2.28,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.05,
      "end_seconds": 38.44,
      "duration_seconds": 3.39,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.66,
      "end_seconds": 42.41,
      "duration_seconds": 2.75,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.49,
      "end_seconds": 45.83,
      "duration_seconds": 2.34,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.74,
      "end_seconds": 49.3,
      "duration_seconds": 1.56,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.09,
      "end_seconds": 52.16,
      "duration_seconds": 2.07,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.95,
      "end_seconds": 56.05,
      "duration_seconds": 3.1,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.8,
      "end_seconds": 65.64,
      "duration_seconds": 4.84,
      "text": "okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.03,
      "end_seconds": 73.98,
      "duration_seconds": 3.95,
      "text": "Sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 95.97,
      "duration_seconds": 3.14,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.05,
      "end_seconds": 99.81,
      "duration_seconds": 2.76,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.75,
      "end_seconds": 115.2,
      "duration_seconds": 2.45,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.51,
      "end_seconds": 120.79,
      "duration_seconds": 4.28,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.85,
      "end_seconds": 126.15,
      "duration_seconds": 3.3,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.32,
      "end_seconds": 131.8,
      "duration_seconds": 4.48,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.95,
      "end_seconds": 136.89,
      "duration_seconds": 1.94,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.93,
      "end_seconds": 142.76,
      "duration_seconds": 3.83,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.03,
      "end_seconds": 147.62,
      "duration_seconds": 3.59,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 152.83,
      "duration_seconds": 4.61,
      "text": "I have migraines i've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.37,
      "end_seconds": 157.12,
      "duration_seconds": 2.75,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.87,
      "end_seconds": 162.63,
      "duration_seconds": 2.76,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.06,
      "end_seconds": 184.1,
      "duration_seconds": 3.04,
      "text": "Let's start with the the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 194.97,
      "duration_seconds": 2.37,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.3,
      "end_seconds": 212.3,
      "duration_seconds": 8.0,
      "text": "Okay: saturation 99 percent, pulse is 75 beats a minute, respiratory rate 16. And pressure 125 over 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.39,
      "end_seconds": 216.17,
      "duration_seconds": 2.78,
      "text": "mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.68,
      "end_seconds": 220.88,
      "duration_seconds": 3.2,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.94,
      "end_seconds": 225.64,
      "duration_seconds": 2.7,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.38,
      "end_seconds": 227.92,
      "duration_seconds": 1.54,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.4,
      "end_seconds": 233.02,
      "duration_seconds": 3.62,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.63,
      "end_seconds": 250.03,
      "duration_seconds": 2.4,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.79,
      "end_seconds": 268.61,
      "duration_seconds": 14.82,
      "text": "You can sit up now. So where does that leave us? I'd lean towards medication-overuse headache on a background of migraine. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.15,
      "end_seconds": 273.21,
      "duration_seconds": 3.06,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.91,
      "end_seconds": 288.11,
      "duration_seconds": 13.2,
      "text": "I understand the worry at the moment I'd say it's medication-overuse headache on a background of migraine, and we'll know more once the a headache diary is back"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.31,
      "end_seconds": 323.02,
      "duration_seconds": 21.71,
      "text": "I'd like to arrange a headache diary for daily headache. What I'm giving you is amitriptyline, 10 milligrams, at night, long term. It's for headache prevention. The pharmacy will go through the details again when you pick it up. Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.59,
      "end_seconds": 327.82,
      "duration_seconds": 4.23,
      "text": "Okay, go on. I'll want another look in six weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.84,
      "end_seconds": 329.54,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.23,
      "end_seconds": 334.01,
      "duration_seconds": 3.78,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.42,
      "end_seconds": 337.89,
      "duration_seconds": 2.47,
      "text": "thank you, doctor, goodbye"
    }
  ]
}