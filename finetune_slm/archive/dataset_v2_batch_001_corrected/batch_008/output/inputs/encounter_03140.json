{
  "schema_version": "1.0",
  "encounter_id": "03140",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.92,
      "end_seconds": 6.69,
      "duration_seconds": 5.77,
      "text": "doctor, if you're free, we can start. I've got the numbers noted down"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.36,
      "end_seconds": 12.65,
      "duration_seconds": 4.29,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.37,
      "end_seconds": 19.95,
      "duration_seconds": 6.58,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.06,
      "end_seconds": 24.61,
      "duration_seconds": 3.55,
      "text": "yes, that's no problem at all please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.74,
      "end_seconds": 30.03,
      "duration_seconds": 4.29,
      "text": "Well, I've been having shoulder tip pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.73,
      "end_seconds": 34.8,
      "duration_seconds": 3.07,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.44,
      "end_seconds": 40.35,
      "duration_seconds": 3.91,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.94,
      "end_seconds": 49.28,
      "duration_seconds": 3.34,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.87,
      "end_seconds": 65.73,
      "duration_seconds": 14.86,
      "text": "Severe, I'd say. And there's vomiting as well, um, about two weeks now. I did have pain spreading all over at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 67.61,
      "end_seconds": 77.4,
      "duration_seconds": 9.79,
      "text": "Okay, so the the vitals from earlier. SpO2 99 percent on room air, respiratory rate 18, heart rate 123, blood pressure 122 over 79."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.85,
      "end_seconds": 83.93,
      "duration_seconds": 5.08,
      "text": "Thanks. Have you had any diarrhoea, blood in the vomit or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.11,
      "end_seconds": 87.99,
      "duration_seconds": 2.88,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.22,
      "end_seconds": 91.64,
      "duration_seconds": 2.42,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.2,
      "end_seconds": 95.88,
      "duration_seconds": 2.68,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.59,
      "end_seconds": 99.88,
      "duration_seconds": 2.29,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.54,
      "end_seconds": 102.7,
      "duration_seconds": 2.16,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.61,
      "end_seconds": 106.85,
      "duration_seconds": 3.24,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.93,
      "end_seconds": 113.79,
      "duration_seconds": 5.86,
      "text": "just two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 123.31,
      "duration_seconds": 1.8,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.21,
      "end_seconds": 131.01,
      "duration_seconds": 5.8,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.79,
      "end_seconds": 134.18,
      "duration_seconds": 1.39,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 134.83,
      "end_seconds": 139.68,
      "duration_seconds": 4.85,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.75,
      "end_seconds": 143.7,
      "duration_seconds": 1.95,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.5,
      "end_seconds": 149.56,
      "duration_seconds": 4.06,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.55,
      "end_seconds": 152.46,
      "duration_seconds": 1.91,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.81,
      "end_seconds": 158.62,
      "duration_seconds": 4.81,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 162.68,
      "duration_seconds": 2.28,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.46,
      "end_seconds": 168.44,
      "duration_seconds": 4.98,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.3,
      "end_seconds": 184.91,
      "duration_seconds": 3.61,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.16,
      "end_seconds": 188.64,
      "duration_seconds": 2.48,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.64,
      "end_seconds": 196.27,
      "duration_seconds": 6.63,
      "text": "Do you take any prescribed or over-the-counter medicines? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.27,
      "end_seconds": 212.05,
      "duration_seconds": 13.78,
      "text": "Naproxen, 250 milligrams, twice a day for the knee pain. I take iron tablets, once a day. Metoprolol. I take it twice a day for my heart."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.79,
      "end_seconds": 214.9,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 223.08,
      "duration_seconds": 7.6,
      "text": "50 milligrams. Erm, you know, I was on aspirin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.97,
      "end_seconds": 228.29,
      "duration_seconds": 3.32,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.95,
      "end_seconds": 241.22,
      "duration_seconds": 7.27,
      "text": "I've had arthritis in my knees for five years now. I have low haemoglobin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.56,
      "end_seconds": 246.33,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.33,
      "end_seconds": 261.38,
      "duration_seconds": 14.05,
      "text": "Oh, I have heart failure, for five years. I did try to ignore it for a while. Sorry, I know I'm rambling a bit. I've got heart disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.22,
      "end_seconds": 283.22,
      "duration_seconds": 17.0,
      "text": "Sure. Okay, I can see arthritis in your knees in your file as well. So, based on your history, I think we're dealing with a perforated stomach ulcer at this stage. Pancreatitis is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 303.53,
      "duration_seconds": 10.91,
      "text": "I'm going to order a CT scan, for possible perforation. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.56,
      "end_seconds": 307.4,
      "duration_seconds": 2.84,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.42,
      "end_seconds": 331.64,
      "duration_seconds": 23.22,
      "text": "I'm going to order urgent blood tests, for acute abdomen. The result will help us decide whether anything more is needed. Nothing to eat or drink, you need an operation urgently. I'm going to send a referral to the surgical team. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.41,
      "end_seconds": 335.0,
      "duration_seconds": 1.59,
      "text": "I, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.06,
      "end_seconds": 339.5,
      "duration_seconds": 2.44,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 340.31,
      "end_seconds": 341.01,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.12,
      "end_seconds": 344.75,
      "duration_seconds": 2.63,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.04,
      "end_seconds": 349.72,
      "duration_seconds": 3.68,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}