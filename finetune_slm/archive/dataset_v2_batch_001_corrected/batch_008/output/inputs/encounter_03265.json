      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.84,
      "end_seconds": 257.03,
      "duration_seconds": 5.19,
      "text": "Your tummy is soft and your weight is stable on the scales."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.82,
      "end_seconds": 259.38,
      "duration_seconds": 1.56,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.04,
      "end_seconds": 275.62,
      "duration_seconds": 10.58,
      "text": "you can relax now so where does that leave us? It points towards coeliac disease on a gluten-free diet with some accidental exposure"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.95,
      "end_seconds": 279.67,
      "duration_seconds": 2.72,
      "text": "is it it dangerous doctor?"
