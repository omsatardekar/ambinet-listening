      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.86,
      "end_seconds": 224.56,
      "duration_seconds": 12.7,
      "text": "sorry you know what was I saying it's telmisartan 40 milligrams once a day i'm on hydrocortisone cream when needed for the eczema"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.41,
      "end_seconds": 231.01,
      "duration_seconds": 3.6,
      "text": "Now I'm going to do a short physical check."
