    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.42,
      "end_seconds": 182.81,
      "duration_seconds": 2.39,
      "text": "do you have any chronic illnesses?"
