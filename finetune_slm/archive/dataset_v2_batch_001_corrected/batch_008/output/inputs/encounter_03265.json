    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.42,
      "end_seconds": 172.03,
      "duration_seconds": 4.61,
      "text": "I retired from the post office two years ago"
