      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.74,
      "end_seconds": 190.24,
      "duration_seconds": 5.5,
      "text": "I have high blood pressure for two years. Eczema for two years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.93,
      "end_seconds": 195.87,
      "duration_seconds": 3.94,
      "text": "mm, okay have you ever had an operation?"
