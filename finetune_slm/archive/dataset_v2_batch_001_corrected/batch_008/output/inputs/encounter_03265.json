    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.08,
      "end_seconds": 210.59,
      "duration_seconds": 4.51,
      "text": "can you list what you take, tablets, creams or inhalers?"
