      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.33,
      "end_seconds": 241.01,
      "duration_seconds": 1.68,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.86,
      "end_seconds": 244.31,
      "duration_seconds": 2.45,
      "text": "hold that for a a second"
