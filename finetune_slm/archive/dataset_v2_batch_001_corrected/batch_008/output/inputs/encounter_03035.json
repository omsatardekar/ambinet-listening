{
  "schema_version": "1.0",
  "encounter_id": "03035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 8.26,
      "duration_seconds": 7.51,
      "text": "Okay, come in, have a seat by the desk. So, have you been here before?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.9,
      "end_seconds": 13.89,
      "duration_seconds": 3.99,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.85,
      "end_seconds": 17.85,
      "duration_seconds": 3.0,
      "text": "how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.66,
      "end_seconds": 24.53,
      "duration_seconds": 4.87,
      "text": "I wanted to get pain spreading all over looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 28.62,
      "duration_seconds": 3.11,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.75,
      "end_seconds": 33.09,
      "duration_seconds": 3.34,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.6,
      "end_seconds": 37.08,
      "duration_seconds": 3.48,
      "text": "Yes, carry on. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.11,
      "end_seconds": 48.09,
      "duration_seconds": 8.98,
      "text": "it usually comes with a sudden severe tummy pain the sudden severe tummy pain? That's been since last weekend"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.11,
      "end_seconds": 52.22,
      "duration_seconds": 2.11,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.67,
      "end_seconds": 56.8,
      "duration_seconds": 3.13,
      "text": "I get some relief from lying still."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.31,
      "end_seconds": 58.23,
      "duration_seconds": 0.92,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.81,
      "end_seconds": 76.56,
      "duration_seconds": 4.75,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.38,
      "end_seconds": 79.42,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.81,
      "end_seconds": 83.67,
      "duration_seconds": 2.86,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.65,
      "end_seconds": 97.06,
      "duration_seconds": 11.41,
      "text": "My partner and our baby. I work in accounts at a hospital. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.99,
      "end_seconds": 103.29,
      "duration_seconds": 4.3,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.0,
      "end_seconds": 107.3,
      "duration_seconds": 2.3,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.48,
      "end_seconds": 128.8,
      "duration_seconds": 3.32,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.08,
      "end_seconds": 134.92,
      "duration_seconds": 4.84,
      "text": "Let me think, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.91,
      "end_seconds": 140.75,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 151.12,
      "duration_seconds": 5.63,
      "text": "Ibuprofen. I take it 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.86,
      "end_seconds": 156.52,
      "duration_seconds": 3.66,
      "text": "Has there been any blood in the vomit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.05,
      "end_seconds": 162.25,
      "duration_seconds": 4.2,
      "text": "I haven't noticed any blood in the vomit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.37,
      "end_seconds": 166.05,
      "duration_seconds": 2.68,
      "text": "Any fever or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.5,
      "end_seconds": 171.11,
      "duration_seconds": 3.61,
      "text": "No fever or diarrhoea, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.14,
      "end_seconds": 176.57,
      "duration_seconds": 4.43,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.07,
      "end_seconds": 180.06,
      "duration_seconds": 1.99,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 195.31,
      "end_seconds": 204.27,
      "duration_seconds": 8.96,
      "text": "Okay, so the vitals from earlier. Heart rate 108, oxygen saturation is 97 percent. Pressure 136 over 87, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.1,
      "end_seconds": 207.2,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.55,
      "end_seconds": 214.28,
      "duration_seconds": 4.73,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.82,
      "end_seconds": 219.1,
      "duration_seconds": 3.28,
      "text": "Right, take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.87,
      "end_seconds": 238.92,
      "duration_seconds": 8.05,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.56,
      "end_seconds": 245.4,
      "duration_seconds": 1.84,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.65,
      "end_seconds": 262.06,
      "duration_seconds": 6.41,
      "text": "Let me tell you where I've got to. My working impression is a perforated stomach ulcer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.18,
      "end_seconds": 266.33,
      "duration_seconds": 3.15,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.8,
      "end_seconds": 301.89,
      "duration_seconds": 31.09,
      "text": "I can't promise yet, but most people with a perforated stomach ulcer do well once it's treated properly. Let's get urgent blood tests, for acute abdomen. That will help us see what's going on underneath and decide the next step. Nothing to eat or drink, you need an operation urgently. I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.23,
      "end_seconds": 306.28,
      "duration_seconds": 3.05,
      "text": "Alright, um, thanks, take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.34,
      "end_seconds": 308.8,
      "duration_seconds": 1.46,
      "text": "see you soon"
    }
  ]
}