{
  "schema_version": "1.0",
  "encounter_id": "03369",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.77,
      "duration_seconds": 5.51,
      "text": "Good evening, um, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.37,
      "end_seconds": 11.8,
      "duration_seconds": 4.43,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.78,
      "end_seconds": 18.32,
      "duration_seconds": 4.54,
      "text": "I wanted to get double vision looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.75,
      "end_seconds": 22.97,
      "duration_seconds": 3.22,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.66,
      "end_seconds": 30.88,
      "duration_seconds": 6.22,
      "text": "Uh, um, it's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.9,
      "end_seconds": 36.94,
      "duration_seconds": 4.04,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.68,
      "end_seconds": 40.81,
      "duration_seconds": 3.13,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.89,
      "end_seconds": 46.99,
      "duration_seconds": 4.1,
      "text": "Has there been a severe headache for days too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.93,
      "end_seconds": 67.9,
      "duration_seconds": 18.97,
      "text": "Yes, about the same, ten days. Let me think, as for severe headache for days, it happens all the time. It's worse with lying down. I mean, um, I've also had being sick, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.43,
      "end_seconds": 72.35,
      "duration_seconds": 3.92,
      "text": "Any weakness on one side, fever or head injury?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.2,
      "end_seconds": 78.09,
      "duration_seconds": 3.89,
      "text": "Yeah, no, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.69,
      "end_seconds": 83.6,
      "duration_seconds": 4.91,
      "text": "Yes, carry on. On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.48,
      "end_seconds": 91.33,
      "duration_seconds": 5.85,
      "text": "Mm, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.48,
      "end_seconds": 95.23,
      "duration_seconds": 2.75,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.02,
      "end_seconds": 99.2,
      "duration_seconds": 3.18,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.52,
      "end_seconds": 113.91,
      "duration_seconds": 4.39,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.25,
      "end_seconds": 119.08,
      "duration_seconds": 3.83,
      "text": "Okay, so my sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.62,
      "end_seconds": 121.61,
      "duration_seconds": 1.99,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.58,
      "end_seconds": 126.14,
      "duration_seconds": 3.56,
      "text": "I have acid reflux, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.68,
      "end_seconds": 135.91,
      "duration_seconds": 8.23,
      "text": "Yes, acid reflux is known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.8,
      "end_seconds": 141.19,
      "duration_seconds": 4.39,
      "text": "Hmm, no, not that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.59,
      "end_seconds": 146.42,
      "duration_seconds": 3.83,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.29,
      "end_seconds": 151.86,
      "duration_seconds": 4.57,
      "text": "Pantoprazole. I take it 40 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.21,
      "end_seconds": 157.17,
      "duration_seconds": 3.96,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.69,
      "end_seconds": 161.1,
      "duration_seconds": 3.41,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.26,
      "end_seconds": 165.51,
      "duration_seconds": 3.25,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.54,
      "end_seconds": 172.33,
      "duration_seconds": 5.79,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.1,
      "end_seconds": 175.62,
      "duration_seconds": 2.52,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.49,
      "end_seconds": 181.25,
      "duration_seconds": 3.76,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.21,
      "end_seconds": 186.51,
      "duration_seconds": 3.3,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.8,
      "end_seconds": 194.74,
      "duration_seconds": 6.94,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.76,
      "end_seconds": 199.27,
      "duration_seconds": 3.51,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.0,
      "end_seconds": 217.03,
      "duration_seconds": 3.03,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.32,
      "end_seconds": 220.51,
      "duration_seconds": 2.19,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.36,
      "end_seconds": 233.66,
      "duration_seconds": 4.3,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.84,
      "end_seconds": 238.66,
      "duration_seconds": 1.82,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.27,
      "end_seconds": 287.0,
      "duration_seconds": 34.73,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at possible cerebral venous thrombosis or raised pressure in the head. I'll request an urgent CT venogram, it'll help with possible venous thrombosis. Stop the pill, you need an urgent scan and admission. Let's get you seen by the neurology team, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.98,
      "end_seconds": 290.71,
      "duration_seconds": 1.73,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.26,
      "end_seconds": 293.89,
      "duration_seconds": 2.63,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.76,
      "end_seconds": 298.9,
      "duration_seconds": 4.14,
      "text": "Actually, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.43,
      "end_seconds": 301.18,
      "duration_seconds": 1.75,
      "text": "Have a good day."
    }
  ]
}