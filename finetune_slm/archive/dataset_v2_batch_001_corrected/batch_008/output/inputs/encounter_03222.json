{
  "schema_version": "1.0",
  "encounter_id": "03222",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.74,
      "duration_seconds": 3.42,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 11.33,
      "duration_seconds": 5.5,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.48,
      "end_seconds": 20.7,
      "duration_seconds": 7.22,
      "text": "Um, so... a high sugar test in pregnancy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 24.75,
      "duration_seconds": 2.91,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 33.39,
      "duration_seconds": 7.51,
      "text": "About... well, ten days. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.89,
      "end_seconds": 38.46,
      "duration_seconds": 3.57,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.74,
      "end_seconds": 40.87,
      "duration_seconds": 1.13,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 44.13,
      "duration_seconds": 2.33,
      "text": "Any no symptoms as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.04,
      "end_seconds": 49.4,
      "duration_seconds": 3.36,
      "text": "Yeah, I've had that since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.9,
      "end_seconds": 55.99,
      "duration_seconds": 5.09,
      "text": "Have you noticed passing a lot of urine or blurred vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.22,
      "end_seconds": 66.49,
      "duration_seconds": 5.27,
      "text": "No, no passing a lot of urine or blurred vision."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.96,
      "end_seconds": 71.34,
      "duration_seconds": 3.38,
      "text": "Have you had thirst, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.37,
      "end_seconds": 74.87,
      "duration_seconds": 1.5,
      "text": "No, no thirst."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.39,
      "end_seconds": 78.82,
      "duration_seconds": 3.43,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.11,
      "end_seconds": 81.21,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.99,
      "end_seconds": 99.89,
      "duration_seconds": 4.9,
      "text": "Do you have any chronic illnesses? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 102.5,
      "duration_seconds": 1.92,
      "text": "Gout, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.32,
      "end_seconds": 105.58,
      "duration_seconds": 2.26,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 110.96,
      "duration_seconds": 4.7,
      "text": "I'm on febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.64,
      "end_seconds": 113.97,
      "duration_seconds": 2.33,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.9,
      "end_seconds": 118.53,
      "duration_seconds": 2.63,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.53,
      "end_seconds": 121.87,
      "duration_seconds": 2.34,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.42,
      "end_seconds": 124.75,
      "duration_seconds": 2.33,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.42,
      "end_seconds": 139.37,
      "duration_seconds": 2.95,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.27,
      "end_seconds": 145.13,
      "duration_seconds": 3.86,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.02,
      "end_seconds": 163.72,
      "duration_seconds": 2.7,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.27,
      "end_seconds": 174.36,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.28,
      "end_seconds": 204.4,
      "duration_seconds": 12.12,
      "text": "Okay: weight 96 kilos, height 150 centimetres, SpO2 97 percent on room air. And blood pressure 119 over 71, temperature 36.9, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.63,
      "end_seconds": 207.25,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.8,
      "end_seconds": 212.19,
      "duration_seconds": 3.39,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.23,
      "end_seconds": 216.58,
      "duration_seconds": 2.35,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.37,
      "end_seconds": 227.98,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.81,
      "end_seconds": 230.15,
      "duration_seconds": 1.34,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.43,
      "end_seconds": 253.44,
      "duration_seconds": 5.01,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.01,
      "end_seconds": 267.1,
      "duration_seconds": 8.09,
      "text": "Alright, you can relax now. Right, here's what I'm thinking. This looks most like gestational diabetes controllable with diet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.91,
      "end_seconds": 272.11,
      "duration_seconds": 3.2,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.61,
      "end_seconds": 301.96,
      "duration_seconds": 28.35,
      "text": "Nothing I've seen today points to an emergency. It looks like gestational diabetes controllable with diet, but I'd like to confirm. Let's book a glucose meter and diary to look into gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals. Come back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.56,
      "end_seconds": 304.31,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    }
  ]
}