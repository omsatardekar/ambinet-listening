{
  "schema_version": "1.0",
  "encounter_id": "03299",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 7.45,
      "duration_seconds": 6.18,
      "text": "Hello, sorry about the delay, do sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.02,
      "end_seconds": 13.46,
      "duration_seconds": 5.44,
      "text": "Well, I've been having pain in my groin and hip."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.26,
      "end_seconds": 18.31,
      "duration_seconds": 3.05,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.37,
      "end_seconds": 22.44,
      "duration_seconds": 2.07,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.16,
      "end_seconds": 27.01,
      "duration_seconds": 3.85,
      "text": "Alright, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.77,
      "end_seconds": 32.07,
      "duration_seconds": 3.3,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.03,
      "end_seconds": 34.76,
      "duration_seconds": 1.73,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 39.33,
      "duration_seconds": 3.29,
      "text": "It settles a little with rest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.78,
      "end_seconds": 55.77,
      "duration_seconds": 1.99,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.59,
      "end_seconds": 59.14,
      "duration_seconds": 1.55,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.8,
      "end_seconds": 64.84,
      "duration_seconds": 4.04,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.86,
      "end_seconds": 67.33,
      "duration_seconds": 1.47,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.89,
      "end_seconds": 81.21,
      "duration_seconds": 3.32,
      "text": "So, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.0,
      "end_seconds": 85.44,
      "duration_seconds": 2.44,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.25,
      "end_seconds": 99.27,
      "duration_seconds": 4.02,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.18,
      "end_seconds": 104.0,
      "duration_seconds": 3.82,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 107.53,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.2,
      "end_seconds": 112.71,
      "duration_seconds": 4.51,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.05,
      "end_seconds": 120.39,
      "duration_seconds": 2.34,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.05,
      "end_seconds": 125.72,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.77,
      "end_seconds": 130.03,
      "duration_seconds": 2.26,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.0,
      "end_seconds": 133.7,
      "duration_seconds": 2.7,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.62,
      "end_seconds": 151.7,
      "duration_seconds": 2.08,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.21,
      "end_seconds": 154.81,
      "duration_seconds": 2.6,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.27,
      "end_seconds": 159.82,
      "duration_seconds": 3.55,
      "text": "Any fall, weight loss or numbness at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.6,
      "end_seconds": 164.34,
      "duration_seconds": 3.74,
      "text": "No, no fall, weight loss or numbness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.33,
      "end_seconds": 169.0,
      "duration_seconds": 3.67,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.64,
      "end_seconds": 171.46,
      "duration_seconds": 1.82,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.54,
      "end_seconds": 175.07,
      "duration_seconds": 2.53,
      "text": "Okay, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.45,
      "end_seconds": 178.01,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.0,
      "end_seconds": 182.3,
      "duration_seconds": 3.3,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.55,
      "end_seconds": 191.2,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.98,
      "end_seconds": 221.45,
      "duration_seconds": 10.47,
      "text": "Okay: temperature is 36.7 degrees, respiratory rate 15, pulse is 70 beats a minute. And saturation 97 percent, pressure 121 over 82."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.53,
      "end_seconds": 223.99,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.2,
      "end_seconds": 227.95,
      "duration_seconds": 2.75,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.15,
      "end_seconds": 233.53,
      "duration_seconds": 3.38,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.8,
      "end_seconds": 238.83,
      "duration_seconds": 4.03,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.44,
      "end_seconds": 263.15,
      "duration_seconds": 6.71,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.85,
      "end_seconds": 278.17,
      "duration_seconds": 12.32,
      "text": "That's all I needed to check. Right, here's what I'm thinking. I can't pin this down yet. We're looking at hip osteoarthritis or a back problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.07,
      "end_seconds": 283.64,
      "duration_seconds": 3.57,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.53,
      "end_seconds": 312.68,
      "duration_seconds": 28.15,
      "text": "I can't promise yet, but most people with hip osteoarthritis do well once it's treated properly. I think an X-ray of the hips makes sense here, for hip pain. I'm going to put you on naproxen, 250 milligrams, twice a day with food, two weeks. You take it by mouth. That should help with hip pain. Use a walking stick in the left hand and do gentle strengthening exercises."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.67,
      "end_seconds": 322.84,
      "duration_seconds": 8.17,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.36,
      "end_seconds": 326.75,
      "duration_seconds": 3.39,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.14,
      "end_seconds": 330.65,
      "duration_seconds": 2.51,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.83,
      "end_seconds": 334.95,
      "duration_seconds": 3.12,
      "text": "I think I understand everything. Thanks."
    }
  ]
