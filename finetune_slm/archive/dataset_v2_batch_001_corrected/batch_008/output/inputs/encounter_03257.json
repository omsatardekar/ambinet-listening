{
  "schema_version": "1.0",
  "encounter_id": "03257",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 7.16,
      "duration_seconds": 6.28,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.25,
      "end_seconds": 14.24,
      "duration_seconds": 4.99,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.23,
      "end_seconds": 22.6,
      "duration_seconds": 7.37,
      "text": "doctor, it's a severe headache for days. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.23,
      "end_seconds": 25.52,
      "duration_seconds": 2.29,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.22,
      "end_seconds": 41.57,
      "duration_seconds": 2.35,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.55,
      "end_seconds": 64.03,
      "duration_seconds": 7.48,
      "text": "Okay: heart rate 78, temp 37.0 degrees, pressure 161 over 100, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.01,
      "end_seconds": 67.55,
      "duration_seconds": 2.54,
      "text": "Is that that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 72.33,
      "duration_seconds": 4.21,
      "text": "We'll go over that shortly. When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.88,
      "end_seconds": 77.27,
      "duration_seconds": 3.39,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.57,
      "end_seconds": 87.45,
      "duration_seconds": 8.88,
      "text": "Right, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.07,
      "end_seconds": 99.24,
      "duration_seconds": 10.17,
      "text": "yeah, it's worse with lying down i'd say moderate it happens all the time i've also had drowsiness, for about four days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.68,
      "end_seconds": 102.73,
      "duration_seconds": 2.05,
      "text": "Any double vision as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.99,
      "end_seconds": 112.07,
      "duration_seconds": 5.08,
      "text": "sorry, what was I saying, yes, that started yesterday"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.92,
      "end_seconds": 114.57,
      "duration_seconds": 1.65,
      "text": "what about head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.22,
      "end_seconds": 119.3,
      "duration_seconds": 3.08,
      "text": "Nope, um, no head injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 124.13,
      "duration_seconds": 3.78,
      "text": "Did you get fever or weakness on one side?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.22,
      "end_seconds": 129.27,
      "duration_seconds": 3.05,
      "text": "I mean, none of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.38,
      "end_seconds": 136.41,
      "duration_seconds": 3.03,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.3,
      "end_seconds": 142.14,
      "duration_seconds": 3.84,
      "text": "Ah, uh, no, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.32,
      "end_seconds": 155.95,
      "duration_seconds": 4.63,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.02,
      "end_seconds": 165.11,
      "duration_seconds": 6.09,
      "text": "Omeprazole i take it 20 milligrams, maybe, once a day for the reflux"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.25,
      "end_seconds": 172.61,
      "duration_seconds": 4.36,
      "text": "did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.33,
      "end_seconds": 186.85,
      "duration_seconds": 13.52,
      "text": "Not with me. I'll bring it next time. The contraceptive pill. I take it daily. I had lansoprazole at one point, you know, but I'm off it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.54,
      "end_seconds": 202.85,
      "duration_seconds": 3.31,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.92,
      "end_seconds": 208.01,
      "duration_seconds": 3.09,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.66,
      "end_seconds": 210.62,
      "duration_seconds": 1.96,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.6,
      "end_seconds": 217.91,
      "duration_seconds": 4.31,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.7,
      "end_seconds": 222.57,
      "duration_seconds": 2.87,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.47,
      "end_seconds": 228.74,
      "duration_seconds": 5.27,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.09,
      "end_seconds": 234.85,
      "duration_seconds": 4.76,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.86,
      "end_seconds": 240.54,
      "duration_seconds": 4.68,
      "text": "I've had acid reflux for about a year now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.72,
      "end_seconds": 247.56,
      "duration_seconds": 5.84,
      "text": "Yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.07,
      "end_seconds": 253.95,
      "duration_seconds": 3.88,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.93,
      "end_seconds": 257.9,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.0,
      "end_seconds": 275.82,
      "duration_seconds": 3.82,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 286.85,
      "duration_seconds": 7.8,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: This is probably possible cerebral venous thrombosis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.56,
      "end_seconds": 308.25,
      "duration_seconds": 3.69,
      "text": "Let's get an MRI of the head, for papilloedema."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.24,
      "end_seconds": 312.45,
      "duration_seconds": 3.21,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.95,
      "end_seconds": 323.27,
      "duration_seconds": 9.32,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.37,
      "end_seconds": 326.01,
      "duration_seconds": 1.64,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.32,
      "end_seconds": 331.05,
      "duration_seconds": 3.73,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.5,
      "end_seconds": 336.02,
      "duration_seconds": 3.52,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.96,
      "end_seconds": 338.63,
      "duration_seconds": 1.67,
      "text": "have a good day"
    }
  ]
