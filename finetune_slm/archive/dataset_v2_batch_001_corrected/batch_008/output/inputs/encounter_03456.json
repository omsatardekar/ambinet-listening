  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.38,
      "duration_seconds": 4.79,
      "text": "Um hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 11.8,
      "duration_seconds": 5.07,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 20.94,
      "duration_seconds": 7.97,
      "text": "honestly, it's a high sugar test in pregnancy, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.57,
      "end_seconds": 26.38,
      "duration_seconds": 3.81,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.61,
      "end_seconds": 35.26,
      "duration_seconds": 2.65,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.82,
      "end_seconds": 71.71,
      "duration_seconds": 16.89,
      "text": "Okay: saturation 97 percent, respiratory rate 17, pulse 81, temp 36.5 degrees, blood pressure 109 over 74, height 153 centimetres, weight 84 kilos. How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.88,
      "end_seconds": 78.56,
      "duration_seconds": 2.68,
      "text": "ever since... since last weekend really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 96.21,
      "duration_seconds": 1.95,
      "text": "what about reduced baby movements?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.05,
      "end_seconds": 101.74,
      "duration_seconds": 3.69,
      "text": "nope, uh, no reduced baby movements"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.58,
      "end_seconds": 107.91,
      "duration_seconds": 5.33,
      "text": "and what about blurred vision, passing a lot of urine or thirst?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.66,
      "end_seconds": 111.08,
      "duration_seconds": 2.42,
      "text": "no not a single one"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.89,
      "end_seconds": 115.12,
      "duration_seconds": 3.23,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.64,
      "end_seconds": 118.23,
      "duration_seconds": 1.59,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.19,
      "end_seconds": 122.33,
      "duration_seconds": 3.14,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.45,
      "end_seconds": 125.44,
      "duration_seconds": 1.99,
      "text": "no that's been fine"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.33,
      "end_seconds": 148.88,
      "duration_seconds": 5.55,
      "text": "do you have any long-term conditions? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.68,
      "end_seconds": 154.56,
      "duration_seconds": 4.88,
      "text": "I have high blood pressure for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.12,
      "end_seconds": 160.5,
      "duration_seconds": 5.38,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.81,
      "end_seconds": 173.81,
      "duration_seconds": 8.0,
      "text": "actually, years back I got feeling very drowsy from tramadol, so I stay away from it now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.4,
      "end_seconds": 177.75,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.38,
      "end_seconds": 184.59,
      "duration_seconds": 5.21,
      "text": "Uh I take losartan 50 milligrams once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.53,
      "end_seconds": 195.86,
      "duration_seconds": 3.33,
      "text": "alright, a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.46,
      "end_seconds": 206.98,
      "duration_seconds": 10.52,
      "text": "Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts. I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.85,
      "end_seconds": 213.61,
      "duration_seconds": 3.76,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.0,
      "end_seconds": 216.22,
      "duration_seconds": 1.22,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.56,
      "end_seconds": 232.24,
      "duration_seconds": 5.68,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.38,
      "end_seconds": 239.79,
      "duration_seconds": 2.41,
      "text": "thank you you can get dressed"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 253.53,
      "duration_seconds": 6.35,
      "text": "right, here's what I'm thinking this is probably gestational diabetes controllable with diet"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.22,
      "end_seconds": 257.23,
      "duration_seconds": 2.01,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.69,
      "end_seconds": 274.34,
      "duration_seconds": 15.65,
      "text": "I understand the worry. At the moment I'd say it's gestational diabetes controllable with diet and we'll know more once the a growth scan is back. We should do a growth scan for gestational diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.69,
      "end_seconds": 278.41,
      "duration_seconds": 2.72,
      "text": "do I need to to prepare?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.98,
      "end_seconds": 307.34,
      "duration_seconds": 27.36,
      "text": "replace sugary drinks and white starches with wholegrains and walk after meals. I think the diabetes midwife should see you too. I'm not ordering a glucose meter and diary today. If things carry on in a month, we'll consider it. Do get help quickly if the symptoms get worse. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.85,
      "end_seconds": 311.25,
      "duration_seconds": 3.4,
      "text": "great thank you for your help"
    }
  ]
}