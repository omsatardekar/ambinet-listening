{
  "schema_version": "1.0",
  "encounter_id": "03169",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.86,
      "end_seconds": 8.11,
      "duration_seconds": 7.25,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.19,
      "end_seconds": 12.75,
      "duration_seconds": 3.56,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.16,
      "end_seconds": 24.44,
      "duration_seconds": 7.28,
      "text": "Doctor, it's pain in my groin and hip. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.1,
      "end_seconds": 29.74,
      "duration_seconds": 3.64,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.56,
      "end_seconds": 34.93,
      "duration_seconds": 3.37,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.5,
      "end_seconds": 40.63,
      "duration_seconds": 5.13,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.91,
      "end_seconds": 54.39,
      "duration_seconds": 9.48,
      "text": "I get some relief from rest. Walking definitely sets it off. It feels severe to me. It happens every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 55.57,
      "end_seconds": 64.29,
      "duration_seconds": 8.72,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 99 percent, temp 36.5 degrees, blood pressure 108 over 76, pulse 81."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.83,
      "end_seconds": 66.53,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.57,
      "end_seconds": 71.6,
      "duration_seconds": 3.03,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.11,
      "end_seconds": 74.11,
      "duration_seconds": 1.0,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.8,
      "end_seconds": 77.87,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.41,
      "end_seconds": 93.78,
      "duration_seconds": 6.37,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.72,
      "end_seconds": 104.59,
      "duration_seconds": 4.87,
      "text": "Okay, that's enough for me. Has there been any numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.14,
      "end_seconds": 106.62,
      "duration_seconds": 1.48,
      "text": "Nope, no numbness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.26,
      "end_seconds": 111.53,
      "duration_seconds": 3.27,
      "text": "Have you had any weight loss or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.22,
      "end_seconds": 115.58,
      "duration_seconds": 2.36,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 122.69,
      "duration_seconds": 3.64,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.47,
      "end_seconds": 127.48,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.47,
      "end_seconds": 132.22,
      "duration_seconds": 2.75,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.87,
      "end_seconds": 138.03,
      "duration_seconds": 5.16,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 143.43,
      "duration_seconds": 4.15,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.16,
      "end_seconds": 149.67,
      "duration_seconds": 3.51,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.62,
      "end_seconds": 153.93,
      "duration_seconds": 3.31,
      "text": "Right, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.8,
      "end_seconds": 157.17,
      "duration_seconds": 2.37,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.69,
      "end_seconds": 163.41,
      "duration_seconds": 4.72,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.5,
      "end_seconds": 180.92,
      "duration_seconds": 15.42,
      "text": "No, I've never smoked in my life. I only drink at family occasions. I hardly move around during the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.81,
      "end_seconds": 193.01,
      "duration_seconds": 3.2,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.72,
      "end_seconds": 199.18,
      "duration_seconds": 2.46,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.18,
      "end_seconds": 212.32,
      "duration_seconds": 5.14,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.48,
      "end_seconds": 216.44,
      "duration_seconds": 2.96,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.55,
      "end_seconds": 232.31,
      "duration_seconds": 4.76,
      "text": "Taking everything into account, it fits best with hip osteoarthritis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.32,
      "end_seconds": 281.07,
      "duration_seconds": 30.75,
      "text": "We should do an X-ray of the hips for hip pain. I'm prescribing naproxen, 250 milligrams, twice a day with food, two weeks. That's for hip pain. Use a walking stick in the left hand and do gentle strengthening exercises. The orthopaedic clinic would be the right next step, I'll refer you. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.62,
      "end_seconds": 285.68,
      "duration_seconds": 3.06,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.6,
      "end_seconds": 297.49,
      "duration_seconds": 5.89,
      "text": "I'd like to see you again in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.5,
      "end_seconds": 301.19,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    }
  ]
}