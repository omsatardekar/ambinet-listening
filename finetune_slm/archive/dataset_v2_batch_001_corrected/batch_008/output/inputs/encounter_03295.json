{
  "schema_version": "1.0",
  "encounter_id": "03295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.28,
      "end_seconds": 4.2,
      "duration_seconds": 2.92,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.6,
      "end_seconds": 6.63,
      "duration_seconds": 1.03,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.82,
      "end_seconds": 12.41,
      "duration_seconds": 2.59,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.47,
      "end_seconds": 18.46,
      "duration_seconds": 4.99,
      "text": "Hmm, I'm here because of pain in my breastbone wound."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.15,
      "end_seconds": 23.06,
      "duration_seconds": 2.91,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.63,
      "end_seconds": 27.21,
      "duration_seconds": 3.58,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.1,
      "end_seconds": 31.69,
      "duration_seconds": 2.59,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.8,
      "end_seconds": 37.09,
      "duration_seconds": 4.29,
      "text": "A five out of ten, you know, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.34,
      "end_seconds": 40.77,
      "duration_seconds": 2.43,
      "text": "Any swollen ankles as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.29,
      "end_seconds": 49.98,
      "duration_seconds": 8.69,
      "text": "Okay, so yes, since last Tuesday. With swollen ankles, it's moderate, honestly. And tiredness, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.58,
      "end_seconds": 61.59,
      "duration_seconds": 7.01,
      "text": "Have you had pain in your breastbone wound before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.4,
      "end_seconds": 68.97,
      "duration_seconds": 6.57,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 69.73,
      "end_seconds": 77.04,
      "duration_seconds": 7.31,
      "text": "Here are the numbers, doctor. Respiratory rate 18, temperature 36.8. Heart rate 74, blood pressure 125 over 82."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.11,
      "end_seconds": 80.18,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.06,
      "end_seconds": 85.86,
      "duration_seconds": 2.8,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.22,
      "end_seconds": 87.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.82,
      "end_seconds": 91.09,
      "duration_seconds": 2.27,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.07,
      "end_seconds": 109.56,
      "duration_seconds": 9.49,
      "text": "The chest wound has healed, the breastbone is stable, and the vein-harvest wound on the leg is a little swollen."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 121.64,
      "duration_seconds": 6.78,
      "text": "Thank you, you can get dressed. And what about chest pain on exertion, breathlessness or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.16,
      "end_seconds": 125.8,
      "duration_seconds": 2.64,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 128.97,
      "duration_seconds": 2.32,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.05,
      "end_seconds": 134.26,
      "duration_seconds": 3.21,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.0,
      "end_seconds": 140.56,
      "duration_seconds": 4.56,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.43,
      "end_seconds": 154.21,
      "duration_seconds": 11.78,
      "text": "Aspirin. I take it 75 milligrams, once a day for my heart. Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 156.23,
      "end_seconds": 160.72,
      "duration_seconds": 4.49,
      "text": "Doctor, our chart from the last visit lists it as 140 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.38,
      "end_seconds": 164.35,
      "duration_seconds": 2.97,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.09,
      "end_seconds": 172.13,
      "duration_seconds": 7.04,
      "text": "I don't think I have it with me. Ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.68,
      "end_seconds": 178.16,
      "duration_seconds": 4.48,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.9,
      "end_seconds": 180.94,
      "duration_seconds": 2.04,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 192.39,
      "duration_seconds": 3.59,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 202.22,
      "duration_seconds": 8.0,
      "text": "I have heart disease. Ah, I've had thin bones, yes. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.75,
      "end_seconds": 212.09,
      "duration_seconds": 8.34,
      "text": "Right, so thin bones and high blood pressure are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.69,
      "end_seconds": 230.19,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.0,
      "end_seconds": 234.83,
      "duration_seconds": 2.83,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.69,
      "end_seconds": 243.43,
      "duration_seconds": 2.74,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.52,
      "end_seconds": 256.27,
      "duration_seconds": 11.75,
      "text": "I gave up cigarettes last spring. I do a yoga class on Thursdays. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.31,
      "end_seconds": 275.71,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.35,
      "end_seconds": 279.27,
      "duration_seconds": 2.92,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.89,
      "end_seconds": 288.68,
      "duration_seconds": 8.79,
      "text": "Taking everything into account, this is probably recovering well after bypass surgery. Another possibility is a leg wound infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.66,
      "end_seconds": 291.02,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.71,
      "end_seconds": 300.55,
      "duration_seconds": 7.84,
      "text": "I can't promise yet, but most people with recovering well after bypass surgery do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 301.24,
      "end_seconds": 304.84,
      "duration_seconds": 3.6,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.78,
      "end_seconds": 317.69,
      "duration_seconds": 10.91,
      "text": "Okay, I'll take a look at that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.57,
      "end_seconds": 320.07,
      "duration_seconds": 1.5,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.94,
      "end_seconds": 329.73,
      "duration_seconds": 7.79,
      "text": "I don't need to add any tests or treatment at this point. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.41,
      "end_seconds": 333.36,
      "duration_seconds": 2.95,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}