{
  "schema_version": "1.0",
  "encounter_id": "03281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 4.44,
      "duration_seconds": 3.17,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 10.26,
      "duration_seconds": 4.65,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 16.53,
      "duration_seconds": 4.33,
      "text": "I wanted to get shaking chills looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.28,
      "end_seconds": 21.05,
      "duration_seconds": 3.77,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.66,
      "end_seconds": 25.21,
      "duration_seconds": 2.55,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.81,
      "end_seconds": 35.29,
      "duration_seconds": 9.48,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.08,
      "end_seconds": 40.55,
      "duration_seconds": 4.47,
      "text": "It's severe, honestly. I'd say on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.74,
      "end_seconds": 44.13,
      "duration_seconds": 2.39,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.03,
      "end_seconds": 50.84,
      "duration_seconds": 5.81,
      "text": "It usually comes with a high temperature. Oh, and a sore mouth."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.14,
      "end_seconds": 55.94,
      "duration_seconds": 3.8,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.56,
      "end_seconds": 62.91,
      "duration_seconds": 5.35,
      "text": "It's severe, honestly. The high temperature? That's been for two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.96,
      "end_seconds": 66.26,
      "duration_seconds": 2.3,
      "text": "Any cough, diarrhoea or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.16,
      "end_seconds": 71.11,
      "duration_seconds": 3.95,
      "text": "I haven't had cough, diarrhoea or rash, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.95,
      "end_seconds": 73.51,
      "duration_seconds": 1.56,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.1,
      "end_seconds": 79.07,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.25,
      "end_seconds": 83.68,
      "duration_seconds": 3.43,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.98,
      "end_seconds": 86.5,
      "duration_seconds": 1.52,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.65,
      "end_seconds": 105.36,
      "duration_seconds": 3.71,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.7,
      "end_seconds": 108.73,
      "duration_seconds": 2.03,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.32,
      "end_seconds": 119.67,
      "duration_seconds": 3.35,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.51,
      "end_seconds": 122.11,
      "duration_seconds": 1.6,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.38,
      "end_seconds": 128.23,
      "duration_seconds": 4.85,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.24,
      "end_seconds": 141.48,
      "duration_seconds": 11.24,
      "text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.6,
      "end_seconds": 152.72,
      "duration_seconds": 8.12,
      "text": "Do you react to any medicines or foods? Any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.46,
      "end_seconds": 156.6,
      "duration_seconds": 2.14,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.02,
      "end_seconds": 160.21,
      "duration_seconds": 2.19,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.29,
      "end_seconds": 164.53,
      "duration_seconds": 2.24,
      "text": "Chemotherapy last week, recent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.97,
      "end_seconds": 168.7,
      "duration_seconds": 2.73,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.27,
      "end_seconds": 184.53,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.81,
      "end_seconds": 208.33,
      "duration_seconds": 11.52,
      "text": "Okay: temp 36.9 degrees, BP is 101 over 63. And SpO2 96 percent on room air, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.18,
      "end_seconds": 212.54,
      "duration_seconds": 2.36,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.14,
      "end_seconds": 221.62,
      "duration_seconds": 4.48,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.89,
      "end_seconds": 226.73,
      "duration_seconds": 3.84,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.94,
      "end_seconds": 229.91,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.84,
      "end_seconds": 253.55,
      "duration_seconds": 7.71,
      "text": "You are hot, shaking and your blood pressure is low, and you had chemotherapy nine days ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.02,
      "end_seconds": 260.9,
      "duration_seconds": 1.88,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.68,
      "end_seconds": 278.04,
      "duration_seconds": 9.36,
      "text": "Right, here's what I'm thinking. It fits best with neutropenic sepsis. It could also be a chest infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.08,
      "end_seconds": 283.61,
      "duration_seconds": 4.53,
      "text": "Hmm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 296.87,
      "duration_seconds": 11.38,
      "text": "It's reasonable to be concerned, but right now neutropenic sepsis is my leading thought, not anything worse. I want urgent blood tests done, that's for neutropenic sepsis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.15,
      "end_seconds": 300.73,
      "duration_seconds": 2.58,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.71,
      "end_seconds": 315.15,
      "duration_seconds": 13.44,
      "text": "I'd like you to take piperacillin and tazobactam, 4.5 grams, now, single dose. That should help with neutropenic sepsis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.9,
      "end_seconds": 318.07,
      "duration_seconds": 1.17,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.0,
      "end_seconds": 330.46,
      "duration_seconds": 11.46,
      "text": "This is an emergency, antibiotics are being given within the hour. Let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.26,
      "end_seconds": 335.69,
      "duration_seconds": 3.43,
      "text": "I mean, alright, thanks, take care."
    }
  ]
}