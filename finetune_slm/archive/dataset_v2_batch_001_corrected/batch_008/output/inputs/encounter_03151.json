{
  "schema_version": "1.0",
  "encounter_id": "03151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 6.14,
      "duration_seconds": 4.93,
      "text": "Good evening, you know, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.66,
      "end_seconds": 12.17,
      "duration_seconds": 4.51,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.67,
      "end_seconds": 19.2,
      "duration_seconds": 5.53,
      "text": "I'm here because of a high sugar test in pregnancy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.75,
      "end_seconds": 22.64,
      "duration_seconds": 1.89,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.34,
      "end_seconds": 29.55,
      "duration_seconds": 5.21,
      "text": "I'd say two days. Actually, no, closer to five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.84,
      "end_seconds": 34.11,
      "duration_seconds": 4.27,
      "text": "Right, right. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.21,
      "end_seconds": 49.88,
      "duration_seconds": 14.67,
      "text": "Severe, I'd say. Erm, I've also had no symptoms, since last weekend. Actually, with no symptoms, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.51,
      "end_seconds": 56.26,
      "duration_seconds": 4.75,
      "text": "Right, any blurred vision, thirst or reduced baby movements at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.96,
      "end_seconds": 63.89,
      "duration_seconds": 2.93,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.71,
      "end_seconds": 67.68,
      "duration_seconds": 2.97,
      "text": "Nothing like passing a lot of urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.62,
      "end_seconds": 73.73,
      "duration_seconds": 4.11,
      "text": "No passing a lot of urine, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.43,
      "end_seconds": 79.04,
      "duration_seconds": 3.61,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.73,
      "end_seconds": 82.47,
      "duration_seconds": 1.74,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.5,
      "end_seconds": 89.01,
      "duration_seconds": 4.51,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.55,
      "end_seconds": 93.68,
      "duration_seconds": 3.13,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.61,
      "end_seconds": 96.4,
      "duration_seconds": 1.79,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.37,
      "end_seconds": 102.87,
      "duration_seconds": 4.5,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.49,
      "end_seconds": 105.75,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.15,
      "end_seconds": 114.72,
      "duration_seconds": 3.57,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.46,
      "end_seconds": 118.94,
      "duration_seconds": 2.48,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.91,
      "end_seconds": 131.63,
      "duration_seconds": 10.72,
      "text": "Just two stents put in my heart, three years ago. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.97,
      "end_seconds": 151.19,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.73,
      "end_seconds": 161.68,
      "duration_seconds": 9.95,
      "text": "Seretide inhaler, twice a day. I mean, it's aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.06,
      "end_seconds": 180.55,
      "duration_seconds": 5.49,
      "text": "Do you have any long-term conditions? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.25,
      "end_seconds": 184.27,
      "duration_seconds": 3.02,
      "text": "Asthma, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.64,
      "end_seconds": 186.56,
      "duration_seconds": 0.92,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.54,
      "end_seconds": 197.2,
      "duration_seconds": 8.66,
      "text": "Well, uh, I've had heart disease, yes. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.49,
      "end_seconds": 202.01,
      "duration_seconds": 3.52,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.5,
      "end_seconds": 209.51,
      "duration_seconds": 6.01,
      "text": "Plasters. I come out in... well, a red itchy rash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.11,
      "end_seconds": 213.96,
      "duration_seconds": 2.85,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.25,
      "end_seconds": 227.86,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.26,
      "end_seconds": 247.75,
      "duration_seconds": 6.49,
      "text": "Okay: respiratory rate 17, pressure 112 over 69, temperature 37.0, heart rate 70."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.75,
      "end_seconds": 252.29,
      "duration_seconds": 3.54,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.18,
      "end_seconds": 257.2,
      "duration_seconds": 3.02,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.27,
      "end_seconds": 260.97,
      "duration_seconds": 2.7,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.23,
      "end_seconds": 280.23,
      "duration_seconds": 5.0,
      "text": "Your blood pressure is normal and your urine has no sugar today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.39,
      "end_seconds": 282.98,
      "duration_seconds": 1.59,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.45,
      "end_seconds": 289.23,
      "duration_seconds": 1.78,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.29,
      "end_seconds": 316.05,
      "duration_seconds": 10.76,
      "text": "Having listened and examined, this looks most like gestational diabetes controllable with diet. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.6,
      "end_seconds": 319.13,
      "duration_seconds": 1.53,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.99,
      "end_seconds": 336.7,
      "duration_seconds": 15.71,
      "text": "Nothing I've seen today points to an emergency. It looks like gestational diabetes controllable with diet, but I'd like to confirm. I think a glucose meter and diary makes sense here, for gestational diabetes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.53,
      "end_seconds": 338.69,
      "duration_seconds": 1.16,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.84,
      "end_seconds": 362.97,
      "duration_seconds": 18.13,
      "text": "Let's get a growth scan, for gestational diabetes. Replace sugary drinks and white starches with wholegrains and walk after meals. We'll refer you to the diabetes midwife. I'll want another look in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.97,
      "end_seconds": 369.51,
      "duration_seconds": 4.54,
      "text": "Great, um, thank you for your help."
    }
  ]
}