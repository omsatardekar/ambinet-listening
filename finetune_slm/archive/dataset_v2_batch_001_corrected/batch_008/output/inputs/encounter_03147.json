{
  "schema_version": "1.0",
  "encounter_id": "03147",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 3.88,
      "duration_seconds": 3.21,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 10.15,
      "duration_seconds": 4.79,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 20.22,
      "duration_seconds": 9.46,
      "text": "Mainly hearing getting worse in both ears. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.92,
      "end_seconds": 23.75,
      "duration_seconds": 1.83,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.38,
      "end_seconds": 31.54,
      "duration_seconds": 6.16,
      "text": "Let me think it's been about a week I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.05,
      "end_seconds": 35.19,
      "duration_seconds": 3.14,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.14,
      "end_seconds": 45.43,
      "duration_seconds": 8.29,
      "text": "Mild, I'd say so, I've had hearing better in a noisy room too, for five days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.95,
      "end_seconds": 48.6,
      "duration_seconds": 2.65,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.07,
      "end_seconds": 51.79,
      "duration_seconds": 1.72,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.94,
      "end_seconds": 55.64,
      "duration_seconds": 2.7,
      "text": "has there been no dizziness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.69,
      "end_seconds": 59.48,
      "duration_seconds": 2.79,
      "text": "yeah. Ten days, I'd say"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.36,
      "end_seconds": 63.19,
      "duration_seconds": 2.83,
      "text": "has there been any ear pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.47,
      "end_seconds": 66.69,
      "duration_seconds": 2.22,
      "text": "Definitely no ear pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.38,
      "end_seconds": 70.79,
      "duration_seconds": 2.41,
      "text": "Any facial weakness or discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 74.39,
      "duration_seconds": 3.07,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.86,
      "end_seconds": 78.61,
      "duration_seconds": 2.75,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.36,
      "end_seconds": 83.43,
      "duration_seconds": 3.07,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.96,
      "end_seconds": 89.12,
      "duration_seconds": 4.16,
      "text": "alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.16,
      "end_seconds": 92.01,
      "duration_seconds": 1.85,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 95.73,
      "duration_seconds": 1.84,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.59,
      "end_seconds": 98.24,
      "duration_seconds": 1.65,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.74,
      "end_seconds": 100.64,
      "duration_seconds": 0.9,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.8,
      "end_seconds": 108.51,
      "duration_seconds": 4.71,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.46,
      "end_seconds": 112.08,
      "duration_seconds": 1.62,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.79,
      "end_seconds": 116.81,
      "duration_seconds": 4.02,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.32,
      "end_seconds": 121.37,
      "duration_seconds": 3.05,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.4,
      "end_seconds": 125.81,
      "duration_seconds": 3.41,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.65,
      "end_seconds": 131.36,
      "duration_seconds": 3.71,
      "text": "So are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.92,
      "end_seconds": 136.3,
      "duration_seconds": 3.38,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.63,
      "end_seconds": 157.93,
      "duration_seconds": 4.3,
      "text": "alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.12,
      "end_seconds": 163.87,
      "duration_seconds": 4.75,
      "text": "Um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.61,
      "end_seconds": 174.33,
      "duration_seconds": 4.72,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.88,
      "end_seconds": 185.44,
      "duration_seconds": 9.56,
      "text": "I take sitagliptin 100 milligrams once a day. I did try to ignore it for a while"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.98,
      "end_seconds": 188.32,
      "duration_seconds": 2.34,
      "text": "roughly how long on that one?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.95,
      "end_seconds": 200.53,
      "duration_seconds": 10.58,
      "text": "About three months now. Tiotropium inhaler. I take it it once a day. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.98,
      "end_seconds": 203.17,
      "duration_seconds": 1.19,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.33,
      "end_seconds": 205.47,
      "duration_seconds": 1.14,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.57,
      "end_seconds": 215.39,
      "duration_seconds": 4.82,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.64,
      "end_seconds": 220.25,
      "duration_seconds": 1.61,
      "text": "I have diabetes"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.1,
      "end_seconds": 221.85,
      "duration_seconds": 0.75,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.69,
      "end_seconds": 236.7,
      "duration_seconds": 13.01,
      "text": "I have COPD. My family kept telling me to get it checked. Work has been very busy so I kept ignoring it it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.8,
      "end_seconds": 241.75,
      "duration_seconds": 3.95,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.63,
      "end_seconds": 248.36,
      "duration_seconds": 2.73,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 259.28,
      "end_seconds": 266.47,
      "duration_seconds": 7.19,
      "text": "okay, so the vitals from earlier. Pulse 79, BP is 124 over 76, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.77,
      "end_seconds": 271.47,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.36,
      "end_seconds": 279.34,
      "duration_seconds": 5.98,
      "text": "alright I'll need to to examine you for this it won't take long"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.59,
      "end_seconds": 282.82,
      "duration_seconds": 2.23,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.95,
      "end_seconds": 307.22,
      "duration_seconds": 7.27,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.1,
      "end_seconds": 315.32,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.88,
      "end_seconds": 341.98,
      "duration_seconds": 19.1,
      "text": "Having listened and examined, I'd lean towards a conductive hearing loss, possibly otosclerosis. I'd also keep wax in mind. A hearing aid or an operation are both options after the tests. Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.04,
      "end_seconds": 345.44,
      "duration_seconds": 2.4,
      "text": "thank you, doctor, goodbye"
    }
  ]
}