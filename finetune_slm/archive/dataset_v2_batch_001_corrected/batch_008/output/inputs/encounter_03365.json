{
  "schema_version": "1.0",
  "encounter_id": "03365",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 6.63,
      "duration_seconds": 5.36,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.26,
      "end_seconds": 10.92,
      "duration_seconds": 3.66,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.59,
      "end_seconds": 18.36,
      "duration_seconds": 3.77,
      "text": "I wanted to get shaking looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.59,
      "end_seconds": 22.91,
      "duration_seconds": 3.32,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.98,
      "end_seconds": 33.4,
      "duration_seconds": 8.42,
      "text": "It's been five days, I'm fairly sure. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.87,
      "end_seconds": 38.1,
      "duration_seconds": 4.23,
      "text": "Yes, carry on. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.08,
      "end_seconds": 47.55,
      "duration_seconds": 7.47,
      "text": "Pretty moderate, if I'm being honest. I'd been sweating, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.15,
      "end_seconds": 56.54,
      "duration_seconds": 5.39,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.51,
      "end_seconds": 79.6,
      "duration_seconds": 22.09,
      "text": "Foracort inhaler, twice a day. I took the morning off to come in today. Work has been very busy so I kept ignoring it. Hydrocortisone cream. I take it when needed. Heavy drinking until two days ago, stopped two days ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.75,
      "end_seconds": 84.77,
      "duration_seconds": 4.02,
      "text": "Okay, since when have you been taking it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.4,
      "end_seconds": 87.22,
      "duration_seconds": 1.82,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.72,
      "end_seconds": 89.9,
      "duration_seconds": 2.18,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.71,
      "end_seconds": 95.94,
      "duration_seconds": 4.23,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.95,
      "end_seconds": 100.47,
      "duration_seconds": 2.52,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 104.84,
      "duration_seconds": 2.96,
      "text": "Yes, wheat. I get itchy skin."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.17,
      "end_seconds": 117.52,
      "duration_seconds": 4.35,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.03,
      "end_seconds": 121.56,
      "duration_seconds": 2.53,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.3,
      "end_seconds": 124.98,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.27,
      "end_seconds": 140.11,
      "duration_seconds": 10.84,
      "text": "I've had asthma for nearly five years now. I have eczema. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.06,
      "end_seconds": 153.41,
      "duration_seconds": 12.35,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.89,
      "end_seconds": 170.39,
      "duration_seconds": 15.5,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. Not much, I mostly stay in these days. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.7,
      "end_seconds": 183.41,
      "duration_seconds": 4.71,
      "text": "Have you had any seeing things, vomiting blood, seizure or confusion?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.1,
      "end_seconds": 190.3,
      "duration_seconds": 6.2,
      "text": "I haven't had seeing things, vomiting blood, seizure or confusion, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.18,
      "end_seconds": 193.58,
      "duration_seconds": 2.4,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.78,
      "end_seconds": 196.34,
      "duration_seconds": 1.56,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.9,
      "end_seconds": 199.78,
      "duration_seconds": 2.88,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.34,
      "end_seconds": 201.36,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.33,
      "end_seconds": 207.08,
      "duration_seconds": 2.75,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.24,
      "end_seconds": 221.34,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.53,
      "end_seconds": 249.18,
      "duration_seconds": 7.65,
      "text": "Okay: BP is 115 over 71, respiratory rate 16. And heart rate 106, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.15,
      "end_seconds": 252.69,
      "duration_seconds": 2.54,
      "text": "Actually, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.25,
      "end_seconds": 271.59,
      "duration_seconds": 15.34,
      "text": "So, that's fine, I'll explain it soon. From what you've told me, the most likely explanation is alcohol withdrawal. It could also be an anxiety state, so we'll keep that open."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.22,
      "end_seconds": 275.34,
      "duration_seconds": 3.12,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.24,
      "end_seconds": 284.07,
      "duration_seconds": 7.83,
      "text": "Nothing I've seen today points to an emergency. It looks like alcohol withdrawal, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 311.24,
      "duration_seconds": 11.95,
      "text": "I'm going to order blood tests, for alcohol withdrawal. I'm prescribing thiamine, 100 milligrams, three times a day, long term. You take it by mouth. It's for alcohol-related deficiency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.92,
      "end_seconds": 314.6,
      "duration_seconds": 1.68,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.26,
      "end_seconds": 348.96,
      "duration_seconds": 32.7,
      "text": "I'm prescribing chlordiazepoxide, 20 milligrams, four times a day, reducing over five days. You take it by mouth. That's for alcohol withdrawal. Do not stop alcohol suddenly without medical support. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. If the symptoms get worse, or you feel really unwell, please come to the emergency department. We'll catch up in two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.1,
      "end_seconds": 354.66,
      "duration_seconds": 4.56,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.33,
      "end_seconds": 357.26,
      "duration_seconds": 1.93,
      "text": "Have a good day."
    }
  ]
}