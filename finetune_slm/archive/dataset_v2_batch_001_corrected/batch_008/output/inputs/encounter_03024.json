{
  "schema_version": "1.0",
  "encounter_id": "03024",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.68,
      "duration_seconds": 4.56,
      "text": "morning, um, doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 11.02,
      "duration_seconds": 4.64,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.66,
      "end_seconds": 17.0,
      "duration_seconds": 5.34,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.41,
      "end_seconds": 28.33,
      "duration_seconds": 9.92,
      "text": "Mainly ringing in the ears. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.89,
      "end_seconds": 32.68,
      "duration_seconds": 2.79,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.95,
      "end_seconds": 40.49,
      "duration_seconds": 3.54,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.46,
      "end_seconds": 48.76,
      "duration_seconds": 7.3,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.86,
      "end_seconds": 54.8,
      "duration_seconds": 5.94,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.63,
      "end_seconds": 59.24,
      "duration_seconds": 2.61,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.88,
      "end_seconds": 69.1,
      "duration_seconds": 4.22,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.88,
      "end_seconds": 79.55,
      "duration_seconds": 9.67,
      "text": "Um, and and there's hearing getting worse in both ears as well, five days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.21,
      "end_seconds": 83.66,
      "duration_seconds": 3.45,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.37,
      "end_seconds": 85.56,
      "duration_seconds": 1.19,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.34,
      "end_seconds": 90.07,
      "duration_seconds": 2.73,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.72,
      "end_seconds": 101.83,
      "duration_seconds": 2.11,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.16,
      "end_seconds": 127.02,
      "duration_seconds": 6.86,
      "text": "Okay: temperature 36.5, pulse 86, BP is 111 over 73. And And respiratory rate 14."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.77,
      "end_seconds": 132.7,
      "duration_seconds": 3.93,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.98,
      "end_seconds": 135.69,
      "duration_seconds": 1.71,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.86,
      "end_seconds": 139.63,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.9,
      "end_seconds": 153.83,
      "duration_seconds": 5.93,
      "text": "Both ear drums look normal and the tuning fork is heard better through the bone."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.42,
      "end_seconds": 163.48,
      "duration_seconds": 6.06,
      "text": "that's all I needed to check did you get ear pain, facial weakness or discharge?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 181.63,
      "duration_seconds": 17.59,
      "text": "Sorry, you know, what was I saying, no, no ear pain, no facial weakness, no discharge. I did have no dizziness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.01,
      "end_seconds": 185.77,
      "duration_seconds": 3.76,
      "text": "Hm, okay. And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.09,
      "end_seconds": 193.76,
      "duration_seconds": 2.67,
      "text": "Oh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.43,
      "end_seconds": 196.55,
      "duration_seconds": 2.12,
      "text": "so, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.9,
      "end_seconds": 200.65,
      "duration_seconds": 2.75,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.26,
      "end_seconds": 205.1,
      "duration_seconds": 2.84,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.75,
      "end_seconds": 213.41,
      "duration_seconds": 6.66,
      "text": "ah, um, yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.59,
      "end_seconds": 225.99,
      "duration_seconds": 8.4,
      "text": "Anything in your past medical history I should know? It helps to to be thorough at this stage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.47,
      "end_seconds": 231.65,
      "duration_seconds": 4.18,
      "text": "I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.33,
      "end_seconds": 233.03,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.84,
      "end_seconds": 236.69,
      "duration_seconds": 1.85,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.61,
      "end_seconds": 239.42,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.46,
      "end_seconds": 244.16,
      "duration_seconds": 3.7,
      "text": "I've had an irregular heartbeat, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.73,
      "end_seconds": 254.9,
      "duration_seconds": 10.17,
      "text": "okay, I can see high cholesterol in your file as well what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.38,
      "end_seconds": 260.07,
      "duration_seconds": 3.69,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.04,
      "end_seconds": 263.71,
      "duration_seconds": 1.67,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.83,
      "end_seconds": 268.87,
      "duration_seconds": 4.04,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.59,
      "end_seconds": 272.43,
      "duration_seconds": 2.84,
      "text": "Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.88,
      "end_seconds": 277.62,
      "duration_seconds": 3.74,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.8,
      "end_seconds": 291.25,
      "duration_seconds": 2.45,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.07,
      "end_seconds": 297.19,
      "duration_seconds": 5.12,
      "text": "I take atorvastatin, 20 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 299.08,
      "end_seconds": 310.67,
      "duration_seconds": 11.59,
      "text": "yeah, doctor, I think the last prescription for the atorvastatin was 40 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.68,
      "end_seconds": 316.52,
      "duration_seconds": 4.84,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.38,
      "end_seconds": 321.82,
      "duration_seconds": 4.44,
      "text": "No, um, I left it at home."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.88,
      "end_seconds": 332.12,
      "duration_seconds": 9.24,
      "text": "Ah, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.71,
      "end_seconds": 335.36,
      "duration_seconds": 2.65,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.49,
      "end_seconds": 353.57,
      "duration_seconds": 17.08,
      "text": "let me think, you know, for my sugar, I believe my wife sets them out for me, I just take what I'm given. Metoprolol, 50 milligrams, maybe, twice a day"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.67,
      "end_seconds": 358.62,
      "duration_seconds": 3.95,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.27,
      "end_seconds": 362.51,
      "duration_seconds": 2.24,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.6,
      "end_seconds": 367.32,
      "duration_seconds": 2.72,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.73,
      "end_seconds": 381.76,
      "duration_seconds": 13.03,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.67,
      "end_seconds": 404.0,
      "duration_seconds": 7.33,
      "text": "Having listened and examined, this is probably a conductive hearing loss, possibly otosclerosis. Another possibility is wax."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.06,
      "end_seconds": 410.31,
      "duration_seconds": 5.25,
      "text": "Right, uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.04,
      "end_seconds": 436.21,
      "duration_seconds": 25.17,
      "text": "I understand the worry. At the moment I'd say it's a conductive hearing loss, possibly otosclerosis, and we'll know more once the a CT scan of the ears is back. I want a CT scan of the ears done, that's for possible otosclerosis. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 437.27,
      "end_seconds": 441.49,
      "duration_seconds": 4.22,
      "text": "We have a slot Monday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.3,
      "end_seconds": 445.33,
      "duration_seconds": 3.03,
      "text": "Monday, that works for me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.15,
      "end_seconds": 451.55,
      "duration_seconds": 4.4,
      "text": "I think a hearing test makes sense here, for hearing loss."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.76,
      "end_seconds": 455.15,
      "duration_seconds": 2.39,
      "text": "is that done today?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.94,
      "end_seconds": 477.99,
      "duration_seconds": 22.05,
      "text": "a hearing aid or an operation are both options after the tests please take the tablets with food so they don't upset your stomach the ENT clinic would be the right next step, I'll refer you and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 481.34,
      "end_seconds": 483.85,
      "duration_seconds": 2.51,
      "text": "I, I'll remember that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 485.91,
      "end_seconds": 488.25,
      "duration_seconds": 2.34,
      "text": "Book a review after the tests."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 489.38,
      "end_seconds": 490.08,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 490.91,
      "end_seconds": 494.74,
      "duration_seconds": 3.83,
      "text": "So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 496.35,
      "end_seconds": 498.7,
      "duration_seconds": 2.35,
      "text": "thank you, doctor, goodbye"
    }
  ]
}