{
  "schema_version": "1.0",
  "encounter_id": "03185",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.04,
      "duration_seconds": 4.89,
      "text": "ah, um, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 11.79,
      "duration_seconds": 4.45,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.69,
      "end_seconds": 17.1,
      "duration_seconds": 3.41,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.92,
      "end_seconds": 22.9,
      "duration_seconds": 3.98,
      "text": "that's fine, sit down we'll go through it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.98,
      "end_seconds": 30.43,
      "duration_seconds": 5.45,
      "text": "Erm, I've been dealing with being found cold and drowsy."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.09,
      "end_seconds": 34.07,
      "duration_seconds": 1.98,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.64,
      "end_seconds": 39.58,
      "duration_seconds": 3.94,
      "text": "It's been like this since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.05,
      "end_seconds": 44.38,
      "duration_seconds": 3.33,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.44,
      "end_seconds": 59.14,
      "duration_seconds": 13.7,
      "text": "I'd say moderate. I've had confusion too, uh, for four weeks. So, with confusion, mild, I'd say. I've also had slurred speech, for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.94,
      "end_seconds": 62.95,
      "duration_seconds": 3.01,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.86,
      "end_seconds": 66.35,
      "duration_seconds": 1.49,
      "text": "I'd say mild"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.12,
      "end_seconds": 75.46,
      "duration_seconds": 7.34,
      "text": "Have you had being found cold and drowsy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 85.06,
      "duration_seconds": 8.34,
      "text": "yes, um, something like this happened last year, and it went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.14,
      "end_seconds": 91.09,
      "duration_seconds": 3.95,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.53,
      "end_seconds": 103.46,
      "duration_seconds": 10.93,
      "text": "I have anxiety, for five years. I've got acid reflux. Work has been very busy so so I kept ignoring it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.26,
      "end_seconds": 112.49,
      "duration_seconds": 7.23,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.44,
      "end_seconds": 128.17,
      "duration_seconds": 5.73,
      "text": "So, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.61,
      "end_seconds": 138.83,
      "duration_seconds": 9.22,
      "text": "I'm allergic to tramadol, I get feeling very drowsy. I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.47,
      "end_seconds": 154.4,
      "duration_seconds": 4.93,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.49,
      "end_seconds": 162.4,
      "duration_seconds": 5.91,
      "text": "My grandmother had dementia. Mm, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.59,
      "end_seconds": 165.93,
      "duration_seconds": 2.34,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.82,
      "end_seconds": 174.75,
      "duration_seconds": 6.93,
      "text": "uh, just my appendix taken out, when I was in my twenties"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.99,
      "end_seconds": 185.99,
      "duration_seconds": 2.0,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.13,
      "end_seconds": 190.48,
      "duration_seconds": 3.35,
      "text": "Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.08,
      "end_seconds": 201.42,
      "duration_seconds": 9.34,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.41,
      "end_seconds": 206.48,
      "duration_seconds": 4.07,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.66,
      "end_seconds": 220.65,
      "duration_seconds": 8.99,
      "text": "Not with me. I'll bring it next time. I'm, I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.23,
      "end_seconds": 225.18,
      "duration_seconds": 2.95,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.03,
      "end_seconds": 228.75,
      "duration_seconds": 1.72,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.62,
      "end_seconds": 231.58,
      "duration_seconds": 0.96,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.04,
      "end_seconds": 237.03,
      "duration_seconds": 3.99,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.24,
      "end_seconds": 239.48,
      "duration_seconds": 1.24,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.89,
      "end_seconds": 244.54,
      "duration_seconds": 1.65,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.28,
      "end_seconds": 248.1,
      "duration_seconds": 2.82,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.8,
      "end_seconds": 252.47,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.49,
      "end_seconds": 255.12,
      "duration_seconds": 1.63,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.24,
      "end_seconds": 259.95,
      "duration_seconds": 3.71,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.16,
      "end_seconds": 264.29,
      "duration_seconds": 3.13,
      "text": "Have you had any fall or head injury?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.83,
      "end_seconds": 271.53,
      "duration_seconds": 6.7,
      "text": "let me think, you know, I haven't had fall or head injury, no"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.22,
      "end_seconds": 274.17,
      "duration_seconds": 1.95,
      "text": "Has there been any alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.26,
      "end_seconds": 277.87,
      "duration_seconds": 1.61,
      "text": "Definitely no alcohol."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.75,
      "end_seconds": 282.66,
      "duration_seconds": 2.91,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.64,
      "end_seconds": 286.76,
      "duration_seconds": 3.12,
      "text": "Um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.67,
      "end_seconds": 290.5,
      "duration_seconds": 2.83,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.56,
      "end_seconds": 306.03,
      "duration_seconds": 2.47,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.4,
      "end_seconds": 324.66,
      "duration_seconds": 7.26,
      "text": "Okay: oxygen saturation is 99 percent, pressure 121 over 74, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.73,
      "end_seconds": 328.35,
      "duration_seconds": 2.62,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.81,
      "end_seconds": 330.51,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.48,
      "end_seconds": 334.73,
      "duration_seconds": 2.25,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.62,
      "end_seconds": 355.55,
      "duration_seconds": 6.93,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.93,
      "end_seconds": 367.28,
      "duration_seconds": 9.35,
      "text": "please sit back down having listened and and examined, I'd lean towards severe hypothermia an overdose is also on my list"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.01,
      "end_seconds": 373.11,
      "duration_seconds": 4.1,
      "text": "well, is there something to worry about?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.09,
      "end_seconds": 390.13,
      "duration_seconds": 15.04,
      "text": "I understand the worry. At the moment I'd say it's severe hypothermia, and we'll know more once the blood tests is back. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.26,
      "end_seconds": 401.29,
      "duration_seconds": 10.03,
      "text": "I had blood tests done at another clinic a few months ago. I don't have the report with me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.09,
      "end_seconds": 405.82,
      "duration_seconds": 2.73,
      "text": "We should do an ECG for bradycardia."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.26,
      "end_seconds": 411.02,
      "duration_seconds": 3.76,
      "text": "Okay, so that's fine with me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.42,
      "end_seconds": 420.54,
      "duration_seconds": 8.12,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.45,
      "end_seconds": 430.21,
      "duration_seconds": 7.76,
      "text": "um, uh, could I get a blood sugar done? A friend had it"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.18,
      "end_seconds": 439.81,
      "duration_seconds": 7.63,
      "text": "so, I wouldn't order it today if anything changes, we'll reconsider i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 441.42,
      "end_seconds": 445.09,
      "duration_seconds": 3.67,
      "text": "Um, thank you, doctor, goodbye."
    }
  ]
}