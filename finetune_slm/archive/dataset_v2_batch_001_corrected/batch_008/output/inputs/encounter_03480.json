{
  "schema_version": "1.0",
  "encounter_id": "03480",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.58,
      "duration_seconds": 4.7,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.08,
      "duration_seconds": 3.61,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.62,
      "end_seconds": 22.53,
      "duration_seconds": 10.91,
      "text": "I've been dealing with shortness of breath. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.59,
      "end_seconds": 27.47,
      "duration_seconds": 2.88,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 32.58,
      "duration_seconds": 3.72,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.96,
      "end_seconds": 37.58,
      "duration_seconds": 1.62,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.3,
      "end_seconds": 41.86,
      "duration_seconds": 3.56,
      "text": "I notice it more with lying flat."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 45.77,
      "duration_seconds": 3.65,
      "text": "I see, go ahead. Does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.8,
      "end_seconds": 62.73,
      "duration_seconds": 14.93,
      "text": "Only sitting forward, and it's not much. I've been feeling faint too, for about two weeks. With feeling faint, it feels moderate to me. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.59,
      "end_seconds": 78.56,
      "duration_seconds": 1.97,
      "text": "Any sign of cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.39,
      "end_seconds": 80.91,
      "duration_seconds": 1.52,
      "text": "No cough, thankfully."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.66,
      "end_seconds": 88.93,
      "duration_seconds": 3.27,
      "text": "And what about leg swelling or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.04,
      "end_seconds": 94.98,
      "duration_seconds": 2.94,
      "text": "No, no leg swelling or fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.43,
      "end_seconds": 100.18,
      "duration_seconds": 3.75,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.7,
      "end_seconds": 103.34,
      "duration_seconds": 2.64,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.12,
      "end_seconds": 107.93,
      "duration_seconds": 2.81,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.03,
      "end_seconds": 114.18,
      "duration_seconds": 4.15,
      "text": "I've had acid reflux for nearly five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 121.94,
      "duration_seconds": 5.98,
      "text": "Alright, yes, acid reflux is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 140.85,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 143.44,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.87,
      "end_seconds": 148.2,
      "duration_seconds": 3.33,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.17,
      "end_seconds": 153.82,
      "duration_seconds": 3.65,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.72,
      "end_seconds": 157.18,
      "duration_seconds": 2.46,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.22,
      "end_seconds": 161.72,
      "duration_seconds": 2.5,
      "text": "Nothing regular, uh, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 165.89,
      "duration_seconds": 2.9,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.57,
      "end_seconds": 178.69,
      "duration_seconds": 11.12,
      "text": "I drink a lot of tea and snack through the day. I work in accounts at a hospital. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.9,
      "end_seconds": 199.25,
      "duration_seconds": 2.35,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.86,
      "end_seconds": 212.38,
      "duration_seconds": 2.52,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.36,
      "end_seconds": 233.44,
      "duration_seconds": 7.08,
      "text": "Okay: BP is 98 over 56, saturation 98 percent, respiratory rate 16, pulse 104."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.53,
      "end_seconds": 239.0,
      "duration_seconds": 4.47,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.02,
      "end_seconds": 241.49,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.8,
      "end_seconds": 245.37,
      "duration_seconds": 2.57,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.04,
      "end_seconds": 265.95,
      "duration_seconds": 6.91,
      "text": "Your neck veins are swollen, the heart sounds are muffled and your blood pressure is low."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.53,
      "end_seconds": 279.55,
      "duration_seconds": 10.02,
      "text": "Right, thank you, you can get dressed. So, to recap quickly. You've had shortness of breath, yesterday, and no cough or leg swelling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.9,
      "end_seconds": 284.38,
      "duration_seconds": 1.48,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.62,
      "end_seconds": 309.47,
      "duration_seconds": 23.85,
      "text": "Let's get an urgent echocardiogram, for possible tamponade. I want an ECG done, that's for chest pain. You need an urgent heart scan and possibly a drain. Do get help quickly if the symptoms get worse. Let's review you straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.33,
      "end_seconds": 314.69,
      "duration_seconds": 3.36,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}