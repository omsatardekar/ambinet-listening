{
  "schema_version": "1.0",
  "encounter_id": "03353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 4.98,
      "duration_seconds": 4.01,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.0,
      "end_seconds": 9.93,
      "duration_seconds": 3.93,
      "text": "Um, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.83,
      "end_seconds": 13.54,
      "duration_seconds": 2.71,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 24.61,
      "duration_seconds": 10.24,
      "text": "I mean, it's shaking chills. I thought I'd wait, but it hasn't gone. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.24,
      "end_seconds": 27.92,
      "duration_seconds": 2.68,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.27,
      "end_seconds": 39.37,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.99,
      "end_seconds": 69.37,
      "duration_seconds": 8.38,
      "text": "Okay: pulse 105, BP is 102 over 59, saturation 97 percent, respiratory rate 16, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.2,
      "end_seconds": 72.66,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.27,
      "end_seconds": 79.44,
      "duration_seconds": 6.17,
      "text": "That's fine, I'll explain it soon. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.92,
      "end_seconds": 83.22,
      "duration_seconds": 2.3,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.74,
      "end_seconds": 87.0,
      "duration_seconds": 3.26,
      "text": "Alright, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.63,
      "end_seconds": 90.63,
      "duration_seconds": 3.0,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.75,
      "end_seconds": 94.13,
      "duration_seconds": 2.38,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.98,
      "end_seconds": 104.83,
      "duration_seconds": 9.85,
      "text": "A high temperature goes along with it, most of the time. Uh, the high temperature? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.1,
      "end_seconds": 125.13,
      "duration_seconds": 3.03,
      "text": "Any diarrhoea, rash or cough at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.5,
      "end_seconds": 136.2,
      "duration_seconds": 5.7,
      "text": "Ah, you know, I haven't had diarrhoea, rash or cough, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.69,
      "end_seconds": 140.9,
      "duration_seconds": 3.21,
      "text": "So, how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.98,
      "end_seconds": 146.5,
      "duration_seconds": 3.52,
      "text": "Right, no, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 153.54,
      "duration_seconds": 4.96,
      "text": "Okay, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.57,
      "end_seconds": 156.88,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.65,
      "end_seconds": 177.28,
      "duration_seconds": 2.63,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.19,
      "end_seconds": 180.71,
      "duration_seconds": 2.52,
      "text": "Heart failure, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.57,
      "end_seconds": 187.52,
      "duration_seconds": 4.95,
      "text": "Yes, heart failure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.75,
      "end_seconds": 204.04,
      "duration_seconds": 3.29,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.31,
      "end_seconds": 209.87,
      "duration_seconds": 4.56,
      "text": "I take furosemide, every morning for the fluid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.67,
      "end_seconds": 212.73,
      "duration_seconds": 2.06,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.49,
      "end_seconds": 218.61,
      "duration_seconds": 5.12,
      "text": "40 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.17,
      "end_seconds": 221.92,
      "duration_seconds": 2.75,
      "text": "Sure. Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.63,
      "end_seconds": 229.18,
      "duration_seconds": 5.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.13,
      "end_seconds": 237.19,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.03,
      "end_seconds": 242.5,
      "duration_seconds": 4.47,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.93,
      "end_seconds": 245.21,
      "duration_seconds": 1.28,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.81,
      "end_seconds": 251.44,
      "duration_seconds": 4.63,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.34,
      "end_seconds": 258.48,
      "duration_seconds": 4.14,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.16,
      "end_seconds": 260.1,
      "duration_seconds": 0.94,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.49,
      "end_seconds": 263.05,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.27,
      "end_seconds": 282.46,
      "duration_seconds": 7.19,
      "text": "You are hot, shaking and your blood pressure is low, and you had chemotherapy nine days ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.61,
      "end_seconds": 294.0,
      "duration_seconds": 7.39,
      "text": "You can sit up now. So where does that leave us? This is probably neutropenic sepsis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.69,
      "end_seconds": 312.94,
      "duration_seconds": 4.25,
      "text": "I'm going to order urgent blood tests, for neutropenic sepsis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.02,
      "end_seconds": 316.36,
      "duration_seconds": 2.34,
      "text": "The earliest is Tuesday, 10 am."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.01,
      "end_seconds": 333.83,
      "duration_seconds": 12.82,
      "text": "You'll be taking piperacillin and tazobactam, 4.5 grams, now, single dose. That's for neutropenic sepsis. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.64,
      "end_seconds": 339.35,
      "duration_seconds": 3.71,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.51,
      "end_seconds": 355.76,
      "duration_seconds": 15.25,
      "text": "This is an emergency, antibiotics are being given within the hour. I think the oncology team should see you too. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.64,
      "end_seconds": 359.73,
      "duration_seconds": 1.09,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.43,
      "end_seconds": 372.03,
      "duration_seconds": 6.6,
      "text": "I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.7,
      "end_seconds": 375.7,
      "duration_seconds": 3.0,
      "text": "So, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.66,
      "end_seconds": 377.83,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}