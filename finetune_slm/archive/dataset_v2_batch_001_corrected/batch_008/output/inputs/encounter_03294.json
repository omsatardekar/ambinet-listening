  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.84,
      "duration_seconds": 3.08,
      "text": "Good morning, grab a a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.81,
      "end_seconds": 9.95,
      "duration_seconds": 1.14,
      "text": "evening, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.23,
      "end_seconds": 14.61,
      "duration_seconds": 1.38,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.39,
      "end_seconds": 18.34,
      "duration_seconds": 1.95,
      "text": "It's a limp, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 23.18,
      "duration_seconds": 2.88,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.75,
      "end_seconds": 27.78,
      "duration_seconds": 4.03,
      "text": "Oh, I've had it for about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.66,
      "end_seconds": 31.08,
      "duration_seconds": 2.42,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.82,
      "end_seconds": 36.63,
      "duration_seconds": 3.81,
      "text": "Only a stick, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.45,
      "end_seconds": 55.43,
      "duration_seconds": 3.98,
      "text": "have you had any fever, weight loss or fall?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.1,
      "end_seconds": 60.6,
      "duration_seconds": 3.5,
      "text": "No, no fever, weight loss or fall."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.73,
      "end_seconds": 65.39,
      "duration_seconds": 1.66,
      "text": "Any sign of numbness?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.3,
      "end_seconds": 69.54,
      "duration_seconds": 3.24,
      "text": "No, I haven't had any numbness."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.09,
      "end_seconds": 73.93,
      "duration_seconds": 2.84,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.8,
      "end_seconds": 79.05,
      "duration_seconds": 3.25,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.95,
      "end_seconds": 86.25,
      "duration_seconds": 3.3,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.34,
      "end_seconds": 91.52,
      "duration_seconds": 4.18,
      "text": "I take paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.41,
      "end_seconds": 109.06,
      "duration_seconds": 3.65,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.5,
      "end_seconds": 115.98,
      "duration_seconds": 5.48,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.96,
      "end_seconds": 119.05,
      "duration_seconds": 2.09,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.18,
      "end_seconds": 124.49,
      "duration_seconds": 4.31,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.37,
      "end_seconds": 129.22,
      "duration_seconds": 2.85,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.92,
      "end_seconds": 136.19,
      "duration_seconds": 3.27,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 140.0,
      "duration_seconds": 2.61,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.62,
      "end_seconds": 145.55,
      "duration_seconds": 3.93,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.31,
      "end_seconds": 148.73,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.27,
      "end_seconds": 150.93,
      "duration_seconds": 1.66,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.89,
      "end_seconds": 156.53,
      "duration_seconds": 4.64,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.75,
      "end_seconds": 161.4,
      "duration_seconds": 3.65,
      "text": "Arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.38,
      "end_seconds": 167.97,
      "duration_seconds": 4.59,
      "text": "Mm-hmm. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 182.9,
      "duration_seconds": 2.11,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.92,
      "end_seconds": 211.38,
      "duration_seconds": 7.46,
      "text": "Okay: SpO2 99 percent on room air, BP is 126 over 81, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.09,
      "end_seconds": 214.59,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.57,
      "end_seconds": 218.49,
      "duration_seconds": 2.92,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.94,
      "end_seconds": 223.64,
      "duration_seconds": 3.7,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.58,
      "end_seconds": 240.0,
      "duration_seconds": 1.42,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.83,
      "end_seconds": 243.51,
      "duration_seconds": 1.68,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.01,
      "end_seconds": 264.2,
      "duration_seconds": 7.19,
      "text": "Hip rotation is painful and limited and you have a limp favouring the right side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.14,
      "end_seconds": 269.15,
      "duration_seconds": 2.01,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.59,
      "end_seconds": 303.63,
      "duration_seconds": 26.04,
      "text": "let me tell you where I've got to. This looks most like hip osteoarthritis. What I'm giving you is naproxen, 250 milligrams, twice a day with food, two weeks. You take it by mouth. That should help with hip pain. Let's review you in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.14,
      "end_seconds": 308.66,
      "duration_seconds": 3.52,
      "text": "right, I'll do that. Thank you, doctor"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 311.4,
      "duration_seconds": 1.37,
      "text": "all the best"
    }
  ]
}