{
  "schema_version": "1.0",
  "encounter_id": "03347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 2.87,
      "duration_seconds": 1.75,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.78,
      "end_seconds": 4.93,
      "duration_seconds": 1.15,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.5,
      "end_seconds": 7.84,
      "duration_seconds": 2.34,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.89,
      "end_seconds": 19.74,
      "duration_seconds": 10.85,
      "text": "I mean, so the thing is, I've got three early losses. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 24.78,
      "duration_seconds": 3.13,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.38,
      "end_seconds": 38.99,
      "duration_seconds": 13.61,
      "text": "I've had it for about two weeks. I looked a few things up online, and that probably didn't help. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.18,
      "end_seconds": 44.05,
      "duration_seconds": 3.87,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.57,
      "end_seconds": 47.89,
      "duration_seconds": 2.32,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.82,
      "end_seconds": 66.96,
      "duration_seconds": 4.14,
      "text": "And what about clotting problem, fever or heavy bleeding now?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.0,
      "end_seconds": 73.18,
      "duration_seconds": 5.18,
      "text": "I haven't had clotting problem, fever or heavy bleeding now, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.37,
      "end_seconds": 78.88,
      "duration_seconds": 4.51,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.87,
      "end_seconds": 83.35,
      "duration_seconds": 2.48,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.91,
      "end_seconds": 87.34,
      "duration_seconds": 2.43,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.3,
      "end_seconds": 89.4,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.74,
      "end_seconds": 92.79,
      "duration_seconds": 2.05,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.63,
      "end_seconds": 99.86,
      "duration_seconds": 1.23,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.47,
      "end_seconds": 102.92,
      "duration_seconds": 2.45,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.33,
      "end_seconds": 116.57,
      "duration_seconds": 12.24,
      "text": "No, I share a house with my brother. I do a yoga class on Thursdays. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.99,
      "end_seconds": 126.07,
      "duration_seconds": 2.08,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.62,
      "end_seconds": 131.84,
      "duration_seconds": 4.22,
      "text": "Amlodipine. I take it 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.05,
      "end_seconds": 137.08,
      "duration_seconds": 4.03,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.83,
      "end_seconds": 141.38,
      "duration_seconds": 2.55,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 151.15,
      "duration_seconds": 7.68,
      "text": "Okay, I can see high blood pressure in your file as well. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.33,
      "end_seconds": 156.75,
      "duration_seconds": 4.42,
      "text": "Trimethoprim. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.58,
      "end_seconds": 159.68,
      "duration_seconds": 2.1,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.01,
      "end_seconds": 172.42,
      "duration_seconds": 2.41,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.2,
      "end_seconds": 199.35,
      "duration_seconds": 8.15,
      "text": "Okay: temp 36.9 degrees, saturation 99 percent. And pulse 67, pressure 121 over 70, respiratory rate 18."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.51,
      "end_seconds": 204.29,
      "duration_seconds": 3.78,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.25,
      "end_seconds": 209.08,
      "duration_seconds": 2.83,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.14,
      "end_seconds": 220.84,
      "duration_seconds": 1.7,
      "text": "Your examination is normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.36,
      "end_seconds": 225.76,
      "duration_seconds": 2.4,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.81,
      "end_seconds": 248.7,
      "duration_seconds": 4.89,
      "text": "Putting it all together, it fits best with recurrent miscarriage needing investigation."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.06,
      "end_seconds": 252.02,
      "duration_seconds": 1.96,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.79,
      "end_seconds": 267.89,
      "duration_seconds": 14.1,
      "text": "I understand the worry. At the moment I'd say it's recurrent miscarriage needing investigation, and we'll know more once the a pelvic ultrasound is back. I want a pelvic ultrasound done, that's for recurrent miscarriage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.73,
      "end_seconds": 270.89,
      "duration_seconds": 1.16,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 295.16,
      "duration_seconds": 23.02,
      "text": "We will arrange specialist care so the next pregnancy is looked after from the start. Let's get you seen by the recurrent miscarriage clinic, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.9,
      "end_seconds": 300.31,
      "duration_seconds": 3.41,
      "text": "I think I understand everything. Thanks."
    }
  ]
}