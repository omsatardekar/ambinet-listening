{
  "schema_version": "1.0",
  "encounter_id": "03246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.29,
      "duration_seconds": 4.24,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.29,
      "end_seconds": 11.27,
      "duration_seconds": 4.98,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.17,
      "end_seconds": 19.45,
      "duration_seconds": 7.28,
      "text": "Mainly headaches most days. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 22.46,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.3,
      "end_seconds": 33.81,
      "duration_seconds": 9.51,
      "text": "Ever since... since last Tuesday, really. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.63,
      "end_seconds": 45.03,
      "duration_seconds": 9.4,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.94,
      "end_seconds": 49.31,
      "duration_seconds": 3.37,
      "text": "It's every other day. Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.11,
      "end_seconds": 53.92,
      "duration_seconds": 2.81,
      "text": "Has there been light sensitivity too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.17,
      "end_seconds": 56.72,
      "duration_seconds": 1.55,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.28,
      "end_seconds": 58.06,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.95,
      "end_seconds": 75.56,
      "duration_seconds": 5.61,
      "text": "Have you had any visual changes, weakness, fever or stiff neck?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.38,
      "end_seconds": 79.93,
      "duration_seconds": 3.55,
      "text": "Erm, no, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.37,
      "end_seconds": 83.95,
      "duration_seconds": 3.58,
      "text": "Ah. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.91,
      "end_seconds": 90.42,
      "duration_seconds": 4.51,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.32,
      "end_seconds": 94.78,
      "duration_seconds": 3.46,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.65,
      "end_seconds": 99.03,
      "duration_seconds": 2.38,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.15,
      "end_seconds": 112.45,
      "duration_seconds": 4.3,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.45,
      "end_seconds": 117.5,
      "duration_seconds": 3.05,
      "text": "Glimepiride. I take it before breakfast."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.29,
      "end_seconds": 121.6,
      "duration_seconds": 2.31,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.2,
      "end_seconds": 123.31,
      "duration_seconds": 1.11,
      "text": "2 milligrams."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.19,
      "end_seconds": 142.6,
      "duration_seconds": 2.41,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.6,
      "end_seconds": 147.84,
      "duration_seconds": 3.24,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.92,
      "end_seconds": 150.6,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.65,
      "end_seconds": 156.93,
      "duration_seconds": 4.28,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.09,
      "end_seconds": 163.34,
      "duration_seconds": 1.25,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.48,
      "end_seconds": 168.03,
      "duration_seconds": 3.55,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.08,
      "end_seconds": 171.5,
      "duration_seconds": 2.42,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.2,
      "end_seconds": 176.44,
      "duration_seconds": 4.24,
      "text": "I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.23,
      "end_seconds": 179.26,
      "duration_seconds": 2.03,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.04,
      "end_seconds": 183.64,
      "duration_seconds": 2.6,
      "text": "Diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.25,
      "end_seconds": 194.51,
      "duration_seconds": 9.26,
      "text": "Okay, I can see migraines in your file as well. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.12,
      "end_seconds": 210.24,
      "duration_seconds": 2.12,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.31,
      "end_seconds": 228.85,
      "duration_seconds": 9.54,
      "text": "Okay: oxygen saturation is 97 percent, temperature is 36.6 degrees. And pressure 115 over 75, heart rate 69, respiratory rate 15."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.33,
      "end_seconds": 233.7,
      "duration_seconds": 2.37,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.22,
      "end_seconds": 239.76,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.31,
      "end_seconds": 243.58,
      "duration_seconds": 2.27,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.72,
      "end_seconds": 262.72,
      "duration_seconds": 2.0,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.25,
      "end_seconds": 265.06,
      "duration_seconds": 1.81,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.11,
      "end_seconds": 299.94,
      "duration_seconds": 31.83,
      "text": "That's all I needed to check. So, based on the history and the examination, this looks most like medication-overuse headache on a background of migraine. The reason I say that is that your story and my examination fit together. We shouldn't forget tension-type headache. I think a headache diary makes sense here, for daily headache. The treatment will be amitriptyline, 10 milligrams, at night, long term. You take it by mouth. That's for headache prevention."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.94,
      "end_seconds": 319.46,
      "duration_seconds": 18.52,
      "text": "Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again in six weeks. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.42,
      "end_seconds": 325.92,
      "duration_seconds": 4.5,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}