{
  "schema_version": "1.0",
  "encounter_id": "03342",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 7.95,
      "duration_seconds": 6.97,
      "text": "sorry, what was I saying, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.03,
      "end_seconds": 14.35,
      "duration_seconds": 4.32,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.18,
      "end_seconds": 25.25,
      "duration_seconds": 10.07,
      "text": "Honestly, it's a pearly bump on my nose that bleeds, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.12,
      "end_seconds": 30.54,
      "duration_seconds": 3.42,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 39.13,
      "duration_seconds": 2.57,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.91,
      "end_seconds": 64.62,
      "duration_seconds": 14.71,
      "text": "Okay: pulse is 75 beats a minute, SpO2 98 percent on room air, BP is 122 over 71, temperature is 36.7 degrees. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.39,
      "end_seconds": 73.78,
      "duration_seconds": 8.39,
      "text": "about... well, three days. I wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 76.91,
      "duration_seconds": 2.6,
      "text": "is it worse at certain times?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.49,
      "end_seconds": 83.35,
      "duration_seconds": 4.86,
      "text": "Erm, um, washing definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.92,
      "end_seconds": 87.81,
      "duration_seconds": 2.89,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.34,
      "end_seconds": 114.84,
      "duration_seconds": 25.5,
      "text": "I mean, you know, when it starts I tend to get crusting as well. Oh, as for crusting, I honestly can't say when that began. It might have been last month or the month before. I had a sore that won't heal before. That's settled now, you know, though."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.55,
      "end_seconds": 118.91,
      "duration_seconds": 3.36,
      "text": "so, and swollen glands, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 121.75,
      "duration_seconds": 2.3,
      "text": "No, no swollen glands."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.13,
      "end_seconds": 128.79,
      "duration_seconds": 5.66,
      "text": "Have you had any family history of skin cancer, other new lumps or pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.62,
      "end_seconds": 138.39,
      "duration_seconds": 8.77,
      "text": "I haven't had family history of skin cancer, other new lumps or pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.24,
      "end_seconds": 143.55,
      "duration_seconds": 4.31,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.07,
      "end_seconds": 145.61,
      "duration_seconds": 1.54,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.38,
      "end_seconds": 152.19,
      "duration_seconds": 2.81,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.49,
      "end_seconds": 157.07,
      "duration_seconds": 3.58,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.23,
      "end_seconds": 161.12,
      "duration_seconds": 2.89,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.73,
      "end_seconds": 171.06,
      "duration_seconds": 9.33,
      "text": "I swim twice a week. I look after my grandchildren most days. I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.3,
      "end_seconds": 174.33,
      "duration_seconds": 2.03,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.73,
      "end_seconds": 176.97,
      "duration_seconds": 1.24,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.47,
      "end_seconds": 180.94,
      "duration_seconds": 2.47,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.76,
      "end_seconds": 193.01,
      "duration_seconds": 11.25,
      "text": "Okay, so I have an underactive thyroid, for about a year. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.88,
      "end_seconds": 218.25,
      "duration_seconds": 7.37,
      "text": "are there any allergies I should be aware of? I'm asking so that we don't miss anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.28,
      "end_seconds": 224.92,
      "duration_seconds": 4.64,
      "text": "Um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.55,
      "end_seconds": 242.03,
      "duration_seconds": 2.48,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.96,
      "end_seconds": 249.26,
      "duration_seconds": 6.3,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.43,
      "end_seconds": 254.7,
      "duration_seconds": 3.27,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.65,
      "end_seconds": 258.23,
      "duration_seconds": 2.58,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.35,
      "end_seconds": 284.25,
      "duration_seconds": 7.9,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.57,
      "end_seconds": 294.5,
      "duration_seconds": 7.93,
      "text": "Okay, that's enough for me. So where does that leave us? This is probably a likely basal cell carcinoma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.55,
      "end_seconds": 299.85,
      "duration_seconds": 4.3,
      "text": "Mm, you know, is it it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.86,
      "end_seconds": 327.31,
      "duration_seconds": 22.45,
      "text": "Nothing I've seen today points to an emergency. It looks like a likely basal cell carcinoma, but I'd like to confirm. Just to be sure I understood. You've had a pearly bump on your nose that bleeds for three days, and no swollen glands or family history of skin cancer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.06,
      "end_seconds": 328.76,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.8,
      "end_seconds": 344.41,
      "duration_seconds": 4.61,
      "text": "A skin biopsy is what I'd like next, for suspicious lesion."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.6,
      "end_seconds": 351.32,
      "duration_seconds": 2.72,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.02,
      "end_seconds": 383.4,
      "duration_seconds": 30.38,
      "text": "I'm going to order a dermoscopy, for suspicious lesion. That will help us see what's going on underneath and decide the next step. Please use a high-factor sunscreen and a hat. I'm going to send a referral to to the skin cancer clinic. I'd like to see you again after the biopsy. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.92,
      "end_seconds": 392.55,
      "duration_seconds": 3.63,
      "text": "I think I understand everything. Thanks"
    }
  ]
}