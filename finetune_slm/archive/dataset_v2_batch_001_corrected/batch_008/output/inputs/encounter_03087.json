{
  "schema_version": "1.0",
  "encounter_id": "03087",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 7.86,
      "duration_seconds": 6.49,
      "text": "doctor, you know, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 13.31,
      "duration_seconds": 4.56,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.2,
      "end_seconds": 21.61,
      "duration_seconds": 6.41,
      "text": "Doctor, you know, it's wheeze at work. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.99,
      "end_seconds": 26.24,
      "duration_seconds": 3.25,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.76,
      "end_seconds": 36.98,
      "duration_seconds": 10.22,
      "text": "So, it started yesterday. I didn't want to make a fuss, you know. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.34,
      "end_seconds": 40.58,
      "duration_seconds": 2.24,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.87,
      "end_seconds": 45.84,
      "duration_seconds": 3.97,
      "text": "Ah, yes, spray paint. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.72,
      "end_seconds": 49.88,
      "duration_seconds": 3.16,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.93,
      "end_seconds": 54.82,
      "duration_seconds": 2.89,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.57,
      "end_seconds": 59.54,
      "duration_seconds": 2.97,
      "text": "Okay, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.51,
      "end_seconds": 81.21,
      "duration_seconds": 20.7,
      "text": "Itchy eyes at work goes along with it, most of the time. The Itchy eyes at work? That's been for about two weeks. Let me think, with Itchy eyes at work, mostly severe. Honestly, a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.89,
      "end_seconds": 94.22,
      "duration_seconds": 4.33,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 100.13,
      "duration_seconds": 4.23,
      "text": "No, you know, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.75,
      "end_seconds": 105.39,
      "duration_seconds": 4.64,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.29,
      "end_seconds": 128.61,
      "duration_seconds": 21.32,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. No, I share a house with my brother. I walk the dog every morning. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.1,
      "end_seconds": 149.03,
      "duration_seconds": 2.93,
      "text": "Alright, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.49,
      "end_seconds": 153.15,
      "duration_seconds": 2.66,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.12,
      "end_seconds": 157.52,
      "duration_seconds": 3.4,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.02,
      "end_seconds": 161.86,
      "duration_seconds": 2.84,
      "text": "not really, you know, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.55,
      "end_seconds": 178.89,
      "duration_seconds": 5.34,
      "text": "let me check a few things. Any weight loss, ankle swelling or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.4,
      "end_seconds": 181.32,
      "duration_seconds": 1.92,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.44,
      "end_seconds": 185.31,
      "duration_seconds": 2.87,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.39,
      "end_seconds": 190.39,
      "duration_seconds": 3.0,
      "text": "No, uh, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.99,
      "end_seconds": 197.14,
      "duration_seconds": 3.15,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 213.63,
      "duration_seconds": 2.6,
      "text": "okay, nearly done with the readings.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.64,
      "end_seconds": 236.13,
      "duration_seconds": 9.49,
      "text": "Okay: respiratory rate 15, blood pressure 115 over 75. And temperature is 36.8 degrees, pulse 69, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.46,
      "end_seconds": 242.52,
      "duration_seconds": 5.06,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.9,
      "end_seconds": 252.42,
      "duration_seconds": 1.52,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.81,
      "end_seconds": 255.07,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 271.63,
      "duration_seconds": 5.37,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.95,
      "end_seconds": 292.67,
      "duration_seconds": 17.72,
      "text": "Good, you can sit up again. Let me tell you where I've got to. It points towards occupational asthma. The reason I say that is that your story and my examination fit together. I want spirometry done, that's for wheeze."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.89,
      "end_seconds": 299.06,
      "duration_seconds": 1.17,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.48,
      "end_seconds": 312.68,
      "duration_seconds": 12.2,
      "text": "I want serial peak flow readings done, that's for work-related wheeze. You'll be taking beclometasone inhaler, 200 micrograms, twice a day, long term. That's for asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.41,
      "end_seconds": 315.92,
      "duration_seconds": 1.51,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.23,
      "end_seconds": 334.53,
      "duration_seconds": 17.3,
      "text": "record peak flows at work and at home for four weeks i'm going to send a a referral to occupational health please come and see me in four weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.83,
      "end_seconds": 340.15,
      "duration_seconds": 3.32,
      "text": "Uh, thank you, doctor, goodbye."
    }
  ]
}