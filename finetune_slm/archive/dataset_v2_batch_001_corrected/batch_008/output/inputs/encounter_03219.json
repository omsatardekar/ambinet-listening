{
  "schema_version": "1.0",
  "encounter_id": "03219",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 5.38,
      "duration_seconds": 4.51,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.92,
      "duration_seconds": 4.56,
      "text": "Okay, thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.71,
      "end_seconds": 17.69,
      "duration_seconds": 4.98,
      "text": "morning, doctor. I'll stay and and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.41,
      "end_seconds": 24.87,
      "duration_seconds": 5.46,
      "text": "of course, please stay it's helpful to to have you here"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.25,
      "end_seconds": 28.85,
      "duration_seconds": 2.6,
      "text": "We came because of shaking."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.58,
      "end_seconds": 33.47,
      "duration_seconds": 3.89,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 39.32,
      "duration_seconds": 4.25,
      "text": "uh, it's been five days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.3,
      "end_seconds": 49.96,
      "duration_seconds": 8.66,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.62,
      "end_seconds": 75.49,
      "duration_seconds": 19.87,
      "text": "Sorry, what was I saying, it just comes and goes. Maybe a four out of ten on a bad day. I told myself I'd wait and see, and here I am. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.42,
      "end_seconds": 83.07,
      "duration_seconds": 6.65,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 83.17,
      "end_seconds": 88.92,
      "duration_seconds": 5.75,
      "text": "Tell the the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.42,
      "end_seconds": 101.66,
      "duration_seconds": 10.24,
      "text": "I was getting to that! Erm, and I've been feeling anxious and agitated as well, for about four days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.48,
      "end_seconds": 105.79,
      "duration_seconds": 3.31,
      "text": "Any being unable to sleep as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.36,
      "end_seconds": 108.57,
      "duration_seconds": 1.21,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 114.76,
      "duration_seconds": 4.95,
      "text": "Have you had shaking before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.7,
      "end_seconds": 123.14,
      "duration_seconds": 7.44,
      "text": "Hmm, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.85,
      "end_seconds": 130.43,
      "duration_seconds": 3.58,
      "text": "Have you noticed vomiting blood, seizure or confusion?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.79,
      "end_seconds": 142.61,
      "duration_seconds": 10.82,
      "text": "No, no vomiting blood, no seizure, no confusion. I was sweating at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.12,
      "end_seconds": 146.66,
      "duration_seconds": 2.54,
      "text": "Has there been any seeing things?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.62,
      "end_seconds": 152.1,
      "duration_seconds": 3.48,
      "text": "Not at all, no seeing things."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.01,
      "end_seconds": 156.63,
      "duration_seconds": 3.62,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.61,
      "end_seconds": 163.62,
      "duration_seconds": 5.01,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.4,
      "end_seconds": 168.04,
      "duration_seconds": 3.64,
      "text": "Alright, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.55,
      "end_seconds": 171.51,
      "duration_seconds": 2.96,
      "text": "No, um, joints are fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.34,
      "end_seconds": 177.8,
      "duration_seconds": 4.46,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.6,
      "end_seconds": 190.21,
      "duration_seconds": 9.61,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.62,
      "end_seconds": 196.13,
      "duration_seconds": 4.51,
      "text": "alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 197.57,
      "end_seconds": 201.89,
      "duration_seconds": 4.32,
      "text": "He takes bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.97,
      "end_seconds": 205.95,
      "duration_seconds": 1.98,
      "text": "right, is that long-standing?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 206.64,
      "end_seconds": 218.88,
      "duration_seconds": 12.24,
      "text": "For two years. He is on thyroxine, 75 micrograms, every morning for my thyroid, I give it to him. It's valsartan, once a day, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.11,
      "end_seconds": 222.21,
      "duration_seconds": 2.1,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.25,
      "end_seconds": 237.49,
      "duration_seconds": 14.24,
      "text": "80 milligrams, I think that's what's on the box. He is on heavy drinking until two days ago, stopped two days ago, I give it to him."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.15,
      "end_seconds": 255.47,
      "duration_seconds": 4.32,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.13,
      "end_seconds": 266.18,
      "duration_seconds": 9.05,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.72,
      "end_seconds": 269.13,
      "duration_seconds": 2.41,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.85,
      "end_seconds": 275.54,
      "duration_seconds": 5.69,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.93,
      "end_seconds": 296.34,
      "duration_seconds": 4.41,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 297.25,
      "end_seconds": 310.29,
      "duration_seconds": 13.04,
      "text": "An irregular heartbeat, for nearly five years. I'd rather know what's going on than keep guessing. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.35,
      "end_seconds": 314.01,
      "duration_seconds": 1.66,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.18,
      "end_seconds": 317.19,
      "duration_seconds": 2.01,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.81,
      "end_seconds": 319.51,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.79,
      "end_seconds": 328.88,
      "duration_seconds": 5.09,
      "text": "Hmm, I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.95,
      "end_seconds": 333.19,
      "duration_seconds": 2.24,
      "text": "Right, is there anything more?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 334.73,
      "end_seconds": 337.97,
      "duration_seconds": 3.24,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.03,
      "end_seconds": 348.32,
      "duration_seconds": 8.29,
      "text": "right, so high cholesterol and an underactive thyroid are already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 349.44,
      "end_seconds": 357.57,
      "duration_seconds": 8.13,
      "text": "Here are the the numbers, doctor. Temperature is 36.8 degrees, blood pressure 129 over 75, pulse 118."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.75,
      "end_seconds": 359.45,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.44,
      "end_seconds": 365.8,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.71,
      "end_seconds": 372.21,
      "duration_seconds": 1.5,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.07,
      "end_seconds": 375.89,
      "duration_seconds": 2.82,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.41,
      "end_seconds": 390.77,
      "duration_seconds": 5.36,
      "text": "You have a coarse tremor, a fast pulse and you are sweating."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.55,
      "end_seconds": 406.26,
      "duration_seconds": 10.71,
      "text": "Good, you can sit up again. Let me repeat that back to make sure. You've had shaking for five days, and no seeing things or confusion."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.53,
      "end_seconds": 408.23,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.88,
      "end_seconds": 412.55,
      "duration_seconds": 3.67,
      "text": "I'll request blood tests, it'll help with alcohol withdrawal."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 413.92,
      "end_seconds": 416.21,
      "duration_seconds": 2.29,
      "text": "the earliest is Tuesday, 2 pm"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.06,
      "end_seconds": 437.25,
      "duration_seconds": 20.19,
      "text": "what I'm giving you is chlordiazepoxide, 20 milligrams, four times a day, reducing over five days you take it it by mouth that should help with alcohol withdrawal what I'm giving you is thiamine, 100 milligrams, three times a day, long term it's for alcohol-related deficiency"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 438.25,
      "end_seconds": 441.87,
      "duration_seconds": 3.62,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.21,
      "end_seconds": 461.04,
      "duration_seconds": 17.83,
      "text": "do not stop alcohol suddenly without medical support i'd like you to see the alcohol liaison service as well, and I'll write the referral one warning sign to remember: the symptoms get worse in that case don't wait"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 462.79,
      "end_seconds": 464.15,
      "duration_seconds": 1.36,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.92,
      "end_seconds": 470.59,
      "duration_seconds": 4.67,
      "text": "we'll catch up in two days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 472.58,
      "end_seconds": 477.85,
      "duration_seconds": 5.27,
      "text": "Let me think, good, thanks, I'll see you then."
    }
  ]
}