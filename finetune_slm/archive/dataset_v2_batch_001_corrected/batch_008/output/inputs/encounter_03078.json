{
  "schema_version": "1.0",
  "encounter_id": "03078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 2.83,
      "duration_seconds": 2.1,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.54,
      "end_seconds": 8.54,
      "duration_seconds": 1.0,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.2,
      "end_seconds": 15.56,
      "duration_seconds": 6.36,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.36,
      "end_seconds": 23.32,
      "duration_seconds": 6.96,
      "text": "Yes, that's no problem at all. Please sit. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.84,
      "end_seconds": 28.82,
      "duration_seconds": 3.98,
      "text": "He's been having flakes on my shoulders, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 33.38,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.12,
      "end_seconds": 37.66,
      "duration_seconds": 2.54,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.33,
      "end_seconds": 43.61,
      "duration_seconds": 4.28,
      "text": "I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.68,
      "end_seconds": 48.82,
      "duration_seconds": 4.14,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.41,
      "end_seconds": 54.0,
      "duration_seconds": 3.59,
      "text": "Ah, uh, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.74,
      "end_seconds": 57.36,
      "duration_seconds": 2.62,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.92,
      "end_seconds": 62.26,
      "duration_seconds": 3.34,
      "text": "It settles a little with shampoo."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.16,
      "end_seconds": 66.16,
      "duration_seconds": 3.0,
      "text": "Has there been an itchy scalp too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.93,
      "end_seconds": 71.63,
      "duration_seconds": 3.7,
      "text": "Mm, yes, about the same, two days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.67,
      "end_seconds": 78.35,
      "duration_seconds": 5.68,
      "text": "Have you had flakes on your shoulders before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.12,
      "end_seconds": 88.36,
      "duration_seconds": 8.24,
      "text": "Let me think, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.53,
      "end_seconds": 102.43,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.7,
      "end_seconds": 112.98,
      "duration_seconds": 3.28,
      "text": "Alright, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.3,
      "end_seconds": 132.41,
      "duration_seconds": 8.11,
      "text": "Okay: pulse 72, respiratory rate 18, saturation 97 percent. And pressure 127 over 68, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.03,
      "end_seconds": 138.38,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.06,
      "end_seconds": 142.52,
      "duration_seconds": 3.46,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.4,
      "end_seconds": 149.46,
      "duration_seconds": 4.06,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.88,
      "end_seconds": 152.25,
      "duration_seconds": 1.37,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.38,
      "end_seconds": 165.18,
      "duration_seconds": 4.8,
      "text": "There is fine greasy scaling across the scalp with no bald patches."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.76,
      "end_seconds": 167.71,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.71,
      "end_seconds": 178.24,
      "duration_seconds": 5.53,
      "text": "You can sit up now. Right, and what about pus or rash elsewhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.84,
      "end_seconds": 182.16,
      "duration_seconds": 2.32,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.94,
      "end_seconds": 186.43,
      "duration_seconds": 3.49,
      "text": "Have you had any hair loss or pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.38,
      "end_seconds": 192.86,
      "duration_seconds": 4.48,
      "text": "No hair loss or pain, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.87,
      "end_seconds": 197.29,
      "duration_seconds": 3.42,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.4,
      "end_seconds": 200.55,
      "duration_seconds": 2.15,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.57,
      "end_seconds": 205.58,
      "duration_seconds": 4.01,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.73,
      "end_seconds": 208.26,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.53,
      "end_seconds": 214.08,
      "duration_seconds": 4.55,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.85,
      "end_seconds": 218.89,
      "duration_seconds": 4.04,
      "text": "I'm on apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 219.6,
      "end_seconds": 225.74,
      "duration_seconds": 6.14,
      "text": "Uh, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.19,
      "end_seconds": 230.31,
      "duration_seconds": 3.12,
      "text": "An anti-dandruff shampoo, twice a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.37,
      "end_seconds": 234.32,
      "duration_seconds": 2.95,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.57,
      "end_seconds": 241.34,
      "duration_seconds": 4.77,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.91,
      "end_seconds": 245.48,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.51,
      "end_seconds": 249.04,
      "duration_seconds": 2.53,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.95,
      "end_seconds": 259.42,
      "duration_seconds": 8.47,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.95,
      "end_seconds": 264.51,
      "duration_seconds": 3.56,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.92,
      "end_seconds": 275.86,
      "duration_seconds": 2.94,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.45,
      "end_seconds": 281.35,
      "duration_seconds": 3.9,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.09,
      "end_seconds": 285.31,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.04,
      "end_seconds": 289.83,
      "duration_seconds": 2.79,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.59,
      "end_seconds": 294.82,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 299.19,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.0,
      "end_seconds": 309.73,
      "duration_seconds": 9.73,
      "text": "Right, here's what I'm thinking. I think we're dealing with simple dandruff at this stage. Seborrhoeic dermatitis is still possible."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.2,
      "end_seconds": 314.74,
      "duration_seconds": 3.54,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.79,
      "end_seconds": 323.25,
      "duration_seconds": 7.46,
      "text": "I understand the worry. At the moment I'd say it's simple dandruff, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.11,
      "end_seconds": 346.06,
      "duration_seconds": 14.95,
      "text": "I'll start you on ketoconazole shampoo, 2%, twice a week, four weeks. That should help with dandruff. Leave the shampoo on for five minutes before rinsing. I'd like you back if not better in a month."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.71,
      "end_seconds": 351.03,
      "duration_seconds": 2.32,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.75,
      "end_seconds": 355.75,
      "duration_seconds": 4.0,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.82,
      "end_seconds": 360.53,
      "duration_seconds": 3.71,
      "text": "So, great, thank you for your help."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.56,
      "end_seconds": 366.92,
      "duration_seconds": 1.36,
      "text": "Take care now."
    }
  ]
}