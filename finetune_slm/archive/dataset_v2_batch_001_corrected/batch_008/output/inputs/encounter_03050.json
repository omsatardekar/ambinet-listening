{
  "schema_version": "1.0",
  "encounter_id": "03050",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 6.85,
      "duration_seconds": 5.5,
      "text": "hi, you know, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.79,
      "end_seconds": 12.22,
      "duration_seconds": 4.43,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.54,
      "end_seconds": 19.0,
      "duration_seconds": 5.46,
      "text": "Let me think, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.27,
      "end_seconds": 31.07,
      "duration_seconds": 10.8,
      "text": "I mean, um, mainly vomiting once or twice. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 34.47,
      "duration_seconds": 1.64,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.79,
      "end_seconds": 39.45,
      "duration_seconds": 3.66,
      "text": "I've had it for one week"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.3,
      "end_seconds": 43.64,
      "duration_seconds": 2.34,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.91,
      "end_seconds": 47.51,
      "duration_seconds": 2.6,
      "text": "I'd call it it moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.43,
      "end_seconds": 51.71,
      "duration_seconds": 2.28,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.79,
      "end_seconds": 64.48,
      "duration_seconds": 11.69,
      "text": "I, I'd say all the time. Let me think, I've also had loose stools. Right, I've also had a mild tummy ache."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.52,
      "end_seconds": 71.34,
      "duration_seconds": 5.82,
      "text": "have you had vomiting once or twice before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.91,
      "end_seconds": 82.39,
      "duration_seconds": 9.48,
      "text": "Uh, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.86,
      "end_seconds": 87.64,
      "duration_seconds": 3.78,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.14,
      "end_seconds": 100.5,
      "duration_seconds": 2.36,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.93,
      "end_seconds": 124.74,
      "duration_seconds": 6.81,
      "text": "Okay: pulse is 65 beats a minute, respiratory rate 16, blood pressure 118 over 81."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.97,
      "end_seconds": 131.13,
      "duration_seconds": 5.16,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.56,
      "end_seconds": 134.9,
      "duration_seconds": 2.34,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.54,
      "end_seconds": 150.9,
      "duration_seconds": 5.36,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.87,
      "end_seconds": 157.69,
      "duration_seconds": 1.82,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.76,
      "end_seconds": 182.55,
      "duration_seconds": 6.79,
      "text": "A few quick ones: high fever, drowsiness, blood in the stool or no wet nappies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.14,
      "end_seconds": 191.84,
      "duration_seconds": 8.7,
      "text": "Mm, no high fever, drowsiness, blood in the stool or no wet nappies, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.74,
      "end_seconds": 196.22,
      "duration_seconds": 3.48,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.74,
      "end_seconds": 203.23,
      "duration_seconds": 3.49,
      "text": "I mean, no, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.09,
      "end_seconds": 207.52,
      "duration_seconds": 3.43,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.13,
      "end_seconds": 211.49,
      "duration_seconds": 2.36,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 232.76,
      "duration_seconds": 2.9,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.45,
      "end_seconds": 245.62,
      "duration_seconds": 11.17,
      "text": "Let me think, I had a reaction to tramadol when I was younger, feeling very drowsy, and I've avoided it since."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.51,
      "end_seconds": 254.69,
      "duration_seconds": 4.18,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.82,
      "end_seconds": 263.32,
      "duration_seconds": 4.5,
      "text": "Well, um, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.66,
      "end_seconds": 267.4,
      "duration_seconds": 2.74,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.35,
      "end_seconds": 272.17,
      "duration_seconds": 2.82,
      "text": "Depression, for nearly five years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.66,
      "end_seconds": 286.78,
      "duration_seconds": 13.12,
      "text": "right, so depression is already on your record we'll keep that in mind today are you taking anything regularly, including from the pharmacy? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.38,
      "end_seconds": 294.57,
      "duration_seconds": 6.19,
      "text": "Okay, so I was on mirtazapine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.05,
      "end_seconds": 297.44,
      "duration_seconds": 1.39,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.75,
      "end_seconds": 302.5,
      "duration_seconds": 3.75,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.29,
      "end_seconds": 305.92,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.61,
      "end_seconds": 310.22,
      "duration_seconds": 2.61,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.66,
      "end_seconds": 315.07,
      "duration_seconds": 3.41,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.71,
      "end_seconds": 325.61,
      "duration_seconds": 8.9,
      "text": "Hmm, you know, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.61,
      "end_seconds": 333.51,
      "duration_seconds": 5.9,
      "text": "Let me tell you where I've got to. It points towards a mild stomach bug."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.95,
      "end_seconds": 338.86,
      "duration_seconds": 3.91,
      "text": "Well, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.06,
      "end_seconds": 371.1,
      "duration_seconds": 31.04,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. Small, frequent sips of fluid and keep him off nursery for two days after it stops. The thing that would worry me is if he stops drinking or becomes drowsy. If that happens, go to emergency. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.87,
      "end_seconds": 374.53,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.73,
      "end_seconds": 380.18,
      "duration_seconds": 1.45,
      "text": "goodbye for now"
    }
  ]
}