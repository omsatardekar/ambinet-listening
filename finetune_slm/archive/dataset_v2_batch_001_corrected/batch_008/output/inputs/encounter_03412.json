{
  "schema_version": "1.0",
  "encounter_id": "03412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.75,
      "duration_seconds": 4.4,
      "text": "good evening, uh, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.01,
      "end_seconds": 11.29,
      "duration_seconds": 4.28,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.97,
      "end_seconds": 15.53,
      "duration_seconds": 3.56,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.79,
      "end_seconds": 24.17,
      "duration_seconds": 7.38,
      "text": "So the thing is, I've got sudden severe pain in the lower tummy."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.92,
      "end_seconds": 29.64,
      "duration_seconds": 3.72,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.95,
      "end_seconds": 41.22,
      "duration_seconds": 8.27,
      "text": "About... well, about a week. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.13,
      "end_seconds": 48.43,
      "duration_seconds": 5.3,
      "text": "is it there all the time or does it it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.08,
      "end_seconds": 52.79,
      "duration_seconds": 2.71,
      "text": "it sort of comes and goes"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.68,
      "end_seconds": 61.1,
      "duration_seconds": 7.42,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.2,
      "end_seconds": 67.11,
      "duration_seconds": 5.91,
      "text": "Ah, tell the doctor about the the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.17,
      "end_seconds": 81.79,
      "duration_seconds": 12.62,
      "text": "I was getting to that! Um, as for collapsing, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 83.18,
      "end_seconds": 94.16,
      "duration_seconds": 10.98,
      "text": "Okay, so the vitals from earlier. BP is 95 over 64, heart rate 112. Oxygen saturation is 96 percent, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.83,
      "end_seconds": 96.8,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 104.56,
      "duration_seconds": 4.81,
      "text": "right, I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.27,
      "end_seconds": 107.47,
      "duration_seconds": 1.2,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.22,
      "end_seconds": 127.42,
      "duration_seconds": 7.2,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.92,
      "end_seconds": 139.76,
      "duration_seconds": 6.84,
      "text": "alright, that's all I needed to check and what about fever, vomiting or discharge?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.65,
      "end_seconds": 152.47,
      "duration_seconds": 10.82,
      "text": "No, no fever, no vomiting, no discharge. I did have shoulder tip pain at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.51,
      "end_seconds": 159.33,
      "duration_seconds": 1.82,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.43,
      "end_seconds": 162.41,
      "duration_seconds": 1.98,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.92,
      "end_seconds": 166.53,
      "duration_seconds": 2.61,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.78,
      "end_seconds": 171.95,
      "duration_seconds": 4.17,
      "text": "let me think, nothing on the skin, no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.18,
      "end_seconds": 176.05,
      "duration_seconds": 2.87,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.11,
      "end_seconds": 180.49,
      "duration_seconds": 3.38,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.58,
      "end_seconds": 184.59,
      "duration_seconds": 3.01,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.25,
      "end_seconds": 187.94,
      "duration_seconds": 2.69,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.9,
      "end_seconds": 193.27,
      "duration_seconds": 3.37,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.9,
      "end_seconds": 202.57,
      "duration_seconds": 7.67,
      "text": "let me think, I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.78,
      "end_seconds": 206.61,
      "duration_seconds": 2.83,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.77,
      "end_seconds": 212.29,
      "duration_seconds": 2.52,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.62,
      "end_seconds": 228.77,
      "duration_seconds": 4.15,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.78,
      "end_seconds": 232.5,
      "duration_seconds": 2.72,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.86,
      "end_seconds": 234.56,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.43,
      "end_seconds": 242.73,
      "duration_seconds": 6.3,
      "text": "I've had depression for nearly five years now. I have low haemoglobin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.71,
      "end_seconds": 258.16,
      "duration_seconds": 10.45,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.35,
      "end_seconds": 273.35,
      "duration_seconds": 14.0,
      "text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.83,
      "end_seconds": 278.65,
      "duration_seconds": 3.82,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.89,
      "end_seconds": 285.01,
      "duration_seconds": 5.12,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 286.82,
      "end_seconds": 292.49,
      "duration_seconds": 5.67,
      "text": "that's what's prescribed, but I'm not sure she takes it every day"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.22,
      "end_seconds": 297.61,
      "duration_seconds": 4.39,
      "text": "okay, so I'm on fluoxetine, 20 milligrams, every morning"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.95,
      "end_seconds": 298.65,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.22,
      "end_seconds": 307.34,
      "duration_seconds": 8.12,
      "text": "I'm on iron tablets, once a day. I'd been on sertraline, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.21,
      "end_seconds": 320.0,
      "duration_seconds": 8.79,
      "text": "So where does that that leave us? My working impression is a ruptured ectopic pregnancy. A ruptured ovarian cyst is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.03,
      "end_seconds": 324.2,
      "duration_seconds": 3.17,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.2,
      "end_seconds": 334.11,
      "duration_seconds": 8.91,
      "text": "nothing I've seen today points to an emergency it looks like a ruptured ectopic pregnancy, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 352.22,
      "end_seconds": 358.97,
      "duration_seconds": 6.75,
      "text": "Doctor, I did a pregnancy test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.69,
      "end_seconds": 383.81,
      "duration_seconds": 24.12,
      "text": "Great, that's useful. Urgent blood tests is what I'd like next, for internal bleeding. I am calling the emergency team, you need an operation now. Don't skip meals, and try to eat smaller portions more often through the day. Do get help quickly if the symptoms get worse. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.72,
      "end_seconds": 389.28,
      "duration_seconds": 3.56,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}