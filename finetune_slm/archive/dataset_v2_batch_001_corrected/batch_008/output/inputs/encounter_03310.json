  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.32,
      "duration_seconds": 3.64,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.13,
      "end_seconds": 10.23,
      "duration_seconds": 5.1,
      "text": "you're alright take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.6,
      "end_seconds": 16.51,
      "duration_seconds": 4.91,
      "text": "well I've been having a severe headache for days"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.67,
      "end_seconds": 22.18,
      "duration_seconds": 4.51,
      "text": "Since when exactly? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.69,
      "end_seconds": 27.34,
      "duration_seconds": 3.65,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.03,
      "end_seconds": 30.9,
      "duration_seconds": 2.87,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.13,
      "end_seconds": 43.11,
      "duration_seconds": 10.98,
      "text": "a three out of ten I suppose oh and drowsiness that's been about the the same five days as for drowsiness it's mild honestly"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 57.69,
      "duration_seconds": 2.64,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.71,
      "end_seconds": 70.59,
      "duration_seconds": 2.88,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.5,
      "end_seconds": 98.12,
      "duration_seconds": 9.62,
      "text": "okay: blood pressure 159 over 102, oxygen saturation is 98 percent, respiratory rate 14, pulse is 78 beats a minute"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.04,
      "end_seconds": 105.73,
      "duration_seconds": 4.69,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.52,
      "end_seconds": 109.33,
      "duration_seconds": 1.81,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.97,
      "end_seconds": 126.01,
      "duration_seconds": 4.04,
      "text": "The optic discs look swollen and you are drowsy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.59,
      "end_seconds": 134.87,
      "duration_seconds": 5.28,
      "text": "so that's the examination finished have you had any weakness on one side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.58,
      "end_seconds": 139.92,
      "duration_seconds": 4.34,
      "text": "I haven't noticed any weakness on one side"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.7,
      "end_seconds": 145.41,
      "duration_seconds": 3.71,
      "text": "a few quick ones: head injury or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.62,
      "end_seconds": 154.72,
      "duration_seconds": 4.1,
      "text": "I haven't had head injury or fever, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.05,
      "end_seconds": 159.95,
      "duration_seconds": 3.9,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.77,
      "end_seconds": 162.24,
      "duration_seconds": 1.47,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.24,
      "end_seconds": 166.86,
      "duration_seconds": 2.62,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.95,
      "end_seconds": 171.98,
      "duration_seconds": 3.03,
      "text": "no, um, not at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.69,
      "end_seconds": 175.36,
      "duration_seconds": 2.67,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.22,
      "end_seconds": 180.72,
      "duration_seconds": 4.5,
      "text": "I mean, I have acid reflux, for five years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 193.48,
      "duration_seconds": 4.04,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 200.56,
      "duration_seconds": 6.34,
      "text": "It's lansoprazole, 30 milligrams, before breakfast. I take the contraceptive pill, daily."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.86,
      "end_seconds": 215.19,
      "duration_seconds": 3.33,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.33,
      "end_seconds": 219.64,
      "duration_seconds": 3.31,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.7,
      "end_seconds": 223.06,
      "duration_seconds": 1.36,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.18,
      "end_seconds": 227.39,
      "duration_seconds": 3.21,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 231.75,
      "duration_seconds": 3.51,
      "text": "so, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.65,
      "end_seconds": 235.16,
      "duration_seconds": 1.51,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.02,
      "end_seconds": 246.18,
      "duration_seconds": 5.16,
      "text": "okay thinking it through it fits best with possible cerebral venous thrombosis"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.42,
      "end_seconds": 250.16,
      "duration_seconds": 2.74,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.87,
      "end_seconds": 259.35,
      "duration_seconds": 7.48,
      "text": "I can't promise yet, but most people with possible cerebral venous thrombosis do well once it's treated properly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.09,
      "end_seconds": 284.65,
      "duration_seconds": 12.56,
      "text": "I want an MRI of the head done, that's for papilloedema that will help us see what's going on underneath and decide the the next step"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.72,
      "end_seconds": 288.69,
      "duration_seconds": 1.97,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.26,
      "end_seconds": 302.77,
      "duration_seconds": 13.51,
      "text": "I'd like to arrange an urgent CT venogram for possible venous thrombosis stop the pill, you need an urgent scan and admission do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.75,
      "end_seconds": 306.64,
      "duration_seconds": 2.89,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.5,
      "end_seconds": 313.44,
      "duration_seconds": 3.94,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.98,
      "end_seconds": 318.28,
      "duration_seconds": 3.3,
      "text": "no that's all. Thanks a lot"
    }
  ]
}