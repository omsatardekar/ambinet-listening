{
  "schema_version": "1.0",
  "encounter_id": "03475",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 8.62,
      "duration_seconds": 7.78,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.61,
      "end_seconds": 14.74,
      "duration_seconds": 4.13,
      "text": "thanks, that's helpful hello, please sit what's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.69,
      "end_seconds": 22.15,
      "duration_seconds": 5.46,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.15,
      "end_seconds": 27.56,
      "duration_seconds": 3.41,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.48,
      "end_seconds": 34.07,
      "duration_seconds": 5.59,
      "text": "She's been having a splash of cleaning fluid in my eye, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.21,
      "end_seconds": 41.25,
      "duration_seconds": 3.04,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.01,
      "end_seconds": 47.81,
      "duration_seconds": 5.8,
      "text": "I'd say about a week. Actually, no, closer to two weeks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.75,
      "end_seconds": 52.63,
      "duration_seconds": 2.88,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.7,
      "end_seconds": 58.41,
      "duration_seconds": 4.71,
      "text": "Pretty mild, if I'm being honest. Oh, and blurred vision."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.02,
      "end_seconds": 64.91,
      "duration_seconds": 3.89,
      "text": "Has there been being unable to open it too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.45,
      "end_seconds": 77.13,
      "duration_seconds": 11.68,
      "text": "Mm, yes. As for severe burning, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 82.01,
      "duration_seconds": 3.64,
      "text": "And And what about both eyes or head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.09,
      "end_seconds": 86.51,
      "duration_seconds": 2.42,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.2,
      "end_seconds": 90.38,
      "duration_seconds": 2.18,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.1,
      "end_seconds": 93.07,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.35,
      "end_seconds": 97.53,
      "duration_seconds": 3.18,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.77,
      "end_seconds": 101.79,
      "duration_seconds": 3.02,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.97,
      "end_seconds": 106.03,
      "duration_seconds": 3.06,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.51,
      "end_seconds": 110.28,
      "duration_seconds": 2.77,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.97,
      "end_seconds": 113.82,
      "duration_seconds": 1.85,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.86,
      "end_seconds": 119.82,
      "duration_seconds": 3.96,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.58,
      "end_seconds": 133.92,
      "duration_seconds": 1.34,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.01,
      "end_seconds": 139.51,
      "duration_seconds": 3.5,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.35,
      "end_seconds": 145.7,
      "duration_seconds": 4.35,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.73,
      "end_seconds": 150.14,
      "duration_seconds": 2.41,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.98,
      "end_seconds": 152.41,
      "duration_seconds": 1.43,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.3,
      "end_seconds": 159.01,
      "duration_seconds": 5.71,
      "text": "High blood pressure, for about ten years. Yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.87,
      "end_seconds": 165.6,
      "duration_seconds": 5.73,
      "text": "alright, high cholesterol and an underactive thyroid, that matches what I have here"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.44,
      "end_seconds": 186.77,
      "duration_seconds": 4.33,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.95,
      "end_seconds": 190.86,
      "duration_seconds": 2.91,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 191.72,
      "end_seconds": 198.78,
      "duration_seconds": 7.06,
      "text": "Hold on, doctor, I think she reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.74,
      "end_seconds": 202.31,
      "duration_seconds": 2.57,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.19,
      "end_seconds": 209.53,
      "duration_seconds": 6.34,
      "text": "okay, I'll note both of those. What do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.56,
      "end_seconds": 215.92,
      "duration_seconds": 5.36,
      "text": "Simvastatin. I take it 20 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.95,
      "end_seconds": 219.4,
      "duration_seconds": 2.45,
      "text": "roughly how long on that one?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.84,
      "end_seconds": 230.76,
      "duration_seconds": 5.92,
      "text": "for six months it's metoprolol, 50 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 232.36,
      "end_seconds": 240.82,
      "duration_seconds": 8.46,
      "text": "It's meant to be twice a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.6,
      "end_seconds": 255.01,
      "duration_seconds": 13.41,
      "text": "I'm on thyroxine, 75 micrograms, every morning for my thyroid. Sorry, I know I'm rambling a bit. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.74,
      "end_seconds": 259.71,
      "duration_seconds": 2.97,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.1,
      "end_seconds": 262.98,
      "duration_seconds": 1.88,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.2,
      "end_seconds": 263.9,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 264.56,
      "end_seconds": 273.99,
      "duration_seconds": 9.43,
      "text": "Doctor, I've got the readings for you. Pulse 77, respiratory rate 16. Temperature is 36.7 degrees, saturation 99 percent, blood pressure 111 over 71."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.62,
      "end_seconds": 275.54,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.09,
      "end_seconds": 282.02,
      "duration_seconds": 3.93,
      "text": "Okay, time for me to to examine you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 285.25,
      "duration_seconds": 2.22,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.15,
      "end_seconds": 302.0,
      "duration_seconds": 8.85,
      "text": "The eye is very red with a cloudy cornea and the pH of the tears is very high."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.89,
      "end_seconds": 308.62,
      "duration_seconds": 1.73,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.47,
      "end_seconds": 347.41,
      "duration_seconds": 27.94,
      "text": "So, based on the history and the examination, the most likely explanation is an alkali chemical burn to the eye. I'd also keep a corneal abrasion in mind. I'd like to arrange an urgent eye assessment for chemical eye injury. I'd like to arrange an urgent pH check for chemical burn. What I'm giving you is sterile saline irrigation, 2 litres, continuous, until pH neutral. That's for chemical eye burn."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.38,
      "end_seconds": 358.87,
      "duration_seconds": 10.49,
      "text": "I am washing the eye now, keep it open and do not stop. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.82,
      "end_seconds": 363.65,
      "duration_seconds": 2.83,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.36,
      "end_seconds": 365.53,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}