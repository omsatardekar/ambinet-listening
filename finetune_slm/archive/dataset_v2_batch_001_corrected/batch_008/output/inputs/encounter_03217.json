{
  "schema_version": "1.0",
  "encounter_id": "03217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.56,
      "duration_seconds": 3.02,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.31,
      "end_seconds": 8.82,
      "duration_seconds": 4.51,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.37,
      "end_seconds": 11.95,
      "duration_seconds": 2.58,
      "text": "So, I've been sweating, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.4,
      "end_seconds": 15.47,
      "duration_seconds": 2.07,
      "text": "did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.07,
      "end_seconds": 22.79,
      "duration_seconds": 5.72,
      "text": "I'd say two months actually, no, closer to six months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.46,
      "end_seconds": 27.61,
      "duration_seconds": 3.15,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.47,
      "end_seconds": 33.53,
      "duration_seconds": 5.06,
      "text": "I'd give it a a eight out of ten"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.94,
      "end_seconds": 37.9,
      "duration_seconds": 2.96,
      "text": "have you been feeling anxious and agitated?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.14,
      "end_seconds": 40.22,
      "duration_seconds": 1.08,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.37,
      "end_seconds": 42.83,
      "duration_seconds": 1.46,
      "text": "How about seizure?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.75,
      "end_seconds": 51.06,
      "duration_seconds": 2.31,
      "text": "No, none, no seizure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.11,
      "end_seconds": 56.2,
      "duration_seconds": 4.09,
      "text": "did you get seeing things, vomiting blood or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.61,
      "end_seconds": 61.7,
      "duration_seconds": 4.09,
      "text": "No, no seeing things, vomiting blood or confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.38,
      "end_seconds": 66.26,
      "duration_seconds": 3.88,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.87,
      "end_seconds": 68.96,
      "duration_seconds": 2.09,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.1,
      "end_seconds": 80.15,
      "duration_seconds": 4.05,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.09,
      "end_seconds": 84.16,
      "duration_seconds": 2.07,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.28,
      "end_seconds": 102.46,
      "duration_seconds": 1.18,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 108.72,
      "duration_seconds": 5.43,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.73,
      "end_seconds": 111.0,
      "duration_seconds": 1.27,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.65,
      "end_seconds": 113.96,
      "duration_seconds": 2.31,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.63,
      "end_seconds": 116.97,
      "duration_seconds": 1.34,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.59,
      "end_seconds": 120.73,
      "duration_seconds": 3.14,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.27,
      "end_seconds": 125.23,
      "duration_seconds": 3.96,
      "text": "What does a a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.67,
      "end_seconds": 131.27,
      "duration_seconds": 3.6,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.36,
      "end_seconds": 145.56,
      "duration_seconds": 2.2,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.31,
      "end_seconds": 150.25,
      "duration_seconds": 2.94,
      "text": "No nothing at the the moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.76,
      "end_seconds": 167.91,
      "duration_seconds": 3.15,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.54,
      "end_seconds": 180.0,
      "duration_seconds": 3.46,
      "text": "right, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 203.24,
      "duration_seconds": 9.61,
      "text": "Okay: temperature 37.0, respiratory rate 19, weight 70 kilos, pulse 122, height 167 centimetres, pressure 137 over 75, saturation 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.29,
      "end_seconds": 209.07,
      "duration_seconds": 3.78,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.54,
      "end_seconds": 213.3,
      "duration_seconds": 2.76,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.86,
      "end_seconds": 228.83,
      "duration_seconds": 4.97,
      "text": "you have a coarse tremor, a fast pulse and you are sweating"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.41,
      "end_seconds": 240.71,
      "duration_seconds": 8.3,
      "text": "Good, you can sit up again. Putting it all together, the most likely explanation is alcohol withdrawal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.73,
      "end_seconds": 244.44,
      "duration_seconds": 2.71,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.02,
      "end_seconds": 264.24,
      "duration_seconds": 18.22,
      "text": "It's reasonable to to be concerned, but right now alcohol withdrawal is my leading thought, not anything worse. I'm going to order blood tests, for alcohol withdrawal. I'm prescribing thiamine, 100 milligrams, three times a day, long term. That's for alcohol-related deficiency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.68,
      "end_seconds": 269.92,
      "duration_seconds": 1.24,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.35,
      "end_seconds": 287.38,
      "duration_seconds": 16.03,
      "text": "Do not stop alcohol suddenly without medical support. I'd like you to see the alcohol liaison service as well and I'll write the referral. If the symptoms get worse that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.4,
      "end_seconds": 291.52,
      "duration_seconds": 3.12,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.41,
      "end_seconds": 295.37,
      "duration_seconds": 1.96,
      "text": "Come back in two days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.37,
      "end_seconds": 299.37,
      "duration_seconds": 2.0,
      "text": "that's fine with me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.4,
      "end_seconds": 304.93,
      "duration_seconds": 3.53,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.58,
      "end_seconds": 308.45,
      "duration_seconds": 1.87,
      "text": "thank you that's helpful"
    }
  ]
}