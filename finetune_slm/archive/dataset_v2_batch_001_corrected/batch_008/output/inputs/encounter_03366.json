{
  "schema_version": "1.0",
  "encounter_id": "03366",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 7.71,
      "duration_seconds": 7.09,
      "text": "Mm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.24,
      "end_seconds": 13.05,
      "duration_seconds": 4.81,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.16,
      "end_seconds": 19.51,
      "duration_seconds": 5.35,
      "text": "I've been dealing with hearing getting worse in both ears."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 28.82,
      "duration_seconds": 3.53,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.48,
      "end_seconds": 35.09,
      "duration_seconds": 4.61,
      "text": "Around one week... no wait, it's more like two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 40.05,
      "duration_seconds": 3.49,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.76,
      "end_seconds": 50.14,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.92,
      "end_seconds": 76.33,
      "duration_seconds": 9.41,
      "text": "Okay: temperature 36.9, SpO2 98 percent on room air, BP is 116 over 71, respiratory rate 14, heart rate 79."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.18,
      "end_seconds": 79.83,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.46,
      "end_seconds": 90.12,
      "duration_seconds": 6.66,
      "text": "I'll come back to the numbers. Did you get vertigo, discharge, facial weakness or ear pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.16,
      "end_seconds": 98.64,
      "duration_seconds": 6.48,
      "text": "no vertigo, discharge, facial weakness or ear pain, none of it it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.52,
      "end_seconds": 102.05,
      "duration_seconds": 2.53,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.5,
      "end_seconds": 107.05,
      "duration_seconds": 3.55,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.99,
      "end_seconds": 128.52,
      "duration_seconds": 2.53,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.7,
      "end_seconds": 133.3,
      "duration_seconds": 3.6,
      "text": "Yeah, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.51,
      "end_seconds": 138.43,
      "duration_seconds": 3.92,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.39,
      "end_seconds": 142.25,
      "duration_seconds": 2.86,
      "text": "No, um, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 161.16,
      "duration_seconds": 2.7,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.24,
      "end_seconds": 166.32,
      "duration_seconds": 4.08,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.93,
      "end_seconds": 168.98,
      "duration_seconds": 2.05,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.0,
      "end_seconds": 176.06,
      "duration_seconds": 6.06,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.89,
      "end_seconds": 178.79,
      "duration_seconds": 1.9,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.47,
      "end_seconds": 183.17,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.02,
      "end_seconds": 195.13,
      "duration_seconds": 4.11,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.08,
      "end_seconds": 197.94,
      "duration_seconds": 1.86,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.21,
      "end_seconds": 213.96,
      "duration_seconds": 2.75,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.49,
      "end_seconds": 217.74,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.49,
      "end_seconds": 224.66,
      "duration_seconds": 6.17,
      "text": "Going by what you've described, it points towards a conductive hearing loss, possibly otosclerosis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.87,
      "end_seconds": 228.91,
      "duration_seconds": 3.04,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 244.89,
      "duration_seconds": 15.03,
      "text": "I understand the worry. At the moment I'd say it's a conductive hearing loss, possibly otosclerosis, and we'll know more once the a hearing test is back. I'd like to arrange a hearing test for hearing loss."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.39,
      "end_seconds": 250.81,
      "duration_seconds": 1.42,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.6,
      "end_seconds": 286.29,
      "duration_seconds": 30.69,
      "text": "Let's get a CT scan of the ears, for possible otosclerosis. A hearing aid or an operation are both options after the tests. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please don't wait if the symptoms get worse. That's when to be seen urgently. Book a review after the tests."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.32,
      "end_seconds": 291.64,
      "duration_seconds": 3.32,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.37,
      "end_seconds": 294.78,
      "duration_seconds": 2.41,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.64,
      "end_seconds": 297.31,
      "duration_seconds": 1.67,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.69,
      "end_seconds": 300.16,
      "duration_seconds": 1.47,
      "text": "Take care now."
    }
  ]
}