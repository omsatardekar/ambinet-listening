{
  "schema_version": "1.0",
  "encounter_id": "03172",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 2.9,
      "duration_seconds": 1.79,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.94,
      "end_seconds": 9.24,
      "duration_seconds": 5.3,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.12,
      "end_seconds": 17.41,
      "duration_seconds": 6.29,
      "text": "Um, so... a sudden severe tummy pain. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.87,
      "end_seconds": 21.21,
      "duration_seconds": 2.34,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.63,
      "end_seconds": 36.41,
      "duration_seconds": 2.78,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.91,
      "end_seconds": 60.31,
      "duration_seconds": 11.4,
      "text": "Okay: oxygen saturation is 99 percent, respiratory rate 20, blood pressure 130 over 78. And pulse 115, temperature is 37.1 degrees. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.18,
      "end_seconds": 64.87,
      "duration_seconds": 3.69,
      "text": "I've had it it for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.22,
      "end_seconds": 76.46,
      "duration_seconds": 10.24,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.83,
      "end_seconds": 89.26,
      "duration_seconds": 11.43,
      "text": "Yes, movement. That makes it worse. It settles a little with lying still. Oh, and vomiting. With vomiting, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.57,
      "end_seconds": 95.43,
      "duration_seconds": 4.86,
      "text": "Any blood in the vomit, fever or diarrhoea at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.06,
      "end_seconds": 100.03,
      "duration_seconds": 2.97,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.07,
      "end_seconds": 104.64,
      "duration_seconds": 2.57,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.95,
      "end_seconds": 109.45,
      "duration_seconds": 3.5,
      "text": "Erm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.51,
      "end_seconds": 129.57,
      "duration_seconds": 4.06,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.33,
      "end_seconds": 142.36,
      "duration_seconds": 8.03,
      "text": "I was told I'm allergic to naproxen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.32,
      "end_seconds": 158.13,
      "duration_seconds": 3.81,
      "text": "A A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.87,
      "end_seconds": 175.64,
      "duration_seconds": 15.77,
      "text": "I only drink at family occasions. I smoke roughly a pack every two days. No, I share a house with my brother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.0,
      "end_seconds": 180.52,
      "duration_seconds": 3.52,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.14,
      "end_seconds": 184.44,
      "duration_seconds": 2.3,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.49,
      "end_seconds": 206.23,
      "duration_seconds": 4.74,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.27,
      "end_seconds": 212.58,
      "duration_seconds": 5.31,
      "text": "It's, It's ibuprofen, 600 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 215.81,
      "duration_seconds": 2.02,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.85,
      "end_seconds": 219.21,
      "duration_seconds": 2.36,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.23,
      "end_seconds": 233.03,
      "duration_seconds": 6.8,
      "text": "Your tummy is rigid like a board and very tender everywhere, and you are lying completely still."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.75,
      "end_seconds": 245.11,
      "duration_seconds": 7.36,
      "text": "You can relax now. Having listened and examined, I'd lean towards a perforated stomach ulcer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.51,
      "end_seconds": 252.69,
      "duration_seconds": 2.18,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.27,
      "end_seconds": 266.51,
      "duration_seconds": 12.24,
      "text": "I understand the worry. At the moment I'd say it's a perforated stomach ulcer, and we'll know more once the an erect chest X-ray is back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.48,
      "end_seconds": 280.04,
      "duration_seconds": 5.56,
      "text": "An erect chest X-ray is what I'd like next, for possible perforation"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.46,
      "end_seconds": 283.73,
      "duration_seconds": 2.27,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.27,
      "end_seconds": 295.42,
      "duration_seconds": 10.15,
      "text": "nothing to eat or drink, you need an operation urgently. Let's plan a check straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.31,
      "end_seconds": 302.56,
      "duration_seconds": 2.25,
      "text": "thank you, doctor, goodbye"
    }
  ]
}