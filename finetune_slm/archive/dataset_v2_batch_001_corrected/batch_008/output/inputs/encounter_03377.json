{
  "schema_version": "1.0",
  "encounter_id": "03377",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.13,
      "duration_seconds": 5.43,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.29,
      "duration_seconds": 3.82,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.49,
      "end_seconds": 21.13,
      "duration_seconds": 5.64,
      "text": "doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.63,
      "end_seconds": 25.86,
      "duration_seconds": 3.23,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.41,
      "end_seconds": 36.07,
      "duration_seconds": 8.66,
      "text": "Mainly vomiting once or twice. There's a couple of other things, uh, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.02,
      "end_seconds": 41.72,
      "duration_seconds": 3.7,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.35,
      "end_seconds": 47.39,
      "duration_seconds": 4.04,
      "text": "She takes omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 62.46,
      "duration_seconds": 3.0,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.51,
      "end_seconds": 67.17,
      "duration_seconds": 2.66,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.97,
      "end_seconds": 70.76,
      "duration_seconds": 2.79,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.38,
      "end_seconds": 75.09,
      "duration_seconds": 3.71,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.92,
      "end_seconds": 78.28,
      "duration_seconds": 2.36,
      "text": "any loose stools as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.28,
      "end_seconds": 87.9,
      "duration_seconds": 8.62,
      "text": "Yeah, that too. Right, with loose stools, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.88,
      "end_seconds": 93.91,
      "duration_seconds": 5.03,
      "text": "what about a mild tummy ache, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.79,
      "end_seconds": 100.95,
      "duration_seconds": 2.16,
      "text": "Yes, since last Tuesday."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.26,
      "end_seconds": 107.95,
      "duration_seconds": 5.69,
      "text": "Have you had vomiting once or twice before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.72,
      "end_seconds": 116.22,
      "duration_seconds": 7.5,
      "text": "Uh, yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.9,
      "end_seconds": 124.86,
      "duration_seconds": 6.96,
      "text": "A few quick ones: no wet nappies, high fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.4,
      "end_seconds": 127.76,
      "duration_seconds": 2.36,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.55,
      "end_seconds": 131.42,
      "duration_seconds": 1.87,
      "text": "Any sign of drowsiness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.25,
      "end_seconds": 135.26,
      "duration_seconds": 3.01,
      "text": "No, um, none, no drowsiness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.8,
      "end_seconds": 138.85,
      "duration_seconds": 2.05,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.83,
      "end_seconds": 142.28,
      "duration_seconds": 2.45,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 148.64,
      "duration_seconds": 1.78,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.75,
      "end_seconds": 153.03,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.48,
      "end_seconds": 157.44,
      "duration_seconds": 2.96,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.27,
      "end_seconds": 164.68,
      "duration_seconds": 4.41,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.68,
      "end_seconds": 167.93,
      "duration_seconds": 2.25,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.83,
      "end_seconds": 171.26,
      "duration_seconds": 2.43,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.68,
      "end_seconds": 192.64,
      "duration_seconds": 3.96,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.59,
      "end_seconds": 198.08,
      "duration_seconds": 4.49,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 203.87,
      "duration_seconds": 3.0,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.29,
      "end_seconds": 209.56,
      "duration_seconds": 4.27,
      "text": "yes, I had a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.11,
      "end_seconds": 214.03,
      "duration_seconds": 2.92,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.71,
      "end_seconds": 217.65,
      "duration_seconds": 1.94,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.19,
      "end_seconds": 221.69,
      "duration_seconds": 2.5,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.68,
      "end_seconds": 232.73,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.24,
      "end_seconds": 249.67,
      "duration_seconds": 7.43,
      "text": "Okay: blood pressure 116 over 77, respiratory rate 16, heart rate 76, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.58,
      "end_seconds": 253.66,
      "duration_seconds": 2.08,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.59,
      "end_seconds": 261.76,
      "duration_seconds": 2.17,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.2,
      "end_seconds": 265.64,
      "duration_seconds": 2.44,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.48,
      "end_seconds": 269.94,
      "duration_seconds": 3.46,
      "text": "alright, I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.58,
      "end_seconds": 282.32,
      "duration_seconds": 4.74,
      "text": "he is alert, drinking, with moist lips and a soft tummy"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.5,
      "end_seconds": 289.14,
      "duration_seconds": 1.64,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.05,
      "end_seconds": 308.7,
      "duration_seconds": 6.65,
      "text": "Okay, so my impression is this: My working impression is a mild stomach bug."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.5,
      "end_seconds": 311.02,
      "duration_seconds": 1.52,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.34,
      "end_seconds": 331.94,
      "duration_seconds": 15.6,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. Small, frequent sips of fluid and keep him off nursery for two days after it stops"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.35,
      "end_seconds": 342.59,
      "duration_seconds": 10.24,
      "text": "ah please don't wait if he stops drinking or becomes drowsy that's when to be seen urgently that's all from me any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.46,
      "end_seconds": 346.83,
      "duration_seconds": 2.37,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.38,
      "end_seconds": 348.57,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}