{
  "schema_version": "1.0",
  "encounter_id": "03097",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 8.47,
      "duration_seconds": 7.52,
      "text": "Actually, you know, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 13.73,
      "duration_seconds": 4.21,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.73,
      "end_seconds": 20.51,
      "duration_seconds": 5.78,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.48,
      "end_seconds": 24.26,
      "duration_seconds": 2.78,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.46,
      "end_seconds": 27.09,
      "duration_seconds": 1.63,
      "text": "It's collapsing, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.27,
      "end_seconds": 30.18,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.25,
      "end_seconds": 40.71,
      "duration_seconds": 8.46,
      "text": "I've had it since Friday. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.56,
      "end_seconds": 45.83,
      "duration_seconds": 3.27,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.8,
      "end_seconds": 49.46,
      "duration_seconds": 2.66,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.48,
      "end_seconds": 56.97,
      "duration_seconds": 2.49,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.65,
      "end_seconds": 78.02,
      "duration_seconds": 19.37,
      "text": "It usually comes with vaginal spotting. Let me think, as for sudden severe pain in the lower tummy, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.24,
      "end_seconds": 79.35,
      "duration_seconds": 1.11,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.64,
      "end_seconds": 94.08,
      "duration_seconds": 1.44,
      "text": "What about vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 97.5,
      "duration_seconds": 1.6,
      "text": "No vomiting, thankfully."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.03,
      "end_seconds": 101.05,
      "duration_seconds": 3.02,
      "text": "A few quick ones: discharge or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.21,
      "end_seconds": 104.91,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.86,
      "end_seconds": 110.03,
      "duration_seconds": 3.17,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.11,
      "end_seconds": 114.02,
      "duration_seconds": 1.91,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.73,
      "end_seconds": 118.02,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.77,
      "end_seconds": 124.78,
      "duration_seconds": 6.01,
      "text": "Hmm, my grandmother had dementia. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.17,
      "end_seconds": 128.3,
      "duration_seconds": 2.13,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 130.31,
      "end_seconds": 140.38,
      "duration_seconds": 10.07,
      "text": "Um, she is on aspirin, 75 milligrams, once a day for my heart, I give it to her."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 145.02,
      "duration_seconds": 3.12,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 146.41,
      "end_seconds": 153.36,
      "duration_seconds": 6.95,
      "text": "For six months. Yeah, she takes metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.12,
      "end_seconds": 157.42,
      "duration_seconds": 3.3,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.09,
      "end_seconds": 164.74,
      "duration_seconds": 3.65,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.38,
      "end_seconds": 169.73,
      "duration_seconds": 3.35,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.74,
      "end_seconds": 174.87,
      "duration_seconds": 4.13,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.7,
      "end_seconds": 177.92,
      "duration_seconds": 2.22,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.01,
      "end_seconds": 184.7,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.08,
      "end_seconds": 188.05,
      "duration_seconds": 1.97,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.96,
      "end_seconds": 193.1,
      "duration_seconds": 4.14,
      "text": "I've, I've had heart disease for five years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.11,
      "end_seconds": 195.81,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.37,
      "end_seconds": 202.8,
      "duration_seconds": 2.43,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.53,
      "end_seconds": 209.03,
      "duration_seconds": 4.5,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.94,
      "end_seconds": 223.22,
      "duration_seconds": 10.28,
      "text": "I think I reacted to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.92,
      "end_seconds": 228.4,
      "duration_seconds": 2.48,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.05,
      "end_seconds": 231.32,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.81,
      "end_seconds": 248.35,
      "duration_seconds": 7.54,
      "text": "You are pale and clammy with a rigid, tender tummy and a very low blood pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.65,
      "end_seconds": 253.77,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.55,
      "end_seconds": 277.38,
      "duration_seconds": 13.83,
      "text": "Putting it all together, it fits best with a ruptured ectopic pregnancy. I want to be honest that this is an impression, not a final answer. We shouldn't forget a ruptured ovarian cyst."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.74,
      "end_seconds": 281.43,
      "duration_seconds": 2.69,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.18,
      "end_seconds": 291.91,
      "duration_seconds": 8.73,
      "text": "I can't promise yet, but most people with a ruptured ectopic pregnancy do well once it's treated properly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.76,
      "end_seconds": 327.77,
      "duration_seconds": 21.01,
      "text": "Let's get a pregnancy test, for collapse. I think urgent blood tests makes sense here, for internal bleeding. I'd rather check than guess, and this is the quickest way to know more. I am calling the emergency team, you need an operation now. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.66,
      "end_seconds": 331.05,
      "duration_seconds": 2.39,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.67,
      "end_seconds": 339.28,
      "duration_seconds": 6.61,
      "text": "I'd like you back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.28,
      "end_seconds": 341.85,
      "duration_seconds": 1.57,
      "text": "That's clear, thanks."
    }
  ]
}