{
  "schema_version": "1.0",
  "encounter_id": "03429",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 4.32,
      "duration_seconds": 3.72,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 9.89,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.55,
      "end_seconds": 20.1,
      "duration_seconds": 9.55,
      "text": "Mainly being found cold and drowsy. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.06,
      "end_seconds": 24.27,
      "duration_seconds": 3.21,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.95,
      "end_seconds": 42.11,
      "duration_seconds": 13.16,
      "text": "It's severe, honestly. I've also had shivering that has stopped, since yesterday. I've also had slurred speech, for two weeks. I had confusion before. That's settled now, though."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.1,
      "end_seconds": 61.12,
      "duration_seconds": 3.02,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 73.06,
      "duration_seconds": 2.92,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.31,
      "end_seconds": 105.64,
      "duration_seconds": 13.33,
      "text": "Okay: weight 90 kilos, pulse 82, respiratory rate 14, BMI works out to 40.0, temperature 36.5, blood pressure 116 over 71, height 150 centimetres."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.69,
      "end_seconds": 112.32,
      "duration_seconds": 4.63,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.62,
      "end_seconds": 115.94,
      "duration_seconds": 2.32,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.7,
      "end_seconds": 130.34,
      "duration_seconds": 6.64,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.2,
      "end_seconds": 137.35,
      "duration_seconds": 2.15,
      "text": "Okay, that's the examination finished."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 157.87,
      "duration_seconds": 3.4,
      "text": "have you noticed head injury, alcohol or fall?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.91,
      "end_seconds": 169.2,
      "duration_seconds": 5.29,
      "text": "no head injury, alcohol or fall, none of it"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.83,
      "end_seconds": 173.18,
      "duration_seconds": 2.35,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 175.93,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.88,
      "end_seconds": 180.0,
      "duration_seconds": 2.12,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.94,
      "end_seconds": 182.95,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.51,
      "end_seconds": 185.78,
      "duration_seconds": 1.27,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.07,
      "end_seconds": 190.05,
      "duration_seconds": 2.98,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.27,
      "end_seconds": 198.3,
      "duration_seconds": 3.03,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.84,
      "end_seconds": 201.74,
      "duration_seconds": 1.9,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.8,
      "end_seconds": 221.09,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.61,
      "end_seconds": 224.99,
      "duration_seconds": 3.38,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.68,
      "end_seconds": 227.93,
      "duration_seconds": 1.25,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.23,
      "end_seconds": 237.1,
      "duration_seconds": 3.87,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 240.56,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.32,
      "end_seconds": 249.67,
      "duration_seconds": 4.35,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.42,
      "end_seconds": 255.72,
      "duration_seconds": 5.3,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.64,
      "end_seconds": 259.0,
      "duration_seconds": 2.36,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.55,
      "end_seconds": 262.99,
      "duration_seconds": 2.44,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.32,
      "end_seconds": 269.1,
      "duration_seconds": 4.78,
      "text": "I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.95,
      "end_seconds": 274.35,
      "duration_seconds": 4.4,
      "text": "Ah. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.18,
      "end_seconds": 281.45,
      "duration_seconds": 6.27,
      "text": "I take something called vals... valsartan, 80 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.27,
      "end_seconds": 286.19,
      "duration_seconds": 3.92,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.56,
      "end_seconds": 289.65,
      "duration_seconds": 2.09,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.16,
      "end_seconds": 302.83,
      "duration_seconds": 11.67,
      "text": "So where does that leave us? My working impression is severe hypothermia. That's my thinking for now, and it may change as we learn more. Hypoglycaemia is still possible."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.94,
      "end_seconds": 307.07,
      "duration_seconds": 3.13,
      "text": "Is this serious, um, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.01,
      "end_seconds": 329.39,
      "duration_seconds": 21.38,
      "text": "it's reasonable to be concerned, but right now severe hypothermia is my leading thought, not anything worse let's get an ECG, for bradycardia i think a blood sugar makes sense here, for hypothermia the result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.96,
      "end_seconds": 332.35,
      "duration_seconds": 1.39,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.39,
      "end_seconds": 346.34,
      "duration_seconds": 11.95,
      "text": "Let's get blood tests, for hypothermia. Handle gently and warm slowly with warm blankets and warm fluids through the drip. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.97,
      "end_seconds": 349.74,
      "duration_seconds": 2.77,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.72,
      "end_seconds": 359.03,
      "duration_seconds": 8.31,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.78,
      "end_seconds": 361.29,
      "duration_seconds": 1.51,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.64,
      "end_seconds": 373.66,
      "duration_seconds": 11.02,
      "text": "if the symptoms get worse, or you feel really unwell, please come to the emergency department please come and see me straight away"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.7,
      "end_seconds": 376.4,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.54,
      "end_seconds": 381.53,
      "duration_seconds": 3.99,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.25,
      "end_seconds": 386.05,
      "duration_seconds": 3.8,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.59,
      "end_seconds": 391.88,
      "duration_seconds": 1.29,
      "text": "See you soon."
    }
  ]
}