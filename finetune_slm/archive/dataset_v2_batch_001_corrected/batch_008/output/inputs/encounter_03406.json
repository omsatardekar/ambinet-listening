{
  "schema_version": "1.0",
  "encounter_id": "03406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 2.45,
      "duration_seconds": 1.6,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.36,
      "end_seconds": 7.38,
      "duration_seconds": 3.02,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.96,
      "end_seconds": 10.68,
      "duration_seconds": 1.72,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.25,
      "end_seconds": 17.29,
      "duration_seconds": 4.04,
      "text": "I'm here because of vomiting once or twice."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 20.1,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.84,
      "end_seconds": 25.89,
      "duration_seconds": 4.05,
      "text": "yeah, ever since... since last night, really"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.28,
      "end_seconds": 30.86,
      "duration_seconds": 3.58,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.21,
      "end_seconds": 45.24,
      "duration_seconds": 13.03,
      "text": "Ah, only sips of fluid, and it's not much. I've had a mild tummy ache too, um, for six months. With mild tummy ache, I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.1,
      "end_seconds": 63.94,
      "duration_seconds": 6.84,
      "text": "Any high fever, drowsiness, blood in the stool or no wet nappies at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.37,
      "end_seconds": 68.72,
      "duration_seconds": 2.35,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.15,
      "end_seconds": 72.54,
      "duration_seconds": 2.39,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.35,
      "end_seconds": 75.26,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.08,
      "end_seconds": 82.75,
      "duration_seconds": 4.67,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 86.29,
      "duration_seconds": 1.94,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.88,
      "end_seconds": 102.13,
      "duration_seconds": 3.25,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.01,
      "end_seconds": 113.85,
      "duration_seconds": 10.84,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety. I thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 119.74,
      "duration_seconds": 3.99,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.08,
      "end_seconds": 134.4,
      "duration_seconds": 13.32,
      "text": "No, I share a house with my brother. Not much, I mostly stay in these days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.84,
      "end_seconds": 150.35,
      "duration_seconds": 2.51,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.28,
      "end_seconds": 159.09,
      "duration_seconds": 6.81,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.96,
      "end_seconds": 165.14,
      "duration_seconds": 4.18,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.16,
      "end_seconds": 178.43,
      "duration_seconds": 11.27,
      "text": "yes, anxiety. A neighbour of mine said I should see someone about it. It's a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.08,
      "end_seconds": 189.4,
      "duration_seconds": 10.32,
      "text": "Mm-hmm. Yes, anxiety is known to us, good to have that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.59,
      "end_seconds": 194.71,
      "duration_seconds": 4.12,
      "text": "Ah, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.65,
      "end_seconds": 199.63,
      "duration_seconds": 3.98,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.3,
      "end_seconds": 214.63,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 238.66,
      "duration_seconds": 8.85,
      "text": "Okay: temperature 36.7, respiratory rate 14, pressure 119 over 82. And pulse 65, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.47,
      "end_seconds": 242.82,
      "duration_seconds": 1.35,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.91,
      "end_seconds": 246.35,
      "duration_seconds": 2.44,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.68,
      "end_seconds": 251.14,
      "duration_seconds": 2.46,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.42,
      "end_seconds": 254.09,
      "duration_seconds": 1.67,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.24,
      "end_seconds": 258.18,
      "duration_seconds": 2.94,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.14,
      "end_seconds": 278.13,
      "duration_seconds": 4.99,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.55,
      "end_seconds": 293.05,
      "duration_seconds": 9.5,
      "text": "Good, you can sit up again. Taking everything into account, I think we're dealing with a mild stomach bug at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.49,
      "end_seconds": 297.68,
      "duration_seconds": 3.19,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.73,
      "end_seconds": 308.61,
      "duration_seconds": 9.88,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.91,
      "end_seconds": 333.4,
      "duration_seconds": 6.49,
      "text": "Small, frequent sips of fluid and keep him off nursery for two days after it stops."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.73,
      "end_seconds": 340.52,
      "duration_seconds": 6.79,
      "text": "Okay, go on. We'll catch up if he is not drinking. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.08,
      "end_seconds": 345.23,
      "duration_seconds": 4.15,
      "text": "Uh, good, thanks, I'll see you then."
    }
  ]
}