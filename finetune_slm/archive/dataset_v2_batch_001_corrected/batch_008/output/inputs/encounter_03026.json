{
  "schema_version": "1.0",
  "encounter_id": "03026",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.97,
      "duration_seconds": 4.68,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.85,
      "end_seconds": 14.5,
      "duration_seconds": 3.65,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.0,
      "end_seconds": 20.69,
      "duration_seconds": 5.69,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.28,
      "end_seconds": 24.65,
      "duration_seconds": 3.37,
      "text": "So, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.35,
      "end_seconds": 30.9,
      "duration_seconds": 4.55,
      "text": "I've been dealing with taking painkillers every day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.56,
      "end_seconds": 39.4,
      "duration_seconds": 3.84,
      "text": "So, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.44,
      "end_seconds": 47.36,
      "duration_seconds": 5.92,
      "text": "Let me think, um, I've had it for three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 57.58,
      "duration_seconds": 9.16,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.63,
      "end_seconds": 66.59,
      "duration_seconds": 7.96,
      "text": "I'd give it a six, out of ten. It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.18,
      "end_seconds": 71.07,
      "duration_seconds": 2.89,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.68,
      "end_seconds": 79.08,
      "duration_seconds": 7.4,
      "text": "Um, when it starts I tend to get light sensitivity as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.66,
      "end_seconds": 91.02,
      "duration_seconds": 2.36,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.94,
      "end_seconds": 102.42,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.75,
      "end_seconds": 132.18,
      "duration_seconds": 9.43,
      "text": "Okay: pressure 115 over 69, temp 36.4 degrees, pulse is 65 beats a minute. And respiratory rate 18."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.69,
      "end_seconds": 134.19,
      "duration_seconds": 1.5,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.68,
      "end_seconds": 138.05,
      "duration_seconds": 2.37,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 144.9,
      "duration_seconds": 5.31,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.78,
      "end_seconds": 158.48,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.64,
      "end_seconds": 160.86,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.66,
      "end_seconds": 180.08,
      "duration_seconds": 2.42,
      "text": "Your neurological examination is normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.95,
      "end_seconds": 190.37,
      "duration_seconds": 5.42,
      "text": "You can sit up now. Any stiff neck or fever at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.86,
      "end_seconds": 196.79,
      "duration_seconds": 4.93,
      "text": "No stiff neck or fever, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.02,
      "end_seconds": 200.5,
      "duration_seconds": 3.48,
      "text": "Mm-hmm. Any visual changes or weakness at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.69,
      "end_seconds": 205.1,
      "duration_seconds": 3.41,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.16,
      "end_seconds": 208.62,
      "duration_seconds": 2.46,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.01,
      "end_seconds": 213.82,
      "duration_seconds": 3.81,
      "text": "Let me think, no, joints are fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.7,
      "end_seconds": 217.39,
      "duration_seconds": 2.69,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.22,
      "end_seconds": 219.78,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.01,
      "end_seconds": 226.17,
      "duration_seconds": 3.16,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.94,
      "end_seconds": 229.0,
      "duration_seconds": 2.06,
      "text": "Migraines, for five years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.93,
      "end_seconds": 230.74,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 250.96,
      "duration_seconds": 3.81,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.72,
      "end_seconds": 255.67,
      "duration_seconds": 2.95,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.11,
      "end_seconds": 258.42,
      "duration_seconds": 1.31,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.47,
      "end_seconds": 264.38,
      "duration_seconds": 3.91,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.56,
      "end_seconds": 266.79,
      "duration_seconds": 1.23,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.83,
      "end_seconds": 271.26,
      "duration_seconds": 3.43,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.01,
      "end_seconds": 275.22,
      "duration_seconds": 2.21,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.14,
      "end_seconds": 282.69,
      "duration_seconds": 6.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.18,
      "end_seconds": 285.59,
      "duration_seconds": 1.41,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.47,
      "end_seconds": 290.76,
      "duration_seconds": 4.29,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.58,
      "end_seconds": 295.14,
      "duration_seconds": 3.56,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.28,
      "end_seconds": 301.96,
      "duration_seconds": 5.68,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.74,
      "end_seconds": 308.75,
      "duration_seconds": 5.01,
      "text": "So, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.77,
      "end_seconds": 317.9,
      "duration_seconds": 7.13,
      "text": "Okay, so I'm on sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 319.11,
      "end_seconds": 328.3,
      "duration_seconds": 9.19,
      "text": "Well, um, she is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.49,
      "end_seconds": 356.62,
      "duration_seconds": 27.13,
      "text": "From what you've told me and what I found, the most likely explanation is medication-overuse headache on a background of migraine. I want to be honest that this is an impression, not a final answer. Tension-type headache is still possible. Let's get a headache diary, for daily headache. I'll start you on amitriptyline, 10 milligrams, at night, long term. It's for headache prevention."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.4,
      "end_seconds": 362.84,
      "duration_seconds": 5.44,
      "text": "Mm, um, should I take that with food?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.47,
      "end_seconds": 380.26,
      "duration_seconds": 16.79,
      "text": "Stop the daily painkillers gradually, the headaches may worsen for a couple of weeks first. Come back or go to emergency straight away if the symptoms get worse. Book a review in six weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.1,
      "end_seconds": 384.51,
      "duration_seconds": 3.41,
      "text": "Uh, good, I'll return then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.84,
      "end_seconds": 393.27,
      "duration_seconds": 5.43,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.43,
      "end_seconds": 405.17,
      "duration_seconds": 10.74,
      "text": "So, you know, I take the amitriptyline, 10 milligrams, at night and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.82,
      "end_seconds": 410.63,
      "duration_seconds": 3.81,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.47,
      "end_seconds": 415.64,
      "duration_seconds": 4.17,
      "text": "Um, um, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.75,
      "end_seconds": 420.8,
      "duration_seconds": 2.05,
      "text": "So, all the best."
    }
  ]
}