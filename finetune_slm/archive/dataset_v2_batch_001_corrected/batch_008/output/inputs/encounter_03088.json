{
  "schema_version": "1.0",
  "encounter_id": "03088",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 5.2,
      "duration_seconds": 3.97,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.62,
      "end_seconds": 10.75,
      "duration_seconds": 4.13,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.41,
      "end_seconds": 18.65,
      "duration_seconds": 6.24,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.44,
      "end_seconds": 23.37,
      "duration_seconds": 3.93,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.12,
      "end_seconds": 32.03,
      "duration_seconds": 7.91,
      "text": "It's being found cold and drowsy, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.27,
      "end_seconds": 39.31,
      "duration_seconds": 6.04,
      "text": "What do you take on a normal day? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.02,
      "end_seconds": 47.22,
      "duration_seconds": 6.2,
      "text": "She is on hydrocortisone cream, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.59,
      "end_seconds": 48.63,
      "duration_seconds": 1.04,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 62.6,
      "duration_seconds": 3.14,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.58,
      "end_seconds": 68.53,
      "duration_seconds": 3.95,
      "text": "It's, It's been going on for two months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.93,
      "end_seconds": 71.56,
      "duration_seconds": 2.63,
      "text": "Yes. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.26,
      "end_seconds": 76.43,
      "duration_seconds": 4.17,
      "text": "Confusion goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.71,
      "end_seconds": 79.88,
      "duration_seconds": 2.17,
      "text": "Have you had slurred speech?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.69,
      "end_seconds": 86.56,
      "duration_seconds": 4.87,
      "text": "Yes, since yesterday. The confusion? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.18,
      "end_seconds": 106.68,
      "duration_seconds": 4.5,
      "text": "Let me check a few things. Any fall or alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.68,
      "end_seconds": 109.82,
      "duration_seconds": 2.14,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.61,
      "end_seconds": 114.43,
      "duration_seconds": 3.82,
      "text": "Have you had head injury, by any chance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.43,
      "end_seconds": 120.37,
      "duration_seconds": 3.94,
      "text": "Not at all, um, no head injury."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.77,
      "end_seconds": 124.16,
      "duration_seconds": 2.39,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.65,
      "end_seconds": 127.69,
      "duration_seconds": 2.04,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.21,
      "end_seconds": 133.77,
      "duration_seconds": 4.56,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.33,
      "end_seconds": 137.42,
      "duration_seconds": 2.09,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.02,
      "end_seconds": 143.4,
      "duration_seconds": 4.38,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.25,
      "end_seconds": 148.58,
      "duration_seconds": 3.33,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.21,
      "end_seconds": 152.88,
      "duration_seconds": 2.67,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.82,
      "end_seconds": 156.8,
      "duration_seconds": 2.98,
      "text": "I have eczema, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.41,
      "end_seconds": 167.36,
      "duration_seconds": 9.95,
      "text": "I follow. Right, so eczema is already on your record. We'll keep that in mind today. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.97,
      "end_seconds": 173.86,
      "duration_seconds": 4.89,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.67,
      "end_seconds": 177.29,
      "duration_seconds": 1.62,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 181.78,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.06,
      "end_seconds": 184.29,
      "duration_seconds": 1.23,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.44,
      "end_seconds": 189.95,
      "duration_seconds": 4.51,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.79,
      "end_seconds": 194.46,
      "duration_seconds": 3.67,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.49,
      "end_seconds": 199.14,
      "duration_seconds": 3.65,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.24,
      "end_seconds": 202.93,
      "duration_seconds": 2.69,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 217.26,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.81,
      "end_seconds": 236.6,
      "duration_seconds": 6.79,
      "text": "Okay: pulse 70, SpO2 99 percent on room air, BP is 124 over 69."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.6,
      "end_seconds": 243.69,
      "duration_seconds": 4.09,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.93,
      "end_seconds": 247.19,
      "duration_seconds": 2.26,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.12,
      "end_seconds": 266.39,
      "duration_seconds": 7.27,
      "text": "Your temperature is twenty-nine degrees, your skin is ice cold and your pulse is very slow."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.16,
      "end_seconds": 271.64,
      "duration_seconds": 2.48,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.59,
      "end_seconds": 297.56,
      "duration_seconds": 15.97,
      "text": "From what you've told me and what I found, it points towards severe hypothermia. Handle gently and warm slowly with warm blankets and warm fluids through the drip. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.7,
      "end_seconds": 303.6,
      "duration_seconds": 2.9,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.39,
      "end_seconds": 307.25,
      "duration_seconds": 1.86,
      "text": "Okay, see you soon."
    }
  ]
}