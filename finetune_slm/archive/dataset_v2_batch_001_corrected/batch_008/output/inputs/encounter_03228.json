    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 37.36,
      "duration_seconds": 15.0,
      "text": "ever since... since yesterday, really i'm hoping you can tell me something definite i kept putting it off, which I know isn't sensible oh, and crusting"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 38.81,
      "end_seconds": 49.67,
      "duration_seconds": 10.86,
      "text": "Here are the numbers, doctor. Temperature is 36.4 degrees, pulse is 80 beats a minute, SpO2 99 percent on room air, pressure 115 over 76."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.48,
      "end_seconds": 51.18,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.86,
      "end_seconds": 57.42,
      "duration_seconds": 3.56,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.71,
      "end_seconds": 60.18,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.11,
      "end_seconds": 75.66,
      "duration_seconds": 7.55,
      "text": "There is a pearly nodule with fine surface vessels and a central dip on the side of the nose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.03,
      "end_seconds": 82.68,
      "duration_seconds": 2.65,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.37,
      "end_seconds": 99.83,
      "duration_seconds": 1.46,
      "text": "any swollen glands?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.69,
      "end_seconds": 105.05,
      "duration_seconds": 3.36,
      "text": "Not that I've noticed, no swollen glands."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 112.28,
      "duration_seconds": 5.9,
      "text": "have you noticed family history of skin cancer, pain or other new lumps?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.48,
      "end_seconds": 120.05,
      "duration_seconds": 6.57,
      "text": "no family history of skin cancer, pain or other new lumps, none of it"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.67,
      "end_seconds": 122.98,
      "duration_seconds": 1.31,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.33,
      "end_seconds": 125.77,
      "duration_seconds": 1.44,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.23,
      "end_seconds": 147.46,
      "duration_seconds": 4.23,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.27,
      "end_seconds": 154.91,
      "duration_seconds": 5.64,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.76,
      "end_seconds": 159.67,
      "duration_seconds": 2.91,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.62,
      "end_seconds": 166.64,
      "duration_seconds": 6.02,
      "text": "just a mole taken off my arm, a few years ago"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.79,
      "end_seconds": 177.13,
      "duration_seconds": 3.34,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.48,
      "end_seconds": 186.24,
      "duration_seconds": 7.76,
      "text": "Sertraline, 50 milligrams, once a day. I take carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.87,
      "end_seconds": 190.2,
      "duration_seconds": 3.33,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.95,
      "end_seconds": 192.83,
      "duration_seconds": 1.88,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.97,
      "end_seconds": 196.64,
      "duration_seconds": 2.67,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.66,
      "end_seconds": 202.61,
      "duration_seconds": 4.95,
      "text": "I have depression, for about a year. I have epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 213.65,
      "duration_seconds": 8.96,
      "text": "Okay, I can see epilepsy in your file as well. Right, a a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 226.4,
      "duration_seconds": 11.92,
      "text": "I work in accounts at a hospital. No, I share a house with my brother. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.82,
      "end_seconds": 239.7,
      "duration_seconds": 8.88,
      "text": "having listened and examined, my working impression is a likely basal cell carcinoma another possibility is a squamous cell carcinoma"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.55,
      "end_seconds": 243.82,
      "duration_seconds": 3.27,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.94,
      "end_seconds": 267.12,
      "duration_seconds": 18.18,
      "text": "It's reasonable to be concerned, but right now a likely basal cell carcinoma is my leading thought, not anything worse. Let's book a dermoscopy to look into suspicious lesion. Let's get a skin biopsy, for suspicious lesion."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.0,
      "end_seconds": 270.95,
      "duration_seconds": 1.95,
      "text": "does it it hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.89,
      "end_seconds": 291.49,
      "duration_seconds": 16.6,
      "text": "please use a high-factor sunscreen and a hat. I think the skin cancer clinic should see you too. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check after the biopsy"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.64,
      "end_seconds": 293.34,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.59,
      "end_seconds": 301.61,
      "duration_seconds": 7.02,
      "text": "Okay, can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.29,
      "end_seconds": 307.32,
      "duration_seconds": 5.03,
      "text": "so, I come back after the biopsy is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.93,
      "end_seconds": 314.17,
      "duration_seconds": 5.24,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.86,
      "end_seconds": 317.89,
      "duration_seconds": 3.03,
      "text": "I think I understand everything. Thanks."
    },
