      "start_seconds": 1.16,
      "end_seconds": 8.17,
      "duration_seconds": 7.01,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.86,
      "end_seconds": 12.39,
      "duration_seconds": 3.53,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
