      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 18.25,
      "duration_seconds": 4.96,
      "text": "It's a pearly bump on my nose that bleeds, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.18,
      "end_seconds": 20.57,
      "duration_seconds": 1.39,
      "text": "since when exactly?"
