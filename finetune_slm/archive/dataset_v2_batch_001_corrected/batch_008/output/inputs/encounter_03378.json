{
  "schema_version": "1.0",
  "encounter_id": "03378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 6.63,
      "duration_seconds": 6.08,
      "text": "Well, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 12.87,
      "duration_seconds": 4.48,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.77,
      "end_seconds": 18.55,
      "duration_seconds": 3.78,
      "text": "It's vomiting once or twice, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.59,
      "end_seconds": 24.5,
      "duration_seconds": 3.91,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.34,
      "end_seconds": 36.14,
      "duration_seconds": 6.8,
      "text": "Okay, so around about a week... no wait, it's more like three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.56,
      "end_seconds": 45.55,
      "duration_seconds": 7.99,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.25,
      "end_seconds": 64.2,
      "duration_seconds": 17.95,
      "text": "Pretty mild, if I'm being honest. I get some relief from sips of fluid. It happens on and off. I've also had a mild tummy ache. With mild tummy ache, mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.04,
      "end_seconds": 75.62,
      "duration_seconds": 6.58,
      "text": "Let me check a few things. Any high fever or blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.23,
      "end_seconds": 79.87,
      "duration_seconds": 3.64,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.29,
      "end_seconds": 84.21,
      "duration_seconds": 2.92,
      "text": "Any no wet nappies or drowsiness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.96,
      "end_seconds": 88.73,
      "duration_seconds": 3.77,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.34,
      "end_seconds": 94.04,
      "duration_seconds": 3.7,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.81,
      "end_seconds": 100.12,
      "duration_seconds": 5.31,
      "text": "Ah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.93,
      "end_seconds": 102.52,
      "duration_seconds": 1.59,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.56,
      "end_seconds": 107.93,
      "duration_seconds": 3.37,
      "text": "Erm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 124.43,
      "duration_seconds": 3.41,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.19,
      "end_seconds": 131.75,
      "duration_seconds": 6.56,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.27,
      "end_seconds": 150.42,
      "duration_seconds": 3.15,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.82,
      "end_seconds": 165.12,
      "duration_seconds": 13.3,
      "text": "I'm on amlodipine, 5 milligrams, once a day. Metoprolol, 50 milligrams, twice a day. Oral rehydration solution, after each loose stool."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.8,
      "end_seconds": 167.87,
      "duration_seconds": 2.07,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.82,
      "end_seconds": 170.63,
      "duration_seconds": 1.81,
      "text": "It's 1 sachet."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.55,
      "end_seconds": 174.96,
      "duration_seconds": 2.41,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.51,
      "end_seconds": 184.08,
      "duration_seconds": 4.57,
      "text": "I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.65,
      "end_seconds": 186.48,
      "duration_seconds": 0.83,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.7,
      "end_seconds": 191.99,
      "duration_seconds": 4.29,
      "text": "An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.64,
      "end_seconds": 202.46,
      "duration_seconds": 9.82,
      "text": "Okay, I can see high blood pressure in your file as well. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.5,
      "end_seconds": 215.63,
      "duration_seconds": 11.13,
      "text": "I do a yoga class on Thursdays. I'm a plumber, lots of bending and kneeling. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.26,
      "end_seconds": 218.75,
      "duration_seconds": 2.49,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.88,
      "end_seconds": 231.48,
      "duration_seconds": 2.6,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.32,
      "end_seconds": 247.76,
      "duration_seconds": 6.44,
      "text": "Okay: pulse is 69 beats a minute, pressure 108 over 80, respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.7,
      "end_seconds": 253.51,
      "duration_seconds": 3.81,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.32,
      "end_seconds": 270.09,
      "duration_seconds": 1.77,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.26,
      "end_seconds": 273.55,
      "duration_seconds": 2.29,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.53,
      "end_seconds": 292.25,
      "duration_seconds": 4.72,
      "text": "He is alert, drinking, with moist lips and a soft tummy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 305.97,
      "duration_seconds": 9.5,
      "text": "Okay, that's enough for me. So, based on the history and the examination, it fits best with a mild stomach bug."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.74,
      "end_seconds": 311.84,
      "duration_seconds": 5.1,
      "text": "Mm, you know, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.43,
      "end_seconds": 336.04,
      "duration_seconds": 22.61,
      "text": "I understand the worry. At the moment I'd say it's a mild stomach bug, and we'll watch how it goes. Small, frequent sips of fluid and keep him off nursery for two days after it stops. I'll want another look if he is not drinking. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.12,
      "end_seconds": 341.37,
      "duration_seconds": 3.25,
      "text": "Oh, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.23,
      "end_seconds": 345.48,
      "duration_seconds": 1.25,
      "text": "See you soon."
    }
  ]
}