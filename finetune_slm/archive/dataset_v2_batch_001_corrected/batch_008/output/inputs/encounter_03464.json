{
  "schema_version": "1.0",
  "encounter_id": "03464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 6.03,
      "duration_seconds": 5.2,
      "text": "Um, uh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.1,
      "end_seconds": 13.31,
      "duration_seconds": 5.21,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.4,
      "end_seconds": 20.16,
      "duration_seconds": 5.76,
      "text": "Honestly, it's wheeze at work, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 21.21,
      "end_seconds": 29.95,
      "duration_seconds": 8.74,
      "text": "Here are the numbers, doctor. Respiratory rate 17, saturation 99 percent. Temperature 36.8, pressure 124 over 73, heart rate 80."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.56,
      "end_seconds": 34.03,
      "duration_seconds": 3.47,
      "text": "Thanks. How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.89,
      "end_seconds": 40.14,
      "duration_seconds": 4.25,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 48.78,
      "duration_seconds": 7.69,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.4,
      "end_seconds": 56.15,
      "duration_seconds": 6.75,
      "text": "Pretty mild, if I'm being honest. I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.71,
      "end_seconds": 59.78,
      "duration_seconds": 2.07,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.55,
      "end_seconds": 81.84,
      "duration_seconds": 18.29,
      "text": "It usually comes with itchy eyes at work. About itchy eyes at work, it happens a few times a day. I had a cough that eases on holiday before. That's settled now, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.43,
      "end_seconds": 88.61,
      "duration_seconds": 6.18,
      "text": "Let me check a few things. Any weight loss or coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.04,
      "end_seconds": 92.98,
      "duration_seconds": 2.94,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.3,
      "end_seconds": 99.22,
      "duration_seconds": 4.92,
      "text": "Let me check a few things. Any ankle swelling or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.15,
      "end_seconds": 105.5,
      "duration_seconds": 4.35,
      "text": "No ankle swelling or fever, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 108.74,
      "duration_seconds": 2.0,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.21,
      "end_seconds": 112.94,
      "duration_seconds": 2.73,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.94,
      "end_seconds": 118.04,
      "duration_seconds": 2.1,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.13,
      "end_seconds": 122.98,
      "duration_seconds": 2.85,
      "text": "No, um, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.5,
      "end_seconds": 128.1,
      "duration_seconds": 4.6,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.89,
      "end_seconds": 132.76,
      "duration_seconds": 3.87,
      "text": "Yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.69,
      "end_seconds": 143.23,
      "duration_seconds": 2.54,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.17,
      "end_seconds": 148.78,
      "duration_seconds": 4.61,
      "text": "Escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 150.7,
      "end_seconds": 156.09,
      "duration_seconds": 5.39,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.19,
      "end_seconds": 161.9,
      "duration_seconds": 4.71,
      "text": "Alright, hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.43,
      "end_seconds": 166.86,
      "duration_seconds": 4.43,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.42,
      "end_seconds": 172.19,
      "duration_seconds": 4.77,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.85,
      "end_seconds": 182.24,
      "duration_seconds": 9.39,
      "text": "Yes, I work in a bakery, early starts. I live with my elderly mother. I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.75,
      "end_seconds": 185.87,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.32,
      "end_seconds": 188.44,
      "duration_seconds": 1.12,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.85,
      "end_seconds": 190.55,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.79,
      "end_seconds": 193.31,
      "duration_seconds": 1.52,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.01,
      "end_seconds": 202.4,
      "duration_seconds": 7.39,
      "text": "Alright, depression and anxiety, that matches what I have here. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.52,
      "end_seconds": 207.13,
      "duration_seconds": 3.61,
      "text": "My grandmother had dementia. My son has asthma."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 211.9,
      "duration_seconds": 2.24,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.35,
      "end_seconds": 214.97,
      "duration_seconds": 1.62,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.92,
      "end_seconds": 238.03,
      "duration_seconds": 5.11,
      "text": "There is a little wheeze at the end of each breath out."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.99,
      "end_seconds": 245.1,
      "duration_seconds": 2.11,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.43,
      "end_seconds": 273.23,
      "duration_seconds": 9.8,
      "text": "Okay, so my impression is this: It's hard to say. Occupational asthma is one possibility and COPD another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.4,
      "end_seconds": 295.73,
      "duration_seconds": 7.33,
      "text": "Let's book spirometry to look into wheeze. I'm going to order serial peak flow readings, for work-related wheeze."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.51,
      "end_seconds": 297.64,
      "duration_seconds": 1.13,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.61,
      "end_seconds": 330.52,
      "duration_seconds": 31.91,
      "text": "You'll be taking beclometasone inhaler, 200 micrograms, twice a day, long term. It's for asthma. Record peak flows at work and at home for four weeks. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.8,
      "end_seconds": 333.29,
      "duration_seconds": 1.49,
      "text": "That's clear, thanks."
    }
  ]
}