    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had heart disease for nearly five years now. I've got high cholesterol. I'd rather not end up on lots of tablets if I can avoid it. Work has been very busy so I kept ignoring it.",
