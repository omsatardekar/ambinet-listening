  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yeah, it's severe back pain. I thought I'd wait, but it hasn't gone.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:34",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Okay, so the vitals from earlier. Heart rate 88, respiratory rate 21, BP is 114 over 66. Oxygen saturation is 98 percent, temp 38.3 degrees.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:46",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, noted. When was the first time you noticed it?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's been about a week now. A neighbour of mine said I should see someone about it. I kept putting it off, which I know isn't sensible.",
      "start_timestamp": "00:52",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it there all the time or does it come and go?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's, It's a few times a day.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm-hmm. Is it bearing on you a lot?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I'd say severe.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Have you had weakness in the legs?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Um, uh, yes, for three weeks.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, how much does it limit you?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:54",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:55",
      "end_timestamp": "02:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "02:03",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say.",
      "start_timestamp": "02:09",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had trouble passing urine?",
      "start_timestamp": "02:12",
