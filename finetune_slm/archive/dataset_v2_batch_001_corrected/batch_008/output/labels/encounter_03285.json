      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Erm, um, yes, that started yesterday. Uh, and there's a fever as well, six months now.",
