      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had severe back pain before, or is this the first time?",
      "start_timestamp": "02:26",
      "end_timestamp": "02:32",
      "supports": [
        "symptoms[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
