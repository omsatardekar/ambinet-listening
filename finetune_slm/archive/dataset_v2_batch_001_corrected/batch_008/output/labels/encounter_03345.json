    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm vegetarian and have been for years. Not much, I mostly stay in these days. I'm a hairdresser, on my feet all day.",
