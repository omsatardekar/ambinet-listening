  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "We came because of a sudden severe tummy pain.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Did it come on recently?",
      "start_timestamp": "00:34",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'd say about three months. Actually, no, closer to about a month. I told myself I'd wait and see, and here I am.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "How frequently does it come?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Uh, it's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "00:55",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "01:03",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I, I'd say a couple of times a week. As for shoulder tip pain, I honestly can't say when that began. It might have been last month or the month before.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay, have you had a sudden severe tummy pain before, or is this the first time?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I had a similar thing last winter. It went away.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Did you notice any fever?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Definitely no fever.",
      "start_timestamp": "01:48",
      "end_timestamp": "01:49",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay, any diarrhoea or blood in the vomit?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:57",
      "supports": [
        "symptoms[3]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No, no diarrhoea, no blood in the vomit. I did have vomiting at one point, but that went away on its own.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[3]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
