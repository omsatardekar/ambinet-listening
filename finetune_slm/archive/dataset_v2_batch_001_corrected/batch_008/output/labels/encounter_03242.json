    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, right. Yes, an enlarged prostate is known to us, good to have that clear. Tell me about your routine, work, habits, that sort of thing.",
