      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps.",
      "start_timestamp": "00:51",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It, It happens on and off. Mild, really. I took the morning off to come in today.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed anything else alongside it?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Double vision goes along with it, most of the time.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Has there been being sick too?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, three weeks.",
      "start_timestamp": "01:34",
