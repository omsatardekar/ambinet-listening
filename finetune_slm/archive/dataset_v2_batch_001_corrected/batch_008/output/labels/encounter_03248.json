    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Did it come on recently?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Erm, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many.",
