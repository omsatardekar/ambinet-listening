    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, you can get dressed. Stop me if I've got anything wrong. You've had a red sore wound after your operation for ten days, and no calf pain or breathlessness.",
