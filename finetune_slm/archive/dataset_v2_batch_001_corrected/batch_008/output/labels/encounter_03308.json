      "speaker_role": "patient",
      "transcript_text": "Correct.",
      "start_timestamp": "04:52",
      "end_timestamp": "04:53",
      "supports": [
        "symptoms[0]",
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_031",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I want blood tests done, that's for alcohol withdrawal. What I'm giving you is thiamine, 100 milligrams, three times a day, long term. You take it by mouth. It's for alcohol-related deficiency. The pharmacy will go through the details again when you pick it up. Do not stop alcohol suddenly without medical support. I'd like you to see the alcohol liaison service as well, and I'll write the referral.",
      "start_timestamp": "04:55",
      "end_timestamp": "05:24",
      "supports": [
        "medications[1]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_032",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency.",
