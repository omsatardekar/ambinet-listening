    },
    {
      "evidence_id": "EV_029",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing I've seen today points to an emergency. It looks like alcohol withdrawal, but I'd like to confirm. So, to recap quickly. You've had shaking for about three months, and no confusion or vomiting blood.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:51",
