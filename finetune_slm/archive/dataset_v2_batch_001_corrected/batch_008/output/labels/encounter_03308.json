    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, epilepsy is known to us, good to have that clear. Having listened and examined, my working impression is alcohol withdrawal.",
