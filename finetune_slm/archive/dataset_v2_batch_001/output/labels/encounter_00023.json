      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "It's reasonable to be concerned, but right now a wrist sprain, but a small fracture is possible is my leading thought, not anything worse. Let me just recap so I've got it right. You've had pain in your left wrist after a fall for one week, mild, and no pain in the elbow or deformity.",
      "start_timestamp": "04:02",
      "end_timestamp": "04:20",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
