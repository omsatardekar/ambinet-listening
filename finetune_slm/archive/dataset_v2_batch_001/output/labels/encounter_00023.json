      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yes, you've got it.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:26",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's get an X-ray of the wrist, for wrist injury. That will help us see what's going on underneath and decide the next step.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:42",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. We'll refer you to the orthopaedic clinic. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently.",
      "start_timestamp": "04:45",
