    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's get a throat swab, for sore throat. I'm prescribing azithromycin, 500 milligrams, once a day, for three days. That should help with throat infection. I'm prescribing paracetamol, 500 milligrams, every six hours if needed, for three days. That's for fever and body aches.",
      "start_timestamp": "05:47",
      "end_timestamp": "06:03",
      "supports": [
        "medications[2]",
        "medications[3]",
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Finish the whole course of antibiotics even if you feel better after two days. A short walk every day, even twenty minutes, will help more than you'd think. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I want you to come back or go to emergency straight away if you can't swallow your saliva or you have trouble breathing.",
      "start_timestamp": "06:09",
      "end_timestamp": "06:36",
      "supports": [
