      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'd give it a seven, out of ten. I'd say once or twice a day. I notice it more with standing in the sun. Only sitting in the shade, and it's not much. I thought it would sort itself out, but it hasn't. I just want to get back to normal, really.",
      "start_timestamp": "00:30",
