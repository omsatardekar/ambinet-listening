{
  "schema_version": "1.0",
  "encounter_id": "00384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 5.87,
      "duration_seconds": 4.91,
      "text": "Um, good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.35,
      "duration_seconds": 3.66,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.82,
      "end_seconds": 15.8,
      "duration_seconds": 3.98,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.63,
      "end_seconds": 20.23,
      "duration_seconds": 3.6,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.65,
      "end_seconds": 24.35,
      "duration_seconds": 2.7,
      "text": "He's been having the room spinning, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.41,
      "end_seconds": 28.3,
      "duration_seconds": 2.89,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.0,
      "end_seconds": 34.98,
      "duration_seconds": 5.98,
      "text": "It's, It's been two weeks now. Sorry, um, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.55,
      "end_seconds": 43.01,
      "duration_seconds": 7.46,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 53.75,
      "duration_seconds": 10.43,
      "text": "It settles a little with lying still. Honestly, on and off. A seven out of ten, I suppose. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.15,
      "end_seconds": 57.61,
      "duration_seconds": 2.46,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.1,
      "end_seconds": 73.94,
      "duration_seconds": 15.84,
      "text": "When it starts I tend to get a bit of vomiting as well. The bit of vomiting? That's been for three days. I've also been feeling unsteady, for three days. About feeling unsteady, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.42,
      "end_seconds": 80.49,
      "duration_seconds": 5.07,
      "text": "Let me check a few things. Any numbness in the face or hearing loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.05,
      "end_seconds": 84.47,
      "duration_seconds": 2.42,
      "text": "So, no. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.0,
      "end_seconds": 89.52,
      "duration_seconds": 4.52,
      "text": "Have you had any headache, double vision, weakness or slurred speech?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.19,
      "end_seconds": 94.99,
      "duration_seconds": 4.8,
      "text": "I haven't had headache, double vision, weakness or slurred speech, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.8,
      "end_seconds": 98.53,
      "duration_seconds": 2.73,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.31,
      "end_seconds": 101.13,
      "duration_seconds": 1.82,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.41,
      "end_seconds": 105.67,
      "duration_seconds": 2.26,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.16,
      "end_seconds": 108.85,
      "duration_seconds": 1.69,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 109.4,
      "end_seconds": 122.27,
      "duration_seconds": 12.87,
      "text": "Doctor, I've got the readings for you. Height 177 centimetres, pulse is 67 beats a minute. Weight 94 kilos, temperature is 36.7 degrees, BP is 109 over 70, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.08,
      "end_seconds": 129.3,
      "duration_seconds": 6.22,
      "text": "Good, thank you. Any long-term health problems I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 132.76,
      "duration_seconds": 1.93,
      "text": "Diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.3,
      "end_seconds": 134.59,
      "duration_seconds": 1.29,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.48,
      "end_seconds": 137.8,
      "duration_seconds": 2.32,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.47,
      "end_seconds": 139.44,
      "duration_seconds": 0.97,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.97,
      "end_seconds": 149.29,
      "duration_seconds": 9.32,
      "text": "I've had anxiety, yes. I told myself I'd wait and see, and here I am. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.41,
      "end_seconds": 158.22,
      "duration_seconds": 7.81,
      "text": "Mm-hm. Yes, I can see the high blood pressure in your file as well. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.99,
      "end_seconds": 162.65,
      "duration_seconds": 3.66,
      "text": "My father had a stroke. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.23,
      "end_seconds": 166.4,
      "duration_seconds": 2.17,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.75,
      "end_seconds": 167.95,
      "duration_seconds": 1.2,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.51,
      "end_seconds": 169.66,
      "duration_seconds": 1.15,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 173.52,
      "duration_seconds": 2.92,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.1,
      "end_seconds": 176.16,
      "duration_seconds": 1.06,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.11,
      "end_seconds": 179.18,
      "duration_seconds": 2.07,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.36,
      "end_seconds": 184.96,
      "duration_seconds": 4.6,
      "text": "What medicines do you take regularly? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.43,
      "end_seconds": 192.51,
      "duration_seconds": 7.08,
      "text": "Amlodipine, 5 milligrams, once a day. Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.81,
      "end_seconds": 200.46,
      "duration_seconds": 7.65,
      "text": "So, doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.39,
      "end_seconds": 204.94,
      "duration_seconds": 3.55,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.8,
      "end_seconds": 217.13,
      "duration_seconds": 11.33,
      "text": "Yeah, no, I left it at home. It's Vertin, 16 milligrams, when it comes. I'd been on glimepiride, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.14,
      "end_seconds": 221.11,
      "duration_seconds": 2.97,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.22,
      "end_seconds": 226.89,
      "duration_seconds": 4.67,
      "text": "Dust. I come out in... well, sneezing. Yes, I'm allergic to aspirin."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.26,
      "end_seconds": 230.84,
      "duration_seconds": 1.58,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.58,
      "end_seconds": 232.28,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.38,
      "end_seconds": 235.88,
      "duration_seconds": 2.5,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.32,
      "end_seconds": 258.18,
      "duration_seconds": 3.86,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.16,
      "end_seconds": 262.43,
      "duration_seconds": 2.27,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.8,
      "end_seconds": 283.06,
      "duration_seconds": 5.26,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 307.1,
      "duration_seconds": 18.86,
      "text": "Alright, all done, thank you, please sit down. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Okay, so my impression is this: It fits best with benign positional vertigo. It could also be a migraine-related dizziness, so we'll keep that open."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.24,
      "end_seconds": 310.85,
      "duration_seconds": 2.61,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.4,
      "end_seconds": 336.71,
      "duration_seconds": 25.31,
      "text": "Nothing I've seen today points to an emergency. It looks like benign positional vertigo, but I'd like to confirm. I'd like to arrange a hearing test for tinnitus and vertigo. It's a routine test and it'll give us a much clearer picture. There's a simple head manoeuvre we can do, and I'll show you how to repeat it at home. Get up slowly from lying down and sit for a moment first."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.82,
      "end_seconds": 350.78,
      "duration_seconds": 12.96,
      "text": "Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.26,
      "end_seconds": 353.71,
      "duration_seconds": 1.45,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.47,
      "end_seconds": 362.51,
      "duration_seconds": 8.04,
      "text": "Please don't sit on it if you get weakness, slurred speech or a severe headache with the dizziness. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.12,
      "end_seconds": 367.75,
      "duration_seconds": 1.63,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.12,
      "end_seconds": 372.44,
      "duration_seconds": 3.32,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.57,
      "end_seconds": 374.27,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.87,
      "end_seconds": 380.88,
      "duration_seconds": 3.01,
      "text": "Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.39,
      "end_seconds": 384.01,
      "duration_seconds": 2.62,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.35,
      "end_seconds": 387.93,
      "duration_seconds": 2.58,
      "text": "Alright, bye for now, look after yourself."
    }
  ]
}