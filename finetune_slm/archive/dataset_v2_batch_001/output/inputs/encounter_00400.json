{
  "schema_version": "1.0",
  "encounter_id": "00400",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.34,
      "end_seconds": 6.74,
      "duration_seconds": 5.4,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.35,
      "end_seconds": 12.6,
      "duration_seconds": 3.25,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.38,
      "end_seconds": 17.28,
      "duration_seconds": 3.9,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.22,
      "end_seconds": 20.52,
      "duration_seconds": 2.3,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.44,
      "end_seconds": 24.41,
      "duration_seconds": 2.97,
      "text": "I've been feeling worn out since the flu."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.98,
      "end_seconds": 30.62,
      "duration_seconds": 4.64,
      "text": "How long have you had it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.03,
      "end_seconds": 37.09,
      "duration_seconds": 6.06,
      "text": "For three weeks, I'd say. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.52,
      "end_seconds": 40.16,
      "duration_seconds": 1.64,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.13,
      "end_seconds": 44.17,
      "duration_seconds": 3.04,
      "text": "It settles a little with sleeping in."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.75,
      "end_seconds": 49.99,
      "duration_seconds": 5.24,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.09,
      "end_seconds": 54.54,
      "duration_seconds": 4.45,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.33,
      "end_seconds": 57.12,
      "duration_seconds": 1.79,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.83,
      "end_seconds": 67.03,
      "duration_seconds": 6.2,
      "text": "That's fine, one at a time. I'll ask about everything. What about aching legs, have you noticed that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.95,
      "end_seconds": 70.82,
      "duration_seconds": 2.87,
      "text": "Yeah, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.27,
      "end_seconds": 73.61,
      "duration_seconds": 2.34,
      "text": "Any a lingering cough as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.14,
      "end_seconds": 76.43,
      "duration_seconds": 1.29,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.87,
      "end_seconds": 78.71,
      "duration_seconds": 1.84,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.84,
      "end_seconds": 82.72,
      "duration_seconds": 1.88,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.26,
      "end_seconds": 87.66,
      "duration_seconds": 4.4,
      "text": "Have you been feeling worn out since the flu at any time before this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.59,
      "end_seconds": 92.64,
      "duration_seconds": 4.05,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.0,
      "end_seconds": 97.68,
      "duration_seconds": 4.68,
      "text": "Have you had any shortness of breath, swollen legs, fever or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 110.48,
      "duration_seconds": 11.36,
      "text": "No, no shortness of breath, no swollen legs, no fever. I did have poor sleep at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.74,
      "end_seconds": 113.3,
      "duration_seconds": 1.56,
      "text": "Have you had any rash?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.25,
      "end_seconds": 117.44,
      "duration_seconds": 1.19,
      "text": "No. No rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 117.78,
      "end_seconds": 121.68,
      "duration_seconds": 3.9,
      "text": "Actually, doctor, I did notice rash. He doesn't always say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.99,
      "end_seconds": 126.79,
      "duration_seconds": 4.8,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.58,
      "end_seconds": 135.62,
      "duration_seconds": 8.04,
      "text": "Alright, I'll note both what you've said and what you've noticed. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.93,
      "end_seconds": 138.16,
      "duration_seconds": 1.23,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.36,
      "end_seconds": 141.41,
      "duration_seconds": 2.05,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.32,
      "end_seconds": 144.63,
      "duration_seconds": 2.31,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 144.95,
      "end_seconds": 151.29,
      "duration_seconds": 6.34,
      "text": "Here are the numbers, doctor. Saturation 98 percent, blood pressure 118 over 77, pulse 82, temperature 36.4."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.63,
      "end_seconds": 158.72,
      "duration_seconds": 7.09,
      "text": "Thanks. Do you have any allergies to medicines, food, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.21,
      "end_seconds": 170.15,
      "duration_seconds": 9.94,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.53,
      "end_seconds": 174.67,
      "duration_seconds": 4.14,
      "text": "Okay, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.09,
      "end_seconds": 189.1,
      "duration_seconds": 13.01,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.51,
      "end_seconds": 190.68,
      "duration_seconds": 1.17,
      "text": "Right, any smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.68,
      "end_seconds": 195.05,
      "duration_seconds": 3.37,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.97,
      "end_seconds": 200.15,
      "duration_seconds": 4.18,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.11,
      "end_seconds": 212.85,
      "duration_seconds": 11.74,
      "text": "Asthma, for about ten years. I've never really been one for hospitals. My sister suggested writing things down, but I forgot. I have gout, for two years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.81,
      "end_seconds": 214.51,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.63,
      "end_seconds": 225.42,
      "duration_seconds": 9.79,
      "text": "I have migraines, for nearly five years. My family kept telling me to get it checked. I've had an enlarged prostate, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.75,
      "end_seconds": 235.78,
      "duration_seconds": 10.03,
      "text": "Okay, asthma, that's already on your record. Good to know. Right, so that's your known gout. We'll keep that in mind today. Any operations in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.29,
      "end_seconds": 241.9,
      "duration_seconds": 4.61,
      "text": "So, just my thyroid operated on, a long time ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.1,
      "end_seconds": 245.88,
      "duration_seconds": 2.78,
      "text": "So, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.28,
      "end_seconds": 247.16,
      "duration_seconds": 0.88,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.39,
      "end_seconds": 258.58,
      "duration_seconds": 4.19,
      "text": "Alright, I've got it. Okay, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.16,
      "end_seconds": 269.02,
      "duration_seconds": 9.86,
      "text": "It's Seretide inhaler, twice a day. It's a relief to finally sit down and talk about it. Allopurinol. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 272.71,
      "end_seconds": 277.06,
      "duration_seconds": 4.35,
      "text": "Doctor, our chart from the last visit lists it as 200 milligrams."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.51,
      "end_seconds": 281.47,
      "duration_seconds": 3.96,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.94,
      "end_seconds": 298.87,
      "duration_seconds": 13.93,
      "text": "No, I left it at home. Sumatriptan, 50 milligrams, when needed. I did try to ignore it for a while. It's tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.01,
      "end_seconds": 302.56,
      "duration_seconds": 1.55,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.15,
      "end_seconds": 305.09,
      "duration_seconds": 0.94,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 308.09,
      "duration_seconds": 1.98,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.45,
      "end_seconds": 327.31,
      "duration_seconds": 1.86,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.28,
      "end_seconds": 329.13,
      "duration_seconds": 0.85,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.88,
      "end_seconds": 350.85,
      "duration_seconds": 15.97,
      "text": "All done, thank you, please sit down. Putting it all together, I think we're dealing with post-viral fatigue at this stage. The reason I say that is that your story and my examination fit together. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 352.39,
      "end_seconds": 354.8,
      "duration_seconds": 2.41,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.28,
      "end_seconds": 370.11,
      "duration_seconds": 13.83,
      "text": "It's reasonable to be concerned, but right now post-viral fatigue is my leading thought, not anything worse. Let me just recap so I've got it right. You've been feeling worn out since the flu for three weeks, and no swollen legs."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.59,
      "end_seconds": 372.36,
      "duration_seconds": 1.77,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.93,
      "end_seconds": 380.01,
      "duration_seconds": 7.08,
      "text": "Let's get a thyroid test, for fatigue. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 380.46,
      "end_seconds": 382.37,
      "duration_seconds": 1.91,
      "text": "The earliest is Thursday, 9 am."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.96,
      "end_seconds": 391.29,
      "duration_seconds": 7.33,
      "text": "We should do blood tests for fatigue. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 392.75,
      "end_seconds": 394.65,
      "duration_seconds": 1.9,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.0,
      "end_seconds": 417.1,
      "duration_seconds": 22.1,
      "text": "Pace yourself, a little more activity each day but stop before you're wiped out. Please take the tablets with food so they don't upset your stomach. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 417.78,
      "end_seconds": 419.22,
      "duration_seconds": 1.44,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.86,
      "end_seconds": 426.46,
      "duration_seconds": 6.6,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 426.88,
      "end_seconds": 428.44,
      "duration_seconds": 1.56,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.81,
      "end_seconds": 432.74,
      "duration_seconds": 2.93,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 433.22,
      "end_seconds": 435.64,
      "duration_seconds": 2.42,
      "text": "Well, okay, I'll book that."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.18,
      "end_seconds": 441.99,
      "duration_seconds": 4.81,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 443.17,
      "end_seconds": 447.7,
      "duration_seconds": 4.53,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.02,
      "end_seconds": 453.02,
      "duration_seconds": 5.0,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 453.6,
      "end_seconds": 458.24,
      "duration_seconds": 4.64,
      "text": "Okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 461.27,
      "end_seconds": 462.81,
      "duration_seconds": 1.54,
      "text": "Alright, see you then."
    }
  ]
}