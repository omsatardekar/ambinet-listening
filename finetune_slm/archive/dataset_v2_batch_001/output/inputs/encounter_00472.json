{
  "schema_version": "1.0",
  "encounter_id": "00472",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.27,
      "duration_seconds": 3.1,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 9.11,
      "duration_seconds": 3.24,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.43,
      "end_seconds": 12.36,
      "duration_seconds": 2.93,
      "text": "I'm here because of very heavy periods."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.73,
      "end_seconds": 16.01,
      "duration_seconds": 2.28,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.56,
      "end_seconds": 19.56,
      "duration_seconds": 3.0,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.39,
      "end_seconds": 22.05,
      "duration_seconds": 1.66,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.67,
      "end_seconds": 30.25,
      "duration_seconds": 7.58,
      "text": "Pretty moderate, if I'm being honest. I've also been passing clots, for about three months. There's tiredness as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 36.47,
      "duration_seconds": 5.29,
      "text": "Let me check a few things. Any weight loss, pain during sex or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.83,
      "end_seconds": 41.3,
      "duration_seconds": 3.47,
      "text": "No, no weight loss, pain during sex or fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.48,
      "end_seconds": 44.32,
      "duration_seconds": 1.84,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.11,
      "end_seconds": 46.42,
      "duration_seconds": 1.31,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 52.8,
      "duration_seconds": 5.82,
      "text": "Do you have any known allergies at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.35,
      "end_seconds": 54.77,
      "duration_seconds": 1.42,
      "text": "Penicillin, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.31,
      "end_seconds": 70.27,
      "duration_seconds": 14.96,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.13,
      "end_seconds": 72.99,
      "duration_seconds": 1.86,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.17,
      "end_seconds": 77.84,
      "duration_seconds": 3.67,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 95.24,
      "duration_seconds": 16.09,
      "text": "I'm on thyroxine, 75 micrograms, every morning for my thyroid. I took the morning off to come in today. My family kept telling me to get it checked. I'm on mefenamic acid, 500 milligrams, maybe, when the pain is bad."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.6,
      "end_seconds": 98.75,
      "duration_seconds": 3.15,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.93,
      "end_seconds": 104.22,
      "duration_seconds": 4.29,
      "text": "Well, you know, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.21,
      "end_seconds": 109.05,
      "duration_seconds": 3.84,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.39,
      "end_seconds": 110.09,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.65,
      "end_seconds": 125.03,
      "duration_seconds": 3.38,
      "text": "Right, thanks for waiting. Okay, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.43,
      "end_seconds": 130.32,
      "duration_seconds": 1.89,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.85,
      "end_seconds": 131.6,
      "duration_seconds": 0.75,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.37,
      "end_seconds": 136.46,
      "duration_seconds": 4.09,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.6,
      "end_seconds": 141.62,
      "duration_seconds": 4.02,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.27,
      "end_seconds": 146.0,
      "duration_seconds": 3.73,
      "text": "I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 146.34,
      "end_seconds": 154.65,
      "duration_seconds": 8.31,
      "text": "Okay, so the vitals from earlier. Temp 37.0 degrees, oxygen saturation is 97 percent, pulse is 71 beats a minute, BP is 117 over 73."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.96,
      "end_seconds": 156.66,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.71,
      "end_seconds": 161.87,
      "duration_seconds": 3.16,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.7,
      "end_seconds": 163.4,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.89,
      "end_seconds": 166.91,
      "duration_seconds": 2.02,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.78,
      "end_seconds": 190.78,
      "duration_seconds": 5.0,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.44,
      "end_seconds": 212.39,
      "duration_seconds": 18.95,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Right, here's what I'm thinking. This looks most like heavy periods with a cause still to find. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.03,
      "end_seconds": 215.4,
      "duration_seconds": 2.37,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.26,
      "end_seconds": 232.62,
      "duration_seconds": 16.36,
      "text": "It's reasonable to be concerned, but right now heavy periods with a cause still to find is my leading thought, not anything worse. Let me just recap so I've got it right. You've had very heavy periods for two days, moderate, and no pain during sex or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.0,
      "end_seconds": 234.28,
      "duration_seconds": 1.28,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.16,
      "end_seconds": 238.14,
      "duration_seconds": 2.98,
      "text": "I'd like to arrange blood tests for heavy periods."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.47,
      "end_seconds": 239.32,
      "duration_seconds": 0.85,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.11,
      "end_seconds": 251.13,
      "duration_seconds": 8.02,
      "text": "I'd like to arrange a pelvic ultrasound for heavy periods. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.42,
      "end_seconds": 254.84,
      "duration_seconds": 2.42,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.39,
      "end_seconds": 283.48,
      "duration_seconds": 28.09,
      "text": "I'd like you to take tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. You take it by mouth. That's for heavy bleeding. The pharmacy will go through the details again when you pick it up. Let's use ferrous sulfate, 200 milligrams, once a day, for three months. That should help with possible iron deficiency. Keep a note of how many pads you use each day and the dates, it helps us a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.99,
      "end_seconds": 302.71,
      "duration_seconds": 18.72,
      "text": "Alright. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.7,
      "end_seconds": 307.91,
      "duration_seconds": 1.21,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.75,
      "end_seconds": 317.34,
      "duration_seconds": 8.59,
      "text": "I want you to come back or go to emergency straight away if you soak through a pad every hour or feel faint."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.14,
      "end_seconds": 319.39,
      "duration_seconds": 1.25,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.79,
      "end_seconds": 323.75,
      "duration_seconds": 2.96,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.28,
      "end_seconds": 324.98,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.74,
      "end_seconds": 331.76,
      "duration_seconds": 6.02,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.26,
      "end_seconds": 344.31,
      "duration_seconds": 11.05,
      "text": "So, I take the tranexamic acid, 500 milligrams, three times a day during periods and take the ferrous sulfate, 200 milligrams, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.03,
      "end_seconds": 347.53,
      "duration_seconds": 2.5,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.54,
      "end_seconds": 351.77,
      "duration_seconds": 3.23,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.78,
      "end_seconds": 355.12,
      "duration_seconds": 2.34,
      "text": "Bye for now, look after yourself."
    }
  ]
}