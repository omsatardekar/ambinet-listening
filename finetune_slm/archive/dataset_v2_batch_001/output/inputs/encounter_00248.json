{
  "schema_version": "1.0",
  "encounter_id": "00248",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 3.89,
      "duration_seconds": 2.68,
      "text": "Hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.65,
      "end_seconds": 8.06,
      "duration_seconds": 3.41,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.51,
      "end_seconds": 12.61,
      "duration_seconds": 3.1,
      "text": "So, I've been feeling overwhelmed at work, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 19.85,
      "duration_seconds": 2.34,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 24.76,
      "duration_seconds": 3.75,
      "text": "Right, it's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.24,
      "end_seconds": 32.91,
      "duration_seconds": 6.67,
      "text": "Okay, give me more detail on it, whatever comes to mind. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.1,
      "end_seconds": 42.96,
      "duration_seconds": 8.86,
      "text": "I notice it more with deadlines. Only weekends off, and it's not much. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.79,
      "end_seconds": 48.36,
      "duration_seconds": 4.57,
      "text": "Right, bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.03,
      "end_seconds": 70.33,
      "duration_seconds": 5.3,
      "text": "Alright, back to you. Have you had any weight loss, chest pain or alcohol use?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.56,
      "end_seconds": 76.07,
      "duration_seconds": 4.51,
      "text": "I haven't had weight loss, chest pain or alcohol use, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.25,
      "end_seconds": 80.4,
      "duration_seconds": 3.15,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.0,
      "end_seconds": 81.7,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.74,
      "end_seconds": 101.4,
      "duration_seconds": 4.66,
      "text": "Right, thanks for waiting. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.7,
      "end_seconds": 103.5,
      "duration_seconds": 0.8,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.07,
      "end_seconds": 119.13,
      "duration_seconds": 15.06,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.51,
      "end_seconds": 123.9,
      "duration_seconds": 4.39,
      "text": "Hmm, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.82,
      "end_seconds": 125.88,
      "duration_seconds": 1.06,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.11,
      "end_seconds": 132.5,
      "duration_seconds": 3.39,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 136.91,
      "duration_seconds": 3.21,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.42,
      "end_seconds": 138.33,
      "duration_seconds": 0.91,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 151.83,
      "duration_seconds": 5.5,
      "text": "Alright, I've got it. Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.81,
      "end_seconds": 155.14,
      "duration_seconds": 2.33,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.55,
      "end_seconds": 158.81,
      "duration_seconds": 2.26,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.21,
      "end_seconds": 166.46,
      "duration_seconds": 6.25,
      "text": "Busy. Everyone's running in different directions at the moment, uh, you know how it is."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.95,
      "end_seconds": 169.61,
      "duration_seconds": 1.66,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.67,
      "end_seconds": 174.6,
      "duration_seconds": 3.93,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.35,
      "end_seconds": 188.84,
      "duration_seconds": 13.49,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.79,
      "end_seconds": 191.72,
      "duration_seconds": 1.93,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.03,
      "end_seconds": 193.17,
      "duration_seconds": 1.14,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.56,
      "end_seconds": 195.82,
      "duration_seconds": 1.26,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.52,
      "end_seconds": 200.34,
      "duration_seconds": 3.82,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.03,
      "end_seconds": 202.95,
      "duration_seconds": 1.92,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.68,
      "end_seconds": 210.44,
      "duration_seconds": 3.76,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.91,
      "end_seconds": 213.93,
      "duration_seconds": 3.02,
      "text": "Uh, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.1,
      "end_seconds": 217.32,
      "duration_seconds": 2.22,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.89,
      "end_seconds": 219.5,
      "duration_seconds": 1.61,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.14,
      "end_seconds": 233.12,
      "duration_seconds": 12.98,
      "text": "Right, here's what I'm thinking. I think we're dealing with stress-related symptoms at this stage. Let me just recap so I've got it right. You've been feeling overwhelmed at work for about two weeks, and no alcohol use or weight loss."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 235.59,
      "duration_seconds": 1.91,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.22,
      "end_seconds": 249.71,
      "duration_seconds": 13.49,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.78,
      "end_seconds": 252.51,
      "duration_seconds": 1.73,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.87,
      "end_seconds": 277.7,
      "duration_seconds": 24.83,
      "text": "We should do blood tests for stress-related symptoms. I'd rather check than guess, and this is the quickest way to know more. Block out proper breaks in the day, and one evening a week that's yours. Talking to someone, even a counsellor, helps more than people expect. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I'll also refer you to a counsellor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.87,
      "end_seconds": 281.11,
      "duration_seconds": 2.24,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.98,
      "end_seconds": 287.54,
      "duration_seconds": 5.56,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.03,
      "end_seconds": 291.14,
      "duration_seconds": 2.11,
      "text": "Okay, um, I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.08,
      "end_seconds": 293.81,
      "duration_seconds": 1.73,
      "text": "Come back in a month."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.04,
      "end_seconds": 295.74,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.33,
      "end_seconds": 303.2,
      "duration_seconds": 6.87,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.49,
      "end_seconds": 308.6,
      "duration_seconds": 4.11,
      "text": "So, I come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.81,
      "end_seconds": 313.71,
      "duration_seconds": 3.9,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.04,
      "end_seconds": 319.57,
      "duration_seconds": 5.53,
      "text": "I mean, okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.88,
      "end_seconds": 321.69,
      "duration_seconds": 0.81,
      "text": "Alright, goodbye."
    }
  ]
}