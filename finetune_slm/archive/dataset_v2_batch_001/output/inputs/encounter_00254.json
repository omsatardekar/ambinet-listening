{
  "schema_version": "1.0",
  "encounter_id": "00254",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 7.04,
      "duration_seconds": 5.98,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 12.5,
      "duration_seconds": 4.35,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.84,
      "end_seconds": 18.66,
      "duration_seconds": 5.82,
      "text": "Mainly constipation. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.13,
      "end_seconds": 20.91,
      "duration_seconds": 1.78,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.28,
      "end_seconds": 25.46,
      "duration_seconds": 3.18,
      "text": "I've, I've had it for two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.12,
      "end_seconds": 33.53,
      "duration_seconds": 3.41,
      "text": "Any a heavy feeling in the lower tummy as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 35.43,
      "duration_seconds": 0.94,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.51,
      "end_seconds": 39.38,
      "duration_seconds": 2.87,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.32,
      "end_seconds": 41.79,
      "duration_seconds": 1.47,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.46,
      "end_seconds": 57.67,
      "duration_seconds": 15.21,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.01,
      "end_seconds": 60.64,
      "duration_seconds": 1.63,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.98,
      "end_seconds": 64.68,
      "duration_seconds": 2.7,
      "text": "Has there been any pain on passing stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.26,
      "end_seconds": 68.28,
      "duration_seconds": 3.02,
      "text": "No pain on passing stool, thank goodness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.62,
      "end_seconds": 73.66,
      "duration_seconds": 4.04,
      "text": "Let me check a few things. Any vomiting or black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.18,
      "end_seconds": 76.71,
      "duration_seconds": 2.53,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.75,
      "end_seconds": 80.44,
      "duration_seconds": 2.69,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.04,
      "end_seconds": 81.82,
      "duration_seconds": 0.78,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 91.59,
      "duration_seconds": 3.25,
      "text": "Alright, I've got it. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.6,
      "end_seconds": 94.6,
      "duration_seconds": 2.0,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.41,
      "end_seconds": 99.0,
      "duration_seconds": 3.59,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.54,
      "end_seconds": 120.23,
      "duration_seconds": 6.69,
      "text": "Okay, continuing. Any long-term health problems I should know about? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.93,
      "end_seconds": 122.14,
      "duration_seconds": 1.21,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.5,
      "end_seconds": 127.99,
      "duration_seconds": 4.49,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.17,
      "end_seconds": 141.43,
      "duration_seconds": 9.26,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 142.88,
      "duration_seconds": 0.99,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.61,
      "end_seconds": 147.21,
      "duration_seconds": 3.6,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.58,
      "end_seconds": 151.71,
      "duration_seconds": 3.13,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.7,
      "end_seconds": 156.17,
      "duration_seconds": 3.47,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.81,
      "end_seconds": 157.74,
      "duration_seconds": 0.93,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.26,
      "end_seconds": 162.44,
      "duration_seconds": 3.18,
      "text": "Just my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.95,
      "end_seconds": 167.35,
      "duration_seconds": 4.4,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.77,
      "end_seconds": 168.57,
      "duration_seconds": 0.8,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.09,
      "end_seconds": 187.74,
      "duration_seconds": 5.65,
      "text": "Okay, here we go. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.23,
      "end_seconds": 193.3,
      "duration_seconds": 4.07,
      "text": "I take Glycomet, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.79,
      "end_seconds": 197.22,
      "duration_seconds": 2.43,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.31,
      "end_seconds": 201.49,
      "duration_seconds": 3.18,
      "text": "No, it's at home. Cremaffin, at night."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.85,
      "end_seconds": 205.39,
      "duration_seconds": 2.54,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.14,
      "end_seconds": 208.49,
      "duration_seconds": 2.35,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.29,
      "end_seconds": 220.79,
      "duration_seconds": 3.5,
      "text": "Alright, I've got it. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.64,
      "end_seconds": 236.55,
      "duration_seconds": 1.91,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.87,
      "end_seconds": 254.76,
      "duration_seconds": 6.89,
      "text": "Okay: temperature 36.5, pulse 73, height 152 centimetres. And weight 90 kilos, pressure 115 over 82."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.33,
      "end_seconds": 258.25,
      "duration_seconds": 2.92,
      "text": "Alright, I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.59,
      "end_seconds": 259.36,
      "duration_seconds": 0.77,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 275.42,
      "duration_seconds": 1.64,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.34,
      "end_seconds": 281.26,
      "duration_seconds": 2.92,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.62,
      "end_seconds": 283.03,
      "duration_seconds": 1.41,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.9,
      "end_seconds": 286.58,
      "duration_seconds": 1.68,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.32,
      "end_seconds": 304.2,
      "duration_seconds": 1.88,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.27,
      "end_seconds": 320.38,
      "duration_seconds": 14.11,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.41,
      "end_seconds": 323.77,
      "duration_seconds": 2.36,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.2,
      "end_seconds": 338.92,
      "duration_seconds": 14.72,
      "text": "Okay, so my impression is this: It fits best with chronic constipation. It could also be haemorrhoids, so we'll keep that open. Let me just recap so I've got it right. You've had constipation for two years, and no vomiting or pain on passing stool."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.52,
      "end_seconds": 342.3,
      "duration_seconds": 1.78,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.76,
      "end_seconds": 347.86,
      "duration_seconds": 4.1,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.42,
      "end_seconds": 361.02,
      "duration_seconds": 11.6,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.87,
      "end_seconds": 369.33,
      "duration_seconds": 7.46,
      "text": "Let's get a colonoscopy, for constipation and rectal bleeding. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.45,
      "end_seconds": 372.6,
      "duration_seconds": 2.15,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.87,
      "end_seconds": 375.87,
      "duration_seconds": 2.0,
      "text": "Let's get blood tests, for constipation."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.33,
      "end_seconds": 377.55,
      "duration_seconds": 1.22,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.69,
      "end_seconds": 402.64,
      "duration_seconds": 23.95,
      "text": "I'll start you on lactulose, 15 ml, at night, for two weeks. You take it by mouth. It's for constipation. More fibre, more water, and give yourself ten unhurried minutes after breakfast. Cut down on salt and fried food for now, it really does make a difference. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.71,
      "end_seconds": 410.76,
      "duration_seconds": 7.05,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.96,
      "end_seconds": 413.2,
      "duration_seconds": 1.24,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.71,
      "end_seconds": 420.92,
      "duration_seconds": 6.21,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.44,
      "end_seconds": 423.14,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.69,
      "end_seconds": 429.45,
      "duration_seconds": 5.76,
      "text": "Come back in three weeks. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.32,
      "end_seconds": 441.49,
      "duration_seconds": 8.17,
      "text": "So, I take the lactulose, 15 ml, at night and come back in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.0,
      "end_seconds": 445.66,
      "duration_seconds": 2.66,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.0,
      "end_seconds": 449.31,
      "duration_seconds": 3.31,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}