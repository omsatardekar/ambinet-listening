{
  "schema_version": "1.0",
  "encounter_id": "00320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.95,
      "duration_seconds": 3.9,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 9.06,
      "duration_seconds": 3.71,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.31,
      "end_seconds": 15.57,
      "duration_seconds": 5.26,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.92,
      "end_seconds": 19.85,
      "duration_seconds": 3.93,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.81,
      "end_seconds": 25.02,
      "duration_seconds": 4.21,
      "text": "She's been having been feeling overwhelmed at work, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.52,
      "end_seconds": 28.95,
      "duration_seconds": 3.43,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.25,
      "end_seconds": 38.17,
      "duration_seconds": 7.92,
      "text": "Probably six months. Yeah. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 43.83,
      "duration_seconds": 1.71,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.45,
      "end_seconds": 53.18,
      "duration_seconds": 4.73,
      "text": "Well, you know, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.59,
      "end_seconds": 56.52,
      "duration_seconds": 1.93,
      "text": "Have you been feeling short-tempered?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.88,
      "end_seconds": 60.16,
      "duration_seconds": 2.28,
      "text": "Yeah, uh, that too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.81,
      "end_seconds": 63.38,
      "duration_seconds": 2.57,
      "text": "Has there been headaches in the evening too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.19,
      "end_seconds": 65.16,
      "duration_seconds": 0.97,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.6,
      "end_seconds": 68.73,
      "duration_seconds": 2.13,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.41,
      "end_seconds": 76.5,
      "duration_seconds": 7.09,
      "text": "Um, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 83.85,
      "duration_seconds": 5.85,
      "text": "Let me check a few things. Any thoughts of harming myself, weight loss or panic attacks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 90.95,
      "duration_seconds": 6.6,
      "text": "Okay, uh, so no, no thoughts of harming myself, weight loss or panic attacks."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.66,
      "end_seconds": 94.6,
      "duration_seconds": 2.94,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 98.66,
      "duration_seconds": 2.6,
      "text": "I mean, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.08,
      "end_seconds": 104.23,
      "duration_seconds": 4.15,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.76,
      "end_seconds": 109.72,
      "duration_seconds": 3.96,
      "text": "Uh, uh, no problem, take your time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.19,
      "end_seconds": 112.71,
      "duration_seconds": 2.52,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.11,
      "end_seconds": 119.67,
      "duration_seconds": 6.56,
      "text": "I've, I've had anxiety, yes. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.21,
      "end_seconds": 122.88,
      "duration_seconds": 2.67,
      "text": "Right. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.61,
      "end_seconds": 127.01,
      "duration_seconds": 3.4,
      "text": "Right, um, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.8,
      "end_seconds": 129.91,
      "duration_seconds": 2.11,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.37,
      "end_seconds": 136.12,
      "duration_seconds": 5.75,
      "text": "Hmm, I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.48,
      "end_seconds": 140.06,
      "duration_seconds": 2.58,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.33,
      "end_seconds": 142.81,
      "duration_seconds": 1.48,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.3,
      "end_seconds": 146.27,
      "duration_seconds": 2.97,
      "text": "Right, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.74,
      "end_seconds": 152.1,
      "duration_seconds": 5.36,
      "text": "Oh, I'm on escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.62,
      "end_seconds": 157.15,
      "duration_seconds": 3.53,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.83,
      "end_seconds": 160.98,
      "duration_seconds": 3.15,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.54,
      "end_seconds": 168.45,
      "duration_seconds": 3.91,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.08,
      "end_seconds": 182.24,
      "duration_seconds": 13.16,
      "text": "Yeah, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.35,
      "end_seconds": 185.02,
      "duration_seconds": 1.67,
      "text": "So, how about smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 190.14,
      "duration_seconds": 4.32,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.94,
      "end_seconds": 193.44,
      "duration_seconds": 2.5,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.84,
      "end_seconds": 198.86,
      "duration_seconds": 4.02,
      "text": "I mean, no, none that I know of."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.72,
      "end_seconds": 202.3,
      "duration_seconds": 2.58,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.75,
      "end_seconds": 217.75,
      "duration_seconds": 15.0,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.44,
      "end_seconds": 222.81,
      "duration_seconds": 4.37,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.96,
      "end_seconds": 243.22,
      "duration_seconds": 4.26,
      "text": "Alright, back to you. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.28,
      "end_seconds": 247.17,
      "duration_seconds": 2.89,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.87,
      "end_seconds": 273.15,
      "duration_seconds": 25.28,
      "text": "So, based on your history, my working impression is stress-related symptoms. The reason I say that is that the way you describe it fits together. It could also be a depressive episode, so we'll keep that open. Let me just recap so I've got it right. You've been feeling overwhelmed at work for six months, and no weight loss or thoughts of harming myself."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.91,
      "end_seconds": 276.18,
      "duration_seconds": 2.27,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.06,
      "end_seconds": 280.62,
      "duration_seconds": 3.56,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.49,
      "end_seconds": 285.35,
      "duration_seconds": 3.86,
      "text": "I, I hadn't even noticed, you know, honestly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.92,
      "end_seconds": 293.91,
      "duration_seconds": 6.99,
      "text": "We should do blood tests for stress-related symptoms. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.71,
      "end_seconds": 298.52,
      "duration_seconds": 3.81,
      "text": "Okay, so sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.87,
      "end_seconds": 318.1,
      "duration_seconds": 18.23,
      "text": "Block out proper breaks in the day, and one evening a week that's yours. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.25,
      "end_seconds": 321.67,
      "duration_seconds": 2.42,
      "text": "Okay, um, I will."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.65,
      "end_seconds": 330.83,
      "duration_seconds": 6.18,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.17,
      "end_seconds": 334.01,
      "duration_seconds": 1.84,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.57,
      "end_seconds": 336.56,
      "duration_seconds": 1.99,
      "text": "Let's review you in a month."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.39,
      "end_seconds": 339.42,
      "duration_seconds": 2.03,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.66,
      "end_seconds": 347.08,
      "duration_seconds": 6.42,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.48,
      "end_seconds": 352.5,
      "duration_seconds": 5.02,
      "text": "So, uh, I come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.03,
      "end_seconds": 356.84,
      "duration_seconds": 3.81,
      "text": "Alright, yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.39,
      "end_seconds": 359.06,
      "duration_seconds": 1.67,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.04,
      "end_seconds": 361.04,
      "duration_seconds": 1.0,
      "text": "See you then."
    }
  ]
}