{
  "schema_version": "1.0",
  "encounter_id": "00061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.82,
      "end_seconds": 2.68,
      "duration_seconds": 1.86,
      "text": "Hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.25,
      "end_seconds": 6.36,
      "duration_seconds": 3.11,
      "text": "Oh, thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.92,
      "end_seconds": 11.01,
      "duration_seconds": 4.09,
      "text": "Thank you for fitting us in, you know, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.04,
      "end_seconds": 14.24,
      "duration_seconds": 2.2,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.83,
      "end_seconds": 20.27,
      "duration_seconds": 5.44,
      "text": "I mean, uh, he's been having occasional chest tightness, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.45,
      "end_seconds": 23.62,
      "duration_seconds": 2.17,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.21,
      "end_seconds": 35.75,
      "duration_seconds": 10.54,
      "text": "Well, you know, it's been about a year, I'm fairly sure. I've never really been one for hospitals. And poor sleep, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.96,
      "end_seconds": 40.74,
      "duration_seconds": 3.78,
      "text": "What about ankle swelling in the evenings, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.13,
      "end_seconds": 60.71,
      "duration_seconds": 18.58,
      "text": "Yeah, that too. With ankle swelling in the evenings, pretty mild, if I'm being honest. Well, you know, I've also had breathlessness on slopes, for three weeks. Uh, with breathlessness on slopes, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.23,
      "end_seconds": 64.51,
      "duration_seconds": 3.28,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 87.79,
      "duration_seconds": 6.08,
      "text": "Alright, back to you. Let me check a few things. Any bruising or coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.65,
      "end_seconds": 91.8,
      "duration_seconds": 3.15,
      "text": "Yeah, no, none of that at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 95.63,
      "duration_seconds": 2.8,
      "text": "Have you had any fainting or pain at rest?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.22,
      "end_seconds": 101.23,
      "duration_seconds": 3.01,
      "text": "So, no, none of that at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.59,
      "end_seconds": 104.33,
      "duration_seconds": 2.74,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.2,
      "end_seconds": 106.71,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.22,
      "end_seconds": 110.39,
      "duration_seconds": 2.17,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.64,
      "end_seconds": 115.09,
      "duration_seconds": 3.45,
      "text": "I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.17,
      "end_seconds": 127.04,
      "duration_seconds": 10.87,
      "text": "Hmm, uh, doctor, I think the last prescription for the aspirin was 37.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.05,
      "end_seconds": 130.29,
      "duration_seconds": 2.24,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.81,
      "end_seconds": 141.16,
      "duration_seconds": 10.35,
      "text": "I mean, not with me. I'll bring it next time. It's losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.57,
      "end_seconds": 146.6,
      "duration_seconds": 4.03,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.64,
      "end_seconds": 149.53,
      "duration_seconds": 1.89,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.7,
      "end_seconds": 151.74,
      "duration_seconds": 1.04,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.47,
      "end_seconds": 163.5,
      "duration_seconds": 11.03,
      "text": "I've, I've had high blood pressure, yes. I kept putting it off, which I know isn't sensible. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.31,
      "end_seconds": 167.53,
      "duration_seconds": 3.22,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.58,
      "end_seconds": 184.1,
      "duration_seconds": 14.52,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.04,
      "end_seconds": 185.8,
      "duration_seconds": 0.76,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.6,
      "end_seconds": 187.99,
      "duration_seconds": 1.39,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 190.37,
      "duration_seconds": 2.07,
      "text": "Alright, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.71,
      "end_seconds": 197.52,
      "duration_seconds": 3.81,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.53,
      "end_seconds": 200.93,
      "duration_seconds": 2.4,
      "text": "Alright, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.3,
      "end_seconds": 203.96,
      "duration_seconds": 2.66,
      "text": "So, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.51,
      "end_seconds": 219.51,
      "duration_seconds": 15.0,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.84,
      "end_seconds": 222.48,
      "duration_seconds": 2.64,
      "text": "Um, okay, that makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 224.0,
      "duration_seconds": 1.09,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.96,
      "end_seconds": 230.03,
      "duration_seconds": 5.07,
      "text": "Um, yes, I had a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.43,
      "end_seconds": 234.65,
      "duration_seconds": 3.22,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.2,
      "end_seconds": 236.03,
      "duration_seconds": 0.83,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.09,
      "end_seconds": 248.92,
      "duration_seconds": 3.83,
      "text": "Alright, I've got it. Right, does anything run in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.54,
      "end_seconds": 253.92,
      "duration_seconds": 4.38,
      "text": "Well, my mother has migraines. My mother has diabetes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.9,
      "end_seconds": 258.91,
      "duration_seconds": 4.01,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.63,
      "end_seconds": 260.33,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.26,
      "end_seconds": 276.67,
      "duration_seconds": 3.41,
      "text": "Okay, here we go. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.64,
      "end_seconds": 289.57,
      "duration_seconds": 1.93,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.99,
      "end_seconds": 309.0,
      "duration_seconds": 4.01,
      "text": "Okay: blood pressure 122 over 82, heart rate 64, respiratory rate 15."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.8,
      "end_seconds": 311.14,
      "duration_seconds": 1.34,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.27,
      "end_seconds": 315.4,
      "duration_seconds": 3.13,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.85,
      "end_seconds": 320.19,
      "duration_seconds": 2.34,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.8,
      "end_seconds": 323.43,
      "duration_seconds": 1.63,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.81,
      "end_seconds": 342.41,
      "duration_seconds": 2.6,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.95,
      "end_seconds": 346.13,
      "duration_seconds": 2.18,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.35,
      "end_seconds": 365.42,
      "duration_seconds": 3.07,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.55,
      "end_seconds": 367.25,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.0,
      "end_seconds": 376.76,
      "duration_seconds": 4.76,
      "text": "That's fine, you can get dressed. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.64,
      "end_seconds": 382.02,
      "duration_seconds": 4.38,
      "text": "Yes, uh, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.79,
      "end_seconds": 391.19,
      "duration_seconds": 8.4,
      "text": "So, based on the history and the examination, this looks most like stable recovery after the heart event. Medication side effects is also on my list."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.45,
      "end_seconds": 394.98,
      "duration_seconds": 2.53,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.08,
      "end_seconds": 413.6,
      "duration_seconds": 17.52,
      "text": "I understand the worry. At the moment I'd say it's stable recovery after the heart event, and we'll know more once the a lipid profile is back. Let me just recap so I've got it right. You've had occasional chest tightness for about a year, and no pain at rest or fainting."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.43,
      "end_seconds": 415.78,
      "duration_seconds": 1.35,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.96,
      "end_seconds": 420.51,
      "duration_seconds": 3.55,
      "text": "I'd like to arrange a lipid profile for cardiovascular risk."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 420.89,
      "end_seconds": 423.49,
      "duration_seconds": 2.6,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.14,
      "end_seconds": 439.07,
      "duration_seconds": 14.93,
      "text": "I'd like to arrange an echocardiogram for follow-up. I'd rather check than guess, and this is the quickest way to know more. We should do an ECG for follow-up. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 441.83,
      "end_seconds": 444.0,
      "duration_seconds": 2.17,
      "text": "Okay, um, that's fine."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 444.77,
      "end_seconds": 468.75,
      "duration_seconds": 23.98,
      "text": "I'd like you to take atorvastatin, 40 milligrams, at night, long term. You take it by mouth. That should help with cardiovascular risk. I'll put all of this in writing so you don't have to remember it. Cardiac rehab is worth doing, it really helps your confidence. A short walk every day, even twenty minutes, will help more than you'd think. I'll also refer you to cardiac rehabilitation."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 469.12,
      "end_seconds": 472.6,
      "duration_seconds": 3.48,
      "text": "Sure, you know, where do I go?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 473.75,
      "end_seconds": 481.19,
      "duration_seconds": 7.44,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 481.57,
      "end_seconds": 482.99,
      "duration_seconds": 1.42,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 484.57,
      "end_seconds": 490.42,
      "duration_seconds": 5.85,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 491.13,
      "end_seconds": 492.52,
      "duration_seconds": 1.39,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 494.01,
      "end_seconds": 495.58,
      "duration_seconds": 1.57,
      "text": "Come back in six weeks."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 496.44,
      "end_seconds": 499.91,
      "duration_seconds": 3.47,
      "text": "Uh, uh, okay, I'll book that."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 500.97,
      "end_seconds": 505.55,
      "duration_seconds": 4.58,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 506.11,
      "end_seconds": 514.25,
      "duration_seconds": 8.14,
      "text": "So, I take the atorvastatin, 40 milligrams, at night and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 515.54,
      "end_seconds": 519.56,
      "duration_seconds": 4.02,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 520.91,
      "end_seconds": 523.69,
      "duration_seconds": 2.78,
      "text": "Nothing more from me, doctor, thanks."
    }
  ]
}