{
  "schema_version": "1.0",
  "encounter_id": "00217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.32,
      "end_seconds": 6.19,
      "duration_seconds": 4.87,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.72,
      "end_seconds": 10.01,
      "duration_seconds": 3.29,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 22.2,
      "duration_seconds": 10.68,
      "text": "It's tingling in my fingers. I thought I'd wait, uh, but it hasn't gone. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.05,
      "end_seconds": 31.02,
      "duration_seconds": 4.97,
      "text": "When did you first notice it? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 31.78,
      "end_seconds": 41.51,
      "duration_seconds": 9.73,
      "text": "About... well, five days. I'm not great at remembering details, so bear with me. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.69,
      "end_seconds": 46.42,
      "duration_seconds": 3.73,
      "text": "So, does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.0,
      "end_seconds": 52.64,
      "duration_seconds": 4.64,
      "text": "Yes, typing and holding the phone. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.05,
      "end_seconds": 55.47,
      "duration_seconds": 2.42,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.97,
      "end_seconds": 62.19,
      "duration_seconds": 6.22,
      "text": "Moderate, I'd say. Oh, and a weak grip. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.61,
      "end_seconds": 72.15,
      "duration_seconds": 5.54,
      "text": "Have you had tingling in your fingers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.06,
      "end_seconds": 77.12,
      "duration_seconds": 4.06,
      "text": "Right, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 82.69,
      "duration_seconds": 4.76,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.99,
      "end_seconds": 93.78,
      "duration_seconds": 9.79,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 97.93,
      "duration_seconds": 3.64,
      "text": "Any swelling in the joints or weakness in the legs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.12,
      "end_seconds": 106.5,
      "duration_seconds": 5.38,
      "text": "I haven't had swelling in the joints or weakness in the legs, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.88,
      "end_seconds": 111.47,
      "duration_seconds": 3.59,
      "text": "Have you had any trouble walking, headache or bladder problems?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.58,
      "end_seconds": 117.18,
      "duration_seconds": 4.6,
      "text": "I haven't had trouble walking, headache or bladder problems, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.78,
      "end_seconds": 122.38,
      "duration_seconds": 4.6,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.08,
      "end_seconds": 136.49,
      "duration_seconds": 1.41,
      "text": "Good, where were we."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 136.81,
      "end_seconds": 146.89,
      "duration_seconds": 10.08,
      "text": "Doctor, I've got the readings for you. Pulse is 66 beats a minute, oxygen saturation is 98 percent, pressure 117 over 77, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 151.91,
      "duration_seconds": 3.72,
      "text": "Thanks. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.49,
      "end_seconds": 156.46,
      "duration_seconds": 2.97,
      "text": "No problem, uh, take your time."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.7,
      "end_seconds": 160.02,
      "duration_seconds": 2.32,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.23,
      "end_seconds": 165.46,
      "duration_seconds": 4.23,
      "text": "Well, uh, I had a C-section about ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.79,
      "end_seconds": 169.02,
      "duration_seconds": 2.23,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.54,
      "end_seconds": 172.5,
      "duration_seconds": 2.96,
      "text": "Oh, of course, take your time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.73,
      "end_seconds": 190.05,
      "duration_seconds": 5.32,
      "text": "Alright, I've got it. Okay, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.53,
      "end_seconds": 199.24,
      "duration_seconds": 7.71,
      "text": "Uh, I have diabetes, for about ten years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.89,
      "end_seconds": 200.59,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.38,
      "end_seconds": 205.04,
      "duration_seconds": 3.66,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.85,
      "end_seconds": 206.55,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.24,
      "end_seconds": 224.26,
      "duration_seconds": 6.02,
      "text": "Alright, I've got it. Right, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.89,
      "end_seconds": 227.13,
      "duration_seconds": 2.24,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.29,
      "end_seconds": 232.49,
      "duration_seconds": 4.2,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.99,
      "end_seconds": 233.75,
      "duration_seconds": 0.76,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 247.46,
      "duration_seconds": 4.34,
      "text": "Okay, here we go. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.0,
      "end_seconds": 251.32,
      "duration_seconds": 2.32,
      "text": "It's Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.64,
      "end_seconds": 254.47,
      "duration_seconds": 1.83,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 255.81,
      "end_seconds": 256.53,
      "duration_seconds": 0.72,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.61,
      "end_seconds": 260.48,
      "duration_seconds": 1.87,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 261.52,
      "end_seconds": 262.22,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.12,
      "end_seconds": 265.68,
      "duration_seconds": 1.56,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.49,
      "end_seconds": 278.24,
      "duration_seconds": 3.75,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.46,
      "end_seconds": 281.28,
      "duration_seconds": 1.82,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.74,
      "end_seconds": 291.94,
      "duration_seconds": 2.2,
      "text": "Power in the thumb is slightly reduced."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.5,
      "end_seconds": 294.85,
      "duration_seconds": 2.35,
      "text": "Okay, uh, go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.16,
      "end_seconds": 311.15,
      "duration_seconds": 11.99,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Alright, are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.53,
      "end_seconds": 315.7,
      "duration_seconds": 3.17,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.08,
      "end_seconds": 337.35,
      "duration_seconds": 18.27,
      "text": "Right, here's what I'm thinking. My working impression is carpal tunnel syndrome. I want to be honest that this is an impression, not a final answer. Let me just recap so I've got it right. You've had tingling in your fingers for five days, moderate, and no swelling in the joints or bladder problems."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.66,
      "end_seconds": 340.38,
      "duration_seconds": 2.72,
      "text": "So, exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.18,
      "end_seconds": 356.04,
      "duration_seconds": 14.86,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.7,
      "end_seconds": 358.75,
      "duration_seconds": 2.05,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.38,
      "end_seconds": 374.64,
      "duration_seconds": 11.26,
      "text": "I'm going to order a blood sugar test, for neuropathy screen. The result will help us decide whether anything more is needed. Take short breaks from typing and keep the wrist straight."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.1,
      "end_seconds": 384.28,
      "duration_seconds": 9.18,
      "text": "Okay. Cut down on salt and fried food for now, it really does make a difference. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 385.55,
      "end_seconds": 386.25,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.45,
      "end_seconds": 393.1,
      "duration_seconds": 5.65,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 394.57,
      "end_seconds": 396.14,
      "duration_seconds": 1.57,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.51,
      "end_seconds": 399.94,
      "duration_seconds": 3.43,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.35,
      "end_seconds": 404.78,
      "duration_seconds": 4.43,
      "text": "Okay, so sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.08,
      "end_seconds": 412.93,
      "duration_seconds": 6.85,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 414.01,
      "end_seconds": 418.52,
      "duration_seconds": 4.51,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.16,
      "end_seconds": 426.22,
      "duration_seconds": 3.06,
      "text": "Yes, exactly right. Right, good. Look after yourself."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 426.66,
      "end_seconds": 429.01,
      "duration_seconds": 2.35,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}