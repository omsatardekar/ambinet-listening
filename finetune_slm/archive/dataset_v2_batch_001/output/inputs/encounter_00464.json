{
  "schema_version": "1.0",
  "encounter_id": "00464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.12,
      "duration_seconds": 4.08,
      "text": "Well, hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.84,
      "end_seconds": 8.62,
      "duration_seconds": 2.78,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.82,
      "end_seconds": 14.19,
      "duration_seconds": 4.37,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.53,
      "end_seconds": 18.76,
      "duration_seconds": 3.23,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.1,
      "end_seconds": 32.62,
      "duration_seconds": 12.52,
      "text": "I've been putting on weight over the last year, and I wanted to get it checked. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.04,
      "end_seconds": 36.24,
      "duration_seconds": 2.2,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.28,
      "end_seconds": 43.56,
      "duration_seconds": 6.28,
      "text": "Um, about... well, three weeks. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.92,
      "end_seconds": 44.62,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.72,
      "end_seconds": 50.22,
      "duration_seconds": 4.5,
      "text": "I've also been feeling out of breath on stairs, for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.2,
      "end_seconds": 53.32,
      "duration_seconds": 2.12,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.2,
      "end_seconds": 63.41,
      "duration_seconds": 9.21,
      "text": "I'd give it a four, out of ten. I've also been feeling sleepy in the day, for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.94,
      "end_seconds": 66.49,
      "duration_seconds": 1.55,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.44,
      "end_seconds": 70.12,
      "duration_seconds": 2.68,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.65,
      "end_seconds": 74.9,
      "duration_seconds": 4.25,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.29,
      "end_seconds": 76.1,
      "duration_seconds": 0.81,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.08,
      "end_seconds": 91.56,
      "duration_seconds": 6.48,
      "text": "Alright, I've got it. Let me check a few things. Any irregular periods, increased thirst or palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.14,
      "end_seconds": 97.1,
      "duration_seconds": 3.96,
      "text": "No irregular periods, increased thirst or palpitations, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.17,
      "end_seconds": 100.33,
      "duration_seconds": 2.16,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.31,
      "end_seconds": 105.18,
      "duration_seconds": 1.87,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 109.34,
      "duration_seconds": 2.8,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.76,
      "end_seconds": 110.49,
      "duration_seconds": 0.73,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.72,
      "end_seconds": 123.33,
      "duration_seconds": 6.61,
      "text": "Alright, I've got it. Do you have any known allergies at all? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.23,
      "end_seconds": 127.33,
      "duration_seconds": 3.1,
      "text": "No, um, none that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 134.05,
      "duration_seconds": 5.13,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.52,
      "end_seconds": 144.28,
      "duration_seconds": 8.76,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.65,
      "end_seconds": 146.9,
      "duration_seconds": 2.25,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.45,
      "end_seconds": 151.01,
      "duration_seconds": 2.56,
      "text": "Right, no, never had any surgery."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.6,
      "end_seconds": 156.26,
      "duration_seconds": 3.66,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.13,
      "end_seconds": 161.2,
      "duration_seconds": 4.07,
      "text": "I mean, uh, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.79,
      "end_seconds": 166.54,
      "duration_seconds": 4.75,
      "text": "What medicines do you take regularly? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.04,
      "end_seconds": 175.0,
      "duration_seconds": 6.96,
      "text": "I mean, you know, he takes Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.33,
      "end_seconds": 191.28,
      "duration_seconds": 14.95,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 194.56,
      "duration_seconds": 1.95,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 202.26,
      "duration_seconds": 7.16,
      "text": "What about your general health, any conditions you're being treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.63,
      "end_seconds": 209.62,
      "duration_seconds": 5.99,
      "text": "Yeah, I've had diabetes, yes. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.42,
      "end_seconds": 227.7,
      "duration_seconds": 17.28,
      "text": "Yes, I can see the diabetes in your file as well. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.1,
      "end_seconds": 230.72,
      "duration_seconds": 1.62,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 234.55,
      "duration_seconds": 3.26,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.7,
      "end_seconds": 246.09,
      "duration_seconds": 1.39,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.18,
      "end_seconds": 270.91,
      "duration_seconds": 11.73,
      "text": "Okay: saturation 99 percent, height 158 centimetres, BP is 120 over 76, temperature is 36.5 degrees, pulse is 74 beats a minute, weight 70 kilos. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.67,
      "end_seconds": 277.32,
      "duration_seconds": 5.65,
      "text": "Right, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.1,
      "end_seconds": 283.04,
      "duration_seconds": 2.94,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.67,
      "end_seconds": 286.28,
      "duration_seconds": 1.61,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.89,
      "end_seconds": 301.86,
      "duration_seconds": 2.97,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.45,
      "end_seconds": 303.15,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.1,
      "end_seconds": 324.95,
      "duration_seconds": 15.85,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.1,
      "end_seconds": 340.33,
      "duration_seconds": 13.23,
      "text": "Okay, so yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.99,
      "end_seconds": 354.93,
      "duration_seconds": 13.94,
      "text": "From what you've told me and what I found, my working impression is weight gain with a metabolic cause that needs checking. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.71,
      "end_seconds": 357.3,
      "duration_seconds": 1.59,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.7,
      "end_seconds": 374.85,
      "duration_seconds": 16.15,
      "text": "It's reasonable to be concerned, but right now weight gain with a metabolic cause that needs checking is my leading thought, not anything worse. Let me just recap so I've got it right. You've been putting on weight over the last year for three weeks, and no increased thirst or palpitations."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.9,
      "end_seconds": 377.28,
      "duration_seconds": 1.38,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.08,
      "end_seconds": 380.45,
      "duration_seconds": 2.37,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.08,
      "end_seconds": 384.19,
      "duration_seconds": 3.11,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.74,
      "end_seconds": 389.3,
      "duration_seconds": 3.56,
      "text": "I'm going to order an HbA1c, for weight gain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.23,
      "end_seconds": 392.87,
      "duration_seconds": 2.64,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.92,
      "end_seconds": 396.76,
      "duration_seconds": 2.84,
      "text": "Let's get a lipid profile, for metabolic risk."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.53,
      "end_seconds": 400.56,
      "duration_seconds": 3.03,
      "text": "Okay, so alright. When can I do that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.66,
      "end_seconds": 419.31,
      "duration_seconds": 17.65,
      "text": "Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'd like you to see a dietitian as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.64,
      "end_seconds": 422.79,
      "duration_seconds": 2.15,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.41,
      "end_seconds": 430.49,
      "duration_seconds": 7.08,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.06,
      "end_seconds": 431.76,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.16,
      "end_seconds": 435.08,
      "duration_seconds": 2.92,
      "text": "Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.25,
      "end_seconds": 438.07,
      "duration_seconds": 1.82,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.5,
      "end_seconds": 442.44,
      "duration_seconds": 3.94,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.23,
      "end_seconds": 448.08,
      "duration_seconds": 4.85,
      "text": "So, um, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.5,
      "end_seconds": 453.64,
      "duration_seconds": 4.14,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.95,
      "end_seconds": 457.66,
      "duration_seconds": 3.71,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}