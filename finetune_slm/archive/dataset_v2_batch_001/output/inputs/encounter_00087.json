{
  "schema_version": "1.0",
  "encounter_id": "00087",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.7,
      "duration_seconds": 4.11,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 12.03,
      "duration_seconds": 3.48,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.52,
      "end_seconds": 24.62,
      "duration_seconds": 11.1,
      "text": "Mainly a tight band-like headache. There's a couple of other things, but that's the main one. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.0,
      "end_seconds": 26.63,
      "duration_seconds": 1.63,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.91,
      "end_seconds": 37.78,
      "duration_seconds": 7.87,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.36,
      "end_seconds": 41.11,
      "duration_seconds": 1.75,
      "text": "Any trouble sleeping as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.09,
      "end_seconds": 44.3,
      "duration_seconds": 2.21,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.78,
      "end_seconds": 46.48,
      "duration_seconds": 0.7,
      "text": "Any weakness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.46,
      "end_seconds": 49.51,
      "duration_seconds": 2.05,
      "text": "Not at all, no weakness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.78,
      "end_seconds": 53.81,
      "duration_seconds": 3.03,
      "text": "Any numbness, fever, blurred vision or vomiting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.05,
      "end_seconds": 58.67,
      "duration_seconds": 3.62,
      "text": "No, no numbness, fever, blurred vision or vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.75,
      "end_seconds": 75.18,
      "duration_seconds": 15.43,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.84,
      "end_seconds": 77.4,
      "duration_seconds": 1.56,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.45,
      "end_seconds": 79.78,
      "duration_seconds": 1.33,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.37,
      "end_seconds": 84.66,
      "duration_seconds": 3.29,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.98,
      "end_seconds": 85.92,
      "duration_seconds": 0.94,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.59,
      "end_seconds": 89.24,
      "duration_seconds": 2.65,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.7,
      "end_seconds": 93.74,
      "duration_seconds": 3.04,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.13,
      "end_seconds": 101.2,
      "duration_seconds": 7.07,
      "text": "I've had anxiety for two years now. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.92,
      "end_seconds": 108.61,
      "duration_seconds": 6.69,
      "text": "What medicines are you taking at the moment? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.12,
      "end_seconds": 110.78,
      "duration_seconds": 1.66,
      "text": "Escitalopram, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.92,
      "end_seconds": 113.63,
      "duration_seconds": 1.71,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.87,
      "end_seconds": 119.08,
      "duration_seconds": 4.21,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 122.53,
      "duration_seconds": 2.19,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.23,
      "end_seconds": 125.97,
      "duration_seconds": 2.74,
      "text": "Right, not that I know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.03,
      "end_seconds": 129.11,
      "duration_seconds": 2.08,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.64,
      "end_seconds": 131.12,
      "duration_seconds": 1.48,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.62,
      "end_seconds": 133.84,
      "duration_seconds": 2.22,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.1,
      "end_seconds": 142.61,
      "duration_seconds": 7.51,
      "text": "Busy. Everyone's running in different directions at the moment, you know, you know how it is."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.41,
      "end_seconds": 145.36,
      "duration_seconds": 1.95,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.11,
      "end_seconds": 155.46,
      "duration_seconds": 1.35,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.35,
      "end_seconds": 174.16,
      "duration_seconds": 6.81,
      "text": "Okay: SpO2 99 percent on room air, BP is 116 over 76, heart rate 78. And temperature 36.9."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.94,
      "end_seconds": 176.73,
      "duration_seconds": 1.79,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.34,
      "end_seconds": 180.02,
      "duration_seconds": 2.68,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.69,
      "end_seconds": 184.63,
      "duration_seconds": 1.94,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.23,
      "end_seconds": 188.59,
      "duration_seconds": 2.36,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.77,
      "end_seconds": 208.47,
      "duration_seconds": 2.7,
      "text": "Your eye movements and reflexes are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.63,
      "end_seconds": 212.82,
      "duration_seconds": 3.19,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.59,
      "end_seconds": 235.51,
      "duration_seconds": 3.92,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.2,
      "end_seconds": 237.16,
      "duration_seconds": 0.96,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.13,
      "end_seconds": 255.64,
      "duration_seconds": 12.51,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.62,
      "end_seconds": 272.61,
      "duration_seconds": 15.99,
      "text": "Um, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.95,
      "end_seconds": 288.95,
      "duration_seconds": 15.0,
      "text": "Right, here's what I'm thinking. This looks most like a tension-type headache. The reason I say that is that your story and my examination fit together. Let me just recap so I've got it right. You've had a tight band-like headache, and no vomiting or blurred vision."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.42,
      "end_seconds": 290.9,
      "duration_seconds": 1.48,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.27,
      "end_seconds": 308.93,
      "duration_seconds": 16.66,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.22,
      "end_seconds": 312.19,
      "duration_seconds": 1.97,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.69,
      "end_seconds": 319.78,
      "duration_seconds": 7.09,
      "text": "Let's get an eye check, for headache and eye strain. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.24,
      "end_seconds": 322.26,
      "duration_seconds": 1.02,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.74,
      "end_seconds": 346.56,
      "duration_seconds": 22.82,
      "text": "I'm prescribing amitriptyline, 10 milligrams, at night, for six weeks. That should help with headache prevention. The pharmacy will go through the details again when you pick it up. Painkillers on most days can actually make the headaches stick around. Cut down on salt and fried food for now, it really does make a difference. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.02,
      "end_seconds": 348.5,
      "duration_seconds": 1.48,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.04,
      "end_seconds": 354.96,
      "duration_seconds": 5.92,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.52,
      "end_seconds": 356.22,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.09,
      "end_seconds": 358.99,
      "duration_seconds": 1.9,
      "text": "Come back in a month."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.3,
      "end_seconds": 362.07,
      "duration_seconds": 1.77,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.47,
      "end_seconds": 368.76,
      "duration_seconds": 5.29,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.32,
      "end_seconds": 377.57,
      "duration_seconds": 8.25,
      "text": "So, uh, I take the amitriptyline, 10 milligrams, at night and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.83,
      "end_seconds": 382.16,
      "duration_seconds": 3.33,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.74,
      "end_seconds": 385.6,
      "duration_seconds": 2.86,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}