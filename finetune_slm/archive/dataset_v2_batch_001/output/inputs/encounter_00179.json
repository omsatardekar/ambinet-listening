{
  "schema_version": "1.0",
  "encounter_id": "00179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 5.3,
      "duration_seconds": 4.07,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 9.76,
      "duration_seconds": 3.2,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 17.78,
      "duration_seconds": 6.62,
      "text": "Yeah, it's pain in my left wrist after a fall. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 20.98,
      "duration_seconds": 1.68,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.0,
      "end_seconds": 37.94,
      "duration_seconds": 12.94,
      "text": "Ever since... since Friday, really. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.28,
      "end_seconds": 41.27,
      "duration_seconds": 1.99,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.48,
      "end_seconds": 43.78,
      "duration_seconds": 1.3,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.27,
      "end_seconds": 47.95,
      "duration_seconds": 2.68,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.67,
      "end_seconds": 54.31,
      "duration_seconds": 5.64,
      "text": "It usually comes with swelling. The, The swelling? That's been for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.14,
      "end_seconds": 62.21,
      "duration_seconds": 7.07,
      "text": "Have you had pain in your left wrist after a fall before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.65,
      "end_seconds": 70.52,
      "duration_seconds": 6.87,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.58,
      "end_seconds": 75.05,
      "duration_seconds": 3.47,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.19,
      "end_seconds": 79.15,
      "duration_seconds": 2.96,
      "text": "Uh, yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.77,
      "end_seconds": 83.16,
      "duration_seconds": 3.39,
      "text": "So, have you had any bump to the head?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.24,
      "end_seconds": 87.87,
      "duration_seconds": 3.63,
      "text": "Okay, so no bump to the head, thank goodness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.75,
      "end_seconds": 94.57,
      "duration_seconds": 5.82,
      "text": "Let me check a few things. Any loss of consciousness or pain in the shoulder?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.38,
      "end_seconds": 97.49,
      "duration_seconds": 2.11,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.26,
      "end_seconds": 101.61,
      "duration_seconds": 3.35,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.43,
      "end_seconds": 104.71,
      "duration_seconds": 2.28,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.49,
      "end_seconds": 107.74,
      "duration_seconds": 2.25,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.07,
      "end_seconds": 114.2,
      "duration_seconds": 2.13,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.43,
      "end_seconds": 117.9,
      "duration_seconds": 2.47,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.78,
      "end_seconds": 121.16,
      "duration_seconds": 2.38,
      "text": "It's, It's perfect, thank you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.73,
      "end_seconds": 125.88,
      "duration_seconds": 3.15,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.7,
      "end_seconds": 132.79,
      "duration_seconds": 4.09,
      "text": "Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.13,
      "end_seconds": 133.83,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.44,
      "end_seconds": 142.66,
      "duration_seconds": 8.22,
      "text": "It's aspirin, 75 milligrams, once a day. My sister suggested writing things down, but I forgot. Paracetamol. I take it when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.2,
      "end_seconds": 145.83,
      "duration_seconds": 1.63,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.2,
      "end_seconds": 147.1,
      "duration_seconds": 0.9,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.48,
      "end_seconds": 152.38,
      "duration_seconds": 3.9,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.23,
      "end_seconds": 153.93,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.06,
      "end_seconds": 167.36,
      "duration_seconds": 2.3,
      "text": "Right, thanks for waiting. What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.46,
      "end_seconds": 172.36,
      "duration_seconds": 3.9,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 176.08,
      "duration_seconds": 3.35,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.5,
      "end_seconds": 190.53,
      "duration_seconds": 13.03,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.17,
      "end_seconds": 192.13,
      "duration_seconds": 0.96,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.34,
      "end_seconds": 196.55,
      "duration_seconds": 3.21,
      "text": "Just my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.21,
      "end_seconds": 200.78,
      "duration_seconds": 3.57,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.25,
      "end_seconds": 202.0,
      "duration_seconds": 0.75,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.19,
      "end_seconds": 222.67,
      "duration_seconds": 6.48,
      "text": "Alright, I've got it. Alright, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.99,
      "end_seconds": 226.06,
      "duration_seconds": 2.07,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 230.99,
      "duration_seconds": 3.46,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.83,
      "end_seconds": 232.67,
      "duration_seconds": 0.84,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.3,
      "end_seconds": 252.72,
      "duration_seconds": 5.42,
      "text": "Right, thanks for waiting. Right, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.55,
      "end_seconds": 259.06,
      "duration_seconds": 5.51,
      "text": "Yes, thin bones. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.21,
      "end_seconds": 260.91,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.35,
      "end_seconds": 264.98,
      "duration_seconds": 3.63,
      "text": "Um, I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.43,
      "end_seconds": 271.34,
      "duration_seconds": 5.91,
      "text": "Okay, thin bones, that's already on your record. Good to know. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.36,
      "end_seconds": 275.01,
      "duration_seconds": 2.65,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.47,
      "end_seconds": 277.58,
      "duration_seconds": 2.11,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.88,
      "end_seconds": 292.34,
      "duration_seconds": 1.46,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.07,
      "end_seconds": 310.37,
      "duration_seconds": 5.3,
      "text": "Okay: BP is 119 over 81, oxygen saturation is 99 percent, pulse 65, temperature 36.7."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.36,
      "end_seconds": 313.98,
      "duration_seconds": 2.62,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.82,
      "end_seconds": 315.68,
      "duration_seconds": 0.86,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.58,
      "end_seconds": 342.48,
      "duration_seconds": 17.9,
      "text": "Right, thanks for waiting. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.82,
      "end_seconds": 344.64,
      "duration_seconds": 1.82,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.91,
      "end_seconds": 362.24,
      "duration_seconds": 16.33,
      "text": "Right, here's what I'm thinking. My working impression is a wrist sprain, but a small fracture is possible. Let me just recap so I've got it right. You've had pain in your left wrist after a fall, since Friday, severe, and no pain in the shoulder or bump to the head."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.58,
      "end_seconds": 365.56,
      "duration_seconds": 1.98,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.44,
      "end_seconds": 369.31,
      "duration_seconds": 2.87,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.06,
      "end_seconds": 385.86,
      "duration_seconds": 15.8,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.58,
      "end_seconds": 390.89,
      "duration_seconds": 4.31,
      "text": "I'd like to arrange an X-ray of the wrist for wrist injury."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 392.77,
      "end_seconds": 395.08,
      "duration_seconds": 2.31,
      "text": "The earliest is Wednesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.67,
      "end_seconds": 398.4,
      "duration_seconds": 2.73,
      "text": "Okay, uh, I'll be there."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.75,
      "end_seconds": 425.13,
      "duration_seconds": 25.38,
      "text": "I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Please take the tablets with food so they don't upset your stomach. I'll also refer you to the orthopaedic clinic. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Please come and see me in a week."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.64,
      "end_seconds": 433.31,
      "duration_seconds": 6.67,
      "text": "Okay, before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.94,
      "end_seconds": 439.09,
      "duration_seconds": 5.15,
      "text": "So, uh, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.17,
      "end_seconds": 445.29,
      "duration_seconds": 5.12,
      "text": "Okay, yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.72,
      "end_seconds": 448.34,
      "duration_seconds": 2.62,
      "text": "No, you've explained it well. Thanks."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.1,
      "end_seconds": 451.82,
      "duration_seconds": 0.72,
      "text": "Take care."
    }
  ]
}