{
  "schema_version": "1.0",
  "encounter_id": "00054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.73,
      "end_seconds": 2.08,
      "duration_seconds": 1.35,
      "text": "Hello, please sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.21,
      "end_seconds": 6.04,
      "duration_seconds": 0.83,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 8.98,
      "duration_seconds": 1.44,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.63,
      "end_seconds": 12.65,
      "duration_seconds": 3.02,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.33,
      "end_seconds": 15.06,
      "duration_seconds": 1.73,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.61,
      "end_seconds": 29.85,
      "duration_seconds": 13.24,
      "text": "Mainly a weak urine stream. There's a couple of other things, but that's the main one. I kept putting it off, which I know isn't sensible. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.06,
      "end_seconds": 35.74,
      "duration_seconds": 2.68,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.07,
      "end_seconds": 43.5,
      "duration_seconds": 7.43,
      "text": "I've had it for two years. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.0,
      "end_seconds": 47.08,
      "duration_seconds": 3.08,
      "text": "Alright, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 50.51,
      "duration_seconds": 2.44,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 56.68,
      "duration_seconds": 3.93,
      "text": "Have you had any blood in the urine or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.74,
      "end_seconds": 60.1,
      "duration_seconds": 2.36,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.67,
      "end_seconds": 63.57,
      "duration_seconds": 2.9,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.15,
      "end_seconds": 64.88,
      "duration_seconds": 0.73,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.56,
      "end_seconds": 85.7,
      "duration_seconds": 5.14,
      "text": "Alright, I've got it. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.66,
      "end_seconds": 87.38,
      "duration_seconds": 0.72,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.06,
      "end_seconds": 91.67,
      "duration_seconds": 3.61,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.51,
      "end_seconds": 105.61,
      "duration_seconds": 13.1,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.95,
      "end_seconds": 108.81,
      "duration_seconds": 2.86,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.5,
      "end_seconds": 115.75,
      "duration_seconds": 6.25,
      "text": "Ramipril, 5 milligrams, every morning. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.36,
      "end_seconds": 118.84,
      "duration_seconds": 2.48,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.26,
      "end_seconds": 121.64,
      "duration_seconds": 1.38,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.81,
      "end_seconds": 126.57,
      "duration_seconds": 3.76,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.26,
      "end_seconds": 129.52,
      "duration_seconds": 2.26,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.8,
      "end_seconds": 139.05,
      "duration_seconds": 8.25,
      "text": "Go on. Right, so that's your known high blood pressure. We'll keep that in mind today. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.52,
      "end_seconds": 152.42,
      "duration_seconds": 11.9,
      "text": "So, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.12,
      "end_seconds": 169.77,
      "duration_seconds": 14.65,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.11,
      "end_seconds": 175.48,
      "duration_seconds": 4.37,
      "text": "Okay, so good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.46,
      "end_seconds": 181.3,
      "duration_seconds": 2.84,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.88,
      "end_seconds": 182.58,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.96,
      "end_seconds": 186.91,
      "duration_seconds": 2.95,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.76,
      "end_seconds": 200.93,
      "duration_seconds": 3.17,
      "text": "Your bladder isn't palpable and the tummy is soft."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 204.35,
      "duration_seconds": 2.03,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.26,
      "end_seconds": 226.46,
      "duration_seconds": 3.2,
      "text": "On rectal examination the prostate feels smooth and enlarged."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.36,
      "end_seconds": 252.25,
      "duration_seconds": 22.89,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.7,
      "end_seconds": 255.83,
      "duration_seconds": 3.13,
      "text": "Okay, so thank you, that really helps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.33,
      "end_seconds": 277.9,
      "duration_seconds": 20.57,
      "text": "Okay, so my impression is this: My working impression is an enlarged prostate causing urinary symptoms. I want to be honest that this is an impression, not a final answer. Let me just recap so I've got it right. You've had a weak urine stream for two years, and no weight loss or blood in the urine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.97,
      "end_seconds": 281.12,
      "duration_seconds": 2.15,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.03,
      "end_seconds": 286.34,
      "duration_seconds": 4.31,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.3,
      "end_seconds": 290.26,
      "duration_seconds": 2.96,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.54,
      "end_seconds": 308.72,
      "duration_seconds": 17.18,
      "text": "We should do an ultrasound of the bladder and prostate for urinary symptoms. It's a routine test and it'll give us a much clearer picture. I'd like you to take tamsulosin, 0.4 milligrams, at night, for four weeks. It's for urinary symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.26,
      "end_seconds": 313.26,
      "duration_seconds": 3.0,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.32,
      "end_seconds": 326.94,
      "duration_seconds": 12.62,
      "text": "Cut back on tea and coffee after the afternoon and go before you sleep. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 333.17,
      "duration_seconds": 5.9,
      "text": "I see. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.16,
      "end_seconds": 334.86,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.69,
      "end_seconds": 344.08,
      "duration_seconds": 8.39,
      "text": "Come back after the results are back. Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.65,
      "end_seconds": 357.22,
      "duration_seconds": 8.57,
      "text": "So, I take the tamsulosin, 0.4 milligrams, at night and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.49,
      "end_seconds": 362.76,
      "duration_seconds": 4.27,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.8,
      "end_seconds": 365.75,
      "duration_seconds": 1.95,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}