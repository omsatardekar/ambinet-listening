{
  "schema_version": "1.0",
  "encounter_id": "00093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 6.97,
      "duration_seconds": 6.07,
      "text": "Um, doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.51,
      "end_seconds": 11.76,
      "duration_seconds": 3.25,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.31,
      "end_seconds": 17.49,
      "duration_seconds": 5.18,
      "text": "Um, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.98,
      "end_seconds": 22.84,
      "duration_seconds": 3.86,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.9,
      "end_seconds": 28.39,
      "duration_seconds": 4.49,
      "text": "Doctor, it's pimples on my face. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.76,
      "end_seconds": 32.15,
      "duration_seconds": 3.39,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.68,
      "end_seconds": 46.93,
      "duration_seconds": 14.25,
      "text": "It's been four weeks now. I thought it would sort itself out, you know, but it hasn't. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.4,
      "end_seconds": 50.85,
      "duration_seconds": 2.45,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.95,
      "end_seconds": 59.07,
      "duration_seconds": 4.12,
      "text": "Oily skin goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.23,
      "end_seconds": 62.47,
      "duration_seconds": 2.24,
      "text": "Have you had flare-ups before your period?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.41,
      "end_seconds": 70.73,
      "duration_seconds": 7.32,
      "text": "Yes, um, for four weeks. I've had painful lumps on the chin too, for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.54,
      "end_seconds": 77.74,
      "duration_seconds": 3.2,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.91,
      "end_seconds": 81.51,
      "duration_seconds": 2.6,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.76,
      "end_seconds": 84.92,
      "duration_seconds": 2.16,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.59,
      "end_seconds": 86.69,
      "duration_seconds": 1.1,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.47,
      "end_seconds": 89.63,
      "duration_seconds": 2.16,
      "text": "Any irregular periods or scarring at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.57,
      "end_seconds": 96.42,
      "duration_seconds": 1.85,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.03,
      "end_seconds": 100.29,
      "duration_seconds": 3.26,
      "text": "Any new face cream, excess hair growth or pregnancy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.67,
      "end_seconds": 107.03,
      "duration_seconds": 5.36,
      "text": "Um, I haven't had new face cream, excess hair growth or pregnancy, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.96,
      "end_seconds": 109.81,
      "duration_seconds": 1.85,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.4,
      "end_seconds": 111.52,
      "duration_seconds": 1.12,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.08,
      "end_seconds": 114.98,
      "duration_seconds": 1.9,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.48,
      "end_seconds": 118.39,
      "duration_seconds": 1.91,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.98,
      "end_seconds": 120.78,
      "duration_seconds": 1.8,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.94,
      "end_seconds": 124.94,
      "duration_seconds": 3.0,
      "text": "No, you know, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.31,
      "end_seconds": 129.52,
      "duration_seconds": 3.21,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.53,
      "end_seconds": 142.74,
      "duration_seconds": 9.21,
      "text": "Oh, um, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.37,
      "end_seconds": 145.08,
      "duration_seconds": 1.71,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.37,
      "end_seconds": 152.68,
      "duration_seconds": 6.31,
      "text": "Just a knee arthroscopy, three years ago. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.38,
      "end_seconds": 156.27,
      "duration_seconds": 2.89,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.68,
      "end_seconds": 160.22,
      "duration_seconds": 3.54,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.52,
      "end_seconds": 164.34,
      "duration_seconds": 3.82,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.33,
      "end_seconds": 173.09,
      "duration_seconds": 5.76,
      "text": "Well, I have heart failure. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.63,
      "end_seconds": 174.68,
      "duration_seconds": 1.05,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.33,
      "end_seconds": 177.96,
      "duration_seconds": 2.63,
      "text": "An enlarged prostate, for two years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.17,
      "end_seconds": 187.05,
      "duration_seconds": 7.88,
      "text": "Yes, I can see the heart failure in your file as well. So, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.67,
      "end_seconds": 191.88,
      "duration_seconds": 4.21,
      "text": "I take spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 192.21,
      "end_seconds": 199.84,
      "duration_seconds": 7.63,
      "text": "Doctor, I think the last prescription for the spironolactone was 12.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.32,
      "end_seconds": 205.07,
      "duration_seconds": 3.75,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.6,
      "end_seconds": 212.65,
      "duration_seconds": 7.05,
      "text": "Not with me. I'll bring it next time. I take tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.7,
      "end_seconds": 230.08,
      "duration_seconds": 16.38,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.67,
      "end_seconds": 233.19,
      "duration_seconds": 2.52,
      "text": "Okay, you know, that makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.92,
      "end_seconds": 239.38,
      "duration_seconds": 1.46,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.27,
      "end_seconds": 243.73,
      "duration_seconds": 3.46,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.54,
      "end_seconds": 250.51,
      "duration_seconds": 1.97,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.02,
      "end_seconds": 262.27,
      "duration_seconds": 1.25,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.89,
      "end_seconds": 286.94,
      "duration_seconds": 5.05,
      "text": "Okay: pulse 79, blood pressure 128 over 77, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.37,
      "end_seconds": 289.54,
      "duration_seconds": 1.17,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.86,
      "end_seconds": 292.61,
      "duration_seconds": 2.75,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.04,
      "end_seconds": 297.66,
      "duration_seconds": 3.62,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.36,
      "end_seconds": 299.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.17,
      "end_seconds": 314.83,
      "duration_seconds": 1.66,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.01,
      "end_seconds": 319.87,
      "duration_seconds": 2.86,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.36,
      "end_seconds": 324.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.23,
      "end_seconds": 326.88,
      "duration_seconds": 1.65,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.07,
      "end_seconds": 342.07,
      "duration_seconds": 6.0,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.15,
      "end_seconds": 358.81,
      "duration_seconds": 11.66,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.17,
      "end_seconds": 362.58,
      "duration_seconds": 2.41,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.45,
      "end_seconds": 365.39,
      "duration_seconds": 1.94,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.64,
      "end_seconds": 395.17,
      "duration_seconds": 23.53,
      "text": "Alright, I've got it. Putting it all together, I think we're dealing with moderate acne at this stage. The reason I say that is that your story and my examination fit together. I can't rule out a hormonal cause yet. Let me just recap so I've got it right. You've had pimples on your face for four weeks, and no new face cream or scarring."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.05,
      "end_seconds": 397.52,
      "duration_seconds": 1.47,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.55,
      "end_seconds": 423.25,
      "duration_seconds": 24.7,
      "text": "I'll start you on doxycycline, 100 milligrams, once a day, for six weeks. You take it by mouth. That's for acne. It takes six to eight weeks to see the difference, so please don't give up in the first fortnight. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.64,
      "end_seconds": 431.52,
      "duration_seconds": 6.88,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.96,
      "end_seconds": 433.36,
      "duration_seconds": 1.4,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.01,
      "end_seconds": 442.94,
      "duration_seconds": 8.93,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department. Please come and see me in eight weeks."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.12,
      "end_seconds": 448.05,
      "duration_seconds": 3.93,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.96,
      "end_seconds": 453.33,
      "duration_seconds": 4.37,
      "text": "Okay, just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 454.58,
      "end_seconds": 463.22,
      "duration_seconds": 8.64,
      "text": "So, I take the doxycycline, 100 milligrams, once a day and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 467.49,
      "end_seconds": 471.31,
      "duration_seconds": 3.82,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 471.98,
      "end_seconds": 475.61,
      "duration_seconds": 3.63,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}