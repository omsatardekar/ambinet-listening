{
  "schema_version": "1.0",
  "encounter_id": "00495",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 6.62,
      "duration_seconds": 5.3,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.96,
      "end_seconds": 10.78,
      "duration_seconds": 2.82,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 20.49,
      "duration_seconds": 8.99,
      "text": "I wanted to get burning when I pass urine looked at. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 22.89,
      "duration_seconds": 2.07,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.69,
      "end_seconds": 25.23,
      "duration_seconds": 1.54,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.67,
      "end_seconds": 31.17,
      "duration_seconds": 3.5,
      "text": "Right, have you been needing to go all the time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.25,
      "end_seconds": 38.43,
      "duration_seconds": 3.18,
      "text": "Hmm, yeah. Five days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.81,
      "end_seconds": 42.86,
      "duration_seconds": 3.05,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.46,
      "end_seconds": 61.88,
      "duration_seconds": 17.42,
      "text": "Um, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.18,
      "end_seconds": 65.15,
      "duration_seconds": 1.97,
      "text": "Any vomiting, fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.96,
      "end_seconds": 68.77,
      "duration_seconds": 2.81,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.98,
      "end_seconds": 69.68,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.99,
      "end_seconds": 75.12,
      "duration_seconds": 4.13,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.6,
      "end_seconds": 76.3,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.39,
      "end_seconds": 93.74,
      "duration_seconds": 2.35,
      "text": "Right, thanks for waiting. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.17,
      "end_seconds": 99.39,
      "duration_seconds": 4.22,
      "text": "Yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.44,
      "end_seconds": 115.92,
      "duration_seconds": 15.48,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.72,
      "end_seconds": 118.96,
      "duration_seconds": 2.24,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.21,
      "end_seconds": 122.15,
      "duration_seconds": 1.94,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.22,
      "end_seconds": 124.1,
      "duration_seconds": 0.88,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.43,
      "end_seconds": 127.55,
      "duration_seconds": 3.12,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.08,
      "end_seconds": 130.28,
      "duration_seconds": 1.2,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.83,
      "end_seconds": 133.95,
      "duration_seconds": 3.12,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.13,
      "end_seconds": 136.02,
      "duration_seconds": 0.89,
      "text": "Yes, ibuprofen."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.6,
      "end_seconds": 142.94,
      "duration_seconds": 5.34,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 153.96,
      "duration_seconds": 10.54,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.53,
      "end_seconds": 158.26,
      "duration_seconds": 3.73,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.46,
      "end_seconds": 161.78,
      "duration_seconds": 2.32,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.68,
      "end_seconds": 165.88,
      "duration_seconds": 3.2,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 178.78,
      "duration_seconds": 3.88,
      "text": "Okay, continuing. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.49,
      "end_seconds": 183.67,
      "duration_seconds": 4.18,
      "text": "Oh, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.56,
      "end_seconds": 187.07,
      "duration_seconds": 2.51,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.42,
      "end_seconds": 190.27,
      "duration_seconds": 2.85,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.63,
      "end_seconds": 205.2,
      "duration_seconds": 13.57,
      "text": "So, based on your history, this looks most like a urinary tract infection. Let me just recap so I've got it right. You've had burning when you pass urine for two days, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.05,
      "end_seconds": 208.03,
      "duration_seconds": 1.98,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.93,
      "end_seconds": 212.98,
      "duration_seconds": 4.05,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.28,
      "end_seconds": 227.43,
      "duration_seconds": 13.15,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.75,
      "end_seconds": 249.16,
      "duration_seconds": 20.41,
      "text": "We should do a urine test for urinary symptoms. It's a routine test and it'll give us a much clearer picture. Let's use nitrofurantoin, 100 milligrams, twice a day, for five days. That should help with urine infection. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.82,
      "end_seconds": 251.58,
      "duration_seconds": 1.76,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.16,
      "end_seconds": 270.2,
      "duration_seconds": 17.04,
      "text": "Drink plenty of water and don't hold it in when you need to go. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I want you to come back or go to emergency straight away if you get a fever, back pain or vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.51,
      "end_seconds": 272.24,
      "duration_seconds": 1.73,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.22,
      "end_seconds": 275.71,
      "duration_seconds": 2.49,
      "text": "Please come and see me in a week."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.93,
      "end_seconds": 280.94,
      "duration_seconds": 4.01,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.91,
      "end_seconds": 285.83,
      "duration_seconds": 3.92,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.33,
      "end_seconds": 295.09,
      "duration_seconds": 8.76,
      "text": "So, uh, I take the nitrofurantoin, 100 milligrams, twice a day and come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.82,
      "end_seconds": 299.9,
      "duration_seconds": 4.08,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.66,
      "end_seconds": 304.23,
      "duration_seconds": 3.57,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.6,
      "end_seconds": 306.35,
      "duration_seconds": 0.75,
      "text": "Alright, goodbye."
    }
  ]
}