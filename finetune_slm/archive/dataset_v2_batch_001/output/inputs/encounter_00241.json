{
  "schema_version": "1.0",
  "encounter_id": "00241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 3.61,
      "duration_seconds": 3.0,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.87,
      "end_seconds": 5.57,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.0,
      "end_seconds": 11.97,
      "duration_seconds": 1.97,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 15.24,
      "duration_seconds": 2.3,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.61,
      "end_seconds": 18.47,
      "duration_seconds": 1.86,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.36,
      "end_seconds": 27.77,
      "duration_seconds": 6.41,
      "text": "Doctor, it's a red swollen area on my leg. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.71,
      "end_seconds": 31.65,
      "duration_seconds": 2.94,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.18,
      "end_seconds": 38.56,
      "duration_seconds": 5.38,
      "text": "It's been two weeks now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.07,
      "end_seconds": 47.03,
      "duration_seconds": 6.96,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.39,
      "end_seconds": 52.38,
      "duration_seconds": 4.99,
      "text": "It happens once or twice a day. I notice it more with walking."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.74,
      "end_seconds": 57.97,
      "duration_seconds": 2.23,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.49,
      "end_seconds": 63.76,
      "duration_seconds": 5.27,
      "text": "It usually comes with a fever. The fever? That's been for ten days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.28,
      "end_seconds": 67.52,
      "duration_seconds": 3.24,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.43,
      "end_seconds": 79.93,
      "duration_seconds": 11.5,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.9,
      "end_seconds": 84.56,
      "duration_seconds": 3.66,
      "text": "Have you had any calf pain, shortness of breath or pus?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.95,
      "end_seconds": 89.56,
      "duration_seconds": 4.61,
      "text": "No calf pain, shortness of breath or pus, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 91.71,
      "duration_seconds": 1.12,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.56,
      "end_seconds": 95.91,
      "duration_seconds": 3.35,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.52,
      "end_seconds": 97.52,
      "duration_seconds": 1.0,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.71,
      "end_seconds": 102.52,
      "duration_seconds": 3.81,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.41,
      "end_seconds": 105.59,
      "duration_seconds": 2.18,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.03,
      "end_seconds": 108.72,
      "duration_seconds": 2.69,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.24,
      "end_seconds": 113.32,
      "duration_seconds": 4.08,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 134.55,
      "duration_seconds": 6.53,
      "text": "Alright, back to you. Do you have any medical conditions I should know about? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.59,
      "end_seconds": 138.27,
      "duration_seconds": 2.68,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.42,
      "end_seconds": 143.58,
      "duration_seconds": 4.16,
      "text": "Right, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.98,
      "end_seconds": 145.76,
      "duration_seconds": 0.78,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.55,
      "end_seconds": 149.6,
      "duration_seconds": 3.05,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.41,
      "end_seconds": 160.74,
      "duration_seconds": 1.33,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.04,
      "end_seconds": 193.59,
      "duration_seconds": 12.55,
      "text": "Okay: height 173 centimetres, SpO2 95 percent on room air, BP is 122 over 71, pulse 101, weight 56 kilos, temperature is 38.8 degrees. Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.63,
      "end_seconds": 198.1,
      "duration_seconds": 3.47,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.76,
      "end_seconds": 208.35,
      "duration_seconds": 9.59,
      "text": "Right, here's what I'm thinking. This looks most like cellulitis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.0,
      "end_seconds": 211.21,
      "duration_seconds": 2.21,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.41,
      "end_seconds": 226.49,
      "duration_seconds": 14.08,
      "text": "I can't promise yet, but most people with cellulitis do well once it's treated properly. Let me just recap so I've got it right. You've had a red swollen area on your leg for two weeks, and no pus or shortness of breath."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.71,
      "end_seconds": 229.1,
      "duration_seconds": 1.39,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 243.75,
      "duration_seconds": 14.17,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.79,
      "end_seconds": 249.73,
      "duration_seconds": 1.94,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 266.03,
      "duration_seconds": 15.03,
      "text": "Let's get a wound swab, for infected wound. I'd like you to take clindamycin, 300 milligrams, three times a day, for seven days. That should help with skin infection. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.37,
      "end_seconds": 269.37,
      "duration_seconds": 3.0,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.69,
      "end_seconds": 288.97,
      "duration_seconds": 19.28,
      "text": "Mark the edge of the redness with a pen so we can see whether it spreads. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please don't sit on it if the redness spreads or the fever gets higher. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.28,
      "end_seconds": 291.61,
      "duration_seconds": 1.33,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.97,
      "end_seconds": 294.83,
      "duration_seconds": 2.86,
      "text": "Please come and see me in two days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.59,
      "end_seconds": 296.29,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.8,
      "end_seconds": 304.39,
      "duration_seconds": 6.59,
      "text": "Right, just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.09,
      "end_seconds": 314.24,
      "duration_seconds": 9.15,
      "text": "So, I take the clindamycin, 300 milligrams, three times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.29,
      "end_seconds": 319.61,
      "duration_seconds": 4.32,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.07,
      "end_seconds": 322.56,
      "duration_seconds": 1.49,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.37,
      "end_seconds": 324.9,
      "duration_seconds": 1.53,
      "text": "Alright, see you then."
    }
  ]
}