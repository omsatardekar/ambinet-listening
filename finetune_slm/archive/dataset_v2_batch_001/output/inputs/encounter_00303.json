{
  "schema_version": "1.0",
  "encounter_id": "00303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.51,
      "end_seconds": 3.98,
      "duration_seconds": 3.47,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.68,
      "end_seconds": 8.24,
      "duration_seconds": 3.56,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.54,
      "end_seconds": 15.67,
      "duration_seconds": 7.13,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. He's been having a bad cough, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.94,
      "end_seconds": 19.17,
      "duration_seconds": 2.23,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.53,
      "end_seconds": 22.91,
      "duration_seconds": 2.38,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.21,
      "end_seconds": 25.18,
      "duration_seconds": 1.97,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.39,
      "end_seconds": 31.63,
      "duration_seconds": 5.24,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.8,
      "end_seconds": 37.08,
      "duration_seconds": 4.28,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.59,
      "end_seconds": 40.09,
      "duration_seconds": 2.5,
      "text": "About a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.24,
      "end_seconds": 43.57,
      "duration_seconds": 2.33,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.16,
      "end_seconds": 48.58,
      "duration_seconds": 3.42,
      "text": "Cold air and lying down definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.11,
      "end_seconds": 51.65,
      "duration_seconds": 1.54,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.21,
      "end_seconds": 59.06,
      "duration_seconds": 5.85,
      "text": "Um, it's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.83,
      "end_seconds": 65.53,
      "duration_seconds": 5.7,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.02,
      "end_seconds": 68.81,
      "duration_seconds": 1.79,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.64,
      "end_seconds": 75.64,
      "duration_seconds": 6.0,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 75.74,
      "end_seconds": 79.71,
      "duration_seconds": 3.97,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.96,
      "end_seconds": 82.98,
      "duration_seconds": 2.02,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.32,
      "end_seconds": 85.35,
      "duration_seconds": 2.03,
      "text": "Any a low fever as well?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.39,
      "end_seconds": 88.76,
      "duration_seconds": 2.37,
      "text": "Yeah. Two days, I'd say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.25,
      "end_seconds": 92.44,
      "duration_seconds": 2.19,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 94.83,
      "end_seconds": 99.92,
      "duration_seconds": 5.09,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.82,
      "end_seconds": 105.69,
      "duration_seconds": 4.87,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.64,
      "end_seconds": 118.97,
      "duration_seconds": 12.33,
      "text": "About a eight out of ten. As for tight chest, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.81,
      "end_seconds": 126.52,
      "duration_seconds": 6.71,
      "text": "Okay, give me more detail on it, whatever comes to mind. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.17,
      "end_seconds": 130.16,
      "duration_seconds": 2.99,
      "text": "It's severe, honestly. Honestly, all the time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.72,
      "end_seconds": 140.65,
      "duration_seconds": 6.93,
      "text": "Let me check a few things. Any weight loss, shortness of breath, chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.11,
      "end_seconds": 153.85,
      "duration_seconds": 11.74,
      "text": "No, you know, no weight loss, no shortness of breath, no chest pain. I did have a sore throat at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.38,
      "end_seconds": 157.47,
      "duration_seconds": 2.09,
      "text": "Have you had any leg swelling?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.04,
      "end_seconds": 161.67,
      "duration_seconds": 2.63,
      "text": "No, I haven't had any leg swelling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.38,
      "end_seconds": 164.04,
      "duration_seconds": 1.66,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.59,
      "end_seconds": 167.2,
      "duration_seconds": 1.61,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 168.09,
      "end_seconds": 181.5,
      "duration_seconds": 13.41,
      "text": "Here are the numbers, doctor. Pulse is 96 beats a minute, temperature is 38.7 degrees, weight 55 kilos. Pressure 123 over 69, respiratory rate 18, oxygen saturation is 95 percent, height 157 centimetres."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.86,
      "end_seconds": 184.78,
      "duration_seconds": 2.92,
      "text": "Thanks. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.64,
      "end_seconds": 190.2,
      "duration_seconds": 4.56,
      "text": "Oh, um, it's ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.34,
      "end_seconds": 193.98,
      "duration_seconds": 2.64,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.02,
      "end_seconds": 202.12,
      "duration_seconds": 7.1,
      "text": "Not with me. I'll bring it next time. I'm on Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.83,
      "end_seconds": 209.68,
      "duration_seconds": 5.85,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.5,
      "end_seconds": 212.59,
      "duration_seconds": 2.09,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.76,
      "end_seconds": 225.6,
      "duration_seconds": 11.84,
      "text": "For the reflux, I believe. My son sets them out for me, I just take what I'm given. I'm on clopidogrel, once a day for the stent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 228.75,
      "duration_seconds": 1.59,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.32,
      "end_seconds": 230.42,
      "duration_seconds": 1.1,
      "text": "It's 75 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.66,
      "end_seconds": 234.28,
      "duration_seconds": 2.62,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.12,
      "end_seconds": 236.55,
      "duration_seconds": 1.43,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.97,
      "end_seconds": 240.74,
      "duration_seconds": 3.77,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.87,
      "end_seconds": 256.42,
      "duration_seconds": 14.55,
      "text": "I've had high blood pressure for five years now. I have asthma, for nearly five years. I wasn't sure whether to come in at all, to be honest. I've got acid reflux. Yes, heart disease."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.56,
      "end_seconds": 266.62,
      "duration_seconds": 8.06,
      "text": "Okay, asthma, that's already on your record. Good to know. Okay, heart disease, that's already on your record. Good to know. What about alcohol?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.97,
      "end_seconds": 270.42,
      "duration_seconds": 3.45,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.98,
      "end_seconds": 271.95,
      "duration_seconds": 0.97,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.63,
      "end_seconds": 276.61,
      "duration_seconds": 3.98,
      "text": "Yes, I had a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.08,
      "end_seconds": 280.82,
      "duration_seconds": 3.74,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.8,
      "end_seconds": 283.77,
      "duration_seconds": 1.97,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.22,
      "end_seconds": 287.31,
      "duration_seconds": 3.09,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.27,
      "end_seconds": 289.16,
      "duration_seconds": 0.89,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.55,
      "end_seconds": 294.29,
      "duration_seconds": 3.74,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.03,
      "end_seconds": 298.16,
      "duration_seconds": 2.13,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.21,
      "end_seconds": 318.63,
      "duration_seconds": 3.42,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.93,
      "end_seconds": 321.54,
      "duration_seconds": 1.61,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.36,
      "end_seconds": 339.9,
      "duration_seconds": 1.54,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.77,
      "end_seconds": 357.03,
      "duration_seconds": 13.26,
      "text": "All done, thank you, please sit down. Okay, so my impression is this: It fits best with a chest infection, probably viral. That's my thinking for now, and it may change as we learn more. I'd also keep pneumonia in mind."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.2,
      "end_seconds": 362.15,
      "duration_seconds": 1.95,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.06,
      "end_seconds": 377.67,
      "duration_seconds": 14.61,
      "text": "It's reasonable to be concerned, but right now a chest infection, probably viral is my leading thought, not anything worse. We should do blood tests for cough. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 379.12,
      "end_seconds": 382.0,
      "duration_seconds": 2.88,
      "text": "We've already done a chest X-ray this morning, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.14,
      "end_seconds": 397.91,
      "duration_seconds": 14.77,
      "text": "Good, thank you. I'd like you to take azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. That should help with chest infection. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.39,
      "end_seconds": 401.2,
      "duration_seconds": 2.81,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.74,
      "end_seconds": 419.64,
      "duration_seconds": 17.9,
      "text": "I'll start you on salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. It's for wheeze. The pharmacy will go through the details again when you pick it up. Steam and warm fluids can ease the cough, and try to sleep with your head propped up."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.02,
      "end_seconds": 436.15,
      "duration_seconds": 16.13,
      "text": "Alright. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 437.49,
      "end_seconds": 438.8,
      "duration_seconds": 1.31,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.55,
      "end_seconds": 451.13,
      "duration_seconds": 11.58,
      "text": "Please don't sit on it if you become breathless or cough up blood. That's the point to get seen urgently. Come back in ten days. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 452.63,
      "end_seconds": 456.1,
      "duration_seconds": 3.47,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}