{
  "schema_version": "1.0",
  "encounter_id": "00460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 6.41,
      "duration_seconds": 5.56,
      "text": "Um, uh, hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 12.17,
      "duration_seconds": 4.67,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 23.46,
      "duration_seconds": 9.71,
      "text": "Doctor, it's a cough. It's getting on my nerves now. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.66,
      "end_seconds": 26.94,
      "duration_seconds": 2.28,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.19,
      "end_seconds": 36.54,
      "duration_seconds": 8.35,
      "text": "It's, It's been about four days now. I thought it would sort itself out, uh, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.96,
      "end_seconds": 39.21,
      "duration_seconds": 2.25,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.26,
      "end_seconds": 41.69,
      "duration_seconds": 1.43,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.92,
      "end_seconds": 45.95,
      "duration_seconds": 3.03,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.1,
      "end_seconds": 48.9,
      "duration_seconds": 1.8,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 52.58,
      "duration_seconds": 2.44,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.07,
      "end_seconds": 57.02,
      "duration_seconds": 3.95,
      "text": "I get some relief from honey and warm water."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.45,
      "end_seconds": 61.36,
      "duration_seconds": 2.91,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.03,
      "end_seconds": 69.35,
      "duration_seconds": 7.32,
      "text": "Okay, you know, so when it starts I tend to get a low fever as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.59,
      "end_seconds": 73.99,
      "duration_seconds": 3.4,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.37,
      "end_seconds": 77.83,
      "duration_seconds": 2.46,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.96,
      "end_seconds": 81.48,
      "duration_seconds": 2.52,
      "text": "Has there been a sore throat too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.06,
      "end_seconds": 86.67,
      "duration_seconds": 3.61,
      "text": "Yeah, yes, about the same, two days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.79,
      "end_seconds": 90.86,
      "duration_seconds": 3.07,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.02,
      "end_seconds": 103.36,
      "duration_seconds": 11.34,
      "text": "Um, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.21,
      "end_seconds": 107.3,
      "duration_seconds": 3.09,
      "text": "Any coughing up blood or weight loss at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.75,
      "end_seconds": 112.96,
      "duration_seconds": 5.21,
      "text": "Okay, um, so no, no coughing up blood or weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 116.71,
      "duration_seconds": 2.91,
      "text": "Any leg swelling or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.97,
      "end_seconds": 119.97,
      "duration_seconds": 2.0,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.5,
      "end_seconds": 123.9,
      "duration_seconds": 3.4,
      "text": "Right, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 126.92,
      "duration_seconds": 1.96,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.69,
      "end_seconds": 131.54,
      "duration_seconds": 3.85,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 134.75,
      "duration_seconds": 1.62,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.54,
      "end_seconds": 139.04,
      "duration_seconds": 3.5,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.44,
      "end_seconds": 140.14,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.85,
      "end_seconds": 152.89,
      "duration_seconds": 5.04,
      "text": "Right, thanks for waiting. Right, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.41,
      "end_seconds": 158.41,
      "duration_seconds": 5.0,
      "text": "Oh, I'm allergic to sulfa drugs, I get itching all over."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.82,
      "end_seconds": 162.62,
      "duration_seconds": 2.8,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.13,
      "end_seconds": 164.1,
      "duration_seconds": 0.97,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.02,
      "end_seconds": 184.2,
      "duration_seconds": 4.18,
      "text": "Right, thanks for waiting. Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.39,
      "end_seconds": 187.49,
      "duration_seconds": 2.1,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 195.65,
      "duration_seconds": 6.85,
      "text": "Yes, I can see the asthma in your file as well. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.86,
      "end_seconds": 199.91,
      "duration_seconds": 3.05,
      "text": "Um, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.3,
      "end_seconds": 202.95,
      "duration_seconds": 1.65,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.51,
      "end_seconds": 208.69,
      "duration_seconds": 4.18,
      "text": "Uh, um, no, never had any surgery."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.12,
      "end_seconds": 212.1,
      "duration_seconds": 1.98,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.51,
      "end_seconds": 220.77,
      "duration_seconds": 7.26,
      "text": "Busy. Everyone's running in different directions at the moment, you know, you know how it is."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.56,
      "end_seconds": 224.68,
      "duration_seconds": 3.12,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.58,
      "end_seconds": 229.83,
      "duration_seconds": 4.25,
      "text": "Right, I'm on Asthalin inhaler, when needed for my asthma."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.82,
      "end_seconds": 235.61,
      "duration_seconds": 4.79,
      "text": "Okay, is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.93,
      "end_seconds": 240.17,
      "duration_seconds": 3.24,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.98,
      "end_seconds": 246.39,
      "duration_seconds": 4.41,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.21,
      "end_seconds": 251.59,
      "duration_seconds": 3.38,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.33,
      "end_seconds": 270.29,
      "duration_seconds": 2.96,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.71,
      "end_seconds": 290.72,
      "duration_seconds": 15.01,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. From what you've told me and what I found, my working impression is a chest infection, probably viral."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.93,
      "end_seconds": 298.32,
      "duration_seconds": 6.39,
      "text": "I've been thinking the worst, um, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.9,
      "end_seconds": 315.54,
      "duration_seconds": 16.64,
      "text": "I can't promise yet, but most people with a chest infection, probably viral do well once it's treated properly. Let me just recap so I've got it right. You've had a cough for about four days, mild, and no leg swelling or weight loss."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.1,
      "end_seconds": 319.31,
      "duration_seconds": 2.21,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.65,
      "end_seconds": 336.76,
      "duration_seconds": 17.11,
      "text": "I'd like to arrange blood tests for cough. That will help us see what's going on underneath and decide the next step. I'm prescribing azithromycin, 500 milligrams, once a day, for three days. That should help with chest infection. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.39,
      "end_seconds": 340.42,
      "duration_seconds": 3.03,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.8,
      "end_seconds": 371.81,
      "duration_seconds": 31.01,
      "text": "Steam and warm fluids can ease the cough, and try to sleep with your head propped up. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If you become breathless or cough up blood, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.15,
      "end_seconds": 374.86,
      "duration_seconds": 1.71,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.55,
      "end_seconds": 387.89,
      "duration_seconds": 9.34,
      "text": "Let's review you in ten days. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.27,
      "end_seconds": 396.68,
      "duration_seconds": 8.41,
      "text": "So, I take the azithromycin, 500 milligrams, once a day and come back in ten days. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.71,
      "end_seconds": 401.98,
      "duration_seconds": 4.27,
      "text": "Okay, yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.52,
      "end_seconds": 407.13,
      "duration_seconds": 4.61,
      "text": "I, I think that's clear. Thank you for being so thorough."
    }
  ]
}