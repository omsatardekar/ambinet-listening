{
  "schema_version": "1.0",
  "encounter_id": "00246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.39,
      "duration_seconds": 5.01,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.43,
      "end_seconds": 10.41,
      "duration_seconds": 2.98,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 18.19,
      "duration_seconds": 6.52,
      "text": "So the thing is, I've got shaky spells. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.3,
      "end_seconds": 23.33,
      "duration_seconds": 4.03,
      "text": "Right, is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.33,
      "end_seconds": 26.42,
      "duration_seconds": 2.09,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.61,
      "end_seconds": 29.44,
      "duration_seconds": 1.83,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.84,
      "end_seconds": 34.43,
      "duration_seconds": 3.59,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.55,
      "end_seconds": 37.81,
      "duration_seconds": 2.26,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.57,
      "end_seconds": 42.14,
      "duration_seconds": 3.57,
      "text": "Yes, exercise and missing meals. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.8,
      "end_seconds": 44.48,
      "duration_seconds": 1.68,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.41,
      "end_seconds": 46.64,
      "duration_seconds": 1.23,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.77,
      "end_seconds": 51.63,
      "duration_seconds": 3.86,
      "text": "What about a pounding heart with it, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 58.24,
      "duration_seconds": 6.0,
      "text": "Yes, since Friday. About pounding heart with it, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.07,
      "end_seconds": 61.58,
      "duration_seconds": 2.51,
      "text": "Have you been feeling suddenly very hungry?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.94,
      "end_seconds": 64.31,
      "duration_seconds": 1.37,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.67,
      "end_seconds": 78.24,
      "duration_seconds": 13.57,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.53,
      "end_seconds": 81.24,
      "duration_seconds": 1.71,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.24,
      "end_seconds": 86.18,
      "duration_seconds": 3.94,
      "text": "Have you had any losing consciousness, vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.82,
      "end_seconds": 88.51,
      "duration_seconds": 1.69,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.74,
      "end_seconds": 92.4,
      "duration_seconds": 2.66,
      "text": "Any weight loss or seizure at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.03,
      "end_seconds": 95.71,
      "duration_seconds": 2.68,
      "text": "No, no weight loss or seizure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.99,
      "end_seconds": 98.75,
      "duration_seconds": 1.76,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.71,
      "end_seconds": 100.99,
      "duration_seconds": 1.28,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.02,
      "end_seconds": 103.1,
      "duration_seconds": 1.08,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.68,
      "end_seconds": 105.68,
      "duration_seconds": 2.0,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.49,
      "end_seconds": 107.19,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.87,
      "end_seconds": 109.15,
      "duration_seconds": 1.28,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.85,
      "end_seconds": 114.66,
      "duration_seconds": 4.81,
      "text": "What medicines are you taking at the moment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 121.92,
      "duration_seconds": 3.69,
      "text": "I take losartan, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.2,
      "end_seconds": 126.56,
      "duration_seconds": 3.36,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.92,
      "end_seconds": 142.73,
      "duration_seconds": 14.81,
      "text": "Not with me. I'll bring it next time. Glimepiride, 2 milligrams, before breakfast for my sugar. I kept putting it off, which I know isn't sensible. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.16,
      "end_seconds": 146.55,
      "duration_seconds": 2.39,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.24,
      "end_seconds": 149.38,
      "duration_seconds": 2.14,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.83,
      "end_seconds": 164.33,
      "duration_seconds": 3.5,
      "text": "Okay, here we go. Any operations in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.22,
      "end_seconds": 172.37,
      "duration_seconds": 4.15,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.74,
      "end_seconds": 176.76,
      "duration_seconds": 3.02,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.98,
      "end_seconds": 178.82,
      "duration_seconds": 0.84,
      "text": "Yes, ibuprofen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.56,
      "end_seconds": 182.04,
      "duration_seconds": 2.48,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.72,
      "end_seconds": 196.28,
      "duration_seconds": 13.56,
      "text": "I've had high blood pressure for nearly five years now. My sister suggested writing things down, but I forgot. I wasn't sure whether to come in at all, to be honest. Diabetes, for two years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.5,
      "end_seconds": 204.9,
      "duration_seconds": 7.4,
      "text": "Okay, high blood pressure, that's already on your record. Good to know. Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.42,
      "end_seconds": 214.46,
      "duration_seconds": 2.04,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.71,
      "end_seconds": 246.22,
      "duration_seconds": 10.51,
      "text": "Okay: BP is 128 over 80, BMI works out to 28.0, height 150 centimetres, SpO2 98 percent on room air, pulse is 66 beats a minute, weight 63 kilos."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.88,
      "end_seconds": 249.59,
      "duration_seconds": 1.71,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.84,
      "end_seconds": 251.54,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.62,
      "end_seconds": 254.34,
      "duration_seconds": 1.72,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.1,
      "end_seconds": 270.3,
      "duration_seconds": 3.2,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.01,
      "end_seconds": 299.29,
      "duration_seconds": 23.28,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. From what you've told me and what I found, my working impression is low sugar episodes related to diabetes medication. Let me just recap so I've got it right. You've had shaky spells for six months, moderate, and no weight loss or seizure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.81,
      "end_seconds": 302.0,
      "duration_seconds": 2.19,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.88,
      "end_seconds": 319.63,
      "duration_seconds": 16.75,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.13,
      "end_seconds": 323.34,
      "duration_seconds": 2.21,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.78,
      "end_seconds": 334.52,
      "duration_seconds": 10.74,
      "text": "I'd like to arrange a blood sugar test for hypoglycaemia. That will help us see what's going on underneath and decide the next step. We should do an HbA1c for diabetes control."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.09,
      "end_seconds": 338.45,
      "duration_seconds": 2.36,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.86,
      "end_seconds": 351.68,
      "duration_seconds": 12.82,
      "text": "Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.89,
      "end_seconds": 358.91,
      "duration_seconds": 7.02,
      "text": "Go on. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.5,
      "end_seconds": 360.9,
      "duration_seconds": 1.4,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.47,
      "end_seconds": 371.4,
      "duration_seconds": 8.93,
      "text": "Keep an eye out, and if you black out or can't wake up properly after an episode, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.31,
      "end_seconds": 374.18,
      "duration_seconds": 1.87,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.5,
      "end_seconds": 377.76,
      "duration_seconds": 2.26,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.29,
      "end_seconds": 382.94,
      "duration_seconds": 1.65,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.24,
      "end_seconds": 392.79,
      "duration_seconds": 5.55,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.01,
      "end_seconds": 398.1,
      "duration_seconds": 4.09,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.27,
      "end_seconds": 403.87,
      "duration_seconds": 2.6,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.4,
      "end_seconds": 407.55,
      "duration_seconds": 2.15,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.94,
      "end_seconds": 409.68,
      "duration_seconds": 0.74,
      "text": "Alright, goodbye."
    }
  ]
}