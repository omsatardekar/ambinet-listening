{
  "schema_version": "1.0",
  "encounter_id": "00435",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 3.17,
      "duration_seconds": 2.55,
      "text": "Hello doctor, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.68,
      "end_seconds": 8.87,
      "duration_seconds": 5.19,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.39,
      "end_seconds": 13.75,
      "duration_seconds": 4.36,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.7,
      "end_seconds": 17.71,
      "duration_seconds": 3.01,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.44,
      "end_seconds": 24.19,
      "duration_seconds": 5.75,
      "text": "It's pain in my right shoulder, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.85,
      "end_seconds": 27.52,
      "duration_seconds": 2.67,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.86,
      "end_seconds": 29.21,
      "duration_seconds": 1.35,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.49,
      "end_seconds": 33.92,
      "duration_seconds": 3.43,
      "text": "And what do you do to cope with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.31,
      "end_seconds": 39.83,
      "duration_seconds": 2.52,
      "text": "Only rest, and it's not much."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.33,
      "end_seconds": 44.34,
      "duration_seconds": 3.01,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.59,
      "end_seconds": 51.14,
      "duration_seconds": 5.55,
      "text": "When it starts I tend to get a dull ache down the arm as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.62,
      "end_seconds": 54.81,
      "duration_seconds": 2.19,
      "text": "Have you had trouble lifting your arm?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.94,
      "end_seconds": 57.18,
      "duration_seconds": 1.24,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.13,
      "end_seconds": 61.04,
      "duration_seconds": 2.91,
      "text": "Any chest pain or numbness in the hand?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.92,
      "end_seconds": 66.62,
      "duration_seconds": 4.7,
      "text": "No chest pain or numbness in the hand, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.72,
      "end_seconds": 69.49,
      "duration_seconds": 1.77,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.22,
      "end_seconds": 75.2,
      "duration_seconds": 1.98,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 76.57,
      "end_seconds": 81.09,
      "duration_seconds": 4.52,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.29,
      "end_seconds": 86.91,
      "duration_seconds": 4.62,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.18,
      "end_seconds": 94.02,
      "duration_seconds": 5.84,
      "text": "Alright, I'll note both what you've said and what you've noticed. Alright, any fall or neck pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.49,
      "end_seconds": 98.13,
      "duration_seconds": 2.64,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.3,
      "end_seconds": 101.24,
      "duration_seconds": 1.94,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.18,
      "end_seconds": 105.37,
      "duration_seconds": 1.19,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 108.7,
      "duration_seconds": 2.16,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.08,
      "end_seconds": 113.05,
      "duration_seconds": 1.97,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.05,
      "end_seconds": 117.77,
      "duration_seconds": 3.72,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.15,
      "end_seconds": 122.76,
      "duration_seconds": 4.61,
      "text": "I've had high blood pressure, yes. I've got diabetes. I have asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.21,
      "end_seconds": 132.59,
      "duration_seconds": 9.38,
      "text": "Right. Right, so that's your known high blood pressure. We'll keep that in mind today. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.81,
      "end_seconds": 137.78,
      "duration_seconds": 3.97,
      "text": "My father had kidney stones. My father was diabetic."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.84,
      "end_seconds": 140.98,
      "duration_seconds": 2.14,
      "text": "One moment, I'm updating your notes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.68,
      "end_seconds": 161.74,
      "duration_seconds": 4.06,
      "text": "Good, where were we. So, have you had any surgery before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.51,
      "end_seconds": 164.82,
      "duration_seconds": 2.31,
      "text": "Just my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.88,
      "end_seconds": 177.85,
      "duration_seconds": 11.97,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.36,
      "end_seconds": 180.79,
      "duration_seconds": 1.43,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.73,
      "end_seconds": 184.54,
      "duration_seconds": 2.81,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.18,
      "end_seconds": 198.63,
      "duration_seconds": 13.45,
      "text": "Asthalin inhaler. I take it when needed for my asthma. I looked a few things up online, and that probably didn't help. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.98,
      "end_seconds": 209.02,
      "duration_seconds": 8.04,
      "text": "Doctor, I think the last prescription for the paracetamol was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.55,
      "end_seconds": 211.97,
      "duration_seconds": 2.42,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.36,
      "end_seconds": 216.77,
      "duration_seconds": 3.41,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.1,
      "end_seconds": 220.07,
      "duration_seconds": 1.97,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.56,
      "end_seconds": 230.1,
      "duration_seconds": 1.54,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.82,
      "end_seconds": 252.74,
      "duration_seconds": 4.92,
      "text": "Okay: respiratory rate 18, pressure 123 over 76, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.26,
      "end_seconds": 255.77,
      "duration_seconds": 2.51,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.27,
      "end_seconds": 259.78,
      "duration_seconds": 2.51,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.49,
      "end_seconds": 265.88,
      "duration_seconds": 3.39,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.27,
      "end_seconds": 268.67,
      "duration_seconds": 1.4,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.72,
      "end_seconds": 271.66,
      "duration_seconds": 1.94,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.34,
      "end_seconds": 282.4,
      "duration_seconds": 3.06,
      "text": "Neck movements are full and don't reproduce it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.93,
      "end_seconds": 286.6,
      "duration_seconds": 2.67,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.76,
      "end_seconds": 305.34,
      "duration_seconds": 5.58,
      "text": "Lifting the arm to the side is painful between sixty and a hundred twenty degrees."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.3,
      "end_seconds": 330.33,
      "duration_seconds": 22.03,
      "text": "That's fine, you can get dressed. From what you've told me and what I found, I think we're dealing with a rotator cuff problem at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep frozen shoulder in mind. Let me just recap so I've got it right. You've had pain in your right shoulder, severe, and no neck pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.87,
      "end_seconds": 333.29,
      "duration_seconds": 2.42,
      "text": "Yes, um, you've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.6,
      "end_seconds": 338.28,
      "duration_seconds": 3.68,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.84,
      "end_seconds": 339.54,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.56,
      "end_seconds": 355.65,
      "duration_seconds": 9.09,
      "text": "Alright, I've got it. Let's get an ultrasound of the shoulder, for shoulder pain. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.12,
      "end_seconds": 357.03,
      "duration_seconds": 0.91,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.23,
      "end_seconds": 373.66,
      "duration_seconds": 15.43,
      "text": "I'm going to order an X-ray of the shoulder, for shoulder pain. That will help us see what's going on underneath and decide the next step. I'm prescribing naproxen, 250 milligrams, twice a day after food, for five days. You take it by mouth. It's for shoulder pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.2,
      "end_seconds": 375.04,
      "duration_seconds": 0.84,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.56,
      "end_seconds": 395.51,
      "duration_seconds": 19.95,
      "text": "Gentle pendulum exercises, I'll show you a couple, but nothing overhead for a bit. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.84,
      "end_seconds": 403.69,
      "duration_seconds": 7.85,
      "text": "Alright. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.75,
      "end_seconds": 406.07,
      "duration_seconds": 1.32,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.94,
      "end_seconds": 413.64,
      "duration_seconds": 6.7,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.97,
      "end_seconds": 416.81,
      "duration_seconds": 1.84,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.71,
      "end_seconds": 419.66,
      "duration_seconds": 1.95,
      "text": "Come back in three weeks."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.0,
      "end_seconds": 423.78,
      "duration_seconds": 1.78,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.57,
      "end_seconds": 433.74,
      "duration_seconds": 6.17,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.8,
      "end_seconds": 443.65,
      "duration_seconds": 8.85,
      "text": "So, I take the naproxen, 250 milligrams, twice a day after food and come back in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.85,
      "end_seconds": 448.71,
      "duration_seconds": 3.86,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.04,
      "end_seconds": 452.95,
      "duration_seconds": 2.91,
      "text": "That's all, thank you for your time."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 453.34,
      "end_seconds": 455.76,
      "duration_seconds": 2.42,
      "text": "Bye for now, look after yourself."
    }
  ]
}