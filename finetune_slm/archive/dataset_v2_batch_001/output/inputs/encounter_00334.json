{
  "schema_version": "1.0",
  "encounter_id": "00334",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.28,
      "duration_seconds": 4.25,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 8.8,
      "duration_seconds": 3.09,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.16,
      "end_seconds": 17.76,
      "duration_seconds": 7.6,
      "text": "I wanted to get blurry vision looked at. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 20.33,
      "duration_seconds": 1.55,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.06,
      "end_seconds": 25.83,
      "duration_seconds": 4.77,
      "text": "Probably four weeks. Yeah. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.22,
      "end_seconds": 30.43,
      "duration_seconds": 3.21,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.29,
      "end_seconds": 36.58,
      "duration_seconds": 2.29,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.08,
      "end_seconds": 41.19,
      "duration_seconds": 4.11,
      "text": "Mm-hm. What about trouble reading small print, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.82,
      "end_seconds": 49.37,
      "duration_seconds": 7.55,
      "text": "Yes, for six months. As for trouble reading small print, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.8,
      "end_seconds": 55.42,
      "duration_seconds": 4.62,
      "text": "Right, have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.53,
      "end_seconds": 70.07,
      "duration_seconds": 13.54,
      "text": "Um, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.26,
      "end_seconds": 73.75,
      "duration_seconds": 2.49,
      "text": "Have you had any redness or double vision?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 78.18,
      "duration_seconds": 2.96,
      "text": "No. None of those, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.55,
      "end_seconds": 81.72,
      "duration_seconds": 2.17,
      "text": "Have you had any flashes of light?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.22,
      "end_seconds": 86.33,
      "duration_seconds": 3.11,
      "text": "Not at all, no flashes of light."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.16,
      "end_seconds": 90.8,
      "duration_seconds": 3.64,
      "text": "Alright, do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.38,
      "end_seconds": 98.24,
      "duration_seconds": 6.86,
      "text": "Okay, so just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.01,
      "end_seconds": 101.36,
      "duration_seconds": 2.35,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.54,
      "end_seconds": 106.9,
      "duration_seconds": 1.36,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.79,
      "end_seconds": 117.61,
      "duration_seconds": 7.82,
      "text": "What about your general health, any conditions you're being treated for? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 119.81,
      "duration_seconds": 1.32,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.18,
      "end_seconds": 129.37,
      "duration_seconds": 8.19,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.5,
      "end_seconds": 132.8,
      "duration_seconds": 2.3,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.79,
      "end_seconds": 139.81,
      "duration_seconds": 4.02,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.35,
      "end_seconds": 142.25,
      "duration_seconds": 0.9,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.83,
      "end_seconds": 145.34,
      "duration_seconds": 2.51,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.12,
      "end_seconds": 146.85,
      "duration_seconds": 0.73,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.48,
      "end_seconds": 159.89,
      "duration_seconds": 1.41,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.83,
      "end_seconds": 163.06,
      "duration_seconds": 2.23,
      "text": "Let me just write this down properly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.36,
      "end_seconds": 177.33,
      "duration_seconds": 1.97,
      "text": "Right, good, where were we."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 181.04,
      "duration_seconds": 1.58,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.24,
      "end_seconds": 183.25,
      "duration_seconds": 1.01,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.31,
      "end_seconds": 186.25,
      "duration_seconds": 1.94,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.1,
      "end_seconds": 196.97,
      "duration_seconds": 2.87,
      "text": "The lens looks a little cloudy on both sides."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.76,
      "end_seconds": 200.73,
      "duration_seconds": 1.97,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.07,
      "end_seconds": 219.91,
      "duration_seconds": 3.84,
      "text": "Vision without glasses is six over twelve in both eyes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.36,
      "end_seconds": 232.25,
      "duration_seconds": 7.89,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.97,
      "end_seconds": 236.12,
      "duration_seconds": 3.15,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.75,
      "end_seconds": 237.54,
      "duration_seconds": 0.79,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.53,
      "end_seconds": 261.53,
      "duration_seconds": 12.0,
      "text": "Alright, I've got it. Putting it all together, it fits best with a refractive problem or early cataracts. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.18,
      "end_seconds": 263.92,
      "duration_seconds": 1.74,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.12,
      "end_seconds": 282.62,
      "duration_seconds": 17.5,
      "text": "I understand the worry. At the moment I'd say it's a refractive problem or early cataracts, and we'll know more once the a dilated eye examination is back. Let me just recap so I've got it right. You've had blurry vision for four weeks, moderate, and no redness or double vision."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.21,
      "end_seconds": 284.56,
      "duration_seconds": 1.35,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.76,
      "end_seconds": 290.38,
      "duration_seconds": 4.62,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.5,
      "end_seconds": 301.52,
      "duration_seconds": 10.02,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.58,
      "end_seconds": 306.69,
      "duration_seconds": 4.11,
      "text": "I'd like to arrange a dilated eye examination for blurred vision."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.56,
      "end_seconds": 310.69,
      "duration_seconds": 3.13,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.15,
      "end_seconds": 333.58,
      "duration_seconds": 22.43,
      "text": "Get a proper glasses test, and keep your sugar and blood pressure well controlled for your eyes. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Keep an eye out, and if you get sudden loss of vision or a curtain across your sight, call us the same day or go to emergency. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.93,
      "end_seconds": 334.63,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.02,
      "end_seconds": 341.75,
      "duration_seconds": 6.73,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.32,
      "end_seconds": 347.29,
      "duration_seconds": 3.97,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.25,
      "end_seconds": 351.94,
      "duration_seconds": 3.69,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.66,
      "end_seconds": 354.94,
      "duration_seconds": 2.28,
      "text": "Um, no questions. Thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.18,
      "end_seconds": 359.97,
      "duration_seconds": 0.79,
      "text": "Alright, goodbye."
    }
  ]
}