{
  "schema_version": "1.0",
  "encounter_id": "00062",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 3.52,
      "duration_seconds": 2.33,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 8.04,
      "duration_seconds": 3.38,
      "text": "Yeah, thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.46,
      "end_seconds": 12.39,
      "duration_seconds": 2.93,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.84,
      "end_seconds": 15.74,
      "duration_seconds": 2.9,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.39,
      "end_seconds": 21.11,
      "duration_seconds": 4.72,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.74,
      "end_seconds": 24.59,
      "duration_seconds": 2.85,
      "text": "So, in your own words, what's happened?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.35,
      "end_seconds": 29.91,
      "duration_seconds": 4.56,
      "text": "We came because of a dry cough that won't go away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.31,
      "end_seconds": 34.4,
      "duration_seconds": 4.09,
      "text": "And when did that start? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.5,
      "end_seconds": 45.11,
      "duration_seconds": 9.61,
      "text": "It's been going on for six months. I took the morning off to come in today. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.02,
      "end_seconds": 49.91,
      "duration_seconds": 3.89,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.3,
      "end_seconds": 61.11,
      "duration_seconds": 10.81,
      "text": "Sipping water helps a bit. It's all the time. Yes, lying down. That makes it worse. Mild, I'd say. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.44,
      "end_seconds": 64.93,
      "duration_seconds": 2.49,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.9,
      "end_seconds": 73.0,
      "duration_seconds": 7.1,
      "text": "Hmm, when it starts I tend to get a hoarse voice in the mornings as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.06,
      "end_seconds": 77.41,
      "duration_seconds": 3.35,
      "text": "Have you had a burning in the chest after meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.86,
      "end_seconds": 79.66,
      "duration_seconds": 1.8,
      "text": "Yes, for six months."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.41,
      "end_seconds": 83.73,
      "duration_seconds": 3.32,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.03,
      "end_seconds": 92.37,
      "duration_seconds": 7.34,
      "text": "It's on and off. I've been clearing my throat all the time too, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.31,
      "end_seconds": 98.54,
      "duration_seconds": 5.23,
      "text": "Let me check a few things. Any trouble swallowing, wheezing or shortness of breath?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.97,
      "end_seconds": 103.88,
      "duration_seconds": 3.91,
      "text": "No, no trouble swallowing, wheezing or shortness of breath."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.27,
      "end_seconds": 108.2,
      "duration_seconds": 2.93,
      "text": "Any weight loss, night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.61,
      "end_seconds": 110.99,
      "duration_seconds": 2.38,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.42,
      "end_seconds": 115.49,
      "duration_seconds": 3.07,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.9,
      "end_seconds": 117.48,
      "duration_seconds": 1.58,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.28,
      "end_seconds": 123.04,
      "duration_seconds": 1.76,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.45,
      "end_seconds": 126.31,
      "duration_seconds": 1.86,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.17,
      "end_seconds": 129.14,
      "duration_seconds": 1.97,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.31,
      "end_seconds": 132.19,
      "duration_seconds": 1.88,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.5,
      "end_seconds": 138.5,
      "duration_seconds": 6.0,
      "text": "Alright, moving on to your background, any past medical history? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.06,
      "end_seconds": 141.09,
      "duration_seconds": 2.03,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.15,
      "end_seconds": 143.13,
      "duration_seconds": 0.98,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.7,
      "end_seconds": 148.51,
      "duration_seconds": 4.81,
      "text": "I've got acid reflux. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.55,
      "end_seconds": 158.02,
      "duration_seconds": 8.47,
      "text": "Right, so that's your known acid reflux. We'll keep that in mind today. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.39,
      "end_seconds": 160.65,
      "duration_seconds": 2.26,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.62,
      "end_seconds": 164.25,
      "duration_seconds": 2.63,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.28,
      "end_seconds": 179.17,
      "duration_seconds": 13.89,
      "text": "I take ramipril, 5 milligrams, every morning. I'd rather know what's going on than keep guessing. I just want to get back to normal, really. Omeprazole. I take it 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.67,
      "end_seconds": 188.09,
      "duration_seconds": 7.42,
      "text": "Doctor, I think the last prescription for the omeprazole was 40 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.07,
      "end_seconds": 191.74,
      "duration_seconds": 2.67,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.71,
      "end_seconds": 207.67,
      "duration_seconds": 14.96,
      "text": "I don't think I have it with me. Digene. I take it after meals. It's a relief to finally sit down and talk about it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.13,
      "end_seconds": 211.6,
      "duration_seconds": 2.47,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.24,
      "end_seconds": 213.12,
      "duration_seconds": 0.88,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.97,
      "end_seconds": 231.73,
      "duration_seconds": 3.76,
      "text": "Right, thanks for waiting. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.11,
      "end_seconds": 241.43,
      "duration_seconds": 1.32,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.04,
      "end_seconds": 262.66,
      "duration_seconds": 11.62,
      "text": "Okay: temp 36.6 degrees, heart rate 84, height 163 centimetres, BMI works out to 23.7, weight 63 kilos, BP is 124 over 72, SpO2 98 percent on room air, respiratory rate 14."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.33,
      "end_seconds": 267.05,
      "duration_seconds": 1.72,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 271.07,
      "duration_seconds": 2.35,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.19,
      "end_seconds": 291.26,
      "duration_seconds": 5.07,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.5,
      "end_seconds": 293.76,
      "duration_seconds": 1.26,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.04,
      "end_seconds": 316.27,
      "duration_seconds": 19.23,
      "text": "Okay, you can sit back up. From what you've told me and what I found, it fits best with a cough driven by acid reflux. That's my thinking for now, and it may change as we learn more. It could also be post-nasal drip, so we'll keep that open."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.64,
      "end_seconds": 318.51,
      "duration_seconds": 1.87,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.23,
      "end_seconds": 339.01,
      "duration_seconds": 19.78,
      "text": "I understand the worry. At the moment I'd say it's a cough driven by acid reflux, and we'll know more once the a chest X-ray is back. Let me just recap so I've got it right. You've had a dry cough that won't go away for six months, mild, and no weight loss or wheezing."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.92,
      "end_seconds": 341.83,
      "duration_seconds": 1.91,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.17,
      "end_seconds": 346.75,
      "duration_seconds": 3.58,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.6,
      "end_seconds": 353.18,
      "duration_seconds": 5.58,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.58,
      "end_seconds": 359.56,
      "duration_seconds": 2.98,
      "text": "We should do a chest X-ray for chronic cough."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.05,
      "end_seconds": 361.97,
      "duration_seconds": 0.92,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.83,
      "end_seconds": 369.71,
      "duration_seconds": 6.88,
      "text": "I'm going to order breathing tests, for chronic cough. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.77,
      "end_seconds": 373.86,
      "duration_seconds": 3.09,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.66,
      "end_seconds": 395.72,
      "duration_seconds": 21.06,
      "text": "Don't eat for two or three hours before lying down, and raise the head of the bed a little. Don't skip meals, and try to eat smaller portions more often through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.41,
      "end_seconds": 397.79,
      "duration_seconds": 1.38,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.69,
      "end_seconds": 404.25,
      "duration_seconds": 5.56,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.68,
      "end_seconds": 407.03,
      "duration_seconds": 1.35,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.34,
      "end_seconds": 413.64,
      "duration_seconds": 6.3,
      "text": "Please come and see me in a month. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.45,
      "end_seconds": 418.25,
      "duration_seconds": 3.8,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.58,
      "end_seconds": 419.65,
      "duration_seconds": 1.07,
      "text": "Okay, take care."
    }
  ]
}