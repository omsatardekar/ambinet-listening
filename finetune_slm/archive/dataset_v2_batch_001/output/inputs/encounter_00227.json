{
  "schema_version": "1.0",
  "encounter_id": "00227",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.26,
      "end_seconds": 6.31,
      "duration_seconds": 5.05,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 10.11,
      "duration_seconds": 2.73,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 22.73,
      "duration_seconds": 11.63,
      "text": "I'm, I'm here because of exhaustion since I had the flu. I looked a few things up online, uh, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.26,
      "end_seconds": 26.13,
      "duration_seconds": 1.87,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.15,
      "end_seconds": 37.89,
      "duration_seconds": 10.74,
      "text": "It's been going on for two weeks. I'm not great at remembering details, so bear with me. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.66,
      "end_seconds": 45.59,
      "duration_seconds": 2.93,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.25,
      "end_seconds": 52.58,
      "duration_seconds": 6.33,
      "text": "I, I'd say mild. Hmm, I had brain fog before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 57.31,
      "duration_seconds": 3.41,
      "text": "Any chest pain, rash or swollen legs at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.1,
      "end_seconds": 63.7,
      "duration_seconds": 5.6,
      "text": "Hmm, I haven't had chest pain, rash or swollen legs, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.91,
      "end_seconds": 67.86,
      "duration_seconds": 2.95,
      "text": "Have you had any shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.39,
      "end_seconds": 72.1,
      "duration_seconds": 2.71,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.69,
      "end_seconds": 75.64,
      "duration_seconds": 2.95,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.97,
      "end_seconds": 79.47,
      "duration_seconds": 2.5,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.59,
      "end_seconds": 92.75,
      "duration_seconds": 12.16,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.89,
      "end_seconds": 96.74,
      "duration_seconds": 2.85,
      "text": "Right, um, I understand now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.93,
      "end_seconds": 101.46,
      "duration_seconds": 3.53,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.82,
      "end_seconds": 107.57,
      "duration_seconds": 5.75,
      "text": "Seretide inhaler, twice a day. Well, I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.17,
      "end_seconds": 111.45,
      "duration_seconds": 3.28,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.41,
      "end_seconds": 115.52,
      "duration_seconds": 3.11,
      "text": "Thank you, uh, I appreciate it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.98,
      "end_seconds": 117.12,
      "duration_seconds": 1.14,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.6,
      "end_seconds": 119.96,
      "duration_seconds": 2.36,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 133.48,
      "duration_seconds": 12.46,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.47,
      "end_seconds": 139.56,
      "duration_seconds": 5.09,
      "text": "Oh, you know, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.95,
      "end_seconds": 141.65,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.06,
      "end_seconds": 144.9,
      "duration_seconds": 2.84,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.62,
      "end_seconds": 149.46,
      "duration_seconds": 3.84,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.08,
      "end_seconds": 150.93,
      "duration_seconds": 0.85,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.67,
      "end_seconds": 170.0,
      "duration_seconds": 6.33,
      "text": "Okay, here we go. Any allergies I should know about? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.41,
      "end_seconds": 173.74,
      "duration_seconds": 3.33,
      "text": "Hmm, no, none that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.46,
      "end_seconds": 178.06,
      "duration_seconds": 3.6,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.95,
      "end_seconds": 179.65,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.31,
      "end_seconds": 200.75,
      "duration_seconds": 5.44,
      "text": "Right, thanks for waiting. Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.59,
      "end_seconds": 206.57,
      "duration_seconds": 4.98,
      "text": "So, uh, I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.4,
      "end_seconds": 210.19,
      "duration_seconds": 2.79,
      "text": "Right. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.19,
      "end_seconds": 230.09,
      "duration_seconds": 15.9,
      "text": "Uh, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 230.86,
      "end_seconds": 241.05,
      "duration_seconds": 10.19,
      "text": "Okay, so the vitals from earlier. SpO2 99 percent on room air, blood pressure 110 over 74, BMI works out to 26.6, pulse 68, height 168 centimetres, weight 75 kilos."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.76,
      "end_seconds": 242.62,
      "duration_seconds": 0.86,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 246.91,
      "duration_seconds": 2.5,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.12,
      "end_seconds": 249.68,
      "duration_seconds": 1.56,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.91,
      "end_seconds": 266.56,
      "duration_seconds": 1.65,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.83,
      "end_seconds": 285.87,
      "duration_seconds": 15.04,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.67,
      "end_seconds": 288.24,
      "duration_seconds": 1.57,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.48,
      "end_seconds": 300.02,
      "duration_seconds": 10.54,
      "text": "So, based on the history and the examination, it fits best with post-viral fatigue. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.71,
      "end_seconds": 306.15,
      "duration_seconds": 5.44,
      "text": "Uh, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.53,
      "end_seconds": 322.65,
      "duration_seconds": 16.12,
      "text": "Nothing I've seen today points to an emergency. It looks like post-viral fatigue, but I'd like to confirm. Let me just recap so I've got it right. You've had exhaustion since you had the flu for two weeks, mild, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.21,
      "end_seconds": 325.47,
      "duration_seconds": 2.26,
      "text": "Oh, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.29,
      "end_seconds": 329.94,
      "duration_seconds": 3.65,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.22,
      "end_seconds": 334.28,
      "duration_seconds": 3.06,
      "text": "I hadn't even noticed, um, honestly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.61,
      "end_seconds": 358.48,
      "duration_seconds": 22.87,
      "text": "Let's get a thyroid test, for fatigue. The result will help us decide whether anything more is needed. Pace yourself, a little more activity each day but stop before you're wiped out. Please take the tablets with food so they don't upset your stomach. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.37,
      "end_seconds": 363.35,
      "duration_seconds": 1.98,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.74,
      "end_seconds": 372.16,
      "duration_seconds": 7.42,
      "text": "Please come and see me in four weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 373.09,
      "end_seconds": 378.05,
      "duration_seconds": 4.96,
      "text": "So, you know, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.65,
      "end_seconds": 383.34,
      "duration_seconds": 4.69,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 384.78,
      "end_seconds": 388.63,
      "duration_seconds": 3.85,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.26,
      "end_seconds": 390.09,
      "duration_seconds": 0.83,
      "text": "Alright, goodbye."
    }
  ]
}