{
  "schema_version": "1.0",
  "encounter_id": "00449",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 3.55,
      "duration_seconds": 2.55,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.01,
      "end_seconds": 8.27,
      "duration_seconds": 4.26,
      "text": "Um, thanks, doctor. It's been a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.47,
      "end_seconds": 13.87,
      "duration_seconds": 4.4,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.15,
      "end_seconds": 19.78,
      "duration_seconds": 4.63,
      "text": "That's fine, sit down. We'll go through it together. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.51,
      "end_seconds": 23.14,
      "duration_seconds": 2.63,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.01,
      "end_seconds": 25.92,
      "duration_seconds": 1.91,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.47,
      "end_seconds": 31.85,
      "duration_seconds": 3.38,
      "text": "He's been having headaches in the mornings, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.44,
      "end_seconds": 36.85,
      "duration_seconds": 3.41,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.15,
      "end_seconds": 39.72,
      "duration_seconds": 2.57,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.66,
      "end_seconds": 47.98,
      "duration_seconds": 7.32,
      "text": "So, um, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 48.08,
      "end_seconds": 52.31,
      "duration_seconds": 4.23,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.25,
      "end_seconds": 63.85,
      "duration_seconds": 10.6,
      "text": "I was getting to that! So, as for occasional dizziness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.94,
      "end_seconds": 67.77,
      "duration_seconds": 2.83,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.19,
      "end_seconds": 74.81,
      "duration_seconds": 5.62,
      "text": "Well, um, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.79,
      "end_seconds": 80.16,
      "duration_seconds": 4.37,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.46,
      "end_seconds": 82.68,
      "duration_seconds": 1.22,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.99,
      "end_seconds": 85.55,
      "duration_seconds": 1.56,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.78,
      "end_seconds": 88.6,
      "duration_seconds": 1.82,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 91.82,
      "duration_seconds": 2.47,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.1,
      "end_seconds": 97.39,
      "duration_seconds": 2.29,
      "text": "No, uh, you're fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.42,
      "end_seconds": 100.61,
      "duration_seconds": 2.19,
      "text": "Any vision changes or weakness at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 112.15,
      "duration_seconds": 10.57,
      "text": "No, no vision changes, no weakness. I did have a little puffiness in the ankles at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.91,
      "end_seconds": 115.8,
      "duration_seconds": 2.89,
      "text": "Any chest pain, palpitations or breathlessness at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.31,
      "end_seconds": 120.63,
      "duration_seconds": 4.32,
      "text": "I haven't had chest pain, palpitations or breathlessness, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.64,
      "end_seconds": 123.97,
      "duration_seconds": 2.33,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.55,
      "end_seconds": 126.02,
      "duration_seconds": 1.47,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.5,
      "end_seconds": 129.8,
      "duration_seconds": 2.3,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.97,
      "end_seconds": 132.95,
      "duration_seconds": 1.98,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.13,
      "end_seconds": 139.99,
      "duration_seconds": 2.86,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.0,
      "end_seconds": 155.02,
      "duration_seconds": 14.02,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 158.64,
      "duration_seconds": 2.12,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.88,
      "end_seconds": 164.62,
      "duration_seconds": 4.74,
      "text": "Yes, I had a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.76,
      "end_seconds": 168.31,
      "duration_seconds": 2.55,
      "text": "Alright, does anything run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.62,
      "end_seconds": 172.28,
      "duration_seconds": 3.66,
      "text": "My sister has epilepsy. My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.09,
      "end_seconds": 176.55,
      "duration_seconds": 3.46,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.95,
      "end_seconds": 181.24,
      "duration_seconds": 4.29,
      "text": "Amlodipine, 5 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.01,
      "end_seconds": 184.58,
      "duration_seconds": 2.57,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.43,
      "end_seconds": 192.2,
      "duration_seconds": 6.77,
      "text": "Yeah, not with me. I'll bring it next time. Oh, I'm on rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.26,
      "end_seconds": 194.81,
      "duration_seconds": 1.55,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.17,
      "end_seconds": 199.72,
      "duration_seconds": 3.55,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.01,
      "end_seconds": 206.58,
      "duration_seconds": 5.57,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.21,
      "end_seconds": 209.34,
      "duration_seconds": 2.13,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.72,
      "end_seconds": 218.45,
      "duration_seconds": 7.73,
      "text": "For the gout, I believe. My daughter sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.01,
      "end_seconds": 223.32,
      "duration_seconds": 3.31,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.35,
      "end_seconds": 236.75,
      "duration_seconds": 12.4,
      "text": "I mean, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.49,
      "end_seconds": 241.13,
      "duration_seconds": 3.64,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.64,
      "end_seconds": 244.96,
      "duration_seconds": 2.32,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.43,
      "end_seconds": 247.39,
      "duration_seconds": 0.96,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.73,
      "end_seconds": 270.03,
      "duration_seconds": 21.3,
      "text": "Oh, I've had diabetes for about ten years now. I took the morning off to come in today. I've had high cholesterol, yes. I didn't want to make a fuss, you know. I've had gout for about ten years now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.4,
      "end_seconds": 284.47,
      "duration_seconds": 13.07,
      "text": "Yes, I can see the high cholesterol in your file as well. Okay, gout, that's already on your record. Good to know. What about allergies, to medicines or foods or anything else? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.12,
      "end_seconds": 295.82,
      "duration_seconds": 10.7,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 296.92,
      "end_seconds": 303.79,
      "duration_seconds": 6.87,
      "text": "Okay, so the vitals from earlier. BP is 147 over 96, pulse 88, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.71,
      "end_seconds": 305.99,
      "duration_seconds": 1.28,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.76,
      "end_seconds": 311.03,
      "duration_seconds": 4.27,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.59,
      "end_seconds": 312.29,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.15,
      "end_seconds": 328.53,
      "duration_seconds": 1.38,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.48,
      "end_seconds": 335.01,
      "duration_seconds": 3.53,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.66,
      "end_seconds": 339.45,
      "duration_seconds": 2.79,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.52,
      "end_seconds": 350.85,
      "duration_seconds": 2.33,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.88,
      "end_seconds": 354.91,
      "duration_seconds": 3.03,
      "text": "So, tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.63,
      "end_seconds": 368.93,
      "duration_seconds": 1.3,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.23,
      "end_seconds": 397.9,
      "duration_seconds": 25.67,
      "text": "All done, thank you, please sit down. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, it fits best with hypertension that isn't well controlled. I want to be honest that this is an impression, not a final answer. I'd also keep a side effect from the current tablet in mind."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.08,
      "end_seconds": 401.38,
      "duration_seconds": 2.3,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.83,
      "end_seconds": 416.07,
      "duration_seconds": 13.24,
      "text": "It's reasonable to be concerned, but right now hypertension that isn't well controlled is my leading thought, not anything worse. Let me just recap so I've got it right. You've had headaches in the mornings, mild, and no breathlessness or weakness."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 417.26,
      "end_seconds": 419.66,
      "duration_seconds": 2.4,
      "text": "Uh, yes, you've got it."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 421.04,
      "end_seconds": 424.4,
      "duration_seconds": 3.36,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.68,
      "end_seconds": 443.53,
      "duration_seconds": 16.85,
      "text": "Perfect. I'm going to order kidney function tests, for hypertension. Let's get a urine test for protein, for hypertension. The result will help us decide whether anything more is needed. I'll start you on telmisartan, 40 milligrams, once a day, long term. That's for high blood pressure."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 444.45,
      "end_seconds": 448.01,
      "duration_seconds": 3.56,
      "text": "Right, okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.53,
      "end_seconds": 473.01,
      "duration_seconds": 24.48,
      "text": "Salt is the big one, try to keep it low even though it's hard. Check the blood pressure at home, same time each morning, and write down the numbers for me. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 473.42,
      "end_seconds": 480.75,
      "duration_seconds": 7.33,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 481.67,
      "end_seconds": 483.07,
      "duration_seconds": 1.4,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 484.67,
      "end_seconds": 491.71,
      "duration_seconds": 7.04,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 492.52,
      "end_seconds": 494.81,
      "duration_seconds": 2.29,
      "text": "Okay, uh, I understand."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 496.12,
      "end_seconds": 498.38,
      "duration_seconds": 2.26,
      "text": "Let's review you in a month."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 498.82,
      "end_seconds": 499.52,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 500.48,
      "end_seconds": 504.67,
      "duration_seconds": 4.19,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0077",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 505.0,
      "end_seconds": 512.48,
      "duration_seconds": 7.48,
