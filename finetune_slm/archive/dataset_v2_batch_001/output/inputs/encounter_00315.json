{
  "schema_version": "1.0",
  "encounter_id": "00315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 4.64,
      "duration_seconds": 3.46,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 8.92,
      "duration_seconds": 2.99,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.44,
      "end_seconds": 15.28,
      "duration_seconds": 4.84,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.56,
      "end_seconds": 18.98,
      "duration_seconds": 2.42,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.4,
      "end_seconds": 28.19,
      "duration_seconds": 7.79,
      "text": "I'm here because of a very painful, swollen big toe. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.59,
      "end_seconds": 34.2,
      "duration_seconds": 4.61,
      "text": "How long has this been going on? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.8,
      "end_seconds": 44.67,
      "duration_seconds": 6.87,
      "text": "It's been going on for three days. I just want to get back to normal, uh, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 52.47,
      "duration_seconds": 7.03,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.91,
      "end_seconds": 61.98,
      "duration_seconds": 9.07,
      "text": "Moderate, I'd say. Ice helps a bit. I kept putting it off, which I know isn't sensible. And redness over the joint, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.16,
      "end_seconds": 67.49,
      "duration_seconds": 4.33,
      "text": "So, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.76,
      "end_seconds": 81.12,
      "duration_seconds": 12.36,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.58,
      "end_seconds": 85.26,
      "duration_seconds": 2.68,
      "text": "Have you had any chills or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.69,
      "end_seconds": 88.36,
      "duration_seconds": 2.67,
      "text": "Well, no. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.11,
      "end_seconds": 91.81,
      "duration_seconds": 2.7,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.44,
      "end_seconds": 94.31,
      "duration_seconds": 1.87,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.9,
      "end_seconds": 97.45,
      "duration_seconds": 2.55,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.94,
      "end_seconds": 98.75,
      "duration_seconds": 0.81,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.47,
      "end_seconds": 112.67,
      "duration_seconds": 5.2,
      "text": "Right, thanks for waiting. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.48,
      "end_seconds": 115.83,
      "duration_seconds": 2.35,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.24,
      "end_seconds": 133.93,
      "duration_seconds": 16.69,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.46,
      "end_seconds": 136.23,
      "duration_seconds": 1.77,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.54,
      "end_seconds": 139.89,
      "duration_seconds": 3.35,
      "text": "Right, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.05,
      "end_seconds": 148.17,
      "duration_seconds": 6.12,
      "text": "Kidney disease, for about a year. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.71,
      "end_seconds": 153.2,
      "duration_seconds": 3.49,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.03,
      "end_seconds": 156.39,
      "duration_seconds": 2.36,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.72,
      "end_seconds": 159.59,
      "duration_seconds": 1.87,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.52,
      "end_seconds": 162.93,
      "duration_seconds": 2.41,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 176.63,
      "duration_seconds": 13.21,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.12,
      "end_seconds": 180.1,
      "duration_seconds": 2.98,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.82,
      "end_seconds": 182.21,
      "duration_seconds": 1.39,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.99,
      "end_seconds": 186.66,
      "duration_seconds": 3.67,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.4,
      "end_seconds": 188.54,
      "duration_seconds": 1.14,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.57,
      "end_seconds": 191.22,
      "duration_seconds": 1.65,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 197.6,
      "duration_seconds": 5.0,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.11,
      "end_seconds": 209.49,
      "duration_seconds": 10.38,
      "text": "Right, you know, yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.47,
      "end_seconds": 215.43,
      "duration_seconds": 2.96,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.63,
      "end_seconds": 217.33,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.47,
      "end_seconds": 220.97,
      "duration_seconds": 2.5,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.9,
      "end_seconds": 243.33,
      "duration_seconds": 4.43,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.05,
      "end_seconds": 257.62,
      "duration_seconds": 9.57,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.28,
      "end_seconds": 262.5,
      "duration_seconds": 4.22,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.31,
      "end_seconds": 264.01,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.34,
      "end_seconds": 291.23,
      "duration_seconds": 12.89,
      "text": "Alright, I've got it. From what you've told me and what I found, my working impression is an acute gout flare. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.01,
      "end_seconds": 293.89,
      "duration_seconds": 1.88,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.31,
      "end_seconds": 310.79,
      "duration_seconds": 14.48,
      "text": "It's reasonable to be concerned, but right now an acute gout flare is my leading thought, not anything worse. Let me just recap so I've got it right. You've had a very painful, swollen big toe for three days, moderate, and no chills or rash."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.15,
      "end_seconds": 313.32,
      "duration_seconds": 2.17,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.07,
      "end_seconds": 317.77,
      "duration_seconds": 3.7,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.52,
      "end_seconds": 319.22,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.75,
      "end_seconds": 360.42,
      "duration_seconds": 27.67,
      "text": "Okay, here we go. We should do kidney function tests for gout. It's a routine test and it'll give us a much clearer picture. I'd like to arrange a uric acid level for suspected gout. The result will help us decide whether anything more is needed. Let's use colchicine, 0.5 milligrams, twice a day, for five days. That's for gout flare. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.82,
      "end_seconds": 377.51,
      "duration_seconds": 16.69,
      "text": "Okay, I'm following. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't sit on it if the joint gets hotter or you develop a fever. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.16,
      "end_seconds": 378.86,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.23,
      "end_seconds": 382.12,
      "duration_seconds": 1.89,
      "text": "Come back in a week."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.24,
      "end_seconds": 385.03,
      "duration_seconds": 1.79,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.11,
      "end_seconds": 392.29,
      "duration_seconds": 6.18,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.13,
      "end_seconds": 401.91,
      "duration_seconds": 8.78,
      "text": "So, I take the colchicine, 0.5 milligrams, twice a day and come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.41,
      "end_seconds": 406.95,
      "duration_seconds": 4.54,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.58,
      "end_seconds": 412.99,
      "duration_seconds": 3.41,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.21,
      "end_seconds": 416.18,
      "duration_seconds": 1.97,
      "text": "Bye for now, look after yourself."
    }
  ]
}