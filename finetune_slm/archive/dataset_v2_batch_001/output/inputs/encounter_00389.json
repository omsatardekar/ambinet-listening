{
  "schema_version": "1.0",
  "encounter_id": "00389",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 2.49,
      "duration_seconds": 1.8,
      "text": "Afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.01,
      "end_seconds": 7.05,
      "duration_seconds": 3.04,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.15,
      "end_seconds": 16.51,
      "duration_seconds": 8.36,
      "text": "I've been feeling a bit dizzy after taking all my tablets. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.85,
      "end_seconds": 22.61,
      "duration_seconds": 4.76,
      "text": "How long have you had it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.15,
      "end_seconds": 30.39,
      "duration_seconds": 7.24,
      "text": "For about a week, I'd say. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.88,
      "end_seconds": 34.98,
      "duration_seconds": 4.1,
      "text": "Okay. Have you been feeling confused about which tablets to take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.81,
      "end_seconds": 37.24,
      "duration_seconds": 1.43,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.52,
      "end_seconds": 42.37,
      "duration_seconds": 3.85,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.99,
      "end_seconds": 57.14,
      "duration_seconds": 14.15,
      "text": "I mean, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.0,
      "end_seconds": 60.22,
      "duration_seconds": 2.22,
      "text": "Any black stools or vomiting at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.36,
      "end_seconds": 63.24,
      "duration_seconds": 1.88,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.22,
      "end_seconds": 69.64,
      "duration_seconds": 5.42,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 80.43,
      "duration_seconds": 9.94,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.04,
      "end_seconds": 81.97,
      "duration_seconds": 0.93,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.8,
      "end_seconds": 85.21,
      "duration_seconds": 2.41,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.57,
      "end_seconds": 94.21,
      "duration_seconds": 4.64,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.52,
      "end_seconds": 97.75,
      "duration_seconds": 3.23,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.89,
      "end_seconds": 103.86,
      "duration_seconds": 4.97,
      "text": "Okay, any allergies I should know about? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.4,
      "end_seconds": 107.42,
      "duration_seconds": 2.02,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.02,
      "end_seconds": 124.49,
      "duration_seconds": 16.47,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.79,
      "end_seconds": 130.35,
      "duration_seconds": 1.56,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.77,
      "end_seconds": 136.65,
      "duration_seconds": 3.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.6,
      "end_seconds": 140.37,
      "duration_seconds": 2.77,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.67,
      "end_seconds": 146.01,
      "duration_seconds": 4.34,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.35,
      "end_seconds": 147.18,
      "duration_seconds": 0.83,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.33,
      "end_seconds": 159.74,
      "duration_seconds": 3.41,
      "text": "Right, thanks for waiting. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.01,
      "end_seconds": 162.2,
      "duration_seconds": 1.19,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.68,
      "end_seconds": 166.46,
      "duration_seconds": 2.78,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.02,
      "end_seconds": 169.3,
      "duration_seconds": 1.28,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.07,
      "end_seconds": 173.12,
      "duration_seconds": 3.05,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.81,
      "end_seconds": 184.14,
      "duration_seconds": 1.33,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.19,
      "end_seconds": 204.58,
      "duration_seconds": 5.39,
      "text": "Okay: pulse is 76 beats a minute, temperature is 36.6 degrees, pressure 121 over 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.36,
      "end_seconds": 206.64,
      "duration_seconds": 1.28,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.02,
      "end_seconds": 213.98,
      "duration_seconds": 5.96,
      "text": "We'll put it in context in a moment. I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.98,
      "end_seconds": 218.13,
      "duration_seconds": 3.15,
      "text": "Um, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.51,
      "end_seconds": 221.62,
      "duration_seconds": 2.11,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.14,
      "end_seconds": 228.73,
      "duration_seconds": 6.59,
      "text": "I mean, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.79,
      "end_seconds": 246.96,
      "duration_seconds": 17.17,
      "text": "Right, here's what I'm thinking. I think we're dealing with possible side effects from too many medicines at this stage. Let me just recap so I've got it right. You've been feeling a bit dizzy after taking all your tablets for about a week, and no black stools or vomiting."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.79,
      "end_seconds": 249.0,
      "duration_seconds": 1.21,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.36,
      "end_seconds": 252.94,
      "duration_seconds": 2.58,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.24,
      "end_seconds": 257.06,
      "duration_seconds": 2.82,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 264.97,
      "duration_seconds": 7.13,
      "text": "We should do blood tests for medication review. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.4,
      "end_seconds": 267.69,
      "duration_seconds": 2.29,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.94,
      "end_seconds": 292.94,
      "duration_seconds": 24.0,
      "text": "Bring every box and bottle you have at home to the next visit, even the herbal ones, and we'll sort them together. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.44,
      "end_seconds": 295.84,
      "duration_seconds": 1.4,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.1,
      "end_seconds": 305.39,
      "duration_seconds": 8.29,
      "text": "Let's review you in a week. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.37,
      "end_seconds": 310.24,
      "duration_seconds": 3.87,
      "text": "So, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.1,
      "end_seconds": 315.52,
      "duration_seconds": 4.42,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.73,
      "end_seconds": 320.83,
      "duration_seconds": 4.1,
      "text": "Okay, thank you. I'll get started on all of that."
    }
  ]
}