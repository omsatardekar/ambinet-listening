{
  "schema_version": "1.0",
  "encounter_id": "00418",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 3.82,
      "duration_seconds": 2.72,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.41,
      "end_seconds": 9.89,
      "duration_seconds": 5.48,
      "text": "So, yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 19.61,
      "duration_seconds": 8.6,
      "text": "It's pain in my right ear. I thought I'd wait, but it hasn't gone. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.43,
      "end_seconds": 26.14,
      "duration_seconds": 5.71,
      "text": "How long have you had it? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.71,
      "end_seconds": 36.1,
      "duration_seconds": 9.39,
      "text": "So, um, I've had it for about a week. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.91,
      "end_seconds": 42.91,
      "duration_seconds": 6.0,
      "text": "Okay, give me more detail on it, whatever comes to mind. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.97,
      "end_seconds": 58.03,
      "duration_seconds": 14.06,
      "text": "Um, um, honestly, all the time. It's worse with lying on it. Pretty mild, if I'm being honest. I'm not great at remembering details, so bear with me. Oh, and muffled hearing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.82,
      "end_seconds": 62.95,
      "duration_seconds": 4.13,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 64.4,
      "duration_seconds": 0.78,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.32,
      "end_seconds": 78.38,
      "duration_seconds": 5.06,
      "text": "Alright, I've got it. Have you had any dizziness, ringing or recent swim?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.59,
      "end_seconds": 82.6,
      "duration_seconds": 3.01,
      "text": "No, no dizziness, ringing or recent swim."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.03,
      "end_seconds": 85.88,
      "duration_seconds": 2.85,
      "text": "Have you had any discharge from the ear?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.08,
      "end_seconds": 90.47,
      "duration_seconds": 3.39,
      "text": "Not at all, no discharge from the ear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.79,
      "end_seconds": 95.76,
      "duration_seconds": 1.97,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.38,
      "end_seconds": 97.99,
      "duration_seconds": 1.61,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 98.38,
      "end_seconds": 106.13,
      "duration_seconds": 7.75,
      "text": "Doctor, I've got the readings for you. Pulse 102, SpO2 96 percent on room air, BP is 110 over 77, temp 39.1 degrees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.07,
      "end_seconds": 113.46,
      "duration_seconds": 6.39,
      "text": "Okay, noted. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.14,
      "end_seconds": 123.89,
      "duration_seconds": 9.75,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.76,
      "end_seconds": 128.42,
      "duration_seconds": 3.66,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.78,
      "end_seconds": 130.45,
      "duration_seconds": 1.67,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.42,
      "end_seconds": 133.44,
      "duration_seconds": 2.02,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.68,
      "end_seconds": 139.08,
      "duration_seconds": 4.4,
      "text": "Hmm, yes, latex. I get a rash on my hands."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.49,
      "end_seconds": 143.55,
      "duration_seconds": 3.06,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.83,
      "end_seconds": 154.8,
      "duration_seconds": 9.97,
      "text": "I have asthma, for five years. I looked a few things up online, and that probably didn't help. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.54,
      "end_seconds": 171.41,
      "duration_seconds": 15.87,
      "text": "Right. Yes, I can see the asthma in your file as well. I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.96,
      "end_seconds": 174.88,
      "duration_seconds": 1.92,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.14,
      "end_seconds": 178.58,
      "duration_seconds": 2.44,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.82,
      "end_seconds": 183.4,
      "duration_seconds": 3.58,
      "text": "I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.58,
      "end_seconds": 190.91,
      "duration_seconds": 3.33,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.53,
      "end_seconds": 201.76,
      "duration_seconds": 10.23,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.12,
      "end_seconds": 207.1,
      "duration_seconds": 3.98,
      "text": "Okay, any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.67,
      "end_seconds": 219.46,
      "duration_seconds": 9.79,
      "text": "I'm on Asthalin inhaler, when needed. Paracetamol. I take it 500 milligrams, when needed. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.01,
      "end_seconds": 221.95,
      "duration_seconds": 1.94,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 229.52,
      "duration_seconds": 6.48,
      "text": "Well, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.71,
      "end_seconds": 234.46,
      "duration_seconds": 2.75,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.63,
      "end_seconds": 236.9,
      "duration_seconds": 1.27,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 256.96,
      "duration_seconds": 1.68,
      "text": "The left ear looks normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.88,
      "end_seconds": 258.58,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.09,
      "end_seconds": 273.43,
      "duration_seconds": 12.34,
      "text": "That's fine, you can get dressed. Putting it all together, this looks most like a middle ear infection. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.83,
      "end_seconds": 275.76,
      "duration_seconds": 1.93,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.09,
      "end_seconds": 294.41,
      "duration_seconds": 17.32,
      "text": "I understand the worry. At the moment I'd say it's a middle ear infection, and we'll watch how it goes. Let me just recap so I've got it right. You've had pain in your right ear for about a week, mild, and no discharge from the ear or ringing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.32,
      "end_seconds": 296.7,
      "duration_seconds": 1.38,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.25,
      "end_seconds": 300.8,
      "duration_seconds": 3.55,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.2,
      "end_seconds": 312.97,
      "duration_seconds": 11.77,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 342.81,
      "duration_seconds": 28.43,
      "text": "I'd like you to take azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. That's for ear infection. Keep the ear dry for now and don't put anything in it, including cotton buds. Cut down on salt and fried food for now, it really does make a difference. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.52,
      "end_seconds": 353.53,
      "duration_seconds": 10.01,
      "text": "I want you to come back or go to emergency straight away if you get discharge, swelling behind the ear or the pain gets much worse."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.9,
      "end_seconds": 356.46,
      "duration_seconds": 1.56,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.01,
      "end_seconds": 358.92,
      "duration_seconds": 1.91,
      "text": "Come back in ten days."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.41,
      "end_seconds": 361.11,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.25,
      "end_seconds": 369.19,
      "duration_seconds": 6.94,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.74,
      "end_seconds": 378.25,
      "duration_seconds": 8.51,
      "text": "So, uh, I take the azithromycin, 500 milligrams, once a day and come back in ten days. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.95,
      "end_seconds": 383.0,
      "duration_seconds": 4.05,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.7,
      "end_seconds": 386.41,
      "duration_seconds": 2.71,
      "text": "Nothing more from me, doctor, thanks."
    }
  ]
}