{
  "schema_version": "1.0",
  "encounter_id": "00341",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 2.08,
      "duration_seconds": 1.47,
      "text": "Hello, please sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 2.83,
      "end_seconds": 6.75,
      "duration_seconds": 3.92,
      "text": "Um, uh, hello, doctor. Thanks for seeing me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.89,
      "end_seconds": 10.48,
      "duration_seconds": 2.59,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.94,
      "end_seconds": 12.78,
      "duration_seconds": 1.84,
      "text": "Okay. Start wherever you like."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 19.88,
      "duration_seconds": 6.59,
      "text": "So the thing is, I've got heartburn. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.29,
      "end_seconds": 24.72,
      "duration_seconds": 3.43,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 32.55,
      "duration_seconds": 6.79,
      "text": "Probably one week. Yeah. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.79,
      "end_seconds": 41.09,
      "duration_seconds": 7.3,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.61,
      "end_seconds": 48.77,
      "duration_seconds": 6.16,
      "text": "I, I notice it more with big meals and lying down. Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.32,
      "end_seconds": 51.87,
      "duration_seconds": 2.55,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.49,
      "end_seconds": 59.18,
      "duration_seconds": 6.69,
      "text": "I mean, when it starts I tend to get chest discomfort after eating as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.49,
      "end_seconds": 64.2,
      "duration_seconds": 4.71,
      "text": "What about a lump feeling in the throat, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.47,
      "end_seconds": 66.38,
      "duration_seconds": 0.91,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.22,
      "end_seconds": 70.18,
      "duration_seconds": 2.96,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.98,
      "end_seconds": 82.91,
      "duration_seconds": 11.93,
      "text": "Moderate, I'd say. The chest discomfort after eating? That's been for about two weeks. As for chest discomfort after eating, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.33,
      "end_seconds": 89.58,
      "duration_seconds": 4.25,
      "text": "Have you had heartburn before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.57,
      "end_seconds": 95.32,
      "duration_seconds": 4.75,
      "text": "I mean, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.13,
      "end_seconds": 99.9,
      "duration_seconds": 3.77,
      "text": "Any pain on exertion, black stools, vomiting blood or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.35,
      "end_seconds": 103.24,
      "duration_seconds": 1.89,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.83,
      "end_seconds": 107.5,
      "duration_seconds": 2.67,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.64,
      "end_seconds": 110.51,
      "duration_seconds": 1.87,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.62,
      "end_seconds": 113.91,
      "duration_seconds": 2.29,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.09,
      "end_seconds": 116.86,
      "duration_seconds": 1.77,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.17,
      "end_seconds": 122.69,
      "duration_seconds": 4.52,
      "text": "Alright, what medicines do you take regularly? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.98,
      "end_seconds": 127.72,
      "duration_seconds": 3.74,
      "text": "Pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 128.16,
      "end_seconds": 135.77,
      "duration_seconds": 7.61,
      "text": "Doctor, I think the last prescription for the pantoprazole was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 140.61,
      "duration_seconds": 4.06,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.72,
      "end_seconds": 150.1,
      "duration_seconds": 8.38,
      "text": "Not with me. I'll bring it next time. I take ramipril, 5 milligrams, every morning. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.02,
      "end_seconds": 154.82,
      "duration_seconds": 3.8,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.45,
      "end_seconds": 158.63,
      "duration_seconds": 3.18,
      "text": "Not that I know, um, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.53,
      "end_seconds": 161.37,
      "duration_seconds": 1.84,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.03,
      "end_seconds": 173.94,
      "duration_seconds": 11.91,
      "text": "Yes, I had a C-section, about ten years ago. I'm hoping you can tell me something definite. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 179.36,
      "duration_seconds": 3.94,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.8,
      "end_seconds": 180.5,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.23,
      "end_seconds": 199.69,
      "duration_seconds": 3.46,
      "text": "Okay, here we go. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.48,
      "end_seconds": 202.49,
      "duration_seconds": 2.01,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.92,
      "end_seconds": 210.54,
      "duration_seconds": 6.62,
      "text": "Any long-term health problems I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.6,
      "end_seconds": 232.86,
      "duration_seconds": 21.26,
      "text": "I have acid reflux, for nearly five years. I told myself I'd wait and see, and here I am. I've, I've had high blood pressure for about a year now. I wasn't sure whether to come in at all, to be honest. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 240.04,
      "duration_seconds": 6.41,
      "text": "Mm-hm. Yes, I can see the acid reflux in your file as well. Alright, what about alcohol?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.34,
      "end_seconds": 244.65,
      "duration_seconds": 3.31,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 245.77,
      "end_seconds": 257.12,
      "duration_seconds": 11.35,
      "text": "Here are the numbers, doctor. Weight 84 kilos, BMI works out to 36.4, blood pressure 120 over 72, temp 37.0 degrees, heart rate 72, height 152 centimetres."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.59,
      "end_seconds": 261.75,
      "duration_seconds": 4.16,
      "text": "Good, thank you. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.95,
      "end_seconds": 266.13,
      "duration_seconds": 3.18,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.83,
      "end_seconds": 271.42,
      "duration_seconds": 3.59,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.83,
      "end_seconds": 273.53,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.18,
      "end_seconds": 277.79,
      "duration_seconds": 2.61,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.47,
      "end_seconds": 297.13,
      "duration_seconds": 1.66,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.53,
      "end_seconds": 299.27,
      "duration_seconds": 1.74,
      "text": "Yes, uh, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.31,
      "end_seconds": 321.08,
      "duration_seconds": 16.77,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, it fits best with gastro-oesophageal reflux. I can't rule out gastritis yet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.68,
      "end_seconds": 323.29,
      "duration_seconds": 1.61,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.9,
      "end_seconds": 340.61,
      "duration_seconds": 13.71,
      "text": "I can't promise yet, but most people with gastro-oesophageal reflux do well once it's treated properly. Let me just recap so I've got it right. You've had heartburn for one week, mild, and no black stools or vomiting blood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.87,
      "end_seconds": 343.3,
      "duration_seconds": 1.43,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.67,
      "end_seconds": 364.47,
      "duration_seconds": 19.8,
      "text": "We should do an ECG for chest discomfort. The result will help us decide whether anything more is needed. We should do an upper endoscopy for persistent reflux. I'd rather check than guess, and this is the quickest way to know more. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.94,
      "end_seconds": 383.76,
      "duration_seconds": 18.82,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.24,
      "end_seconds": 385.68,
      "duration_seconds": 1.44,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.22,
      "end_seconds": 392.32,
      "duration_seconds": 6.1,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.07,
      "end_seconds": 394.96,
      "duration_seconds": 1.89,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.65,
      "end_seconds": 398.83,
      "duration_seconds": 3.18,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.33,
      "end_seconds": 406.51,
      "duration_seconds": 4.18,
      "text": "Yeah, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.21,
      "end_seconds": 408.61,
      "duration_seconds": 1.4,
      "text": "Good. Look after yourself."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 409.73,
      "end_seconds": 413.73,
      "duration_seconds": 4.0,
      "text": "Hmm, that's all, thank you for your time."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.13,
      "end_seconds": 415.09,
      "duration_seconds": 0.96,
      "text": "See you then."
    }
  ]
}