{
  "schema_version": "1.0",
  "encounter_id": "00096",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.78,
      "duration_seconds": 3.27,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.09,
      "end_seconds": 8.33,
      "duration_seconds": 3.24,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.77,
      "end_seconds": 13.63,
      "duration_seconds": 4.86,
      "text": "So, you know, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.69,
      "end_seconds": 18.27,
      "duration_seconds": 3.58,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.31,
      "end_seconds": 23.29,
      "duration_seconds": 3.98,
      "text": "So, I've been losing weight without trying, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.5,
      "end_seconds": 26.12,
      "duration_seconds": 1.62,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.64,
      "end_seconds": 30.12,
      "duration_seconds": 2.48,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.14,
      "end_seconds": 34.2,
      "duration_seconds": 3.06,
      "text": "Okay, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.75,
      "end_seconds": 50.18,
      "duration_seconds": 15.43,
      "text": "Right, uh, it usually comes with night sweats. Oh, and a low fever in the evenings. Had that since Friday. The night sweats? That's been for three days. As for night sweats, I'd say on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.44,
      "end_seconds": 55.48,
      "duration_seconds": 4.04,
      "text": "Have you had any shortness of breath or lumps in the neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.99,
      "end_seconds": 59.4,
      "duration_seconds": 2.41,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.7,
      "end_seconds": 63.2,
      "duration_seconds": 2.5,
      "text": "Any diarrhoea or blood in the stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.8,
      "end_seconds": 69.49,
      "duration_seconds": 4.69,
      "text": "Oh, I haven't had diarrhoea or blood in the stool, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.82,
      "end_seconds": 72.84,
      "duration_seconds": 2.02,
      "text": "And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.54,
      "end_seconds": 75.62,
      "duration_seconds": 2.08,
      "text": "No chest pain, thank goodness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.76,
      "end_seconds": 81.6,
      "duration_seconds": 2.84,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.59,
      "end_seconds": 85.13,
      "duration_seconds": 2.54,
      "text": "Uh, no, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 89.5,
      "duration_seconds": 3.04,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.48,
      "end_seconds": 93.35,
      "duration_seconds": 2.87,
      "text": "Hmm, no, all normal there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.99,
      "end_seconds": 96.26,
      "duration_seconds": 2.27,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.86,
      "end_seconds": 101.46,
      "duration_seconds": 4.6,
      "text": "Glimepiride, 2 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.36,
      "end_seconds": 108.65,
      "duration_seconds": 4.29,
      "text": "So, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.95,
      "end_seconds": 115.46,
      "duration_seconds": 5.51,
      "text": "Not with me. I'll bring it next time. Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 115.99,
      "end_seconds": 125.67,
      "duration_seconds": 9.68,
      "text": "Doctor, uh, I think the last prescription for the Thyronorm was 100 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.17,
      "end_seconds": 128.98,
      "duration_seconds": 2.81,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.46,
      "end_seconds": 135.72,
      "duration_seconds": 5.26,
      "text": "Right, um, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.27,
      "end_seconds": 139.89,
      "duration_seconds": 3.62,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.42,
      "end_seconds": 149.6,
      "duration_seconds": 8.18,
      "text": "Okay, uh, so I'm allergic to ibuprofen, I get a rash. Yes, aspirin, it gives me wheezing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.11,
      "end_seconds": 154.87,
      "duration_seconds": 3.76,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.42,
      "end_seconds": 164.84,
      "duration_seconds": 8.42,
      "text": "I've had diabetes for nearly five years now. I thought it would sort itself out, uh, but it hasn't."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.28,
      "end_seconds": 167.41,
      "duration_seconds": 1.13,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.97,
      "end_seconds": 174.73,
      "duration_seconds": 6.76,
      "text": "So, um, I've got an underactive thyroid. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.32,
      "end_seconds": 185.28,
      "duration_seconds": 9.96,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. Right, so that's your known an underactive thyroid. We'll keep that in mind today. What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 190.79,
      "duration_seconds": 4.24,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.57,
      "end_seconds": 195.29,
      "duration_seconds": 3.72,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.16,
      "end_seconds": 202.35,
      "duration_seconds": 6.19,
      "text": "Right, my uncle had colon cancer. Okay, you know, so my father had kidney stones."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 205.41,
      "duration_seconds": 1.98,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.68,
      "end_seconds": 213.63,
      "duration_seconds": 6.95,
      "text": "Just my gallbladder removed, in 2016. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.51,
      "end_seconds": 218.59,
      "duration_seconds": 4.08,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.08,
      "end_seconds": 237.16,
      "duration_seconds": 17.08,
      "text": "I mean, um, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.08,
      "end_seconds": 240.97,
      "duration_seconds": 2.89,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.25,
      "end_seconds": 256.21,
      "duration_seconds": 1.96,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.78,
      "end_seconds": 274.56,
      "duration_seconds": 7.78,
      "text": "Okay: heart rate 106, respiratory rate 17, temp 38.5 degrees, BP is 117 over 71, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.48,
      "end_seconds": 281.82,
      "duration_seconds": 4.34,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.06,
      "end_seconds": 284.61,
      "duration_seconds": 1.55,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.11,
      "end_seconds": 289.41,
      "duration_seconds": 3.3,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.42,
      "end_seconds": 304.63,
      "duration_seconds": 4.21,
      "text": "Air entry is a bit reduced at the top of the right lung."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.55,
      "end_seconds": 308.63,
      "duration_seconds": 2.08,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.26,
      "end_seconds": 327.09,
      "duration_seconds": 4.83,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.26,
      "end_seconds": 349.61,
      "duration_seconds": 20.35,
      "text": "That's fine, you can get dressed. Right, here's what I'm thinking. It fits best with an infection or something chronic going on, I can't say what yet. I want to be honest that this is an impression, not a final answer. It could also be a thyroid problem, so we'll keep that open."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.11,
      "end_seconds": 361.49,
      "duration_seconds": 11.38,
      "text": "Let me just recap so I've got it right. You've been losing weight without trying for four weeks, and no blood in the stool or lumps in the neck."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.89,
      "end_seconds": 364.37,
      "duration_seconds": 1.48,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.23,
      "end_seconds": 375.95,
      "duration_seconds": 10.72,
      "text": "I'm going to order a sputum test, for chronic cough. That will help us see what's going on underneath and decide the next step. Let's get a chest X-ray, for weight loss and cough."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.91,
      "end_seconds": 382.48,
      "duration_seconds": 5.57,
      "text": "Okay, um, so sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.85,
      "end_seconds": 393.17,
      "duration_seconds": 10.32,
      "text": "I'm going to order blood tests, for weight loss. The result will help us decide whether anything more is needed. Weigh yourself once a week at the same time and note it down."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.51,
      "end_seconds": 401.71,
      "duration_seconds": 8.2,
      "text": "Mm-hm. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the chest clinic."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.03,
      "end_seconds": 405.47,
      "duration_seconds": 2.44,
      "text": "Alright, uh, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.22,
      "end_seconds": 413.38,
      "duration_seconds": 7.16,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.79,
      "end_seconds": 416.21,
      "duration_seconds": 2.42,
      "text": "Okay, uh, I will."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.34,
      "end_seconds": 430.65,
      "duration_seconds": 13.31,
      "text": "I want you to come back or go to emergency straight away if you cough up blood or get breathless. Let's review you in a week. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.16,
      "end_seconds": 436.96,
      "duration_seconds": 2.8,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.5,
      "end_seconds": 439.2,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}