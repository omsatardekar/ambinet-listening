{
  "schema_version": "1.0",
  "encounter_id": "00002",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 5.58,
      "duration_seconds": 4.65,
      "text": "Hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.02,
      "end_seconds": 9.31,
      "duration_seconds": 3.29,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.22,
      "end_seconds": 15.04,
      "duration_seconds": 4.82,
      "text": "Yeah, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.19,
      "end_seconds": 19.64,
      "duration_seconds": 3.45,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.4,
      "end_seconds": 27.2,
      "duration_seconds": 6.8,
      "text": "So, uh, I've been feeling a bit dizzy after taking all my tablets, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.81,
      "end_seconds": 31.99,
      "duration_seconds": 2.18,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.16,
      "end_seconds": 40.0,
      "duration_seconds": 6.84,
      "text": "It's been going on for two months. I just want to get back to normal, uh, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.93,
      "end_seconds": 43.12,
      "duration_seconds": 2.19,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.36,
      "end_seconds": 45.74,
      "duration_seconds": 1.38,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.02,
      "end_seconds": 49.71,
      "duration_seconds": 2.69,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.8,
      "end_seconds": 68.0,
      "duration_seconds": 17.2,
      "text": "Honestly, once or twice a day. Well, as for feeling drowsy in the afternoon, I honestly can't say when that began. It might have been last month or the month before. I've been feeling confused about which tablets to take too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.58,
      "end_seconds": 71.52,
      "duration_seconds": 2.94,
      "text": "Any low mood, fainting or vomiting at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.75,
      "end_seconds": 74.94,
      "duration_seconds": 2.19,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.35,
      "end_seconds": 78.6,
      "duration_seconds": 3.25,
      "text": "Have you had any black stools, falls or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.03,
      "end_seconds": 82.39,
      "duration_seconds": 3.36,
      "text": "Hmm, no, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 87.18,
      "duration_seconds": 3.52,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.72,
      "end_seconds": 89.4,
      "duration_seconds": 1.68,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.43,
      "end_seconds": 91.98,
      "duration_seconds": 1.55,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.89,
      "end_seconds": 94.33,
      "duration_seconds": 1.44,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.94,
      "end_seconds": 99.37,
      "duration_seconds": 4.43,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 113.1,
      "duration_seconds": 4.59,
      "text": "That's saved, thanks for waiting. Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.94,
      "end_seconds": 137.67,
      "duration_seconds": 20.73,
      "text": "I have diabetes, for five years. A neighbour of mine said I should see someone about it. Oh, I've had high blood pressure for two years now. I kept putting it off, which I know isn't sensible. I have arthritis in my knees, for two years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.32,
      "end_seconds": 145.92,
      "duration_seconds": 4.6,
      "text": "I see. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.01,
      "end_seconds": 148.92,
      "duration_seconds": 1.91,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.27,
      "end_seconds": 155.09,
      "duration_seconds": 4.82,
      "text": "What medicines do you take regularly? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.82,
      "end_seconds": 165.53,
      "duration_seconds": 6.71,
      "text": "I'm on metformin, 500 milligrams, twice a day for my sugar. Losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 166.77,
      "end_seconds": 175.16,
      "duration_seconds": 8.39,
      "text": "Doctor, I think the last prescription for the losartan was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.75,
      "end_seconds": 179.78,
      "duration_seconds": 4.03,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.64,
      "end_seconds": 188.98,
      "duration_seconds": 8.34,
      "text": "Um, um, I don't think I have it with me. I'm on diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.67,
      "end_seconds": 191.7,
      "duration_seconds": 2.03,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.2,
      "end_seconds": 197.44,
      "duration_seconds": 4.24,
      "text": "I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.26,
      "end_seconds": 201.66,
      "duration_seconds": 3.4,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.24,
      "end_seconds": 202.94,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.76,
      "end_seconds": 222.48,
      "duration_seconds": 3.72,
      "text": "Okay, here we go. Okay, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.95,
      "end_seconds": 227.03,
      "duration_seconds": 3.08,
      "text": "I mean, not that I know, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.43,
      "end_seconds": 232.63,
      "duration_seconds": 4.2,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.75,
      "end_seconds": 235.72,
      "duration_seconds": 1.97,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.72,
      "end_seconds": 239.13,
      "duration_seconds": 2.41,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.7,
      "end_seconds": 240.46,
      "duration_seconds": 0.76,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.83,
      "end_seconds": 254.31,
      "duration_seconds": 3.48,
      "text": "Alright, I've got it. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.78,
      "end_seconds": 268.15,
      "duration_seconds": 1.37,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.98,
      "end_seconds": 296.39,
      "duration_seconds": 6.41,
      "text": "Okay: pressure 112 over 73, saturation 97 percent. And pulse 77, respiratory rate 14, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.78,
      "end_seconds": 300.8,
      "duration_seconds": 3.02,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.77,
      "end_seconds": 302.47,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.91,
      "end_seconds": 306.03,
      "duration_seconds": 2.12,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.24,
      "end_seconds": 322.4,
      "duration_seconds": 3.16,
      "text": "Your blood pressure falls a little when you stand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.55,
      "end_seconds": 337.69,
      "duration_seconds": 11.14,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.2,
      "end_seconds": 339.93,
      "duration_seconds": 1.73,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.38,
      "end_seconds": 358.16,
      "duration_seconds": 16.78,
      "text": "Right, here's what I'm thinking. This looks most like possible side effects from too many medicines. I want to be honest that this is an impression, not a final answer. It could also be low blood pressure, so we'll keep that open."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.48,
      "end_seconds": 361.9,
      "duration_seconds": 3.42,
      "text": "Okay, so is this going to go away?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.62,
      "end_seconds": 380.88,
      "duration_seconds": 18.26,
      "text": "I understand the worry. At the moment I'd say it's possible side effects from too many medicines, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've been feeling a bit dizzy after taking all your tablets for two months, moderate, and no vomiting or fainting."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.47,
      "end_seconds": 383.72,
      "duration_seconds": 1.25,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.1,
      "end_seconds": 394.06,
      "duration_seconds": 8.96,
      "text": "Let's get blood tests, for medication review. I'd rather check than guess, and this is the quickest way to know more. We should do an ECG for dizziness."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.95,
      "end_seconds": 400.32,
      "duration_seconds": 2.37,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.66,
      "end_seconds": 418.84,
      "duration_seconds": 17.18,
      "text": "Use a weekly pill organiser so the doses don't get mixed. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.91,
      "end_seconds": 421.18,
      "duration_seconds": 1.27,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.64,
      "end_seconds": 431.52,
      "duration_seconds": 7.88,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back in a week."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.38,
      "end_seconds": 433.08,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.72,
      "end_seconds": 440.97,
      "duration_seconds": 7.25,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.37,
      "end_seconds": 447.29,
      "duration_seconds": 4.92,
      "text": "So, you know, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.71,
      "end_seconds": 452.01,
      "duration_seconds": 4.3,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.53,
      "end_seconds": 457.03,
      "duration_seconds": 3.5,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.33,
      "end_seconds": 459.54,
      "duration_seconds": 2.21,
      "text": "Bye for now, look after yourself."
    }
  ]
}