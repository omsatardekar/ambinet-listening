{
  "schema_version": "1.0",
  "encounter_id": "00100",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 3.85,
      "duration_seconds": 2.52,
      "text": "Good morning, how are you doing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.25,
      "end_seconds": 8.89,
      "duration_seconds": 3.64,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.51,
      "end_seconds": 13.36,
      "duration_seconds": 3.85,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.3,
      "end_seconds": 20.82,
      "duration_seconds": 6.52,
      "text": "It's breathlessness when I lie flat, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.65,
      "end_seconds": 26.97,
      "duration_seconds": 5.32,
      "text": "How long have you had it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.27,
      "end_seconds": 30.43,
      "duration_seconds": 2.16,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.75,
      "end_seconds": 33.91,
      "duration_seconds": 2.16,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.78,
      "end_seconds": 37.8,
      "duration_seconds": 3.02,
      "text": "Sitting up on pillows helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.18,
      "end_seconds": 41.61,
      "duration_seconds": 2.43,
      "text": "Okay, how much is it bothering you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.98,
      "end_seconds": 45.98,
      "duration_seconds": 4.0,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.36,
      "end_seconds": 52.79,
      "duration_seconds": 3.43,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 56.41,
      "duration_seconds": 2.76,
      "text": "Hmm, it's worse with lying flat."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.77,
      "end_seconds": 59.54,
      "duration_seconds": 1.77,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.22,
      "end_seconds": 66.65,
      "duration_seconds": 5.43,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 73.19,
      "duration_seconds": 5.14,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.26,
      "end_seconds": 77.39,
      "duration_seconds": 3.13,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.23,
      "end_seconds": 86.24,
      "duration_seconds": 8.01,
      "text": "So, you know, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.34,
      "end_seconds": 90.3,
      "duration_seconds": 3.96,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.42,
      "end_seconds": 106.71,
      "duration_seconds": 15.29,
      "text": "Well, I was getting to that! Um, I've had tiredness too, for ten days. As for dry cough at night, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.55,
      "end_seconds": 109.13,
      "duration_seconds": 1.58,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.01,
      "end_seconds": 115.24,
      "duration_seconds": 1.23,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 116.53,
      "end_seconds": 121.98,
      "duration_seconds": 5.45,
      "text": "Yeah, um, actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.88,
      "end_seconds": 127.65,
      "duration_seconds": 4.77,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.33,
      "end_seconds": 137.3,
      "duration_seconds": 8.97,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any calf pain, fainting, chest pain or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.48,
      "end_seconds": 149.17,
      "duration_seconds": 10.69,
      "text": "No, no calf pain, no fainting, no chest pain. I was waking up at night short of breath at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.43,
      "end_seconds": 153.38,
      "duration_seconds": 3.95,
      "text": "Go on. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.69,
      "end_seconds": 155.48,
      "duration_seconds": 1.79,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 160.01,
      "duration_seconds": 3.69,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.44,
      "end_seconds": 163.73,
      "duration_seconds": 2.29,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.02,
      "end_seconds": 171.3,
      "duration_seconds": 4.28,
      "text": "Okay, what about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.27,
      "end_seconds": 173.74,
      "duration_seconds": 1.47,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.1,
      "end_seconds": 177.27,
      "duration_seconds": 2.17,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.6,
      "end_seconds": 187.39,
      "duration_seconds": 9.79,
      "text": "I, I take furosemide, 40 milligrams, every morning for the fluid. I'm on amlodipine, 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.61,
      "end_seconds": 191.01,
      "duration_seconds": 2.4,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.67,
      "end_seconds": 196.4,
      "duration_seconds": 4.73,
      "text": "About three months now. It's clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 197.89,
      "end_seconds": 201.63,
      "duration_seconds": 3.74,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.02,
      "end_seconds": 205.41,
      "duration_seconds": 3.39,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.77,
      "end_seconds": 211.07,
      "duration_seconds": 4.3,
      "text": "Yeah, uh, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.0,
      "end_seconds": 218.97,
      "duration_seconds": 5.97,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.43,
      "end_seconds": 221.46,
      "duration_seconds": 2.03,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.11,
      "end_seconds": 234.45,
      "duration_seconds": 12.34,
      "text": "For my sugar, I believe. My wife sets them out for me, I just take what I'm given. So, I used to take losartan, but I stopped it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.83,
      "end_seconds": 236.33,
      "duration_seconds": 1.5,
      "text": "Right, do you smoke?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.51,
      "end_seconds": 238.78,
      "duration_seconds": 1.27,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.04,
      "end_seconds": 241.17,
      "duration_seconds": 1.13,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.0,
      "end_seconds": 246.03,
      "duration_seconds": 4.03,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.64,
      "end_seconds": 249.3,
      "duration_seconds": 2.66,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 260.94,
      "duration_seconds": 11.26,
      "text": "I have heart failure, for two years. I did try to ignore it for a while. Yes, high blood pressure. I've got heart disease. I have diabetes, for five years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.2,
      "end_seconds": 265.6,
      "duration_seconds": 3.4,
      "text": "Okay, diabetes, that's already on your record. Good to know."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 266.44,
      "end_seconds": 272.06,
      "duration_seconds": 5.62,
      "text": "Okay, so the vitals from earlier. Pulse 99, temp 36.9 degrees, pressure 127 over 83."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.21,
      "end_seconds": 274.97,
      "duration_seconds": 0.76,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.89,
      "end_seconds": 280.68,
      "duration_seconds": 3.79,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.91,
      "end_seconds": 282.61,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.07,
      "end_seconds": 285.75,
      "duration_seconds": 1.68,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.55,
      "end_seconds": 304.1,
      "duration_seconds": 3.55,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.63,
      "end_seconds": 308.1,
      "duration_seconds": 2.47,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.86,
      "end_seconds": 322.38,
      "duration_seconds": 3.52,
      "text": "There's pitting oedema up to the shins on both legs."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.14,
      "end_seconds": 346.55,
      "duration_seconds": 20.41,
      "text": "All done, thank you, please sit down. So, based on the history and the examination, I think we're dealing with fluid overload related to the heart at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep a chest infection in mind. Let's get a chest X-ray, for breathlessness."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 350.87,
      "end_seconds": 353.9,
      "duration_seconds": 3.03,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.23,
      "end_seconds": 359.62,
      "duration_seconds": 4.39,
      "text": "Perfect. I'm going to order blood tests, for heart failure review."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.48,
      "end_seconds": 362.87,
      "duration_seconds": 2.39,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.85,
      "end_seconds": 388.42,
      "duration_seconds": 24.57,
      "text": "Weigh yourself every morning, and tell us if you put on more than two kilos in a few days. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. A short walk every day, even twenty minutes, will help more than you'd think. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.91,
      "end_seconds": 390.27,
      "duration_seconds": 1.36,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.42,
      "end_seconds": 401.48,
      "duration_seconds": 10.06,
      "text": "Keep an eye out, and if the breathlessness gets worse or you can't lie down at all, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.98,
      "end_seconds": 404.64,
      "duration_seconds": 1.66,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.69,
      "end_seconds": 408.32,
      "duration_seconds": 2.63,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 408.71,
      "end_seconds": 411.22,
      "duration_seconds": 2.51,
      "text": "Okay, uh, I'll book that."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.66,
      "end_seconds": 417.6,
      "duration_seconds": 2.94,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.55,
      "end_seconds": 420.89,
      "duration_seconds": 2.34,
      "text": "I appreciate your time, doctor."
    }
  ]
}