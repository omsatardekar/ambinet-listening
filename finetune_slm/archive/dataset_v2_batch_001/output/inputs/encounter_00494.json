{
  "schema_version": "1.0",
  "encounter_id": "00494",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.95,
      "duration_seconds": 3.9,
      "text": "So, morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 8.5,
      "duration_seconds": 3.02,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.11,
      "end_seconds": 11.39,
      "duration_seconds": 2.28,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.85,
      "end_seconds": 15.82,
      "duration_seconds": 2.97,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.91,
      "end_seconds": 19.56,
      "duration_seconds": 2.65,
      "text": "She's been having very heavy periods, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.59,
      "end_seconds": 22.49,
      "duration_seconds": 1.9,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.34,
      "end_seconds": 26.02,
      "duration_seconds": 2.68,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.34,
      "end_seconds": 30.25,
      "duration_seconds": 2.91,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.27,
      "end_seconds": 39.68,
      "duration_seconds": 8.41,
      "text": "Maybe a six out of ten on a bad day. And there's periods lasting longer as well, one week now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.53,
      "end_seconds": 45.3,
      "duration_seconds": 1.77,
      "text": "Have you been passing clots?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.88,
      "end_seconds": 48.79,
      "duration_seconds": 1.91,
      "text": "Yes, for about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.25,
      "end_seconds": 55.26,
      "duration_seconds": 6.01,
      "text": "Okay, I'm following. Have you had any vaginal discharge, fever, weight loss or pain during sex?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.05,
      "end_seconds": 61.65,
      "duration_seconds": 5.6,
      "text": "No vaginal discharge, fever, weight loss or pain during sex, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.99,
      "end_seconds": 66.62,
      "duration_seconds": 3.63,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.08,
      "end_seconds": 70.41,
      "duration_seconds": 2.33,
      "text": "Well, no, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.02,
      "end_seconds": 73.7,
      "duration_seconds": 2.68,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.22,
      "end_seconds": 75.92,
      "duration_seconds": 1.7,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.41,
      "end_seconds": 81.04,
      "duration_seconds": 3.63,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.71,
      "end_seconds": 82.58,
      "duration_seconds": 0.87,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.99,
      "end_seconds": 94.0,
      "duration_seconds": 5.01,
      "text": "Okay, here we go. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.22,
      "end_seconds": 101.18,
      "duration_seconds": 5.96,
      "text": "Sulfa drugs. I come out in... well, itching all over. Yes, aspirin. I get wheezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.65,
      "end_seconds": 106.28,
      "duration_seconds": 4.63,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.68,
      "end_seconds": 115.57,
      "duration_seconds": 8.89,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.15,
      "end_seconds": 119.09,
      "duration_seconds": 1.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.39,
      "end_seconds": 122.53,
      "duration_seconds": 2.14,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.4,
      "end_seconds": 125.93,
      "duration_seconds": 2.53,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.54,
      "end_seconds": 127.43,
      "duration_seconds": 0.89,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.13,
      "end_seconds": 143.27,
      "duration_seconds": 5.14,
      "text": "Alright, I've got it. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.6,
      "end_seconds": 161.13,
      "duration_seconds": 16.53,
      "text": "Pantoprazole, 40 milligrams, before breakfast for my acidity. Sorry, I know I'm rambling a bit. It's aspirin, 75 milligrams, once a day. I just want to get back to normal, really. It's mefenamic acid, 500 milligrams, when the pain is bad."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 162.01,
      "end_seconds": 169.46,
      "duration_seconds": 7.45,
      "text": "Doctor, I think the last prescription for the mefenamic acid was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.7,
      "end_seconds": 177.26,
      "duration_seconds": 4.56,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.68,
      "end_seconds": 185.62,
      "duration_seconds": 6.94,
      "text": "I don't think I have it with me. I was on Thyronorm before. I stopped taking it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.79,
      "end_seconds": 194.11,
      "duration_seconds": 4.32,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.14,
      "end_seconds": 197.61,
      "duration_seconds": 2.47,
      "text": "An underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.14,
      "end_seconds": 199.23,
      "duration_seconds": 1.09,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.53,
      "end_seconds": 202.28,
      "duration_seconds": 1.75,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.92,
      "end_seconds": 203.62,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.65,
      "end_seconds": 212.96,
      "duration_seconds": 8.31,
      "text": "Uh, I've had heart disease for about a year now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.03,
      "end_seconds": 225.37,
      "duration_seconds": 11.34,
      "text": "Okay, an underactive thyroid, that's already on your record. Good to know. Yes, I can see the acid reflux in your file as well. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.2,
      "end_seconds": 235.23,
      "duration_seconds": 2.03,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.86,
      "end_seconds": 259.97,
      "duration_seconds": 5.11,
      "text": "Okay: pulse 70, blood pressure 121 over 72, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.33,
      "end_seconds": 264.36,
      "duration_seconds": 2.03,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.53,
      "end_seconds": 266.23,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.99,
      "end_seconds": 269.54,
      "duration_seconds": 1.55,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.3,
      "end_seconds": 284.39,
      "duration_seconds": 6.09,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.31,
      "end_seconds": 286.58,
      "duration_seconds": 1.27,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.08,
      "end_seconds": 289.63,
      "duration_seconds": 1.55,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.44,
      "end_seconds": 310.24,
      "duration_seconds": 1.8,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.66,
      "end_seconds": 327.69,
      "duration_seconds": 12.03,
      "text": "That's fine, you can get dressed. So, based on the history and the examination, this looks most like heavy periods with a cause still to find. Fibroids is also on my list."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.5,
      "end_seconds": 330.43,
      "duration_seconds": 1.93,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.8,
      "end_seconds": 349.34,
      "duration_seconds": 17.54,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with a cause still to find, and we'll know more once the a pelvic ultrasound is back. Let me just recap so I've got it right. You've had very heavy periods, since this morning, and no fever or weight loss."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.9,
      "end_seconds": 351.74,
      "duration_seconds": 1.84,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.15,
      "end_seconds": 370.5,
      "duration_seconds": 18.35,
      "text": "I'm going to order a pelvic ultrasound, for heavy periods. The result will help us decide whether anything more is needed. Let's get a pregnancy test, for abnormal bleeding. The result will help us decide whether anything more is needed. Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.92,
      "end_seconds": 380.06,
      "duration_seconds": 8.14,
      "text": "I had blood tests done at another clinic a few months ago. I don't have the report with me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.5,
      "end_seconds": 404.5,
      "duration_seconds": 24.0,
      "text": "I'll start you on ferrous sulfate, 200 milligrams, once a day, for three months. You take it by mouth. It's for possible iron deficiency. It's a commonly used medicine and most people tolerate it well. Keep a note of how many pads you use each day and the dates, it helps us a lot. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.47,
      "end_seconds": 412.45,
      "duration_seconds": 6.98,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.37,
      "end_seconds": 414.85,
      "duration_seconds": 1.48,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.45,
      "end_seconds": 423.41,
      "duration_seconds": 7.96,
      "text": "I want you to come back or go to emergency straight away if you soak through a pad every hour or feel faint."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.21,
      "end_seconds": 424.91,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.24,
      "end_seconds": 428.79,
      "duration_seconds": 2.55,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.36,
      "end_seconds": 431.08,
      "duration_seconds": 1.72,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.21,
      "end_seconds": 438.38,
      "duration_seconds": 6.17,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.69,
      "end_seconds": 448.75,
      "duration_seconds": 10.06,
      "text": "So, I take the ferrous sulfate, 200 milligrams, once a day and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.05,
      "end_seconds": 454.84,
      "duration_seconds": 4.79,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 455.87,
      "end_seconds": 460.06,
      "duration_seconds": 4.19,
      "text": "Um, no, I think that's everything. Thank you, doctor."
    }
  ]
}