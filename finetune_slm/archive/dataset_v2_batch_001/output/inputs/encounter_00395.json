{
  "schema_version": "1.0",
  "encounter_id": "00395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 3.99,
      "duration_seconds": 3.26,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 8.7,
      "duration_seconds": 3.26,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.52,
      "end_seconds": 13.1,
      "duration_seconds": 3.58,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.2,
      "end_seconds": 17.32,
      "duration_seconds": 3.12,
      "text": "So, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.24,
      "end_seconds": 23.81,
      "duration_seconds": 5.57,
      "text": "It's tiredness all the time, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.12,
      "end_seconds": 26.03,
      "duration_seconds": 1.91,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.78,
      "end_seconds": 37.37,
      "duration_seconds": 10.59,
      "text": "It's been five days, I'm fairly sure. I've never really been one for hospitals. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.86,
      "end_seconds": 40.83,
      "duration_seconds": 1.97,
      "text": "Any hair falling out as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.05,
      "end_seconds": 56.81,
      "duration_seconds": 11.76,
      "text": "Yeah, uh, that too. Oh, and trouble concentrating. That's been about the same, about a month. About trouble concentrating, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.79,
      "end_seconds": 61.85,
      "duration_seconds": 4.06,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.85,
      "end_seconds": 66.75,
      "duration_seconds": 3.9,
      "text": "I'd rather not, um, if you don't mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.74,
      "end_seconds": 70.76,
      "duration_seconds": 3.02,
      "text": "Any chest pain or low mood at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.18,
      "end_seconds": 73.26,
      "duration_seconds": 2.08,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.68,
      "end_seconds": 76.0,
      "duration_seconds": 2.32,
      "text": "Any night sweats or shortness of breath?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.26,
      "end_seconds": 80.33,
      "duration_seconds": 3.07,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.65,
      "end_seconds": 85.3,
      "duration_seconds": 3.65,
      "text": "Alright, do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.39,
      "end_seconds": 92.18,
      "duration_seconds": 5.79,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 100.2,
      "duration_seconds": 7.37,
      "text": "Do you have any allergies to medicines, food, anything at all? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.86,
      "end_seconds": 104.69,
      "duration_seconds": 3.83,
      "text": "I'm allergic to eggs, I get stomach cramps."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.95,
      "end_seconds": 108.99,
      "duration_seconds": 3.04,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.85,
      "end_seconds": 110.71,
      "duration_seconds": 0.86,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.09,
      "end_seconds": 120.16,
      "duration_seconds": 3.07,
      "text": "Right, thanks for waiting. Any operations in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 126.55,
      "duration_seconds": 5.94,
      "text": "I mean, I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.53,
      "end_seconds": 141.92,
      "duration_seconds": 14.39,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.43,
      "end_seconds": 144.23,
      "duration_seconds": 1.8,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 147.2,
      "duration_seconds": 1.86,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.97,
      "end_seconds": 148.88,
      "duration_seconds": 0.91,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.5,
      "end_seconds": 161.18,
      "duration_seconds": 11.68,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.19,
      "end_seconds": 164.0,
      "duration_seconds": 1.81,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 166.36,
      "duration_seconds": 1.15,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.86,
      "end_seconds": 169.07,
      "duration_seconds": 2.21,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.94,
      "end_seconds": 170.87,
      "duration_seconds": 0.93,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.48,
      "end_seconds": 174.66,
      "duration_seconds": 3.18,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.0,
      "end_seconds": 178.71,
      "duration_seconds": 2.71,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.85,
      "end_seconds": 181.27,
      "duration_seconds": 1.42,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.76,
      "end_seconds": 185.43,
      "duration_seconds": 3.67,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.63,
      "end_seconds": 189.0,
      "duration_seconds": 2.37,
      "text": "Yeah, my mother has diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.05,
      "end_seconds": 193.12,
      "duration_seconds": 3.07,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.45,
      "end_seconds": 194.35,
      "duration_seconds": 0.9,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.34,
      "end_seconds": 218.4,
      "duration_seconds": 8.06,
      "text": "Right, thanks for waiting. What about your general health, any conditions you're being treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.89,
      "end_seconds": 228.2,
      "duration_seconds": 8.31,
      "text": "Okay, so I've had diabetes for nearly five years now. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.49,
      "end_seconds": 233.94,
      "duration_seconds": 4.45,
      "text": "Okay. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.59,
      "end_seconds": 236.85,
      "duration_seconds": 2.26,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.27,
      "end_seconds": 239.55,
      "duration_seconds": 2.28,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.93,
      "end_seconds": 248.24,
      "duration_seconds": 1.31,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.71,
      "end_seconds": 271.11,
      "duration_seconds": 8.4,
      "text": "Okay: temperature 36.9, BP is 108 over 69, pulse is 75 beats a minute. Okay, are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.63,
      "end_seconds": 276.02,
      "duration_seconds": 4.39,
      "text": "Oh, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.34,
      "end_seconds": 279.81,
      "duration_seconds": 2.47,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.8,
      "end_seconds": 284.3,
      "duration_seconds": 2.5,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.11,
      "end_seconds": 297.69,
      "duration_seconds": 2.58,
      "text": "You look a little pale in the eyelids."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.16,
      "end_seconds": 298.86,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.82,
      "end_seconds": 316.44,
      "duration_seconds": 12.62,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.6,
      "end_seconds": 322.01,
      "duration_seconds": 4.41,
      "text": "Uh, uh, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.3,
      "end_seconds": 332.11,
      "duration_seconds": 8.81,
      "text": "Putting it all together, this looks most like persistent tiredness, possibly from low iron. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.37,
      "end_seconds": 336.13,
      "duration_seconds": 2.76,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.45,
      "end_seconds": 352.85,
      "duration_seconds": 15.4,
      "text": "Nothing I've seen today points to an emergency. It looks like persistent tiredness, possibly from low iron, but I'd like to confirm. Let me just recap so I've got it right. You've had tiredness all the time for five days, and no chest pain or night sweats."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.2,
      "end_seconds": 356.43,
      "duration_seconds": 2.23,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.33,
      "end_seconds": 371.73,
      "duration_seconds": 14.4,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.93,
      "end_seconds": 375.04,
      "duration_seconds": 2.11,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.31,
      "end_seconds": 387.28,
      "duration_seconds": 10.97,
      "text": "I'd like to arrange a ferritin level for suspected low iron. I'm prescribing vitamin D, 60000 units, once a week, for eight weeks. That should help with low energy."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.64,
      "end_seconds": 391.46,
      "duration_seconds": 2.82,
      "text": "Right, uh, I'll remember that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.21,
      "end_seconds": 412.5,
      "duration_seconds": 20.29,
      "text": "Try to keep a regular sleep time and get some daylight in the morning. A short walk every day, even twenty minutes, will help more than you'd think. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.69,
      "end_seconds": 414.39,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.12,
      "end_seconds": 418.79,
      "duration_seconds": 3.67,
      "text": "Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.04,
      "end_seconds": 420.74,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.82,
      "end_seconds": 428.39,
      "duration_seconds": 6.57,
      "text": "Okay, I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.43,
      "end_seconds": 434.39,
      "duration_seconds": 4.96,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.93,
      "end_seconds": 442.15,
      "duration_seconds": 4.22,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.29,
      "end_seconds": 445.72,
      "duration_seconds": 2.43,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}