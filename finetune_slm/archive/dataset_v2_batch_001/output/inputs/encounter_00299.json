{
  "schema_version": "1.0",
  "encounter_id": "00299",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.09,
      "duration_seconds": 4.05,
      "text": "Hmm, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.59,
      "end_seconds": 11.65,
      "duration_seconds": 3.06,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.48,
      "end_seconds": 21.96,
      "duration_seconds": 9.48,
      "text": "So, So the thing is, I've got exhaustion since I had the flu. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.48,
      "end_seconds": 25.87,
      "duration_seconds": 2.39,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.84,
      "end_seconds": 37.71,
      "duration_seconds": 10.87,
      "text": "It's, It's been going on for about a month. I took the morning off to come in today. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.26,
      "end_seconds": 47.7,
      "duration_seconds": 9.44,
      "text": "Go on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.31,
      "end_seconds": 58.26,
      "duration_seconds": 9.95,
      "text": "It settles a little with sleeping in. I'd say severe. It's worse with walking far. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.46,
      "end_seconds": 61.45,
      "duration_seconds": 1.99,
      "text": "Has there been poor sleep too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.05,
      "end_seconds": 65.55,
      "duration_seconds": 3.5,
      "text": "Uh, yes, about the same, ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.09,
      "end_seconds": 69.44,
      "duration_seconds": 3.35,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.36,
      "end_seconds": 73.15,
      "duration_seconds": 2.79,
      "text": "No problem, uh, take your time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.74,
      "end_seconds": 76.03,
      "duration_seconds": 2.29,
      "text": "Any fever, shortness of breath or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.47,
      "end_seconds": 81.66,
      "duration_seconds": 4.19,
      "text": "I haven't had fever, shortness of breath or rash, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.9,
      "end_seconds": 86.13,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.05,
      "end_seconds": 90.72,
      "duration_seconds": 3.67,
      "text": "Um, no, I've never had anything serious."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 93.6,
      "duration_seconds": 1.36,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.09,
      "end_seconds": 98.33,
      "duration_seconds": 3.24,
      "text": "I mean, no, never had any surgery."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 100.32,
      "duration_seconds": 1.05,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.72,
      "end_seconds": 105.63,
      "duration_seconds": 3.91,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.16,
      "end_seconds": 106.94,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.84,
      "end_seconds": 110.63,
      "duration_seconds": 2.79,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.83,
      "end_seconds": 115.74,
      "duration_seconds": 3.91,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.07,
      "end_seconds": 121.34,
      "duration_seconds": 4.27,
      "text": "Sulfa drugs. I come out in... well, itching all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.4,
      "end_seconds": 135.45,
      "duration_seconds": 13.05,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.93,
      "end_seconds": 138.99,
      "duration_seconds": 3.06,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.86,
      "end_seconds": 145.42,
      "duration_seconds": 5.56,
      "text": "Are you on any tablets or medication? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 149.49,
      "duration_seconds": 2.82,
      "text": "I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.53,
      "end_seconds": 152.68,
      "duration_seconds": 2.15,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.98,
      "end_seconds": 164.25,
      "duration_seconds": 1.27,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.07,
      "end_seconds": 189.26,
      "duration_seconds": 12.19,
      "text": "Okay: weight 59 kilos, BMI works out to 22.8, pulse is 67 beats a minute, height 161 centimetres, saturation 98 percent, temperature is 36.6 degrees, pressure 112 over 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.95,
      "end_seconds": 193.86,
      "duration_seconds": 2.91,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.05,
      "end_seconds": 196.77,
      "duration_seconds": 1.72,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.17,
      "end_seconds": 215.01,
      "duration_seconds": 1.84,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.94,
      "end_seconds": 236.61,
      "duration_seconds": 16.67,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.53,
      "end_seconds": 241.12,
      "duration_seconds": 3.59,
      "text": "Um, I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.24,
      "end_seconds": 259.97,
      "duration_seconds": 17.73,
      "text": "Putting it all together, this looks most like post-viral fatigue. I want to be honest that this is an impression, not a final answer. Let me just recap so I've got it right. You've had exhaustion since you had the flu for about a month, severe, and no shortness of breath or rash."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.31,
      "end_seconds": 262.59,
      "duration_seconds": 1.28,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.42,
      "end_seconds": 269.59,
      "duration_seconds": 6.17,
      "text": "I'd like to arrange blood tests for fatigue. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.8,
      "end_seconds": 274.65,
      "duration_seconds": 3.85,
      "text": "Sure, you know, where do I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.59,
      "end_seconds": 295.84,
      "duration_seconds": 20.25,
      "text": "Pace yourself, a little more activity each day but stop before you're wiped out. If you smoke, this is a good moment to think about stopping, and we can help you with that. I want you to come back or go to emergency straight away if the symptoms get worse. Come back in four weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.89,
      "end_seconds": 298.44,
      "duration_seconds": 1.55,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.35,
      "end_seconds": 303.48,
      "duration_seconds": 4.13,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.1,
      "end_seconds": 308.55,
      "duration_seconds": 4.45,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.12,
      "end_seconds": 313.62,
      "duration_seconds": 3.5,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.12,
      "end_seconds": 317.14,
      "duration_seconds": 2.02,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.6,
      "end_seconds": 319.5,
      "duration_seconds": 0.9,
      "text": "Alright, goodbye."
    }
  ]
}