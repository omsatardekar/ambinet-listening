{
  "schema_version": "1.0",
  "encounter_id": "00408",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.06,
      "duration_seconds": 4.04,
      "text": "Good evening, um, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 8.47,
      "duration_seconds": 2.61,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.2,
      "end_seconds": 14.97,
      "duration_seconds": 5.77,
      "text": "So the thing is, I've got a burning pain in the upper tummy."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.43,
      "end_seconds": 18.61,
      "duration_seconds": 3.18,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.0,
      "end_seconds": 21.88,
      "duration_seconds": 2.88,
      "text": "Uh, ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.83,
      "end_seconds": 29.48,
      "duration_seconds": 6.65,
      "text": "Okay, give me more detail on it, whatever comes to mind. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.53,
      "end_seconds": 38.18,
      "duration_seconds": 7.65,
      "text": "Yes, spicy food and an empty stomach. That makes it worse. I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.62,
      "end_seconds": 40.56,
      "duration_seconds": 1.94,
      "text": "Have you been belching a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.85,
      "end_seconds": 43.52,
      "duration_seconds": 1.67,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.63,
      "end_seconds": 47.76,
      "duration_seconds": 3.13,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.43,
      "end_seconds": 61.67,
      "duration_seconds": 11.24,
      "text": "It's moderate, honestly. Um, there's nausea as well. With nausea, I'd say mild. There was a sour taste in the mouth, yes, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.36,
      "end_seconds": 64.36,
      "duration_seconds": 2.0,
      "text": "Has there been any weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.62,
      "end_seconds": 67.26,
      "duration_seconds": 1.64,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.58,
      "end_seconds": 73.09,
      "duration_seconds": 4.51,
      "text": "Let me check a few things. Any trouble swallowing, jaundice or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.91,
      "end_seconds": 76.19,
      "duration_seconds": 2.28,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.68,
      "end_seconds": 78.6,
      "duration_seconds": 1.92,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.91,
      "end_seconds": 81.73,
      "duration_seconds": 1.82,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.57,
      "end_seconds": 89.31,
      "duration_seconds": 6.74,
      "text": "Do you have any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.92,
      "end_seconds": 92.25,
      "duration_seconds": 2.33,
      "text": "Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.74,
      "end_seconds": 93.82,
      "duration_seconds": 1.08,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.89,
      "end_seconds": 97.1,
      "duration_seconds": 2.21,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.47,
      "end_seconds": 98.52,
      "duration_seconds": 1.05,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.96,
      "end_seconds": 108.45,
      "duration_seconds": 9.49,
      "text": "Okay, acid reflux, that's already on your record. Good to know. Let's go through your medication. What are you taking? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.78,
      "end_seconds": 115.95,
      "duration_seconds": 7.17,
      "text": "Pantoprazole, 40 milligrams, before breakfast. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.86,
      "end_seconds": 119.08,
      "duration_seconds": 2.22,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 121.25,
      "duration_seconds": 1.63,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.55,
      "end_seconds": 123.3,
      "duration_seconds": 0.75,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.86,
      "end_seconds": 127.66,
      "duration_seconds": 2.8,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.35,
      "end_seconds": 130.58,
      "duration_seconds": 2.23,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.2,
      "end_seconds": 137.3,
      "duration_seconds": 3.1,
      "text": "Just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.27,
      "end_seconds": 145.03,
      "duration_seconds": 6.76,
      "text": "Do you have any allergies to medicines, food, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.14,
      "end_seconds": 148.73,
      "duration_seconds": 2.59,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.31,
      "end_seconds": 152.24,
      "duration_seconds": 1.93,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.86,
      "end_seconds": 165.75,
      "duration_seconds": 1.89,
      "text": "So, just relax your arm..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.74,
      "end_seconds": 188.56,
      "duration_seconds": 7.82,
      "text": "Okay: SpO2 98 percent on room air, pulse 77, respiratory rate 15, temperature is 36.7 degrees, pressure 114 over 75."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.54,
      "end_seconds": 192.7,
      "duration_seconds": 1.16,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.91,
      "end_seconds": 196.61,
      "duration_seconds": 2.7,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.22,
      "end_seconds": 202.55,
      "duration_seconds": 3.33,
      "text": "Alright, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.67,
      "end_seconds": 204.37,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.34,
      "end_seconds": 208.11,
      "duration_seconds": 1.77,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.84,
      "end_seconds": 223.67,
      "duration_seconds": 1.83,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.34,
      "end_seconds": 225.8,
      "duration_seconds": 1.46,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.39,
      "end_seconds": 229.65,
      "duration_seconds": 2.26,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.52,
      "end_seconds": 243.59,
      "duration_seconds": 4.07,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.44,
      "end_seconds": 260.03,
      "duration_seconds": 11.59,
      "text": "That's fine, you can get dressed. Putting it all together, it fits best with gastritis. I want to be honest that this is an impression, not a final answer. I'd also keep acid reflux in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.5,
      "end_seconds": 263.02,
      "duration_seconds": 2.52,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.92,
      "end_seconds": 282.02,
      "duration_seconds": 15.1,
      "text": "I understand the worry. At the moment I'd say it's gastritis, and we'll know more once the blood tests is back. We should do blood tests for dyspepsia. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 282.46,
      "end_seconds": 285.86,
      "duration_seconds": 3.4,
      "text": "We have a slot Tuesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.61,
      "end_seconds": 310.41,
      "duration_seconds": 23.8,
      "text": "I'd like to arrange an H. pylori test for dyspepsia. It's a routine test and it'll give us a much clearer picture. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. Cut down on salt and fried food for now, it really does make a difference. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.01,
      "end_seconds": 322.57,
      "duration_seconds": 11.56,
      "text": "If you vomit blood or pass black stools, or you feel really unwell, please don't wait, come to the emergency department. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.43,
      "end_seconds": 324.13,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.47,
      "end_seconds": 328.9,
      "duration_seconds": 3.43,
      "text": "Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.33,
      "end_seconds": 331.29,
      "duration_seconds": 1.96,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.24,
      "end_seconds": 336.98,
      "duration_seconds": 0.74,
      "text": "Alright, goodbye."
    }
  ]
}