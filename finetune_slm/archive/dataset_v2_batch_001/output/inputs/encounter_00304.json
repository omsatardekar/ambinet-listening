{
  "schema_version": "1.0",
  "encounter_id": "00304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 7.12,
      "duration_seconds": 6.01,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 11.69,
      "duration_seconds": 3.64,
      "text": "Alright, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.29,
      "end_seconds": 21.15,
      "duration_seconds": 7.86,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. Doctor, it's been feeling lightheaded. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.89,
      "end_seconds": 24.91,
      "duration_seconds": 3.02,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.8,
      "end_seconds": 33.28,
      "duration_seconds": 7.48,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.42,
      "end_seconds": 40.39,
      "duration_seconds": 5.97,
      "text": "Okay, give me more detail on it, whatever comes to mind. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.04,
      "end_seconds": 56.57,
      "duration_seconds": 12.53,
      "text": "About a seven out of ten. It's a few times a day. I didn't want to make a fuss, you know. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.83,
      "end_seconds": 59.17,
      "duration_seconds": 1.34,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.74,
      "end_seconds": 68.08,
      "duration_seconds": 8.34,
      "text": "Yeah, that too. About sweating, severe, I'd say. I did have nearly passing out at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.26,
      "end_seconds": 71.39,
      "duration_seconds": 2.13,
      "text": "Any slurred speech, vomiting or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.71,
      "end_seconds": 76.63,
      "duration_seconds": 3.92,
      "text": "No slurred speech, vomiting or weakness, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 81.09,
      "duration_seconds": 3.57,
      "text": "Have you had any chest pain, fainting completely or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.68,
      "end_seconds": 86.42,
      "duration_seconds": 4.74,
      "text": "No chest pain, fainting completely or palpitations, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.79,
      "end_seconds": 89.66,
      "duration_seconds": 1.87,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.91,
      "end_seconds": 92.63,
      "duration_seconds": 1.72,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.98,
      "end_seconds": 96.29,
      "duration_seconds": 2.31,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.52,
      "end_seconds": 99.54,
      "duration_seconds": 2.02,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.85,
      "end_seconds": 105.09,
      "duration_seconds": 4.24,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.35,
      "end_seconds": 109.53,
      "duration_seconds": 3.18,
      "text": "I, I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.98,
      "end_seconds": 113.78,
      "duration_seconds": 3.8,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.89,
      "end_seconds": 116.03,
      "duration_seconds": 1.14,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.39,
      "end_seconds": 118.09,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.15,
      "end_seconds": 123.17,
      "duration_seconds": 4.02,
      "text": "I've had high blood pressure, yes. I have heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.42,
      "end_seconds": 125.58,
      "duration_seconds": 1.16,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.62,
      "end_seconds": 135.94,
      "duration_seconds": 9.32,
      "text": "Right, so that's your known heart disease. We'll keep that in mind today. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.18,
      "end_seconds": 139.17,
      "duration_seconds": 1.99,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.69,
      "end_seconds": 144.0,
      "duration_seconds": 4.31,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.34,
      "end_seconds": 147.37,
      "duration_seconds": 2.03,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.63,
      "end_seconds": 161.68,
      "duration_seconds": 13.05,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.53,
      "end_seconds": 165.65,
      "duration_seconds": 3.12,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.94,
      "end_seconds": 171.45,
      "duration_seconds": 2.51,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.13,
      "end_seconds": 190.62,
      "duration_seconds": 18.49,
      "text": "Oh, it's Glycomet, 500 milligrams, twice a day for my sugar. I take amlodipine, 5 milligrams, once a day for my pressure. I'm not great at remembering details, so bear with me. Clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.76,
      "end_seconds": 195.17,
      "duration_seconds": 3.41,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.89,
      "end_seconds": 207.82,
      "duration_seconds": 11.93,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.41,
      "end_seconds": 210.77,
      "duration_seconds": 1.36,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.34,
      "end_seconds": 215.62,
      "duration_seconds": 3.28,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 220.44,
      "duration_seconds": 1.0,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.87,
      "end_seconds": 223.72,
      "duration_seconds": 2.85,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.22,
      "end_seconds": 240.6,
      "duration_seconds": 14.38,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.06,
      "end_seconds": 242.86,
      "duration_seconds": 1.8,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 243.64,
      "end_seconds": 252.97,
      "duration_seconds": 9.33,
      "text": "Okay, so the vitals from earlier. Blood pressure 99 over 58, temperature is 37.0 degrees, SpO2 96 percent on room air, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.47,
      "end_seconds": 254.17,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.48,
      "end_seconds": 258.2,
      "duration_seconds": 1.72,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.34,
      "end_seconds": 260.58,
      "duration_seconds": 1.24,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.55,
      "end_seconds": 264.91,
      "duration_seconds": 2.36,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 282.72,
      "duration_seconds": 3.67,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.83,
      "end_seconds": 285.61,
      "duration_seconds": 1.78,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.66,
      "end_seconds": 305.19,
      "duration_seconds": 1.53,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 306.49,
      "end_seconds": 307.19,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.93,
      "end_seconds": 326.84,
      "duration_seconds": 13.91,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Okay, is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.34,
      "end_seconds": 328.98,
      "duration_seconds": 1.64,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.44,
      "end_seconds": 351.72,
      "duration_seconds": 19.28,
      "text": "Right, here's what I'm thinking. This looks most like postural low blood pressure. That's my thinking for now, and it may change as we learn more. I'd also keep a heart rhythm problem in mind. Let me just recap so I've got it right. You've been feeling lightheaded, and no vomiting or weakness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 352.95,
      "end_seconds": 354.55,
      "duration_seconds": 1.6,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.01,
      "end_seconds": 358.7,
      "duration_seconds": 3.69,
      "text": "I'm going to order a blood sugar test, for dizziness."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.17,
      "end_seconds": 360.01,
      "duration_seconds": 0.84,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 360.99,
      "end_seconds": 364.36,
      "duration_seconds": 3.37,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.61,
      "end_seconds": 387.0,
      "duration_seconds": 21.39,
      "text": "Perfect. Let's get blood tests, for dizziness. Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.91,
      "end_seconds": 390.33,
      "duration_seconds": 2.42,
      "text": "Got it, um, thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.86,
      "end_seconds": 393.72,
      "duration_seconds": 1.86,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 394.68,
      "end_seconds": 396.31,
      "duration_seconds": 1.63,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.84,
      "end_seconds": 402.44,
      "duration_seconds": 5.6,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.71,
      "end_seconds": 408.1,
      "duration_seconds": 4.39,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.77,
      "end_seconds": 414.57,
      "duration_seconds": 5.8,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.75,
      "end_seconds": 417.36,
      "duration_seconds": 1.61,
      "text": "Thanks so much, doctor."
    }
  ]
}