{
  "schema_version": "1.0",
  "encounter_id": "00228",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 5.56,
      "duration_seconds": 5.05,
      "text": "Um, uh, morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.63,
      "end_seconds": 9.92,
      "duration_seconds": 3.29,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.26,
      "end_seconds": 21.54,
      "duration_seconds": 11.28,
      "text": "Good morning, you know, doctor. I came along to help out. Doctor, um, it's been feeling low most days. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.98,
      "end_seconds": 28.74,
      "duration_seconds": 5.76,
      "text": "Right, how long have you had it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.28,
      "end_seconds": 41.82,
      "duration_seconds": 11.54,
      "text": "Well, I've had it for six months. I just want to get back to normal, really. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.15,
      "end_seconds": 44.8,
      "duration_seconds": 2.65,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.23,
      "end_seconds": 60.54,
      "duration_seconds": 12.31,
      "text": "Poor appetite goes along with it, most of the time. I've also been losing interest in things I used to enjoy, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 66.65,
      "duration_seconds": 5.4,
      "text": "Have you had any thoughts of harming myself, periods of unusually high energy or hearing voices?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.01,
      "end_seconds": 71.4,
      "duration_seconds": 3.39,
      "text": "Right, no, none of that at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.47,
      "end_seconds": 74.33,
      "duration_seconds": 1.86,
      "text": "What about drinking more than usual?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.15,
      "end_seconds": 77.53,
      "duration_seconds": 2.38,
      "text": "No. No drinking more than usual."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.61,
      "end_seconds": 81.91,
      "duration_seconds": 3.3,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.26,
      "end_seconds": 84.67,
      "duration_seconds": 1.41,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.08,
      "end_seconds": 87.24,
      "duration_seconds": 2.16,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.1,
      "end_seconds": 90.04,
      "duration_seconds": 1.94,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 98.39,
      "duration_seconds": 7.98,
      "text": "Do you have any medical conditions, anything you've been treated for? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.83,
      "end_seconds": 114.61,
      "duration_seconds": 14.78,
      "text": "I've had an underactive thyroid, yes. My family kept telling me to get it checked. Um, I've had depression, yes. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.95,
      "end_seconds": 120.83,
      "duration_seconds": 5.88,
      "text": "What medicines are you taking at the moment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.44,
      "end_seconds": 125.11,
      "duration_seconds": 3.67,
      "text": "I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 126.08,
      "end_seconds": 136.04,
      "duration_seconds": 9.96,
      "text": "Doctor, uh, I think the last prescription for the escitalopram was 5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.2,
      "end_seconds": 140.91,
      "duration_seconds": 3.71,
      "text": "Alright, hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 147.09,
      "duration_seconds": 3.87,
      "text": "Uh, no, I left it at home."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.36,
      "end_seconds": 152.36,
      "duration_seconds": 4.0,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.93,
      "end_seconds": 153.85,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.09,
      "end_seconds": 175.21,
      "duration_seconds": 8.12,
      "text": "Alright, I've got it. Right, do you have any allergies to medicines, food, anything at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.91,
      "end_seconds": 176.9,
      "duration_seconds": 0.99,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.14,
      "end_seconds": 179.28,
      "duration_seconds": 1.14,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.98,
      "end_seconds": 183.16,
      "duration_seconds": 3.18,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.55,
      "end_seconds": 185.2,
      "duration_seconds": 1.65,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.81,
      "end_seconds": 189.49,
      "duration_seconds": 3.68,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.4,
      "end_seconds": 193.61,
      "duration_seconds": 3.21,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.41,
      "end_seconds": 195.22,
      "duration_seconds": 0.81,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.05,
      "end_seconds": 213.42,
      "duration_seconds": 3.37,
      "text": "Okay, here we go. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.15,
      "end_seconds": 225.14,
      "duration_seconds": 1.99,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.87,
      "end_seconds": 251.24,
      "duration_seconds": 5.37,
      "text": "Okay: heart rate 69, BP is 115 over 80. And saturation 98 percent, respiratory rate 16."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.99,
      "end_seconds": 254.7,
      "duration_seconds": 1.71,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.05,
      "end_seconds": 255.75,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.59,
      "end_seconds": 259.94,
      "duration_seconds": 2.35,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.09,
      "end_seconds": 274.39,
      "duration_seconds": 4.3,
      "text": "You're well kempt and speaking clearly, and you maintain good eye contact."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.85,
      "end_seconds": 307.46,
      "duration_seconds": 27.61,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Okay, so my impression is this: It fits best with a depressive episode. I'd also keep an underactive thyroid in mind. Let me just recap so I've got it right. You've been feeling low most days for six months, and no drinking more than usual or hearing voices."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.32,
      "end_seconds": 309.63,
      "duration_seconds": 1.31,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.75,
      "end_seconds": 317.83,
      "duration_seconds": 7.08,
      "text": "We should do a thyroid test for low mood. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.57,
      "end_seconds": 321.92,
      "duration_seconds": 3.35,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.73,
      "end_seconds": 347.07,
      "duration_seconds": 24.34,
      "text": "Let's get blood tests, for low mood. I'd rather check than guess, and this is the quickest way to know more. Try to keep some routine, a bit of daylight and a short walk each day. It usually takes a few weeks for the tablet to start helping, so give it time and stay in touch. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.17,
      "end_seconds": 350.47,
      "duration_seconds": 2.3,
      "text": "I'll also refer you to a counsellor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.66,
      "end_seconds": 354.03,
      "duration_seconds": 2.37,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.81,
      "end_seconds": 364.15,
      "duration_seconds": 7.34,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.97,
      "end_seconds": 366.48,
      "duration_seconds": 1.51,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.84,
      "end_seconds": 374.77,
      "duration_seconds": 6.93,
      "text": "I want you to come back or go to emergency straight away if you have thoughts of harming yourself."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.88,
      "end_seconds": 380.89,
      "duration_seconds": 2.01,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.59,
      "end_seconds": 385.01,
      "duration_seconds": 3.42,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.37,
      "end_seconds": 389.2,
      "duration_seconds": 2.83,
      "text": "Okay, um, I'll book that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.24,
      "end_seconds": 394.39,
      "duration_seconds": 4.15,
      "text": "Okay, all right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.88,
      "end_seconds": 398.04,
      "duration_seconds": 3.16,
      "text": "Well, no, you've explained it well. Thanks."
    }
  ]
}