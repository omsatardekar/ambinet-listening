{
  "schema_version": "1.0",
  "encounter_id": "00413",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.67,
      "end_seconds": 6.16,
      "duration_seconds": 5.49,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 10.03,
      "duration_seconds": 3.25,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.05,
      "end_seconds": 15.62,
      "duration_seconds": 4.57,
      "text": "Um, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 20.2,
      "duration_seconds": 3.09,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.73,
      "end_seconds": 26.63,
      "duration_seconds": 4.9,
      "text": "Doctor, um, it's fever with chills. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.06,
      "end_seconds": 30.35,
      "duration_seconds": 3.29,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.73,
      "end_seconds": 38.81,
      "duration_seconds": 8.08,
      "text": "It's, It's been like this since last night. My sister suggested writing things down, um, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.42,
      "end_seconds": 42.33,
      "duration_seconds": 2.91,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.3,
      "end_seconds": 47.93,
      "duration_seconds": 4.63,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.53,
      "end_seconds": 49.92,
      "duration_seconds": 1.39,
      "text": "Any nausea as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.42,
      "end_seconds": 62.39,
      "duration_seconds": 10.97,
      "text": "I mean, yes, for two weeks. I mean, uh, with nausea, severe, I'd say. And there's a headache as well, ten days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.59,
      "end_seconds": 68.45,
      "duration_seconds": 4.86,
      "text": "Have you had fever with chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.29,
      "end_seconds": 73.68,
      "duration_seconds": 4.39,
      "text": "Oh, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.11,
      "end_seconds": 78.6,
      "duration_seconds": 3.49,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.99,
      "end_seconds": 79.85,
      "duration_seconds": 0.86,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.61,
      "end_seconds": 97.77,
      "duration_seconds": 2.16,
      "text": "Right, thanks for waiting. Any breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.17,
      "end_seconds": 102.13,
      "duration_seconds": 2.96,
      "text": "Yeah, not at all, no breathlessness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.13,
      "end_seconds": 107.08,
      "duration_seconds": 1.95,
      "text": "Any rash, cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.48,
      "end_seconds": 110.98,
      "duration_seconds": 3.5,
      "text": "Um, no, no rash, cough or diarrhoea."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.3,
      "end_seconds": 114.23,
      "duration_seconds": 1.93,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.59,
      "end_seconds": 118.06,
      "duration_seconds": 2.47,
      "text": "Right, no, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.96,
      "end_seconds": 122.11,
      "duration_seconds": 3.15,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 123.24,
      "end_seconds": 125.26,
      "duration_seconds": 2.02,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.82,
      "end_seconds": 129.02,
      "duration_seconds": 2.2,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.9,
      "end_seconds": 132.33,
      "duration_seconds": 2.43,
      "text": "No operations, uh, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.24,
      "end_seconds": 137.02,
      "duration_seconds": 3.78,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.83,
      "end_seconds": 144.26,
      "duration_seconds": 6.43,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.74,
      "end_seconds": 148.06,
      "duration_seconds": 2.32,
      "text": "So, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.38,
      "end_seconds": 149.4,
      "duration_seconds": 1.02,
      "text": "Yes, peanuts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 153.98,
      "duration_seconds": 3.33,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.22,
      "end_seconds": 157.73,
      "duration_seconds": 2.51,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.11,
      "end_seconds": 165.24,
      "duration_seconds": 7.13,
      "text": "Any medication at the moment, including things from the pharmacy? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.02,
      "end_seconds": 171.29,
      "duration_seconds": 5.27,
      "text": "Um, you know, I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 172.37,
      "end_seconds": 176.92,
      "duration_seconds": 4.55,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.29,
      "end_seconds": 179.78,
      "duration_seconds": 2.49,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.58,
      "end_seconds": 185.09,
      "duration_seconds": 4.51,
      "text": "Uh, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.92,
      "end_seconds": 203.65,
      "duration_seconds": 14.73,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.69,
      "end_seconds": 207.01,
      "duration_seconds": 2.32,
      "text": "Right, that's reassuring to hear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.29,
      "end_seconds": 215.25,
      "duration_seconds": 6.96,
      "text": "What about your general health, any conditions you're being treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.88,
      "end_seconds": 221.96,
      "duration_seconds": 6.08,
      "text": "I've got COPD. I, I have thin bones, for about ten years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.46,
      "end_seconds": 237.83,
      "duration_seconds": 14.37,
      "text": "Okay. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.24,
      "end_seconds": 242.19,
      "duration_seconds": 2.95,
      "text": "Oh, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 243.41,
      "end_seconds": 252.38,
      "duration_seconds": 8.97,
      "text": "Okay, so the vitals from earlier. Heart rate 106, blood pressure 118 over 73, saturation 97 percent, temp 39.1 degrees, respiratory rate 21."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.94,
      "end_seconds": 257.76,
      "duration_seconds": 3.82,
      "text": "Thanks. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.94,
      "end_seconds": 269.96,
      "duration_seconds": 11.02,
      "text": "So, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.97,
      "end_seconds": 273.89,
      "duration_seconds": 1.92,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.25,
      "end_seconds": 277.5,
      "duration_seconds": 2.25,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.93,
      "end_seconds": 292.77,
      "duration_seconds": 2.84,
      "text": "Your spleen tip is just palpable under the ribs."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.82,
      "end_seconds": 294.83,
      "duration_seconds": 1.01,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.24,
      "end_seconds": 297.7,
      "duration_seconds": 1.46,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.99,
      "end_seconds": 311.07,
      "duration_seconds": 3.08,
      "text": "No rash anywhere on your body that I can see."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.68,
      "end_seconds": 320.33,
      "duration_seconds": 6.65,
      "text": "All done, thank you, please sit down. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 321.36,
      "end_seconds": 325.0,
      "duration_seconds": 3.64,
      "text": "No problem, you know, take your time."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.84,
      "end_seconds": 334.53,
      "duration_seconds": 8.69,
      "text": "Putting it all together, it fits best with malaria until proven otherwise. It could also be dengue fever, so we'll keep that open."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 336.05,
      "end_seconds": 340.58,
      "duration_seconds": 4.53,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.04,
      "end_seconds": 357.53,
      "duration_seconds": 15.49,
      "text": "Nothing I've seen today points to an emergency. It looks like malaria until proven otherwise, but I'd like to confirm. Let me just recap so I've got it right. You've had fever with chills, since last night, and no diarrhoea or breathlessness."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 358.57,
      "end_seconds": 361.02,
      "duration_seconds": 2.45,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.92,
      "end_seconds": 366.76,
      "duration_seconds": 4.84,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 367.46,
      "end_seconds": 378.33,
      "duration_seconds": 10.87,
      "text": "Yes, you know, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.71,
      "end_seconds": 382.14,
      "duration_seconds": 3.43,
      "text": "I'd like to arrange a malaria test for fever after travel."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 383.19,
      "end_seconds": 384.09,
      "duration_seconds": 0.9,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.95,
      "end_seconds": 412.78,
      "duration_seconds": 27.83,
      "text": "Let's get a dengue test, for fever. The result will help us decide whether anything more is needed. We should do blood tests for fever. That will help us see what's going on underneath and decide the next step. Let the lab know you travelled recently, that's important for the tests. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.88,
      "end_seconds": 420.53,
      "duration_seconds": 6.65,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.05,
      "end_seconds": 423.65,
      "duration_seconds": 1.6,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.88,
      "end_seconds": 431.97,
      "duration_seconds": 7.09,
      "text": "Please don't sit on it if you get confused, very drowsy, or the shaking returns. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 432.28,
      "end_seconds": 434.1,
      "duration_seconds": 1.82,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.31,
      "end_seconds": 438.21,
      "duration_seconds": 2.9,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 438.78,
      "end_seconds": 441.69,
      "duration_seconds": 2.91,
      "text": "Um, okay, I'll book that."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.64,
      "end_seconds": 450.27,
      "duration_seconds": 5.63,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 451.51,
      "end_seconds": 457.0,
      "duration_seconds": 5.49,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.49,
      "end_seconds": 462.64,
      "duration_seconds": 5.15,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 463.29,
      "end_seconds": 469.84,
      "duration_seconds": 6.55,
      "text": "Yeah, uh, okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 471.25,
      "end_seconds": 471.95,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}