{
  "schema_version": "1.0",
  "encounter_id": "00240",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.09,
      "duration_seconds": 3.74,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.61,
      "end_seconds": 9.0,
      "duration_seconds": 3.39,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.06,
      "end_seconds": 13.47,
      "duration_seconds": 3.41,
      "text": "Doctor, you know, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.99,
      "end_seconds": 17.05,
      "duration_seconds": 3.06,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.47,
      "end_seconds": 23.29,
      "duration_seconds": 4.82,
      "text": "It's hot flushes, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.36,
      "end_seconds": 26.63,
      "duration_seconds": 2.27,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.64,
      "end_seconds": 30.33,
      "duration_seconds": 2.69,
      "text": "Yeah, I've had it since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.88,
      "end_seconds": 32.81,
      "duration_seconds": 1.93,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.33,
      "end_seconds": 34.7,
      "duration_seconds": 1.37,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.02,
      "end_seconds": 41.75,
      "duration_seconds": 3.73,
      "text": "Alright, is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.75,
      "end_seconds": 46.15,
      "duration_seconds": 3.4,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.86,
      "end_seconds": 49.93,
      "duration_seconds": 3.07,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.96,
      "end_seconds": 54.18,
      "duration_seconds": 3.22,
      "text": "Yes, warm rooms. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.0,
      "end_seconds": 58.08,
      "duration_seconds": 3.08,
      "text": "Alright, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 67.41,
      "duration_seconds": 8.18,
      "text": "When it starts I tend to get night sweats as well. As for night sweats, severe, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.73,
      "end_seconds": 71.87,
      "duration_seconds": 4.14,
      "text": "Have you had any palpitations, bleeding after sex or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.9,
      "end_seconds": 76.69,
      "duration_seconds": 3.79,
      "text": "No, you know, none of that at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 82.57,
      "duration_seconds": 4.38,
      "text": "Let me check a few things. Any chest pain or breast lumps?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 85.76,
      "duration_seconds": 1.78,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.97,
      "end_seconds": 87.75,
      "duration_seconds": 0.78,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.92,
      "end_seconds": 92.26,
      "duration_seconds": 3.34,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.93,
      "end_seconds": 97.02,
      "duration_seconds": 1.09,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.39,
      "end_seconds": 102.08,
      "duration_seconds": 3.69,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.4,
      "end_seconds": 107.59,
      "duration_seconds": 4.19,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.08,
      "end_seconds": 112.2,
      "duration_seconds": 3.12,
      "text": "I'm allergic to peanuts, I get hives."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.83,
      "end_seconds": 132.03,
      "duration_seconds": 15.2,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.48,
      "end_seconds": 134.93,
      "duration_seconds": 2.45,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.95,
      "end_seconds": 140.36,
      "duration_seconds": 4.41,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.91,
      "end_seconds": 152.44,
      "duration_seconds": 10.53,
      "text": "I've, I've had an underactive thyroid for two years now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.67,
      "end_seconds": 162.48,
      "duration_seconds": 8.81,
      "text": "Okay, an underactive thyroid, that's already on your record. Good to know. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.14,
      "end_seconds": 167.55,
      "duration_seconds": 4.41,
      "text": "It's, It's thyroxine, 75 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.03,
      "end_seconds": 171.63,
      "duration_seconds": 2.6,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.89,
      "end_seconds": 175.1,
      "duration_seconds": 2.21,
      "text": "Well, no, it's at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 178.34,
      "duration_seconds": 2.09,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 190.44,
      "duration_seconds": 1.68,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 211.24,
      "duration_seconds": 5.26,
      "text": "Okay: BP is 126 over 81, saturation 97 percent. And pulse 80, temperature 36.9."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.84,
      "end_seconds": 214.31,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.86,
      "end_seconds": 217.94,
      "duration_seconds": 3.08,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.6,
      "end_seconds": 222.05,
      "duration_seconds": 3.45,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.74,
      "end_seconds": 223.54,
      "duration_seconds": 0.8,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.34,
      "end_seconds": 237.97,
      "duration_seconds": 1.63,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 242.27,
      "duration_seconds": 2.5,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.35,
      "end_seconds": 244.74,
      "duration_seconds": 1.39,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.09,
      "end_seconds": 249.37,
      "duration_seconds": 3.28,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.5,
      "end_seconds": 267.53,
      "duration_seconds": 5.03,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.13,
      "end_seconds": 294.01,
      "duration_seconds": 20.88,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Right, here's what I'm thinking. This looks most like perimenopausal symptoms. The reason I say that is that your story and my examination fit together. A thyroid problem is also on my list."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.89,
      "end_seconds": 303.54,
      "duration_seconds": 8.65,
      "text": "Let me just recap so I've got it right. You've had hot flushes, since yesterday, severe, and no chest pain or weight loss."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.94,
      "end_seconds": 306.31,
      "duration_seconds": 1.37,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 312.54,
      "duration_seconds": 2.98,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.93,
      "end_seconds": 316.29,
      "duration_seconds": 3.36,
      "text": "Um, yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.6,
      "end_seconds": 325.03,
      "duration_seconds": 8.43,
      "text": "I'm going to order a thyroid test, for hot flushes. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.07,
      "end_seconds": 328.61,
      "duration_seconds": 2.54,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.47,
      "end_seconds": 341.64,
      "duration_seconds": 12.17,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.96,
      "end_seconds": 350.27,
      "duration_seconds": 8.31,
      "text": "I see. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.62,
      "end_seconds": 352.91,
      "duration_seconds": 1.29,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.98,
      "end_seconds": 360.42,
      "duration_seconds": 6.44,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.47,
      "end_seconds": 362.83,
      "duration_seconds": 1.36,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.95,
      "end_seconds": 366.04,
      "duration_seconds": 2.09,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.4,
      "end_seconds": 369.24,
      "duration_seconds": 1.84,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.53,
      "end_seconds": 375.6,
      "duration_seconds": 5.07,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.15,
      "end_seconds": 381.16,
      "duration_seconds": 4.01,
      "text": "So, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.05,
      "end_seconds": 385.94,
      "duration_seconds": 3.89,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.25,
      "end_seconds": 390.02,
      "duration_seconds": 2.77,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.74,
      "end_seconds": 392.93,
      "duration_seconds": 2.19,
      "text": "Bye for now, look after yourself."
    }
  ]
}