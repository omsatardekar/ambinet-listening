{
  "schema_version": "1.0",
  "encounter_id": "00129",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 3.73,
      "duration_seconds": 2.62,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.22,
      "end_seconds": 8.16,
      "duration_seconds": 3.94,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.58,
      "end_seconds": 13.3,
      "duration_seconds": 3.72,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.29,
      "end_seconds": 18.16,
      "duration_seconds": 3.87,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.94,
      "end_seconds": 23.52,
      "duration_seconds": 4.58,
      "text": "We came because of numbness on the left side of my face."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.48,
      "end_seconds": 26.3,
      "duration_seconds": 1.82,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.58,
      "end_seconds": 30.25,
      "duration_seconds": 2.67,
      "text": "Ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 33.69,
      "duration_seconds": 2.33,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.05,
      "end_seconds": 40.06,
      "duration_seconds": 5.01,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.92,
      "end_seconds": 45.35,
      "duration_seconds": 4.43,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.52,
      "end_seconds": 47.83,
      "duration_seconds": 1.31,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.77,
      "end_seconds": 54.12,
      "duration_seconds": 5.35,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 54.22,
      "end_seconds": 58.82,
      "duration_seconds": 4.6,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.55,
      "end_seconds": 66.69,
      "duration_seconds": 5.14,
      "text": "I was getting to that! And a slight slur in my speech, too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.48,
      "end_seconds": 70.29,
      "duration_seconds": 2.81,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.07,
      "end_seconds": 72.49,
      "duration_seconds": 1.42,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.02,
      "end_seconds": 77.99,
      "duration_seconds": 4.97,
      "text": "Okay, I'm following. Any palpitations, loss of vision, chest pain or fall at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.71,
      "end_seconds": 89.87,
      "duration_seconds": 11.16,
      "text": "No, no palpitations, no loss of vision, no chest pain. I did have headache at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.75,
      "end_seconds": 93.83,
      "duration_seconds": 1.08,
      "text": "What about confusion?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.34,
      "end_seconds": 96.96,
      "duration_seconds": 2.62,
      "text": "Hmm, no confusion, thank goodness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.45,
      "end_seconds": 100.06,
      "duration_seconds": 2.61,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.32,
      "end_seconds": 104.06,
      "duration_seconds": 2.74,
      "text": "No, um, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.2,
      "end_seconds": 110.4,
      "duration_seconds": 2.2,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.24,
      "end_seconds": 112.79,
      "duration_seconds": 1.55,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.12,
      "end_seconds": 117.44,
      "duration_seconds": 4.32,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.08,
      "end_seconds": 125.73,
      "duration_seconds": 7.65,
      "text": "Yes, an irregular heartbeat. I just want to get back to normal, really. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.21,
      "end_seconds": 127.36,
      "duration_seconds": 1.15,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.59,
      "end_seconds": 131.39,
      "duration_seconds": 2.8,
      "text": "I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.81,
      "end_seconds": 134.85,
      "duration_seconds": 2.04,
      "text": "Go on. Right, how about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.34,
      "end_seconds": 139.08,
      "duration_seconds": 2.74,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.49,
      "end_seconds": 141.45,
      "duration_seconds": 0.96,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.23,
      "end_seconds": 145.47,
      "duration_seconds": 3.24,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.8,
      "end_seconds": 150.76,
      "duration_seconds": 3.96,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.56,
      "end_seconds": 154.21,
      "duration_seconds": 2.65,
      "text": "Right, my father had kidney stones."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.37,
      "end_seconds": 158.05,
      "duration_seconds": 2.68,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.65,
      "end_seconds": 170.79,
      "duration_seconds": 11.14,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.69,
      "end_seconds": 177.12,
      "duration_seconds": 5.43,
      "text": "What medicines are you taking at the moment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.97,
      "end_seconds": 200.85,
      "duration_seconds": 22.88,
      "text": "Uh, it's bisoprolol, 2.5 milligrams, once a day for the heart rhythm. I'm on losartan, 50 milligrams, once a day. I wasn't sure whether to come in at all, to be honest. I didn't want to make a fuss, you know. Right, you know, it's glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 202.23,
      "end_seconds": 210.54,
      "duration_seconds": 8.31,
      "text": "Doctor, I think the last prescription for the glimepiride was 4 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.28,
      "end_seconds": 213.59,
      "duration_seconds": 2.31,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.92,
      "end_seconds": 230.99,
      "duration_seconds": 16.07,
      "text": "I don't think I have it with me. Aspirin. I take it 75 milligrams, once a day. I'd rather know what's going on than keep guessing. I used to take metformin, but I stopped it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.46,
      "end_seconds": 233.07,
      "duration_seconds": 1.61,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.86,
      "end_seconds": 237.35,
      "duration_seconds": 3.49,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.64,
      "end_seconds": 242.04,
      "duration_seconds": 3.4,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.38,
      "end_seconds": 249.02,
      "duration_seconds": 5.64,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.21,
      "end_seconds": 253.33,
      "duration_seconds": 3.12,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 262.33,
      "duration_seconds": 2.07,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.66,
      "end_seconds": 283.36,
      "duration_seconds": 8.7,
      "text": "Okay: saturation 96 percent, blood pressure 161 over 93, respiratory rate 14. And temperature 36.7, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.87,
      "end_seconds": 285.97,
      "duration_seconds": 1.1,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.41,
      "end_seconds": 290.01,
      "duration_seconds": 2.6,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.48,
      "end_seconds": 294.7,
      "duration_seconds": 2.22,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.81,
      "end_seconds": 297.57,
      "duration_seconds": 1.76,
      "text": "Yes, you know, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.32,
      "end_seconds": 301.96,
      "duration_seconds": 2.64,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.0,
      "end_seconds": 322.78,
      "duration_seconds": 3.78,
      "text": "There's mild drooping at the left corner of your mouth."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.13,
      "end_seconds": 324.83,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.16,
      "end_seconds": 329.11,
      "duration_seconds": 2.95,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.86,
      "end_seconds": 340.91,
      "duration_seconds": 3.05,
      "text": "Grip strength is a little weaker on the left."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.44,
      "end_seconds": 342.14,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.57,
      "end_seconds": 363.86,
      "duration_seconds": 16.29,
      "text": "Okay, you can sit back up. So, based on the history and the examination, it fits best with a possible mini-stroke, which we need to investigate urgently. I want to be honest that this is an impression, not a final answer. A migraine variant is also on my list."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.81,
      "end_seconds": 367.34,
      "duration_seconds": 2.53,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.18,
      "end_seconds": 389.46,
      "duration_seconds": 21.28,
      "text": "It's reasonable to be concerned, but right now a possible mini-stroke, which we need to investigate urgently is my leading thought, not anything worse. Let me just recap so I've got it right. You've had numbness on the left side of your face, since last weekend, severe, and no palpitations or chest pain."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.9,
      "end_seconds": 392.35,
      "duration_seconds": 1.45,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.72,
      "end_seconds": 395.37,
      "duration_seconds": 2.65,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.62,
      "end_seconds": 400.6,
      "duration_seconds": 3.98,
      "text": "Yes, you know, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.64,
      "end_seconds": 409.17,
      "duration_seconds": 7.53,
      "text": "I'd like to arrange an MRI of the brain for possible stroke. Let's get a carotid scan, for possible stroke."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.5,
      "end_seconds": 411.36,
      "duration_seconds": 0.86,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.86,
      "end_seconds": 442.24,
      "duration_seconds": 29.38,
      "text": "We should do an ECG for possible stroke. It's a routine test and it'll give us a much clearer picture. Don't drive for now, and bring someone with you to the next visit. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.8,
      "end_seconds": 444.05,
      "duration_seconds": 1.25,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.44,
      "end_seconds": 451.84,
      "duration_seconds": 6.4,
      "text": "Please don't sit on it if the numbness, weakness or speech problem returns. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.85,
      "end_seconds": 454.73,
      "duration_seconds": 1.88,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.17,
      "end_seconds": 458.06,
      "duration_seconds": 2.89,
      "text": "Please come and see me in one week."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.95,
      "end_seconds": 460.82,
      "duration_seconds": 1.87,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 462.25,
      "end_seconds": 467.64,
      "duration_seconds": 5.39,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 469.05,
      "end_seconds": 473.43,
      "duration_seconds": 4.38,
      "text": "So, I come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.41,
      "end_seconds": 479.13,
      "duration_seconds": 4.72,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 480.61,
      "end_seconds": 482.43,
      "duration_seconds": 1.82,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0077",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 483.6,
      "end_seconds": 486.04,
      "duration_seconds": 2.44,
      "text": "Bye for now, look after yourself."
    }
  ]
}