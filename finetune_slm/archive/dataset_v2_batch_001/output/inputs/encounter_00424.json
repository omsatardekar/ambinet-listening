{
  "schema_version": "1.0",
  "encounter_id": "00424",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.59,
      "duration_seconds": 3.29,
      "text": "Hello doctor, um, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.77,
      "end_seconds": 10.15,
      "duration_seconds": 4.38,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.84,
      "end_seconds": 28.11,
      "duration_seconds": 17.27,
      "text": "I wanted to get acne looked at. It's a relief to finally sit down and talk about it. And there's flare-ups before my period as well, uh, about three months now. With flare-ups before my period, mild, I'd say."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.42,
      "end_seconds": 29.12,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.86,
      "end_seconds": 34.78,
      "duration_seconds": 4.92,
      "text": "Okay, bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.71,
      "end_seconds": 56.95,
      "duration_seconds": 4.24,
      "text": "Good, where were we. Have you had any excess hair growth?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.87,
      "end_seconds": 62.47,
      "duration_seconds": 4.6,
      "text": "Okay, so no, I haven't had any excess hair growth."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.87,
      "end_seconds": 66.72,
      "duration_seconds": 2.85,
      "text": "Any fever, pregnancy or irregular periods at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.22,
      "end_seconds": 70.74,
      "duration_seconds": 3.52,
      "text": "I haven't had fever, pregnancy or irregular periods, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.33,
      "end_seconds": 74.03,
      "duration_seconds": 2.7,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.62,
      "end_seconds": 77.55,
      "duration_seconds": 1.93,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.96,
      "end_seconds": 82.15,
      "duration_seconds": 3.19,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 96.05,
      "duration_seconds": 12.67,
      "text": "Yeah, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.32,
      "end_seconds": 101.53,
      "duration_seconds": 4.21,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.42,
      "end_seconds": 111.86,
      "duration_seconds": 9.44,
      "text": "I've had high cholesterol for two years now. I didn't want to make a fuss, you know. I have eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.51,
      "end_seconds": 120.95,
      "duration_seconds": 8.44,
      "text": "Right, yes, I can see the high cholesterol in your file as well. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 124.46,
      "duration_seconds": 2.28,
      "text": "I take rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.81,
      "end_seconds": 126.47,
      "duration_seconds": 1.66,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.52,
      "end_seconds": 133.26,
      "duration_seconds": 5.74,
      "text": "It's 10 milligrams. Hydrocortisone cream, when needed. It's face wash, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.52,
      "end_seconds": 134.63,
      "duration_seconds": 1.11,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.83,
      "end_seconds": 139.48,
      "duration_seconds": 3.65,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 140.98,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.69,
      "end_seconds": 155.81,
      "duration_seconds": 5.12,
      "text": "Okay, here we go. Right, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 159.59,
      "duration_seconds": 3.11,
      "text": "Not that I know, uh, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.23,
      "end_seconds": 173.93,
      "duration_seconds": 13.7,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.52,
      "end_seconds": 177.69,
      "duration_seconds": 3.17,
      "text": "Hmm, you know, that's reassuring to hear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.95,
      "end_seconds": 180.43,
      "duration_seconds": 1.48,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.1,
      "end_seconds": 188.45,
      "duration_seconds": 3.35,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 191.39,
      "duration_seconds": 2.63,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.48,
      "end_seconds": 193.85,
      "duration_seconds": 1.37,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.16,
      "end_seconds": 197.48,
      "duration_seconds": 2.32,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 208.92,
      "duration_seconds": 1.39,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.36,
      "end_seconds": 232.13,
      "duration_seconds": 4.77,
      "text": "Okay: BP is 128 over 77, heart rate 78, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.41,
      "end_seconds": 238.15,
      "duration_seconds": 1.74,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.79,
      "end_seconds": 242.0,
      "duration_seconds": 3.21,
      "text": "Alright, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.04,
      "end_seconds": 246.32,
      "duration_seconds": 3.28,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.32,
      "end_seconds": 248.52,
      "duration_seconds": 1.2,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.47,
      "end_seconds": 251.92,
      "duration_seconds": 2.45,
      "text": "Right, just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.77,
      "end_seconds": 276.55,
      "duration_seconds": 5.78,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.97,
      "end_seconds": 281.11,
      "duration_seconds": 2.14,
      "text": "Okay, you can sit back up."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.71,
      "end_seconds": 284.96,
      "duration_seconds": 3.25,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.69,
      "end_seconds": 286.39,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.37,
      "end_seconds": 311.36,
      "duration_seconds": 10.99,
      "text": "Alright, I've got it. Putting it all together, it fits best with moderate acne. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.69,
      "end_seconds": 313.94,
      "duration_seconds": 2.25,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.53,
      "end_seconds": 327.49,
      "duration_seconds": 11.96,
      "text": "Nothing I've seen today points to an emergency. It looks like moderate acne. Let me just recap so I've got it right. You've had acne, and no fever or excess hair growth."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.8,
      "end_seconds": 330.01,
      "duration_seconds": 2.21,
      "text": "Right, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.82,
      "end_seconds": 342.61,
      "duration_seconds": 11.79,
      "text": "I'd like you to take doxycycline, 100 milligrams, once a day, for six weeks. That should help with acne. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.01,
      "end_seconds": 344.66,
      "duration_seconds": 1.65,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.65,
      "end_seconds": 364.73,
      "duration_seconds": 19.08,
      "text": "Don't squeeze them, that's how the marks stay. It takes six to eight weeks to see the difference, so please don't give up in the first fortnight. Don't skip meals, and try to eat smaller portions more often through the day. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.33,
      "end_seconds": 370.57,
      "duration_seconds": 2.24,
      "text": "Well, yes, I'll do that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.35,
      "end_seconds": 374.14,
      "duration_seconds": 2.79,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 374.64,
      "end_seconds": 378.54,
      "duration_seconds": 3.9,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.19,
      "end_seconds": 383.01,
      "duration_seconds": 3.82,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.16,
      "end_seconds": 392.65,
      "duration_seconds": 8.49,
      "text": "So, I take the doxycycline, 100 milligrams, once a day and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.79,
      "end_seconds": 398.56,
      "duration_seconds": 4.77,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.84,
      "end_seconds": 401.83,
      "duration_seconds": 1.99,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.78,
      "end_seconds": 404.77,
      "duration_seconds": 1.99,
      "text": "Bye for now, look after yourself."
    }
  ]
}