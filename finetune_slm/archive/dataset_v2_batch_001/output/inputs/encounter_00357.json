{
  "schema_version": "1.0",
  "encounter_id": "00357",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.47,
      "duration_seconds": 4.28,
      "text": "Um, good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.96,
      "end_seconds": 8.96,
      "duration_seconds": 3.0,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.26,
      "end_seconds": 17.62,
      "duration_seconds": 8.36,
      "text": "So, it's dizziness when I stand up, mostly. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.01,
      "end_seconds": 24.93,
      "duration_seconds": 5.92,
      "text": "Is this recent, or has it been a while? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.49,
      "end_seconds": 32.86,
      "duration_seconds": 6.37,
      "text": "For two days, I'd say. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.81,
      "end_seconds": 40.64,
      "duration_seconds": 6.83,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.41,
      "end_seconds": 52.69,
      "duration_seconds": 11.28,
      "text": "I'd say mild. I notice it more with standing up quickly. Only sitting down, and it's not much. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.42,
      "end_seconds": 58.36,
      "duration_seconds": 1.94,
      "text": "Have you had dark urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.97,
      "end_seconds": 60.8,
      "duration_seconds": 1.83,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.69,
      "end_seconds": 63.63,
      "duration_seconds": 1.94,
      "text": "Has there been muscle cramps too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.36,
      "end_seconds": 67.13,
      "duration_seconds": 2.77,
      "text": "Yeah. About a week, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.17,
      "end_seconds": 71.43,
      "duration_seconds": 3.26,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.9,
      "end_seconds": 75.33,
      "duration_seconds": 3.43,
      "text": "Right, you know, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.05,
      "end_seconds": 83.79,
      "duration_seconds": 5.74,
      "text": "Let me check a few things. Any chest pain, blood in the stool or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.24,
      "end_seconds": 86.9,
      "duration_seconds": 1.66,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.99,
      "end_seconds": 89.07,
      "duration_seconds": 1.08,
      "text": "What about fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.51,
      "end_seconds": 92.87,
      "duration_seconds": 2.36,
      "text": "No, I haven't had any fainting."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.06,
      "end_seconds": 97.02,
      "duration_seconds": 2.96,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.48,
      "end_seconds": 99.77,
      "duration_seconds": 1.29,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.12,
      "end_seconds": 104.86,
      "duration_seconds": 3.74,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.33,
      "end_seconds": 106.11,
      "duration_seconds": 0.78,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.18,
      "end_seconds": 123.47,
      "duration_seconds": 5.29,
      "text": "Alright, I've got it. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.21,
      "end_seconds": 126.06,
      "duration_seconds": 1.85,
      "text": "ORS, whenever I remember."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.87,
      "end_seconds": 130.88,
      "duration_seconds": 4.01,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.18,
      "end_seconds": 136.04,
      "duration_seconds": 3.86,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.5,
      "end_seconds": 137.59,
      "duration_seconds": 1.09,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.69,
      "end_seconds": 141.55,
      "duration_seconds": 2.86,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.97,
      "end_seconds": 143.52,
      "duration_seconds": 1.55,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.41,
      "end_seconds": 146.22,
      "duration_seconds": 1.81,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.5,
      "end_seconds": 149.86,
      "duration_seconds": 2.36,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.3,
      "end_seconds": 154.02,
      "duration_seconds": 2.72,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.25,
      "end_seconds": 159.11,
      "duration_seconds": 1.86,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.06,
      "end_seconds": 162.99,
      "duration_seconds": 2.93,
      "text": "Shellfish. I come out in... well, vomiting."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.55,
      "end_seconds": 168.86,
      "duration_seconds": 4.31,
      "text": "Right, do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.72,
      "end_seconds": 175.63,
      "duration_seconds": 5.91,
      "text": "Right, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.52,
      "end_seconds": 180.91,
      "duration_seconds": 4.39,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.97,
      "end_seconds": 189.69,
      "duration_seconds": 5.72,
      "text": "Diabetes, for five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.28,
      "end_seconds": 193.36,
      "duration_seconds": 3.08,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.96,
      "end_seconds": 194.81,
      "duration_seconds": 0.85,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.46,
      "end_seconds": 208.09,
      "duration_seconds": 3.63,
      "text": "Okay, here we go. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.74,
      "end_seconds": 221.44,
      "duration_seconds": 1.7,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.87,
      "end_seconds": 246.29,
      "duration_seconds": 6.42,
      "text": "Okay: BP is 103 over 58, respiratory rate 19, pulse 105, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.53,
      "end_seconds": 248.81,
      "duration_seconds": 1.28,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 252.92,
      "duration_seconds": 2.9,
      "text": "Okay, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.11,
      "end_seconds": 256.63,
      "duration_seconds": 2.52,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.07,
      "end_seconds": 259.9,
      "duration_seconds": 2.83,
      "text": "Of course, uh, take your time."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.05,
      "end_seconds": 272.73,
      "duration_seconds": 1.68,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 276.75,
      "duration_seconds": 1.72,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.24,
      "end_seconds": 278.94,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.09,
      "end_seconds": 282.15,
      "duration_seconds": 2.06,
      "text": "Alright, breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.48,
      "end_seconds": 302.82,
      "duration_seconds": 5.34,
      "text": "Your mouth is quite dry and the skin is a little slow to spring back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.26,
      "end_seconds": 303.96,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.31,
      "end_seconds": 317.81,
      "duration_seconds": 11.5,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.83,
      "end_seconds": 329.97,
      "duration_seconds": 11.14,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.49,
      "end_seconds": 341.65,
      "duration_seconds": 10.16,
      "text": "Okay, so my impression is this: It fits best with mild dehydration. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.03,
      "end_seconds": 344.35,
      "duration_seconds": 2.32,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.56,
      "end_seconds": 363.04,
      "duration_seconds": 17.48,
      "text": "I understand the worry. At the moment I'd say it's mild dehydration, and we'll know more once the a kidney function test is back. Let me just recap so I've got it right. You've had dizziness when you stand up for two days, mild, and no chest pain or confusion."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.09,
      "end_seconds": 368.72,
      "duration_seconds": 1.63,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.75,
      "end_seconds": 372.45,
      "duration_seconds": 2.7,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.16,
      "end_seconds": 375.54,
      "duration_seconds": 2.38,
      "text": "Well, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.88,
      "end_seconds": 392.47,
      "duration_seconds": 15.59,
      "text": "I'd like to arrange a kidney function test for dehydration. The result will help us decide whether anything more is needed. We should do blood salts for dehydration. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.4,
      "end_seconds": 396.25,
      "duration_seconds": 2.85,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.65,
      "end_seconds": 427.28,
      "duration_seconds": 29.63,
      "text": "Small, frequent sips are better than a big glass at once, and keep going even if you don't feel thirsty. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please take the tablets with food so they don't upset your stomach. Please don't sit on it if you faint or can't keep any fluids down. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.84,
      "end_seconds": 431.07,
      "duration_seconds": 2.23,
      "text": "Let's review you in three days."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.61,
      "end_seconds": 433.31,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.74,
      "end_seconds": 438.82,
      "duration_seconds": 4.08,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.43,
      "end_seconds": 443.56,
      "duration_seconds": 4.13,
      "text": "So, I come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.03,
      "end_seconds": 446.84,
      "duration_seconds": 2.81,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.87,
      "end_seconds": 452.98,
      "duration_seconds": 5.11,
      "text": "I, I think that's clear. Thank you for being so thorough."
    }
  ]
}