{
  "schema_version": "1.0",
  "encounter_id": "00080",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 2.85,
      "duration_seconds": 2.16,
      "text": "Hi. Thanks for coming in today."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.7,
      "end_seconds": 4.45,
      "duration_seconds": 0.75,
      "text": "Good afternoon."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.09,
      "end_seconds": 7.28,
      "duration_seconds": 2.19,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.92,
      "end_seconds": 12.83,
      "duration_seconds": 4.91,
      "text": "Yes, that's no problem at all. Please sit. So, did you take the bus in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.94,
      "end_seconds": 16.7,
      "duration_seconds": 2.76,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.13,
      "end_seconds": 18.55,
      "duration_seconds": 1.42,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.9,
      "end_seconds": 24.39,
      "duration_seconds": 4.49,
      "text": "Doctor, it's pain in my lower back. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.31,
      "end_seconds": 29.56,
      "duration_seconds": 4.25,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.34,
      "end_seconds": 35.27,
      "duration_seconds": 4.93,
      "text": "I'd give it a three, out of ten. It happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.69,
      "end_seconds": 41.7,
      "duration_seconds": 6.01,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.8,
      "end_seconds": 46.32,
      "duration_seconds": 4.52,
      "text": "Well, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.68,
      "end_seconds": 49.73,
      "duration_seconds": 2.05,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.58,
      "end_seconds": 53.78,
      "duration_seconds": 3.2,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.53,
      "end_seconds": 58.27,
      "duration_seconds": 3.74,
      "text": "Hmm, and stiffness as well, since this morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.55,
      "end_seconds": 61.38,
      "duration_seconds": 1.83,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.03,
      "end_seconds": 63.46,
      "duration_seconds": 1.43,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.82,
      "end_seconds": 81.2,
      "duration_seconds": 17.38,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.15,
      "end_seconds": 84.12,
      "duration_seconds": 1.97,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 89.38,
      "duration_seconds": 3.84,
      "text": "Let me check a few things. Any bladder problems or weight loss?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.92,
      "end_seconds": 100.21,
      "duration_seconds": 9.29,
      "text": "Right, no, no bladder problems, no weight loss. I did have difficulty bending forward at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.29,
      "end_seconds": 105.22,
      "duration_seconds": 0.93,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.13,
      "end_seconds": 109.92,
      "duration_seconds": 3.79,
      "text": "I mean, no, I haven't had any fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 113.33,
      "end_seconds": 118.74,
      "duration_seconds": 5.41,
      "text": "Hmm, actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.56,
      "end_seconds": 125.11,
      "duration_seconds": 5.55,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.94,
      "end_seconds": 133.95,
      "duration_seconds": 8.01,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any numbness around the groin or weakness in the legs at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.37,
      "end_seconds": 137.2,
      "duration_seconds": 1.83,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.03,
      "end_seconds": 140.55,
      "duration_seconds": 2.52,
      "text": "Have you had any numbness in the legs?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.05,
      "end_seconds": 144.9,
      "duration_seconds": 3.85,
      "text": "No, I haven't had any numbness in the legs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.42,
      "end_seconds": 148.76,
      "duration_seconds": 2.34,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.36,
      "end_seconds": 152.66,
      "duration_seconds": 2.3,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.04,
      "end_seconds": 155.77,
      "duration_seconds": 2.73,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.2,
      "end_seconds": 158.81,
      "duration_seconds": 1.61,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.16,
      "end_seconds": 165.71,
      "duration_seconds": 5.55,
      "text": "What medicines are you taking at the moment? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.83,
      "end_seconds": 177.79,
      "duration_seconds": 10.96,
      "text": "Diclofenac. I take it 50 milligrams, when needed. Sorry, I know I'm rambling a bit. Hmm, it's losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 178.23,
      "end_seconds": 185.55,
      "duration_seconds": 7.32,
      "text": "Doctor, I think the last prescription for the losartan was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.66,
      "end_seconds": 190.04,
      "duration_seconds": 3.38,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.29,
      "end_seconds": 196.74,
      "duration_seconds": 5.45,
      "text": "I don't think I have it with me. It's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.18,
      "end_seconds": 199.91,
      "duration_seconds": 2.73,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.04,
      "end_seconds": 202.54,
      "duration_seconds": 1.5,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.97,
      "end_seconds": 205.95,
      "duration_seconds": 1.98,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.34,
      "end_seconds": 210.01,
      "duration_seconds": 3.67,
      "text": "Yeah, just a hernia repair, about five years back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.2,
      "end_seconds": 215.27,
      "duration_seconds": 4.07,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.64,
      "end_seconds": 227.03,
      "duration_seconds": 10.39,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.21,
      "end_seconds": 234.78,
      "duration_seconds": 6.57,
      "text": "Moving on to your background, any past medical history? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.63,
      "end_seconds": 243.77,
      "duration_seconds": 8.14,
      "text": "I've had arthritis in my knees for nearly five years now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.05,
      "end_seconds": 245.75,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.09,
      "end_seconds": 253.44,
      "duration_seconds": 6.35,
      "text": "High blood pressure, for about ten years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.4,
      "end_seconds": 255.34,
      "duration_seconds": 0.94,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.78,
      "end_seconds": 268.52,
      "duration_seconds": 11.74,
      "text": "Yes, I can see the arthritis in my knees in your file as well. Okay, high blood pressure, that's already on your record. Good to know. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.49,
      "end_seconds": 271.72,
      "duration_seconds": 2.23,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.25,
      "end_seconds": 275.43,
      "duration_seconds": 2.18,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.74,
      "end_seconds": 289.29,
      "duration_seconds": 1.55,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.19,
      "end_seconds": 312.42,
      "duration_seconds": 6.23,
      "text": "Okay: SpO2 97 percent on room air, temp 36.6 degrees, pulse 71, BP is 114 over 80."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.0,
      "end_seconds": 317.72,
      "duration_seconds": 3.72,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.07,
      "end_seconds": 320.77,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.86,
      "end_seconds": 324.15,
      "duration_seconds": 2.29,
      "text": "Okay, can you lie back for me?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.02,
      "end_seconds": 342.32,
      "duration_seconds": 5.3,
      "text": "Straight leg raise is negative on both sides and power in the legs is normal."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.94,
      "end_seconds": 345.53,
      "duration_seconds": 1.59,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.52,
      "end_seconds": 357.36,
      "duration_seconds": 3.84,
      "text": "There's tenderness over the muscles on the right of the lower back."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.75,
      "end_seconds": 359.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.69,
      "end_seconds": 380.91,
      "duration_seconds": 19.22,
      "text": "That's fine, you can get dressed. Okay, so my impression is this: I think we're dealing with mechanical low back pain at this stage. The reason I say that is that your story and my examination fit together. It could also be a pinched nerve, so we'll keep that open. I can't rule out a disc problem yet."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.99,
      "end_seconds": 384.17,
      "duration_seconds": 2.18,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.16,
      "end_seconds": 408.46,
      "duration_seconds": 23.3,
      "text": "I can't promise yet, but most people with mechanical low back pain do well once it's treated properly. I'm going to order an X-ray of the lower back, for back pain. It's a routine test and it'll give us a much clearer picture. I'd like to arrange an MRI of the lumbar spine for persistent back pain. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.72,
      "end_seconds": 417.51,
      "duration_seconds": 7.79,
      "text": "Let's use thiocolchicoside, 4 milligrams, twice a day, for five days. You take it by mouth. That should help with muscle spasm."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 418.06,
      "end_seconds": 420.94,
      "duration_seconds": 2.88,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.28,
      "end_seconds": 445.03,
      "duration_seconds": 23.75,
      "text": "Every hour, get up and stretch if you're at a desk. Staying gently active heals back pain faster than bed rest, so keep moving. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'll also refer you to physiotherapy. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 449.97,
      "end_seconds": 451.24,
      "duration_seconds": 1.27,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 452.79,
      "end_seconds": 461.99,
      "duration_seconds": 9.2,
      "text": "Keep an eye out, and if you get numbness in the groin or lose bladder control, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 462.97,
      "end_seconds": 464.86,
      "duration_seconds": 1.89,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 466.08,
      "end_seconds": 467.89,
      "duration_seconds": 1.81,
      "text": "Come back in three weeks."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 469.1,
      "end_seconds": 469.8,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 471.21,
      "end_seconds": 475.79,
      "duration_seconds": 4.58,
      "text": "Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 477.19,
      "end_seconds": 479.94,
      "duration_seconds": 2.75,
      "text": "Um, alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 480.33,
      "end_seconds": 482.61,
      "duration_seconds": 2.28,
      "text": "Bye for now, look after yourself."
    }
  ]
}