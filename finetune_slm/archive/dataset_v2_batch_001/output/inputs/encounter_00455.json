{
  "schema_version": "1.0",
  "encounter_id": "00455",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 9.55,
      "duration_seconds": 8.22,
      "text": "Right, uh, hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.97,
      "end_seconds": 14.06,
      "duration_seconds": 3.09,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.2,
      "end_seconds": 22.1,
      "duration_seconds": 4.9,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.43,
      "end_seconds": 26.46,
      "duration_seconds": 3.03,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.31,
      "end_seconds": 33.87,
      "duration_seconds": 6.56,
      "text": "I mean, doctor, it's pain in my right ankle. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.44,
      "end_seconds": 38.66,
      "duration_seconds": 3.22,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.59,
      "end_seconds": 47.87,
      "duration_seconds": 8.28,
      "text": "Hmm, you know, probably two weeks. Yeah. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.66,
      "end_seconds": 56.99,
      "duration_seconds": 8.33,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.47,
      "end_seconds": 67.36,
      "duration_seconds": 8.89,
      "text": "Moderate, I'd say. It's worse with putting weight on it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.87,
      "end_seconds": 70.69,
      "duration_seconds": 2.82,
      "text": "Has there been a twist during football too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.57,
      "end_seconds": 73.34,
      "duration_seconds": 1.77,
      "text": "Yes, for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.59,
      "end_seconds": 77.22,
      "duration_seconds": 3.63,
      "text": "Go on. What about difficulty walking, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.56,
      "end_seconds": 83.08,
      "duration_seconds": 5.52,
      "text": "Yes, um, I have. I mean, about difficulty walking, I'd say mild."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.3,
      "end_seconds": 85.83,
      "duration_seconds": 2.53,
      "text": "Alright. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.64,
      "end_seconds": 90.69,
      "duration_seconds": 4.05,
      "text": "Well, yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.11,
      "end_seconds": 95.38,
      "duration_seconds": 4.27,
      "text": "Have you had any pain at the back of the heel or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.76,
      "end_seconds": 104.33,
      "duration_seconds": 6.57,
      "text": "Uh, I haven't had pain at the back of the heel or numbness, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 109.26,
      "duration_seconds": 3.45,
      "text": "Any fever or pain in the knee at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.63,
      "end_seconds": 114.44,
      "duration_seconds": 3.81,
      "text": "Uh, uh, nothing like that, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.88,
      "end_seconds": 118.56,
      "duration_seconds": 3.68,
      "text": "Alright, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.44,
      "end_seconds": 122.49,
      "duration_seconds": 3.05,
      "text": "Um, no, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.03,
      "end_seconds": 126.18,
      "duration_seconds": 3.15,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.71,
      "end_seconds": 130.29,
      "duration_seconds": 2.58,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.23,
      "end_seconds": 134.85,
      "duration_seconds": 3.62,
      "text": "Okay, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.96,
      "end_seconds": 157.65,
      "duration_seconds": 21.69,
      "text": "Right, uh, I have an underactive thyroid. It's a relief to finally sit down and talk about it. A neighbour of mine said I should see someone about it. I've had heart failure for nearly five years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.23,
      "end_seconds": 163.7,
      "duration_seconds": 5.47,
      "text": "Okay, heart failure, that's already on your record. Good to know. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.21,
      "end_seconds": 169.24,
      "duration_seconds": 4.03,
      "text": "I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.51,
      "end_seconds": 173.02,
      "duration_seconds": 2.51,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 176.21,
      "end_seconds": 181.85,
      "duration_seconds": 5.64,
      "text": "Uh, uh, it's thyroxine, every morning for my thyroid, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.64,
      "end_seconds": 184.21,
      "duration_seconds": 1.57,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 188.03,
      "end_seconds": 200.68,
      "duration_seconds": 12.65,
      "text": "75 micrograms, I think that's what's on the box. Uh, it's furosemide, 40 milligrams, every morning, doctor. He is on paracetamol, 500 milligrams, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.81,
      "end_seconds": 205.05,
      "duration_seconds": 3.24,
      "text": "So, how long have you been on it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 205.46,
      "end_seconds": 206.99,
      "duration_seconds": 1.53,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.35,
      "end_seconds": 213.89,
      "duration_seconds": 5.54,
      "text": "Right, um, I was on spironolactone before. I stopped taking it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.26,
      "end_seconds": 218.94,
      "duration_seconds": 3.68,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.09,
      "end_seconds": 232.53,
      "duration_seconds": 12.44,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.46,
      "end_seconds": 234.17,
      "duration_seconds": 0.71,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.5,
      "end_seconds": 237.77,
      "duration_seconds": 3.27,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 240.19,
      "duration_seconds": 1.36,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.76,
      "end_seconds": 245.45,
      "duration_seconds": 3.69,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 249.16,
      "duration_seconds": 2.21,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.75,
      "end_seconds": 261.68,
      "duration_seconds": 1.93,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.26,
      "end_seconds": 285.71,
      "duration_seconds": 5.45,
      "text": "Okay: saturation 97 percent, BP is 117 over 68, temp 36.9 degrees, heart rate 77."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.49,
      "end_seconds": 289.22,
      "duration_seconds": 2.73,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.06,
      "end_seconds": 292.57,
      "duration_seconds": 2.51,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.94,
      "end_seconds": 298.18,
      "duration_seconds": 3.24,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.42,
      "end_seconds": 302.03,
      "duration_seconds": 2.61,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.55,
      "end_seconds": 321.25,
      "duration_seconds": 4.7,
      "text": "The bones themselves aren't tender and the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.62,
      "end_seconds": 323.99,
      "duration_seconds": 1.37,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.95,
      "end_seconds": 340.71,
      "duration_seconds": 5.76,
      "text": "There's swelling and bruising on the outer side of the ankle, tender over the ligament."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.53,
      "end_seconds": 348.99,
      "duration_seconds": 4.46,
      "text": "All done, thank you, please sit down. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.94,
      "end_seconds": 357.63,
      "duration_seconds": 7.69,
      "text": "I mean, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.12,
      "end_seconds": 385.93,
      "duration_seconds": 27.81,
      "text": "Right, here's what I'm thinking. I think we're dealing with an ankle sprain at this stage. That's my thinking for now, and it may change as we learn more. It could also be a small fracture, so we'll keep that open. Let me just recap so I've got it right. You've had pain in your right ankle for two weeks, moderate, and no pain at the back of the heel or pain in the knee."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.74,
      "end_seconds": 388.23,
      "duration_seconds": 1.49,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.54,
      "end_seconds": 400.91,
      "duration_seconds": 12.37,
      "text": "Let's get an X-ray of the ankle, for ankle injury. I'm prescribing ibuprofen, 400 milligrams, three times a day after food, for three days. You take it by mouth. That should help with ankle pain."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.99,
      "end_seconds": 402.9,
      "duration_seconds": 0.91,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.25,
      "end_seconds": 416.57,
      "duration_seconds": 13.32,
      "text": "Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. Please take the tablets with food so they don't upset your stomach. I'd like you to see physiotherapy as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.58,
      "end_seconds": 419.85,
      "duration_seconds": 2.27,
      "text": "Alright, um, thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.41,
      "end_seconds": 435.17,
      "duration_seconds": 13.76,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's review you in ten days. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.01,
      "end_seconds": 445.16,
      "duration_seconds": 9.15,
      "text": "So, I take the ibuprofen, 400 milligrams, three times a day after food and come back in ten days. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.0,
      "end_seconds": 450.27,
      "duration_seconds": 4.27,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 451.2,
      "end_seconds": 455.4,
      "duration_seconds": 4.2,
      "text": "Hmm, uh, no, you've explained it well. Thanks."
    }
  ]
}