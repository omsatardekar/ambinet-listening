{
  "schema_version": "1.0",
  "encounter_id": "00461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 3.61,
      "duration_seconds": 2.46,
      "text": "Okay, hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.59,
      "end_seconds": 6.46,
      "duration_seconds": 1.87,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.78,
      "end_seconds": 9.42,
      "duration_seconds": 1.64,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.23,
      "end_seconds": 12.99,
      "duration_seconds": 2.76,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 17.54,
      "duration_seconds": 3.16,
      "text": "Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.36,
      "end_seconds": 22.52,
      "duration_seconds": 4.16,
      "text": "I mean, I've been dealing with a routine check-up."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.15,
      "end_seconds": 25.73,
      "duration_seconds": 2.58,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.6,
      "end_seconds": 27.44,
      "duration_seconds": 0.84,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.31,
      "end_seconds": 39.92,
      "duration_seconds": 2.61,
      "text": "Alright, I've got it. Any chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.5,
      "end_seconds": 42.31,
      "duration_seconds": 1.81,
      "text": "No. No chest pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.09,
      "end_seconds": 46.95,
      "duration_seconds": 3.86,
      "text": "Any weight loss or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.23,
      "end_seconds": 50.72,
      "duration_seconds": 2.49,
      "text": "Right, no, none of those."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.39,
      "end_seconds": 55.05,
      "duration_seconds": 3.66,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.5,
      "end_seconds": 66.77,
      "duration_seconds": 11.27,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.65,
      "end_seconds": 71.86,
      "duration_seconds": 4.21,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.76,
      "end_seconds": 81.21,
      "duration_seconds": 8.45,
      "text": "Well, you know, I have high cholesterol, for two years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.65,
      "end_seconds": 95.09,
      "duration_seconds": 12.44,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.75,
      "end_seconds": 102.28,
      "duration_seconds": 4.53,
      "text": "Okay, so good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.11,
      "end_seconds": 108.6,
      "duration_seconds": 2.49,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.93,
      "end_seconds": 112.41,
      "duration_seconds": 2.48,
      "text": "It's rosuvastatin, 10 milligrams, at night."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 115.55,
      "duration_seconds": 2.66,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.98,
      "end_seconds": 117.21,
      "duration_seconds": 1.23,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.2,
      "end_seconds": 122.24,
      "duration_seconds": 2.04,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.98,
      "end_seconds": 127.1,
      "duration_seconds": 4.12,
      "text": "I mean, you know, not that I know, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.1,
      "end_seconds": 136.55,
      "duration_seconds": 5.45,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.96,
      "end_seconds": 146.59,
      "duration_seconds": 8.63,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.18,
      "end_seconds": 150.42,
      "duration_seconds": 3.24,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.94,
      "end_seconds": 161.86,
      "duration_seconds": 1.92,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.22,
      "end_seconds": 179.94,
      "duration_seconds": 7.72,
      "text": "Okay: heart rate 64, temperature 36.9, BP is 115 over 81. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.47,
      "end_seconds": 196.05,
      "duration_seconds": 15.58,
      "text": "Oh, um, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.56,
      "end_seconds": 199.92,
      "duration_seconds": 2.36,
      "text": "Okay, can I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.99,
      "end_seconds": 201.69,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 206.23,
      "duration_seconds": 2.94,
      "text": "Okay, stay still while I have a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.04,
      "end_seconds": 224.93,
      "duration_seconds": 1.89,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.95,
      "end_seconds": 227.89,
      "duration_seconds": 1.94,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.23,
      "end_seconds": 244.68,
      "duration_seconds": 2.45,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.88,
      "end_seconds": 249.31,
      "duration_seconds": 2.43,
      "text": "That's fine, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.13,
      "end_seconds": 252.43,
      "duration_seconds": 2.3,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 253.81,
      "duration_seconds": 0.8,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.84,
      "end_seconds": 275.36,
      "duration_seconds": 12.52,
      "text": "Alright, I've got it. Putting it all together, I think we're dealing with generally well, nothing worrying today at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.47,
      "end_seconds": 280.38,
      "duration_seconds": 3.91,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.71,
      "end_seconds": 281.5,
      "duration_seconds": 0.79,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.32,
      "end_seconds": 297.84,
      "duration_seconds": 4.52,
      "text": "Alright, I've got it. We should do an HbA1c for health screening."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 298.95,
      "end_seconds": 303.01,
      "duration_seconds": 4.06,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.37,
      "end_seconds": 322.81,
      "duration_seconds": 18.44,
      "text": "Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. Please take the tablets with food so they don't upset your stomach. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.45,
      "end_seconds": 325.19,
      "duration_seconds": 1.74,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.96,
      "end_seconds": 329.02,
      "duration_seconds": 3.06,
      "text": "Please come and see me in a year."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.41,
      "end_seconds": 334.35,
      "duration_seconds": 3.94,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.74,
      "end_seconds": 341.81,
      "duration_seconds": 7.07,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.28,
      "end_seconds": 347.92,
      "duration_seconds": 4.64,
      "text": "So, I come back in a year. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.38,
      "end_seconds": 354.29,
      "duration_seconds": 4.91,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.69,
      "end_seconds": 361.53,
      "duration_seconds": 2.84,
      "text": "Alright, um, thanks. Bye for now."
    }
  ]
}