{
  "schema_version": "1.0",
  "encounter_id": "00497",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.92,
      "duration_seconds": 3.2,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.83,
      "end_seconds": 8.32,
      "duration_seconds": 3.49,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.33,
      "end_seconds": 15.01,
      "duration_seconds": 4.68,
      "text": "Honestly, it's trouble sleeping, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.4,
      "end_seconds": 18.22,
      "duration_seconds": 1.82,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.52,
      "end_seconds": 25.82,
      "duration_seconds": 6.3,
      "text": "For about a month, I'd say. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.61,
      "end_seconds": 29.73,
      "duration_seconds": 3.12,
      "text": "And what do you do to cope with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.06,
      "end_seconds": 33.71,
      "duration_seconds": 3.65,
      "text": "I, I get some relief from a warm bath."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.94,
      "end_seconds": 37.7,
      "duration_seconds": 2.76,
      "text": "Have you been feeling exhausted in the day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.36,
      "end_seconds": 42.92,
      "duration_seconds": 4.56,
      "text": "Yes, actually. I've also had trouble concentrating, for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.75,
      "end_seconds": 45.52,
      "duration_seconds": 1.77,
      "text": "And snoring, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.65,
      "end_seconds": 50.64,
      "duration_seconds": 1.99,
      "text": "Not at all, no snoring."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.91,
      "end_seconds": 55.84,
      "duration_seconds": 3.93,
      "text": "Any restless legs, low mood or chest pain at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.41,
      "end_seconds": 59.46,
      "duration_seconds": 2.05,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.45,
      "end_seconds": 62.42,
      "duration_seconds": 1.97,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.12,
      "end_seconds": 64.62,
      "duration_seconds": 1.5,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.79,
      "end_seconds": 70.98,
      "duration_seconds": 5.19,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.1,
      "end_seconds": 81.36,
      "duration_seconds": 9.26,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.27,
      "end_seconds": 83.21,
      "duration_seconds": 0.94,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.89,
      "end_seconds": 87.35,
      "duration_seconds": 3.46,
      "text": "Just cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.5,
      "end_seconds": 93.1,
      "duration_seconds": 4.6,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.77,
      "end_seconds": 115.84,
      "duration_seconds": 5.07,
      "text": "Okay, that's done. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.47,
      "end_seconds": 118.76,
      "duration_seconds": 2.29,
      "text": "Yes, codeine. I get vomiting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.44,
      "end_seconds": 122.92,
      "duration_seconds": 3.48,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.34,
      "end_seconds": 124.14,
      "duration_seconds": 0.8,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.94,
      "end_seconds": 143.49,
      "duration_seconds": 5.55,
      "text": "Alright, I've got it. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.28,
      "end_seconds": 145.83,
      "duration_seconds": 1.55,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.69,
      "end_seconds": 150.38,
      "duration_seconds": 3.69,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.79,
      "end_seconds": 156.73,
      "duration_seconds": 5.94,
      "text": "So, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 160.34,
      "duration_seconds": 2.47,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 165.59,
      "duration_seconds": 4.04,
      "text": "Escitalopram. I take it once a day for the anxiety."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.41,
      "end_seconds": 168.3,
      "duration_seconds": 1.89,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.7,
      "end_seconds": 172.22,
      "duration_seconds": 3.52,
      "text": "It's, It's 10 milligrams. Amlodipine, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 175.59,
      "duration_seconds": 1.87,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.74,
      "end_seconds": 177.88,
      "duration_seconds": 1.14,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.31,
      "end_seconds": 186.49,
      "duration_seconds": 7.18,
      "text": "What about your general health, any conditions you're being treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.27,
      "end_seconds": 189.44,
      "duration_seconds": 2.17,
      "text": "Anxiety, for about ten years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.52,
      "end_seconds": 194.22,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.12,
      "end_seconds": 197.51,
      "duration_seconds": 2.39,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.88,
      "end_seconds": 205.08,
      "duration_seconds": 6.2,
      "text": "Mm. Yes, I can see the anxiety in your file as well. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.94,
      "end_seconds": 215.86,
      "duration_seconds": 1.92,
      "text": "Okay, just relax your arm..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.92,
      "end_seconds": 242.15,
      "duration_seconds": 7.23,
      "text": "Okay: oxygen saturation is 97 percent, pulse is 74 beats a minute, blood pressure 108 over 79. And temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.25,
      "end_seconds": 244.34,
      "duration_seconds": 1.09,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.04,
      "end_seconds": 250.31,
      "duration_seconds": 5.27,
      "text": "We'll put it in context in a moment. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.06,
      "end_seconds": 253.83,
      "duration_seconds": 2.77,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.15,
      "end_seconds": 266.84,
      "duration_seconds": 11.69,
      "text": "Right, here's what I'm thinking. It fits best with insomnia, probably stress-related. The reason I say that is that the way you describe it fits together. Sleep apnoea is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.08,
      "end_seconds": 270.39,
      "duration_seconds": 2.31,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.74,
      "end_seconds": 285.41,
      "duration_seconds": 13.67,
      "text": "It's reasonable to be concerned, but right now insomnia, probably stress-related is my leading thought, not anything worse. Let me just recap so I've got it right. You've had trouble sleeping for about a month, and no low mood or snoring."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.81,
      "end_seconds": 287.43,
      "duration_seconds": 1.62,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.38,
      "end_seconds": 295.54,
      "duration_seconds": 7.16,
      "text": "Let's get a thyroid test, for insomnia. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.73,
      "end_seconds": 299.28,
      "duration_seconds": 2.55,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.85,
      "end_seconds": 323.14,
      "duration_seconds": 23.29,
      "text": "We should do a sleep study for insomnia. I'd rather check than guess, and this is the quickest way to know more. Same wake-up time every day, no screens in the hour before bed, and no coffee after lunch. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.71,
      "end_seconds": 334.87,
      "duration_seconds": 11.16,
      "text": "Right. A short walk every day, even twenty minutes, will help more than you'd think. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.89,
      "end_seconds": 337.61,
      "duration_seconds": 1.72,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.14,
      "end_seconds": 340.74,
      "duration_seconds": 2.6,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.24,
      "end_seconds": 344.84,
      "duration_seconds": 3.6,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.26,
      "end_seconds": 350.93,
      "duration_seconds": 4.67,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.65,
      "end_seconds": 355.4,
      "duration_seconds": 3.75,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.65,
      "end_seconds": 360.8,
      "duration_seconds": 4.15,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.77,
      "end_seconds": 366.19,
      "duration_seconds": 4.42,
      "text": "No, you know, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.48,
      "end_seconds": 368.52,
      "duration_seconds": 1.04,
      "text": "See you then."
    }
  ]
}