{
  "schema_version": "1.0",
  "encounter_id": "00308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 2.74,
      "duration_seconds": 2.14,
      "text": "Good afternoon. Take a seat, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.13,
      "end_seconds": 4.86,
      "duration_seconds": 0.73,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.89,
      "end_seconds": 9.09,
      "duration_seconds": 3.2,
      "text": "Doctor, um, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.6,
      "end_seconds": 14.32,
      "duration_seconds": 3.72,
      "text": "Absolutely, come and sit beside them. Alright, what's been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.62,
      "end_seconds": 18.8,
      "duration_seconds": 4.18,
      "text": "Doctor, it's a missed period. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.43,
      "end_seconds": 21.79,
      "duration_seconds": 2.36,
      "text": "Okay, and when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.56,
      "end_seconds": 29.85,
      "duration_seconds": 7.29,
      "text": "I've had it for about a month. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.21,
      "end_seconds": 36.1,
      "duration_seconds": 1.89,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.68,
      "end_seconds": 42.35,
      "duration_seconds": 5.67,
      "text": "Pretty mild, if I'm being honest. And, And I've been feeling tired as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.39,
      "end_seconds": 46.03,
      "duration_seconds": 2.64,
      "text": "Have you been needing to pass urine more?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.49,
      "end_seconds": 48.99,
      "duration_seconds": 2.5,
      "text": "Yes, about the same, one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.22,
      "end_seconds": 51.83,
      "duration_seconds": 1.61,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.89,
      "end_seconds": 55.16,
      "duration_seconds": 2.27,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.56,
      "end_seconds": 61.6,
      "duration_seconds": 5.04,
      "text": "Have you had a missed period before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.27,
      "end_seconds": 67.66,
      "duration_seconds": 5.39,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.88,
      "end_seconds": 72.95,
      "duration_seconds": 4.07,
      "text": "Let me check a few things. Any vomiting everything or bleeding?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.46,
      "end_seconds": 77.66,
      "duration_seconds": 3.2,
      "text": "I haven't had vomiting everything or bleeding, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.23,
      "end_seconds": 83.41,
      "duration_seconds": 4.18,
      "text": "Have you had any burning when passing urine or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.98,
      "end_seconds": 86.35,
      "duration_seconds": 2.37,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 89.74,
      "duration_seconds": 2.75,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.14,
      "end_seconds": 93.33,
      "duration_seconds": 3.19,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.65,
      "end_seconds": 97.15,
      "duration_seconds": 2.5,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.7,
      "end_seconds": 110.94,
      "duration_seconds": 13.24,
      "text": "Uh, I'm on thyroxine, 75 micrograms, every morning. I told myself I'd wait and see, and here I am. Iron tablets. I take it once a day for my blood count."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.28,
      "end_seconds": 115.94,
      "duration_seconds": 3.66,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.1,
      "end_seconds": 118.67,
      "duration_seconds": 1.57,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.72,
      "end_seconds": 122.34,
      "duration_seconds": 2.62,
      "text": "Hold on, the screen's frozen for a second."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.13,
      "end_seconds": 138.13,
      "duration_seconds": 3.0,
      "text": "Good, where were we. Any operations in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.24,
      "end_seconds": 143.32,
      "duration_seconds": 4.08,
      "text": "Uh, just a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.93,
      "end_seconds": 157.83,
      "duration_seconds": 13.9,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.64,
      "end_seconds": 160.23,
      "duration_seconds": 1.59,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.69,
      "end_seconds": 167.15,
      "duration_seconds": 6.46,
      "text": "Okay, what about your general health, any conditions you're being treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.11,
      "end_seconds": 185.34,
      "duration_seconds": 13.23,
      "text": "I have an underactive thyroid, for five years. My family kept telling me to get it checked. Hmm, I have low haemoglobin. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.34,
      "end_seconds": 200.42,
      "duration_seconds": 14.08,
      "text": "Okay, an underactive thyroid, that's already on your record. Good to know. Right, so that's your known low haemoglobin. We'll keep that in mind today. Do you have any known allergies at all? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.92,
      "end_seconds": 202.7,
      "duration_seconds": 0.78,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.2,
      "end_seconds": 206.11,
      "duration_seconds": 1.91,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.76,
      "end_seconds": 221.16,
      "duration_seconds": 1.4,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.68,
      "end_seconds": 243.93,
      "duration_seconds": 5.25,
      "text": "Okay: temperature 36.5, heart rate 75, pressure 112 over 78. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.19,
      "end_seconds": 249.14,
      "duration_seconds": 2.95,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.59,
      "end_seconds": 251.29,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 254.62,
      "duration_seconds": 1.61,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 278.1,
      "duration_seconds": 4.9,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.46,
      "end_seconds": 299.92,
      "duration_seconds": 17.46,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.52,
      "end_seconds": 310.45,
      "duration_seconds": 9.93,
      "text": "Okay, so yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.03,
      "end_seconds": 334.43,
      "duration_seconds": 22.4,
      "text": "Okay, so my impression is this: This looks most like an early pregnancy. I want to be honest that this is an impression, not a final answer. It could also be a late period for another reason, so we'll keep that open. Let me just recap so I've got it right. You've had a missed period for about a month, mild, and no vomiting everything or severe abdominal pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.89,
      "end_seconds": 338.18,
      "duration_seconds": 2.29,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.63,
      "end_seconds": 362.67,
      "duration_seconds": 23.04,
      "text": "Let's get a pregnancy test, for missed period. Let's get an early scan, for early pregnancy. The result will help us decide whether anything more is needed. I'd like you to take folic acid, 5 milligrams, once a day, until twelve weeks. That should help with pregnancy. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.99,
      "end_seconds": 390.06,
      "duration_seconds": 27.07,
      "text": "Right. Avoid alcohol and don't take any new tablets without checking with us first. Cut down on salt and fried food for now, it really does make a difference. A short walk every day, even twenty minutes, will help more than you'd think. Please don't sit on it if you have bleeding or sharp pain on one side. That's the point to get seen urgently. Let's review you after the scan."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.72,
      "end_seconds": 391.42,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.16,
      "end_seconds": 398.8,
      "duration_seconds": 6.64,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.04,
      "end_seconds": 409.7,
      "duration_seconds": 7.66,
      "text": "So, I take the folic acid, 5 milligrams, once a day and come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.61,
      "end_seconds": 415.73,
      "duration_seconds": 5.12,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 416.85,
      "end_seconds": 420.29,
      "duration_seconds": 3.44,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.55,
      "end_seconds": 423.72,
      "duration_seconds": 2.17,
      "text": "Bye for now, look after yourself."
    }
  ]
}