{
  "schema_version": "1.0",
  "encounter_id": "00353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.53,
      "duration_seconds": 3.45,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.37,
      "end_seconds": 10.36,
      "duration_seconds": 4.99,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.55,
      "end_seconds": 18.73,
      "duration_seconds": 7.18,
      "text": "Um, so... fever and chills. That's why I came. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.23,
      "end_seconds": 24.6,
      "duration_seconds": 4.37,
      "text": "And when did that start? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 35.04,
      "duration_seconds": 10.0,
      "text": "I've had it since Monday. I've had a cough with phlegm too, for one week. As for cough with phlegm, it happens all the time."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.51,
      "end_seconds": 41.13,
      "duration_seconds": 4.62,
      "text": "Have you had fever and chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.31,
      "end_seconds": 49.08,
      "duration_seconds": 6.77,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.75,
      "end_seconds": 53.49,
      "duration_seconds": 3.74,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.18,
      "end_seconds": 54.88,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.71,
      "end_seconds": 68.39,
      "duration_seconds": 3.68,
      "text": "Okay, here we go. Alright, what about recent travel?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.96,
      "end_seconds": 71.09,
      "duration_seconds": 2.13,
      "text": "No recent travel, thank goodness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.63,
      "end_seconds": 76.51,
      "duration_seconds": 3.88,
      "text": "Let me check a few things. Any confusion or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.71,
      "end_seconds": 80.32,
      "duration_seconds": 2.61,
      "text": "I mean, no, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.69,
      "end_seconds": 84.31,
      "duration_seconds": 2.62,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.78,
      "end_seconds": 87.75,
      "duration_seconds": 1.97,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.79,
      "end_seconds": 91.36,
      "duration_seconds": 2.57,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.22,
      "end_seconds": 98.38,
      "duration_seconds": 3.16,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.35,
      "end_seconds": 103.68,
      "duration_seconds": 4.33,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.42,
      "end_seconds": 110.42,
      "duration_seconds": 4.0,
      "text": "I mean, um, not that I know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.48,
      "end_seconds": 114.21,
      "duration_seconds": 2.73,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.39,
      "end_seconds": 117.0,
      "duration_seconds": 1.61,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.97,
      "end_seconds": 120.09,
      "duration_seconds": 2.12,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.26,
      "end_seconds": 125.56,
      "duration_seconds": 2.3,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.15,
      "end_seconds": 131.45,
      "duration_seconds": 4.3,
      "text": "Alright, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 138.39,
      "duration_seconds": 6.31,
      "text": "Right, I've had diabetes, yes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.84,
      "end_seconds": 145.2,
      "duration_seconds": 5.36,
      "text": "Are you on any tablets or medication? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 150.06,
      "duration_seconds": 3.29,
      "text": "I'm on glimepiride, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.89,
      "end_seconds": 152.62,
      "duration_seconds": 1.73,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.11,
      "end_seconds": 161.41,
      "duration_seconds": 8.3,
      "text": "2 milligrams, I think that's what's on the box. I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.86,
      "end_seconds": 166.5,
      "duration_seconds": 3.64,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.94,
      "end_seconds": 181.05,
      "duration_seconds": 13.11,
      "text": "Yes, uh, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.61,
      "end_seconds": 184.82,
      "duration_seconds": 2.21,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 199.22,
      "duration_seconds": 1.29,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.72,
      "end_seconds": 240.87,
      "duration_seconds": 24.15,
      "text": "Okay: oxygen saturation is 91 percent, pulse is 97 beats a minute, respiratory rate 20, BP is 126 over 74. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.69,
      "end_seconds": 244.3,
      "duration_seconds": 2.61,
      "text": "Uh, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.96,
      "end_seconds": 249.39,
      "duration_seconds": 2.43,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.49,
      "end_seconds": 251.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.45,
      "end_seconds": 254.61,
      "duration_seconds": 2.16,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.62,
      "end_seconds": 269.96,
      "duration_seconds": 3.34,
      "text": "There's bronchial breathing and crackles at the right lower zone."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.49,
      "end_seconds": 272.28,
      "duration_seconds": 1.79,
      "text": "Yes, um, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.8,
      "end_seconds": 288.64,
      "duration_seconds": 10.84,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.4,
      "end_seconds": 292.37,
      "duration_seconds": 2.97,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.91,
      "end_seconds": 293.73,
      "duration_seconds": 0.82,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.03,
      "end_seconds": 314.67,
      "duration_seconds": 11.64,
      "text": "Okay, here we go. Right, here's what I'm thinking. It fits best with a possible pneumonia on the right side. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.21,
      "end_seconds": 318.51,
      "duration_seconds": 2.3,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.4,
      "end_seconds": 335.71,
      "duration_seconds": 16.31,
      "text": "I can't promise yet, but most people with a possible pneumonia on the right side do well once it's treated properly. Let me just recap so I've got it right. You've had fever and chills, since Monday, and no recent travel or vomiting."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.52,
      "end_seconds": 342.48,
      "duration_seconds": 1.96,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.69,
      "end_seconds": 358.39,
      "duration_seconds": 14.7,
      "text": "Let's get blood tests, for infection. I'd like you to take amoxicillin-clavulanate, 625 milligrams, three times a day, for five days. That should help with chest infection. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.84,
      "end_seconds": 363.11,
      "duration_seconds": 2.27,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.18,
      "end_seconds": 382.41,
      "duration_seconds": 18.23,
      "text": "Rest and fluids, and finish every dose of the antibiotic. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Keep an eye out, and if the breathlessness worsens or you become drowsy, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.97,
      "end_seconds": 384.67,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.8,
      "end_seconds": 387.81,
      "duration_seconds": 2.01,
      "text": "Let's review you in three days."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.1,
      "end_seconds": 389.8,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.41,
      "end_seconds": 396.73,
      "duration_seconds": 6.32,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.09,
      "end_seconds": 404.97,
      "duration_seconds": 7.88,
      "text": "So, I take the amoxicillin-clavulanate, 625 milligrams, three times a day and come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.25,
      "end_seconds": 411.29,
      "duration_seconds": 5.04,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.93,
      "end_seconds": 418.76,
      "duration_seconds": 3.83,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.06,
      "end_seconds": 420.76,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}