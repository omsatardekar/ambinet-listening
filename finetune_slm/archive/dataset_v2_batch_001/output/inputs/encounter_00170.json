{
  "schema_version": "1.0",
  "encounter_id": "00170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.31,
      "duration_seconds": 3.68,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.35,
      "end_seconds": 8.39,
      "duration_seconds": 3.04,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.71,
      "end_seconds": 15.11,
      "duration_seconds": 4.4,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.36,
      "end_seconds": 18.7,
      "duration_seconds": 2.34,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.37,
      "end_seconds": 31.3,
      "duration_seconds": 11.93,
      "text": "Uh, mainly swelling in my left calf. There's a couple of other things, but that's the main one. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.78,
      "end_seconds": 34.61,
      "duration_seconds": 1.83,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.02,
      "end_seconds": 44.18,
      "duration_seconds": 8.16,
      "text": "It's been going on for three days. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.35,
      "end_seconds": 48.99,
      "duration_seconds": 3.64,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.48,
      "end_seconds": 75.76,
      "duration_seconds": 25.28,
      "text": "Severe, I'd say. Yes, standing. That makes it worse. I get some relief from raising the leg. Honestly, on and off. I took the morning off to come in today. And pain in that calf, too. About pain in that calf, I'd say mild. A bit of redness was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.32,
      "end_seconds": 79.02,
      "duration_seconds": 1.7,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.16,
      "end_seconds": 82.42,
      "duration_seconds": 2.26,
      "text": "Not at all, no fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 82.97,
      "end_seconds": 87.47,
      "duration_seconds": 4.5,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.36,
      "end_seconds": 93.93,
      "duration_seconds": 5.57,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.09,
      "end_seconds": 102.1,
      "duration_seconds": 7.01,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.94,
      "end_seconds": 105.66,
      "duration_seconds": 2.72,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 109.68,
      "duration_seconds": 2.62,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.08,
      "end_seconds": 112.83,
      "duration_seconds": 1.75,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.24,
      "end_seconds": 116.42,
      "duration_seconds": 2.18,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.55,
      "end_seconds": 119.56,
      "duration_seconds": 2.01,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.92,
      "end_seconds": 133.84,
      "duration_seconds": 12.92,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.24,
      "end_seconds": 136.15,
      "duration_seconds": 1.91,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.66,
      "end_seconds": 140.75,
      "duration_seconds": 3.09,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.32,
      "end_seconds": 166.07,
      "duration_seconds": 23.75,
      "text": "I've got arthritis in my knees. I kept putting it off, which I know isn't sensible. I have high blood pressure, for about a year. I looked a few things up online, and that probably didn't help. I have low haemoglobin. I didn't want to make a fuss, you know. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.97,
      "end_seconds": 175.9,
      "duration_seconds": 8.93,
      "text": "I've, I've got heart disease. I'd rather know what's going on than keep guessing. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 177.88,
      "duration_seconds": 1.52,
      "text": "Right. What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.22,
      "end_seconds": 181.22,
      "duration_seconds": 3.0,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.92,
      "end_seconds": 184.28,
      "duration_seconds": 2.36,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.69,
      "end_seconds": 201.92,
      "duration_seconds": 17.23,
      "text": "I take ramipril, 5 milligrams, every morning. Okay, so I take iron tablets, once a day. I thought it would sort itself out, but it hasn't. I mean, I'm on clopidogrel, 75 milligrams, once a day. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 206.14,
      "duration_seconds": 2.71,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.15,
      "end_seconds": 210.35,
      "duration_seconds": 3.2,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.07,
      "end_seconds": 214.65,
      "duration_seconds": 3.58,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.16,
      "end_seconds": 220.01,
      "duration_seconds": 4.85,
      "text": "Peanuts, I'd say. Sulfa drugs. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 222.29,
      "duration_seconds": 1.08,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.47,
      "end_seconds": 234.21,
      "duration_seconds": 10.74,
      "text": "Oh, I had a stent put in my heart two years ago. I've never really been one for hospitals. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.9,
      "end_seconds": 237.22,
      "duration_seconds": 2.32,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.94,
      "end_seconds": 246.96,
      "duration_seconds": 2.02,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.02,
      "end_seconds": 272.06,
      "duration_seconds": 4.04,
      "text": "Okay: BP is 121 over 76, pulse 108, temperature 37.1."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.03,
      "end_seconds": 274.38,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.78,
      "end_seconds": 277.52,
      "duration_seconds": 2.74,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 281.85,
      "duration_seconds": 2.05,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.57,
      "end_seconds": 283.27,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.25,
      "end_seconds": 287.81,
      "duration_seconds": 2.56,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.33,
      "end_seconds": 308.8,
      "duration_seconds": 4.47,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.82,
      "end_seconds": 311.44,
      "duration_seconds": 1.62,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.08,
      "end_seconds": 324.72,
      "duration_seconds": 1.64,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.99,
      "end_seconds": 338.52,
      "duration_seconds": 9.53,
      "text": "That's fine, you can get dressed. Putting it all together, it fits best with a possible deep vein clot. I can't rule out cellulitis yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.05,
      "end_seconds": 344.31,
      "duration_seconds": 4.26,
      "text": "Okay, um, so should I be worried about this?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.36,
      "end_seconds": 364.85,
      "duration_seconds": 19.49,
      "text": "I understand the worry. At the moment I'd say it's a possible deep vein clot, and we'll know more once the a Doppler scan of the leg is back. Let me just recap so I've got it right. You've had swelling in your left calf for three days, severe, and no chest pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.56,
      "end_seconds": 370.89,
      "duration_seconds": 1.33,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.88,
      "end_seconds": 380.65,
      "duration_seconds": 8.77,
      "text": "We should do a Doppler scan of the leg for suspected DVT. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.97,
      "end_seconds": 384.35,
      "duration_seconds": 2.38,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.32,
      "end_seconds": 409.83,
      "duration_seconds": 24.51,
      "text": "Let's get a D-dimer blood test, for suspected DVT. I'd rather check than guess, and this is the quickest way to know more. Keep walking gently, and don't massage the calf. A short walk every day, even twenty minutes, will help more than you'd think. If you get chest pain or sudden breathlessness, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.8,
      "end_seconds": 411.5,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.63,
      "end_seconds": 414.5,
      "duration_seconds": 1.87,
      "text": "Let's review you after the scan."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.88,
      "end_seconds": 417.57,
      "duration_seconds": 1.69,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.11,
      "end_seconds": 419.66,
      "duration_seconds": 1.55,
      "text": "Good. Look after yourself."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.05,
      "end_seconds": 424.22,
      "duration_seconds": 3.17,
      "text": "Well, no, you've explained it well. Thanks."
    }
  ]
}