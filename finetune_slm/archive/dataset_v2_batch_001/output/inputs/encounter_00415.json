{
  "schema_version": "1.0",
  "encounter_id": "00415",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 3.38,
      "duration_seconds": 2.54,
      "text": "Hi, I'm glad you could make it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.79,
      "end_seconds": 4.7,
      "duration_seconds": 0.91,
      "text": "Hi, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.19,
      "end_seconds": 8.45,
      "duration_seconds": 3.26,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.96,
      "end_seconds": 18.06,
      "duration_seconds": 8.1,
      "text": "So the thing is, you know, I've got tingling in my fingers. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.56,
      "end_seconds": 21.2,
      "duration_seconds": 2.64,
      "text": "Alright, how long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.68,
      "end_seconds": 34.95,
      "duration_seconds": 13.27,
      "text": "Oh, um, probably one week. Yeah. I told myself I'd wait and see, and here I am. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.46,
      "end_seconds": 38.92,
      "duration_seconds": 2.46,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.28,
      "end_seconds": 44.59,
      "duration_seconds": 4.31,
      "text": "I mean, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.84,
      "end_seconds": 48.78,
      "duration_seconds": 2.94,
      "text": "Has there been an ache in the wrist too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.28,
      "end_seconds": 64.93,
      "duration_seconds": 14.65,
      "text": "Yes, that started yesterday. About ache in the wrist, maybe a three out of ten on a bad day. Hmm, I've also been waking up at night with pins and needles."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.28,
      "end_seconds": 68.16,
      "duration_seconds": 2.88,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.63,
      "end_seconds": 82.29,
      "duration_seconds": 13.66,
      "text": "I'd say moderate. I've also had numbness in the thumb and first two fingers, for two days. Okay, so about numbness in the thumb and first two fingers, moderate, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.68,
      "end_seconds": 87.01,
      "duration_seconds": 3.33,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.48,
      "end_seconds": 88.18,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.56,
      "end_seconds": 103.73,
      "duration_seconds": 5.17,
      "text": "Alright, I've got it. Any headache, trouble walking or bladder problems at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.14,
      "end_seconds": 109.77,
      "duration_seconds": 4.63,
      "text": "No headache, trouble walking or bladder problems, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.95,
      "end_seconds": 114.06,
      "duration_seconds": 3.11,
      "text": "Any swelling in the joints or neck pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.88,
      "end_seconds": 116.47,
      "duration_seconds": 1.59,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.03,
      "end_seconds": 120.49,
      "duration_seconds": 3.46,
      "text": "Go on. How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.02,
      "end_seconds": 124.11,
      "duration_seconds": 2.09,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.1,
      "end_seconds": 126.65,
      "duration_seconds": 1.55,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 129.22,
      "duration_seconds": 1.83,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.91,
      "end_seconds": 132.75,
      "duration_seconds": 2.84,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.49,
      "end_seconds": 144.04,
      "duration_seconds": 10.55,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.57,
      "end_seconds": 152.16,
      "duration_seconds": 7.59,
      "text": "Do you have any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.66,
      "end_seconds": 163.78,
      "duration_seconds": 11.12,
      "text": "I mean, I have an underactive thyroid, for two years. I just want to get back to normal, really. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 167.72,
      "duration_seconds": 1.09,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.1,
      "end_seconds": 176.69,
      "duration_seconds": 7.59,
      "text": "Um, I've had diabetes for five years now. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.27,
      "end_seconds": 187.29,
      "duration_seconds": 9.02,
      "text": "Okay, an underactive thyroid, that's already on your record. Good to know. Right, do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.38,
      "end_seconds": 195.89,
      "duration_seconds": 7.51,
      "text": "I, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 201.61,
      "duration_seconds": 4.53,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.16,
      "end_seconds": 206.07,
      "duration_seconds": 3.91,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.94,
      "end_seconds": 209.53,
      "duration_seconds": 2.59,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.02,
      "end_seconds": 216.16,
      "duration_seconds": 5.14,
      "text": "I'm on thyroxine, 75 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 223.25,
      "duration_seconds": 3.81,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.18,
      "end_seconds": 231.24,
      "duration_seconds": 7.06,
      "text": "So, um, no, it's at home. Yeah, I'm on metformin, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.71,
      "end_seconds": 234.65,
      "duration_seconds": 1.94,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.36,
      "end_seconds": 247.33,
      "duration_seconds": 11.97,
      "text": "500 milligrams. Uh, you know, it's paracetamol, 500 milligrams, when needed. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.8,
      "end_seconds": 251.11,
      "duration_seconds": 2.31,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.43,
      "end_seconds": 253.58,
      "duration_seconds": 1.15,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.59,
      "end_seconds": 258.48,
      "duration_seconds": 3.89,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 263.14,
      "duration_seconds": 2.88,
      "text": "Alright, stay still while I have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.68,
      "end_seconds": 275.27,
      "duration_seconds": 2.59,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.94,
      "end_seconds": 278.85,
      "duration_seconds": 1.91,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.61,
      "end_seconds": 299.03,
      "duration_seconds": 3.42,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.9,
      "end_seconds": 302.39,
      "duration_seconds": 1.49,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.03,
      "end_seconds": 315.62,
      "duration_seconds": 2.59,
      "text": "Power in the thumb is slightly reduced."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.58,
      "end_seconds": 332.53,
      "duration_seconds": 10.95,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.16,
      "end_seconds": 335.5,
      "duration_seconds": 2.34,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.01,
      "end_seconds": 336.81,
      "duration_seconds": 0.8,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.85,
      "end_seconds": 369.43,
      "duration_seconds": 25.58,
      "text": "Alright, I've got it. So, based on the history and the examination, it fits best with carpal tunnel syndrome. I want to be honest that this is an impression, not a final answer. Diabetic neuropathy is also on my list. Let me just recap so I've got it right. You've had tingling in your fingers for one week, and no headache or bladder problems."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.02,
      "end_seconds": 373.55,
      "duration_seconds": 2.53,
      "text": "Oh, exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.97,
      "end_seconds": 377.69,
      "duration_seconds": 3.72,
      "text": "I'd like to arrange a blood sugar test for neuropathy screen."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 378.64,
      "end_seconds": 381.7,
      "duration_seconds": 3.06,
      "text": "I can book that for Friday at 3:30 pm."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.04,
      "end_seconds": 383.81,
      "duration_seconds": 1.77,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.13,
      "end_seconds": 401.37,
      "duration_seconds": 16.24,
      "text": "Let's get a nerve conduction study, for hand numbness. The result will help us decide whether anything more is needed. A night wrist splint, kept neutral, usually helps a lot. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.43,
      "end_seconds": 403.84,
      "duration_seconds": 1.41,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.33,
      "end_seconds": 411.81,
      "duration_seconds": 6.48,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.1,
      "end_seconds": 413.8,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.45,
      "end_seconds": 418.28,
      "duration_seconds": 3.83,
      "text": "Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 419.84,
      "end_seconds": 420.54,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.66,
      "end_seconds": 426.9,
      "duration_seconds": 5.24,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 427.4,
      "end_seconds": 432.01,
      "duration_seconds": 4.61,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 432.31,
      "end_seconds": 437.7,
      "duration_seconds": 5.39,
      "text": "Yes, exactly right. So, we're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.66,
      "end_seconds": 445.66,
      "duration_seconds": 5.0,
      "text": "Um, uh, that's everything I wanted to ask. Thank you."
    }
  ]
}