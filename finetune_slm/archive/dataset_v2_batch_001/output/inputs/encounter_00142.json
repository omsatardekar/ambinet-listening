{
  "schema_version": "1.0",
  "encounter_id": "00142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 4.19,
      "duration_seconds": 3.08,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.81,
      "end_seconds": 8.27,
      "duration_seconds": 3.46,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.39,
      "end_seconds": 19.62,
      "duration_seconds": 10.23,
      "text": "Mainly blurry vision. There's a couple of other things, but that's the main one. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.56,
      "end_seconds": 22.72,
      "duration_seconds": 2.16,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.04,
      "end_seconds": 30.84,
      "duration_seconds": 6.8,
      "text": "About... well, about a year. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.06,
      "end_seconds": 36.72,
      "duration_seconds": 4.66,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.89,
      "end_seconds": 41.54,
      "duration_seconds": 3.65,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.28,
      "end_seconds": 42.98,
      "duration_seconds": 0.7,
      "text": "Any redness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.4,
      "end_seconds": 44.49,
      "duration_seconds": 1.09,
      "text": "No. No redness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.81,
      "end_seconds": 50.2,
      "duration_seconds": 5.39,
      "text": "Go on. Let me check a few things. Any double vision or sudden loss of vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.22,
      "end_seconds": 55.06,
      "duration_seconds": 1.84,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.38,
      "end_seconds": 59.71,
      "duration_seconds": 3.33,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.77,
      "end_seconds": 72.3,
      "duration_seconds": 11.53,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.85,
      "end_seconds": 74.0,
      "duration_seconds": 1.15,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.75,
      "end_seconds": 77.4,
      "duration_seconds": 2.65,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.14,
      "end_seconds": 80.65,
      "duration_seconds": 2.51,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.43,
      "end_seconds": 82.22,
      "duration_seconds": 0.79,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 94.02,
      "duration_seconds": 2.31,
      "text": "Alright, I've got it. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.23,
      "end_seconds": 99.6,
      "duration_seconds": 4.37,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.1,
      "end_seconds": 103.75,
      "duration_seconds": 2.65,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.21,
      "end_seconds": 109.4,
      "duration_seconds": 4.19,
      "text": "Yes, uh, I had something small this morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.16,
      "end_seconds": 113.95,
      "duration_seconds": 3.79,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.47,
      "end_seconds": 118.32,
      "duration_seconds": 2.85,
      "text": "Yes, shellfish, it gives me vomiting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.23,
      "end_seconds": 136.5,
      "duration_seconds": 17.27,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.27,
      "end_seconds": 142.23,
      "duration_seconds": 1.96,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.14,
      "end_seconds": 145.9,
      "duration_seconds": 2.76,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.26,
      "end_seconds": 149.87,
      "duration_seconds": 2.61,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.53,
      "end_seconds": 154.32,
      "duration_seconds": 3.79,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.84,
      "end_seconds": 155.69,
      "duration_seconds": 0.85,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.21,
      "end_seconds": 174.18,
      "duration_seconds": 2.97,
      "text": "Okay, here we go. Right, any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.38,
      "end_seconds": 176.39,
      "duration_seconds": 1.01,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.35,
      "end_seconds": 181.56,
      "duration_seconds": 4.21,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.82,
      "end_seconds": 195.82,
      "duration_seconds": 13.0,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.73,
      "end_seconds": 199.76,
      "duration_seconds": 3.03,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.19,
      "end_seconds": 201.04,
      "duration_seconds": 0.85,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.83,
      "end_seconds": 229.13,
      "duration_seconds": 12.3,
      "text": "Okay, here we go. Right, here's what I'm thinking. This looks most like a refractive problem or early cataracts. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.69,
      "end_seconds": 231.59,
      "duration_seconds": 1.9,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.13,
      "end_seconds": 249.45,
      "duration_seconds": 17.32,
      "text": "It's reasonable to be concerned, but right now a refractive problem or early cataracts is my leading thought, not anything worse. Let me just recap so I've got it right. You've had blurry vision for about a year, and no double vision or redness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.88,
      "end_seconds": 252.96,
      "duration_seconds": 2.08,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.11,
      "end_seconds": 257.27,
      "duration_seconds": 3.16,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.9,
      "end_seconds": 258.6,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.61,
      "end_seconds": 275.33,
      "duration_seconds": 8.72,
      "text": "Right, thanks for waiting. We should do a dilated eye examination for blurred vision. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.52,
      "end_seconds": 277.98,
      "duration_seconds": 1.46,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.42,
      "end_seconds": 306.66,
      "duration_seconds": 25.24,
      "text": "Get a proper glasses test, and keep your sugar and blood pressure well controlled for your eyes. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Keep an eye out, and if you get sudden loss of vision or a curtain across your sight, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.25,
      "end_seconds": 309.41,
      "duration_seconds": 2.16,
      "text": "Yeah, got it, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.67,
      "end_seconds": 319.7,
      "duration_seconds": 8.03,
      "text": "Let's review you in four weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.16,
      "end_seconds": 325.71,
      "duration_seconds": 4.55,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.17,
      "end_seconds": 331.51,
      "duration_seconds": 5.34,
      "text": "Right, yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.35,
      "end_seconds": 336.14,
      "duration_seconds": 3.79,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.52,
      "end_seconds": 338.47,
      "duration_seconds": 0.95,
      "text": "See you then."
    }
  ]
}