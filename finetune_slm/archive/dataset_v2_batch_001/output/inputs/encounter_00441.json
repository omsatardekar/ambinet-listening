{
  "schema_version": "1.0",
  "encounter_id": "00441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.77,
      "duration_seconds": 3.6,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.14,
      "end_seconds": 8.87,
      "duration_seconds": 3.73,
      "text": "Right, no trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.96,
      "end_seconds": 16.05,
      "duration_seconds": 6.09,
      "text": "It's exhaustion since I had the flu. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.44,
      "end_seconds": 21.93,
      "duration_seconds": 5.49,
      "text": "How long has this been going on? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.83,
      "end_seconds": 25.52,
      "duration_seconds": 2.69,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.1,
      "end_seconds": 29.89,
      "duration_seconds": 2.79,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.99,
      "end_seconds": 34.84,
      "duration_seconds": 3.85,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.16,
      "end_seconds": 35.86,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 40.45,
      "duration_seconds": 4.16,
      "text": "I've, I've had poor sleep too, for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.77,
      "end_seconds": 47.01,
      "duration_seconds": 3.24,
      "text": "Okay, has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.01,
      "end_seconds": 61.84,
      "duration_seconds": 13.83,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.78,
      "end_seconds": 67.18,
      "duration_seconds": 4.4,
      "text": "Let me check a few things. Any shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.55,
      "end_seconds": 69.88,
      "duration_seconds": 2.33,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.05,
      "end_seconds": 72.14,
      "duration_seconds": 1.09,
      "text": "Any weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.71,
      "end_seconds": 74.5,
      "duration_seconds": 1.79,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.05,
      "end_seconds": 87.08,
      "duration_seconds": 12.03,
      "text": "Okay. I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.77,
      "end_seconds": 89.41,
      "duration_seconds": 1.64,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.48,
      "end_seconds": 93.49,
      "duration_seconds": 3.01,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.7,
      "end_seconds": 97.84,
      "duration_seconds": 3.14,
      "text": "Yes, aspirin, it gives me a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.33,
      "end_seconds": 100.71,
      "duration_seconds": 1.38,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.71,
      "end_seconds": 104.74,
      "duration_seconds": 3.03,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.08,
      "end_seconds": 107.24,
      "duration_seconds": 1.16,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.09,
      "end_seconds": 109.69,
      "duration_seconds": 1.6,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.15,
      "end_seconds": 126.81,
      "duration_seconds": 15.66,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.3,
      "end_seconds": 129.18,
      "duration_seconds": 1.88,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.69,
      "end_seconds": 131.67,
      "duration_seconds": 0.98,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.9,
      "end_seconds": 133.84,
      "duration_seconds": 0.94,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.37,
      "end_seconds": 137.38,
      "duration_seconds": 3.01,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.94,
      "end_seconds": 138.79,
      "duration_seconds": 0.85,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.51,
      "end_seconds": 155.94,
      "duration_seconds": 7.43,
      "text": "Right, thanks for waiting. Do you have any medical conditions I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.46,
      "end_seconds": 160.08,
      "duration_seconds": 2.62,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.48,
      "end_seconds": 165.5,
      "duration_seconds": 4.02,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 167.08,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.25,
      "end_seconds": 178.81,
      "duration_seconds": 1.56,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.44,
      "end_seconds": 184.53,
      "duration_seconds": 3.09,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.42,
      "end_seconds": 186.12,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.92,
      "end_seconds": 189.35,
      "duration_seconds": 1.43,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.77,
      "end_seconds": 209.65,
      "duration_seconds": 1.88,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.03,
      "end_seconds": 221.17,
      "duration_seconds": 9.14,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.1,
      "end_seconds": 224.67,
      "duration_seconds": 2.57,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.53,
      "end_seconds": 226.38,
      "duration_seconds": 0.85,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.3,
      "end_seconds": 244.83,
      "duration_seconds": 10.53,
      "text": "Alright, I've got it. Putting it all together, I think we're dealing with post-viral fatigue at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.18,
      "end_seconds": 249.26,
      "duration_seconds": 4.08,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.71,
      "end_seconds": 267.04,
      "duration_seconds": 17.33,
      "text": "It's reasonable to be concerned, but right now post-viral fatigue is my leading thought, not anything worse. Let me just recap so I've got it right. You've had exhaustion since you had the flu for about four days, and no weight loss or chest pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.72,
      "end_seconds": 272.82,
      "duration_seconds": 2.1,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.6,
      "end_seconds": 280.36,
      "duration_seconds": 6.76,
      "text": "Let's get blood tests, for fatigue. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.82,
      "end_seconds": 283.89,
      "duration_seconds": 3.07,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.33,
      "end_seconds": 294.75,
      "duration_seconds": 9.42,
      "text": "Pace yourself, a little more activity each day but stop before you're wiped out. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.03,
      "end_seconds": 300.94,
      "duration_seconds": 5.91,
      "text": "I see. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.72,
      "end_seconds": 302.42,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 311.86,
      "duration_seconds": 8.25,
      "text": "I'd like to see you again in four weeks. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.04,
      "end_seconds": 317.03,
      "duration_seconds": 3.99,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.57,
      "end_seconds": 320.19,
      "duration_seconds": 2.62,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.45,
      "end_seconds": 323.38,
      "duration_seconds": 1.93,
      "text": "Oh, no questions. Thank you."
    }
  ]
}