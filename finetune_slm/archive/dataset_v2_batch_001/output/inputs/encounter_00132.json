{
  "schema_version": "1.0",
  "encounter_id": "00132",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 5.33,
      "duration_seconds": 4.39,
      "text": "Good evening, um, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.82,
      "end_seconds": 9.79,
      "duration_seconds": 3.97,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.09,
      "end_seconds": 17.32,
      "duration_seconds": 6.23,
      "text": "I've been dealing with acne. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.92,
      "end_seconds": 20.73,
      "duration_seconds": 1.81,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.15,
      "end_seconds": 26.99,
      "duration_seconds": 5.84,
      "text": "It's been going on for three weeks. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.55,
      "end_seconds": 31.0,
      "duration_seconds": 3.45,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.51,
      "end_seconds": 33.86,
      "duration_seconds": 1.35,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 38.29,
      "duration_seconds": 3.54,
      "text": "Okay, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.87,
      "end_seconds": 43.25,
      "duration_seconds": 3.38,
      "text": "It usually comes with dark marks after they heal."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.65,
      "end_seconds": 49.61,
      "duration_seconds": 4.96,
      "text": "Let me check a few things. Any new face cream or irregular periods?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.81,
      "end_seconds": 54.74,
      "duration_seconds": 3.93,
      "text": "No new face cream or irregular periods, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.44,
      "end_seconds": 56.43,
      "duration_seconds": 0.99,
      "text": "What about pregnancy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.02,
      "end_seconds": 59.5,
      "duration_seconds": 1.48,
      "text": "No, no pregnancy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.03,
      "end_seconds": 66.53,
      "duration_seconds": 3.5,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.73,
      "end_seconds": 70.49,
      "duration_seconds": 2.76,
      "text": "Oh, yes, ibuprofen. I get stomach pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.47,
      "end_seconds": 73.88,
      "duration_seconds": 2.41,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.28,
      "end_seconds": 75.07,
      "duration_seconds": 0.79,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 86.07,
      "duration_seconds": 4.02,
      "text": "Okay, here we go. Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.63,
      "end_seconds": 94.81,
      "duration_seconds": 7.18,
      "text": "I take telmisartan, 40 milligrams, once a day. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.98,
      "end_seconds": 103.85,
      "duration_seconds": 5.87,
      "text": "Any long-term health problems I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.62,
      "end_seconds": 108.31,
      "duration_seconds": 3.69,
      "text": "I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.75,
      "end_seconds": 112.24,
      "duration_seconds": 3.49,
      "text": "Alright. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.29,
      "end_seconds": 123.59,
      "duration_seconds": 10.3,
      "text": "Oh, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.65,
      "end_seconds": 127.47,
      "duration_seconds": 2.82,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.29,
      "end_seconds": 141.07,
      "duration_seconds": 1.78,
      "text": "Alright, just relax your arm..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 158.9,
      "duration_seconds": 6.63,
      "text": "Okay: pulse is 74 beats a minute, respiratory rate 18, BP is 119 over 78, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.41,
      "end_seconds": 161.05,
      "duration_seconds": 1.64,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.93,
      "end_seconds": 164.6,
      "duration_seconds": 2.67,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.15,
      "end_seconds": 169.59,
      "duration_seconds": 2.44,
      "text": "Alright, can I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.79,
      "end_seconds": 172.27,
      "duration_seconds": 1.48,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 194.22,
      "duration_seconds": 5.98,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.16,
      "end_seconds": 214.61,
      "duration_seconds": 14.45,
      "text": "All done, thank you, please sit down. Okay, so my impression is this: I think we're dealing with moderate acne at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.78,
      "end_seconds": 218.47,
      "duration_seconds": 2.69,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.92,
      "end_seconds": 231.96,
      "duration_seconds": 12.04,
      "text": "Nothing I've seen today points to an emergency. It looks like moderate acne. Let me just recap so I've got it right. You've had acne for three weeks, moderate, and no pregnancy or irregular periods."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.75,
      "end_seconds": 233.99,
      "duration_seconds": 1.24,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.64,
      "end_seconds": 246.59,
      "duration_seconds": 7.95,
      "text": "I'll start you on adapalene gel, at night, for eight weeks. That's for acne. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.07,
      "end_seconds": 251.29,
      "duration_seconds": 3.22,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.4,
      "end_seconds": 265.7,
      "duration_seconds": 13.3,
      "text": "It takes six to eight weeks to see the difference, so please don't give up in the first fortnight. Don't squeeze them, that's how the marks stay. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.05,
      "end_seconds": 273.65,
      "duration_seconds": 7.6,
      "text": "Mm-hm. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.68,
      "end_seconds": 276.27,
      "duration_seconds": 1.59,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.34,
      "end_seconds": 280.5,
      "duration_seconds": 3.16,
      "text": "I'd like to see you again in eight weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.04,
      "end_seconds": 285.92,
      "duration_seconds": 3.88,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.14,
      "end_seconds": 292.77,
      "duration_seconds": 5.63,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.09,
      "end_seconds": 301.16,
      "duration_seconds": 8.07,
      "text": "So, um, I take the adapalene gel, at night and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.64,
      "end_seconds": 305.42,
      "duration_seconds": 3.78,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.01,
      "end_seconds": 311.93,
      "duration_seconds": 1.92,
      "text": "I appreciate your time, doctor."
    }
  ]
}