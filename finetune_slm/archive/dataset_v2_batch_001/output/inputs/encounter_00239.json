{
  "schema_version": "1.0",
  "encounter_id": "00239",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.7,
      "duration_seconds": 3.51,
      "text": "Uh, hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.16,
      "end_seconds": 9.26,
      "duration_seconds": 4.1,
      "text": "Right, that's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.58,
      "end_seconds": 16.16,
      "duration_seconds": 5.58,
      "text": "I mean, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.75,
      "end_seconds": 20.44,
      "duration_seconds": 2.69,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.11,
      "end_seconds": 25.89,
      "duration_seconds": 4.78,
      "text": "Oh, we came because of tightness in my chest when I walk."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.77,
      "end_seconds": 31.22,
      "duration_seconds": 4.45,
      "text": "How long have you had it? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.92,
      "end_seconds": 40.39,
      "duration_seconds": 8.47,
      "text": "It's been four weeks, I'm fairly sure. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.82,
      "end_seconds": 44.12,
      "duration_seconds": 3.3,
      "text": "I see. What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.74,
      "end_seconds": 50.38,
      "duration_seconds": 2.64,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.38,
      "end_seconds": 54.71,
      "duration_seconds": 3.33,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.93,
      "end_seconds": 59.59,
      "duration_seconds": 3.66,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.8,
      "end_seconds": 63.12,
      "duration_seconds": 2.32,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.53,
      "end_seconds": 81.42,
      "duration_seconds": 16.89,
      "text": "It's worse with walking fast. Oh, and a heavy feeling in the left arm. With heavy feeling in the left arm, pretty severe, if I'm being honest. I get some relief from resting. There's tiredness as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.18,
      "end_seconds": 85.99,
      "duration_seconds": 3.81,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.46,
      "end_seconds": 89.38,
      "duration_seconds": 1.92,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 93.05,
      "duration_seconds": 2.92,
      "text": "Have you had any cough, fainting or palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.45,
      "end_seconds": 96.96,
      "duration_seconds": 3.51,
      "text": "I mean, no, no cough, fainting or palpitations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.18,
      "end_seconds": 103.75,
      "duration_seconds": 2.57,
      "text": "Have you had any swelling in the ankles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.27,
      "end_seconds": 108.92,
      "duration_seconds": 3.65,
      "text": "No, uh, no swelling in the ankles."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.45,
      "end_seconds": 114.21,
      "duration_seconds": 3.76,
      "text": "So, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.78,
      "end_seconds": 117.45,
      "duration_seconds": 1.67,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.77,
      "end_seconds": 119.93,
      "duration_seconds": 2.16,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.18,
      "end_seconds": 125.67,
      "duration_seconds": 4.49,
      "text": "Sulfa drugs. I come out in... well, itching all over."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.99,
      "end_seconds": 130.68,
      "duration_seconds": 4.69,
      "text": "Are you on any tablets or medication? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 131.34,
      "end_seconds": 136.1,
      "duration_seconds": 4.76,
      "text": "He takes losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.12,
      "end_seconds": 139.0,
      "duration_seconds": 1.88,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.89,
      "end_seconds": 156.22,
      "duration_seconds": 16.33,
      "text": "Oh, you know, just a bypass operation, six years ago. I'd rather not end up on lots of tablets if I can avoid it. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.98,
      "end_seconds": 160.89,
      "duration_seconds": 3.91,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.77,
      "end_seconds": 162.52,
      "duration_seconds": 0.75,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.04,
      "end_seconds": 179.57,
      "duration_seconds": 8.53,
      "text": "Okay, here we go. What about your general health, any conditions you're being treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.52,
      "end_seconds": 196.74,
      "duration_seconds": 13.22,
      "text": "Yes, high blood pressure. I didn't want to make a fuss, you know. I'd rather know what's going on than keep guessing. I've got heart disease. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.34,
      "end_seconds": 205.51,
      "duration_seconds": 8.17,
      "text": "Right, so that's your known heart disease. We'll keep that in mind today. Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.55,
      "end_seconds": 209.68,
      "duration_seconds": 3.13,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.7,
      "end_seconds": 212.4,
      "duration_seconds": 1.7,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.38,
      "end_seconds": 214.08,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.06,
      "end_seconds": 216.66,
      "duration_seconds": 1.6,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.25,
      "end_seconds": 238.08,
      "duration_seconds": 3.83,
      "text": "Lungs are clear and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.03,
      "end_seconds": 241.72,
      "duration_seconds": 1.69,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.96,
      "end_seconds": 260.1,
      "duration_seconds": 2.14,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.34,
      "end_seconds": 262.04,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.3,
      "end_seconds": 283.34,
      "duration_seconds": 19.04,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Right, here's what I'm thinking. This looks most like angina-type chest pain. I can't rule out a musculoskeletal cause yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.77,
      "end_seconds": 288.86,
      "duration_seconds": 5.09,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.65,
      "end_seconds": 303.97,
      "duration_seconds": 14.32,
      "text": "I can't promise yet, but most people with angina-type chest pain do well once it's treated properly. Let me just recap so I've got it right. You've had tightness in your chest when you walk for four weeks, and no palpitations or fainting."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.65,
      "end_seconds": 305.95,
      "duration_seconds": 1.3,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.32,
      "end_seconds": 309.66,
      "duration_seconds": 3.34,
      "text": "I'm going to order an ECG, for chest tightness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.97,
      "end_seconds": 310.96,
      "duration_seconds": 0.99,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.11,
      "end_seconds": 340.91,
      "duration_seconds": 25.8,
      "text": "Let's get a lipid profile, for cardiovascular risk. The result will help us decide whether anything more is needed. I'd like you to take atorvastatin, 40 milligrams, at night, long term. That should help with cardiovascular risk. The pharmacy will go through the details again when you pick it up. Let's use GTN spray, 0.4 milligrams, when the chest tightness comes, as needed. It's for chest tightness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.32,
      "end_seconds": 343.21,
      "duration_seconds": 0.89,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.75,
      "end_seconds": 366.88,
      "duration_seconds": 22.13,
      "text": "Don't push through the chest tightness, stop, sit down, and use the spray if I've given it to you. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Don't skip meals, and try to eat smaller portions more often through the day. I'd like you to see a cardiologist as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.91,
      "end_seconds": 377.17,
      "duration_seconds": 9.26,
      "text": "Please don't sit on it if the chest tightness comes at rest or lasts more than fifteen minutes. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.53,
      "end_seconds": 379.73,
      "duration_seconds": 2.2,
      "text": "Well, got it, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.1,
      "end_seconds": 388.63,
      "duration_seconds": 8.53,
      "text": "Please come and see me in two weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.86,
      "end_seconds": 401.19,
      "duration_seconds": 11.33,
      "text": "So, you know, I take the atorvastatin, 40 milligrams, at night and take the GTN spray, 0.4 milligrams, when the chest tightness comes. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.78,
      "end_seconds": 404.35,
      "duration_seconds": 2.57,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.24,
      "end_seconds": 407.61,
      "duration_seconds": 2.37,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.48,
      "end_seconds": 409.23,
      "duration_seconds": 0.75,
      "text": "Alright, goodbye."
    }
  ]
}