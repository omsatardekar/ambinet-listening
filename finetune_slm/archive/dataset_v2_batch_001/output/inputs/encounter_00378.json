{
  "schema_version": "1.0",
  "encounter_id": "00378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 6.85,
      "duration_seconds": 5.62,
      "text": "Right, um, hi there, is it alright if I come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.42,
      "end_seconds": 12.18,
      "duration_seconds": 3.76,
      "text": "Right, yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.76,
      "end_seconds": 17.9,
      "duration_seconds": 4.14,
      "text": "Uh, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.24,
      "end_seconds": 20.49,
      "duration_seconds": 2.25,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.8,
      "end_seconds": 23.7,
      "duration_seconds": 2.9,
      "text": "I'm here because of tingling in my fingers."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.73,
      "end_seconds": 28.14,
      "duration_seconds": 3.41,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.46,
      "end_seconds": 37.96,
      "duration_seconds": 9.5,
      "text": "It's been going on for two months. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.42,
      "end_seconds": 41.31,
      "duration_seconds": 1.89,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.71,
      "end_seconds": 52.33,
      "duration_seconds": 9.62,
      "text": "I'd give it a seven, you know, out of ten. Oh, and numbness in the thumb and first two fingers. Had that since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.91,
      "end_seconds": 56.55,
      "duration_seconds": 3.64,
      "text": "What about a weak grip, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.75,
      "end_seconds": 60.85,
      "duration_seconds": 3.1,
      "text": "Yes, about the same, about three months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.2,
      "end_seconds": 67.31,
      "duration_seconds": 5.11,
      "text": "Okay, have you had tingling in your fingers before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.67,
      "end_seconds": 73.62,
      "duration_seconds": 4.95,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 77.97,
      "duration_seconds": 3.24,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.46,
      "end_seconds": 90.91,
      "duration_seconds": 2.45,
      "text": "Right, carry on. What about neck pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.84,
      "end_seconds": 93.62,
      "duration_seconds": 1.78,
      "text": "No. No neck pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.2,
      "end_seconds": 98.71,
      "duration_seconds": 4.51,
      "text": "Have you had any weakness in the legs, bladder problems or trouble walking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.27,
      "end_seconds": 102.52,
      "duration_seconds": 3.25,
      "text": "Right, no, none of that at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.0,
      "end_seconds": 103.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.33,
      "end_seconds": 108.58,
      "duration_seconds": 4.25,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 109.95,
      "duration_seconds": 0.78,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.5,
      "end_seconds": 128.75,
      "duration_seconds": 4.25,
      "text": "Alright, I've got it. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.2,
      "end_seconds": 132.16,
      "duration_seconds": 1.96,
      "text": "I take glimepiride, before breakfast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.4,
      "end_seconds": 135.07,
      "duration_seconds": 1.67,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.27,
      "end_seconds": 139.01,
      "duration_seconds": 2.74,
      "text": "2 milligrams. Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.42,
      "end_seconds": 142.62,
      "duration_seconds": 3.2,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.6,
      "end_seconds": 147.75,
      "duration_seconds": 4.15,
      "text": "I mean, you know, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.09,
      "end_seconds": 150.65,
      "duration_seconds": 2.56,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.09,
      "end_seconds": 155.06,
      "duration_seconds": 3.97,
      "text": "Yes, diabetes. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 161.3,
      "duration_seconds": 4.78,
      "text": "I see. Right, so that's your known diabetes. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.58,
      "end_seconds": 164.86,
      "duration_seconds": 2.28,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 166.17,
      "duration_seconds": 0.81,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.63,
      "end_seconds": 180.44,
      "duration_seconds": 3.81,
      "text": "Okay, here we go. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.94,
      "end_seconds": 182.76,
      "duration_seconds": 0.82,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.98,
      "end_seconds": 187.26,
      "duration_seconds": 3.28,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.8,
      "end_seconds": 201.2,
      "duration_seconds": 12.4,
      "text": "Uh, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 202.66,
      "duration_seconds": 1.15,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.01,
      "end_seconds": 206.22,
      "duration_seconds": 2.21,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.09,
      "end_seconds": 209.25,
      "duration_seconds": 2.16,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 224.63,
      "duration_seconds": 1.4,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.9,
      "end_seconds": 249.5,
      "duration_seconds": 7.6,
      "text": "Okay: heart rate 78, BP is 110 over 69. And oxygen saturation is 98 percent, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.4,
      "end_seconds": 253.09,
      "duration_seconds": 2.69,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.34,
      "end_seconds": 256.87,
      "duration_seconds": 2.53,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.28,
      "end_seconds": 263.7,
      "duration_seconds": 4.42,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.49,
      "end_seconds": 267.7,
      "duration_seconds": 2.21,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.42,
      "end_seconds": 288.94,
      "duration_seconds": 2.52,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.94,
      "end_seconds": 291.65,
      "duration_seconds": 1.71,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.26,
      "end_seconds": 305.74,
      "duration_seconds": 2.48,
      "text": "Power in the thumb is slightly reduced."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.42,
      "end_seconds": 332.39,
      "duration_seconds": 21.97,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Right, here's what I'm thinking. My working impression is carpal tunnel syndrome. That's my thinking for now, and it may change as we learn more. It could also be diabetic neuropathy, so we'll keep that open."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.41,
      "end_seconds": 339.04,
      "duration_seconds": 2.63,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.93,
      "end_seconds": 357.37,
      "duration_seconds": 17.44,
      "text": "Nothing I've seen today points to an emergency. It looks like carpal tunnel syndrome, but I'd like to confirm. Let me just recap so I've got it right. You've had tingling in your fingers for two months, and no trouble walking or weakness in the legs."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.11,
      "end_seconds": 359.82,
      "duration_seconds": 1.71,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.75,
      "end_seconds": 372.57,
      "duration_seconds": 11.82,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.12,
      "end_seconds": 374.97,
      "duration_seconds": 1.85,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.44,
      "end_seconds": 383.38,
      "duration_seconds": 7.94,
      "text": "I'm going to order a blood sugar test, for neuropathy screen. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.52,
      "end_seconds": 385.87,
      "duration_seconds": 1.35,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.12,
      "end_seconds": 410.07,
      "duration_seconds": 22.95,
      "text": "I'd like to arrange a nerve conduction study for hand numbness. Take short breaks from typing and keep the wrist straight. A night wrist splint, kept neutral, usually helps a lot. A short walk every day, even twenty minutes, will help more than you'd think. Please take the tablets with food so they don't upset your stomach. I'll also refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.44,
      "end_seconds": 412.73,
      "duration_seconds": 1.29,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.94,
      "end_seconds": 421.51,
      "duration_seconds": 7.57,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.64,
      "end_seconds": 426.0,
      "duration_seconds": 3.36,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.36,
      "end_seconds": 433.23,
      "duration_seconds": 5.87,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.81,
      "end_seconds": 439.91,
      "duration_seconds": 5.1,
      "text": "So, uh, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.54,
      "end_seconds": 445.18,
      "duration_seconds": 4.64,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.42,
      "end_seconds": 449.71,
      "duration_seconds": 3.29,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}