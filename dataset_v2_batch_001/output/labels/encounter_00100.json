        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Have you found anything that eases it?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
