      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's been three weeks now.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:30",
