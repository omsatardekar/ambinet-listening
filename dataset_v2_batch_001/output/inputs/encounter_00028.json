{
  "schema_version": "1.0",
  "encounter_id": "00028",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 1.94,
      "duration_seconds": 0.99,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.73,
      "end_seconds": 5.73,
      "duration_seconds": 3.0,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.16,
      "end_seconds": 11.82,
      "duration_seconds": 5.66,
      "text": "Hmm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.1,
      "end_seconds": 15.83,
      "duration_seconds": 2.73,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.3,
      "end_seconds": 17.98,
      "duration_seconds": 1.68,
      "text": "I've been feeling lightheaded."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.49,
      "end_seconds": 21.75,
      "duration_seconds": 2.26,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.75,
      "end_seconds": 25.17,
      "duration_seconds": 2.42,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.67,
      "end_seconds": 30.85,
      "duration_seconds": 5.18,
      "text": "I see. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.87,
      "end_seconds": 40.73,
      "duration_seconds": 8.86,
      "text": "It's worse with standing up and hot weather. It happens a couple of times a week. It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 46.64,
      "duration_seconds": 2.49,
      "text": "Have you had a pounding in the head?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.0,
      "end_seconds": 54.38,
      "duration_seconds": 3.38,
      "text": "Um, yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.91,
      "end_seconds": 58.86,
      "duration_seconds": 3.95,
      "text": "Right. Okay, any vomiting, chest pain, slurred speech or weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.22,
      "end_seconds": 62.44,
      "duration_seconds": 2.22,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.2,
      "end_seconds": 66.06,
      "duration_seconds": 2.86,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.49,
      "end_seconds": 81.38,
      "duration_seconds": 13.89,
      "text": "Uh, uh, it's losartan, 50 milligrams, once a day for my blood pressure. Oh, uh, it's metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 83.9,
      "duration_seconds": 2.19,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.24,
      "end_seconds": 92.57,
      "duration_seconds": 8.33,
      "text": "Just a hernia repair, about five years back. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.43,
      "end_seconds": 97.76,
      "duration_seconds": 4.33,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.33,
      "end_seconds": 100.74,
      "duration_seconds": 1.41,
      "text": "Peanuts, I'd say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.95,
      "end_seconds": 104.68,
      "duration_seconds": 2.73,
      "text": "Okay, does anything run in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.8,
      "end_seconds": 109.04,
      "duration_seconds": 3.24,
      "text": "Yeah, um, my mother has migraines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 113.19,
      "duration_seconds": 2.97,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.68,
      "end_seconds": 121.71,
      "duration_seconds": 8.03,
      "text": "High blood pressure, for nearly five years. Yes, diabetes. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.21,
      "end_seconds": 127.95,
      "duration_seconds": 5.74,
      "text": "Right, so that's your known high blood pressure. We'll keep that in mind today. How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.5,
      "end_seconds": 134.95,
      "duration_seconds": 3.45,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.5,
      "end_seconds": 137.91,
      "duration_seconds": 1.41,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.45,
      "end_seconds": 143.31,
      "duration_seconds": 3.86,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.6,
      "end_seconds": 146.51,
      "duration_seconds": 1.91,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.86,
      "end_seconds": 155.66,
      "duration_seconds": 1.8,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.54,
      "end_seconds": 177.58,
      "duration_seconds": 8.04,
      "text": "Okay: pressure 92 over 61, oxygen saturation is 99 percent, pulse is 105 beats a minute. And respiratory rate 17."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.55,
      "end_seconds": 182.65,
      "duration_seconds": 3.1,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.0,
      "end_seconds": 184.7,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.56,
      "end_seconds": 188.01,
      "duration_seconds": 2.45,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.29,
      "end_seconds": 208.03,
      "duration_seconds": 3.74,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.46,
      "end_seconds": 212.76,
      "duration_seconds": 3.3,
      "text": "So, turn your head to the side for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.9,
      "end_seconds": 228.24,
      "duration_seconds": 1.34,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.03,
      "end_seconds": 242.12,
      "duration_seconds": 9.09,
      "text": "That's fine, you can get dressed. Putting it all together, this looks most like postural low blood pressure. It could also be dehydration, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.46,
      "end_seconds": 246.94,
      "duration_seconds": 2.48,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 258.14,
      "duration_seconds": 10.17,
      "text": "Nothing I've seen today points to an emergency. It looks like postural low blood pressure, but I'd like to confirm. We should do an ECG for dizziness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.36,
      "end_seconds": 264.8,
      "duration_seconds": 3.44,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.57,
      "end_seconds": 290.58,
      "duration_seconds": 25.01,
      "text": "Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. Cut down on salt and fried food for now, it really does make a difference. Don't skip meals, and try to eat smaller portions more often through the day. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.53,
      "end_seconds": 292.87,
      "duration_seconds": 1.34,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.55,
      "end_seconds": 297.92,
      "duration_seconds": 4.37,
      "text": "Come back in two weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.46,
      "end_seconds": 303.18,
      "duration_seconds": 2.72,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.56,
      "end_seconds": 305.4,
      "duration_seconds": 0.84,
      "text": "Alright, goodbye."
    }
  ]
}