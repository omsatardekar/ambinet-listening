{
  "schema_version": "1.0",
  "encounter_id": "00006",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 4.39,
      "duration_seconds": 3.86,
      "text": "Hello. Right, let's get started. Right, lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.37,
      "end_seconds": 9.41,
      "duration_seconds": 4.04,
      "text": "It, It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.44,
      "end_seconds": 12.48,
      "duration_seconds": 2.04,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 18.3,
      "duration_seconds": 4.51,
      "text": "So, I've been putting on weight over the last year, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 21.78,
      "duration_seconds": 2.66,
      "text": "So, how long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.63,
      "end_seconds": 29.91,
      "duration_seconds": 7.28,
      "text": "It's been four weeks now. I've also been feeling sleepy in the day, for about three months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.38,
      "end_seconds": 33.13,
      "duration_seconds": 2.75,
      "text": "Any irregular periods or low mood at all?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.68,
      "end_seconds": 35.27,
      "duration_seconds": 1.59,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.29,
      "end_seconds": 38.06,
      "duration_seconds": 1.77,
      "text": "Any heat intolerance or palpitations?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.03,
      "end_seconds": 41.3,
      "duration_seconds": 2.27,
      "text": "No, no heat intolerance or palpitations."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.84,
      "end_seconds": 45.47,
      "duration_seconds": 2.63,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.98,
      "end_seconds": 48.56,
      "duration_seconds": 1.58,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.69,
      "end_seconds": 54.96,
      "duration_seconds": 5.27,
      "text": "Any long-term health problems I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.4,
      "end_seconds": 60.8,
      "duration_seconds": 1.4,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.27,
      "end_seconds": 62.97,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.55,
      "end_seconds": 68.73,
      "duration_seconds": 2.18,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.26,
      "end_seconds": 73.09,
      "duration_seconds": 2.83,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.73,
      "end_seconds": 86.05,
      "duration_seconds": 12.32,
      "text": "Yeah, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.54,
      "end_seconds": 92.9,
      "duration_seconds": 5.36,
      "text": "Any allergies I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.47,
      "end_seconds": 97.23,
      "duration_seconds": 2.76,
      "text": "Right, yes, I'm allergic to sulfa drugs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.39,
      "end_seconds": 109.47,
      "duration_seconds": 11.08,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.49,
      "end_seconds": 112.25,
      "duration_seconds": 1.76,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.85,
      "end_seconds": 114.7,
      "duration_seconds": 1.85,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.31,
      "end_seconds": 120.24,
      "duration_seconds": 4.93,
      "text": "Atorvastatin. I take it 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.29,
      "end_seconds": 123.94,
      "duration_seconds": 2.65,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.55,
      "end_seconds": 133.25,
      "duration_seconds": 8.7,
      "text": "Not with me. I'll bring it next time. I take telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.89,
      "end_seconds": 136.31,
      "duration_seconds": 2.42,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.18,
      "end_seconds": 138.46,
      "duration_seconds": 1.28,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.55,
      "end_seconds": 141.85,
      "duration_seconds": 2.3,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.74,
      "end_seconds": 145.1,
      "duration_seconds": 2.36,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.59,
      "end_seconds": 155.57,
      "duration_seconds": 2.98,
      "text": "Okay, here we go. Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.05,
      "end_seconds": 158.99,
      "duration_seconds": 1.94,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.35,
      "end_seconds": 161.29,
      "duration_seconds": 1.94,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.81,
      "end_seconds": 167.32,
      "duration_seconds": 5.51,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.47,
      "end_seconds": 169.45,
      "duration_seconds": 0.98,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.46,
      "end_seconds": 171.79,
      "duration_seconds": 1.33,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.9,
      "end_seconds": 178.21,
      "duration_seconds": 5.31,
      "text": "Just to be sure I've got this right, the telmisartan, what dose was that again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.59,
      "end_seconds": 180.66,
      "duration_seconds": 2.07,
      "text": "40 milligrams, like I said."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.55,
      "end_seconds": 184.58,
      "duration_seconds": 3.03,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.49,
      "end_seconds": 196.19,
      "duration_seconds": 1.7,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.1,
      "end_seconds": 224.75,
      "duration_seconds": 12.65,
      "text": "Okay: blood pressure 117 over 68, SpO2 97 percent on room air. And weight 84 kilos, temp 36.9 degrees, pulse 70, BMI works out to 29.8, height 168 centimetres."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.17,
      "end_seconds": 230.34,
      "duration_seconds": 3.17,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.68,
      "end_seconds": 231.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.97,
      "end_seconds": 234.27,
      "duration_seconds": 1.3,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.81,
      "end_seconds": 256.11,
      "duration_seconds": 3.3,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 274.22,
      "duration_seconds": 13.9,
      "text": "All done, thank you, please sit down. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.93,
      "end_seconds": 287.12,
      "duration_seconds": 12.19,
      "text": "Uh, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.92,
      "end_seconds": 299.23,
      "duration_seconds": 11.31,
      "text": "Okay, so my impression is this: My working impression is weight gain with a metabolic cause that needs checking. It could also be sleep apnoea, so we'll keep that open."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.62,
      "end_seconds": 302.0,
      "duration_seconds": 2.38,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.27,
      "end_seconds": 322.93,
      "duration_seconds": 19.66,
      "text": "I understand the worry. At the moment I'd say it's weight gain with a metabolic cause that needs checking, and we'll know more once the an HbA1c is back. Let me just recap so I've got it right. You've been putting on weight over the last year for four weeks, and no heat intolerance or irregular periods."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.51,
      "end_seconds": 325.75,
      "duration_seconds": 2.24,
      "text": "Yes, you know, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.92,
      "end_seconds": 329.68,
      "duration_seconds": 2.76,
      "text": "So, I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.38,
      "end_seconds": 331.15,
      "duration_seconds": 0.77,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.33,
      "end_seconds": 365.49,
      "duration_seconds": 26.16,
      "text": "Okay, here we go. We should do an HbA1c for weight gain. The result will help us decide whether anything more is needed. Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. Cut down on salt and fried food for now, it really does make a difference. Please take the tablets with food so they don't upset your stomach. I'll also refer you to a dietitian."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.49,
      "end_seconds": 367.79,
      "duration_seconds": 1.3,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.2,
      "end_seconds": 376.5,
      "duration_seconds": 7.3,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.04,
      "end_seconds": 379.34,
      "duration_seconds": 1.3,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.41,
      "end_seconds": 386.68,
      "duration_seconds": 6.27,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.14,
      "end_seconds": 389.91,
      "duration_seconds": 1.77,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.38,
      "end_seconds": 396.89,
      "duration_seconds": 6.51,
      "text": "Come back after the results are back. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.36,
      "end_seconds": 402.81,
      "duration_seconds": 4.45,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.73,
      "end_seconds": 409.19,
      "duration_seconds": 5.46,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 409.71,
      "end_seconds": 412.05,
      "duration_seconds": 2.34,
      "text": "I appreciate your time, doctor."
    }
  ]
}