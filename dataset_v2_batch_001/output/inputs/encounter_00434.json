{
  "schema_version": "1.0",
  "encounter_id": "00434",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.26,
      "duration_seconds": 3.42,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.05,
      "end_seconds": 8.81,
      "duration_seconds": 3.76,
      "text": "So, no trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.34,
      "end_seconds": 14.98,
      "duration_seconds": 4.64,
      "text": "So, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.05,
      "end_seconds": 21.81,
      "duration_seconds": 3.76,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.53,
      "end_seconds": 28.12,
      "duration_seconds": 5.59,
      "text": "Oh, uh, doctor, it's constant tiredness. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 31.45,
      "duration_seconds": 2.17,
      "text": "Alright, does anything make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.98,
      "end_seconds": 38.01,
      "duration_seconds": 5.03,
      "text": "Um, only a good night's sleep, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.78,
      "end_seconds": 44.03,
      "duration_seconds": 5.25,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 44.13,
      "end_seconds": 49.66,
      "duration_seconds": 5.53,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.67,
      "end_seconds": 55.7,
      "duration_seconds": 5.03,
      "text": "Later, thanks. Please go on. Have you had a bit of weight gain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.01,
      "end_seconds": 57.08,
      "duration_seconds": 1.07,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.47,
      "end_seconds": 59.12,
      "duration_seconds": 1.65,
      "text": "Have you been feeling cold?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.99,
      "end_seconds": 60.93,
      "duration_seconds": 0.94,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.48,
      "end_seconds": 65.33,
      "duration_seconds": 3.85,
      "text": "Have you had constant tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.91,
      "end_seconds": 72.66,
      "duration_seconds": 5.75,
      "text": "Okay, so I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.33,
      "end_seconds": 77.68,
      "duration_seconds": 4.35,
      "text": "Have you had any night sweats, fever, low mood or shortness of breath?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.48,
      "end_seconds": 89.9,
      "duration_seconds": 11.42,
      "text": "No, no night sweats, no fever, no low mood. I did have hair falling out at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 92.27,
      "duration_seconds": 1.68,
      "text": "Any blood in the stool?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.81,
      "end_seconds": 96.55,
      "duration_seconds": 2.74,
      "text": "No. No blood in the stool."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.57,
      "end_seconds": 100.55,
      "duration_seconds": 2.98,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.45,
      "end_seconds": 104.29,
      "duration_seconds": 2.84,
      "text": "No, um, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.55,
      "end_seconds": 107.27,
      "duration_seconds": 1.72,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.67,
      "end_seconds": 110.46,
      "duration_seconds": 1.79,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 110.98,
      "end_seconds": 120.75,
      "duration_seconds": 9.77,
      "text": "Doctor, I've got the readings for you. Temperature 36.6, respiratory rate 18, oxygen saturation is 99 percent. BP is 121 over 73, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.29,
      "end_seconds": 123.78,
      "duration_seconds": 1.49,
      "text": "Okay, noted. Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.11,
      "end_seconds": 128.02,
      "duration_seconds": 2.91,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.98,
      "end_seconds": 132.55,
      "duration_seconds": 3.57,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.79,
      "end_seconds": 140.23,
      "duration_seconds": 6.44,
      "text": "Oh, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.34,
      "end_seconds": 144.15,
      "duration_seconds": 2.81,
      "text": "Right, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.64,
      "end_seconds": 160.68,
      "duration_seconds": 12.04,
      "text": "For my sugar, I believe. My daughter sets them out for me, I just take what I'm given. Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.89,
      "end_seconds": 164.23,
      "duration_seconds": 2.34,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.26,
      "end_seconds": 166.64,
      "duration_seconds": 1.38,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.87,
      "end_seconds": 168.1,
      "duration_seconds": 1.23,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.65,
      "end_seconds": 174.1,
      "duration_seconds": 4.45,
      "text": "Yeah, I was on glimepiride before. I stopped taking it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.7,
      "end_seconds": 176.63,
      "duration_seconds": 1.93,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.98,
      "end_seconds": 184.48,
      "duration_seconds": 6.5,
      "text": "Just my gallbladder removed, in 2016. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.67,
      "end_seconds": 189.06,
      "duration_seconds": 3.39,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.7,
      "end_seconds": 192.27,
      "duration_seconds": 2.57,
      "text": "Right, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.56,
      "end_seconds": 195.78,
      "duration_seconds": 2.22,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.36,
      "end_seconds": 208.61,
      "duration_seconds": 11.25,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.82,
      "end_seconds": 212.44,
      "duration_seconds": 2.62,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.99,
      "end_seconds": 213.85,
      "duration_seconds": 0.86,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.64,
      "end_seconds": 235.65,
      "duration_seconds": 7.01,
      "text": "Alright, I've got it. Any long-term health problems I should know about? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.56,
      "end_seconds": 243.52,
      "duration_seconds": 6.96,
      "text": "I have diabetes. I just want to get back to normal, really. I've got an enlarged prostate."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.74,
      "end_seconds": 252.66,
      "duration_seconds": 7.92,
      "text": "Yes, I can see the diabetes in your file as well. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.7,
      "end_seconds": 255.9,
      "duration_seconds": 2.2,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.79,
      "end_seconds": 260.12,
      "duration_seconds": 2.33,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.27,
      "end_seconds": 264.12,
      "duration_seconds": 2.85,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.58,
      "end_seconds": 283.42,
      "duration_seconds": 3.84,
      "text": "Your thyroid isn't enlarged, I can't feel any lumps in your neck."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.32,
      "end_seconds": 285.02,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.66,
      "end_seconds": 289.21,
      "duration_seconds": 2.55,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.01,
      "end_seconds": 307.68,
      "duration_seconds": 2.67,
      "text": "You look a little pale in the eyelids."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.15,
      "end_seconds": 327.32,
      "duration_seconds": 14.17,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Okay, has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.06,
      "end_seconds": 345.64,
      "duration_seconds": 17.58,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.37,
      "end_seconds": 363.89,
      "duration_seconds": 17.52,
      "text": "Right, here's what I'm thinking. It fits best with fatigue with no clear cause yet. It could also be an underactive thyroid, so we'll keep that open. Let me just recap so I've got it right. You've had constant tiredness, and no blood in the stool or shortness of breath."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.49,
      "end_seconds": 367.47,
      "duration_seconds": 1.98,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.13,
      "end_seconds": 380.28,
      "duration_seconds": 9.15,
      "text": "I'd like to arrange a vitamin B12 level for fatigue. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.64,
      "end_seconds": 385.56,
      "duration_seconds": 3.92,
      "text": "Hmm, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.55,
      "end_seconds": 389.23,
      "duration_seconds": 2.68,
      "text": "Let's get a thyroid test, for fatigue."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.42,
      "end_seconds": 392.37,
      "duration_seconds": 1.95,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.22,
      "end_seconds": 400.37,
      "duration_seconds": 7.15,
      "text": "We should do blood tests for fatigue. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.71,
      "end_seconds": 404.71,
      "duration_seconds": 1.0,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.46,
      "end_seconds": 408.79,
      "duration_seconds": 3.33,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.76,
      "end_seconds": 416.79,
      "duration_seconds": 7.03,
      "text": "I did have a ferritin level done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.36,
      "end_seconds": 442.04,
      "duration_seconds": 24.68,
      "text": "I'm prescribing vitamin D, 60000 units, once a week, for eight weeks. That's for low energy. I'll put all of this in writing so you don't have to remember it. Try to keep a regular sleep time and get some daylight in the morning. Please take the tablets with food so they don't upset your stomach. If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.43,
      "end_seconds": 443.13,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.21,
      "end_seconds": 449.88,
      "duration_seconds": 5.67,
      "text": "Come back in two weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.67,
      "end_seconds": 454.73,
      "duration_seconds": 4.06,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.43,
      "end_seconds": 459.29,
      "duration_seconds": 3.86,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 459.81,
      "end_seconds": 463.5,
      "duration_seconds": 3.69,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.07,
      "end_seconds": 464.84,
      "duration_seconds": 0.77,
      "text": "Take care."
    }
  ]
}