{
  "schema_version": "1.0",
  "encounter_id": "00417",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.64,
      "end_seconds": 3.04,
      "duration_seconds": 2.4,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.56,
      "end_seconds": 5.46,
      "duration_seconds": 0.9,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 8.51,
      "duration_seconds": 1.59,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.87,
      "end_seconds": 16.33,
      "duration_seconds": 6.46,
      "text": "Well, mainly wheezing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.42,
      "end_seconds": 20.94,
      "duration_seconds": 2.52,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.91,
      "end_seconds": 27.96,
      "duration_seconds": 6.05,
      "text": "About... well, about four days. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.49,
      "end_seconds": 32.68,
      "duration_seconds": 3.19,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.34,
      "end_seconds": 34.98,
      "duration_seconds": 1.64,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.63,
      "end_seconds": 37.96,
      "duration_seconds": 2.33,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.13,
      "end_seconds": 41.78,
      "duration_seconds": 2.65,
      "text": "I get some relief from the inhaler."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.12,
      "end_seconds": 44.05,
      "duration_seconds": 1.93,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.75,
      "end_seconds": 45.94,
      "duration_seconds": 1.19,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.41,
      "end_seconds": 49.76,
      "duration_seconds": 2.35,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.45,
      "end_seconds": 62.03,
      "duration_seconds": 11.58,
      "text": "Yeah, uh, when it starts I tend to get a tight chest as well. And I've been using my blue inhaler more as well. With tight chest, I'd say severe."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.54,
      "end_seconds": 66.09,
      "duration_seconds": 3.55,
      "text": "Any runny nose, leg swelling, fever or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.67,
      "end_seconds": 71.94,
      "duration_seconds": 5.27,
      "text": "No runny nose, leg swelling, fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.33,
      "end_seconds": 77.46,
      "duration_seconds": 1.13,
      "text": "Any weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.87,
      "end_seconds": 82.64,
      "duration_seconds": 3.77,
      "text": "Um, no, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.44,
      "end_seconds": 86.47,
      "duration_seconds": 3.03,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.66,
      "end_seconds": 89.66,
      "duration_seconds": 2.0,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.64,
      "end_seconds": 93.19,
      "duration_seconds": 2.55,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.64,
      "end_seconds": 94.46,
      "duration_seconds": 0.82,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 108.92,
      "duration_seconds": 2.45,
      "text": "Okay, here we go. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.47,
      "end_seconds": 111.42,
      "duration_seconds": 1.95,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.45,
      "end_seconds": 114.65,
      "duration_seconds": 2.2,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.54,
      "end_seconds": 117.27,
      "duration_seconds": 1.73,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.72,
      "end_seconds": 118.44,
      "duration_seconds": 0.72,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.7,
      "end_seconds": 120.84,
      "duration_seconds": 1.14,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.44,
      "end_seconds": 135.86,
      "duration_seconds": 14.42,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.95,
      "end_seconds": 140.31,
      "duration_seconds": 3.36,
      "text": "Uh, um, okay, that makes sense."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 145.78,
      "duration_seconds": 4.17,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.34,
      "end_seconds": 153.32,
      "duration_seconds": 5.98,
      "text": "I'm allergic to pollen, I get sneezing. Yes, shellfish, it gives me vomiting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.8,
      "end_seconds": 160.79,
      "duration_seconds": 6.99,
      "text": "Do you have any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 173.34,
      "duration_seconds": 12.2,
      "text": "Asthma, for nearly five years. I just want to get back to normal, really. My sister suggested writing things down, but I forgot. Yes, heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 175.04,
      "duration_seconds": 1.0,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.87,
      "end_seconds": 184.4,
      "duration_seconds": 8.53,
      "text": "Yes, I can see the asthma in your file as well. Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.99,
      "end_seconds": 199.89,
      "duration_seconds": 13.9,
      "text": "Yeah, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.31,
      "end_seconds": 204.68,
      "duration_seconds": 3.37,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.85,
      "end_seconds": 213.88,
      "duration_seconds": 8.03,
      "text": "I'm on Asthalin inhaler, when needed for my asthma. I'm on aspirin, 75 milligrams, maybe, once a day for my heart."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.22,
      "end_seconds": 218.44,
      "duration_seconds": 3.22,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.06,
      "end_seconds": 221.96,
      "duration_seconds": 2.9,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.67,
      "end_seconds": 225.05,
      "duration_seconds": 2.38,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.83,
      "end_seconds": 227.75,
      "duration_seconds": 1.92,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.47,
      "end_seconds": 242.15,
      "duration_seconds": 1.68,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 243.19,
      "end_seconds": 250.53,
      "duration_seconds": 7.34,
      "text": "Okay, so the vitals from earlier. Temperature 37.2, pressure 120 over 86, pulse 91, respiratory rate 25, saturation 89 percent."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 251.99,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 256.75,
      "duration_seconds": 2.08,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.41,
      "end_seconds": 258.66,
      "duration_seconds": 1.25,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.85,
      "end_seconds": 261.16,
      "duration_seconds": 1.31,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.72,
      "end_seconds": 279.74,
      "duration_seconds": 5.02,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.3,
      "end_seconds": 284.59,
      "duration_seconds": 3.29,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.62,
      "end_seconds": 301.4,
      "duration_seconds": 2.78,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.85,
      "end_seconds": 316.91,
      "duration_seconds": 12.06,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.27,
      "end_seconds": 319.46,
      "duration_seconds": 2.19,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.48,
      "end_seconds": 335.16,
      "duration_seconds": 14.68,
      "text": "From what you've told me and what I found, I think we're dealing with an asthma flare-up at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep an allergic reaction in mind."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.66,
      "end_seconds": 338.42,
      "duration_seconds": 1.76,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.26,
      "end_seconds": 359.25,
      "duration_seconds": 16.99,
      "text": "I understand the worry. At the moment I'd say it's an asthma flare-up, and we'll know more once the a peak flow reading is back. Let me just recap so I've got it right. You've had wheezing for about four days, moderate, and no weight loss or fever."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.98,
      "end_seconds": 361.25,
      "duration_seconds": 1.27,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.23,
      "end_seconds": 366.82,
      "duration_seconds": 4.59,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.0,
      "end_seconds": 370.71,
      "duration_seconds": 2.71,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 371.6,
      "end_seconds": 375.16,
      "duration_seconds": 3.56,
      "text": "I've already done a peak flow reading, it's ready for you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.54,
      "end_seconds": 391.48,
      "duration_seconds": 15.94,
      "text": "Good, thank you. We should do a chest X-ray for wheeze. Let's use prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That should help with asthma flare-up. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.7,
      "end_seconds": 393.65,
      "duration_seconds": 0.95,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.05,
      "end_seconds": 416.22,
      "duration_seconds": 21.17,
      "text": "Rinse your mouth after the steroid inhaler. Let me watch you use the inhaler, a lot of people don't get the full dose. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 417.37,
      "end_seconds": 419.41,
      "duration_seconds": 2.04,
      "text": "Okay, you know, I will."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.31,
      "end_seconds": 439.02,
      "duration_seconds": 18.71,
      "text": "Keep an eye out, and if the inhaler isn't helping or you can't speak in full sentences, call us the same day or go to emergency. I'd like to see you again in two weeks. I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 443.0,
      "end_seconds": 451.2,
      "duration_seconds": 8.2,
      "text": "So, I take the prednisolone, 30 milligrams, once a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 452.49,
      "end_seconds": 458.07,
      "duration_seconds": 5.58,
      "text": "Right, yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 459.18,
      "end_seconds": 462.0,
      "duration_seconds": 2.82,
      "text": "Uh, I appreciate your time, doctor."
    }
  ]
}