{
  "schema_version": "1.0",
  "encounter_id": "00244",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.03,
      "end_seconds": 5.78,
      "duration_seconds": 4.75,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.14,
      "end_seconds": 11.62,
      "duration_seconds": 4.48,
      "text": "So, great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.99,
      "end_seconds": 16.96,
      "duration_seconds": 4.97,
      "text": "Hmm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.67,
      "end_seconds": 22.69,
      "duration_seconds": 3.02,
      "text": "Alright, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.02,
      "end_seconds": 30.31,
      "duration_seconds": 6.29,
      "text": "Doctor, you know, it's breathlessness when I lie flat. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.71,
      "end_seconds": 33.61,
      "duration_seconds": 1.9,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.55,
      "end_seconds": 36.61,
      "duration_seconds": 2.06,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.0,
      "end_seconds": 44.12,
      "duration_seconds": 6.12,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.46,
      "end_seconds": 53.96,
      "duration_seconds": 9.5,
      "text": "Pretty mild, if I'm being honest. I notice it more with lying flat. Sorry, I know I'm rambling a bit. And tiredness, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.63,
      "end_seconds": 56.91,
      "duration_seconds": 2.28,
      "text": "Have you had swelling in both ankles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.67,
      "end_seconds": 59.36,
      "duration_seconds": 1.69,
      "text": "Yes, that started yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.69,
      "end_seconds": 63.57,
      "duration_seconds": 2.88,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 65.7,
      "duration_seconds": 1.5,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.99,
      "end_seconds": 68.62,
      "duration_seconds": 1.63,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.45,
      "end_seconds": 70.79,
      "duration_seconds": 1.34,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.15,
      "end_seconds": 76.11,
      "duration_seconds": 3.96,
      "text": "Okay, have you been waking up at night short of breath?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.81,
      "end_seconds": 86.95,
      "duration_seconds": 10.14,
      "text": "Yeah, I've had that since last weekend. Yeah, about waking up at night short of breath, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.3,
      "end_seconds": 94.66,
      "duration_seconds": 4.36,
      "text": "Have you had any calf pain, palpitations or coughing up blood?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.69,
      "end_seconds": 103.43,
      "duration_seconds": 4.74,
      "text": "No calf pain, palpitations or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.68,
      "end_seconds": 108.38,
      "duration_seconds": 0.7,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.81,
      "end_seconds": 110.95,
      "duration_seconds": 1.14,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 111.82,
      "end_seconds": 116.34,
      "duration_seconds": 4.52,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.74,
      "end_seconds": 122.95,
      "duration_seconds": 5.21,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.69,
      "end_seconds": 130.39,
      "duration_seconds": 6.7,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.98,
      "end_seconds": 132.55,
      "duration_seconds": 1.57,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.1,
      "end_seconds": 136.13,
      "duration_seconds": 3.03,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.6,
      "end_seconds": 138.5,
      "duration_seconds": 1.9,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.78,
      "end_seconds": 142.56,
      "duration_seconds": 2.78,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.93,
      "end_seconds": 159.13,
      "duration_seconds": 15.2,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.72,
      "end_seconds": 160.76,
      "duration_seconds": 1.04,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.28,
      "end_seconds": 173.86,
      "duration_seconds": 12.58,
      "text": "Yes, I had a stent put in my heart, two years ago. I thought it would sort itself out, but it hasn't. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.61,
      "end_seconds": 178.51,
      "duration_seconds": 3.9,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.97,
      "end_seconds": 185.1,
      "duration_seconds": 6.13,
      "text": "Dust. I come out in... well, itchy eyes. Yes, aspirin, it gives me wheezing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.26,
      "end_seconds": 187.23,
      "duration_seconds": 0.97,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.67,
      "end_seconds": 191.09,
      "duration_seconds": 3.42,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.61,
      "end_seconds": 192.65,
      "duration_seconds": 1.04,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.4,
      "end_seconds": 194.53,
      "duration_seconds": 1.13,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.87,
      "end_seconds": 201.76,
      "duration_seconds": 5.89,
      "text": "Do you have any medical conditions, anything you've been treated for? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.79,
      "end_seconds": 209.14,
      "duration_seconds": 6.35,
      "text": "I, I have high blood pressure. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.74,
      "end_seconds": 210.44,
      "duration_seconds": 0.7,
      "text": "I see."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.8,
      "end_seconds": 216.99,
      "duration_seconds": 6.19,
      "text": "I've got heart disease. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.2,
      "end_seconds": 223.48,
      "duration_seconds": 5.28,
      "text": "Okay, are you on any tablets or medication? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.86,
      "end_seconds": 231.58,
      "duration_seconds": 7.72,
      "text": "It's telmisartan, 40 milligrams, once a day for my pressure. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 231.9,
      "end_seconds": 238.77,
      "duration_seconds": 6.87,
      "text": "Doctor, I think the last prescription for the clopidogrel was 150 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.09,
      "end_seconds": 241.89,
      "duration_seconds": 2.8,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 243.31,
      "end_seconds": 245.76,
      "duration_seconds": 2.45,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 246.44,
      "end_seconds": 254.5,
      "duration_seconds": 8.06,
      "text": "Okay, so the vitals from earlier. Heart rate 104, SpO2 93 percent on room air, BP is 122 over 88. Respiratory rate 22."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.08,
      "end_seconds": 258.78,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 265.89,
      "duration_seconds": 4.41,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.86,
      "end_seconds": 268.47,
      "duration_seconds": 1.61,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.74,
      "end_seconds": 285.86,
      "duration_seconds": 3.12,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.85,
      "end_seconds": 289.6,
      "duration_seconds": 1.75,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.65,
      "end_seconds": 303.12,
      "duration_seconds": 1.47,
      "text": "Neck veins are raised."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.81,
      "end_seconds": 306.13,
      "duration_seconds": 1.32,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.66,
      "end_seconds": 326.21,
      "duration_seconds": 3.55,
      "text": "There's pitting oedema up to the shins on both legs."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.54,
      "end_seconds": 327.39,
      "duration_seconds": 0.85,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.62,
      "end_seconds": 344.68,
      "duration_seconds": 14.06,
      "text": "That's fine, you can get dressed. Okay, so my impression is this: This looks most like fluid overload related to the heart. That's my thinking for now, and it may change as we learn more. A chest infection is also on my list."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.14,
      "end_seconds": 348.73,
      "duration_seconds": 2.59,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.31,
      "end_seconds": 368.96,
      "duration_seconds": 16.65,
      "text": "It's reasonable to be concerned, but right now fluid overload related to the heart is my leading thought, not anything worse. Let me just recap so I've got it right. You've had breathlessness when you lie flat for about three months, mild, and no palpitations or calf pain."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.47,
      "end_seconds": 371.66,
      "duration_seconds": 1.19,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.22,
      "end_seconds": 387.79,
      "duration_seconds": 15.57,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.2,
      "end_seconds": 390.66,
      "duration_seconds": 2.46,
      "text": "Well, thank you, that really helps."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.72,
      "end_seconds": 395.03,
      "duration_seconds": 3.31,
      "text": "I'd like to arrange a chest X-ray for breathlessness."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 396.28,
      "end_seconds": 397.18,
      "duration_seconds": 0.9,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 397.9,
      "end_seconds": 402.88,
      "duration_seconds": 4.98,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.58,
      "end_seconds": 408.51,
      "duration_seconds": 4.93,
      "text": "Good, thank you. I'd like to arrange blood tests for heart failure review."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.13,
      "end_seconds": 412.14,
      "duration_seconds": 3.01,
      "text": "Oh, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.31,
      "end_seconds": 441.31,
      "duration_seconds": 28.0,
      "text": "I'll start you on furosemide, 40 milligrams, every morning, until we review. You take it by mouth. It's for fluid overload. I'll put all of this in writing so you don't have to remember it. Weigh yourself every morning, and tell us if you put on more than two kilos in a few days. Keep the salt and the fluids moderate, no more than about one and a half litres a day."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 442.29,
      "end_seconds": 461.66,
      "duration_seconds": 19.37,
      "text": "Don't skip meals, and try to eat smaller portions more often through the day. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 462.61,
      "end_seconds": 465.01,
      "duration_seconds": 2.4,
      "text": "Okay, uh, I will."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.68,
      "end_seconds": 473.21,
      "duration_seconds": 7.53,
      "text": "I want you to come back or go to emergency straight away if the breathlessness gets worse or you can't lie down at all."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 474.07,
      "end_seconds": 475.67,
      "duration_seconds": 1.6,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.37,
      "end_seconds": 481.3,
      "duration_seconds": 4.93,
      "text": "Come back after the results are back. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 481.84,
      "end_seconds": 484.52,
      "duration_seconds": 2.68,
      "text": "That's all, thank you for your time."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 485.17,
      "end_seconds": 485.87,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}