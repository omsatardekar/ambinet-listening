{
  "schema_version": "1.0",
  "encounter_id": "00307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 4.84,
      "duration_seconds": 3.97,
      "text": "Come in, come in. Pull the door closed behind you, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.98,
      "end_seconds": 6.68,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.17,
      "end_seconds": 10.35,
      "duration_seconds": 2.18,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.99,
      "end_seconds": 17.13,
      "duration_seconds": 6.14,
      "text": "Mainly a missed period. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 19.71,
      "duration_seconds": 2.18,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.55,
      "end_seconds": 32.14,
      "duration_seconds": 11.59,
      "text": "It's been going on for about two weeks. I took the morning off to come in today. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.23,
      "end_seconds": 34.78,
      "duration_seconds": 1.55,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.09,
      "end_seconds": 39.19,
      "duration_seconds": 3.1,
      "text": "A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.1,
      "end_seconds": 43.09,
      "duration_seconds": 2.99,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.24,
      "end_seconds": 48.85,
      "duration_seconds": 4.61,
      "text": "When it starts I tend to get tender breasts as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.52,
      "end_seconds": 51.17,
      "duration_seconds": 1.65,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.29,
      "end_seconds": 53.61,
      "duration_seconds": 1.32,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.87,
      "end_seconds": 57.94,
      "duration_seconds": 3.07,
      "text": "Have you had any fever, vomiting everything or dizziness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.31,
      "end_seconds": 62.44,
      "duration_seconds": 4.13,
      "text": "Um, no, no fever, vomiting everything or dizziness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.02,
      "end_seconds": 67.41,
      "duration_seconds": 4.39,
      "text": "Any bleeding, burning when passing urine or severe abdominal pain at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.63,
      "end_seconds": 75.09,
      "duration_seconds": 6.46,
      "text": "Okay, so no, no bleeding, burning when passing urine or severe abdominal pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.3,
      "end_seconds": 77.98,
      "duration_seconds": 1.68,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.29,
      "end_seconds": 80.99,
      "duration_seconds": 1.7,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.35,
      "end_seconds": 85.35,
      "duration_seconds": 3.0,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.33,
      "end_seconds": 88.79,
      "duration_seconds": 2.46,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.37,
      "end_seconds": 92.61,
      "duration_seconds": 3.24,
      "text": "So, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.12,
      "end_seconds": 110.28,
      "duration_seconds": 17.16,
      "text": "Yeah, I've had an underactive thyroid for five years now. I just want to get back to normal, really. I've had heart disease for about ten years now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.7,
      "end_seconds": 119.2,
      "duration_seconds": 8.5,
      "text": "Mm. Right, so that's your known heart disease. We'll keep that in mind today. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.01,
      "end_seconds": 124.24,
      "duration_seconds": 4.23,
      "text": "Yeah, you know, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 127.18,
      "duration_seconds": 2.5,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.68,
      "end_seconds": 134.16,
      "duration_seconds": 5.48,
      "text": "I'm on Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.96,
      "end_seconds": 138.78,
      "duration_seconds": 3.82,
      "text": "Right, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.41,
      "end_seconds": 153.26,
      "duration_seconds": 13.85,
      "text": "Oh, no, it's at home. Aspirin, 75 milligrams, once a day. I told myself I'd wait and see, and here I am. I'm on folic acid, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.82,
      "end_seconds": 155.84,
      "duration_seconds": 1.02,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.51,
      "end_seconds": 162.38,
      "duration_seconds": 3.87,
      "text": "I, I had my gallbladder removed in 2016."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.27,
      "end_seconds": 164.33,
      "duration_seconds": 1.06,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.34,
      "end_seconds": 172.99,
      "duration_seconds": 4.65,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.93,
      "end_seconds": 189.06,
      "duration_seconds": 14.13,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.06,
      "end_seconds": 193.57,
      "duration_seconds": 3.51,
      "text": "Thank you, um, that really helps."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 197.22,
      "end_seconds": 210.32,
      "duration_seconds": 13.1,
      "text": "Okay, so the vitals from earlier. Respiratory rate 14, BP is 116 over 68, temperature is 36.5 degrees, heart rate 80, height 177 centimetres, weight 78 kilos, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.49,
      "end_seconds": 212.25,
      "duration_seconds": 0.76,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.5,
      "end_seconds": 218.03,
      "duration_seconds": 3.53,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.49,
      "end_seconds": 219.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.14,
      "end_seconds": 224.04,
      "duration_seconds": 2.9,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 245.43,
      "duration_seconds": 5.57,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 272.45,
      "duration_seconds": 24.03,
      "text": "All done, thank you, please sit down. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Putting it all together, this looks most like an early pregnancy. I want to be honest that this is an impression, not a final answer. I can't rule out a late period for another reason yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.91,
      "end_seconds": 276.9,
      "duration_seconds": 2.99,
      "text": "Is it something serious, you know, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.84,
      "end_seconds": 294.98,
      "duration_seconds": 17.14,
      "text": "I understand the worry. At the moment I'd say it's an early pregnancy, and we'll know more once the an early scan is back. Let me just recap so I've got it right. You've had a missed period for about two weeks, and no vomiting everything or severe abdominal pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.6,
      "end_seconds": 298.07,
      "duration_seconds": 2.47,
      "text": "Yes, uh, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.29,
      "end_seconds": 303.41,
      "duration_seconds": 4.12,
      "text": "So, have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.56,
      "end_seconds": 317.67,
      "duration_seconds": 13.11,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.24,
      "end_seconds": 326.85,
      "duration_seconds": 8.61,
      "text": "Let's get an early scan, for early pregnancy. Let's get blood tests, for antenatal screening. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.44,
      "end_seconds": 328.37,
      "duration_seconds": 0.93,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 329.32,
      "end_seconds": 334.81,
      "duration_seconds": 5.49,
      "text": "Doctor, I did a pregnancy test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.72,
      "end_seconds": 360.0,
      "duration_seconds": 24.28,
      "text": "So, perfect. Avoid alcohol and don't take any new tablets without checking with us first. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.18,
      "end_seconds": 363.44,
      "duration_seconds": 2.26,
      "text": "Okay, you know, I will."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.16,
      "end_seconds": 374.62,
      "duration_seconds": 10.46,
      "text": "I want you to come back or go to emergency straight away if you have bleeding or sharp pain on one side. Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 375.64,
      "end_seconds": 377.92,
      "duration_seconds": 2.28,
      "text": "Well, okay, I'll book that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.31,
      "end_seconds": 382.54,
      "duration_seconds": 3.23,
      "text": "Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.95,
      "end_seconds": 385.99,
      "duration_seconds": 3.04,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.08,
      "end_seconds": 387.78,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}