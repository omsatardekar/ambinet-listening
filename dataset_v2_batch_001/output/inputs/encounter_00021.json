{
  "schema_version": "1.0",
  "encounter_id": "00021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 7.26,
      "duration_seconds": 6.0,
      "text": "Uh, uh, good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.23,
      "end_seconds": 12.16,
      "duration_seconds": 3.93,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.58,
      "end_seconds": 15.43,
      "duration_seconds": 2.85,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.79,
      "end_seconds": 18.54,
      "duration_seconds": 2.75,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.63,
      "end_seconds": 26.74,
      "duration_seconds": 7.11,
      "text": "Well, it's breathlessness on the stairs, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.84,
      "end_seconds": 30.52,
      "duration_seconds": 2.68,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.75,
      "end_seconds": 42.57,
      "duration_seconds": 10.82,
      "text": "For two months, I'd say. I'm not great at remembering details, so bear with me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.85,
      "end_seconds": 47.49,
      "duration_seconds": 3.64,
      "text": "Alright, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 49.39,
      "duration_seconds": 1.32,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.29,
      "end_seconds": 52.44,
      "duration_seconds": 2.15,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.82,
      "end_seconds": 56.25,
      "duration_seconds": 2.43,
      "text": "It's worse with climbing stairs."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.97,
      "end_seconds": 63.7,
      "duration_seconds": 6.73,
      "text": "So, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 63.8,
      "end_seconds": 68.32,
      "duration_seconds": 4.52,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.29,
      "end_seconds": 71.86,
      "duration_seconds": 2.57,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.12,
      "end_seconds": 74.85,
      "duration_seconds": 1.73,
      "text": "Have you been looking pale?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.34,
      "end_seconds": 77.27,
      "duration_seconds": 0.93,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.8,
      "end_seconds": 82.39,
      "duration_seconds": 4.59,
      "text": "Have you had breathlessness on the stairs before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.5,
      "end_seconds": 88.29,
      "duration_seconds": 4.79,
      "text": "So, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 92.35,
      "duration_seconds": 3.1,
      "text": "Have you had any weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.4,
      "end_seconds": 105.03,
      "duration_seconds": 11.63,
      "text": "No, no weight loss, no chest pain. I did have a racing heart sometimes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.1,
      "end_seconds": 110.01,
      "duration_seconds": 3.91,
      "text": "Any heavy periods, fainting or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.6,
      "end_seconds": 112.35,
      "duration_seconds": 1.75,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.55,
      "end_seconds": 117.06,
      "duration_seconds": 3.51,
      "text": "So, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 121.43,
      "duration_seconds": 1.44,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.48,
      "end_seconds": 123.18,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.81,
      "end_seconds": 127.08,
      "duration_seconds": 3.27,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.45,
      "end_seconds": 132.03,
      "duration_seconds": 3.58,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.8,
      "end_seconds": 136.74,
      "duration_seconds": 3.94,
      "text": "Yes, dust, it gives me sneezing. Yes, pollen."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.88,
      "end_seconds": 139.75,
      "duration_seconds": 1.87,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 150.0,
      "duration_seconds": 8.11,
      "text": "So, uh, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.02,
      "end_seconds": 153.06,
      "duration_seconds": 2.04,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.54,
      "end_seconds": 180.16,
      "duration_seconds": 26.62,
      "text": "For my acidity, I believe. My wife sets them out for me, I just take what I'm given. Escitalopram, 10 milligrams, once a day for the anxiety. I take furosemide, 40 milligrams, every morning. I told myself I'd wait and see, and here I am. It's losartan, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.91,
      "end_seconds": 183.38,
      "duration_seconds": 2.47,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.43,
      "end_seconds": 194.45,
      "duration_seconds": 10.02,
      "text": "Oh, not with me. I'll bring it next time. Well, uh, I was on amlodipine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.96,
      "end_seconds": 201.64,
      "duration_seconds": 5.68,
      "text": "Moving on to your background, any past medical history? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.97,
      "end_seconds": 207.92,
      "duration_seconds": 4.95,
      "text": "I have acid reflux. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.38,
      "end_seconds": 210.08,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.95,
      "end_seconds": 212.05,
      "duration_seconds": 1.1,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.92,
      "end_seconds": 213.62,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.15,
      "end_seconds": 232.38,
      "duration_seconds": 15.23,
      "text": "I've had heart failure for about ten years now. My family kept telling me to get it checked. I have high blood pressure, for two years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.19,
      "end_seconds": 243.11,
      "duration_seconds": 9.92,
      "text": "Okay, acid reflux, that's already on your record. Good to know. Alright, yes, I can see the anxiety in your file as well. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.46,
      "end_seconds": 258.44,
      "duration_seconds": 1.98,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.76,
      "end_seconds": 274.74,
      "duration_seconds": 4.98,
      "text": "Okay: BP is 125 over 87, heart rate 107, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.61,
      "end_seconds": 280.99,
      "duration_seconds": 3.38,
      "text": "Okay, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.48,
      "end_seconds": 284.32,
      "duration_seconds": 1.84,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.09,
      "end_seconds": 303.86,
      "duration_seconds": 1.77,
      "text": "Your eyelids are pale inside."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.31,
      "end_seconds": 306.81,
      "duration_seconds": 1.5,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.79,
      "end_seconds": 327.34,
      "duration_seconds": 3.55,
      "text": "Heart sounds are normal, I don't hear any murmur."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.66,
      "end_seconds": 350.62,
      "duration_seconds": 19.96,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Putting it all together, this looks most like anaemia of some kind. That's my thinking for now, and it may change as we learn more. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.19,
      "end_seconds": 360.3,
      "duration_seconds": 8.11,
      "text": "I'd like to arrange a vitamin B12 level for possible deficiency. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 361.15,
      "end_seconds": 363.08,
      "duration_seconds": 1.93,
      "text": "The earliest is Wednesday, 10 am."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.82,
      "end_seconds": 368.17,
      "duration_seconds": 4.35,
      "text": "I'm going to order a ferritin level, for possible iron deficiency."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.56,
      "end_seconds": 370.49,
      "duration_seconds": 0.93,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.76,
      "end_seconds": 374.03,
      "duration_seconds": 2.27,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.54,
      "end_seconds": 381.41,
      "duration_seconds": 6.87,
      "text": "I did have a full blood count done last month, you know, but the paper's at home."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.88,
      "end_seconds": 410.17,
      "duration_seconds": 27.29,
      "text": "I'll start you on ferrous sulfate, 200 milligrams, once a day, for three months. That's for possible iron deficiency. The pharmacy will go through the details again when you pick it up. Iron can darken the stools and bother the stomach, so take it after food. Please take the tablets with food so they don't upset your stomach. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.55,
      "end_seconds": 420.16,
      "duration_seconds": 6.61,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.77,
      "end_seconds": 422.35,
      "duration_seconds": 1.58,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.77,
      "end_seconds": 428.63,
      "duration_seconds": 5.86,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.5,
      "end_seconds": 430.95,
      "duration_seconds": 1.45,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.71,
      "end_seconds": 434.65,
      "duration_seconds": 2.94,
      "text": "Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.06,
      "end_seconds": 441.08,
      "duration_seconds": 5.02,
      "text": "Oh, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.45,
      "end_seconds": 444.58,
      "duration_seconds": 3.13,
      "text": "Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.07,
      "end_seconds": 450.34,
      "duration_seconds": 4.27,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.88,
      "end_seconds": 452.0,
      "duration_seconds": 1.12,
      "text": "See you then."
    }
  ]
}