{
  "schema_version": "1.0",
  "encounter_id": "00223",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 5.36,
      "duration_seconds": 4.2,
      "text": "Sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.31,
      "end_seconds": 9.09,
      "duration_seconds": 2.78,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.75,
      "end_seconds": 14.44,
      "duration_seconds": 2.69,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.98,
      "end_seconds": 23.51,
      "duration_seconds": 5.53,
      "text": "Doctor, it's more breathlessness than usual. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.67,
      "end_seconds": 26.88,
      "duration_seconds": 2.21,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.56,
      "end_seconds": 33.96,
      "duration_seconds": 6.4,
      "text": "I've had it for ten days. There's poor sleep because of the cough as well."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.18,
      "end_seconds": 38.09,
      "duration_seconds": 2.91,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.84,
      "end_seconds": 41.17,
      "duration_seconds": 2.33,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.97,
      "end_seconds": 48.48,
      "duration_seconds": 3.51,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.34,
      "end_seconds": 51.34,
      "duration_seconds": 2.0,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 57.19,
      "duration_seconds": 2.14,
      "text": "And swollen ankles, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.59,
      "end_seconds": 64.54,
      "duration_seconds": 2.95,
      "text": "No, I haven't had any swollen ankles."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.54,
      "end_seconds": 70.75,
      "duration_seconds": 5.21,
      "text": "Let me check a few things. Any chest pain, confusion, coughing up blood or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.73,
      "end_seconds": 77.3,
      "duration_seconds": 5.57,
      "text": "I haven't had chest pain, confusion, coughing up blood or weight loss, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.49,
      "end_seconds": 83.4,
      "duration_seconds": 1.91,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.59,
      "end_seconds": 87.84,
      "duration_seconds": 1.25,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.08,
      "end_seconds": 91.45,
      "duration_seconds": 2.37,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.03,
      "end_seconds": 92.92,
      "duration_seconds": 0.89,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.88,
      "end_seconds": 113.91,
      "duration_seconds": 5.03,
      "text": "Right, thanks for waiting. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.32,
      "end_seconds": 115.08,
      "duration_seconds": 0.76,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.48,
      "end_seconds": 132.76,
      "duration_seconds": 14.28,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.48,
      "end_seconds": 135.16,
      "duration_seconds": 1.68,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.49,
      "end_seconds": 138.55,
      "duration_seconds": 3.06,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.1,
      "end_seconds": 141.94,
      "duration_seconds": 1.84,
      "text": "COPD, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.39,
      "end_seconds": 150.93,
      "duration_seconds": 7.54,
      "text": "Go on. Okay, COPD, that's already on your record. Good to know. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.86,
      "end_seconds": 164.87,
      "duration_seconds": 13.01,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.23,
      "end_seconds": 168.65,
      "duration_seconds": 3.42,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.61,
      "end_seconds": 173.77,
      "duration_seconds": 4.16,
      "text": "It's Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.99,
      "end_seconds": 178.14,
      "duration_seconds": 3.15,
      "text": "So, how long have you been on it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.76,
      "end_seconds": 179.92,
      "duration_seconds": 1.16,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.52,
      "end_seconds": 192.84,
      "duration_seconds": 11.32,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.89,
      "end_seconds": 195.78,
      "duration_seconds": 1.89,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.72,
      "end_seconds": 200.76,
      "duration_seconds": 4.04,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.23,
      "end_seconds": 201.95,
      "duration_seconds": 0.72,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 217.32,
      "duration_seconds": 1.42,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.59,
      "end_seconds": 220.77,
      "duration_seconds": 2.18,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.7,
      "end_seconds": 224.96,
      "duration_seconds": 2.26,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.89,
      "end_seconds": 238.7,
      "duration_seconds": 4.81,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 255.99,
      "duration_seconds": 11.83,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.46,
      "end_seconds": 259.45,
      "duration_seconds": 1.99,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.18,
      "end_seconds": 269.67,
      "duration_seconds": 9.49,
      "text": "Putting it all together, my working impression is a flare-up of COPD. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.12,
      "end_seconds": 272.46,
      "duration_seconds": 2.34,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.19,
      "end_seconds": 289.28,
      "duration_seconds": 16.09,
      "text": "I can't promise yet, but most people with a flare-up of COPD do well once it's treated properly. Let me just recap so I've got it right. You've had more breathlessness than usual for ten days, and no coughing up blood or weight loss."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.71,
      "end_seconds": 291.13,
      "duration_seconds": 1.42,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.74,
      "end_seconds": 296.49,
      "duration_seconds": 4.75,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.84,
      "end_seconds": 306.89,
      "duration_seconds": 9.05,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.32,
      "end_seconds": 309.69,
      "duration_seconds": 2.37,
      "text": "Let's get a chest X-ray, for breathlessness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.08,
      "end_seconds": 313.96,
      "duration_seconds": 2.88,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.88,
      "end_seconds": 320.95,
      "duration_seconds": 6.07,
      "text": "I'm prescribing prednisolone, 30 milligrams, once a day, for five days. That should help with COPD flare-up."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.47,
      "end_seconds": 324.19,
      "duration_seconds": 2.72,
      "text": "Right, uh, I'll remember that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.2,
      "end_seconds": 349.85,
      "duration_seconds": 24.65,
      "text": "I'll start you on doxycycline, 100 milligrams, twice a day, for five days. That should help with chest infection. The pharmacy will go through the details again when you pick it up. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I want you to come back or go to emergency straight away if you become more breathless or your lips turn blue."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.54,
      "end_seconds": 351.24,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.98,
      "end_seconds": 354.62,
      "duration_seconds": 2.64,
      "text": "Please come and see me in one week."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.7,
      "end_seconds": 359.57,
      "duration_seconds": 3.87,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.56,
      "end_seconds": 367.86,
      "duration_seconds": 4.3,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.56,
      "end_seconds": 378.28,
      "duration_seconds": 9.72,
      "text": "So, I take the prednisolone, 30 milligrams, once a day and take the doxycycline, 100 milligrams, twice a day. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.04,
      "end_seconds": 382.99,
      "duration_seconds": 3.95,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.46,
      "end_seconds": 386.59,
      "duration_seconds": 3.13,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.1,
      "end_seconds": 388.88,
      "duration_seconds": 0.78,
      "text": "Alright, goodbye."
    }
  ]
}