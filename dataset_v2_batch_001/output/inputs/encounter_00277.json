{
  "schema_version": "1.0",
  "encounter_id": "00277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.25,
      "end_seconds": 5.02,
      "duration_seconds": 3.77,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 9.78,
      "duration_seconds": 3.6,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.45,
      "end_seconds": 15.98,
      "duration_seconds": 5.53,
      "text": "It's pain in my right ankle. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.24,
      "end_seconds": 18.86,
      "duration_seconds": 1.62,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.8,
      "end_seconds": 22.56,
      "duration_seconds": 2.76,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.53,
      "end_seconds": 25.47,
      "duration_seconds": 1.94,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.6,
      "end_seconds": 29.17,
      "duration_seconds": 2.57,
      "text": "It, It happens every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.33,
      "end_seconds": 32.83,
      "duration_seconds": 2.5,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.96,
      "end_seconds": 41.57,
      "duration_seconds": 7.61,
      "text": "I'd say moderate. There's bruising as well. I, I did have swelling at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.92,
      "end_seconds": 48.34,
      "duration_seconds": 6.42,
      "text": "Any pain at the back of the heel, pop or crack or pain in the knee at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.7,
      "end_seconds": 50.61,
      "duration_seconds": 1.91,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.47,
      "end_seconds": 55.23,
      "duration_seconds": 3.76,
      "text": "Let me check a few things. Any numbness or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.1,
      "end_seconds": 62.34,
      "duration_seconds": 3.24,
      "text": "Well, I haven't had numbness or fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.76,
      "end_seconds": 66.96,
      "duration_seconds": 3.2,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.46,
      "end_seconds": 69.03,
      "duration_seconds": 1.57,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.61,
      "end_seconds": 71.63,
      "duration_seconds": 1.02,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.19,
      "end_seconds": 75.33,
      "duration_seconds": 3.14,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.64,
      "end_seconds": 76.81,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.28,
      "end_seconds": 81.59,
      "duration_seconds": 3.31,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.9,
      "end_seconds": 88.99,
      "duration_seconds": 4.09,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.01,
      "end_seconds": 94.06,
      "duration_seconds": 4.05,
      "text": "Um, mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.92,
      "end_seconds": 97.78,
      "duration_seconds": 2.86,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 101.82,
      "duration_seconds": 2.76,
      "text": "Spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 103.15,
      "end_seconds": 107.58,
      "duration_seconds": 4.43,
      "text": "Doctor, our chart from the last visit lists it as 50 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 111.47,
      "duration_seconds": 2.96,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.61,
      "end_seconds": 127.21,
      "duration_seconds": 14.6,
      "text": "Okay, so I don't think I have it with me. Volini spray, a few times a day. A neighbour of mine said I should see someone about it. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.51,
      "end_seconds": 129.7,
      "duration_seconds": 2.19,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 132.37,
      "duration_seconds": 1.69,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 137.72,
      "duration_seconds": 3.81,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.63,
      "end_seconds": 141.64,
      "duration_seconds": 3.01,
      "text": "Asthma, for five years. I've got heart failure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.7,
      "end_seconds": 149.16,
      "duration_seconds": 6.46,
      "text": "Right, so that's your known heart failure. We'll keep that in mind today. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.97,
      "end_seconds": 154.41,
      "duration_seconds": 4.44,
      "text": "Latex. I come out in... well, a rash on my hands."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.63,
      "end_seconds": 158.09,
      "duration_seconds": 2.46,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.57,
      "end_seconds": 160.3,
      "duration_seconds": 1.73,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.95,
      "end_seconds": 162.7,
      "duration_seconds": 1.75,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.48,
      "end_seconds": 167.14,
      "duration_seconds": 3.66,
      "text": "I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 168.48,
      "end_seconds": 174.94,
      "duration_seconds": 6.46,
      "text": "Here are the numbers, doctor. Oxygen saturation is 98 percent, pressure 112 over 80, heart rate 67."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.06,
      "end_seconds": 176.85,
      "duration_seconds": 0.79,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 182.91,
      "duration_seconds": 3.72,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.39,
      "end_seconds": 187.16,
      "duration_seconds": 2.77,
      "text": "So, can you lie back for me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.07,
      "end_seconds": 210.19,
      "duration_seconds": 5.12,
      "text": "The bones themselves aren't tender and the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.24,
      "end_seconds": 211.94,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.18,
      "end_seconds": 215.46,
      "duration_seconds": 2.28,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 235.22,
      "duration_seconds": 5.36,
      "text": "There's swelling and bruising on the outer side of the ankle, tender over the ligament."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.89,
      "end_seconds": 258.47,
      "duration_seconds": 18.58,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, it fits best with an ankle sprain. It could also be a ligament tear, so we'll keep that open."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.07,
      "end_seconds": 261.57,
      "duration_seconds": 2.5,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.63,
      "end_seconds": 281.91,
      "duration_seconds": 19.28,
      "text": "I can't promise yet, but most people with an ankle sprain do well once it's treated properly. Let me just recap so I've got it right. You've had pain in your right ankle for about two weeks, moderate, and no pain at the back of the heel or fever."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.59,
      "end_seconds": 283.94,
      "duration_seconds": 1.35,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.1,
      "end_seconds": 289.42,
      "duration_seconds": 4.32,
      "text": "I'd like to arrange an X-ray of the ankle for ankle injury."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.16,
      "end_seconds": 292.42,
      "duration_seconds": 2.26,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.9,
      "end_seconds": 301.17,
      "duration_seconds": 7.27,
      "text": "I'll start you on paracetamol, 650 milligrams, three times a day, for three days. It's for ankle pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.52,
      "end_seconds": 303.41,
      "duration_seconds": 0.89,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.35,
      "end_seconds": 325.15,
      "duration_seconds": 20.8,
      "text": "Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. Cut down on salt and fried food for now, it really does make a difference. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. We'll refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.63,
      "end_seconds": 326.84,
      "duration_seconds": 1.21,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.8,
      "end_seconds": 334.1,
      "duration_seconds": 6.3,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.55,
      "end_seconds": 335.85,
      "duration_seconds": 1.3,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.28,
      "end_seconds": 342.74,
      "duration_seconds": 5.46,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 343.34,
      "end_seconds": 345.03,
      "duration_seconds": 1.69,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.21,
      "end_seconds": 348.54,
      "duration_seconds": 2.33,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.5,
      "end_seconds": 350.2,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.37,
      "end_seconds": 355.47,
      "duration_seconds": 4.1,
      "text": "Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.64,
      "end_seconds": 361.02,
      "duration_seconds": 4.38,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}