{
  "schema_version": "1.0",
  "encounter_id": "00046",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 4.55,
      "duration_seconds": 3.25,
      "text": "So, morning. Just put your bag down anywhere."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.68,
      "end_seconds": 8.27,
      "duration_seconds": 2.59,
      "text": "Hello, doctor. Thanks for seeing me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.87,
      "end_seconds": 10.81,
      "duration_seconds": 1.94,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.79,
      "end_seconds": 19.34,
      "duration_seconds": 7.55,
      "text": "Well, I've been having pressure in the face. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.85,
      "end_seconds": 22.9,
      "duration_seconds": 3.05,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.24,
      "end_seconds": 31.19,
      "duration_seconds": 6.95,
      "text": "It's been like this since Monday. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.87,
      "end_seconds": 34.9,
      "duration_seconds": 3.03,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.22,
      "end_seconds": 38.52,
      "duration_seconds": 2.3,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 40.04,
      "duration_seconds": 1.09,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.67,
      "end_seconds": 45.2,
      "duration_seconds": 4.53,
      "text": "Oh, and reduced sense of smell. Had that since last weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.08,
      "end_seconds": 48.69,
      "duration_seconds": 2.61,
      "text": "Has there been a blocked nose too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.74,
      "end_seconds": 50.71,
      "duration_seconds": 0.97,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.01,
      "end_seconds": 57.05,
      "duration_seconds": 5.04,
      "text": "Let me check a few things. Any vision changes, fever or stiff neck?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.51,
      "end_seconds": 59.22,
      "duration_seconds": 1.71,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.46,
      "end_seconds": 63.14,
      "duration_seconds": 2.68,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.56,
      "end_seconds": 67.28,
      "duration_seconds": 2.72,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 71.41,
      "duration_seconds": 3.36,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 76.02,
      "duration_seconds": 3.3,
      "text": "Uh, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.71,
      "end_seconds": 79.29,
      "duration_seconds": 2.58,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.69,
      "end_seconds": 103.96,
      "duration_seconds": 23.27,
      "text": "I'm on Asthalin inhaler, when needed. I looked a few things up online, and that probably didn't help. I'm hoping you can tell me something definite. Paracetamol, 500 milligrams, when needed. I told myself I'd wait and see, and here I am. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.45,
      "end_seconds": 110.85,
      "duration_seconds": 6.4,
      "text": "What about allergies, to medicines or foods or anything else? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.6,
      "end_seconds": 114.62,
      "duration_seconds": 3.02,
      "text": "I'm allergic to shellfish, I get vomiting."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.75,
      "end_seconds": 129.76,
      "duration_seconds": 14.01,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.15,
      "end_seconds": 133.94,
      "duration_seconds": 3.79,
      "text": "Yeah, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 138.09,
      "duration_seconds": 3.73,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.58,
      "end_seconds": 146.55,
      "duration_seconds": 6.97,
      "text": "I have asthma, for two years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.65,
      "end_seconds": 150.49,
      "duration_seconds": 2.84,
      "text": "Alright, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.33,
      "end_seconds": 152.07,
      "duration_seconds": 0.74,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.16,
      "end_seconds": 168.84,
      "duration_seconds": 3.68,
      "text": "Okay, here we go. Right, does anything run in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.78,
      "end_seconds": 171.59,
      "duration_seconds": 1.81,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 176.72,
      "duration_seconds": 4.52,
      "text": "Right, is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.74,
      "end_seconds": 180.81,
      "duration_seconds": 3.07,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.18,
      "end_seconds": 183.06,
      "duration_seconds": 1.88,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.12,
      "end_seconds": 195.39,
      "duration_seconds": 1.27,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.25,
      "end_seconds": 215.4,
      "duration_seconds": 6.15,
      "text": "Okay: pulse 69, saturation 99 percent, temperature is 36.9 degrees, BP is 125 over 75."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.63,
      "end_seconds": 220.46,
      "duration_seconds": 3.83,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.3,
      "end_seconds": 222.0,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.62,
      "end_seconds": 239.24,
      "duration_seconds": 1.62,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.12,
      "end_seconds": 244.13,
      "duration_seconds": 2.01,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.82,
      "end_seconds": 249.34,
      "duration_seconds": 3.52,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 264.79,
      "duration_seconds": 4.53,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.22,
      "end_seconds": 265.92,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.63,
      "end_seconds": 270.39,
      "duration_seconds": 2.76,
      "text": "Right, now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.1,
      "end_seconds": 283.5,
      "duration_seconds": 2.4,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.25,
      "end_seconds": 284.95,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.97,
      "end_seconds": 298.15,
      "duration_seconds": 11.18,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.28,
      "end_seconds": 302.99,
      "duration_seconds": 3.71,
      "text": "Right, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.35,
      "end_seconds": 314.93,
      "duration_seconds": 10.58,
      "text": "Right, here's what I'm thinking. I think we're dealing with sinusitis at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.97,
      "end_seconds": 319.86,
      "duration_seconds": 1.89,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.63,
      "end_seconds": 335.61,
      "duration_seconds": 14.98,
      "text": "Nothing I've seen today points to an emergency. It looks like sinusitis, but I'd like to confirm. Let me just recap so I've got it right. You've had pressure in the face, since Monday, severe, and no fever or stiff neck."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.3,
      "end_seconds": 338.6,
      "duration_seconds": 2.3,
      "text": "Yes, uh, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.85,
      "end_seconds": 342.98,
      "duration_seconds": 3.13,
      "text": "So, has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.68,
      "end_seconds": 360.69,
      "duration_seconds": 17.01,
      "text": "Um, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.31,
      "end_seconds": 369.33,
      "duration_seconds": 8.02,
      "text": "I'd like to arrange an X-ray of the sinuses for sinusitis. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 371.46,
      "end_seconds": 372.41,
      "duration_seconds": 0.95,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.16,
      "end_seconds": 397.32,
      "duration_seconds": 24.16,
      "text": "I'll start you on saline nasal spray, three times a day, for one week. It's for nasal congestion. Steam a couple of times a day and saline rinses will help clear things. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.91,
      "end_seconds": 400.15,
      "duration_seconds": 1.24,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.48,
      "end_seconds": 402.18,
      "duration_seconds": 1.7,
      "text": "Come back in ten days."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 404.67,
      "end_seconds": 408.75,
      "duration_seconds": 4.08,
      "text": "Right, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.79,
      "end_seconds": 414.16,
      "duration_seconds": 4.37,
      "text": "Alright, just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.47,
      "end_seconds": 419.41,
      "duration_seconds": 3.94,
      "text": "So, I come back in ten days. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.82,
      "end_seconds": 422.41,
      "duration_seconds": 2.59,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 423.48,
      "end_seconds": 425.12,
      "duration_seconds": 1.64,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.63,
      "end_seconds": 426.5,
      "duration_seconds": 0.87,
      "text": "Alright, goodbye."
    }
  ]
}