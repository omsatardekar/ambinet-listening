{
  "schema_version": "1.0",
  "encounter_id": "00210",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 5.42,
      "duration_seconds": 4.84,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.58,
      "end_seconds": 9.32,
      "duration_seconds": 2.74,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.69,
      "end_seconds": 13.75,
      "duration_seconds": 4.06,
      "text": "Well, you know, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.22,
      "end_seconds": 19.37,
      "duration_seconds": 3.15,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.39,
      "end_seconds": 26.93,
      "duration_seconds": 6.54,
      "text": "It's breathlessness when I lie flat, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 29.61,
      "duration_seconds": 2.35,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.03,
      "end_seconds": 39.16,
      "duration_seconds": 8.13,
      "text": "Oh, it's been one week, I'm fairly sure. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.37,
      "end_seconds": 46.89,
      "duration_seconds": 6.52,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.3,
      "end_seconds": 68.46,
      "duration_seconds": 21.16,
      "text": "Yeah, it happens every other day. I'd say mild. Oh, and a dry cough at night. That's been about the same, one week. Oh, and I've been waking up at night short of breath as well. So, I had tiredness before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 71.54,
      "duration_seconds": 1.88,
      "text": "Has there been any fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.27,
      "end_seconds": 73.66,
      "duration_seconds": 1.39,
      "text": "No, no fainting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.23,
      "end_seconds": 79.01,
      "duration_seconds": 3.78,
      "text": "Any calf pain, coughing up blood or palpitations at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.99,
      "end_seconds": 83.75,
      "duration_seconds": 3.76,
      "text": "No, no calf pain, coughing up blood or palpitations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.23,
      "end_seconds": 87.04,
      "duration_seconds": 2.81,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.71,
      "end_seconds": 90.55,
      "duration_seconds": 2.84,
      "text": "Okay, so no, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 91.1,
      "end_seconds": 99.13,
      "duration_seconds": 8.03,
      "text": "Here are the numbers, doctor. Saturation 94 percent, BP is 140 over 81, temperature is 37.0 degrees, pulse 84."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.84,
      "end_seconds": 103.4,
      "duration_seconds": 3.56,
      "text": "Good, thank you. Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.0,
      "end_seconds": 109.0,
      "duration_seconds": 4.0,
      "text": "I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.67,
      "end_seconds": 112.47,
      "duration_seconds": 2.8,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.2,
      "end_seconds": 117.99,
      "duration_seconds": 4.79,
      "text": "Dust, I'd say. Uh, yes, I'm allergic to peanuts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.98,
      "end_seconds": 122.72,
      "duration_seconds": 3.74,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.58,
      "end_seconds": 134.25,
      "duration_seconds": 7.67,
      "text": "Hmm, you know, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.83,
      "end_seconds": 138.38,
      "duration_seconds": 3.55,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.82,
      "end_seconds": 145.21,
      "duration_seconds": 5.39,
      "text": "My father had kidney stones. Hmm, my mother has diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.56,
      "end_seconds": 148.6,
      "duration_seconds": 3.04,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.55,
      "end_seconds": 168.46,
      "duration_seconds": 15.91,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.74,
      "end_seconds": 175.33,
      "duration_seconds": 5.59,
      "text": "Let's go through your medication. What are you taking? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.39,
      "end_seconds": 180.26,
      "duration_seconds": 3.87,
      "text": "Oh, I'm on glimepiride, 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 181.76,
      "end_seconds": 190.69,
      "duration_seconds": 8.93,
      "text": "Hmm, doctor, I think the last prescription for the glimepiride was 4 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.99,
      "end_seconds": 195.35,
      "duration_seconds": 3.36,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.88,
      "end_seconds": 202.14,
      "duration_seconds": 4.26,
      "text": "Well, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.76,
      "end_seconds": 203.69,
      "duration_seconds": 0.93,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.59,
      "end_seconds": 210.13,
      "duration_seconds": 3.54,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 215.44,
      "duration_seconds": 4.27,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.34,
      "end_seconds": 228.68,
      "duration_seconds": 12.34,
      "text": "Oh, I have diabetes. A neighbour of mine said I should see someone about it. I wasn't sure whether to come in at all, to be honest. Yes, heart failure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.42,
      "end_seconds": 233.66,
      "duration_seconds": 3.24,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.37,
      "end_seconds": 236.61,
      "duration_seconds": 1.24,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.76,
      "end_seconds": 246.18,
      "duration_seconds": 1.42,
      "text": "Neck veins are raised."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.39,
      "end_seconds": 250.03,
      "duration_seconds": 2.64,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.08,
      "end_seconds": 266.32,
      "duration_seconds": 3.24,
      "text": "There's pitting oedema up to the shins on both legs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.87,
      "end_seconds": 273.13,
      "duration_seconds": 4.26,
      "text": "All done, thank you, please sit down. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 273.5,
      "end_seconds": 279.72,
      "duration_seconds": 6.22,
      "text": "Well, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.72,
      "end_seconds": 298.13,
      "duration_seconds": 17.41,
      "text": "From what you've told me and what I found, I think we're dealing with fluid overload related to the heart at this stage. That's my thinking for now, and it may change as we learn more. A chest infection is also on my list."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.56,
      "end_seconds": 302.96,
      "duration_seconds": 3.4,
      "text": "Hmm, should I be worried about this?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.06,
      "end_seconds": 321.57,
      "duration_seconds": 17.51,
      "text": "I understand the worry. At the moment I'd say it's fluid overload related to the heart, and we'll know more once the a chest X-ray is back. Let me just recap so I've got it right. You've had breathlessness when you lie flat for one week, mild, and no calf pain or coughing up blood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.02,
      "end_seconds": 324.56,
      "duration_seconds": 1.54,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.01,
      "end_seconds": 329.38,
      "duration_seconds": 4.37,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.71,
      "end_seconds": 340.72,
      "duration_seconds": 10.01,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.18,
      "end_seconds": 349.36,
      "duration_seconds": 8.18,
      "text": "Let's get a chest X-ray, for breathlessness. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.72,
      "end_seconds": 352.21,
      "duration_seconds": 2.49,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 353.22,
      "end_seconds": 355.97,
      "duration_seconds": 2.75,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.89,
      "end_seconds": 364.52,
      "duration_seconds": 7.63,
      "text": "Perfect. We should do blood tests for heart failure review. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 365.77,
      "end_seconds": 366.7,
      "duration_seconds": 0.93,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.58,
      "end_seconds": 378.2,
      "duration_seconds": 10.62,
      "text": "Let's use furosemide, 40 milligrams, every morning, until we review. You take it by mouth. That's for fluid overload. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.88,
      "end_seconds": 381.83,
      "duration_seconds": 2.95,
      "text": "Right, um, I'll remember that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.84,
      "end_seconds": 408.17,
      "duration_seconds": 25.33,
      "text": "Keep the salt and the fluids moderate, no more than about one and a half litres a day. Weigh yourself every morning, and tell us if you put on more than two kilos in a few days. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.73,
      "end_seconds": 411.17,
      "duration_seconds": 1.44,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.3,
      "end_seconds": 421.4,
      "duration_seconds": 9.1,
      "text": "Please don't sit on it if the breathlessness gets worse or you can't lie down at all. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 422.86,
      "end_seconds": 423.56,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.93,
      "end_seconds": 427.63,
      "duration_seconds": 3.7,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.36,
      "end_seconds": 431.05,
      "duration_seconds": 2.69,
      "text": "Oh, okay, I'll book that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.55,
      "end_seconds": 437.39,
      "duration_seconds": 4.84,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 437.88,
      "end_seconds": 447.55,
      "duration_seconds": 9.67,
      "text": "So, I take the furosemide, 40 milligrams, every morning and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.57,
      "end_seconds": 453.14,
      "duration_seconds": 4.57,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 453.75,
      "end_seconds": 458.98,
      "duration_seconds": 5.23,
      "text": "Hmm, uh, no, I think that's everything. Thank you, doctor."
    }
  ]
}