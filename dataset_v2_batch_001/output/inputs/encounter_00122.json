{
  "schema_version": "1.0",
  "encounter_id": "00122",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.51,
      "duration_seconds": 3.29,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.43,
      "end_seconds": 9.35,
      "duration_seconds": 3.92,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.27,
      "end_seconds": 14.97,
      "duration_seconds": 4.7,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.34,
      "end_seconds": 18.99,
      "duration_seconds": 3.65,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.45,
      "end_seconds": 26.08,
      "duration_seconds": 6.63,
      "text": "I'm here because of headaches in the mornings. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.6,
      "end_seconds": 29.3,
      "duration_seconds": 2.7,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 49.09,
      "duration_seconds": 16.38,
      "text": "It's been going on for four weeks. I did try to ignore it for a while. Oh, and a high reading at home. That's been about the same, two months. And a little puffiness in the ankles, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.56,
      "end_seconds": 52.45,
      "duration_seconds": 1.89,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 58.11,
      "duration_seconds": 5.19,
      "text": "So, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.48,
      "end_seconds": 61.18,
      "duration_seconds": 2.7,
      "text": "Have you had any breathlessness or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.61,
      "end_seconds": 68.61,
      "duration_seconds": 3.0,
      "text": "No breathlessness or weakness, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.89,
      "end_seconds": 71.95,
      "duration_seconds": 2.06,
      "text": "Any chest pain or vision changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.37,
      "end_seconds": 76.43,
      "duration_seconds": 3.06,
      "text": "No, no chest pain or vision changes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 78.68,
      "duration_seconds": 1.16,
      "text": "What about nosebleeds?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.74,
      "end_seconds": 81.14,
      "duration_seconds": 1.4,
      "text": "No. No nosebleeds."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.82,
      "end_seconds": 83.21,
      "duration_seconds": 1.39,
      "text": "Okay, what about palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.72,
      "end_seconds": 86.1,
      "duration_seconds": 1.38,
      "text": "No, no palpitations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.74,
      "end_seconds": 92.68,
      "duration_seconds": 5.94,
      "text": "I mean, um, actually, doctor, I did notice palpitations. She doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.19,
      "end_seconds": 102.17,
      "duration_seconds": 5.98,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.86,
      "end_seconds": 109.52,
      "duration_seconds": 6.66,
      "text": "Alright, I'll note both what you've said and what you've noticed. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.01,
      "end_seconds": 112.41,
      "duration_seconds": 1.4,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.23,
      "end_seconds": 116.22,
      "duration_seconds": 2.99,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.25,
      "end_seconds": 118.13,
      "duration_seconds": 0.88,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.58,
      "end_seconds": 122.28,
      "duration_seconds": 2.7,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.51,
      "end_seconds": 132.7,
      "duration_seconds": 9.19,
      "text": "Um, I take atorvastatin, 20 milligrams, at night for my cholesterol. I'm, I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 136.36,
      "end_seconds": 144.69,
      "duration_seconds": 8.33,
      "text": "Doctor, I think the last prescription for the telmisartan was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.02,
      "end_seconds": 151.82,
      "duration_seconds": 2.8,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.25,
      "end_seconds": 156.6,
      "duration_seconds": 4.35,
      "text": "Well, uh, no, I left it at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.92,
      "end_seconds": 164.62,
      "duration_seconds": 6.7,
      "text": "Alright, moving on to your background, any past medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.29,
      "end_seconds": 176.73,
      "duration_seconds": 11.44,
      "text": "I have high cholesterol. I didn't want to make a fuss, you know. I've got high blood pressure. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.71,
      "end_seconds": 185.08,
      "duration_seconds": 7.37,
      "text": "Mm. Okay, high blood pressure, that's already on your record. Good to know. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.63,
      "end_seconds": 199.92,
      "duration_seconds": 1.29,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.07,
      "end_seconds": 224.6,
      "duration_seconds": 5.53,
      "text": "Okay: respiratory rate 15, oxygen saturation is 98 percent. And pulse 87, blood pressure 171 over 97."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 229.74,
      "duration_seconds": 3.85,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.48,
      "end_seconds": 231.18,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.95,
      "end_seconds": 236.24,
      "duration_seconds": 3.29,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.54,
      "end_seconds": 253.23,
      "duration_seconds": 2.69,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.89,
      "end_seconds": 254.8,
      "duration_seconds": 0.91,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.13,
      "end_seconds": 257.84,
      "duration_seconds": 1.71,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.36,
      "end_seconds": 275.63,
      "duration_seconds": 1.27,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.01,
      "end_seconds": 276.71,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.06,
      "end_seconds": 302.38,
      "duration_seconds": 20.32,
      "text": "That's fine, you can get dressed. So, based on the history and the examination, I think we're dealing with hypertension that isn't well controlled at this stage. The reason I say that is that your story and my examination fit together. It could also be a side effect from the current tablet, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.9,
      "end_seconds": 306.6,
      "duration_seconds": 2.7,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.58,
      "end_seconds": 328.42,
      "duration_seconds": 20.84,
      "text": "I can't promise yet, but most people with hypertension that isn't well controlled do well once it's treated properly. I'd like to arrange a lipid profile for cardiovascular risk. It's a routine test and it'll give us a much clearer picture. I'd like to arrange an ECG for hypertension. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.75,
      "end_seconds": 331.26,
      "duration_seconds": 1.51,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.71,
      "end_seconds": 338.82,
      "duration_seconds": 6.11,
      "text": "We should do kidney function tests for hypertension. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.61,
      "end_seconds": 347.58,
      "duration_seconds": 7.97,
      "text": "So, I did have a urine test for protein done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.13,
      "end_seconds": 374.13,
      "duration_seconds": 26.0,
      "text": "Let's use amlodipine, 5 milligrams, once a day, long term. That's for high blood pressure. Check the blood pressure at home, same time each morning, and write down the numbers for me. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.12,
      "end_seconds": 377.3,
      "duration_seconds": 2.18,
      "text": "Okay, uh, I will."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.55,
      "end_seconds": 384.71,
      "duration_seconds": 6.16,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.27,
      "end_seconds": 388.92,
      "duration_seconds": 2.65,
      "text": "Okay, you know, I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.69,
      "end_seconds": 392.51,
      "duration_seconds": 2.82,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.0,
      "end_seconds": 393.7,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.63,
      "end_seconds": 399.62,
      "duration_seconds": 2.99,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.14,
      "end_seconds": 403.06,
      "duration_seconds": 1.92,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.73,
      "end_seconds": 404.73,
      "duration_seconds": 1.0,
      "text": "See you then."
    }
  ]
}