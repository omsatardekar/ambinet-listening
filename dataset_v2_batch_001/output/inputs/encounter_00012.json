{
  "schema_version": "1.0",
  "encounter_id": "00012",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 6.95,
      "duration_seconds": 6.19,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.73,
      "end_seconds": 10.66,
      "duration_seconds": 2.93,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.22,
      "end_seconds": 19.34,
      "duration_seconds": 8.12,
      "text": "Okay, so morning, doctor. I'll stay and fill in anything that's missed. He's been having dizziness when I stand up, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.83,
      "end_seconds": 25.37,
      "duration_seconds": 2.54,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.52,
      "end_seconds": 31.88,
      "duration_seconds": 5.36,
      "text": "Probably about four days. Yeah. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.9,
      "end_seconds": 36.29,
      "duration_seconds": 3.39,
      "text": "Alright, on a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.63,
      "end_seconds": 37.84,
      "duration_seconds": 1.21,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.75,
      "end_seconds": 41.05,
      "duration_seconds": 2.3,
      "text": "Alright, how often does it happen?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.15,
      "end_seconds": 43.97,
      "duration_seconds": 1.82,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 47.13,
      "duration_seconds": 2.12,
      "text": "Has there been dark urine too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.32,
      "end_seconds": 51.07,
      "duration_seconds": 2.75,
      "text": "Hmm, yes, since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.14,
      "end_seconds": 54.03,
      "duration_seconds": 1.89,
      "text": "Have you had muscle cramps?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.43,
      "end_seconds": 63.84,
      "duration_seconds": 8.41,
      "text": "Yeah. About two weeks, I'd say. So, with muscle cramps, it happens a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.82,
      "end_seconds": 66.57,
      "duration_seconds": 1.75,
      "text": "Have you had loose motions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.26,
      "end_seconds": 68.51,
      "duration_seconds": 1.25,
      "text": "Yes, since Friday."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.87,
      "end_seconds": 71.99,
      "duration_seconds": 2.12,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.58,
      "end_seconds": 74.88,
      "duration_seconds": 1.3,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.69,
      "end_seconds": 79.3,
      "duration_seconds": 3.61,
      "text": "Have you had any vomiting, chest pain or confusion?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.05,
      "end_seconds": 82.63,
      "duration_seconds": 2.58,
      "text": "Um, no, none of those."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 86.27,
      "duration_seconds": 2.37,
      "text": "Okay, and fainting, any of that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 90.05,
      "duration_seconds": 2.44,
      "text": "No, I haven't had any fainting."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.01,
      "end_seconds": 93.12,
      "duration_seconds": 2.11,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.7,
      "end_seconds": 96.51,
      "duration_seconds": 1.81,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.37,
      "end_seconds": 102.35,
      "duration_seconds": 1.98,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.76,
      "end_seconds": 106.89,
      "duration_seconds": 3.13,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.22,
      "end_seconds": 110.61,
      "duration_seconds": 2.39,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.48,
      "end_seconds": 115.91,
      "duration_seconds": 4.43,
      "text": "Amlodipine. I take it 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.26,
      "end_seconds": 119.87,
      "duration_seconds": 3.61,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.92,
      "end_seconds": 128.48,
      "duration_seconds": 4.56,
      "text": "No, um, it's at home. ORS, whenever I remember."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.51,
      "end_seconds": 133.18,
      "duration_seconds": 3.67,
      "text": "Alright, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.61,
      "end_seconds": 147.87,
      "duration_seconds": 13.26,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 153.2,
      "duration_seconds": 4.86,
      "text": "Any allergies I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.28,
      "end_seconds": 164.52,
      "duration_seconds": 10.24,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.16,
      "end_seconds": 184.4,
      "duration_seconds": 16.24,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.25,
      "end_seconds": 187.08,
      "duration_seconds": 1.83,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 191.59,
      "duration_seconds": 3.8,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.92,
      "end_seconds": 202.82,
      "duration_seconds": 10.9,
      "text": "I've had high blood pressure for about ten years now. I've had diabetes for two years now. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.24,
      "end_seconds": 205.45,
      "duration_seconds": 2.21,
      "text": "Alright. Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.86,
      "end_seconds": 211.75,
      "duration_seconds": 5.89,
      "text": "Hmm, yes, I had my tonsils out, when I was a child."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.52,
      "end_seconds": 214.24,
      "duration_seconds": 1.72,
      "text": "Okay, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.71,
      "end_seconds": 216.82,
      "duration_seconds": 2.11,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.36,
      "end_seconds": 219.35,
      "duration_seconds": 0.99,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.9,
      "end_seconds": 223.45,
      "duration_seconds": 2.55,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 227.78,
      "duration_seconds": 2.93,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.93,
      "end_seconds": 242.6,
      "duration_seconds": 13.67,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.63,
      "end_seconds": 246.52,
      "duration_seconds": 2.89,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.94,
      "end_seconds": 258.71,
      "duration_seconds": 1.77,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.37,
      "end_seconds": 281.43,
      "duration_seconds": 7.06,
      "text": "Okay: BP is 101 over 56, pulse is 108 beats a minute, temperature 36.5, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.31,
      "end_seconds": 283.48,
      "duration_seconds": 1.17,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.61,
      "end_seconds": 287.1,
      "duration_seconds": 2.49,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.41,
      "end_seconds": 292.5,
      "duration_seconds": 3.09,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.39,
      "end_seconds": 295.37,
      "duration_seconds": 1.98,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.0,
      "end_seconds": 307.65,
      "duration_seconds": 4.65,
      "text": "Your mouth is quite dry and the skin is a little slow to spring back."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 336.36,
      "duration_seconds": 23.65,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Putting it all together, my working impression is mild dehydration. That's my thinking for now, and it may change as we learn more. It could also be an electrolyte imbalance, so we'll keep that open."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.08,
      "end_seconds": 342.64,
      "duration_seconds": 5.56,
      "text": "Well, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.18,
      "end_seconds": 360.26,
      "duration_seconds": 17.08,
      "text": "It's reasonable to be concerned, but right now mild dehydration is my leading thought, not anything worse. Let me just recap so I've got it right. You've had dizziness when you stand up for about four days, moderate, and no confusion or vomiting."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.03,
      "end_seconds": 362.29,
      "duration_seconds": 1.26,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.85,
      "end_seconds": 376.48,
      "duration_seconds": 13.63,
      "text": "I'm going to order blood salts, for dehydration. I'd rather check than guess, and this is the quickest way to know more. We should do a kidney function test for dehydration. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.14,
      "end_seconds": 378.86,
      "duration_seconds": 1.72,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.41,
      "end_seconds": 400.03,
      "duration_seconds": 19.62,
      "text": "Small, frequent sips are better than a big glass at once, and keep going even if you don't feel thirsty. If you smoke, this is a good moment to think about stopping, and we can help you with that. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.02,
      "end_seconds": 407.91,
      "duration_seconds": 6.89,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.81,
      "end_seconds": 410.24,
      "duration_seconds": 1.43,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.54,
      "end_seconds": 418.62,
      "duration_seconds": 8.08,
      "text": "Please don't sit on it if you faint or can't keep any fluids down. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.67,
      "end_seconds": 421.35,
      "duration_seconds": 1.68,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.09,
      "end_seconds": 423.4,
      "duration_seconds": 1.31,
      "text": "Come back next week."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.09,
      "end_seconds": 424.79,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.06,
      "end_seconds": 430.19,
      "duration_seconds": 4.13,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.51,
      "end_seconds": 435.72,
      "duration_seconds": 4.21,
      "text": "So, um, I come back next week. Is that right?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.29,
      "end_seconds": 439.83,
      "duration_seconds": 2.54,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.17,
      "end_seconds": 447.52,
      "duration_seconds": 4.35,
      "text": "Well, okay, thank you. I'll get started on all of that."
    }
  ]
}