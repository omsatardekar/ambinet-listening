{
  "schema_version": "1.0",
  "encounter_id": "00097",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.52,
      "end_seconds": 2.98,
      "duration_seconds": 2.46,
      "text": "Good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.18,
      "end_seconds": 4.88,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.67,
      "end_seconds": 11.51,
      "duration_seconds": 5.84,
      "text": "Hmm, uh, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.8,
      "end_seconds": 16.37,
      "duration_seconds": 3.57,
      "text": "Absolutely, come and sit beside them. What brings you in today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.42,
      "end_seconds": 22.82,
      "duration_seconds": 5.4,
      "text": "Yeah, you know, we came because of red scaly patches on my elbows."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.35,
      "end_seconds": 27.51,
      "duration_seconds": 4.16,
      "text": "When did you first notice it? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.62,
      "end_seconds": 31.83,
      "duration_seconds": 3.21,
      "text": "It's been going on for about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.4,
      "end_seconds": 35.82,
      "duration_seconds": 3.42,
      "text": "I see. Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.34,
      "end_seconds": 42.4,
      "duration_seconds": 5.06,
      "text": "Hmm, I notice it more with stress and cold weather."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.67,
      "end_seconds": 45.18,
      "duration_seconds": 2.51,
      "text": "Alright. Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.86,
      "end_seconds": 66.6,
      "duration_seconds": 17.74,
      "text": "Stiff fingers in the morning goes along with it, most of the time. Okay, so I've had pitted nails too, for four weeks. I mean, you know, with stiff fingers in the morning, it's severe, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.97,
      "end_seconds": 69.92,
      "duration_seconds": 2.95,
      "text": "Any joint swelling, new medicines or weeping at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 75.16,
      "duration_seconds": 3.82,
      "text": "Hmm, no, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 77.07,
      "duration_seconds": 0.94,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.87,
      "end_seconds": 81.16,
      "duration_seconds": 3.29,
      "text": "Not at all, you know, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 81.99,
      "end_seconds": 87.81,
      "duration_seconds": 5.82,
      "text": "Um, actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 93.81,
      "duration_seconds": 5.04,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.66,
      "end_seconds": 102.6,
      "duration_seconds": 7.94,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has there been any sore throat before it started?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.61,
      "end_seconds": 108.42,
      "duration_seconds": 4.81,
      "text": "Hmm, not at all, no sore throat before it started."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.14,
      "end_seconds": 112.12,
      "duration_seconds": 2.98,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.41,
      "end_seconds": 115.21,
      "duration_seconds": 1.8,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 118.31,
      "duration_seconds": 2.61,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.77,
      "end_seconds": 121.68,
      "duration_seconds": 2.91,
      "text": "No, you know, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.48,
      "end_seconds": 123.57,
      "duration_seconds": 1.09,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.76,
      "end_seconds": 127.88,
      "duration_seconds": 3.12,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.66,
      "end_seconds": 130.98,
      "duration_seconds": 2.32,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 134.85,
      "duration_seconds": 2.94,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.38,
      "end_seconds": 139.09,
      "duration_seconds": 3.71,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.21,
      "end_seconds": 143.95,
      "duration_seconds": 3.74,
      "text": "Ibuprofen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.73,
      "end_seconds": 148.08,
      "duration_seconds": 3.35,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.87,
      "end_seconds": 158.95,
      "duration_seconds": 8.08,
      "text": "It's, It's metformin, 500 milligrams, twice a day. Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.34,
      "end_seconds": 161.94,
      "duration_seconds": 2.6,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.87,
      "end_seconds": 169.48,
      "duration_seconds": 6.61,
      "text": "About about a month. Paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 170.47,
      "end_seconds": 179.62,
      "duration_seconds": 9.15,
      "text": "So, doctor, I think the last prescription for the paracetamol was 325 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.27,
      "end_seconds": 183.59,
      "duration_seconds": 3.32,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.66,
      "end_seconds": 196.08,
      "duration_seconds": 11.42,
      "text": "Not with me. I'll bring it next time. I take coconut oil, daily. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.65,
      "end_seconds": 202.72,
      "duration_seconds": 6.07,
      "text": "What about your general health, any conditions you're being treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.14,
      "end_seconds": 221.81,
      "duration_seconds": 18.67,
      "text": "Well, I've had diabetes for two years now. I wasn't sure whether to come in at all, to be honest. I have high blood pressure, for nearly five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.02,
      "end_seconds": 223.72,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.66,
      "end_seconds": 228.96,
      "duration_seconds": 4.3,
      "text": "Uh, I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.54,
      "end_seconds": 237.46,
      "duration_seconds": 6.92,
      "text": "Okay, high blood pressure, that's already on your record. Good to know. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.61,
      "end_seconds": 248.16,
      "duration_seconds": 1.55,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.98,
      "end_seconds": 277.81,
      "duration_seconds": 9.83,
      "text": "Okay: respiratory rate 17, temperature is 37.0 degrees, pulse is 81 beats a minute, SpO2 98 percent on room air, blood pressure 116 over 73."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.75,
      "end_seconds": 281.69,
      "duration_seconds": 2.94,
      "text": "Uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.9,
      "end_seconds": 285.91,
      "duration_seconds": 3.01,
      "text": "Right, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.53,
      "end_seconds": 292.26,
      "duration_seconds": 3.73,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.64,
      "end_seconds": 295.72,
      "duration_seconds": 2.08,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.64,
      "end_seconds": 311.01,
      "duration_seconds": 3.37,
      "text": "Well-defined thick silvery plaques over both elbows and knees."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.32,
      "end_seconds": 314.21,
      "duration_seconds": 1.89,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.28,
      "end_seconds": 330.67,
      "duration_seconds": 2.39,
      "text": "A few small pits in the fingernails."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.1,
      "end_seconds": 357.32,
      "duration_seconds": 23.22,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. From what you've told me and what I found, I think we're dealing with plaque psoriasis at this stage. I want to be honest that this is an impression, not a final answer. It could also be eczema, so we'll keep that open."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.45,
      "end_seconds": 363.23,
      "duration_seconds": 4.78,
      "text": "Uh, you know, is this going to go away?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.36,
      "end_seconds": 393.2,
      "duration_seconds": 26.84,
      "text": "It's reasonable to be concerned, but right now plaque psoriasis is my leading thought, not anything worse. I'm going to order blood tests, for baseline before treatment. It's a routine test and it'll give us a much clearer picture. I'm prescribing calcipotriol-betamethasone gel, once a day, for four weeks. It's for psoriasis. I'll put all of this in writing so you don't have to remember it. A little sunlight helps psoriasis, but avoid sunburn. Moisturise often."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.64,
      "end_seconds": 408.15,
      "duration_seconds": 13.51,
      "text": "Don't skip meals, and try to eat smaller portions more often through the day. We'll refer you to a dermatologist. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 409.38,
      "end_seconds": 410.72,
      "duration_seconds": 1.34,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 412.15,
      "end_seconds": 417.52,
      "duration_seconds": 5.37,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 418.66,
      "end_seconds": 421.62,
      "duration_seconds": 2.96,
      "text": "Got it, you know, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.1,
      "end_seconds": 428.77,
      "duration_seconds": 5.67,
      "text": "Come back in six weeks. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 429.09,
      "end_seconds": 431.91,
      "duration_seconds": 2.82,
      "text": "Yeah, I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 433.51,
      "end_seconds": 434.21,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}