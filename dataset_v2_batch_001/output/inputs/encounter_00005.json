{
  "schema_version": "1.0",
  "encounter_id": "00005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.32,
      "duration_seconds": 3.0,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.73,
      "end_seconds": 9.34,
      "duration_seconds": 4.61,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.5,
      "end_seconds": 13.49,
      "duration_seconds": 2.99,
      "text": "So, I've been forgetting things lately, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.03,
      "end_seconds": 16.61,
      "duration_seconds": 2.58,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.15,
      "end_seconds": 35.67,
      "duration_seconds": 17.52,
      "text": "It's been going on for nearly five years. It's the not knowing that gets to me. I'm not great at remembering details, so bear with me. And I've been misplacing things as well. I've, I've also been repeating the same questions."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.09,
      "end_seconds": 39.86,
      "duration_seconds": 2.77,
      "text": "Have you been getting lost on familiar roads?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.36,
      "end_seconds": 44.34,
      "duration_seconds": 3.98,
      "text": "Yes, uh, about the same, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.41,
      "end_seconds": 51.39,
      "duration_seconds": 2.98,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.95,
      "end_seconds": 56.3,
      "duration_seconds": 3.35,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.75,
      "end_seconds": 58.46,
      "duration_seconds": 1.71,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.14,
      "end_seconds": 62.81,
      "duration_seconds": 3.67,
      "text": "Hmm, no, I haven't had any headache."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 67.31,
      "duration_seconds": 3.16,
      "text": "Any falls, weakness on one side or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.81,
      "end_seconds": 70.3,
      "duration_seconds": 2.49,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.24,
      "end_seconds": 72.82,
      "duration_seconds": 1.58,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.76,
      "end_seconds": 76.66,
      "duration_seconds": 2.9,
      "text": "Okay, so no, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.94,
      "end_seconds": 80.23,
      "duration_seconds": 2.29,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.52,
      "end_seconds": 83.29,
      "duration_seconds": 1.77,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.67,
      "end_seconds": 86.86,
      "duration_seconds": 2.19,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.51,
      "end_seconds": 89.66,
      "duration_seconds": 2.15,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.72,
      "end_seconds": 107.58,
      "duration_seconds": 5.86,
      "text": "Alright, I've got it. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.84,
      "end_seconds": 111.08,
      "duration_seconds": 2.24,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.51,
      "end_seconds": 115.16,
      "duration_seconds": 2.65,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.62,
      "end_seconds": 116.48,
      "duration_seconds": 0.86,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.52,
      "end_seconds": 131.94,
      "duration_seconds": 4.42,
      "text": "Right, thanks for waiting. Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.3,
      "end_seconds": 147.65,
      "duration_seconds": 15.35,
      "text": "Hmm, I've got high blood pressure. I'm hoping you can tell me something definite. So, uh, I've had high cholesterol for about a year now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.38,
      "end_seconds": 165.61,
      "duration_seconds": 17.23,
      "text": "Mm. Right, so that's your known high blood pressure. We'll keep that in mind today. I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.09,
      "end_seconds": 168.88,
      "duration_seconds": 1.79,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.42,
      "end_seconds": 172.68,
      "duration_seconds": 2.26,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.05,
      "end_seconds": 180.25,
      "duration_seconds": 6.2,
      "text": "Right, it's telmisartan, 40 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.57,
      "end_seconds": 183.23,
      "duration_seconds": 2.66,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.18,
      "end_seconds": 191.03,
      "duration_seconds": 6.85,
      "text": "So, not with me. I'll bring it next time. Atorvastatin. I take it at night."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.51,
      "end_seconds": 197.1,
      "duration_seconds": 1.59,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.49,
      "end_seconds": 199.42,
      "duration_seconds": 0.93,
      "text": "20 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.21,
      "end_seconds": 202.92,
      "duration_seconds": 2.71,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.67,
      "end_seconds": 218.83,
      "duration_seconds": 15.16,
      "text": "So, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.19,
      "end_seconds": 222.49,
      "duration_seconds": 2.3,
      "text": "Right, any operations in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.87,
      "end_seconds": 226.75,
      "duration_seconds": 3.88,
      "text": "Hmm, just a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.68,
      "end_seconds": 230.6,
      "duration_seconds": 2.92,
      "text": "I'm just saving what we've covered so far."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.43,
      "end_seconds": 251.53,
      "duration_seconds": 5.1,
      "text": "Good, where were we. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.92,
      "end_seconds": 257.19,
      "duration_seconds": 5.27,
      "text": "Um, my father had a heart attack. My father had kidney stones."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.71,
      "end_seconds": 262.4,
      "duration_seconds": 3.69,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.13,
      "end_seconds": 266.73,
      "duration_seconds": 3.6,
      "text": "I, I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 271.11,
      "duration_seconds": 2.86,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.28,
      "end_seconds": 282.77,
      "duration_seconds": 1.49,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.82,
      "end_seconds": 307.78,
      "duration_seconds": 4.96,
      "text": "Okay: respiratory rate 18, blood pressure 120 over 80, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.35,
      "end_seconds": 312.43,
      "duration_seconds": 4.08,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.1,
      "end_seconds": 314.03,
      "duration_seconds": 0.93,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.62,
      "end_seconds": 322.03,
      "duration_seconds": 1.41,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.79,
      "end_seconds": 327.51,
      "duration_seconds": 3.72,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.68,
      "end_seconds": 330.79,
      "duration_seconds": 2.11,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.31,
      "end_seconds": 353.37,
      "duration_seconds": 4.06,
      "text": "Your gait is steady and the tone in your limbs is normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.31,
      "end_seconds": 364.98,
      "duration_seconds": 6.67,
      "text": "Okay, you can sit back up. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.5,
      "end_seconds": 377.81,
      "duration_seconds": 11.31,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.31,
      "end_seconds": 391.76,
      "duration_seconds": 12.45,
      "text": "Putting it all together, my working impression is memory difficulties that need to be worked up. That's my thinking for now, and it may change as we learn more. I can't rule out a vitamin deficiency yet."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.95,
      "end_seconds": 395.55,
      "duration_seconds": 2.6,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.87,
      "end_seconds": 410.4,
      "duration_seconds": 14.53,
      "text": "I can't promise yet, but most people with memory difficulties that need to be worked up do well once it's treated properly. Let me just recap so I've got it right. You've been forgetting things lately for nearly five years, and no headache or low mood."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.9,
      "end_seconds": 414.27,
      "duration_seconds": 2.37,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.74,
      "end_seconds": 417.26,
      "duration_seconds": 2.52,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.69,
      "end_seconds": 419.21,
      "duration_seconds": 1.52,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.25,
      "end_seconds": 427.7,
      "duration_seconds": 7.45,
      "text": "I'm going to order a thyroid test, for memory loss. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 429.15,
      "end_seconds": 432.84,
      "duration_seconds": 3.69,
      "text": "I can book that for Monday at 11:30 am."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.42,
      "end_seconds": 434.23,
      "duration_seconds": 0.81,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.83,
      "end_seconds": 440.14,
      "duration_seconds": 4.31,
      "text": "I'd like to arrange a CT scan of the head for memory loss."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 441.49,
      "end_seconds": 444.65,
      "duration_seconds": 3.16,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.25,
      "end_seconds": 460.64,
      "duration_seconds": 14.39,
      "text": "Keep a daily routine and write things down, a notebook by the door works well. Don't skip meals, and try to eat smaller portions more often through the day. I'd like you to see the memory clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 461.41,
      "end_seconds": 463.7,
      "duration_seconds": 2.29,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.06,
      "end_seconds": 472.41,
      "duration_seconds": 7.35,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 473.47,
      "end_seconds": 475.03,
      "duration_seconds": 1.56,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 475.69,
      "end_seconds": 482.43,
      "duration_seconds": 6.74,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 483.52,
      "end_seconds": 484.22,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 485.81,
      "end_seconds": 493.75,
      "duration_seconds": 7.94,
      "text": "Come back after the results are back. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 495.15,
      "end_seconds": 501.03,
      "duration_seconds": 5.88,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 501.88,
      "end_seconds": 504.28,
      "duration_seconds": 2.4,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 504.73,
      "end_seconds": 507.48,
      "duration_seconds": 2.75,
      "text": "Right, alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 508.95,
      "end_seconds": 511.08,
      "duration_seconds": 2.13,
      "text": "Bye for now, look after yourself."
    }
  ]
}