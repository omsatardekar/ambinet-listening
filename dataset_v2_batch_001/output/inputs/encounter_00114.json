{
  "schema_version": "1.0",
  "encounter_id": "00114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 3.68,
      "duration_seconds": 2.47,
      "text": "Evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.39,
      "end_seconds": 5.22,
      "duration_seconds": 0.83,
      "text": "Thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 8.7,
      "duration_seconds": 2.11,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 19.94,
      "duration_seconds": 8.13,
      "text": "It's, It's heartburn. I thought I'd wait, but it hasn't gone. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.38,
      "end_seconds": 22.41,
      "duration_seconds": 2.03,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.82,
      "end_seconds": 25.65,
      "duration_seconds": 2.83,
      "text": "Oh, lying down definitely sets it off."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.12,
      "end_seconds": 26.82,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.84,
      "end_seconds": 31.36,
      "duration_seconds": 3.52,
      "text": "And a lump feeling in the throat, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.53,
      "end_seconds": 34.86,
      "duration_seconds": 2.33,
      "text": "Have you had chest discomfort after eating?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.49,
      "end_seconds": 41.89,
      "duration_seconds": 6.4,
      "text": "Mm, um, yes. Hmm, with chest discomfort after eating, I'd say severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.54,
      "end_seconds": 45.93,
      "duration_seconds": 3.39,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.36,
      "end_seconds": 48.94,
      "duration_seconds": 2.58,
      "text": "I, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.2,
      "end_seconds": 54.36,
      "duration_seconds": 4.16,
      "text": "Let me check a few things. Any anaemia or black stools?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.86,
      "end_seconds": 59.02,
      "duration_seconds": 3.16,
      "text": "So, no, none of that at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 63.75,
      "duration_seconds": 3.87,
      "text": "Have you had any weight loss, trouble swallowing or vomiting blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.78,
      "end_seconds": 67.01,
      "duration_seconds": 2.23,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.86,
      "end_seconds": 69.85,
      "duration_seconds": 1.99,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.13,
      "end_seconds": 72.81,
      "duration_seconds": 1.68,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.71,
      "end_seconds": 75.91,
      "duration_seconds": 2.2,
      "text": "Okay, any operations in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.28,
      "end_seconds": 82.84,
      "duration_seconds": 5.56,
      "text": "Yes, I had a stent put in my heart, two years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.25,
      "end_seconds": 87.76,
      "duration_seconds": 3.51,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.55,
      "end_seconds": 89.42,
      "duration_seconds": 0.87,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.15,
      "end_seconds": 108.13,
      "duration_seconds": 4.98,
      "text": "Okay, here we go. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.63,
      "end_seconds": 113.71,
      "duration_seconds": 2.08,
      "text": "It's Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.64,
      "end_seconds": 120.4,
      "duration_seconds": 5.76,
      "text": "What about allergies, to medicines or foods or anything else? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.02,
      "end_seconds": 123.94,
      "duration_seconds": 2.92,
      "text": "Not that I know, um, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.85,
      "end_seconds": 128.61,
      "duration_seconds": 3.76,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.04,
      "end_seconds": 137.66,
      "duration_seconds": 7.62,
      "text": "Hmm, I have asthma, for two years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.19,
      "end_seconds": 141.27,
      "duration_seconds": 1.08,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.49,
      "end_seconds": 158.5,
      "duration_seconds": 13.01,
      "text": "Right, I've got heart disease. I wasn't sure whether to come in at all, to be honest. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.92,
      "end_seconds": 165.12,
      "duration_seconds": 5.2,
      "text": "Okay, asthma, that's already on your record. Good to know. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.08,
      "end_seconds": 174.39,
      "duration_seconds": 1.31,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.6,
      "end_seconds": 193.61,
      "duration_seconds": 5.01,
      "text": "Okay: BP is 126 over 73, temperature is 36.7 degrees, heart rate 78."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.32,
      "end_seconds": 195.98,
      "duration_seconds": 1.66,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.54,
      "end_seconds": 199.14,
      "duration_seconds": 2.6,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.45,
      "end_seconds": 205.71,
      "duration_seconds": 4.26,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.11,
      "end_seconds": 207.81,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.56,
      "end_seconds": 211.83,
      "duration_seconds": 2.27,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.13,
      "end_seconds": 225.95,
      "duration_seconds": 1.82,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.51,
      "end_seconds": 227.21,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.43,
      "end_seconds": 237.91,
      "duration_seconds": 8.48,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.9,
      "end_seconds": 242.31,
      "duration_seconds": 3.41,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.75,
      "end_seconds": 243.52,
      "duration_seconds": 0.77,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.37,
      "end_seconds": 269.8,
      "duration_seconds": 13.43,
      "text": "Okay, here we go. Right, here's what I'm thinking. I think we're dealing with gastro-oesophageal reflux at this stage. The reason I say that is that your story and my examination fit together. I can't rule out gastritis yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.53,
      "end_seconds": 272.48,
      "duration_seconds": 1.95,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.78,
      "end_seconds": 285.77,
      "duration_seconds": 12.99,
      "text": "I understand the worry. At the moment I'd say it's gastro-oesophageal reflux, and we'll know more once the an upper endoscopy is back. Let me just recap so I've got it right. You've had heartburn, and no anaemia or trouble swallowing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.1,
      "end_seconds": 287.3,
      "duration_seconds": 1.2,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 291.32,
      "duration_seconds": 3.08,
      "text": "I'd like to arrange an upper endoscopy for persistent reflux."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.9,
      "end_seconds": 293.12,
      "duration_seconds": 1.22,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.66,
      "end_seconds": 312.64,
      "duration_seconds": 18.98,
      "text": "I'm going to order an ECG, for chest discomfort. That will help us see what's going on underneath and decide the next step. Let's use esomeprazole, 40 milligrams, before breakfast, for eight weeks. That should help with reflux. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.62,
      "end_seconds": 329.94,
      "duration_seconds": 16.32,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. I'd like to see you again in eight weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.41,
      "end_seconds": 332.11,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.52,
      "end_seconds": 338.79,
      "duration_seconds": 6.27,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.86,
      "end_seconds": 348.35,
      "duration_seconds": 8.49,
      "text": "So, I take the esomeprazole, 40 milligrams, before breakfast and come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.85,
      "end_seconds": 353.2,
      "duration_seconds": 4.35,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.11,
      "end_seconds": 356.71,
      "duration_seconds": 2.6,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.76,
      "end_seconds": 358.55,
      "duration_seconds": 0.79,
      "text": "Alright, goodbye."
    }
  ]
}