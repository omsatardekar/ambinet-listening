{
  "schema_version": "1.0",
  "encounter_id": "00017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.43,
      "duration_seconds": 3.58,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.62,
      "end_seconds": 8.71,
      "duration_seconds": 3.09,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.38,
      "end_seconds": 17.72,
      "duration_seconds": 8.34,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed. It's blurry vision, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 20.61,
      "duration_seconds": 2.14,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.08,
      "end_seconds": 28.97,
      "duration_seconds": 6.89,
      "text": "For about a month, I'd say. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.46,
      "end_seconds": 33.47,
      "duration_seconds": 4.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.69,
      "end_seconds": 38.96,
      "duration_seconds": 4.27,
      "text": "Severe, I'd say. Yes, reading. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.42,
      "end_seconds": 41.42,
      "duration_seconds": 2.0,
      "text": "Have you had headaches after reading?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.89,
      "end_seconds": 59.12,
      "duration_seconds": 16.23,
      "text": "Yes, for two years. As for headaches after reading, I'd give it a seven, out of ten. I'd say a few times a day. Oh, and tired eyes. That's been about the same, about a year. With tired eyes, I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.26,
      "end_seconds": 64.62,
      "duration_seconds": 4.36,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.49,
      "end_seconds": 75.07,
      "duration_seconds": 9.58,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.03,
      "end_seconds": 78.15,
      "duration_seconds": 2.12,
      "text": "Any floaters or redness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.07,
      "end_seconds": 80.85,
      "duration_seconds": 1.78,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.21,
      "end_seconds": 88.01,
      "duration_seconds": 5.8,
      "text": "Let me check a few things. Any flashes of light, eye pain or double vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.48,
      "end_seconds": 94.7,
      "duration_seconds": 6.22,
      "text": "Um, I haven't had flashes of light, eye pain or double vision, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.12,
      "end_seconds": 97.55,
      "duration_seconds": 2.43,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.39,
      "end_seconds": 100.16,
      "duration_seconds": 1.77,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.83,
      "end_seconds": 103.23,
      "duration_seconds": 2.4,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.93,
      "end_seconds": 104.7,
      "duration_seconds": 0.77,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.95,
      "end_seconds": 118.55,
      "duration_seconds": 2.6,
      "text": "Right, thanks for waiting. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.17,
      "end_seconds": 120.85,
      "duration_seconds": 1.68,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.27,
      "end_seconds": 124.85,
      "duration_seconds": 2.58,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.49,
      "end_seconds": 134.06,
      "duration_seconds": 8.57,
      "text": "It's metformin, 500 milligrams, twice a day for my sugar. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.38,
      "end_seconds": 136.94,
      "duration_seconds": 2.56,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.59,
      "end_seconds": 144.35,
      "duration_seconds": 6.76,
      "text": "About a year now. I take losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 145.41,
      "end_seconds": 153.82,
      "duration_seconds": 8.41,
      "text": "Okay, so doctor, I think the last prescription for the losartan was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.33,
      "end_seconds": 158.91,
      "duration_seconds": 3.58,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.91,
      "end_seconds": 166.34,
      "duration_seconds": 6.43,
      "text": "Not with me. I'll bring it next time. I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.7,
      "end_seconds": 169.95,
      "duration_seconds": 2.25,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.69,
      "end_seconds": 172.42,
      "duration_seconds": 1.73,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.91,
      "end_seconds": 177.99,
      "duration_seconds": 4.08,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.32,
      "end_seconds": 186.04,
      "duration_seconds": 4.72,
      "text": "Okay, so my father was diabetic. My father had a stroke."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.03,
      "end_seconds": 190.95,
      "duration_seconds": 3.92,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.38,
      "end_seconds": 193.76,
      "duration_seconds": 2.38,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.19,
      "end_seconds": 201.38,
      "duration_seconds": 7.19,
      "text": "Do you have any medical conditions, anything you've been treated for? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.63,
      "end_seconds": 220.57,
      "duration_seconds": 17.94,
      "text": "Diabetes, for about a year. I thought it would sort itself out, but it hasn't. I've had high blood pressure for nearly five years now. I'm hoping you can tell me something definite. So, I've had low haemoglobin for about ten years now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.01,
      "end_seconds": 225.65,
      "duration_seconds": 4.64,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 226.11,
      "end_seconds": 232.51,
      "duration_seconds": 6.4,
      "text": "Doctor, I've got the readings for you. Blood pressure 108 over 71, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.98,
      "end_seconds": 250.07,
      "duration_seconds": 16.09,
      "text": "Good, thank you. Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 253.85,
      "duration_seconds": 3.14,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.48,
      "end_seconds": 259.38,
      "duration_seconds": 3.9,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.06,
      "end_seconds": 263.22,
      "duration_seconds": 2.16,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 279.31,
      "duration_seconds": 3.26,
      "text": "Vision without glasses is six over twelve in both eyes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.66,
      "end_seconds": 282.35,
      "duration_seconds": 1.69,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.42,
      "end_seconds": 295.24,
      "duration_seconds": 2.82,
      "text": "The lens looks a little cloudy on both sides."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.95,
      "end_seconds": 318.38,
      "duration_seconds": 17.43,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. From what you've told me and what I found, it fits best with a refractive problem or early cataracts. I can't rule out diabetic eye changes yet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.55,
      "end_seconds": 324.55,
      "duration_seconds": 5.0,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.89,
      "end_seconds": 341.36,
      "duration_seconds": 15.47,
      "text": "It's reasonable to be concerned, but right now a refractive problem or early cataracts is my leading thought, not anything worse. Let me just recap so I've got it right. You've had blurry vision for about a month, severe, and no double vision or eye pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.57,
      "end_seconds": 344.02,
      "duration_seconds": 1.45,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.43,
      "end_seconds": 363.56,
      "duration_seconds": 18.13,
      "text": "I'd like to arrange an eye pressure check for blurred vision. It's a routine test and it'll give us a much clearer picture. I'm going to order a dilated eye examination, for blurred vision. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.45,
      "end_seconds": 367.46,
      "duration_seconds": 3.01,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.94,
      "end_seconds": 394.56,
      "duration_seconds": 26.62,
      "text": "Get a proper glasses test, and keep your sugar and blood pressure well controlled for your eyes. Don't skip meals, and try to eat smaller portions more often through the day. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.93,
      "end_seconds": 397.39,
      "duration_seconds": 1.46,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.89,
      "end_seconds": 405.97,
      "duration_seconds": 8.08,
      "text": "I want you to come back or go to emergency straight away if you get sudden loss of vision or a curtain across your sight."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.4,
      "end_seconds": 409.86,
      "duration_seconds": 2.46,
      "text": "Got it, uh, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.34,
      "end_seconds": 413.23,
      "duration_seconds": 2.89,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.06,
      "end_seconds": 415.74,
      "duration_seconds": 1.68,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.06,
      "end_seconds": 421.08,
      "duration_seconds": 4.02,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.95,
      "end_seconds": 426.2,
      "duration_seconds": 4.25,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.75,
      "end_seconds": 431.73,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.35,
      "end_seconds": 434.53,
      "duration_seconds": 2.18,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.01,
      "end_seconds": 436.71,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}