{
  "schema_version": "1.0",
  "encounter_id": "00454",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 3.14,
      "duration_seconds": 2.01,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.64,
      "end_seconds": 6.8,
      "duration_seconds": 3.16,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.02,
      "end_seconds": 14.44,
      "duration_seconds": 3.42,
      "text": "Please do. Extra information is always welcome. Did you come far?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.18,
      "end_seconds": 19.39,
      "duration_seconds": 4.21,
      "text": "Not too far, about half an hour by bus."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.69,
      "end_seconds": 21.92,
      "duration_seconds": 2.23,
      "text": "In your own words, what's happened?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.91,
      "end_seconds": 32.4,
      "duration_seconds": 9.49,
      "text": "It's trouble hearing in my left ear. I thought I'd wait, um, but it hasn't gone. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.41,
      "end_seconds": 36.53,
      "duration_seconds": 3.12,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.05,
      "end_seconds": 49.53,
      "duration_seconds": 11.48,
      "text": "About... well, two months. My sister suggested writing things down, but I forgot. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.13,
      "end_seconds": 52.94,
      "duration_seconds": 2.81,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.37,
      "end_seconds": 54.5,
      "duration_seconds": 1.13,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.88,
      "end_seconds": 57.57,
      "duration_seconds": 2.69,
      "text": "Okay, does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 58.81,
      "end_seconds": 61.32,
      "duration_seconds": 2.51,
      "text": "It usually comes with a ringing noise."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.92,
      "end_seconds": 68.04,
      "duration_seconds": 6.12,
      "text": "I mean, um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 68.14,
      "end_seconds": 73.46,
      "duration_seconds": 5.32,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.8,
      "end_seconds": 80.62,
      "duration_seconds": 5.82,
      "text": "Right, later, thanks. Please go on. Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.17,
      "end_seconds": 83.85,
      "duration_seconds": 2.68,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.35,
      "end_seconds": 86.95,
      "duration_seconds": 2.6,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.49,
      "end_seconds": 90.67,
      "duration_seconds": 3.18,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.12,
      "end_seconds": 96.19,
      "duration_seconds": 4.07,
      "text": "Let me check a few things. Any facial weakness, discharge or dizziness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.81,
      "end_seconds": 113.31,
      "duration_seconds": 12.5,
      "text": "No, no facial weakness, no discharge, no dizziness. I did have a feeling of fullness in the ear at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.09,
      "end_seconds": 116.31,
      "duration_seconds": 2.22,
      "text": "Have you had any ear pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.27,
      "end_seconds": 118.8,
      "duration_seconds": 1.53,
      "text": "No. No ear pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.75,
      "end_seconds": 121.96,
      "duration_seconds": 2.21,
      "text": "So, and headache, any of that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.64,
      "end_seconds": 125.64,
      "duration_seconds": 3.0,
      "text": "Not at all, um, no headache."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 126.39,
      "end_seconds": 130.11,
      "duration_seconds": 3.72,
      "text": "Actually, doctor, I did notice headache. He doesn't always say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 136.44,
      "duration_seconds": 5.22,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.75,
      "end_seconds": 143.43,
      "duration_seconds": 5.68,
      "text": "Alright, I'll note both what you've said and what you've noticed. So, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.05,
      "end_seconds": 145.48,
      "duration_seconds": 1.43,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.98,
      "end_seconds": 150.09,
      "duration_seconds": 3.11,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.14,
      "end_seconds": 152.46,
      "duration_seconds": 1.32,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.38,
      "end_seconds": 167.17,
      "duration_seconds": 13.79,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 168.14,
      "end_seconds": 170.07,
      "duration_seconds": 1.93,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 171.02,
      "end_seconds": 177.16,
      "duration_seconds": 6.14,
      "text": "Here are the numbers, doctor. Heart rate 71, temp 36.6 degrees, blood pressure 127 over 68."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.09,
      "end_seconds": 180.31,
      "duration_seconds": 2.22,
      "text": "Okay, noted. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.52,
      "end_seconds": 185.44,
      "duration_seconds": 3.92,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.88,
      "end_seconds": 186.81,
      "duration_seconds": 0.93,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.63,
      "end_seconds": 190.88,
      "duration_seconds": 3.25,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 194.96,
      "duration_seconds": 3.38,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.55,
      "end_seconds": 205.47,
      "duration_seconds": 9.92,
      "text": "I've got high blood pressure. I've got diabetes. I thought it would sort itself out, but it hasn't. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.67,
      "end_seconds": 209.62,
      "duration_seconds": 2.95,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.35,
      "end_seconds": 211.11,
      "duration_seconds": 0.76,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 222.03,
      "duration_seconds": 4.65,
      "text": "Alright, I've got it. What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.24,
      "end_seconds": 226.4,
      "duration_seconds": 3.16,
      "text": "I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 227.64,
      "end_seconds": 231.45,
      "duration_seconds": 3.81,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.89,
      "end_seconds": 236.23,
      "duration_seconds": 3.34,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.42,
      "end_seconds": 245.33,
      "duration_seconds": 7.91,
      "text": "Right, not with me. I'll bring it next time. I take glimepiride, 2 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.85,
      "end_seconds": 249.46,
      "duration_seconds": 2.61,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.82,
      "end_seconds": 255.49,
      "duration_seconds": 5.67,
      "text": "No, it's at home. I was on amlodipine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.19,
      "end_seconds": 269.52,
      "duration_seconds": 13.33,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.86,
      "end_seconds": 273.79,
      "duration_seconds": 3.93,
      "text": "Well, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.57,
      "end_seconds": 282.46,
      "duration_seconds": 7.89,
      "text": "Do you have any allergies to medicines, food, anything at all? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.17,
      "end_seconds": 283.96,
      "duration_seconds": 0.79,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.54,
      "end_seconds": 286.83,
      "duration_seconds": 2.29,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.03,
      "end_seconds": 290.97,
      "duration_seconds": 2.94,
      "text": "My mother has migraines. My sister has epilepsy."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.27,
      "end_seconds": 295.69,
      "duration_seconds": 3.42,
      "text": "Alright, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.94,
      "end_seconds": 297.64,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.53,
      "end_seconds": 301.37,
      "duration_seconds": 2.84,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.97,
      "end_seconds": 319.82,
      "duration_seconds": 2.85,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.67,
      "end_seconds": 323.77,
      "duration_seconds": 2.1,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.22,
      "end_seconds": 340.55,
      "duration_seconds": 5.33,
      "text": "There's a lot of wax in the left ear canal, I can't see the drum."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.82,
      "end_seconds": 366.17,
      "duration_seconds": 21.35,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Right, here's what I'm thinking. It fits best with hearing loss from wax. Age-related hearing loss is also on my list. An inner ear problem is also on my list."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.64,
      "end_seconds": 377.28,
      "duration_seconds": 9.64,
      "text": "Let me just recap so I've got it right. You've had trouble hearing in your left ear for two months, mild, and no ear pain or discharge."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 377.68,
      "end_seconds": 379.81,
      "duration_seconds": 2.13,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.07,
      "end_seconds": 394.31,
      "duration_seconds": 13.24,
      "text": "We should do a hearing test for hearing loss. I'd like you to take ear drops, three times a day, for five days. It's for wax softening. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 395.5,
      "end_seconds": 398.27,
      "duration_seconds": 2.77,
      "text": "Right, um, I'll remember that."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 399.15,
      "end_seconds": 416.7,
      "duration_seconds": 17.55,
      "text": "Please don't use cotton buds or ear candles, they push the wax in further. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 418.23,
      "end_seconds": 419.58,
      "duration_seconds": 1.35,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.67,
      "end_seconds": 429.86,
      "duration_seconds": 9.19,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse. Please come and see me in a week."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 430.88,
      "end_seconds": 431.58,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 433.1,
      "end_seconds": 439.21,
      "duration_seconds": 6.11,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 440.61,
      "end_seconds": 444.68,
      "duration_seconds": 4.07,
      "text": "So, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.3,
      "end_seconds": 452.0,
      "duration_seconds": 3.7,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 452.92,
      "end_seconds": 456.77,
      "duration_seconds": 3.85,
      "text": "Uh, that's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.27,
      "end_seconds": 458.02,
      "duration_seconds": 0.75,
      "text": "Take care."
    }
  ]
}