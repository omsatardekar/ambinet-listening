{
  "schema_version": "1.0",
  "encounter_id": "00250",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.97,
      "end_seconds": 6.35,
      "duration_seconds": 5.38,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.7,
      "end_seconds": 12.5,
      "duration_seconds": 2.8,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.75,
      "end_seconds": 19.13,
      "duration_seconds": 5.38,
      "text": "Yeah, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.21,
      "end_seconds": 23.16,
      "duration_seconds": 2.95,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 23.74,
      "end_seconds": 33.67,
      "duration_seconds": 9.93,
      "text": "Well, doctor, it's trouble hearing in my left ear. It's getting on my nerves now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.06,
      "end_seconds": 38.6,
      "duration_seconds": 3.54,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.61,
      "end_seconds": 47.39,
      "duration_seconds": 7.78,
      "text": "Oh, uh, it's been about a month now. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.86,
      "end_seconds": 50.77,
      "duration_seconds": 1.91,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.69,
      "end_seconds": 53.1,
      "duration_seconds": 1.41,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.74,
      "end_seconds": 58.62,
      "duration_seconds": 4.88,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 58.72,
      "end_seconds": 64.53,
      "duration_seconds": 5.81,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.1,
      "end_seconds": 71.31,
      "duration_seconds": 5.21,
      "text": "Later, thanks. Please go on. What about a ringing noise, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.63,
      "end_seconds": 75.37,
      "duration_seconds": 3.74,
      "text": "Well, yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.12,
      "end_seconds": 81.78,
      "duration_seconds": 5.66,
      "text": "Have you had trouble hearing in your left ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.89,
      "end_seconds": 92.27,
      "duration_seconds": 7.38,
      "text": "Hmm, um, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.5,
      "end_seconds": 94.43,
      "duration_seconds": 0.93,
      "text": "What about dizziness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.51,
      "end_seconds": 98.96,
      "duration_seconds": 3.45,
      "text": "No, uh, I haven't had any dizziness."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.76,
      "end_seconds": 104.97,
      "duration_seconds": 5.21,
      "text": "Yeah, actually, doctor, I did notice dizziness. She doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.97,
      "end_seconds": 111.87,
      "duration_seconds": 5.9,
      "text": "Uh, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.41,
      "end_seconds": 120.87,
      "duration_seconds": 8.46,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any facial weakness, ear pain, headache or discharge at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.89,
      "end_seconds": 134.92,
      "duration_seconds": 13.03,
      "text": "No, no facial weakness, no ear pain, no headache. I did have a feeling of fullness in the ear at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.63,
      "end_seconds": 137.75,
      "duration_seconds": 2.12,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.23,
      "end_seconds": 140.13,
      "duration_seconds": 1.9,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.96,
      "end_seconds": 143.39,
      "duration_seconds": 2.43,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.91,
      "end_seconds": 145.78,
      "duration_seconds": 1.87,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.23,
      "end_seconds": 148.56,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.96,
      "end_seconds": 151.05,
      "duration_seconds": 2.09,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.95,
      "end_seconds": 154.88,
      "duration_seconds": 2.93,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.61,
      "end_seconds": 157.83,
      "duration_seconds": 2.22,
      "text": "Yes, pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.07,
      "end_seconds": 160.19,
      "duration_seconds": 1.12,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.14,
      "end_seconds": 164.53,
      "duration_seconds": 3.39,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.32,
      "end_seconds": 169.35,
      "duration_seconds": 4.03,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 170.49,
      "end_seconds": 175.07,
      "duration_seconds": 4.58,
      "text": "Uh, my mother has migraines. My father had kidney stones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.07,
      "end_seconds": 179.99,
      "duration_seconds": 3.92,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.99,
      "end_seconds": 189.41,
      "duration_seconds": 8.42,
      "text": "I take ramipril, 5 milligrams, every morning. Well, I take Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 193.31,
      "end_seconds": 200.86,
      "duration_seconds": 7.55,
      "text": "Doctor, I think the last prescription for the Glycomet was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.26,
      "end_seconds": 204.52,
      "duration_seconds": 3.26,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.03,
      "end_seconds": 213.38,
      "duration_seconds": 7.35,
      "text": "Um, I don't think I have it with me. Paracetamol. I take it 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.83,
      "end_seconds": 216.54,
      "duration_seconds": 2.71,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.36,
      "end_seconds": 230.23,
      "duration_seconds": 12.87,
      "text": "Nearly five years now. Escitalopram. I take it 10 milligrams, once a day for the anxiety. I'd been on glimepiride, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.79,
      "end_seconds": 235.21,
      "duration_seconds": 3.42,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.07,
      "end_seconds": 243.19,
      "duration_seconds": 7.12,
      "text": "I've had high blood pressure, yes. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.55,
      "end_seconds": 244.25,
      "duration_seconds": 0.7,
      "text": "I see."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.83,
      "end_seconds": 254.46,
      "duration_seconds": 8.63,
      "text": "Diabetes, for two years. Sorry, I know I'm rambling a bit. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 255.96,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.79,
      "end_seconds": 267.27,
      "duration_seconds": 10.48,
      "text": "I, I have arthritis in my knees, for two years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.23,
      "end_seconds": 269.16,
      "duration_seconds": 0.93,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 270.58,
      "end_seconds": 274.36,
      "duration_seconds": 3.78,
      "text": "I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.04,
      "end_seconds": 285.62,
      "duration_seconds": 10.58,
      "text": "Yes, I can see the high blood pressure in your file as well. Right, so that's your known anxiety. We'll keep that in mind today. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.65,
      "end_seconds": 302.29,
      "duration_seconds": 15.64,
      "text": "Not really, um, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 302.81,
      "end_seconds": 311.3,
      "duration_seconds": 8.49,
      "text": "Okay, so the vitals from earlier. Saturation 99 percent, blood pressure 109 over 81. Pulse 77, temperature is 36.5 degrees, respiratory rate 17."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.06,
      "end_seconds": 312.81,
      "duration_seconds": 0.75,
      "text": "Alright, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.4,
      "end_seconds": 317.38,
      "duration_seconds": 2.98,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 317.75,
      "end_seconds": 318.45,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.95,
      "end_seconds": 322.63,
      "duration_seconds": 2.68,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.6,
      "end_seconds": 341.37,
      "duration_seconds": 2.77,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.63,
      "end_seconds": 344.36,
      "duration_seconds": 1.73,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.7,
      "end_seconds": 367.02,
      "duration_seconds": 5.32,
      "text": "There's a lot of wax in the left ear canal, I can't see the drum."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 367.39,
      "end_seconds": 368.88,
      "duration_seconds": 1.49,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.8,
      "end_seconds": 400.08,
      "duration_seconds": 25.28,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Right, here's what I'm thinking. I think we're dealing with hearing loss from wax at this stage. The reason I say that is that your story and my examination fit together. Age-related hearing loss is also on my list. I can't rule out an inner ear problem yet."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.24,
      "end_seconds": 426.91,
      "duration_seconds": 25.67,
      "text": "We should do a hearing test for hearing loss. That will help us see what's going on underneath and decide the next step. I'm prescribing ear drops, three times a day, for five days. It's for wax softening. Please don't use cotton buds or ear candles, they push the wax in further. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.9,
      "end_seconds": 444.59,
      "duration_seconds": 14.69,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 445.33,
      "end_seconds": 446.92,
      "duration_seconds": 1.59,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.48,
      "end_seconds": 454.18,
      "duration_seconds": 5.7,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 454.68,
      "end_seconds": 455.38,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.82,
      "end_seconds": 459.99,
      "duration_seconds": 3.17,
      "text": "Please come and see me after the hearing test."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 460.56,
      "end_seconds": 465.03,
      "duration_seconds": 4.47,
      "text": "Yeah, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.4,
      "end_seconds": 468.88,
      "duration_seconds": 2.48,
      "text": "Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 470.3,
      "end_seconds": 471.86,
      "duration_seconds": 1.56,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.77,
      "end_seconds": 475.63,
      "duration_seconds": 0.86,
      "text": "Alright, goodbye."
    }
  ]
}