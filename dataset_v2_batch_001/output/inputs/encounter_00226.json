{
  "schema_version": "1.0",
  "encounter_id": "00226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 4.04,
      "duration_seconds": 2.81,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 8.22,
      "duration_seconds": 2.71,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.52,
      "end_seconds": 16.2,
      "duration_seconds": 7.68,
      "text": "I mean, um, mainly my heart racing. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.62,
      "end_seconds": 19.5,
      "duration_seconds": 1.88,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.94,
      "end_seconds": 25.09,
      "duration_seconds": 5.15,
      "text": "Probably four weeks. Yeah. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 30.07,
      "duration_seconds": 3.74,
      "text": "So, what's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.01,
      "end_seconds": 33.32,
      "duration_seconds": 2.31,
      "text": "Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.28,
      "end_seconds": 35.84,
      "duration_seconds": 1.56,
      "text": "Have you had lightheadedness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.36,
      "end_seconds": 41.23,
      "duration_seconds": 3.87,
      "text": "Yes, actually. I'd been sweating, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.73,
      "end_seconds": 56.16,
      "duration_seconds": 13.43,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.5,
      "end_seconds": 58.56,
      "duration_seconds": 2.06,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.7,
      "end_seconds": 63.44,
      "duration_seconds": 3.74,
      "text": "Let me check a few things. Any leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.96,
      "end_seconds": 66.86,
      "duration_seconds": 1.9,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.05,
      "end_seconds": 70.24,
      "duration_seconds": 2.19,
      "text": "Any weight loss, fainting or tremor?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.85,
      "end_seconds": 74.98,
      "duration_seconds": 4.13,
      "text": "No weight loss, fainting or tremor, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.02,
      "end_seconds": 78.12,
      "duration_seconds": 2.1,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.79,
      "end_seconds": 80.71,
      "duration_seconds": 1.92,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.27,
      "end_seconds": 86.84,
      "duration_seconds": 3.57,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.2,
      "end_seconds": 94.37,
      "duration_seconds": 7.17,
      "text": "I've got anxiety. An underactive thyroid, for five years. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.85,
      "end_seconds": 100.95,
      "duration_seconds": 5.1,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.75,
      "end_seconds": 113.17,
      "duration_seconds": 11.42,
      "text": "Okay, uh, so yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.68,
      "end_seconds": 117.01,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.63,
      "end_seconds": 119.4,
      "duration_seconds": 1.77,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.57,
      "end_seconds": 122.89,
      "duration_seconds": 2.32,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.03,
      "end_seconds": 126.79,
      "duration_seconds": 2.76,
      "text": "It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 131.24,
      "duration_seconds": 3.25,
      "text": "So, is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.52,
      "end_seconds": 134.67,
      "duration_seconds": 2.15,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 139.13,
      "duration_seconds": 3.86,
      "text": "Right, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.29,
      "end_seconds": 143.34,
      "duration_seconds": 3.05,
      "text": "I'm allergic to dust, I get sneezing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.64,
      "end_seconds": 147.18,
      "duration_seconds": 3.54,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.27,
      "end_seconds": 161.49,
      "duration_seconds": 13.22,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.02,
      "end_seconds": 164.0,
      "duration_seconds": 1.98,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.81,
      "end_seconds": 179.31,
      "duration_seconds": 1.5,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.33,
      "end_seconds": 202.17,
      "duration_seconds": 11.84,
      "text": "Okay: height 179 centimetres, BMI works out to 24.0. And temperature is 36.8 degrees, weight 77 kilos, oxygen saturation is 99 percent, pulse 125, blood pressure 122 over 75."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.36,
      "end_seconds": 204.55,
      "duration_seconds": 1.19,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.91,
      "end_seconds": 211.01,
      "duration_seconds": 6.1,
      "text": "We'll put it in context in a moment. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.63,
      "end_seconds": 227.42,
      "duration_seconds": 15.79,
      "text": "Yeah, um, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.38,
      "end_seconds": 232.38,
      "duration_seconds": 2.0,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.84,
      "end_seconds": 233.54,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.4,
      "end_seconds": 236.63,
      "duration_seconds": 2.23,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.42,
      "end_seconds": 250.38,
      "duration_seconds": 1.96,
      "text": "Pulse is irregular right now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.22,
      "end_seconds": 253.13,
      "duration_seconds": 1.91,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 265.28,
      "duration_seconds": 2.67,
      "text": "No murmurs and the neck veins aren't distended."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.31,
      "end_seconds": 287.24,
      "duration_seconds": 19.93,
      "text": "Okay, you can sit back up. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.5,
      "end_seconds": 290.38,
      "duration_seconds": 1.88,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.55,
      "end_seconds": 310.51,
      "duration_seconds": 18.96,
      "text": "So, based on the history and the examination, it fits best with palpitations with an unclear cause. That's my thinking for now, and it may change as we learn more. I can't rule out a rhythm problem yet. Let me just recap so I've got it right. You've had your heart racing for four weeks, and no fainting or tremor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.05,
      "end_seconds": 313.24,
      "duration_seconds": 1.19,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.66,
      "end_seconds": 329.17,
      "duration_seconds": 15.51,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.73,
      "end_seconds": 331.3,
      "duration_seconds": 1.57,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.71,
      "end_seconds": 346.25,
      "duration_seconds": 13.54,
      "text": "Let's get an ECG, for palpitations. That will help us see what's going on underneath and decide the next step. I'd like to arrange a thyroid test for palpitations. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.25,
      "end_seconds": 348.61,
      "duration_seconds": 1.36,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.89,
      "end_seconds": 372.35,
      "duration_seconds": 22.46,
      "text": "Let's use metoprolol, 25 milligrams, twice a day, until we review. That should help with palpitations. Cut back on tea, coffee and energy drinks, and note the time whenever it happens. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.42,
      "end_seconds": 380.29,
      "duration_seconds": 6.87,
      "text": "Please don't sit on it if you faint or have chest pain with the racing. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.79,
      "end_seconds": 384.72,
      "duration_seconds": 1.93,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.19,
      "end_seconds": 389.07,
      "duration_seconds": 2.88,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.0,
      "end_seconds": 393.91,
      "duration_seconds": 3.91,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.23,
      "end_seconds": 400.28,
      "duration_seconds": 5.05,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.81,
      "end_seconds": 408.92,
      "duration_seconds": 8.11,
      "text": "So, I take the metoprolol, 25 milligrams, twice a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.38,
      "end_seconds": 413.98,
      "duration_seconds": 4.6,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.43,
      "end_seconds": 417.44,
      "duration_seconds": 2.01,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.22,
      "end_seconds": 421.88,
      "duration_seconds": 1.66,
      "text": "Okay, see you then."
    }
  ]
}