{
  "schema_version": "1.0",
  "encounter_id": "00347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.0,
      "duration_seconds": 2.47,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.33,
      "end_seconds": 5.26,
      "duration_seconds": 0.93,
      "text": "Hi, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.11,
      "end_seconds": 8.53,
      "duration_seconds": 2.42,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.89,
      "end_seconds": 11.25,
      "duration_seconds": 2.36,
      "text": "Yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.88,
      "end_seconds": 13.89,
      "duration_seconds": 2.01,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.29,
      "end_seconds": 20.06,
      "duration_seconds": 4.77,
      "text": "It's the room spinning. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.66,
      "end_seconds": 23.03,
      "duration_seconds": 2.37,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.42,
      "end_seconds": 28.07,
      "duration_seconds": 4.65,
      "text": "Uh, yes, turning over in bed. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.91,
      "end_seconds": 30.64,
      "duration_seconds": 1.73,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.37,
      "end_seconds": 32.56,
      "duration_seconds": 1.19,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.1,
      "end_seconds": 35.73,
      "duration_seconds": 2.63,
      "text": "Okay, have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.89,
      "end_seconds": 39.54,
      "duration_seconds": 2.65,
      "text": "I get some relief from lying still."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 42.52,
      "duration_seconds": 2.46,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.01,
      "end_seconds": 62.86,
      "duration_seconds": 18.85,
      "text": "When it starts I tend to get a ringing in my ear as well. I've also had a bit of vomiting, for ten days. About bit of vomiting, it's mild, honestly. Honestly, on and off. The ringing in my ear? That's been since this morning. There's nausea as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.28,
      "end_seconds": 67.78,
      "duration_seconds": 3.5,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.28,
      "end_seconds": 68.98,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.83,
      "end_seconds": 85.26,
      "duration_seconds": 4.43,
      "text": "Okay, here we go. Have you had any double vision or headache?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.63,
      "end_seconds": 89.45,
      "duration_seconds": 2.82,
      "text": "No. None of those, you know, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.94,
      "end_seconds": 93.55,
      "duration_seconds": 2.61,
      "text": "And numbness in the face, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.31,
      "end_seconds": 99.83,
      "duration_seconds": 3.52,
      "text": "No, you know, no numbness in the face."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.48,
      "end_seconds": 102.61,
      "duration_seconds": 2.13,
      "text": "Any slurred speech or hearing loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.81,
      "end_seconds": 107.69,
      "duration_seconds": 3.88,
      "text": "Right, you know, no, none of that at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.96,
      "end_seconds": 110.43,
      "duration_seconds": 2.47,
      "text": "Mm. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.66,
      "end_seconds": 113.68,
      "duration_seconds": 2.02,
      "text": "Well, no problems with breathing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.05,
      "end_seconds": 117.26,
      "duration_seconds": 2.21,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.6,
      "end_seconds": 119.76,
      "duration_seconds": 2.16,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.98,
      "end_seconds": 124.88,
      "duration_seconds": 3.9,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.15,
      "end_seconds": 131.33,
      "duration_seconds": 5.18,
      "text": "So, yes, diabetes. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.61,
      "end_seconds": 133.65,
      "duration_seconds": 1.04,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.08,
      "end_seconds": 140.12,
      "duration_seconds": 5.04,
      "text": "I, I have high blood pressure. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.52,
      "end_seconds": 144.56,
      "duration_seconds": 4.04,
      "text": "So, yes, I can see the diabetes in your file as well."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.39,
      "end_seconds": 148.35,
      "duration_seconds": 2.96,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.78,
      "end_seconds": 149.56,
      "duration_seconds": 0.78,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.38,
      "end_seconds": 161.2,
      "duration_seconds": 3.82,
      "text": "Okay, here we go. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.61,
      "end_seconds": 165.29,
      "duration_seconds": 2.68,
      "text": "Yes, codeine, it gives me vomiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.09,
      "end_seconds": 169.93,
      "duration_seconds": 3.84,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.28,
      "end_seconds": 172.59,
      "duration_seconds": 2.31,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.15,
      "end_seconds": 175.67,
      "duration_seconds": 2.52,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.3,
      "end_seconds": 187.06,
      "duration_seconds": 10.76,
      "text": "I'm on glimepiride, 2 milligrams, before breakfast. Losartan. I take it 50 milligrams, once a day. Vertin. I take it 16 milligrams, when it comes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.56,
      "end_seconds": 200.58,
      "duration_seconds": 13.02,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.98,
      "end_seconds": 204.73,
      "duration_seconds": 3.75,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.15,
      "end_seconds": 208.17,
      "duration_seconds": 2.02,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.11,
      "end_seconds": 212.45,
      "duration_seconds": 3.34,
      "text": "Yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.32,
      "end_seconds": 216.12,
      "duration_seconds": 2.8,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.08,
      "end_seconds": 224.39,
      "duration_seconds": 1.31,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.43,
      "end_seconds": 242.6,
      "duration_seconds": 8.17,
      "text": "Okay: pulse is 79 beats a minute, temperature 36.6, blood pressure 111 over 71. And oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.72,
      "end_seconds": 244.82,
      "duration_seconds": 1.1,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.89,
      "end_seconds": 248.82,
      "duration_seconds": 2.93,
      "text": "So, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 253.43,
      "duration_seconds": 3.03,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.5,
      "end_seconds": 255.79,
      "duration_seconds": 1.29,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.77,
      "end_seconds": 259.32,
      "duration_seconds": 1.55,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.19,
      "end_seconds": 277.86,
      "duration_seconds": 3.67,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.02,
      "end_seconds": 280.8,
      "duration_seconds": 1.78,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.88,
      "end_seconds": 301.0,
      "duration_seconds": 6.12,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.3,
      "end_seconds": 314.57,
      "duration_seconds": 9.27,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.49,
      "end_seconds": 318.06,
      "duration_seconds": 2.57,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.62,
      "end_seconds": 319.39,
      "duration_seconds": 0.77,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.49,
      "end_seconds": 337.49,
      "duration_seconds": 11.0,
      "text": "Alright, I've got it. From what you've told me and what I found, my working impression is benign positional vertigo. An inner ear infection is also on my list."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.27,
      "end_seconds": 340.95,
      "duration_seconds": 2.68,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.15,
      "end_seconds": 356.08,
      "duration_seconds": 13.93,
      "text": "Nothing I've seen today points to an emergency. It looks like benign positional vertigo, but I'd like to confirm. Let me just recap so I've got it right. You've had the room spinning, severe, and no headache or slurred speech."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.59,
      "end_seconds": 360.33,
      "duration_seconds": 2.74,
      "text": "Um, yes, you've got it."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.7,
      "end_seconds": 368.39,
      "duration_seconds": 6.69,
      "text": "Let's get a hearing test, for tinnitus and vertigo. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.65,
      "end_seconds": 373.65,
      "duration_seconds": 4.0,
      "text": "We have a slot Wednesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.72,
      "end_seconds": 401.85,
      "duration_seconds": 27.13,
      "text": "Get up slowly from lying down and sit for a moment first. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. A short walk every day, even twenty minutes, will help more than you'd think. Keep an eye out, and if you get weakness, slurred speech or a severe headache with the dizziness, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.41,
      "end_seconds": 413.64,
      "duration_seconds": 10.23,
      "text": "Please come and see me in two weeks. Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.24,
      "end_seconds": 420.69,
      "duration_seconds": 5.45,
      "text": "So, uh, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.59,
      "end_seconds": 426.31,
      "duration_seconds": 4.72,
      "text": "Yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 428.87,
      "end_seconds": 431.73,
      "duration_seconds": 2.86,
      "text": "Uh, I appreciate your time, doctor."
    }
  ]
}