{
  "schema_version": "1.0",
  "encounter_id": "00462",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 5.09,
      "duration_seconds": 4.52,
      "text": "Hello again. Come on in. Alright, lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.58,
      "end_seconds": 9.97,
      "duration_seconds": 3.39,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.44,
      "end_seconds": 15.13,
      "duration_seconds": 3.69,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.71,
      "end_seconds": 18.08,
      "duration_seconds": 2.37,
      "text": "It's my heart racing, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.05,
      "end_seconds": 24.13,
      "duration_seconds": 2.08,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.21,
      "end_seconds": 27.66,
      "duration_seconds": 2.45,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 30.71,
      "duration_seconds": 2.31,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.97,
      "end_seconds": 35.59,
      "duration_seconds": 3.62,
      "text": "I mean, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.11,
      "end_seconds": 38.45,
      "duration_seconds": 2.34,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.17,
      "end_seconds": 41.93,
      "duration_seconds": 2.76,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.27,
      "end_seconds": 44.48,
      "duration_seconds": 2.21,
      "text": "Any eye bulging or shortness of breath?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.24,
      "end_seconds": 49.23,
      "duration_seconds": 3.99,
      "text": "No eye bulging or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.65,
      "end_seconds": 67.98,
      "duration_seconds": 17.33,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.45,
      "end_seconds": 70.71,
      "duration_seconds": 2.26,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.23,
      "end_seconds": 74.82,
      "duration_seconds": 3.59,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.16,
      "end_seconds": 77.86,
      "duration_seconds": 2.7,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.18,
      "end_seconds": 82.03,
      "duration_seconds": 2.85,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.59,
      "end_seconds": 83.47,
      "duration_seconds": 0.88,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.55,
      "end_seconds": 100.84,
      "duration_seconds": 5.29,
      "text": "Alright, I've got it. Right, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.74,
      "end_seconds": 102.64,
      "duration_seconds": 0.9,
      "text": "Yes, dust."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.01,
      "end_seconds": 106.4,
      "duration_seconds": 3.39,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.25,
      "end_seconds": 109.17,
      "duration_seconds": 1.92,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.94,
      "end_seconds": 112.05,
      "duration_seconds": 2.11,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.75,
      "end_seconds": 113.74,
      "duration_seconds": 0.99,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.71,
      "end_seconds": 118.82,
      "duration_seconds": 4.11,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.88,
      "end_seconds": 126.96,
      "duration_seconds": 4.08,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.51,
      "end_seconds": 131.48,
      "duration_seconds": 3.97,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.0,
      "end_seconds": 134.45,
      "duration_seconds": 1.45,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.14,
      "end_seconds": 138.25,
      "duration_seconds": 3.11,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.46,
      "end_seconds": 150.74,
      "duration_seconds": 11.28,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.76,
      "end_seconds": 152.93,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.12,
      "end_seconds": 157.71,
      "duration_seconds": 3.59,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.83,
      "end_seconds": 165.11,
      "duration_seconds": 3.28,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.59,
      "end_seconds": 176.06,
      "duration_seconds": 10.47,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.5,
      "end_seconds": 180.35,
      "duration_seconds": 3.85,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.21,
      "end_seconds": 193.91,
      "duration_seconds": 12.7,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.03,
      "end_seconds": 198.09,
      "duration_seconds": 3.06,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.19,
      "end_seconds": 200.76,
      "duration_seconds": 1.57,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.9,
      "end_seconds": 213.85,
      "duration_seconds": 2.95,
      "text": "Your thyroid feels a little enlarged and smooth."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.82,
      "end_seconds": 217.87,
      "duration_seconds": 2.05,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.23,
      "end_seconds": 239.98,
      "duration_seconds": 4.75,
      "text": "There's a fine tremor in the outstretched hands, and your palms are warm and moist."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.08,
      "end_seconds": 247.77,
      "duration_seconds": 4.69,
      "text": "Okay, you can sit back up. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.28,
      "end_seconds": 250.98,
      "duration_seconds": 1.7,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.78,
      "end_seconds": 264.19,
      "duration_seconds": 12.41,
      "text": "So, based on the history and the examination, I think we're dealing with an overactive thyroid at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.21,
      "end_seconds": 267.42,
      "duration_seconds": 2.21,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.91,
      "end_seconds": 283.74,
      "duration_seconds": 15.83,
      "text": "It's reasonable to be concerned, but right now an overactive thyroid is my leading thought, not anything worse. Let me just recap so I've got it right. You've had your heart racing for about a month, moderate, and no eye bulging or shortness of breath."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.33,
      "end_seconds": 285.65,
      "duration_seconds": 1.32,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.42,
      "end_seconds": 290.16,
      "duration_seconds": 3.74,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.92,
      "end_seconds": 291.67,
      "duration_seconds": 0.75,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.85,
      "end_seconds": 325.33,
      "duration_seconds": 19.48,
      "text": "Right, thanks for waiting. I'm going to order an ECG, for palpitations. That will help us see what's going on underneath and decide the next step. I'd like you to take propranolol, 20 milligrams, twice a day, until we review. You take it by mouth. That's for palpitations and tremor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.1,
      "end_seconds": 328.53,
      "duration_seconds": 2.43,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.12,
      "end_seconds": 337.12,
      "duration_seconds": 7.0,
      "text": "Limit tea, coffee and anything that speeds up the heart for now. We'll refer you to an endocrinologist."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.36,
      "end_seconds": 339.63,
      "duration_seconds": 1.27,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.26,
      "end_seconds": 346.1,
      "duration_seconds": 5.84,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.67,
      "end_seconds": 350.54,
      "duration_seconds": 1.87,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.09,
      "end_seconds": 352.76,
      "duration_seconds": 1.67,
      "text": "Come back in two weeks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.96,
      "end_seconds": 357.96,
      "duration_seconds": 4.0,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.96,
      "end_seconds": 366.52,
      "duration_seconds": 5.56,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.71,
      "end_seconds": 375.99,
      "duration_seconds": 8.28,
      "text": "So, I take the propranolol, 20 milligrams, twice a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.89,
      "end_seconds": 380.54,
      "duration_seconds": 3.65,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.38,
      "end_seconds": 383.02,
      "duration_seconds": 1.64,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.4,
      "end_seconds": 385.57,
      "duration_seconds": 1.17,
      "text": "See you then."
    }
  ]
}