{
  "schema_version": "1.0",
  "encounter_id": "00379",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.17,
      "end_seconds": 5.12,
      "duration_seconds": 3.95,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.54,
      "end_seconds": 10.78,
      "duration_seconds": 4.24,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.16,
      "end_seconds": 21.66,
      "duration_seconds": 9.5,
      "text": "It's, It's puffiness around the eyes in the morning, mostly. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 25.91,
      "duration_seconds": 3.4,
      "text": "So, is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.84,
      "end_seconds": 33.91,
      "duration_seconds": 7.07,
      "text": "Oh, it's been six months, I'm fairly sure. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.12,
      "end_seconds": 38.76,
      "duration_seconds": 3.64,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.96,
      "end_seconds": 51.26,
      "duration_seconds": 11.3,
      "text": "So, I'd give it a seven, out of ten. It sort of comes and goes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.64,
      "end_seconds": 55.56,
      "duration_seconds": 2.92,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.71,
      "end_seconds": 71.78,
      "duration_seconds": 15.07,
      "text": "Swelling in the ankles goes along with it, most of the time. The swelling in the ankles? That's been for about three months. Foamy urine was there, uh, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.25,
      "end_seconds": 74.95,
      "duration_seconds": 2.7,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.58,
      "end_seconds": 91.0,
      "duration_seconds": 15.42,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.29,
      "end_seconds": 98.48,
      "duration_seconds": 3.19,
      "text": "Alright, has there been any reduced urine output?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.92,
      "end_seconds": 101.06,
      "duration_seconds": 2.14,
      "text": "No. No reduced urine output."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 106.12,
      "duration_seconds": 1.24,
      "text": "Any breathlessness or nausea?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.67,
      "end_seconds": 110.65,
      "duration_seconds": 2.98,
      "text": "No, uh, no breathlessness or nausea."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.0,
      "end_seconds": 113.64,
      "duration_seconds": 2.64,
      "text": "Mm. And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.18,
      "end_seconds": 117.69,
      "duration_seconds": 3.51,
      "text": "Nothing on the skin, you know, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.51,
      "end_seconds": 122.29,
      "duration_seconds": 3.78,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.86,
      "end_seconds": 123.56,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.22,
      "end_seconds": 142.01,
      "duration_seconds": 2.79,
      "text": "Alright, I've got it. How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 146.24,
      "end_seconds": 150.65,
      "duration_seconds": 4.41,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.55,
      "end_seconds": 153.22,
      "duration_seconds": 1.67,
      "text": "Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.62,
      "end_seconds": 156.73,
      "duration_seconds": 2.11,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 160.6,
      "duration_seconds": 2.73,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.04,
      "end_seconds": 163.77,
      "duration_seconds": 2.73,
      "text": "Well, of course, take your time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.26,
      "end_seconds": 176.17,
      "duration_seconds": 4.91,
      "text": "Okay, here we go. Right, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.23,
      "end_seconds": 179.55,
      "duration_seconds": 2.32,
      "text": "Right, my father was diabetic."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.03,
      "end_seconds": 185.22,
      "duration_seconds": 4.19,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.97,
      "end_seconds": 190.92,
      "duration_seconds": 4.95,
      "text": "So, um, mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.23,
      "end_seconds": 194.26,
      "duration_seconds": 3.03,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.5,
      "end_seconds": 217.55,
      "duration_seconds": 20.05,
      "text": "Uh, um, I've had kidney disease for about a year now. Sorry, I know I'm rambling a bit. I'd rather not end up on lots of tablets if I can avoid it. Diabetes, for about ten years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.03,
      "end_seconds": 220.08,
      "duration_seconds": 1.05,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.55,
      "end_seconds": 224.68,
      "duration_seconds": 3.13,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.93,
      "end_seconds": 229.87,
      "duration_seconds": 3.94,
      "text": "Uh, uh, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.71,
      "end_seconds": 232.62,
      "duration_seconds": 1.91,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 234.12,
      "end_seconds": 238.53,
      "duration_seconds": 4.41,
      "text": "Yes, I had a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 246.41,
      "duration_seconds": 4.81,
      "text": "Do you have any known allergies at all? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.52,
      "end_seconds": 252.52,
      "duration_seconds": 5.0,
      "text": "Okay, uh, so no, none that I know of."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.19,
      "end_seconds": 254.32,
      "duration_seconds": 1.13,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.51,
      "end_seconds": 260.71,
      "duration_seconds": 2.2,
      "text": "Nothing, you know, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 261.65,
      "end_seconds": 268.87,
      "duration_seconds": 7.22,
      "text": "Here are the numbers, doctor. Saturation 98 percent, temperature 37.0. Blood pressure 152 over 93, respiratory rate 18, heart rate 86."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.94,
      "end_seconds": 271.09,
      "duration_seconds": 1.15,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 276.24,
      "duration_seconds": 3.04,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.54,
      "end_seconds": 278.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.96,
      "end_seconds": 281.9,
      "duration_seconds": 1.94,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.24,
      "end_seconds": 297.46,
      "duration_seconds": 5.22,
      "text": "There's pitting swelling at both ankles, and your blood pressure is on the high side."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 316.11,
      "duration_seconds": 12.91,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.29,
      "end_seconds": 326.34,
      "duration_seconds": 9.05,
      "text": "Um, you know, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.64,
      "end_seconds": 349.9,
      "duration_seconds": 23.26,
      "text": "From what you've told me and what I found, it fits best with progression of the kidney problem. That's my thinking for now, and it may change as we learn more. Let me just recap so I've got it right. You've had puffiness around the eyes in the morning for six months, and no reduced urine output or nausea."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 351.22,
      "end_seconds": 352.58,
      "duration_seconds": 1.36,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.54,
      "end_seconds": 370.57,
      "duration_seconds": 17.03,
      "text": "I'm going to order a urine protein test, for chronic kidney disease. I'd rather check than guess, and this is the quickest way to know more. We should do kidney function tests for chronic kidney disease. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.53,
      "end_seconds": 373.77,
      "duration_seconds": 2.24,
      "text": "Okay, you know, that's fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.69,
      "end_seconds": 392.98,
      "duration_seconds": 18.29,
      "text": "Stay off anti-inflammatory painkillers like diclofenac or ibuprofen, they're hard on the kidneys. Keep an eye on salt and protein portions, a dietitian can help with the specifics. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'll also refer you to a kidney specialist."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 394.56,
      "end_seconds": 396.08,
      "duration_seconds": 1.52,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.0,
      "end_seconds": 404.65,
      "duration_seconds": 7.65,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 405.91,
      "end_seconds": 408.78,
      "duration_seconds": 2.87,
      "text": "Uh, got it, thank you."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.95,
      "end_seconds": 413.61,
      "duration_seconds": 3.66,
      "text": "Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 414.14,
      "end_seconds": 414.84,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.51,
      "end_seconds": 421.14,
      "duration_seconds": 5.63,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 421.93,
      "end_seconds": 428.79,
      "duration_seconds": 6.86,
      "text": "So, you know, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.57,
      "end_seconds": 431.91,
      "duration_seconds": 2.34,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 433.01,
      "end_seconds": 437.19,
      "duration_seconds": 4.18,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.66,
      "end_seconds": 438.45,
      "duration_seconds": 0.79,
      "text": "Alright, goodbye."
    }
  ]
}