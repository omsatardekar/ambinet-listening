{
  "schema_version": "1.0",
  "encounter_id": "00394",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 2.04,
      "duration_seconds": 1.44,
      "text": "Hello there. Please, sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.46,
      "end_seconds": 4.16,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 8.24,
      "duration_seconds": 2.59,
      "text": "Okay, lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.57,
      "end_seconds": 13.66,
      "duration_seconds": 4.09,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.94,
      "end_seconds": 18.61,
      "duration_seconds": 1.67,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.0,
      "end_seconds": 29.14,
      "duration_seconds": 10.14,
      "text": "Oh, honestly, it's burning in both feet, and my family pushed me to come. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.03,
      "end_seconds": 32.97,
      "duration_seconds": 2.94,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.5,
      "end_seconds": 40.86,
      "duration_seconds": 7.36,
      "text": "Oh, I've had it for about three months. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.43,
      "end_seconds": 43.45,
      "duration_seconds": 2.02,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.22,
      "end_seconds": 48.35,
      "duration_seconds": 4.13,
      "text": "Okay, so yes, bedsheets touching them. That makes it worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.27,
      "end_seconds": 50.39,
      "duration_seconds": 1.12,
      "text": "Anything that helps?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.21,
      "end_seconds": 55.04,
      "duration_seconds": 3.83,
      "text": "Right, I get some relief from walking around."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.07,
      "end_seconds": 57.74,
      "duration_seconds": 1.67,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.15,
      "end_seconds": 61.37,
      "duration_seconds": 3.22,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.77,
      "end_seconds": 65.03,
      "duration_seconds": 2.26,
      "text": "Right, and how severe is it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.34,
      "end_seconds": 66.79,
      "duration_seconds": 1.45,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.45,
      "end_seconds": 70.82,
      "duration_seconds": 3.37,
      "text": "Alright, any pins and needles in the legs as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.35,
      "end_seconds": 88.78,
      "duration_seconds": 17.43,
      "text": "Yes, actually. I've, I've also had numbness in the toes. About numbness in the toes, I'd say a couple of times a week. And I've been feeling unsteady in the dark as well, for four weeks."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.67,
      "end_seconds": 102.7,
      "duration_seconds": 13.03,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.21,
      "end_seconds": 108.98,
      "duration_seconds": 5.77,
      "text": "Uh, um, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.26,
      "end_seconds": 114.82,
      "duration_seconds": 4.56,
      "text": "Any fever, bladder problems, weakness in the legs or hand symptoms at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.98,
      "end_seconds": 123.26,
      "duration_seconds": 7.28,
      "text": "Um, um, no, no fever, bladder problems, weakness in the legs or hand symptoms."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.83,
      "end_seconds": 126.82,
      "duration_seconds": 1.99,
      "text": "And foot ulcers, any of that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.3,
      "end_seconds": 130.2,
      "duration_seconds": 1.9,
      "text": "No. No foot ulcers."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.62,
      "end_seconds": 133.62,
      "duration_seconds": 2.0,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.38,
      "end_seconds": 136.11,
      "duration_seconds": 1.73,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 137.15,
      "end_seconds": 150.57,
      "duration_seconds": 13.42,
      "text": "Doctor, I've got the readings for you. Height 173 centimetres, temp 36.4 degrees, pressure 118 over 81, weight 89 kilos, BMI works out to 29.7, pulse 72, saturation 99 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.98,
      "end_seconds": 154.29,
      "duration_seconds": 2.31,
      "text": "Thanks. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.06,
      "end_seconds": 164.05,
      "duration_seconds": 8.99,
      "text": "Yeah, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.55,
      "end_seconds": 167.6,
      "duration_seconds": 3.05,
      "text": "I'm just saving what we've covered so far."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.37,
      "end_seconds": 180.53,
      "duration_seconds": 3.16,
      "text": "Right, carry on. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.94,
      "end_seconds": 184.75,
      "duration_seconds": 3.81,
      "text": "Uh, uh, no, nothing like that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.17,
      "end_seconds": 189.11,
      "duration_seconds": 2.94,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.23,
      "end_seconds": 202.72,
      "duration_seconds": 12.49,
      "text": "I'm on omeprazole, 20 milligrams, once a day for the reflux. Okay, so it's thyroxine, 75 micrograms, every morning for my thyroid. Paracetamol. I take it 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 203.9,
      "end_seconds": 208.28,
      "duration_seconds": 4.38,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.75,
      "end_seconds": 212.3,
      "duration_seconds": 3.55,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.99,
      "end_seconds": 218.08,
      "duration_seconds": 5.09,
      "text": "So, uh, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.02,
      "end_seconds": 221.9,
      "duration_seconds": 2.88,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.55,
      "end_seconds": 230.72,
      "duration_seconds": 8.17,
      "text": "Um, uh, I've got acid reflux. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.16,
      "end_seconds": 232.1,
      "duration_seconds": 0.94,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.95,
      "end_seconds": 240.35,
      "duration_seconds": 7.4,
      "text": "An underactive thyroid, for about a year. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.98,
      "end_seconds": 260.35,
      "duration_seconds": 19.37,
      "text": "Okay, I'm following. Right, so that's your known acid reflux. We'll keep that in mind today. I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.94,
      "end_seconds": 263.64,
      "duration_seconds": 1.7,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.87,
      "end_seconds": 268.42,
      "duration_seconds": 3.55,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.47,
      "end_seconds": 270.17,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.98,
      "end_seconds": 273.09,
      "duration_seconds": 2.11,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.11,
      "end_seconds": 285.66,
      "duration_seconds": 1.55,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.45,
      "end_seconds": 290.17,
      "duration_seconds": 2.72,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.21,
      "end_seconds": 305.47,
      "duration_seconds": 3.26,
      "text": "Feeling of light touch is reduced in both feet."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.43,
      "end_seconds": 307.13,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.85,
      "end_seconds": 315.45,
      "duration_seconds": 4.6,
      "text": "That's fine, you can get dressed. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.63,
      "end_seconds": 319.87,
      "duration_seconds": 3.24,
      "text": "Yeah, um, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.5,
      "end_seconds": 348.81,
      "duration_seconds": 24.31,
      "text": "Okay, so my impression is this: My working impression is peripheral neuropathy, possibly related to sugar. That's my thinking for now, and it may change as we learn more. A vitamin B12 deficiency is also on my list. Let me just recap so I've got it right. You've had burning in both feet for about three months, moderate, and no bladder problems or weakness in the legs."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.89,
      "end_seconds": 353.28,
      "duration_seconds": 1.39,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.53,
      "end_seconds": 360.95,
      "duration_seconds": 6.42,
      "text": "Let's get an HbA1c, for neuropathy. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.38,
      "end_seconds": 363.94,
      "duration_seconds": 2.56,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.25,
      "end_seconds": 388.7,
      "duration_seconds": 24.45,
      "text": "Let's get a vitamin B12 level, for neuropathy. I'd rather check than guess, and this is the quickest way to know more. I'd like to arrange a nerve conduction study for neuropathy. I'd rather check than guess, and this is the quickest way to know more. I'll start you on pregabalin, 75 milligrams, at night, for four weeks. That's for nerve pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.28,
      "end_seconds": 392.98,
      "duration_seconds": 2.7,
      "text": "Right, uh, I'll remember that."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.07,
      "end_seconds": 402.67,
      "duration_seconds": 8.6,
      "text": "Check your feet every evening for cuts or blisters, you may not feel them. I'd like you to see podiatry as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.95,
      "end_seconds": 406.21,
      "duration_seconds": 2.26,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.77,
      "end_seconds": 413.75,
      "duration_seconds": 6.98,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.44,
      "end_seconds": 416.97,
      "duration_seconds": 2.53,
      "text": "Okay, uh, I will."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 417.34,
      "end_seconds": 424.39,
      "duration_seconds": 7.05,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.69,
      "end_seconds": 428.78,
      "duration_seconds": 3.09,
      "text": "I mean, got it, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 429.55,
      "end_seconds": 431.5,
      "duration_seconds": 1.95,
      "text": "Come back in four weeks."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 432.44,
      "end_seconds": 434.21,
      "duration_seconds": 1.77,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 434.96,
      "end_seconds": 438.61,
      "duration_seconds": 3.65,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 439.86,
      "end_seconds": 447.64,
      "duration_seconds": 7.78,
      "text": "So, I take the pregabalin, 75 milligrams, at night and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.75,
      "end_seconds": 453.02,
      "duration_seconds": 4.27,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 453.44,
      "end_seconds": 456.36,
      "duration_seconds": 2.92,
      "text": "Okay, so thanks so much, doctor."
    }
  ]
}