{
  "schema_version": "1.0",
  "encounter_id": "00484",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.48,
      "duration_seconds": 3.89,
      "text": "Hello, uh, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 8.75,
      "duration_seconds": 2.78,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.55,
      "end_seconds": 12.92,
      "duration_seconds": 3.37,
      "text": "So, I've been feeling very thirsty, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.86,
      "end_seconds": 17.05,
      "duration_seconds": 3.19,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.45,
      "end_seconds": 26.43,
      "duration_seconds": 7.98,
      "text": "Okay, so it's been going on for about three months. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.12,
      "end_seconds": 29.08,
      "duration_seconds": 1.96,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.58,
      "end_seconds": 32.11,
      "duration_seconds": 2.53,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.49,
      "end_seconds": 34.42,
      "duration_seconds": 1.93,
      "text": "Alright. Have you had tiredness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.15,
      "end_seconds": 38.09,
      "duration_seconds": 2.94,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.09,
      "end_seconds": 43.22,
      "duration_seconds": 1.13,
      "text": "Any blurred vision?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.68,
      "end_seconds": 45.46,
      "duration_seconds": 1.78,
      "text": "No, no blurred vision."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.92,
      "end_seconds": 52.52,
      "duration_seconds": 4.6,
      "text": "Let me check a few things. Any abdominal pain, breathlessness, fever or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.05,
      "end_seconds": 56.16,
      "duration_seconds": 2.11,
      "text": "Well, nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.57,
      "end_seconds": 58.82,
      "duration_seconds": 2.25,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.03,
      "end_seconds": 63.06,
      "duration_seconds": 3.03,
      "text": "Well, uh, no, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.11,
      "end_seconds": 67.73,
      "duration_seconds": 3.62,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.2,
      "end_seconds": 71.03,
      "duration_seconds": 2.83,
      "text": "I hadn't even noticed, you know, honestly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.46,
      "end_seconds": 73.48,
      "duration_seconds": 1.02,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.72,
      "end_seconds": 77.63,
      "duration_seconds": 1.91,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.59,
      "end_seconds": 82.11,
      "duration_seconds": 3.52,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.99,
      "end_seconds": 84.91,
      "duration_seconds": 1.92,
      "text": "Yes, I'm allergic to aspirin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.96,
      "end_seconds": 91.05,
      "duration_seconds": 5.09,
      "text": "What medicines do you take regularly? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.58,
      "end_seconds": 95.74,
      "duration_seconds": 3.16,
      "text": "It's diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.69,
      "end_seconds": 99.88,
      "duration_seconds": 3.19,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.88,
      "end_seconds": 107.06,
      "duration_seconds": 6.18,
      "text": "No, it's at home. I'm on escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.91,
      "end_seconds": 111.6,
      "duration_seconds": 3.69,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 124.15,
      "duration_seconds": 11.7,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.69,
      "end_seconds": 129.09,
      "duration_seconds": 3.4,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.24,
      "end_seconds": 145.87,
      "duration_seconds": 15.63,
      "text": "Um, I've had arthritis in my knees for about ten years now. I've had depression, yes. It's a relief to finally sit down and talk about it. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 150.85,
      "duration_seconds": 4.57,
      "text": "Right, so that's your known depression. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.36,
      "end_seconds": 154.36,
      "duration_seconds": 3.0,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.14,
      "end_seconds": 155.93,
      "duration_seconds": 0.79,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.62,
      "end_seconds": 170.94,
      "duration_seconds": 2.32,
      "text": "Okay, here we go. Do you smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.26,
      "end_seconds": 174.11,
      "duration_seconds": 2.85,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.07,
      "end_seconds": 178.55,
      "duration_seconds": 3.48,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.04,
      "end_seconds": 190.39,
      "duration_seconds": 11.35,
      "text": "Hmm, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 193.77,
      "duration_seconds": 1.92,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.05,
      "end_seconds": 202.01,
      "duration_seconds": 1.96,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 228.66,
      "duration_seconds": 7.23,
      "text": "Okay: pulse is 77 beats a minute, temp 36.5 degrees, saturation 99 percent, BP is 110 over 72."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.31,
      "end_seconds": 230.49,
      "duration_seconds": 1.18,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.17,
      "end_seconds": 235.93,
      "duration_seconds": 4.76,
      "text": "We'll put it in context in a moment. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.86,
      "end_seconds": 238.56,
      "duration_seconds": 1.7,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.59,
      "end_seconds": 241.76,
      "duration_seconds": 2.17,
      "text": "So, can I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.57,
      "end_seconds": 245.53,
      "duration_seconds": 2.96,
      "text": "Okay, now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.24,
      "end_seconds": 257.46,
      "duration_seconds": 2.22,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.89,
      "end_seconds": 260.85,
      "duration_seconds": 1.96,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.12,
      "end_seconds": 278.05,
      "duration_seconds": 3.93,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.38,
      "end_seconds": 303.29,
      "duration_seconds": 22.91,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. So, based on the history and the examination, I think we're dealing with possible new-onset diabetes at this stage. The reason I say that is that your story and my examination fit together. I can't rule out a urine infection yet."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.96,
      "end_seconds": 306.18,
      "duration_seconds": 2.22,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.71,
      "end_seconds": 321.43,
      "duration_seconds": 13.72,
      "text": "Nothing I've seen today points to an emergency. It looks like possible new-onset diabetes, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling very thirsty for about three months, and no breathlessness or fever."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.69,
      "end_seconds": 323.89,
      "duration_seconds": 1.2,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.73,
      "end_seconds": 347.65,
      "duration_seconds": 22.92,
      "text": "I'd like to arrange a urine test for polyuria. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. If you smoke, this is a good moment to think about stopping, and we can help you with that. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.41,
      "end_seconds": 355.66,
      "duration_seconds": 7.25,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.81,
      "end_seconds": 358.2,
      "duration_seconds": 1.39,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.32,
      "end_seconds": 374.13,
      "duration_seconds": 14.81,
      "text": "Keep an eye out, and if you start vomiting or become drowsy, call us the same day or go to emergency. Come back after the results are back. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.43,
      "end_seconds": 380.58,
      "duration_seconds": 5.15,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.02,
      "end_seconds": 385.78,
      "duration_seconds": 3.76,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.18,
      "end_seconds": 388.28,
      "duration_seconds": 2.1,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.79,
      "end_seconds": 393.01,
      "duration_seconds": 2.22,
      "text": "Bye for now, look after yourself."
    }
  ]
}