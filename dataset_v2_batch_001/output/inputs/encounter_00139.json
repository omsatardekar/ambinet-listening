{
  "schema_version": "1.0",
  "encounter_id": "00139",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.16,
      "duration_seconds": 4.05,
      "text": "Hello, um, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.74,
      "end_seconds": 11.74,
      "duration_seconds": 5.0,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.8,
      "end_seconds": 16.81,
      "duration_seconds": 4.01,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.35,
      "end_seconds": 19.89,
      "duration_seconds": 2.54,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.6,
      "end_seconds": 22.55,
      "duration_seconds": 1.95,
      "text": "She's been having constipation, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.07,
      "end_seconds": 28.51,
      "duration_seconds": 4.44,
      "text": "How long has this been going on? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.92,
      "end_seconds": 34.31,
      "duration_seconds": 4.39,
      "text": "Probably four weeks. Yeah. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.0,
      "end_seconds": 38.11,
      "duration_seconds": 3.11,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.51,
      "end_seconds": 40.59,
      "duration_seconds": 1.08,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.81,
      "end_seconds": 44.34,
      "duration_seconds": 2.53,
      "text": "Any straining to pass stool as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.71,
      "end_seconds": 50.32,
      "duration_seconds": 5.61,
      "text": "Hmm, yeah. About three months, I'd say. There's hard pellet-like stools as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.61,
      "end_seconds": 57.21,
      "duration_seconds": 3.6,
      "text": "Have you had constipation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.52,
      "end_seconds": 62.85,
      "duration_seconds": 5.33,
      "text": "Hmm, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.91,
      "end_seconds": 69.58,
      "duration_seconds": 2.67,
      "text": "Have you had any black stools or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.77,
      "end_seconds": 73.67,
      "duration_seconds": 2.9,
      "text": "Right, no, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.11,
      "end_seconds": 76.92,
      "duration_seconds": 2.81,
      "text": "Have you had any weight loss or abdominal swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.33,
      "end_seconds": 83.41,
      "duration_seconds": 5.08,
      "text": "Hmm, I haven't had weight loss or abdominal swelling, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.13,
      "end_seconds": 86.07,
      "duration_seconds": 1.94,
      "text": "Any pain on passing stool?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.36,
      "end_seconds": 90.63,
      "duration_seconds": 3.27,
      "text": "Not at all, no pain on passing stool."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.3,
      "end_seconds": 93.98,
      "duration_seconds": 2.68,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.43,
      "end_seconds": 97.06,
      "duration_seconds": 1.63,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.61,
      "end_seconds": 99.31,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.75,
      "end_seconds": 103.47,
      "duration_seconds": 2.72,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.81,
      "end_seconds": 106.29,
      "duration_seconds": 1.48,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.67,
      "end_seconds": 109.98,
      "duration_seconds": 3.31,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.13,
      "end_seconds": 125.73,
      "duration_seconds": 14.6,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.18,
      "end_seconds": 132.27,
      "duration_seconds": 2.09,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.51,
      "end_seconds": 137.58,
      "duration_seconds": 4.07,
      "text": "Okay, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.07,
      "end_seconds": 152.62,
      "duration_seconds": 13.55,
      "text": "Yes, an underactive thyroid. I have diabetes, for five years. I just want to get back to normal, really. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.34,
      "end_seconds": 154.47,
      "duration_seconds": 1.13,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.18,
      "end_seconds": 164.24,
      "duration_seconds": 9.06,
      "text": "Right, so that's your known an underactive thyroid. We'll keep that in mind today. Alright, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.83,
      "end_seconds": 168.08,
      "duration_seconds": 2.25,
      "text": "Yes, I'm allergic to pollen."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.58,
      "end_seconds": 173.6,
      "duration_seconds": 5.02,
      "text": "What medicines do you take regularly? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.95,
      "end_seconds": 177.94,
      "duration_seconds": 3.99,
      "text": "Um, I take Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.73,
      "end_seconds": 181.13,
      "duration_seconds": 2.4,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.32,
      "end_seconds": 191.07,
      "duration_seconds": 5.75,
      "text": "Two years now. It's metformin, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.4,
      "end_seconds": 194.74,
      "duration_seconds": 2.34,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 199.1,
      "duration_seconds": 3.83,
      "text": "Two years now. So, I'm on Cremaffin, at night."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.98,
      "end_seconds": 205.15,
      "duration_seconds": 2.17,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.55,
      "end_seconds": 214.77,
      "duration_seconds": 8.22,
      "text": "Right, yes, I had a hysterectomy, about twelve years ago. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.68,
      "end_seconds": 230.13,
      "duration_seconds": 12.45,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.47,
      "end_seconds": 233.09,
      "duration_seconds": 1.62,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.44,
      "end_seconds": 235.44,
      "duration_seconds": 2.0,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.08,
      "end_seconds": 237.95,
      "duration_seconds": 1.87,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.3,
      "end_seconds": 242.77,
      "duration_seconds": 4.47,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.88,
      "end_seconds": 253.38,
      "duration_seconds": 9.5,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.48,
      "end_seconds": 256.7,
      "duration_seconds": 2.22,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 265.82,
      "duration_seconds": 1.75,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.03,
      "end_seconds": 284.76,
      "duration_seconds": 6.73,
      "text": "Okay: saturation 98 percent, temperature 36.7, blood pressure 127 over 72, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.21,
      "end_seconds": 286.57,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.17,
      "end_seconds": 290.25,
      "duration_seconds": 3.08,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.35,
      "end_seconds": 294.27,
      "duration_seconds": 2.92,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.79,
      "end_seconds": 296.64,
      "duration_seconds": 0.85,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.47,
      "end_seconds": 300.18,
      "duration_seconds": 1.71,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.23,
      "end_seconds": 317.89,
      "duration_seconds": 3.66,
      "text": "I can feel firm stool in the left lower abdomen."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.63,
      "end_seconds": 321.39,
      "duration_seconds": 1.76,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.99,
      "end_seconds": 331.13,
      "duration_seconds": 2.14,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.12,
      "end_seconds": 358.52,
      "duration_seconds": 21.4,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. So, based on the history and the examination, it fits best with chronic constipation. Let me just recap so I've got it right. You've had constipation for four weeks, mild, and no black stools or weight loss."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.92,
      "end_seconds": 360.32,
      "duration_seconds": 1.4,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.44,
      "end_seconds": 385.95,
      "duration_seconds": 24.51,
      "text": "I'm going to order a colonoscopy, for constipation and rectal bleeding. That will help us see what's going on underneath and decide the next step. Let's use lactulose, 15 ml, at night, for two weeks. It's for constipation. More fibre, more water, and give yourself ten unhurried minutes after breakfast. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.72,
      "end_seconds": 392.4,
      "duration_seconds": 5.68,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.01,
      "end_seconds": 395.16,
      "duration_seconds": 2.15,
      "text": "Okay, um, I understand."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.62,
      "end_seconds": 401.73,
      "duration_seconds": 3.11,
      "text": "Please come and see me in a month."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.32,
      "end_seconds": 403.02,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.09,
      "end_seconds": 407.9,
      "duration_seconds": 3.81,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 409.02,
      "end_seconds": 416.81,
      "duration_seconds": 7.79,
      "text": "So, I take the lactulose, 15 ml, at night and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.19,
      "end_seconds": 421.69,
      "duration_seconds": 4.5,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.13,
      "end_seconds": 424.54,
      "duration_seconds": 2.41,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.12,
      "end_seconds": 427.33,
      "duration_seconds": 2.21,
      "text": "Bye for now, look after yourself."
    }
  ]
}