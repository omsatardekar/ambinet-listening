{
  "schema_version": "1.0",
  "encounter_id": "00245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 3.95,
      "duration_seconds": 3.02,
      "text": "Hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 8.38,
      "duration_seconds": 3.02,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.47,
      "end_seconds": 11.85,
      "duration_seconds": 2.38,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.54,
      "end_seconds": 14.91,
      "duration_seconds": 2.37,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.77,
      "end_seconds": 24.35,
      "duration_seconds": 8.58,
      "text": "Right, I wanted to get my heart racing looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.18,
      "end_seconds": 27.64,
      "duration_seconds": 2.46,
      "text": "So, how long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.0,
      "end_seconds": 35.49,
      "duration_seconds": 7.49,
      "text": "It's been five days, I'm fairly sure. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.37,
      "end_seconds": 38.69,
      "duration_seconds": 2.32,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.94,
      "end_seconds": 46.56,
      "duration_seconds": 3.62,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.03,
      "end_seconds": 48.58,
      "duration_seconds": 1.55,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.16,
      "end_seconds": 55.04,
      "duration_seconds": 5.88,
      "text": "It comes and goes. I've, I've also been feeling hot and sweaty."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.43,
      "end_seconds": 59.56,
      "duration_seconds": 3.13,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 66.27,
      "duration_seconds": 2.71,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.59,
      "end_seconds": 69.05,
      "duration_seconds": 2.46,
      "text": "Have you been feeling anxious and jittery?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.78,
      "end_seconds": 72.26,
      "duration_seconds": 2.48,
      "text": "Yes, you know, I have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.22,
      "end_seconds": 75.73,
      "duration_seconds": 2.51,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.45,
      "end_seconds": 78.75,
      "duration_seconds": 2.3,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.59,
      "end_seconds": 98.34,
      "duration_seconds": 6.75,
      "text": "Right, thanks for waiting. Let me check a few things. Any lump in the neck or eye bulging?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.78,
      "end_seconds": 101.66,
      "duration_seconds": 2.88,
      "text": "Nothing like that, you know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.5,
      "end_seconds": 105.13,
      "duration_seconds": 2.63,
      "text": "Any diarrhoea or chest pain at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.91,
      "end_seconds": 108.2,
      "duration_seconds": 2.29,
      "text": "Right, nothing like that, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.59,
      "end_seconds": 111.34,
      "duration_seconds": 1.75,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.33,
      "end_seconds": 114.68,
      "duration_seconds": 2.35,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.63,
      "end_seconds": 119.66,
      "duration_seconds": 4.03,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.11,
      "end_seconds": 123.25,
      "duration_seconds": 2.14,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.51,
      "end_seconds": 128.74,
      "duration_seconds": 4.23,
      "text": "Any allergies I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.33,
      "end_seconds": 132.52,
      "duration_seconds": 2.19,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 148.06,
      "duration_seconds": 15.09,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.28,
      "end_seconds": 152.88,
      "duration_seconds": 3.6,
      "text": "So, you know, okay, that makes sense."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.62,
      "end_seconds": 155.53,
      "duration_seconds": 1.91,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.49,
      "end_seconds": 158.02,
      "duration_seconds": 1.53,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.43,
      "end_seconds": 162.0,
      "duration_seconds": 2.57,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.36,
      "end_seconds": 178.56,
      "duration_seconds": 16.2,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.55,
      "end_seconds": 182.99,
      "duration_seconds": 3.44,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.92,
      "end_seconds": 189.51,
      "duration_seconds": 5.59,
      "text": "Asthma, for about ten years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.75,
      "end_seconds": 191.72,
      "duration_seconds": 0.97,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.91,
      "end_seconds": 196.16,
      "duration_seconds": 3.25,
      "text": "I've had high cholesterol for five years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.07,
      "end_seconds": 197.77,
      "duration_seconds": 0.7,
      "text": "I see."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.64,
      "end_seconds": 201.79,
      "duration_seconds": 3.15,
      "text": "Alright, I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.19,
      "end_seconds": 203.06,
      "duration_seconds": 0.87,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.29,
      "end_seconds": 217.48,
      "duration_seconds": 3.19,
      "text": "Right, thanks for waiting. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.98,
      "end_seconds": 223.06,
      "duration_seconds": 2.08,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.91,
      "end_seconds": 224.61,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.19,
      "end_seconds": 229.11,
      "duration_seconds": 2.92,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.84,
      "end_seconds": 233.86,
      "duration_seconds": 4.02,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.71,
      "end_seconds": 235.41,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.59,
      "end_seconds": 255.3,
      "duration_seconds": 4.71,
      "text": "Right, thanks for waiting. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.49,
      "end_seconds": 258.45,
      "duration_seconds": 1.96,
      "text": "Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.82,
      "end_seconds": 264.34,
      "duration_seconds": 4.52,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.66,
      "end_seconds": 269.59,
      "duration_seconds": 3.93,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.66,
      "end_seconds": 272.78,
      "duration_seconds": 2.12,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.97,
      "end_seconds": 280.52,
      "duration_seconds": 1.55,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.29,
      "end_seconds": 311.69,
      "duration_seconds": 11.4,
      "text": "Okay: BMI works out to 26.0, SpO2 98 percent on room air, weight 64 kilos, height 157 centimetres, BP is 130 over 87, temp 37.0 degrees, pulse is 123 beats a minute."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.21,
      "end_seconds": 314.77,
      "duration_seconds": 2.56,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.66,
      "end_seconds": 316.62,
      "duration_seconds": 0.96,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.26,
      "end_seconds": 344.96,
      "duration_seconds": 14.7,
      "text": "Okay, here we go. I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.7,
      "end_seconds": 347.43,
      "duration_seconds": 1.73,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.02,
      "end_seconds": 371.8,
      "duration_seconds": 23.78,
      "text": "Putting together what you've described, it fits best with an overactive thyroid. I want to be honest that this is an impression, not a final answer. It could also be anxiety, so we'll keep that open. Let me just recap so I've got it right. You've had your heart racing for five days, and no chest pain or lump in the neck."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.57,
      "end_seconds": 374.14,
      "duration_seconds": 1.57,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.66,
      "end_seconds": 378.95,
      "duration_seconds": 3.29,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.57,
      "end_seconds": 390.08,
      "duration_seconds": 10.51,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.72,
      "end_seconds": 409.97,
      "duration_seconds": 19.25,
      "text": "I'd like to arrange an ECG for palpitations. Limit tea, coffee and anything that speeds up the heart for now. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.47,
      "end_seconds": 415.75,
      "duration_seconds": 4.28,
      "text": "Yeah, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.1,
      "end_seconds": 422.35,
      "duration_seconds": 6.25,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.51,
      "end_seconds": 428.14,
      "duration_seconds": 4.63,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.15,
      "end_seconds": 433.33,
      "duration_seconds": 4.18,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.43,
      "end_seconds": 437.7,
      "duration_seconds": 3.27,
      "text": "That's all, thank you for your time."
    }
  ]
}