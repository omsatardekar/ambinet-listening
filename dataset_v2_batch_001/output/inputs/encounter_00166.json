{
  "schema_version": "1.0",
  "encounter_id": "00166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.93,
      "duration_seconds": 3.39,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 9.15,
      "duration_seconds": 3.68,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.49,
      "end_seconds": 14.15,
      "duration_seconds": 4.66,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.17,
      "end_seconds": 20.32,
      "duration_seconds": 3.15,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.0,
      "end_seconds": 26.68,
      "duration_seconds": 5.68,
      "text": "Yeah, mainly heartburn. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.37,
      "end_seconds": 29.99,
      "duration_seconds": 2.62,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.35,
      "end_seconds": 36.71,
      "duration_seconds": 5.36,
      "text": "For two months, I'd say. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.25,
      "end_seconds": 39.69,
      "duration_seconds": 2.44,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.04,
      "end_seconds": 45.52,
      "duration_seconds": 4.48,
      "text": "Uh, it's worse with big meals and lying down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.55,
      "end_seconds": 49.43,
      "duration_seconds": 2.88,
      "text": "So, how bad is it, would you say?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.97,
      "end_seconds": 53.48,
      "duration_seconds": 2.51,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 57.92,
      "duration_seconds": 2.94,
      "text": "Okay, have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.23,
      "end_seconds": 61.66,
      "duration_seconds": 2.43,
      "text": "Only antacids, and it's not much."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.24,
      "end_seconds": 66.3,
      "duration_seconds": 3.06,
      "text": "Any a lump feeling in the throat as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.96,
      "end_seconds": 77.07,
      "duration_seconds": 10.11,
      "text": "Yeah, you know, I've had that since last Tuesday. Uh, there was chest discomfort after eating, yes, but that went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.39,
      "end_seconds": 94.06,
      "duration_seconds": 15.67,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 97.01,
      "duration_seconds": 1.82,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 100.69,
      "duration_seconds": 2.98,
      "text": "Any pain on exertion or black stools at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.43,
      "end_seconds": 105.25,
      "duration_seconds": 3.82,
      "text": "I haven't had pain on exertion or black stools, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.23,
      "end_seconds": 111.55,
      "duration_seconds": 3.32,
      "text": "Any anaemia, trouble swallowing or weight loss at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.45,
      "end_seconds": 114.73,
      "duration_seconds": 2.28,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.24,
      "end_seconds": 116.78,
      "duration_seconds": 1.54,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.3,
      "end_seconds": 120.64,
      "duration_seconds": 2.34,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.7,
      "end_seconds": 123.08,
      "duration_seconds": 1.38,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.57,
      "end_seconds": 126.88,
      "duration_seconds": 2.31,
      "text": "No operations, um, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.37,
      "end_seconds": 132.57,
      "duration_seconds": 4.2,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.41,
      "end_seconds": 136.85,
      "duration_seconds": 3.44,
      "text": "Yes, pollen, it gives me a runny nose."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.41,
      "end_seconds": 152.86,
      "duration_seconds": 14.45,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.81,
      "end_seconds": 155.34,
      "duration_seconds": 1.53,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 158.34,
      "duration_seconds": 2.16,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.76,
      "end_seconds": 161.11,
      "duration_seconds": 2.35,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.15,
      "end_seconds": 165.99,
      "duration_seconds": 3.84,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.3,
      "end_seconds": 188.79,
      "duration_seconds": 22.49,
      "text": "I've, I've had asthma, yes. I'd rather not end up on lots of tablets if I can avoid it. I kept putting it off, which I know isn't sensible. Acid reflux, for nearly five years. My family kept telling me to get it checked. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.3,
      "end_seconds": 198.0,
      "duration_seconds": 7.7,
      "text": "Mm. Right, so that's your known asthma. We'll keep that in mind today. Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.9,
      "end_seconds": 211.29,
      "duration_seconds": 12.39,
      "text": "Right, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.45,
      "end_seconds": 215.22,
      "duration_seconds": 2.77,
      "text": "So, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.54,
      "end_seconds": 226.75,
      "duration_seconds": 10.21,
      "text": "I'm, I'm on Seretide inhaler, twice a day for my asthma. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 230.88,
      "duration_seconds": 2.64,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.79,
      "end_seconds": 242.43,
      "duration_seconds": 6.64,
      "text": "For two years. Well, I take pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 242.76,
      "end_seconds": 249.83,
      "duration_seconds": 7.07,
      "text": "Doctor, I think the last prescription for the pantoprazole was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 254.25,
      "duration_seconds": 2.96,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.47,
      "end_seconds": 263.73,
      "duration_seconds": 8.26,
      "text": "Not with me. I'll bring it next time. Eno, when I get it. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.58,
      "end_seconds": 266.56,
      "duration_seconds": 1.98,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.09,
      "end_seconds": 276.59,
      "duration_seconds": 1.5,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.04,
      "end_seconds": 298.34,
      "duration_seconds": 8.3,
      "text": "Okay: weight 81 kilos, temp 36.8 degrees, heart rate 79, blood pressure 111 over 70, SpO2 98 percent on room air, height 151 centimetres."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.33,
      "end_seconds": 300.46,
      "duration_seconds": 1.13,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.24,
      "end_seconds": 306.13,
      "duration_seconds": 2.89,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.53,
      "end_seconds": 310.83,
      "duration_seconds": 3.3,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.54,
      "end_seconds": 314.77,
      "duration_seconds": 2.23,
      "text": "Okay, bear with me a second."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.45,
      "end_seconds": 333.38,
      "duration_seconds": 1.93,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.45,
      "end_seconds": 353.18,
      "duration_seconds": 15.73,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.17,
      "end_seconds": 357.35,
      "duration_seconds": 3.18,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.78,
      "end_seconds": 363.85,
      "duration_seconds": 5.07,
      "text": "Putting it all together, this looks most like gastro-oesophageal reflux. I can't rule out gastritis yet."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.61,
      "end_seconds": 366.88,
      "duration_seconds": 2.27,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.65,
      "end_seconds": 382.15,
      "duration_seconds": 14.5,
      "text": "I can't promise yet, but most people with gastro-oesophageal reflux do well once it's treated properly. Let me just recap so I've got it right. You've had heartburn for two months, severe, and no black stools or trouble swallowing."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.23,
      "end_seconds": 384.89,
      "duration_seconds": 1.66,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.62,
      "end_seconds": 412.19,
      "duration_seconds": 26.57,
      "text": "I'd like to arrange an ECG for chest discomfort. The result will help us decide whether anything more is needed. Let's get an upper endoscopy, for persistent reflux. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.52,
      "end_seconds": 420.02,
      "duration_seconds": 6.5,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.76,
      "end_seconds": 422.09,
      "duration_seconds": 1.33,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.22,
      "end_seconds": 429.43,
      "duration_seconds": 6.21,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.89,
      "end_seconds": 431.64,
      "duration_seconds": 1.75,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.08,
      "end_seconds": 435.21,
      "duration_seconds": 3.13,
      "text": "Please come and see me in six weeks."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.0,
      "end_seconds": 439.7,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.51,
      "end_seconds": 445.26,
      "duration_seconds": 4.75,
      "text": "Alright, can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.92,
      "end_seconds": 450.46,
      "duration_seconds": 4.54,
      "text": "So, you know, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.97,
      "end_seconds": 456.47,
      "duration_seconds": 4.5,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.01,
      "end_seconds": 459.05,
      "duration_seconds": 2.04,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.82,
      "end_seconds": 461.97,
      "duration_seconds": 2.15,
      "text": "Bye for now, look after yourself."
    }
  ]
}