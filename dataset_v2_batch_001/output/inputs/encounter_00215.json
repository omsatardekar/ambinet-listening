{
  "schema_version": "1.0",
  "encounter_id": "00215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 3.72,
      "duration_seconds": 2.86,
      "text": "Hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.65,
      "end_seconds": 8.1,
      "duration_seconds": 3.45,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.05,
      "end_seconds": 11.32,
      "duration_seconds": 2.27,
      "text": "It's headaches in the mornings, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.62,
      "end_seconds": 16.19,
      "duration_seconds": 3.57,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.15,
      "end_seconds": 20.06,
      "duration_seconds": 2.91,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.55,
      "end_seconds": 25.56,
      "duration_seconds": 4.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.33,
      "end_seconds": 31.19,
      "duration_seconds": 4.86,
      "text": "Moderate, I'd say. I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.52,
      "end_seconds": 34.61,
      "duration_seconds": 3.09,
      "text": "Any vision changes, palpitations or chest pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.82,
      "end_seconds": 37.49,
      "duration_seconds": 1.67,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.85,
      "end_seconds": 40.44,
      "duration_seconds": 2.59,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.47,
      "end_seconds": 55.73,
      "duration_seconds": 14.26,
      "text": "So, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.24,
      "end_seconds": 63.72,
      "duration_seconds": 6.48,
      "text": "Do you have any allergies to medicines, food, anything at all? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.17,
      "end_seconds": 67.43,
      "duration_seconds": 2.26,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.21,
      "end_seconds": 71.17,
      "duration_seconds": 2.96,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.21,
      "end_seconds": 75.81,
      "duration_seconds": 3.6,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.35,
      "end_seconds": 82.12,
      "duration_seconds": 5.77,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.22,
      "end_seconds": 87.69,
      "duration_seconds": 2.47,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.27,
      "end_seconds": 91.42,
      "duration_seconds": 2.15,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.76,
      "end_seconds": 94.15,
      "duration_seconds": 1.39,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.77,
      "end_seconds": 100.11,
      "duration_seconds": 5.34,
      "text": "Right, is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.65,
      "end_seconds": 109.32,
      "duration_seconds": 8.67,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 115.45,
      "duration_seconds": 3.23,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.03,
      "end_seconds": 118.49,
      "duration_seconds": 1.46,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.14,
      "end_seconds": 132.35,
      "duration_seconds": 2.21,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.52,
      "end_seconds": 134.22,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 137.01,
      "duration_seconds": 1.74,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 147.02,
      "duration_seconds": 1.33,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.92,
      "end_seconds": 163.83,
      "duration_seconds": 11.91,
      "text": "All done, thank you, please sit down. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.39,
      "end_seconds": 166.93,
      "duration_seconds": 2.54,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.83,
      "end_seconds": 168.58,
      "duration_seconds": 0.75,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.67,
      "end_seconds": 185.23,
      "duration_seconds": 7.56,
      "text": "Right, thanks for waiting. So, based on the history and the examination, my working impression is hypertension that isn't well controlled."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.38,
      "end_seconds": 188.56,
      "duration_seconds": 2.18,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.12,
      "end_seconds": 203.34,
      "duration_seconds": 14.22,
      "text": "I can't promise yet, but most people with hypertension that isn't well controlled do well once it's treated properly. Let me just recap so I've got it right. You've had headaches in the mornings for four weeks, moderate, and no palpitations or chest pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.56,
      "end_seconds": 205.85,
      "duration_seconds": 1.29,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.05,
      "end_seconds": 210.89,
      "duration_seconds": 3.84,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.46,
      "end_seconds": 212.21,
      "duration_seconds": 0.75,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.91,
      "end_seconds": 232.16,
      "duration_seconds": 4.25,
      "text": "Alright, I've got it. I'm going to order an ECG, for hypertension."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 233.23,
      "end_seconds": 236.97,
      "duration_seconds": 3.74,
      "text": "I can book that for Tuesday at 11:30 am."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.23,
      "end_seconds": 246.56,
      "duration_seconds": 6.33,
      "text": "I'll start you on amlodipine, 5 milligrams, once a day, long term. That should help with high blood pressure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.77,
      "end_seconds": 250.16,
      "duration_seconds": 2.39,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.62,
      "end_seconds": 269.7,
      "duration_seconds": 18.08,
      "text": "Salt is the big one, try to keep it low even though it's hard. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.22,
      "end_seconds": 272.54,
      "duration_seconds": 1.32,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.7,
      "end_seconds": 283.35,
      "duration_seconds": 8.65,
      "text": "Come back in a month. Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.77,
      "end_seconds": 293.62,
      "duration_seconds": 8.85,
      "text": "So, I take the amlodipine, 5 milligrams, once a day and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.08,
      "end_seconds": 301.76,
      "duration_seconds": 4.68,
      "text": "Yes, exactly right. Right, all right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.04,
      "end_seconds": 305.65,
      "duration_seconds": 2.61,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}