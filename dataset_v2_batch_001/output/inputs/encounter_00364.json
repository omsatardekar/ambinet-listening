{
  "schema_version": "1.0",
  "encounter_id": "00364",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.49,
      "duration_seconds": 3.19,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.25,
      "end_seconds": 9.64,
      "duration_seconds": 4.39,
      "text": "So, of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.5,
      "end_seconds": 13.57,
      "duration_seconds": 3.07,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.96,
      "end_seconds": 16.0,
      "duration_seconds": 2.04,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.64,
      "end_seconds": 19.56,
      "duration_seconds": 2.92,
      "text": "Well, I've been having the room spinning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.41,
      "end_seconds": 22.5,
      "duration_seconds": 2.09,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.75,
      "end_seconds": 31.07,
      "duration_seconds": 7.32,
      "text": "It's been like this since last Tuesday. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 34.42,
      "duration_seconds": 2.89,
      "text": "Alright. How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.96,
      "end_seconds": 49.07,
      "duration_seconds": 13.11,
      "text": "I'd give it a four, out of ten. And nausea, too. Oh, uh, and a bit of vomiting. With bit of vomiting, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.25,
      "end_seconds": 53.2,
      "duration_seconds": 2.95,
      "text": "Have you had any slurred speech or hearing loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.44,
      "end_seconds": 58.24,
      "duration_seconds": 3.8,
      "text": "No slurred speech or hearing loss, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.93,
      "end_seconds": 61.55,
      "duration_seconds": 2.62,
      "text": "Any weakness or numbness in the face?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.91,
      "end_seconds": 65.84,
      "duration_seconds": 3.93,
      "text": "No, no weakness or numbness in the face."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.87,
      "end_seconds": 68.85,
      "duration_seconds": 1.98,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.83,
      "end_seconds": 71.76,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.66,
      "end_seconds": 80.94,
      "duration_seconds": 5.28,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.5,
      "end_seconds": 93.11,
      "duration_seconds": 10.61,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.54,
      "end_seconds": 96.87,
      "duration_seconds": 3.33,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.5,
      "end_seconds": 100.54,
      "duration_seconds": 3.04,
      "text": "Okay, so not that I know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.59,
      "end_seconds": 104.89,
      "duration_seconds": 3.3,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.46,
      "end_seconds": 117.99,
      "duration_seconds": 12.53,
      "text": "Yes, you know, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.3,
      "end_seconds": 122.46,
      "duration_seconds": 3.16,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.02,
      "end_seconds": 128.02,
      "duration_seconds": 5.0,
      "text": "He is on hydrocortisone cream, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.1,
      "end_seconds": 132.65,
      "duration_seconds": 3.55,
      "text": "I was on Glycomet before. I stopped taking it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.67,
      "end_seconds": 137.27,
      "duration_seconds": 3.6,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.66,
      "end_seconds": 143.05,
      "duration_seconds": 4.39,
      "text": "I mean, my brother has asthma. My father had a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.0,
      "end_seconds": 145.16,
      "duration_seconds": 1.16,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.12,
      "end_seconds": 149.74,
      "duration_seconds": 3.62,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.45,
      "end_seconds": 154.68,
      "duration_seconds": 4.23,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.6,
      "end_seconds": 162.19,
      "duration_seconds": 6.59,
      "text": "Diabetes, for about a year. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.9,
      "end_seconds": 164.06,
      "duration_seconds": 1.16,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.48,
      "end_seconds": 166.69,
      "duration_seconds": 2.21,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.97,
      "end_seconds": 168.67,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 175.25,
      "duration_seconds": 5.07,
      "text": "I have eczema. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.66,
      "end_seconds": 184.5,
      "duration_seconds": 7.84,
      "text": "Okay, diabetes, that's already on your record. Good to know. Right, so that's your known high blood pressure. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 188.96,
      "duration_seconds": 3.25,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.85,
      "end_seconds": 190.55,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.64,
      "end_seconds": 204.85,
      "duration_seconds": 3.21,
      "text": "Okay, here we go. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 216.31,
      "duration_seconds": 1.92,
      "text": "Right, just relax your arm..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.97,
      "end_seconds": 247.4,
      "duration_seconds": 9.43,
      "text": "Okay: blood pressure 110 over 73, temperature is 36.9 degrees. And pulse is 70 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.56,
      "end_seconds": 250.03,
      "duration_seconds": 1.47,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.14,
      "end_seconds": 253.72,
      "duration_seconds": 2.58,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 258.6,
      "duration_seconds": 3.28,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.12,
      "end_seconds": 260.82,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.48,
      "end_seconds": 266.06,
      "duration_seconds": 3.58,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 289.64,
      "duration_seconds": 4.98,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.23,
      "end_seconds": 290.93,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.37,
      "end_seconds": 294.24,
      "duration_seconds": 1.87,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.61,
      "end_seconds": 309.47,
      "duration_seconds": 3.86,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.73,
      "end_seconds": 314.71,
      "duration_seconds": 1.98,
      "text": "Okay, you can sit back up."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.45,
      "end_seconds": 318.26,
      "duration_seconds": 2.81,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.89,
      "end_seconds": 319.73,
      "duration_seconds": 0.84,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.08,
      "end_seconds": 353.95,
      "duration_seconds": 25.87,
      "text": "Alright, I've got it. Putting it all together, I think we're dealing with benign positional vertigo at this stage. That's my thinking for now, and it may change as we learn more. I can't rule out a migraine-related dizziness yet. Let me just recap so I've got it right. You've had the room spinning, since last Tuesday, and no numbness in the face or hearing loss."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.25,
      "end_seconds": 357.48,
      "duration_seconds": 2.23,
      "text": "Right, yes, you've got it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.03,
      "end_seconds": 375.07,
      "duration_seconds": 16.04,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.55,
      "end_seconds": 377.47,
      "duration_seconds": 1.92,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.42,
      "end_seconds": 381.41,
      "duration_seconds": 2.99,
      "text": "Let's get a hearing test, for tinnitus and vertigo."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.9,
      "end_seconds": 386.44,
      "duration_seconds": 3.54,
      "text": "Hmm, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.24,
      "end_seconds": 407.43,
      "duration_seconds": 20.19,
      "text": "Let's use betahistine, 16 milligrams, three times a day, for two weeks. That should help with vertigo. There's a simple head manoeuvre we can do, and I'll show you how to repeat it at home. Get up slowly from lying down and sit for a moment first. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.96,
      "end_seconds": 416.97,
      "duration_seconds": 8.01,
      "text": "Please don't sit on it if you get weakness, slurred speech or a severe headache with the dizziness. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.24,
      "end_seconds": 420.01,
      "duration_seconds": 1.77,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.17,
      "end_seconds": 423.97,
      "duration_seconds": 2.8,
      "text": "Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.44,
      "end_seconds": 427.34,
      "duration_seconds": 1.9,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.84,
      "end_seconds": 434.52,
      "duration_seconds": 6.68,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 434.98,
      "end_seconds": 446.29,
      "duration_seconds": 11.31,
      "text": "So, you know, I take the betahistine, 16 milligrams, three times a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.59,
      "end_seconds": 452.33,
      "duration_seconds": 5.74,
      "text": "Right, yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 453.63,
      "end_seconds": 455.46,
      "duration_seconds": 1.83,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.78,
      "end_seconds": 457.67,
      "duration_seconds": 0.89,
      "text": "Alright, goodbye."
    }
  ]
}