{
  "schema_version": "1.0",
  "encounter_id": "00040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 6.42,
      "duration_seconds": 5.09,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.98,
      "end_seconds": 10.13,
      "duration_seconds": 3.15,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.65,
      "end_seconds": 21.35,
      "duration_seconds": 10.7,
      "text": "Um, hello, doctor. I hope it's alright if I stay in for this. Well, we came because of tingling in my fingers."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 23.56,
      "duration_seconds": 1.88,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.09,
      "end_seconds": 29.51,
      "duration_seconds": 5.42,
      "text": "About... well, five days. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.46,
      "end_seconds": 38.6,
      "duration_seconds": 8.14,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.45,
      "end_seconds": 52.36,
      "duration_seconds": 12.91,
      "text": "Severe, I'd say. It happens every other day. I did try to ignore it for a while. Oh, and numbness in the thumb and first two fingers. Had that since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.28,
      "end_seconds": 56.27,
      "duration_seconds": 2.99,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.95,
      "end_seconds": 69.82,
      "duration_seconds": 12.87,
      "text": "Hmm, it sort of comes and goes. Okay, uh, so I've been waking up at night with pins and needles too, for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.05,
      "end_seconds": 73.36,
      "duration_seconds": 2.31,
      "text": "Alright, what about weakness in the legs?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.67,
      "end_seconds": 77.2,
      "duration_seconds": 3.53,
      "text": "No weakness in the legs, thank goodness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.82,
      "end_seconds": 84.82,
      "duration_seconds": 4.0,
      "text": "Any trouble walking, swelling in the joints, neck pain or bladder problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.26,
      "end_seconds": 93.01,
      "duration_seconds": 6.75,
      "text": "Oh, no, no trouble walking, swelling in the joints, neck pain or bladder problems."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 95.0,
      "duration_seconds": 0.74,
      "text": "Any headache?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.43,
      "end_seconds": 96.85,
      "duration_seconds": 1.42,
      "text": "No, no headache."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 97.44,
      "end_seconds": 103.11,
      "duration_seconds": 5.67,
      "text": "Oh, uh, actually, doctor, I did notice headache. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.61,
      "end_seconds": 109.69,
      "duration_seconds": 6.08,
      "text": "I mean, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.15,
      "end_seconds": 116.46,
      "duration_seconds": 5.31,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.31,
      "end_seconds": 119.68,
      "duration_seconds": 2.37,
      "text": "So, no, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.67,
      "end_seconds": 123.62,
      "duration_seconds": 2.95,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.11,
      "end_seconds": 130.4,
      "duration_seconds": 3.29,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.86,
      "end_seconds": 133.78,
      "duration_seconds": 1.92,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.44,
      "end_seconds": 140.42,
      "duration_seconds": 5.98,
      "text": "Yes, you know, I had a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 143.69,
      "duration_seconds": 1.86,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.04,
      "end_seconds": 150.45,
      "duration_seconds": 5.41,
      "text": "It's Glycomet, 500 milligrams, twice a day. Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 151.0,
      "end_seconds": 159.3,
      "duration_seconds": 8.3,
      "text": "Doctor, I think the last prescription for the Thyronorm was 100 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.83,
      "end_seconds": 163.63,
      "duration_seconds": 2.8,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.9,
      "end_seconds": 168.11,
      "duration_seconds": 3.21,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.59,
      "end_seconds": 174.98,
      "duration_seconds": 5.39,
      "text": "So, any long-term health problems I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.58,
      "end_seconds": 182.08,
      "duration_seconds": 6.5,
      "text": "I have diabetes, for five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.33,
      "end_seconds": 184.03,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.63,
      "end_seconds": 189.17,
      "duration_seconds": 4.54,
      "text": "Okay, so I have an underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.6,
      "end_seconds": 196.66,
      "duration_seconds": 7.06,
      "text": "Right, so that's your known an underactive thyroid. We'll keep that in mind today. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.0,
      "end_seconds": 201.3,
      "duration_seconds": 4.3,
      "text": "Oh, uh, no, none that I know of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.36,
      "end_seconds": 205.4,
      "duration_seconds": 1.04,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.59,
      "end_seconds": 210.54,
      "duration_seconds": 3.95,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.84,
      "end_seconds": 214.54,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.9,
      "end_seconds": 218.27,
      "duration_seconds": 3.37,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.3,
      "end_seconds": 222.72,
      "duration_seconds": 3.42,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.66,
      "end_seconds": 233.02,
      "duration_seconds": 1.36,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 253.74,
      "duration_seconds": 10.62,
      "text": "Okay: heart rate 66, weight 69 kilos, BMI works out to 23.6, blood pressure 126 over 77, height 171 centimetres, saturation 97 percent, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.42,
      "end_seconds": 259.47,
      "duration_seconds": 4.05,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.58,
      "end_seconds": 262.93,
      "duration_seconds": 2.35,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.34,
      "end_seconds": 278.82,
      "duration_seconds": 3.48,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 281.65,
      "duration_seconds": 1.85,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.68,
      "end_seconds": 291.1,
      "duration_seconds": 2.42,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.41,
      "end_seconds": 293.11,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.28,
      "end_seconds": 296.0,
      "duration_seconds": 1.72,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.53,
      "end_seconds": 306.02,
      "duration_seconds": 2.49,
      "text": "Power in the thumb is slightly reduced."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.92,
      "end_seconds": 308.62,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 338.33,
      "duration_seconds": 26.84,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Putting it all together, this looks most like carpal tunnel syndrome. I can't rule out a pinched nerve in the neck yet. Let's get a blood sugar test, for neuropathy screen. I'm going to order a nerve conduction study, for hand numbness."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.44,
      "end_seconds": 341.89,
      "duration_seconds": 2.45,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.25,
      "end_seconds": 346.35,
      "duration_seconds": 4.1,
      "text": "A night wrist splint, kept neutral, usually helps a lot."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.86,
      "end_seconds": 358.64,
      "duration_seconds": 11.78,
      "text": "Right. Please take the tablets with food so they don't upset your stomach. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.07,
      "end_seconds": 360.4,
      "duration_seconds": 1.33,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.97,
      "end_seconds": 366.88,
      "duration_seconds": 5.91,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.06,
      "end_seconds": 370.32,
      "duration_seconds": 2.26,
      "text": "Okay, um, I understand."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.77,
      "end_seconds": 378.3,
      "duration_seconds": 6.53,
      "text": "Please come and see me after the results are back. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.88,
      "end_seconds": 381.63,
      "duration_seconds": 2.75,
      "text": "Oh, I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.77,
      "end_seconds": 384.94,
      "duration_seconds": 2.17,
      "text": "Bye for now, look after yourself."
    }
  ]
}