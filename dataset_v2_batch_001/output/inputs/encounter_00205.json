{
  "schema_version": "1.0",
  "encounter_id": "00205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 8.83,
      "duration_seconds": 7.74,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 12.94,
      "duration_seconds": 3.71,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.73,
      "end_seconds": 17.27,
      "duration_seconds": 3.54,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.33,
      "end_seconds": 21.38,
      "duration_seconds": 3.05,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.08,
      "end_seconds": 27.37,
      "duration_seconds": 5.29,
      "text": "It's fever, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.35,
      "end_seconds": 32.4,
      "duration_seconds": 2.05,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.72,
      "end_seconds": 41.06,
      "duration_seconds": 7.34,
      "text": "It's, It's been three days now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.85,
      "end_seconds": 44.76,
      "duration_seconds": 2.91,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.51,
      "end_seconds": 47.76,
      "duration_seconds": 2.25,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.77,
      "end_seconds": 51.46,
      "duration_seconds": 2.69,
      "text": "So, how much is it bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.96,
      "end_seconds": 58.21,
      "duration_seconds": 5.25,
      "text": "It's moderate, honestly. I've also had body aches, for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.02,
      "end_seconds": 62.95,
      "duration_seconds": 3.93,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.86,
      "end_seconds": 78.15,
      "duration_seconds": 14.29,
      "text": "Uh, you know, I'd give it a four, out of ten. Honestly, a few times a day. Oh, and a sore throat. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.75,
      "end_seconds": 81.61,
      "duration_seconds": 1.86,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.08,
      "end_seconds": 83.45,
      "duration_seconds": 1.37,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.86,
      "end_seconds": 87.49,
      "duration_seconds": 3.63,
      "text": "Have you had any chest pain or burning when passing urine?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.85,
      "end_seconds": 91.31,
      "duration_seconds": 2.46,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.79,
      "end_seconds": 94.94,
      "duration_seconds": 3.15,
      "text": "Let me check a few things. Any vomiting or diarrhoea?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.07,
      "end_seconds": 99.75,
      "duration_seconds": 3.68,
      "text": "Okay, so no, no vomiting or diarrhoea."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.59,
      "end_seconds": 105.36,
      "duration_seconds": 1.77,
      "text": "Has there been any rash?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.58,
      "end_seconds": 107.84,
      "duration_seconds": 1.26,
      "text": "No. No rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 108.6,
      "end_seconds": 113.62,
      "duration_seconds": 5.02,
      "text": "Actually, uh, doctor, I did notice rash. She doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.91,
      "end_seconds": 121.52,
      "duration_seconds": 6.61,
      "text": "Yeah, you know, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.97,
      "end_seconds": 128.82,
      "duration_seconds": 5.85,
      "text": "Alright, I'll note both what you've said and what you've noticed. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.5,
      "end_seconds": 132.82,
      "duration_seconds": 3.32,
      "text": "No, you know, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.25,
      "end_seconds": 135.88,
      "duration_seconds": 2.63,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.28,
      "end_seconds": 139.51,
      "duration_seconds": 2.23,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.9,
      "end_seconds": 143.26,
      "duration_seconds": 2.36,
      "text": "Okay, does anything run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.82,
      "end_seconds": 148.44,
      "duration_seconds": 4.62,
      "text": "My father had a heart attack. My brother has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 150.56,
      "duration_seconds": 1.25,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.44,
      "end_seconds": 153.7,
      "duration_seconds": 2.26,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.26,
      "end_seconds": 158.41,
      "duration_seconds": 4.15,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.98,
      "end_seconds": 172.79,
      "duration_seconds": 12.81,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.24,
      "end_seconds": 178.23,
      "duration_seconds": 3.99,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.55,
      "end_seconds": 181.07,
      "duration_seconds": 2.52,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.64,
      "end_seconds": 185.23,
      "duration_seconds": 3.59,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.96,
      "end_seconds": 186.82,
      "duration_seconds": 0.86,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.14,
      "end_seconds": 210.72,
      "duration_seconds": 8.58,
      "text": "Okay, here we go. Moving on to your background, any past medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.44,
      "end_seconds": 224.95,
      "duration_seconds": 10.51,
      "text": "Yeah, I've had asthma for five years now. It's the not knowing that gets to me. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.97,
      "end_seconds": 227.04,
      "duration_seconds": 1.07,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.01,
      "end_seconds": 235.16,
      "duration_seconds": 7.15,
      "text": "High blood pressure, for about a year. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 236.6,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.42,
      "end_seconds": 239.6,
      "duration_seconds": 2.18,
      "text": "One moment, I'm updating your notes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 257.18,
      "duration_seconds": 7.55,
      "text": "Alright, back to you. Any medication at the moment, including things from the pharmacy? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.04,
      "end_seconds": 264.18,
      "duration_seconds": 6.14,
      "text": "I'm on Asthalin inhaler, when needed. I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.51,
      "end_seconds": 267.25,
      "duration_seconds": 2.74,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.6,
      "end_seconds": 272.59,
      "duration_seconds": 4.99,
      "text": "For six months. Paracetamol. I take it 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 274.99,
      "end_seconds": 279.65,
      "duration_seconds": 4.66,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.23,
      "end_seconds": 283.01,
      "duration_seconds": 2.78,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.17,
      "end_seconds": 287.79,
      "duration_seconds": 3.62,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.25,
      "end_seconds": 294.94,
      "duration_seconds": 3.69,
      "text": "Right, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.47,
      "end_seconds": 307.25,
      "duration_seconds": 11.78,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.77,
      "end_seconds": 310.39,
      "duration_seconds": 1.62,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 311.21,
      "end_seconds": 312.68,
      "duration_seconds": 1.47,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.51,
      "end_seconds": 316.01,
      "duration_seconds": 2.5,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 316.49,
      "end_seconds": 317.46,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.55,
      "end_seconds": 329.94,
      "duration_seconds": 1.39,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 331.47,
      "end_seconds": 340.11,
      "duration_seconds": 8.64,
      "text": "Doctor, I've got the readings for you. Respiratory rate 17, temperature is 38.7 degrees, blood pressure 120 over 76. Saturation 96 percent, pulse 108."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.69,
      "end_seconds": 346.02,
      "duration_seconds": 4.33,
      "text": "Good, thank you. Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.91,
      "end_seconds": 348.2,
      "duration_seconds": 1.29,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.35,
      "end_seconds": 361.94,
      "duration_seconds": 12.59,
      "text": "So, based on your history, this looks most like a viral illness. The reason I say that is that the way you describe it fits together. I can't rule out influenza yet."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.51,
      "end_seconds": 365.07,
      "duration_seconds": 2.56,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.23,
      "end_seconds": 384.42,
      "duration_seconds": 18.19,
      "text": "I understand the worry. At the moment I'd say it's a viral illness, and we'll know more once the a throat swab is back. Let me just recap so I've got it right. You've had fever for three days, moderate, and no chest pain or vomiting."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.72,
      "end_seconds": 387.01,
      "duration_seconds": 2.29,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.18,
      "end_seconds": 394.75,
      "duration_seconds": 6.57,
      "text": "Let's get a throat swab, for sore throat. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 396.23,
      "end_seconds": 401.38,
      "duration_seconds": 5.15,
      "text": "Doctor, I did a flu swab before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.25,
      "end_seconds": 425.76,
      "duration_seconds": 23.51,
      "text": "Perfect. We should do blood tests for fever. The result will help us decide whether anything more is needed. I'd like you to take cetirizine, 10 milligrams, at night, for five days. You take it by mouth. It's for blocked nose. It's a commonly used medicine and most people tolerate it well. Stay home, rest, and keep the fluids up. Warm soups and water, anything that goes down easily."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.69,
      "end_seconds": 441.13,
      "duration_seconds": 14.44,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 442.53,
      "end_seconds": 443.95,
      "duration_seconds": 1.42,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.37,
      "end_seconds": 458.16,
      "duration_seconds": 13.79,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department. Let's review you in a week. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 459.41,
      "end_seconds": 467.5,
      "duration_seconds": 8.09,
      "text": "So, I take the cetirizine, 10 milligrams, at night and come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 468.75,
      "end_seconds": 472.61,
      "duration_seconds": 3.86,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 473.92,
      "end_seconds": 476.37,
      "duration_seconds": 2.45,
      "text": "Well, no questions. Thank you."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 476.95,
      "end_seconds": 477.65,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}