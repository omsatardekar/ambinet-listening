{
  "schema_version": "1.0",
  "encounter_id": "00322",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 3.79,
      "duration_seconds": 2.99,
      "text": "So, evening. Long day, I imagine. Sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.21,
      "end_seconds": 4.91,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 8.75,
      "duration_seconds": 2.39,
      "text": "Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.11,
      "end_seconds": 12.85,
      "duration_seconds": 3.74,
      "text": "Um, yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.56,
      "end_seconds": 19.15,
      "duration_seconds": 2.59,
      "text": "Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.1,
      "end_seconds": 32.56,
      "duration_seconds": 12.46,
      "text": "Doctor, it's tiredness all the time. It's getting on my nerves now. I'm hoping you can tell me something definite. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 35.21,
      "duration_seconds": 1.67,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.65,
      "end_seconds": 37.46,
      "duration_seconds": 1.81,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.96,
      "end_seconds": 40.88,
      "duration_seconds": 1.92,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.34,
      "end_seconds": 44.84,
      "duration_seconds": 2.5,
      "text": "A good night's sleep helps a bit."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 47.58,
      "duration_seconds": 1.54,
      "text": "Any trouble concentrating as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.17,
      "end_seconds": 49.52,
      "duration_seconds": 1.35,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.49,
      "end_seconds": 53.66,
      "duration_seconds": 3.17,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.98,
      "end_seconds": 60.08,
      "duration_seconds": 6.1,
      "text": "Uh, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.99,
      "end_seconds": 64.11,
      "duration_seconds": 3.12,
      "text": "Okay, any fever or night sweats at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.18,
      "end_seconds": 67.03,
      "duration_seconds": 1.85,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.31,
      "end_seconds": 75.04,
      "duration_seconds": 4.73,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.91,
      "end_seconds": 85.59,
      "duration_seconds": 9.68,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.97,
      "end_seconds": 89.31,
      "duration_seconds": 2.34,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.44,
      "end_seconds": 100.82,
      "duration_seconds": 10.38,
      "text": "Yeah, it's glimepiride, 2 milligrams, before breakfast for my sugar. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.26,
      "end_seconds": 113.92,
      "duration_seconds": 12.66,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.53,
      "end_seconds": 119.09,
      "duration_seconds": 2.56,
      "text": "Right, um, I understand now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.62,
      "end_seconds": 121.64,
      "duration_seconds": 2.02,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.67,
      "end_seconds": 124.76,
      "duration_seconds": 2.09,
      "text": "No operations, you know, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.1,
      "end_seconds": 128.77,
      "duration_seconds": 3.67,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.28,
      "end_seconds": 133.06,
      "duration_seconds": 2.78,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.72,
      "end_seconds": 137.32,
      "duration_seconds": 3.6,
      "text": "So, do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.65,
      "end_seconds": 150.35,
      "duration_seconds": 12.7,
      "text": "Uh, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.89,
      "end_seconds": 158.5,
      "duration_seconds": 6.61,
      "text": "Do you have any medical conditions, anything you've been treated for? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.88,
      "end_seconds": 164.4,
      "duration_seconds": 5.52,
      "text": "I have diabetes, for five years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.37,
      "end_seconds": 168.62,
      "duration_seconds": 3.25,
      "text": "Okay. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.04,
      "end_seconds": 172.41,
      "duration_seconds": 3.37,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.28,
      "end_seconds": 175.14,
      "duration_seconds": 1.86,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.49,
      "end_seconds": 189.55,
      "duration_seconds": 2.06,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.57,
      "end_seconds": 223.69,
      "duration_seconds": 23.12,
      "text": "Okay: blood pressure 118 over 74, saturation 97 percent, pulse is 67 beats a minute, respiratory rate 14. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.06,
      "end_seconds": 226.16,
      "duration_seconds": 2.1,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.13,
      "end_seconds": 238.26,
      "duration_seconds": 11.13,
      "text": "Okay, so my impression from what you've said is this: My working impression is fatigue with no clear cause yet. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.12,
      "end_seconds": 241.54,
      "duration_seconds": 2.42,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.32,
      "end_seconds": 257.13,
      "duration_seconds": 14.81,
      "text": "Nothing I've seen today points to an emergency. It looks like fatigue with no clear cause yet, but I'd like to confirm. Let me just recap so I've got it right. You've had tiredness all the time for one week, and no fever or night sweats."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.32,
      "end_seconds": 259.58,
      "duration_seconds": 1.26,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.51,
      "end_seconds": 263.27,
      "duration_seconds": 2.76,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.58,
      "end_seconds": 264.31,
      "duration_seconds": 0.73,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 283.12,
      "duration_seconds": 8.43,
      "text": "Right, thanks for waiting. Let's get blood tests, for fatigue. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 284.01,
      "end_seconds": 288.62,
      "duration_seconds": 4.61,
      "text": "We have a slot Monday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.58,
      "end_seconds": 300.01,
      "duration_seconds": 10.43,
      "text": "I'll start you on vitamin D, 60000 units, once a week, for eight weeks. That's for low energy. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.52,
      "end_seconds": 303.71,
      "duration_seconds": 3.19,
      "text": "Alright, uh, I'll pick it up today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.29,
      "end_seconds": 319.86,
      "duration_seconds": 15.57,
      "text": "Try to keep a regular sleep time and get some daylight in the morning. Cut down on salt and fried food for now, it really does make a difference. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.93,
      "end_seconds": 322.59,
      "duration_seconds": 1.66,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.4,
      "end_seconds": 332.1,
      "duration_seconds": 8.7,
      "text": "Please come and see me after the results are back. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.46,
      "end_seconds": 337.1,
      "duration_seconds": 4.64,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.57,
      "end_seconds": 343.0,
      "duration_seconds": 5.43,
      "text": "Right, yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.63,
      "end_seconds": 345.71,
      "duration_seconds": 2.08,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}