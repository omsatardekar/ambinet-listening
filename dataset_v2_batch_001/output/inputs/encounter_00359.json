{
  "schema_version": "1.0",
  "encounter_id": "00359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.02,
      "end_seconds": 4.11,
      "duration_seconds": 3.09,
      "text": "Right, afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.59,
      "end_seconds": 9.19,
      "duration_seconds": 3.6,
      "text": "Thanks, doctor. It's been a long few days."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.47,
      "end_seconds": 15.6,
      "duration_seconds": 2.13,
      "text": "Did you take the bus in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.25,
      "end_seconds": 18.94,
      "duration_seconds": 2.69,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.91,
      "end_seconds": 21.96,
      "duration_seconds": 2.05,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.56,
      "end_seconds": 35.51,
      "duration_seconds": 11.95,
      "text": "So the thing is, I've got numbness on the left side of my face. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.3,
      "end_seconds": 38.44,
      "duration_seconds": 2.14,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.46,
      "end_seconds": 44.26,
      "duration_seconds": 4.8,
      "text": "For one week, I'd say. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.28,
      "end_seconds": 58.1,
      "duration_seconds": 12.82,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.33,
      "end_seconds": 62.8,
      "duration_seconds": 3.47,
      "text": "Yeah, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.08,
      "end_seconds": 66.69,
      "duration_seconds": 2.61,
      "text": "Any fall or chest pain at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.11,
      "end_seconds": 70.41,
      "duration_seconds": 2.3,
      "text": "No, no fall or chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.94,
      "end_seconds": 74.45,
      "duration_seconds": 3.51,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.76,
      "end_seconds": 75.46,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.92,
      "end_seconds": 95.29,
      "duration_seconds": 6.37,
      "text": "Alright, I've got it. Any allergies I should know about? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.99,
      "end_seconds": 97.24,
      "duration_seconds": 1.25,
      "text": "Codeine, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.68,
      "end_seconds": 114.53,
      "duration_seconds": 13.85,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.06,
      "end_seconds": 117.13,
      "duration_seconds": 2.07,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.29,
      "end_seconds": 121.99,
      "duration_seconds": 3.7,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.51,
      "end_seconds": 124.49,
      "duration_seconds": 0.98,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.82,
      "end_seconds": 128.86,
      "duration_seconds": 3.04,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.31,
      "end_seconds": 131.66,
      "duration_seconds": 2.35,
      "text": "I take metformin, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.19,
      "end_seconds": 133.98,
      "duration_seconds": 1.79,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.37,
      "end_seconds": 148.39,
      "duration_seconds": 11.02,
      "text": "500 milligrams, I think that's what's on the box. Aspirin, 75 milligrams, once a day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.77,
      "end_seconds": 164.24,
      "duration_seconds": 14.47,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.69,
      "end_seconds": 166.34,
      "duration_seconds": 1.65,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.01,
      "end_seconds": 169.73,
      "duration_seconds": 1.72,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.02,
      "end_seconds": 173.38,
      "duration_seconds": 2.36,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.49,
      "end_seconds": 191.62,
      "duration_seconds": 3.13,
      "text": "There's mild drooping at the left corner of your mouth."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.49,
      "end_seconds": 194.72,
      "duration_seconds": 2.23,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.47,
      "end_seconds": 213.53,
      "duration_seconds": 3.06,
      "text": "Grip strength is a little weaker on the left."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.64,
      "end_seconds": 217.64,
      "duration_seconds": 2.0,
      "text": "That's fine, you can get dressed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.85,
      "end_seconds": 221.95,
      "duration_seconds": 3.1,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.65,
      "end_seconds": 223.54,
      "duration_seconds": 0.89,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.87,
      "end_seconds": 249.48,
      "duration_seconds": 13.61,
      "text": "Alright, I've got it. Putting it all together, I think we're dealing with a possible mini-stroke, which we need to investigate urgently at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 255.27,
      "duration_seconds": 2.26,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.77,
      "end_seconds": 275.33,
      "duration_seconds": 19.56,
      "text": "I understand the worry. At the moment I'd say it's a possible mini-stroke, which we need to investigate urgently, and we'll know more once the a carotid scan is back. Let me just recap so I've got it right. You've had numbness on the left side of your face for one week, and no fall or chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.26,
      "end_seconds": 278.18,
      "duration_seconds": 1.92,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.4,
      "end_seconds": 282.5,
      "duration_seconds": 3.1,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.26,
      "end_seconds": 284.08,
      "duration_seconds": 0.82,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.02,
      "end_seconds": 321.06,
      "duration_seconds": 21.04,
      "text": "Alright, I've got it. Let's get a carotid scan, for possible stroke. I'd rather check than guess, and this is the quickest way to know more. Don't drive for now, and bring someone with you to the next visit. Please take the tablets with food so they don't upset your stomach. We'll refer you to the stroke clinic."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.14,
      "end_seconds": 329.78,
      "duration_seconds": 7.64,
      "text": "Keep an eye out, and if the numbness, weakness or speech problem returns, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.19,
      "end_seconds": 331.39,
      "duration_seconds": 1.2,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.71,
      "end_seconds": 335.65,
      "duration_seconds": 2.94,
      "text": "Please come and see me in one week."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.14,
      "end_seconds": 336.84,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.45,
      "end_seconds": 343.75,
      "duration_seconds": 6.3,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.52,
      "end_seconds": 349.33,
      "duration_seconds": 4.81,
      "text": "So, you know, I come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.58,
      "end_seconds": 354.37,
      "duration_seconds": 3.79,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.9,
      "end_seconds": 358.61,
      "duration_seconds": 2.71,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}