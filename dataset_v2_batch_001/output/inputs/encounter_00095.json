{
  "schema_version": "1.0",
  "encounter_id": "00095",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 4.41,
      "duration_seconds": 3.05,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.21,
      "end_seconds": 11.09,
      "duration_seconds": 3.88,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.87,
      "end_seconds": 16.96,
      "duration_seconds": 5.09,
      "text": "Morning, uh, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 20.68,
      "duration_seconds": 2.79,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.12,
      "end_seconds": 26.68,
      "duration_seconds": 5.56,
      "text": "Honestly, it's the room spinning, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.51,
      "end_seconds": 29.11,
      "duration_seconds": 1.6,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.31,
      "end_seconds": 33.62,
      "duration_seconds": 3.31,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.0,
      "end_seconds": 36.98,
      "duration_seconds": 1.98,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.68,
      "end_seconds": 40.52,
      "duration_seconds": 2.84,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.04,
      "end_seconds": 41.74,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.12,
      "end_seconds": 53.22,
      "duration_seconds": 11.1,
      "text": "I've been feeling unsteady too, for about four days. And there's nausea as well, about four days now. About nausea, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.7,
      "end_seconds": 58.16,
      "duration_seconds": 3.46,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.73,
      "end_seconds": 61.75,
      "duration_seconds": 2.02,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.1,
      "end_seconds": 65.92,
      "duration_seconds": 3.82,
      "text": "Any numbness in the face, double vision or hearing loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.0,
      "end_seconds": 71.54,
      "duration_seconds": 4.54,
      "text": "No, no numbness in the face, double vision or hearing loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.04,
      "end_seconds": 78.24,
      "duration_seconds": 6.2,
      "text": "Let's go through your medication. What are you taking? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.72,
      "end_seconds": 91.2,
      "duration_seconds": 12.48,
      "text": "I'm on telmisartan, 40 milligrams, once a day for my pressure. I'd rather not end up on lots of tablets if I can avoid it. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.68,
      "end_seconds": 94.42,
      "duration_seconds": 2.74,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.99,
      "end_seconds": 97.25,
      "duration_seconds": 1.26,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.65,
      "end_seconds": 98.88,
      "duration_seconds": 1.23,
      "text": "Go on. Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.21,
      "end_seconds": 101.35,
      "duration_seconds": 1.14,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.11,
      "end_seconds": 103.73,
      "duration_seconds": 1.62,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.83,
      "end_seconds": 109.07,
      "duration_seconds": 4.24,
      "text": "Yes, I had a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.59,
      "end_seconds": 113.78,
      "duration_seconds": 4.19,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.47,
      "end_seconds": 126.43,
      "duration_seconds": 11.96,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 134.11,
      "duration_seconds": 6.21,
      "text": "Do you have any known allergies at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.3,
      "end_seconds": 137.55,
      "duration_seconds": 2.25,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 141.73,
      "duration_seconds": 2.75,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 144.5,
      "duration_seconds": 1.28,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.8,
      "end_seconds": 149.02,
      "duration_seconds": 3.22,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.22,
      "end_seconds": 162.77,
      "duration_seconds": 12.55,
      "text": "I've had high blood pressure for about ten years now. I didn't want to make a fuss, you know. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.14,
      "end_seconds": 165.83,
      "duration_seconds": 2.69,
      "text": "Okay, I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.76,
      "end_seconds": 176.01,
      "duration_seconds": 1.25,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.01,
      "end_seconds": 215.84,
      "duration_seconds": 21.83,
      "text": "Okay: pulse 65, BP is 115 over 81, SpO2 98 percent on room air. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.76,
      "end_seconds": 218.67,
      "duration_seconds": 1.91,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.83,
      "end_seconds": 222.1,
      "duration_seconds": 2.27,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.99,
      "end_seconds": 224.44,
      "duration_seconds": 1.45,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.26,
      "end_seconds": 227.83,
      "duration_seconds": 1.57,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.8,
      "end_seconds": 246.52,
      "duration_seconds": 5.72,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.82,
      "end_seconds": 249.13,
      "duration_seconds": 1.31,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 263.05,
      "duration_seconds": 3.55,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 281.9,
      "duration_seconds": 15.35,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Just to be sure I've got this right, the telmisartan, what dose was that again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.59,
      "end_seconds": 287.81,
      "duration_seconds": 1.22,
      "text": "40 milligrams. Yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.17,
      "end_seconds": 293.15,
      "duration_seconds": 4.98,
      "text": "So, based on the history and the examination, this looks most like benign positional vertigo."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.85,
      "end_seconds": 296.1,
      "duration_seconds": 2.25,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.28,
      "end_seconds": 313.19,
      "duration_seconds": 15.91,
      "text": "It's reasonable to be concerned, but right now benign positional vertigo is my leading thought, not anything worse. Let me just recap so I've got it right. You've had the room spinning for about four days, moderate, and no double vision or hearing loss."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 315.29,
      "duration_seconds": 1.23,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.71,
      "end_seconds": 320.22,
      "duration_seconds": 3.51,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.81,
      "end_seconds": 321.51,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.95,
      "end_seconds": 357.83,
      "duration_seconds": 28.88,
      "text": "Okay, here we go. Let's get a hearing test, for tinnitus and vertigo. I'd like you to take betahistine, 16 milligrams, three times a day, for two weeks. That's for vertigo. The pharmacy will go through the details again when you pick it up. Get up slowly from lying down and sit for a moment first. If you smoke, this is a good moment to think about stopping, and we can help you with that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.12,
      "end_seconds": 385.15,
      "duration_seconds": 26.03,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. If you get weakness, slurred speech or a severe headache with the dizziness, or you feel really unwell, please don't wait, come to the emergency department. I'd like to see you again in two weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.32,
      "end_seconds": 394.0,
      "duration_seconds": 7.68,
      "text": "So, I take the betahistine, 16 milligrams, three times a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.61,
      "end_seconds": 399.15,
      "duration_seconds": 4.54,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.62,
      "end_seconds": 405.5,
      "duration_seconds": 4.88,
      "text": "Okay, um, thank you. I'll get started on all of that."
    }
  ]
}