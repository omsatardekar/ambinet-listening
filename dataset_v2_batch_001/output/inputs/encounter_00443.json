{
  "schema_version": "1.0",
  "encounter_id": "00443",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.33,
      "duration_seconds": 3.95,
      "text": "Excuse me, um, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.79,
      "end_seconds": 9.09,
      "duration_seconds": 3.3,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.35,
      "end_seconds": 13.21,
      "duration_seconds": 2.86,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.75,
      "end_seconds": 16.76,
      "duration_seconds": 3.01,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.68,
      "end_seconds": 20.66,
      "duration_seconds": 2.98,
      "text": "We came because of headaches in the mornings."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.02,
      "end_seconds": 22.78,
      "duration_seconds": 1.76,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 30.15,
      "duration_seconds": 5.11,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.32,
      "end_seconds": 36.26,
      "duration_seconds": 4.94,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.59,
      "end_seconds": 40.92,
      "duration_seconds": 1.33,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.8,
      "end_seconds": 44.22,
      "duration_seconds": 2.42,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.31,
      "end_seconds": 51.17,
      "duration_seconds": 5.86,
      "text": "When it starts I tend to get a ringing in the ears as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.17,
      "end_seconds": 57.16,
      "duration_seconds": 4.99,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 57.26,
      "end_seconds": 62.3,
      "duration_seconds": 5.04,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.98,
      "end_seconds": 65.32,
      "duration_seconds": 2.34,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.33,
      "end_seconds": 70.49,
      "duration_seconds": 4.16,
      "text": "The ringing in the ears? That's been for three weeks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 71.86,
      "end_seconds": 74.83,
      "duration_seconds": 2.97,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.28,
      "end_seconds": 77.92,
      "duration_seconds": 1.64,
      "text": "Any vision changes or nosebleeds?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.26,
      "end_seconds": 88.5,
      "duration_seconds": 9.24,
      "text": "No, you know, no vision changes, no nosebleeds. I did have occasional dizziness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.44,
      "end_seconds": 93.04,
      "duration_seconds": 1.6,
      "text": "Have you had any palpitations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.09,
      "end_seconds": 96.68,
      "duration_seconds": 2.59,
      "text": "No, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 97.27,
      "end_seconds": 102.38,
      "duration_seconds": 5.11,
      "text": "Uh, actually, doctor, I did notice palpitations. She doesn't always say."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.1,
      "end_seconds": 111.11,
      "duration_seconds": 5.01,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.79,
      "end_seconds": 120.71,
      "duration_seconds": 8.92,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any breathlessness, weakness or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.3,
      "end_seconds": 124.5,
      "duration_seconds": 3.2,
      "text": "Hmm, no, none of that at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.96,
      "end_seconds": 127.49,
      "duration_seconds": 2.53,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.06,
      "end_seconds": 129.82,
      "duration_seconds": 1.76,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.61,
      "end_seconds": 138.4,
      "duration_seconds": 3.79,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.1,
      "end_seconds": 152.53,
      "duration_seconds": 13.43,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 153.78,
      "end_seconds": 162.7,
      "duration_seconds": 8.92,
      "text": "Okay, so the vitals from earlier. Pulse is 92 beats a minute, BP is 172 over 93, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.75,
      "end_seconds": 164.64,
      "duration_seconds": 0.89,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 168.73,
      "duration_seconds": 2.59,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.63,
      "end_seconds": 170.46,
      "duration_seconds": 0.83,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.25,
      "end_seconds": 181.74,
      "duration_seconds": 4.49,
      "text": "Okay, here we go. Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.17,
      "end_seconds": 185.38,
      "duration_seconds": 2.21,
      "text": "High cholesterol, for two years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.75,
      "end_seconds": 187.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.17,
      "end_seconds": 207.85,
      "duration_seconds": 19.68,
      "text": "High blood pressure, for two years. It's the not knowing that gets to me. I've got diabetes. I thought it would sort itself out, but it hasn't. Hmm, I've had epilepsy for about ten years now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.64,
      "end_seconds": 216.13,
      "duration_seconds": 7.49,
      "text": "Go on. Right, so that's your known high cholesterol. We'll keep that in mind today. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.7,
      "end_seconds": 218.76,
      "duration_seconds": 2.06,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.33,
      "end_seconds": 224.84,
      "duration_seconds": 4.51,
      "text": "What medicines do you take regularly? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.41,
      "end_seconds": 229.87,
      "duration_seconds": 3.46,
      "text": "I take rosuvastatin, 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.09,
      "end_seconds": 236.61,
      "duration_seconds": 3.52,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.46,
      "end_seconds": 243.16,
      "duration_seconds": 5.7,
      "text": "No, uh, it's at home. It's, It's losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.62,
      "end_seconds": 245.9,
      "duration_seconds": 2.28,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.82,
      "end_seconds": 254.9,
      "duration_seconds": 6.08,
      "text": "About a month now. It's levetiracetam, 500 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.15,
      "end_seconds": 257.69,
      "duration_seconds": 1.54,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.49,
      "end_seconds": 261.86,
      "duration_seconds": 3.37,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.18,
      "end_seconds": 262.88,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.97,
      "end_seconds": 265.18,
      "duration_seconds": 1.21,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.41,
      "end_seconds": 270.34,
      "duration_seconds": 3.93,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.01,
      "end_seconds": 279.84,
      "duration_seconds": 8.83,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 285.62,
      "duration_seconds": 3.74,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.73,
      "end_seconds": 288.43,
      "duration_seconds": 1.7,
      "text": "Right, open wide for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.4,
      "end_seconds": 309.92,
      "duration_seconds": 2.52,
      "text": "There's mild pitting swelling at both ankles."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.8,
      "end_seconds": 311.5,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.23,
      "end_seconds": 315.22,
      "duration_seconds": 1.99,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.91,
      "end_seconds": 324.35,
      "duration_seconds": 1.44,
      "text": "Heart sounds are normal."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.48,
      "end_seconds": 353.01,
      "duration_seconds": 24.53,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. From what you've told me and what I found, this looks most like hypertension that isn't well controlled. I want to be honest that this is an impression, not a final answer. I can't rule out a side effect from the current tablet yet."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.47,
      "end_seconds": 359.26,
      "duration_seconds": 4.79,
      "text": "Right, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.79,
      "end_seconds": 377.84,
      "duration_seconds": 17.05,
      "text": "I understand the worry. At the moment I'd say it's hypertension that isn't well controlled, and we'll know more once the a urine test for protein is back. Let me just recap so I've got it right. You've had headaches in the mornings, moderate, and no chest pain or nosebleeds."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.67,
      "end_seconds": 380.28,
      "duration_seconds": 1.61,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.16,
      "end_seconds": 385.45,
      "duration_seconds": 4.29,
      "text": "I'd like to arrange a urine test for protein for hypertension."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.99,
      "end_seconds": 389.18,
      "duration_seconds": 2.19,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 389.99,
      "end_seconds": 394.75,
      "duration_seconds": 4.76,
      "text": "Doctor, I did an ECG before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.88,
      "end_seconds": 418.42,
      "duration_seconds": 22.54,
      "text": "Okay, thanks, I'll look at that. Let's get a lipid profile, for cardiovascular risk. The result will help us decide whether anything more is needed. I'm prescribing amlodipine, 5 milligrams, once a day, long term. That should help with high blood pressure. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.81,
      "end_seconds": 420.73,
      "duration_seconds": 0.92,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.55,
      "end_seconds": 433.94,
      "duration_seconds": 12.39,
      "text": "Salt is the big one, try to keep it low even though it's hard. Check the blood pressure at home, same time each morning, and write down the numbers for me."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.27,
      "end_seconds": 451.3,
      "duration_seconds": 17.03,
      "text": "Alright. Please take the tablets with food so they don't upset your stomach. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.43,
      "end_seconds": 453.63,
      "duration_seconds": 1.2,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.12,
      "end_seconds": 461.46,
      "duration_seconds": 7.34,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 463.02,
      "end_seconds": 463.72,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.85,
      "end_seconds": 471.41,
      "duration_seconds": 6.56,
      "text": "Please come and see me in a month. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 472.27,
      "end_seconds": 480.9,
      "duration_seconds": 8.63,
      "text": "So, I take the amlodipine, 5 milligrams, once a day and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 482.21,
      "end_seconds": 486.61,
      "duration_seconds": 4.4,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 491.42,
      "end_seconds": 494.12,
      "duration_seconds": 2.7,
      "text": "Yeah, I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 495.65,
      "end_seconds": 497.72,
      "duration_seconds": 2.07,
      "text": "Bye for now, look after yourself."
    }
  ]
}