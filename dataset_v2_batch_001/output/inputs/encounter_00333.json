{
  "schema_version": "1.0",
  "encounter_id": "00333",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.31,
      "end_seconds": 7.09,
      "duration_seconds": 5.78,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.65,
      "end_seconds": 11.56,
      "duration_seconds": 3.91,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.95,
      "end_seconds": 16.93,
      "duration_seconds": 3.98,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.34,
      "end_seconds": 21.11,
      "duration_seconds": 3.77,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.76,
      "end_seconds": 26.87,
      "duration_seconds": 5.11,
      "text": "It's a bad cough, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.23,
      "end_seconds": 34.83,
      "duration_seconds": 6.6,
      "text": "Is this recent, or has it been a while? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 46.84,
      "duration_seconds": 10.79,
      "text": "It's been like this since Monday. I kept putting it off, which I know isn't sensible. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.9,
      "end_seconds": 54.96,
      "duration_seconds": 7.06,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.4,
      "end_seconds": 60.98,
      "duration_seconds": 5.58,
      "text": "A seven out of ten, I suppose. Yes, cold air. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.47,
      "end_seconds": 66.21,
      "duration_seconds": 4.74,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 66.31,
      "end_seconds": 72.43,
      "duration_seconds": 6.12,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.47,
      "end_seconds": 75.54,
      "duration_seconds": 2.07,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.5,
      "end_seconds": 80.75,
      "duration_seconds": 2.25,
      "text": "Oh, and a tight chest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.16,
      "end_seconds": 85.16,
      "duration_seconds": 3.0,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.62,
      "end_seconds": 88.29,
      "duration_seconds": 2.67,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.35,
      "end_seconds": 91.55,
      "duration_seconds": 2.2,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.16,
      "end_seconds": 94.54,
      "duration_seconds": 2.38,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.31,
      "end_seconds": 111.22,
      "duration_seconds": 4.91,
      "text": "Okay, here we go. Any leg swelling, chest pain or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.0,
      "end_seconds": 123.06,
      "duration_seconds": 11.06,
      "text": "No, no leg swelling, no chest pain, no coughing up blood. I did have a sore throat at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.33,
      "end_seconds": 128.17,
      "duration_seconds": 3.84,
      "text": "Have you had any weight loss or shortness of breath?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.83,
      "end_seconds": 132.98,
      "duration_seconds": 4.15,
      "text": "No weight loss or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.42,
      "end_seconds": 136.67,
      "duration_seconds": 2.25,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.57,
      "end_seconds": 139.15,
      "duration_seconds": 1.58,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.62,
      "end_seconds": 142.89,
      "duration_seconds": 3.27,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.88,
      "end_seconds": 159.11,
      "duration_seconds": 13.23,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.45,
      "end_seconds": 164.56,
      "duration_seconds": 4.11,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.46,
      "end_seconds": 168.35,
      "duration_seconds": 2.89,
      "text": "I've got high blood pressure. Yes, asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.79,
      "end_seconds": 170.77,
      "duration_seconds": 1.98,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.13,
      "end_seconds": 173.12,
      "duration_seconds": 1.99,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.77,
      "end_seconds": 177.95,
      "duration_seconds": 4.18,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.74,
      "end_seconds": 190.43,
      "duration_seconds": 11.69,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.83,
      "end_seconds": 192.78,
      "duration_seconds": 0.95,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.58,
      "end_seconds": 197.61,
      "duration_seconds": 4.03,
      "text": "I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.65,
      "end_seconds": 204.59,
      "duration_seconds": 3.94,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.87,
      "end_seconds": 206.66,
      "duration_seconds": 0.79,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.82,
      "end_seconds": 211.54,
      "duration_seconds": 3.72,
      "text": "Alright, is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.83,
      "end_seconds": 214.96,
      "duration_seconds": 2.13,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.46,
      "end_seconds": 217.16,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.54,
      "end_seconds": 221.39,
      "duration_seconds": 2.85,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.7,
      "end_seconds": 224.31,
      "duration_seconds": 1.61,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.65,
      "end_seconds": 232.6,
      "duration_seconds": 3.95,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.75,
      "end_seconds": 237.18,
      "duration_seconds": 3.43,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.54,
      "end_seconds": 242.54,
      "duration_seconds": 4.0,
      "text": "Paracetamol. I take it 500 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 246.78,
      "duration_seconds": 3.43,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.19,
      "end_seconds": 249.05,
      "duration_seconds": 1.86,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.48,
      "end_seconds": 254.21,
      "duration_seconds": 3.73,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.61,
      "end_seconds": 255.43,
      "duration_seconds": 0.82,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.05,
      "end_seconds": 267.69,
      "duration_seconds": 1.64,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 268.55,
      "end_seconds": 275.8,
      "duration_seconds": 7.25,
      "text": "Okay, so the vitals from earlier. Blood pressure 110 over 80, respiratory rate 19. Pulse 94, oxygen saturation is 95 percent."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.75,
      "end_seconds": 280.36,
      "duration_seconds": 3.61,
      "text": "Okay, noted. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 280.67,
      "end_seconds": 292.35,
      "duration_seconds": 11.68,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.68,
      "end_seconds": 296.55,
      "duration_seconds": 1.87,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.92,
      "end_seconds": 299.61,
      "duration_seconds": 1.69,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.83,
      "end_seconds": 313.08,
      "duration_seconds": 3.25,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.07,
      "end_seconds": 316.71,
      "duration_seconds": 1.64,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.09,
      "end_seconds": 325.71,
      "duration_seconds": 1.62,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.61,
      "end_seconds": 344.65,
      "duration_seconds": 16.04,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Right, here's what I'm thinking. This looks most like acute bronchitis. An asthma flare-up is also on my list."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.24,
      "end_seconds": 347.92,
      "duration_seconds": 1.68,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.3,
      "end_seconds": 364.86,
      "duration_seconds": 15.56,
      "text": "I understand the worry. At the moment I'd say it's acute bronchitis, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've had a bad cough, since Monday, and no leg swelling or weight loss."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 366.13,
      "end_seconds": 368.46,
      "duration_seconds": 2.33,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.6,
      "end_seconds": 375.41,
      "duration_seconds": 5.81,
      "text": "Let's get blood tests, for cough. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 379.02,
      "end_seconds": 380.25,
      "duration_seconds": 1.23,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 380.99,
      "end_seconds": 384.66,
      "duration_seconds": 3.67,
      "text": "I've already done a chest X-ray, it's ready for you."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.39,
      "end_seconds": 409.78,
      "duration_seconds": 24.39,
      "text": "Perfect. I'm prescribing salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. It's for wheeze. I'll put all of this in writing so you don't have to remember it. I'll start you on azithromycin, 500 milligrams, once a day, for three days. That should help with chest infection. Steam and warm fluids can ease the cough, and try to sleep with your head propped up."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.83,
      "end_seconds": 427.34,
      "duration_seconds": 13.51,
      "text": "Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.46,
      "end_seconds": 429.82,
      "duration_seconds": 1.36,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.54,
      "end_seconds": 437.1,
      "duration_seconds": 6.56,
      "text": "I want you to come back or go to emergency straight away if you become breathless or cough up blood."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 438.14,
      "end_seconds": 439.46,
      "duration_seconds": 1.32,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.72,
      "end_seconds": 448.93,
      "duration_seconds": 8.21,
      "text": "Please come and see me in ten days. I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 452.31,
      "end_seconds": 462.61,
      "duration_seconds": 10.3,
      "text": "So, I take the salbutamol inhaler, 100 micrograms, two puffs when needed and take the azithromycin, 500 milligrams, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 463.09,
      "end_seconds": 466.96,
      "duration_seconds": 3.87,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 468.0,
      "end_seconds": 471.84,
      "duration_seconds": 3.84,
      "text": "Okay, so nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.25,
      "end_seconds": 474.58,
      "duration_seconds": 2.33,
      "text": "Bye for now, look after yourself."
    }
  ]
}