{
  "schema_version": "1.0",
  "encounter_id": "00402",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.2,
      "end_seconds": 4.75,
      "duration_seconds": 3.55,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.33,
      "end_seconds": 9.21,
      "duration_seconds": 3.88,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.99,
      "end_seconds": 19.16,
      "duration_seconds": 9.17,
      "text": "Uh, morning, doctor. I'll stay and fill in anything that's missed. Um, we came because of blood on the toilet paper."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 21.99,
      "duration_seconds": 2.53,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.95,
      "end_seconds": 41.78,
      "duration_seconds": 15.83,
      "text": "I'd give it a eight, out of ten. I've had an itchy bottom too, for about a month. Oh, uh, and a small lump near the back passage. With small lump near the back passage, I'd say mild."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 44.64,
      "duration_seconds": 2.05,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.58,
      "end_seconds": 48.41,
      "duration_seconds": 2.83,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 49.9,
      "end_seconds": 54.08,
      "duration_seconds": 4.18,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.15,
      "end_seconds": 62.4,
      "duration_seconds": 6.25,
      "text": "So, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.29,
      "end_seconds": 73.92,
      "duration_seconds": 10.63,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any change in bowel habit, abdominal pain or family history of bowel cancer?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.3,
      "end_seconds": 78.18,
      "duration_seconds": 2.88,
      "text": "Oh, uh, nothing like that, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.55,
      "end_seconds": 81.28,
      "duration_seconds": 2.73,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.94,
      "end_seconds": 84.75,
      "duration_seconds": 2.81,
      "text": "I mean, no, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.07,
      "end_seconds": 87.43,
      "duration_seconds": 2.36,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.6,
      "end_seconds": 92.84,
      "duration_seconds": 2.24,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 93.57,
      "end_seconds": 100.98,
      "duration_seconds": 7.41,
      "text": "Doctor, I've got the readings for you. Temperature is 36.7 degrees, BP is 110 over 79, saturation 99 percent, pulse 77."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 106.59,
      "duration_seconds": 4.14,
      "text": "Okay, noted. Right, do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.04,
      "end_seconds": 109.99,
      "duration_seconds": 1.95,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.34,
      "end_seconds": 111.51,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 111.96,
      "end_seconds": 113.18,
      "duration_seconds": 1.22,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.44,
      "end_seconds": 118.45,
      "duration_seconds": 2.01,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 128.36,
      "duration_seconds": 8.37,
      "text": "I take iron tablets, once a day. I take apixaban, 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 129.47,
      "end_seconds": 133.48,
      "duration_seconds": 4.01,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 136.64,
      "duration_seconds": 2.43,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.63,
      "end_seconds": 144.61,
      "duration_seconds": 6.98,
      "text": "No, um, I left it at home. Anovate cream. I take it twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.71,
      "end_seconds": 149.23,
      "duration_seconds": 3.52,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.18,
      "end_seconds": 158.24,
      "duration_seconds": 6.06,
      "text": "Hmm, uh, my grandmother had breast cancer. Uh, my father had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.22,
      "end_seconds": 163.12,
      "duration_seconds": 3.9,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.49,
      "end_seconds": 172.06,
      "duration_seconds": 8.57,
      "text": "I, I have low haemoglobin, for nearly five years. Hmm, I've had an irregular heartbeat for five years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.33,
      "end_seconds": 179.74,
      "duration_seconds": 6.41,
      "text": "Mm. Yes, I can see the an irregular heartbeat in your file as well. What about alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.08,
      "end_seconds": 184.26,
      "duration_seconds": 4.18,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.36,
      "end_seconds": 188.9,
      "duration_seconds": 2.54,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.57,
      "end_seconds": 190.27,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.5,
      "end_seconds": 193.74,
      "duration_seconds": 2.24,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.15,
      "end_seconds": 213.68,
      "duration_seconds": 4.53,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 217.08,
      "duration_seconds": 1.79,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.64,
      "end_seconds": 229.42,
      "duration_seconds": 1.78,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.67,
      "end_seconds": 255.59,
      "duration_seconds": 23.92,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Putting it all together, my working impression is haemorrhoids. I want to be honest that this is an impression, not a final answer. I can't rule out something higher up in the bowel that we shouldn't miss yet. Let's get blood tests, for rectal bleeding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.51,
      "end_seconds": 263.93,
      "duration_seconds": 7.42,
      "text": "Let's get a colonoscopy, for rectal bleeding. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 264.68,
      "end_seconds": 266.14,
      "duration_seconds": 1.46,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.13,
      "end_seconds": 289.67,
      "duration_seconds": 22.54,
      "text": "I'd like you to take a soothing cream, twice a day, for one week. That's for haemorrhoids. It's a commonly used medicine and most people tolerate it well. Soak in a warm bath for ten minutes after you pass stool, and don't strain. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.56,
      "end_seconds": 297.73,
      "duration_seconds": 7.17,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.45,
      "end_seconds": 299.82,
      "duration_seconds": 1.37,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.66,
      "end_seconds": 307.59,
      "duration_seconds": 6.93,
      "text": "I want you to come back or go to emergency straight away if you pass a lot of blood or feel faint."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 308.91,
      "end_seconds": 309.61,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.01,
      "end_seconds": 312.74,
      "duration_seconds": 2.73,
      "text": "Please come and see me in three weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.96,
      "end_seconds": 317.73,
      "duration_seconds": 3.77,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.2,
      "end_seconds": 322.86,
      "duration_seconds": 4.66,
      "text": "Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.19,
      "end_seconds": 326.68,
      "duration_seconds": 3.49,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.8,
      "end_seconds": 331.25,
      "duration_seconds": 1.45,
      "text": "Okay, see you then."
    }
  ]
}