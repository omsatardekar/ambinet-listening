{
  "schema_version": "1.0",
  "encounter_id": "00112",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 4.0,
      "duration_seconds": 2.85,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.43,
      "end_seconds": 9.82,
      "duration_seconds": 4.39,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.74,
      "end_seconds": 15.89,
      "duration_seconds": 5.15,
      "text": "That's fine, sit down. We'll go through it together. Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.89,
      "end_seconds": 21.47,
      "duration_seconds": 4.58,
      "text": "I mean, a couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.41,
      "end_seconds": 24.72,
      "duration_seconds": 2.31,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 29.0,
      "end_seconds": 32.86,
      "duration_seconds": 3.86,
      "text": "Doctor, it's very heavy periods. That's what we're worried about."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.18,
      "end_seconds": 40.39,
      "duration_seconds": 6.21,
      "text": "Is this recent, or has it been a while? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.14,
      "end_seconds": 42.52,
      "duration_seconds": 1.38,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.9,
      "end_seconds": 47.01,
      "duration_seconds": 3.11,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.49,
      "end_seconds": 50.23,
      "duration_seconds": 2.74,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.86,
      "end_seconds": 54.95,
      "duration_seconds": 4.09,
      "text": "Okay, what about periods lasting longer, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.47,
      "end_seconds": 66.78,
      "duration_seconds": 11.31,
      "text": "Yes, you know, since this morning. About periods lasting longer, severe, I'd say. Oh, I've been passing clots too, for four weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 71.37,
      "duration_seconds": 3.45,
      "text": "Have you had cramping pain in the lower tummy?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.35,
      "end_seconds": 74.91,
      "duration_seconds": 2.56,
      "text": "Um, yes, for three days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 79.21,
      "duration_seconds": 3.08,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 80.32,
      "end_seconds": 84.35,
      "duration_seconds": 4.03,
      "text": "Um, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.73,
      "end_seconds": 90.83,
      "duration_seconds": 5.1,
      "text": "Have you had very heavy periods before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.2,
      "end_seconds": 99.94,
      "duration_seconds": 8.74,
      "text": "Yes, you know, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.95,
      "end_seconds": 103.56,
      "duration_seconds": 2.61,
      "text": "Alright, and vaginal discharge, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.49,
      "end_seconds": 107.06,
      "duration_seconds": 2.57,
      "text": "Not at all, no vaginal discharge."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 110.79,
      "duration_seconds": 2.66,
      "text": "Any weight loss or pain during sex?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.91,
      "end_seconds": 116.75,
      "duration_seconds": 4.84,
      "text": "No weight loss or pain during sex, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.71,
      "end_seconds": 120.41,
      "duration_seconds": 0.7,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.31,
      "end_seconds": 124.45,
      "duration_seconds": 3.14,
      "text": "Hmm, not at all, no fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 125.83,
      "end_seconds": 131.04,
      "duration_seconds": 5.21,
      "text": "Actually, um, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.56,
      "end_seconds": 139.8,
      "duration_seconds": 7.24,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 147.95,
      "duration_seconds": 6.72,
      "text": "Alright, I'll note both what you've said and what you've noticed. Right, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.28,
      "end_seconds": 151.35,
      "duration_seconds": 2.07,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.54,
      "end_seconds": 156.64,
      "duration_seconds": 1.1,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.41,
      "end_seconds": 160.51,
      "duration_seconds": 3.1,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.55,
      "end_seconds": 171.21,
      "duration_seconds": 6.66,
      "text": "Do you have any medical conditions, anything you've been treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.57,
      "end_seconds": 186.53,
      "duration_seconds": 14.96,
      "text": "An underactive thyroid, for about ten years. I've had gout for about ten years now. I'm hoping you can tell me something definite. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.1,
      "end_seconds": 196.33,
      "duration_seconds": 8.23,
      "text": "Okay, I'm following. Right, so that's your known gout. We'll keep that in mind today. So, have you had any surgery before?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.86,
      "end_seconds": 202.27,
      "duration_seconds": 4.41,
      "text": "Yes, I had a C-section, about ten years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.23,
      "end_seconds": 206.13,
      "duration_seconds": 2.9,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.79,
      "end_seconds": 209.93,
      "duration_seconds": 3.14,
      "text": "No, um, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.29,
      "end_seconds": 213.53,
      "duration_seconds": 2.24,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.61,
      "end_seconds": 220.56,
      "duration_seconds": 5.95,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.64,
      "end_seconds": 223.72,
      "duration_seconds": 2.08,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.9,
      "end_seconds": 231.59,
      "duration_seconds": 6.69,
      "text": "Thyroxine, 75 micrograms, every morning. Hmm, I'm on allopurinol, once a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.08,
      "end_seconds": 234.83,
      "duration_seconds": 1.75,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.67,
      "end_seconds": 239.48,
      "duration_seconds": 0.81,
      "text": "100 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 244.17,
      "duration_seconds": 3.49,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.36,
      "end_seconds": 258.64,
      "duration_seconds": 1.28,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.49,
      "end_seconds": 288.32,
      "duration_seconds": 7.83,
      "text": "Okay: oxygen saturation is 98 percent, BP is 123 over 76, temp 37.0 degrees, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.8,
      "end_seconds": 290.98,
      "duration_seconds": 1.18,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.69,
      "end_seconds": 294.64,
      "duration_seconds": 2.95,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.64,
      "end_seconds": 301.12,
      "duration_seconds": 3.48,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.45,
      "end_seconds": 303.15,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.93,
      "end_seconds": 307.56,
      "duration_seconds": 2.63,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.8,
      "end_seconds": 326.45,
      "duration_seconds": 1.65,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.51,
      "end_seconds": 331.6,
      "duration_seconds": 4.09,
      "text": "Okay, a little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.9,
      "end_seconds": 353.68,
      "duration_seconds": 5.78,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.64,
      "end_seconds": 381.52,
      "duration_seconds": 22.88,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. From what you've told me and what I found, it fits best with heavy periods with a cause still to find. That's my thinking for now, and it may change as we learn more. Fibroids is also on my list."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.83,
      "end_seconds": 385.61,
      "duration_seconds": 2.78,
      "text": "Doctor, uh, is this dangerous?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.08,
      "end_seconds": 401.09,
      "duration_seconds": 15.01,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with a cause still to find, and we'll know more once the a pregnancy test is back. I'm going to order a pregnancy test, for abnormal bleeding."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 401.79,
      "end_seconds": 404.42,
      "duration_seconds": 2.63,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.67,
      "end_seconds": 417.11,
      "duration_seconds": 11.44,
      "text": "I'd like to arrange blood tests for heavy periods. I'm prescribing tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. You take it by mouth. It's for heavy bleeding."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 417.79,
      "end_seconds": 422.93,
      "duration_seconds": 5.14,
      "text": "Oh, you know, okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.38,
      "end_seconds": 446.53,
      "duration_seconds": 22.15,
      "text": "Keep a note of how many pads you use each day and the dates, it helps us a lot. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 447.19,
      "end_seconds": 456.08,
      "duration_seconds": 8.89,
      "text": "If you soak through a pad every hour or feel faint, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 456.55,
      "end_seconds": 457.25,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.87,
      "end_seconds": 461.71,
      "duration_seconds": 3.84,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 462.4,
      "end_seconds": 465.55,
      "duration_seconds": 3.15,
      "text": "I mean, okay, I'll book that."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 467.05,
      "end_seconds": 470.98,
      "duration_seconds": 3.93,
      "text": "Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 472.11,
      "end_seconds": 476.87,
      "duration_seconds": 4.76,
      "text": "Okay, thank you. I'll get started on all of that."
    }
  ]
}