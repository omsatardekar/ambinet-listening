{
  "schema_version": "1.0",
  "encounter_id": "00020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 4.19,
      "duration_seconds": 3.48,
      "text": "Hello doctor, um, sorry, am I early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.41,
      "end_seconds": 11.7,
      "duration_seconds": 3.29,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.22,
      "end_seconds": 17.91,
      "duration_seconds": 4.69,
      "text": "I wanted to get pain in the lower right tummy looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 21.15,
      "duration_seconds": 2.26,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.54,
      "end_seconds": 30.1,
      "duration_seconds": 8.56,
      "text": "Uh, um, ever since... since last weekend, really. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.5,
      "end_seconds": 33.83,
      "duration_seconds": 3.33,
      "text": "Right. Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.91,
      "end_seconds": 41.48,
      "duration_seconds": 6.57,
      "text": "Honestly, once or twice a day. I've had nausea too, for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.28,
      "end_seconds": 46.34,
      "duration_seconds": 4.06,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.36,
      "end_seconds": 49.42,
      "duration_seconds": 2.06,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.16,
      "end_seconds": 53.68,
      "duration_seconds": 3.52,
      "text": "Any hernia bulge, jaundice or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.06,
      "end_seconds": 57.36,
      "duration_seconds": 2.3,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.75,
      "end_seconds": 59.54,
      "duration_seconds": 1.79,
      "text": "Has there been any diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.75,
      "end_seconds": 62.18,
      "duration_seconds": 1.43,
      "text": "No, no diarrhoea."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.53,
      "end_seconds": 69.1,
      "duration_seconds": 5.57,
      "text": "Do you have any medical conditions, anything you've been treated for? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.8,
      "end_seconds": 78.61,
      "duration_seconds": 5.81,
      "text": "I have eczema, for about a year. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.19,
      "end_seconds": 81.91,
      "duration_seconds": 2.72,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.68,
      "end_seconds": 83.44,
      "duration_seconds": 0.76,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.78,
      "end_seconds": 97.95,
      "duration_seconds": 6.17,
      "text": "Right, thanks for waiting. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.36,
      "end_seconds": 102.04,
      "duration_seconds": 2.68,
      "text": "Yes, dust, it gives me sneezing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.49,
      "end_seconds": 115.97,
      "duration_seconds": 13.48,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.69,
      "end_seconds": 119.24,
      "duration_seconds": 2.55,
      "text": "Right, you know, I understand now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.61,
      "end_seconds": 126.18,
      "duration_seconds": 6.57,
      "text": "Any medication at the moment, including things from the pharmacy? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.55,
      "end_seconds": 133.81,
      "duration_seconds": 6.26,
      "text": "It's hydrocortisone cream, when needed. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.09,
      "end_seconds": 138.82,
      "duration_seconds": 3.73,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.57,
      "end_seconds": 140.27,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.73,
      "end_seconds": 160.75,
      "duration_seconds": 5.02,
      "text": "Alright, I've got it. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.16,
      "end_seconds": 165.76,
      "duration_seconds": 1.6,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.35,
      "end_seconds": 168.05,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.07,
      "end_seconds": 172.05,
      "duration_seconds": 2.98,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.97,
      "end_seconds": 175.14,
      "duration_seconds": 2.17,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.81,
      "end_seconds": 179.02,
      "duration_seconds": 3.21,
      "text": "Of course, uh, take your time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.32,
      "end_seconds": 194.84,
      "duration_seconds": 2.52,
      "text": "Alright, I've got it. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.71,
      "end_seconds": 197.01,
      "duration_seconds": 1.3,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.36,
      "end_seconds": 200.1,
      "duration_seconds": 2.74,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.7,
      "end_seconds": 214.9,
      "duration_seconds": 14.2,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.71,
      "end_seconds": 218.64,
      "duration_seconds": 1.93,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.1,
      "end_seconds": 221.9,
      "duration_seconds": 1.8,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.82,
      "end_seconds": 236.44,
      "duration_seconds": 5.62,
      "text": "There's tenderness in the right lower part and it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.21,
      "end_seconds": 237.91,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 242.71,
      "duration_seconds": 3.04,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.23,
      "end_seconds": 260.68,
      "duration_seconds": 1.45,
      "text": "Bowel sounds are present."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.77,
      "end_seconds": 267.11,
      "duration_seconds": 2.34,
      "text": "That's fine, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.91,
      "end_seconds": 271.16,
      "duration_seconds": 3.25,
      "text": "Hold on, the screen's frozen for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.48,
      "end_seconds": 307.71,
      "duration_seconds": 19.23,
      "text": "That's saved, thanks for waiting. Putting it all together, this looks most like possible appendicitis. I'd also keep a gastroenteritis in mind. Let me just recap so I've got it right. You've had pain in the lower right tummy, since last weekend, and no hernia bulge or diarrhoea."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.6,
      "end_seconds": 310.49,
      "duration_seconds": 1.89,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.85,
      "end_seconds": 331.37,
      "duration_seconds": 20.52,
      "text": "I'd like to arrange a urine test for abdominal pain. Please don't eat or drink anything until the surgeons have seen you. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'd like you to see the surgical team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.7,
      "end_seconds": 333.1,
      "duration_seconds": 1.4,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.41,
      "end_seconds": 341.91,
      "duration_seconds": 8.5,
      "text": "Keep an eye out, and if the pain gets sharper or spreads across the tummy, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.86,
      "end_seconds": 343.56,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.08,
      "end_seconds": 348.58,
      "duration_seconds": 3.5,
      "text": "I'd like to see you again after the scan."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.32,
      "end_seconds": 350.02,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.63,
      "end_seconds": 356.83,
      "duration_seconds": 6.2,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.16,
      "end_seconds": 362.33,
      "duration_seconds": 4.17,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.82,
      "end_seconds": 367.58,
      "duration_seconds": 4.76,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.64,
      "end_seconds": 370.44,
      "duration_seconds": 1.8,
      "text": "No questions. Thank you."
    }
  ]
}