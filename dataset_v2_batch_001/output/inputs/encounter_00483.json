{
  "schema_version": "1.0",
  "encounter_id": "00483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.6,
      "duration_seconds": 4.02,
      "text": "Hello? Doctor? They told me to come straight in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.11,
      "end_seconds": 9.6,
      "duration_seconds": 4.49,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.59,
      "end_seconds": 14.13,
      "duration_seconds": 3.54,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.55,
      "end_seconds": 18.23,
      "duration_seconds": 2.68,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.88,
      "end_seconds": 21.82,
      "duration_seconds": 2.94,
      "text": "She's been having more breathlessness than usual, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.59,
      "end_seconds": 26.04,
      "duration_seconds": 3.45,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.18,
      "end_seconds": 38.95,
      "duration_seconds": 11.77,
      "text": "It's, It's been three days, I'm fairly sure. I wasn't sure whether to come in at all, to be honest. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.47,
      "end_seconds": 43.88,
      "duration_seconds": 4.41,
      "text": "Right. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.43,
      "end_seconds": 58.43,
      "duration_seconds": 11.0,
      "text": "It's mild, honestly. It's on and off. I thought it would sort itself out, but it hasn't. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.73,
      "end_seconds": 62.34,
      "duration_seconds": 2.61,
      "text": "Have you been coughing up green phlegm?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.48,
      "end_seconds": 85.02,
      "duration_seconds": 21.54,
      "text": "Uh, yes, for about two weeks. Yeah, about coughing up green phlegm, pretty severe, if I'm being honest. I'd say once or twice a day. As for poor sleep because of the cough, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.35,
      "end_seconds": 88.71,
      "duration_seconds": 3.36,
      "text": "I see. Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.23,
      "end_seconds": 93.49,
      "duration_seconds": 1.26,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.87,
      "end_seconds": 98.74,
      "duration_seconds": 3.87,
      "text": "Have you had any chest pain or coughing up blood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.44,
      "end_seconds": 103.18,
      "duration_seconds": 3.74,
      "text": "I haven't had chest pain or coughing up blood, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.69,
      "end_seconds": 108.6,
      "duration_seconds": 4.91,
      "text": "Let me check a few things. Any fever, swollen ankles or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.11,
      "end_seconds": 112.93,
      "duration_seconds": 3.82,
      "text": "No fever, swollen ankles or weight loss, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.52,
      "end_seconds": 117.37,
      "duration_seconds": 2.85,
      "text": "Alright, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.21,
      "end_seconds": 119.77,
      "duration_seconds": 1.56,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.62,
      "end_seconds": 124.82,
      "duration_seconds": 4.2,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.17,
      "end_seconds": 125.93,
      "duration_seconds": 0.76,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 145.58,
      "duration_seconds": 6.12,
      "text": "Okay, here we go. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.58,
      "end_seconds": 149.3,
      "duration_seconds": 2.72,
      "text": "Yes, dust, it gives me sneezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.17,
      "end_seconds": 153.32,
      "duration_seconds": 3.15,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.64,
      "end_seconds": 154.34,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.59,
      "end_seconds": 172.75,
      "duration_seconds": 4.16,
      "text": "Right, thanks for waiting. Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 174.04,
      "end_seconds": 181.12,
      "duration_seconds": 7.08,
      "text": "She takes Tiotropium inhaler, once a day. She takes losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.23,
      "end_seconds": 185.78,
      "duration_seconds": 3.55,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.25,
      "end_seconds": 189.19,
      "duration_seconds": 2.94,
      "text": "Thank you, you know, I appreciate it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.5,
      "end_seconds": 196.36,
      "duration_seconds": 6.86,
      "text": "What about your general health, any conditions you're being treated for? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.69,
      "end_seconds": 209.41,
      "duration_seconds": 11.72,
      "text": "I mean, yes, COPD. I looked a few things up online, and that probably didn't help. Yes, high blood pressure. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.72,
      "end_seconds": 214.52,
      "duration_seconds": 4.8,
      "text": "Go on. Alright, have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.64,
      "end_seconds": 230.01,
      "duration_seconds": 14.37,
      "text": "Oh, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.1,
      "end_seconds": 234.6,
      "duration_seconds": 3.5,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.09,
      "end_seconds": 235.79,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.22,
      "end_seconds": 248.72,
      "duration_seconds": 1.5,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.13,
      "end_seconds": 252.69,
      "duration_seconds": 2.56,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.09,
      "end_seconds": 253.82,
      "duration_seconds": 0.73,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.53,
      "end_seconds": 289.73,
      "duration_seconds": 25.2,
      "text": "Alright, I've got it. Putting together what you've described, it fits best with a flare-up of COPD. That's my thinking for now, and it may change as we learn more. It could also be heart failure, so we'll keep that open. Let me just recap so I've got it right. You've had more breathlessness than usual for three days, mild, and no weight loss or chest pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.31,
      "end_seconds": 292.64,
      "duration_seconds": 1.33,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.7,
      "end_seconds": 307.77,
      "duration_seconds": 14.07,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.83,
      "end_seconds": 312.33,
      "duration_seconds": 3.5,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.18,
      "end_seconds": 337.21,
      "duration_seconds": 24.03,
      "text": "I'm going to order blood tests, for infective exacerbation. I'd rather check than guess, and this is the quickest way to know more. I'd like you to take doxycycline, 100 milligrams, twice a day, for five days. You take it by mouth. That should help with chest infection. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.06,
      "end_seconds": 339.75,
      "duration_seconds": 1.69,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.69,
      "end_seconds": 352.78,
      "duration_seconds": 12.09,
      "text": "I'll start you on prednisolone, 30 milligrams, once a day, for five days. It's for COPD flare-up. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.17,
      "end_seconds": 357.84,
      "duration_seconds": 4.67,
      "text": "I mean, you know, okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.7,
      "end_seconds": 372.44,
      "duration_seconds": 13.74,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't sit on it if you become more breathless or your lips turn blue. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.3,
      "end_seconds": 375.8,
      "duration_seconds": 2.5,
      "text": "Got it, uh, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.61,
      "end_seconds": 378.38,
      "duration_seconds": 1.77,
      "text": "Come back in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.69,
      "end_seconds": 383.09,
      "duration_seconds": 3.4,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.85,
      "end_seconds": 387.9,
      "duration_seconds": 4.05,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.45,
      "end_seconds": 398.0,
      "duration_seconds": 9.55,
      "text": "So, I take the doxycycline, 100 milligrams, twice a day and take the prednisolone, 30 milligrams, once a day. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.6,
      "end_seconds": 403.24,
      "duration_seconds": 4.64,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.16,
      "end_seconds": 407.12,
      "duration_seconds": 2.96,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}