{
  "schema_version": "1.0",
  "encounter_id": "00376",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 5.15,
      "duration_seconds": 4.34,
      "text": "Come in, come in. Pull the door closed behind you, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.25,
      "end_seconds": 6.95,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.59,
      "end_seconds": 9.3,
      "duration_seconds": 1.71,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.75,
      "end_seconds": 12.13,
      "duration_seconds": 2.38,
      "text": "Only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.86,
      "end_seconds": 15.06,
      "duration_seconds": 2.2,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.46,
      "end_seconds": 20.91,
      "duration_seconds": 4.45,
      "text": "Yeah, it's a high fever. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.71,
      "end_seconds": 25.04,
      "duration_seconds": 3.33,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.46,
      "end_seconds": 28.6,
      "duration_seconds": 3.14,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.91,
      "end_seconds": 32.37,
      "duration_seconds": 3.46,
      "text": "Mm-hm. Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.26,
      "end_seconds": 35.24,
      "duration_seconds": 1.98,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.09,
      "end_seconds": 39.11,
      "duration_seconds": 3.02,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.13,
      "end_seconds": 46.38,
      "duration_seconds": 3.25,
      "text": "It usually comes with pain behind my eyes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.36,
      "end_seconds": 50.03,
      "duration_seconds": 2.67,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.53,
      "end_seconds": 51.37,
      "duration_seconds": 0.84,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.25,
      "end_seconds": 67.01,
      "duration_seconds": 4.76,
      "text": "Right, thanks for waiting. Let me check a few things. Any cough or breathlessness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.61,
      "end_seconds": 71.33,
      "duration_seconds": 2.72,
      "text": "I haven't had cough or breathlessness, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 75.84,
      "duration_seconds": 3.32,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.48,
      "end_seconds": 77.18,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.63,
      "end_seconds": 94.47,
      "duration_seconds": 4.84,
      "text": "Okay, here we go. Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 99.88,
      "duration_seconds": 4.69,
      "text": "I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.2,
      "end_seconds": 106.34,
      "duration_seconds": 6.14,
      "text": "I see. Okay, any medical conditions, anything you've been treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.18,
      "end_seconds": 110.01,
      "duration_seconds": 2.83,
      "text": "Oh, no, I've never had anything serious."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 115.01,
      "duration_seconds": 3.8,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.31,
      "end_seconds": 116.01,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.29,
      "end_seconds": 136.46,
      "duration_seconds": 8.17,
      "text": "Okay, here we go. Do you have any allergies to medicines, food, anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.92,
      "end_seconds": 140.33,
      "duration_seconds": 2.41,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.63,
      "end_seconds": 143.86,
      "duration_seconds": 2.23,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.96,
      "end_seconds": 148.14,
      "duration_seconds": 3.18,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.69,
      "end_seconds": 150.72,
      "duration_seconds": 2.03,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.83,
      "end_seconds": 155.19,
      "duration_seconds": 1.36,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.98,
      "end_seconds": 171.12,
      "duration_seconds": 15.14,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.0,
      "end_seconds": 176.45,
      "duration_seconds": 4.45,
      "text": "Uh, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.48,
      "end_seconds": 181.3,
      "duration_seconds": 3.82,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.05,
      "end_seconds": 185.3,
      "duration_seconds": 3.25,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.47,
      "end_seconds": 189.26,
      "duration_seconds": 1.79,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.59,
      "end_seconds": 193.29,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.12,
      "end_seconds": 196.5,
      "duration_seconds": 1.38,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.55,
      "end_seconds": 208.81,
      "duration_seconds": 4.26,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.72,
      "end_seconds": 218.68,
      "duration_seconds": 5.96,
      "text": "Right, all done, thank you, please sit down. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.01,
      "end_seconds": 230.57,
      "duration_seconds": 11.56,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.1,
      "end_seconds": 241.79,
      "duration_seconds": 9.69,
      "text": "Okay, so my impression is this: My working impression is a viral fever, possibly dengue. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.36,
      "end_seconds": 246.55,
      "duration_seconds": 4.19,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.08,
      "end_seconds": 264.03,
      "duration_seconds": 15.95,
      "text": "It's reasonable to be concerned, but right now a viral fever, possibly dengue is my leading thought, not anything worse. Let me just recap so I've got it right. You've had a high fever, since last weekend, and no breathlessness or cough."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.58,
      "end_seconds": 266.84,
      "duration_seconds": 1.26,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.49,
      "end_seconds": 271.19,
      "duration_seconds": 3.7,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.02,
      "end_seconds": 274.73,
      "duration_seconds": 2.71,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.33,
      "end_seconds": 283.74,
      "duration_seconds": 7.41,
      "text": "Let's get a full blood count, for platelet count. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.74,
      "end_seconds": 286.92,
      "duration_seconds": 2.18,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.08,
      "end_seconds": 307.96,
      "duration_seconds": 19.88,
      "text": "Drink a lot, coconut water, ORS, whatever you can manage. Please avoid ibuprofen or any anti-inflammatory painkillers for now, stick with paracetamol only. A short walk every day, even twenty minutes, will help more than you'd think. If you notice any bleeding or you can't keep fluids down, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.85,
      "end_seconds": 309.55,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.44,
      "end_seconds": 312.86,
      "duration_seconds": 2.42,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.72,
      "end_seconds": 314.42,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.77,
      "end_seconds": 319.85,
      "duration_seconds": 5.08,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.21,
      "end_seconds": 324.63,
      "duration_seconds": 4.42,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.35,
      "end_seconds": 330.15,
      "duration_seconds": 4.8,
      "text": "Yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.75,
      "end_seconds": 333.87,
      "duration_seconds": 2.12,
      "text": "Right, no questions. Thank you."
    }
  ]
}