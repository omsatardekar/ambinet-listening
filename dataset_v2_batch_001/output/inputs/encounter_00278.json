{
  "schema_version": "1.0",
  "encounter_id": "00278",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.05,
      "end_seconds": 3.12,
      "duration_seconds": 2.07,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.24,
      "end_seconds": 4.94,
      "duration_seconds": 0.7,
      "text": "Hi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.88,
      "end_seconds": 9.95,
      "duration_seconds": 2.07,
      "text": "Okay, have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.22,
      "end_seconds": 14.37,
      "duration_seconds": 3.15,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.42,
      "end_seconds": 17.66,
      "duration_seconds": 2.24,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.53,
      "end_seconds": 25.05,
      "duration_seconds": 6.52,
      "text": "Mainly blood in my urine. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.59,
      "end_seconds": 28.75,
      "duration_seconds": 2.16,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.82,
      "end_seconds": 43.68,
      "duration_seconds": 13.86,
      "text": "It's been going on for three weeks. I've also had a mild ache in the back. With mild ache in the back, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.03,
      "end_seconds": 46.89,
      "duration_seconds": 2.86,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.03,
      "end_seconds": 58.78,
      "duration_seconds": 10.75,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.36,
      "end_seconds": 62.26,
      "duration_seconds": 2.9,
      "text": "Any pain on passing urine, fever or flank pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.64,
      "end_seconds": 68.01,
      "duration_seconds": 5.37,
      "text": "No pain on passing urine, fever or flank pain, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.76,
      "end_seconds": 71.19,
      "duration_seconds": 2.43,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.05,
      "end_seconds": 74.08,
      "duration_seconds": 2.03,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.07,
      "end_seconds": 87.53,
      "duration_seconds": 2.46,
      "text": "Right, thanks for waiting. Any regular medication?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.48,
      "end_seconds": 89.34,
      "duration_seconds": 0.86,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.25,
      "end_seconds": 91.86,
      "duration_seconds": 1.61,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.01,
      "end_seconds": 94.36,
      "duration_seconds": 1.35,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.85,
      "end_seconds": 99.83,
      "duration_seconds": 3.98,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.14,
      "end_seconds": 103.98,
      "duration_seconds": 3.84,
      "text": "No, you know, I've never had anything serious."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 120.96,
      "duration_seconds": 16.3,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.5,
      "end_seconds": 123.3,
      "duration_seconds": 1.8,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 127.25,
      "duration_seconds": 2.57,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.87,
      "end_seconds": 128.62,
      "duration_seconds": 0.75,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.08,
      "end_seconds": 131.28,
      "duration_seconds": 2.2,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.96,
      "end_seconds": 144.22,
      "duration_seconds": 1.26,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.64,
      "end_seconds": 170.75,
      "duration_seconds": 7.11,
      "text": "Okay: blood pressure 116 over 81, temp 36.9 degrees, pulse is 81 beats a minute, saturation 99 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.12,
      "end_seconds": 172.24,
      "duration_seconds": 1.12,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.63,
      "end_seconds": 175.48,
      "duration_seconds": 2.85,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.5,
      "end_seconds": 179.0,
      "duration_seconds": 2.5,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.59,
      "end_seconds": 181.48,
      "duration_seconds": 0.89,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.46,
      "end_seconds": 186.33,
      "duration_seconds": 2.87,
      "text": "Okay, stay still while I have a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.07,
      "end_seconds": 208.1,
      "duration_seconds": 4.03,
      "text": "Abdomen is soft, no masses, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.41,
      "end_seconds": 209.26,
      "duration_seconds": 0.85,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.29,
      "end_seconds": 237.2,
      "duration_seconds": 22.91,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. So, based on the history and the examination, I think we're dealing with blood in the urine that needs full investigation at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.64,
      "end_seconds": 239.26,
      "duration_seconds": 1.62,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 256.88,
      "duration_seconds": 17.23,
      "text": "I understand the worry. At the moment I'd say it's blood in the urine that needs full investigation, and we'll know more once the a urine culture is back. Let me just recap so I've got it right. You've had blood in your urine for three weeks, and no fever or flank pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.82,
      "end_seconds": 259.8,
      "duration_seconds": 1.98,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 263.74,
      "duration_seconds": 3.63,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.85,
      "end_seconds": 278.34,
      "duration_seconds": 13.49,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.82,
      "end_seconds": 287.14,
      "duration_seconds": 7.32,
      "text": "Let's get a urine culture, for haematuria. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.32,
      "end_seconds": 290.52,
      "duration_seconds": 2.2,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.86,
      "end_seconds": 304.47,
      "duration_seconds": 13.61,
      "text": "Keep drinking plenty of water, and let us know quickly if you pass clots or can't pass urine. Please take the tablets with food so they don't upset your stomach. I'll also refer you to the urology clinic."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.88,
      "end_seconds": 306.58,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.9,
      "end_seconds": 316.76,
      "duration_seconds": 8.86,
      "text": "If you can't pass urine or pass large clots, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.78,
      "end_seconds": 319.0,
      "duration_seconds": 1.22,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.37,
      "end_seconds": 323.24,
      "duration_seconds": 3.87,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.88,
      "end_seconds": 327.96,
      "duration_seconds": 4.08,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.49,
      "end_seconds": 336.15,
      "duration_seconds": 6.66,
      "text": "Alright, I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.9,
      "end_seconds": 345.26,
      "duration_seconds": 5.36,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.05,
      "end_seconds": 350.85,
      "duration_seconds": 4.8,
      "text": "Alright, yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.44,
      "end_seconds": 354.45,
      "duration_seconds": 3.01,
      "text": "Right, nothing more from me, doctor, thanks."
    }
  ]
}