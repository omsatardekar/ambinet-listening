{
  "schema_version": "1.0",
  "encounter_id": "00310",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 6.28,
      "duration_seconds": 5.71,
      "text": "Uh, doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.39,
      "end_seconds": 10.53,
      "duration_seconds": 3.14,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.16,
      "end_seconds": 14.98,
      "duration_seconds": 3.82,
      "text": "So, I've been feeling anxious most of the day, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.44,
      "end_seconds": 18.54,
      "duration_seconds": 3.1,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.33,
      "end_seconds": 25.36,
      "duration_seconds": 6.03,
      "text": "About... well, two months. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.17,
      "end_seconds": 28.23,
      "duration_seconds": 2.06,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.98,
      "end_seconds": 31.43,
      "duration_seconds": 2.45,
      "text": "I notice it more with work."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.02,
      "end_seconds": 35.55,
      "duration_seconds": 3.53,
      "text": "Right, have you had a tight feeling in the chest?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.65,
      "end_seconds": 38.99,
      "duration_seconds": 2.34,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.29,
      "end_seconds": 43.67,
      "duration_seconds": 3.38,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.84,
      "end_seconds": 55.91,
      "duration_seconds": 11.07,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.06,
      "end_seconds": 59.03,
      "duration_seconds": 1.97,
      "text": "Any low mood or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.5,
      "end_seconds": 63.38,
      "duration_seconds": 3.88,
      "text": "Right, no low mood or weight loss, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.57,
      "end_seconds": 66.9,
      "duration_seconds": 2.33,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.39,
      "end_seconds": 68.94,
      "duration_seconds": 1.55,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.8,
      "end_seconds": 71.71,
      "duration_seconds": 1.91,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.16,
      "end_seconds": 79.61,
      "duration_seconds": 7.45,
      "text": "Escitalopram, 10 milligrams, once a day. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.19,
      "end_seconds": 84.24,
      "duration_seconds": 3.05,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.26,
      "end_seconds": 87.71,
      "duration_seconds": 2.45,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.32,
      "end_seconds": 90.88,
      "duration_seconds": 2.56,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.22,
      "end_seconds": 94.0,
      "duration_seconds": 2.78,
      "text": "I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.46,
      "end_seconds": 102.6,
      "duration_seconds": 8.14,
      "text": "Okay, anxiety, that's already on your record. Good to know. Okay, is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.19,
      "end_seconds": 107.46,
      "duration_seconds": 3.27,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 114.06,
      "duration_seconds": 5.03,
      "text": "Any allergies I should know about? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.09,
      "end_seconds": 115.98,
      "duration_seconds": 0.89,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.68,
      "end_seconds": 121.69,
      "duration_seconds": 5.01,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.24,
      "end_seconds": 133.62,
      "duration_seconds": 10.38,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 135.63,
      "duration_seconds": 1.04,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.09,
      "end_seconds": 137.53,
      "duration_seconds": 1.44,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.73,
      "end_seconds": 142.73,
      "duration_seconds": 4.0,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.92,
      "end_seconds": 146.17,
      "duration_seconds": 2.25,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.97,
      "end_seconds": 152.76,
      "duration_seconds": 3.79,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.87,
      "end_seconds": 157.19,
      "duration_seconds": 3.32,
      "text": "Thank you, you know, I appreciate it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.95,
      "end_seconds": 163.99,
      "duration_seconds": 4.04,
      "text": "Right, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.52,
      "end_seconds": 166.39,
      "duration_seconds": 0.87,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.11,
      "end_seconds": 171.24,
      "duration_seconds": 3.13,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.36,
      "end_seconds": 188.62,
      "duration_seconds": 3.26,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.21,
      "end_seconds": 201.14,
      "duration_seconds": 7.93,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.42,
      "end_seconds": 204.98,
      "duration_seconds": 2.56,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.48,
      "end_seconds": 206.38,
      "duration_seconds": 0.9,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.86,
      "end_seconds": 232.07,
      "duration_seconds": 11.21,
      "text": "Alright, I've got it. So, based on the history and the examination, it fits best with an anxiety disorder. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.19,
      "end_seconds": 236.21,
      "duration_seconds": 3.02,
      "text": "Okay, so is this going to go away?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.54,
      "end_seconds": 253.8,
      "duration_seconds": 17.26,
      "text": "I understand the worry. At the moment I'd say it's an anxiety disorder, and we'll know more once the a thyroid test is back. Let me just recap so I've got it right. You've been feeling anxious most of the day for two months, and no weight loss or low mood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.26,
      "end_seconds": 256.39,
      "duration_seconds": 2.13,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.95,
      "end_seconds": 261.22,
      "duration_seconds": 3.27,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.37,
      "end_seconds": 268.23,
      "duration_seconds": 5.86,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.34,
      "end_seconds": 276.75,
      "duration_seconds": 7.41,
      "text": "We should do a thyroid test for anxiety. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 277.12,
      "end_seconds": 280.62,
      "duration_seconds": 3.5,
      "text": "I can book that for Tuesday at 11:30 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.14,
      "end_seconds": 282.86,
      "duration_seconds": 0.72,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.0,
      "end_seconds": 300.27,
      "duration_seconds": 16.27,
      "text": "Slow breathing, in for four and out for six, for a few minutes whenever it builds up. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you to see a counsellor as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.92,
      "end_seconds": 301.62,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.95,
      "end_seconds": 310.0,
      "duration_seconds": 7.05,
      "text": "Keep an eye out, and if you have thoughts of harming yourself, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.27,
      "end_seconds": 311.97,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.22,
      "end_seconds": 316.11,
      "duration_seconds": 2.89,
      "text": "I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.19,
      "end_seconds": 320.04,
      "duration_seconds": 2.85,
      "text": "Okay, you know, I'll book that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.41,
      "end_seconds": 325.08,
      "duration_seconds": 4.67,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.4,
      "end_seconds": 334.39,
      "duration_seconds": 4.99,
      "text": "So, um, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.22,
      "end_seconds": 340.45,
      "duration_seconds": 5.23,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.45,
      "end_seconds": 344.98,
      "duration_seconds": 3.53,
      "text": "Right, nothing more from me, doctor, thanks."
    }
  ]
}