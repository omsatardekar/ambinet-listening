{
  "schema_version": "1.0",
  "encounter_id": "00355",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 2.85,
      "duration_seconds": 1.86,
      "text": "Hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.74,
      "end_seconds": 4.44,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 7.53,
      "duration_seconds": 1.67,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.1,
      "end_seconds": 11.0,
      "duration_seconds": 2.9,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.97,
      "end_seconds": 13.93,
      "duration_seconds": 1.96,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.88,
      "end_seconds": 22.74,
      "duration_seconds": 4.86,
      "text": "Yeah, it's tiredness all the time. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.19,
      "end_seconds": 25.46,
      "duration_seconds": 2.27,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.72,
      "end_seconds": 34.31,
      "duration_seconds": 7.59,
      "text": "It's been three weeks, I'm fairly sure. I've had a bit of weight gain too, for five days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.6,
      "end_seconds": 39.4,
      "duration_seconds": 3.8,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.93,
      "end_seconds": 42.41,
      "duration_seconds": 2.48,
      "text": "Yeah, no problem, take your time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 49.8,
      "duration_seconds": 6.64,
      "text": "Let me check a few things. Any night sweats, blood in the stool or shortness of breath?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.83,
      "end_seconds": 55.95,
      "duration_seconds": 5.12,
      "text": "Well, no, no night sweats, blood in the stool or shortness of breath."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.34,
      "end_seconds": 59.81,
      "duration_seconds": 2.47,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.33,
      "end_seconds": 63.21,
      "duration_seconds": 1.88,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.9,
      "end_seconds": 67.16,
      "duration_seconds": 3.26,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 69.64,
      "duration_seconds": 2.0,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.14,
      "end_seconds": 73.41,
      "duration_seconds": 2.27,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.96,
      "end_seconds": 76.02,
      "duration_seconds": 2.06,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.61,
      "end_seconds": 79.18,
      "duration_seconds": 2.57,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.16,
      "end_seconds": 84.58,
      "duration_seconds": 4.42,
      "text": "Yeah, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.87,
      "end_seconds": 86.57,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.25,
      "end_seconds": 88.54,
      "duration_seconds": 1.29,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.68,
      "end_seconds": 94.28,
      "duration_seconds": 1.6,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.77,
      "end_seconds": 102.57,
      "duration_seconds": 3.8,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 107.43,
      "duration_seconds": 3.45,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.32,
      "end_seconds": 109.02,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.23,
      "end_seconds": 128.99,
      "duration_seconds": 4.76,
      "text": "Alright, I've got it. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.87,
      "end_seconds": 131.98,
      "duration_seconds": 2.11,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.42,
      "end_seconds": 137.13,
      "duration_seconds": 2.71,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.83,
      "end_seconds": 139.27,
      "duration_seconds": 1.44,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.67,
      "end_seconds": 144.07,
      "duration_seconds": 3.4,
      "text": "Okay, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.51,
      "end_seconds": 146.5,
      "duration_seconds": 0.99,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.52,
      "end_seconds": 150.25,
      "duration_seconds": 2.73,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.32,
      "end_seconds": 153.8,
      "duration_seconds": 2.48,
      "text": "Metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.08,
      "end_seconds": 157.56,
      "duration_seconds": 2.48,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.42,
      "end_seconds": 159.17,
      "duration_seconds": 0.75,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.56,
      "end_seconds": 174.13,
      "duration_seconds": 5.57,
      "text": "Right, thanks for waiting. Okay, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.99,
      "end_seconds": 187.38,
      "duration_seconds": 12.39,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.07,
      "end_seconds": 191.88,
      "duration_seconds": 1.81,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.13,
      "end_seconds": 196.32,
      "duration_seconds": 3.19,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 214.4,
      "duration_seconds": 3.04,
      "text": "You look a little pale in the eyelids."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.29,
      "end_seconds": 226.9,
      "duration_seconds": 9.61,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.49,
      "end_seconds": 232.06,
      "duration_seconds": 4.57,
      "text": "So, bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.8,
      "end_seconds": 249.66,
      "duration_seconds": 8.86,
      "text": "Okay, continuing. Putting it all together, my working impression is persistent tiredness, possibly from low iron. I'd also keep thyroid disease in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.29,
      "end_seconds": 252.48,
      "duration_seconds": 2.19,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.8,
      "end_seconds": 270.09,
      "duration_seconds": 16.29,
      "text": "I can't promise yet, but most people with persistent tiredness, possibly from low iron do well once it's treated properly. Let me just recap so I've got it right. You've had tiredness all the time for three weeks, and no blood in the stool or shortness of breath."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.63,
      "end_seconds": 273.02,
      "duration_seconds": 1.39,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.51,
      "end_seconds": 278.1,
      "duration_seconds": 3.59,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.4,
      "end_seconds": 279.2,
      "duration_seconds": 0.8,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.56,
      "end_seconds": 322.25,
      "duration_seconds": 27.69,
      "text": "Right, thanks for waiting. I'd like to arrange a vitamin B12 level for fatigue. It's a routine test and it'll give us a much clearer picture. Let's use vitamin D, 60000 units, once a week, for eight weeks. You take it by mouth. That should help with low energy. The pharmacy will go through the details again when you pick it up. Try to keep a regular sleep time and get some daylight in the morning."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.42,
      "end_seconds": 339.71,
      "duration_seconds": 16.29,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.06,
      "end_seconds": 341.76,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.24,
      "end_seconds": 345.18,
      "duration_seconds": 2.94,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.87,
      "end_seconds": 347.59,
      "duration_seconds": 1.72,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.99,
      "end_seconds": 352.24,
      "duration_seconds": 4.25,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.23,
      "end_seconds": 358.21,
      "duration_seconds": 4.98,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.8,
      "end_seconds": 362.27,
      "duration_seconds": 2.47,
      "text": "Yes, exactly right. Good. Look after yourself."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.66,
      "end_seconds": 364.53,
      "duration_seconds": 1.87,
      "text": "Thanks so much, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.11,
      "end_seconds": 365.81,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}