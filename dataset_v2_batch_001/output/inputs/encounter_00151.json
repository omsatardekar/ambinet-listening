{
  "schema_version": "1.0",
  "encounter_id": "00151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 6.92,
      "duration_seconds": 6.06,
      "text": "Come in, come in. Pull the door closed behind you, please. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.97,
      "end_seconds": 10.7,
      "duration_seconds": 2.73,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.1,
      "end_seconds": 14.97,
      "duration_seconds": 1.87,
      "text": "So, how have things been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.99,
      "end_seconds": 22.45,
      "duration_seconds": 6.46,
      "text": "Honestly, it's a fever that won't go away, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.88,
      "end_seconds": 25.29,
      "duration_seconds": 2.41,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.36,
      "end_seconds": 31.92,
      "duration_seconds": 5.56,
      "text": "About... well, ten days. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.98,
      "end_seconds": 34.85,
      "duration_seconds": 1.87,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.84,
      "end_seconds": 37.21,
      "duration_seconds": 1.37,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.0,
      "end_seconds": 41.08,
      "duration_seconds": 3.08,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.27,
      "end_seconds": 47.07,
      "duration_seconds": 1.8,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.67,
      "end_seconds": 48.37,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 51.89,
      "duration_seconds": 2.83,
      "text": "I've also been feeling weak, since yesterday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.04,
      "end_seconds": 55.55,
      "duration_seconds": 2.51,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.2,
      "end_seconds": 57.09,
      "duration_seconds": 0.89,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.02,
      "end_seconds": 74.24,
      "duration_seconds": 4.22,
      "text": "Okay, here we go. Any vomiting or burning when passing urine at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.27,
      "end_seconds": 79.78,
      "duration_seconds": 4.51,
      "text": "No vomiting or burning when passing urine, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.3,
      "end_seconds": 85.09,
      "duration_seconds": 4.79,
      "text": "Let me check a few things. Any rash, cough or blood in the stool?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.0,
      "end_seconds": 87.64,
      "duration_seconds": 1.64,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 102.26,
      "duration_seconds": 13.48,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.01,
      "end_seconds": 104.63,
      "duration_seconds": 1.62,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.53,
      "end_seconds": 108.47,
      "duration_seconds": 2.94,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.41,
      "end_seconds": 138.79,
      "duration_seconds": 29.38,
      "text": "Metformin. I take it 500 milligrams, twice a day. I did try to ignore it for a while. I take escitalopram, 10 milligrams, once a day for my mood. My family kept telling me to get it checked. I told myself I'd wait and see, and here I am. Dolo, 650 milligrams, when I get the fever. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.9,
      "end_seconds": 143.99,
      "duration_seconds": 4.09,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.63,
      "end_seconds": 145.33,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.61,
      "end_seconds": 157.96,
      "duration_seconds": 2.35,
      "text": "Alright, I've got it. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.34,
      "end_seconds": 159.97,
      "duration_seconds": 1.63,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 164.47,
      "duration_seconds": 3.8,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.45,
      "end_seconds": 168.29,
      "duration_seconds": 2.84,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.63,
      "end_seconds": 173.09,
      "duration_seconds": 4.46,
      "text": "Right, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.72,
      "end_seconds": 174.59,
      "duration_seconds": 0.87,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.09,
      "end_seconds": 175.79,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.59,
      "end_seconds": 178.9,
      "duration_seconds": 2.31,
      "text": "I have depression, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 181.05,
      "duration_seconds": 0.95,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.1,
      "end_seconds": 201.0,
      "duration_seconds": 18.9,
      "text": "Okay, depression, that's already on your record. Good to know. It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.6,
      "end_seconds": 203.17,
      "duration_seconds": 1.57,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.37,
      "end_seconds": 206.26,
      "duration_seconds": 1.89,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.9,
      "end_seconds": 209.58,
      "duration_seconds": 2.68,
      "text": "I'm allergic to shellfish, I get hives."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.91,
      "end_seconds": 214.2,
      "duration_seconds": 3.29,
      "text": "Alright, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.54,
      "end_seconds": 215.4,
      "duration_seconds": 0.86,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 230.51,
      "duration_seconds": 3.43,
      "text": "Okay, here we go. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.44,
      "end_seconds": 244.8,
      "duration_seconds": 1.36,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.09,
      "end_seconds": 271.71,
      "duration_seconds": 7.62,
      "text": "Okay: pulse is 98 beats a minute, oxygen saturation is 97 percent. And temperature is 38.5 degrees, BP is 126 over 73."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.38,
      "end_seconds": 277.62,
      "duration_seconds": 1.24,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.53,
      "end_seconds": 284.32,
      "duration_seconds": 5.79,
      "text": "We'll put it in context in a moment. Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.7,
      "end_seconds": 287.91,
      "duration_seconds": 3.21,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.34,
      "end_seconds": 292.32,
      "duration_seconds": 3.98,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.85,
      "end_seconds": 294.81,
      "duration_seconds": 1.96,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.78,
      "end_seconds": 307.32,
      "duration_seconds": 11.54,
      "text": "Putting together what you've described, I think we're dealing with typhoid fever, which we need to confirm at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.65,
      "end_seconds": 313.18,
      "duration_seconds": 5.53,
      "text": "Um, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.71,
      "end_seconds": 331.34,
      "duration_seconds": 17.63,
      "text": "Nothing I've seen today points to an emergency. It looks like typhoid fever, which we need to confirm, but I'd like to confirm. Let me just recap so I've got it right. You've had a fever that won't go away for ten days, moderate, and no rash or burning when passing urine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.0,
      "end_seconds": 334.0,
      "duration_seconds": 2.0,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.02,
      "end_seconds": 352.58,
      "duration_seconds": 17.56,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.91,
      "end_seconds": 356.13,
      "duration_seconds": 3.22,
      "text": "Okay, so I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.93,
      "end_seconds": 360.36,
      "duration_seconds": 3.43,
      "text": "I'd like to arrange a malaria test for fever."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.7,
      "end_seconds": 363.17,
      "duration_seconds": 2.47,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.91,
      "end_seconds": 390.55,
      "duration_seconds": 26.64,
      "text": "Eat only home-cooked food and drink boiled or bottled water while this is going on. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please take the tablets with food so they don't upset your stomach. I want you to come back or go to emergency straight away if the fever stays high or the tummy pain gets sharp."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.7,
      "end_seconds": 395.44,
      "duration_seconds": 3.74,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.07,
      "end_seconds": 396.77,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.23,
      "end_seconds": 403.07,
      "duration_seconds": 4.84,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.65,
      "end_seconds": 408.8,
      "duration_seconds": 5.15,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.77,
      "end_seconds": 414.67,
      "duration_seconds": 4.9,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 416.07,
      "end_seconds": 419.21,
      "duration_seconds": 3.14,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.67,
      "end_seconds": 422.66,
      "duration_seconds": 1.99,
      "text": "Bye for now, look after yourself."
    }
  ]
}