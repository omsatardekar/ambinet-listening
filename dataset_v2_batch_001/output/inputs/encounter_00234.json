{
  "schema_version": "1.0",
  "encounter_id": "00234",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 1.93,
      "duration_seconds": 1.36,
      "text": "Hello, please sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 2.36,
      "end_seconds": 3.28,
      "duration_seconds": 0.92,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.05,
      "end_seconds": 6.66,
      "duration_seconds": 2.61,
      "text": "So, in your own words, what's happened?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.12,
      "end_seconds": 13.85,
      "duration_seconds": 6.73,
      "text": "Um, uh, honestly, it's the room spinning, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.87,
      "end_seconds": 16.73,
      "duration_seconds": 1.86,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.06,
      "end_seconds": 20.07,
      "duration_seconds": 3.01,
      "text": "Um, it's been three days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.58,
      "end_seconds": 28.86,
      "duration_seconds": 8.28,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.45,
      "end_seconds": 44.28,
      "duration_seconds": 13.83,
      "text": "Honestly, on and off. I get some relief from lying still. Mild, I'd say. I notice it more with turning over in bed and looking up. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 59.24,
      "duration_seconds": 14.02,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.48,
      "end_seconds": 62.48,
      "duration_seconds": 2.0,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.83,
      "end_seconds": 67.79,
      "duration_seconds": 3.96,
      "text": "Have you had any numbness in the face or slurred speech?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.4,
      "end_seconds": 72.17,
      "duration_seconds": 3.77,
      "text": "No, no numbness in the face or slurred speech."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.58,
      "end_seconds": 78.74,
      "duration_seconds": 5.16,
      "text": "Do you have any known allergies at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.32,
      "end_seconds": 80.21,
      "duration_seconds": 0.89,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.81,
      "end_seconds": 83.13,
      "duration_seconds": 2.32,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.72,
      "end_seconds": 84.58,
      "duration_seconds": 0.86,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.49,
      "end_seconds": 96.66,
      "duration_seconds": 2.17,
      "text": "Right, thanks for waiting. Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.84,
      "end_seconds": 100.64,
      "duration_seconds": 2.8,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.89,
      "end_seconds": 106.84,
      "duration_seconds": 4.95,
      "text": "Any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.81,
      "end_seconds": 110.34,
      "duration_seconds": 2.53,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.3,
      "end_seconds": 115.22,
      "duration_seconds": 1.92,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.6,
      "end_seconds": 118.39,
      "duration_seconds": 1.79,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.25,
      "end_seconds": 123.04,
      "duration_seconds": 3.79,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.46,
      "end_seconds": 124.16,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.94,
      "end_seconds": 143.74,
      "duration_seconds": 5.8,
      "text": "Okay, here we go. Are you on any tablets or medication? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.32,
      "end_seconds": 149.07,
      "duration_seconds": 3.75,
      "text": "Vertin. I take it 16 milligrams, when it comes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.99,
      "end_seconds": 153.74,
      "duration_seconds": 3.75,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.22,
      "end_seconds": 154.92,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 171.06,
      "duration_seconds": 1.36,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.28,
      "end_seconds": 175.4,
      "duration_seconds": 2.12,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.26,
      "end_seconds": 179.23,
      "duration_seconds": 2.97,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 197.88,
      "duration_seconds": 4.91,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.05,
      "end_seconds": 200.94,
      "duration_seconds": 1.89,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.54,
      "end_seconds": 214.78,
      "duration_seconds": 3.24,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.17,
      "end_seconds": 219.23,
      "duration_seconds": 2.06,
      "text": "Okay, you can sit back up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.43,
      "end_seconds": 222.78,
      "duration_seconds": 2.35,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.13,
      "end_seconds": 225.07,
      "duration_seconds": 1.94,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.43,
      "end_seconds": 249.31,
      "duration_seconds": 10.88,
      "text": "Right, thanks for waiting. Putting it all together, my working impression is benign positional vertigo. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 252.01,
      "duration_seconds": 2.33,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.4,
      "end_seconds": 268.49,
      "duration_seconds": 15.09,
      "text": "Nothing I've seen today points to an emergency. It looks like benign positional vertigo, but I'd like to confirm. Let me just recap so I've got it right. You've had the room spinning for three days, mild, and no slurred speech or numbness in the face."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.53,
      "end_seconds": 270.77,
      "duration_seconds": 1.24,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.93,
      "end_seconds": 275.03,
      "duration_seconds": 3.1,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.61,
      "end_seconds": 290.46,
      "duration_seconds": 13.85,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.84,
      "end_seconds": 299.47,
      "duration_seconds": 8.63,
      "text": "We should do a hearing test for tinnitus and vertigo. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.14,
      "end_seconds": 307.58,
      "duration_seconds": 3.44,
      "text": "I can book that for Thursday at 11:30 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.43,
      "end_seconds": 310.57,
      "duration_seconds": 2.14,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.59,
      "end_seconds": 328.91,
      "duration_seconds": 17.32,
      "text": "Get up slowly from lying down and sit for a moment first. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I want you to come back or go to emergency straight away if you get weakness, slurred speech or a severe headache with the dizziness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.93,
      "end_seconds": 330.63,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.97,
      "end_seconds": 334.65,
      "duration_seconds": 2.68,
      "text": "Please come and see me in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.41,
      "end_seconds": 340.45,
      "duration_seconds": 5.04,
      "text": "Sure, you know, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.77,
      "end_seconds": 345.62,
      "duration_seconds": 4.85,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.29,
      "end_seconds": 350.88,
      "duration_seconds": 4.59,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.81,
      "end_seconds": 357.05,
      "duration_seconds": 5.24,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.17,
      "end_seconds": 362.08,
      "duration_seconds": 3.91,
      "text": "Okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.82,
      "end_seconds": 365.82,
      "duration_seconds": 1.0,
      "text": "See you then."
    }
  ]
}