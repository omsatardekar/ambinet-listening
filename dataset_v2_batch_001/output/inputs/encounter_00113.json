{
  "schema_version": "1.0",
  "encounter_id": "00113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 6.46,
      "duration_seconds": 5.57,
      "text": "Doctor, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.14,
      "end_seconds": 10.78,
      "duration_seconds": 3.64,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.98,
      "end_seconds": 22.92,
      "duration_seconds": 10.94,
      "text": "Oh, honestly, it's swelling in my left calf, and my family pushed me to come. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.8,
      "end_seconds": 25.47,
      "duration_seconds": 1.67,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.64,
      "end_seconds": 33.72,
      "duration_seconds": 7.08,
      "text": "Probably one week. Yeah. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.67,
      "end_seconds": 39.77,
      "duration_seconds": 3.1,
      "text": "Okay, what's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.09,
      "end_seconds": 46.75,
      "duration_seconds": 5.66,
      "text": "It's, It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.86,
      "end_seconds": 53.62,
      "duration_seconds": 5.76,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.08,
      "end_seconds": 58.61,
      "duration_seconds": 3.53,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 62.47,
      "duration_seconds": 2.59,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.89,
      "end_seconds": 66.96,
      "duration_seconds": 3.07,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 72.3,
      "duration_seconds": 4.66,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 72.4,
      "end_seconds": 77.81,
      "duration_seconds": 5.41,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.99,
      "end_seconds": 80.74,
      "duration_seconds": 1.75,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.19,
      "end_seconds": 85.8,
      "duration_seconds": 4.61,
      "text": "Uh, I've also had warmth in the leg, for five days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.22,
      "end_seconds": 91.35,
      "duration_seconds": 4.13,
      "text": "Any recent injury to the leg or chest pain at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.96,
      "end_seconds": 102.78,
      "duration_seconds": 10.82,
      "text": "No, no recent injury to the leg, no chest pain. I did have heaviness in the leg at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.37,
      "end_seconds": 109.29,
      "duration_seconds": 4.92,
      "text": "Let me check a few things. Any breathlessness, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 112.0,
      "duration_seconds": 1.93,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.48,
      "end_seconds": 114.08,
      "duration_seconds": 1.6,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.73,
      "end_seconds": 116.04,
      "duration_seconds": 1.31,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.59,
      "end_seconds": 119.43,
      "duration_seconds": 1.84,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.07,
      "end_seconds": 122.89,
      "duration_seconds": 2.82,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.14,
      "end_seconds": 128.93,
      "duration_seconds": 4.79,
      "text": "Right, what medicines do you take regularly? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.71,
      "end_seconds": 146.44,
      "duration_seconds": 16.73,
      "text": "Ramipril. I take it 5 milligrams, every morning. It's a relief to finally sit down and talk about it. I did try to ignore it for a while. Alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.87,
      "end_seconds": 149.57,
      "duration_seconds": 2.7,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.34,
      "end_seconds": 159.53,
      "duration_seconds": 5.19,
      "text": "Well, no, it's at home. I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 160.8,
      "end_seconds": 165.28,
      "duration_seconds": 4.48,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.66,
      "end_seconds": 169.87,
      "duration_seconds": 3.21,
      "text": "So, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.74,
      "end_seconds": 175.5,
      "duration_seconds": 4.76,
      "text": "No, I left it at home. It's paracetamol, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.03,
      "end_seconds": 178.23,
      "duration_seconds": 2.2,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.72,
      "end_seconds": 187.83,
      "duration_seconds": 8.11,
      "text": "500 milligrams, I think that's what's on the box. I'd been on clopidogrel, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.57,
      "end_seconds": 192.43,
      "duration_seconds": 3.86,
      "text": "Right, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.02,
      "end_seconds": 201.83,
      "duration_seconds": 7.81,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.96,
      "end_seconds": 204.85,
      "duration_seconds": 1.89,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.95,
      "end_seconds": 210.56,
      "duration_seconds": 4.61,
      "text": "I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 214.87,
      "duration_seconds": 3.7,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.32,
      "end_seconds": 223.85,
      "duration_seconds": 8.53,
      "text": "I have high blood pressure, for nearly five years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.71,
      "end_seconds": 225.67,
      "duration_seconds": 0.96,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.05,
      "end_seconds": 246.28,
      "duration_seconds": 19.23,
      "text": "I've got arthritis in my knees. I kept putting it off, which I know isn't sensible. I've had thin bones for five years now. I've got depression. I have heart disease. I'm hoping you can tell me something definite. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.65,
      "end_seconds": 258.79,
      "duration_seconds": 12.14,
      "text": "Right, so that's your known high blood pressure. We'll keep that in mind today. Okay, arthritis in my knees, that's already on your record. Good to know. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.53,
      "end_seconds": 262.26,
      "duration_seconds": 2.73,
      "text": "Uh, my mother has diabetes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 263.51,
      "end_seconds": 269.42,
      "duration_seconds": 5.91,
      "text": "Doctor, I've got the readings for you. Temperature 36.6, heart rate 121, blood pressure 112 over 73."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.03,
      "end_seconds": 272.77,
      "duration_seconds": 0.74,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.72,
      "end_seconds": 279.05,
      "duration_seconds": 3.33,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.62,
      "end_seconds": 280.32,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.29,
      "end_seconds": 282.96,
      "duration_seconds": 1.67,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.25,
      "end_seconds": 301.39,
      "duration_seconds": 4.14,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 305.47,
      "duration_seconds": 2.73,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.37,
      "end_seconds": 322.94,
      "duration_seconds": 1.57,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.36,
      "end_seconds": 325.58,
      "duration_seconds": 1.22,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.25,
      "end_seconds": 354.16,
      "duration_seconds": 23.91,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, this looks most like a possible deep vein clot. I want to be honest that this is an impression, not a final answer. I'd also keep a muscle strain in mind. I can't rule out cellulitis yet."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.26,
      "end_seconds": 364.09,
      "duration_seconds": 8.83,
      "text": "I'm going to order a D-dimer blood test, for suspected DVT. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 365.46,
      "end_seconds": 367.55,
      "duration_seconds": 2.09,
      "text": "The earliest is Tuesday, 9 am."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.11,
      "end_seconds": 369.93,
      "duration_seconds": 1.82,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.81,
      "end_seconds": 379.79,
      "duration_seconds": 8.98,
      "text": "I'm going to order a Doppler scan of the leg, for suspected DVT. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.61,
      "end_seconds": 381.48,
      "duration_seconds": 0.87,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.12,
      "end_seconds": 404.39,
      "duration_seconds": 22.27,
      "text": "Keep walking gently, and don't massage the calf. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.92,
      "end_seconds": 407.28,
      "duration_seconds": 1.36,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.84,
      "end_seconds": 415.76,
      "duration_seconds": 6.92,
      "text": "Please don't sit on it if you get chest pain or sudden breathlessness. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.96,
      "end_seconds": 419.59,
      "duration_seconds": 2.63,
      "text": "Yes, uh, I'll do that."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.64,
      "end_seconds": 423.39,
      "duration_seconds": 2.75,
      "text": "Please come and see me after the scan."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.54,
      "end_seconds": 425.24,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.23,
      "end_seconds": 430.68,
      "duration_seconds": 4.45,
      "text": "Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.32,
      "end_seconds": 435.01,
      "duration_seconds": 3.69,
      "text": "Hmm, um, thanks so much, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.68,
      "end_seconds": 436.75,
      "duration_seconds": 1.07,
      "text": "See you then."
    }
  ]
}