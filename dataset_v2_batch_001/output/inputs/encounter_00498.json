{
  "schema_version": "1.0",
  "encounter_id": "00498",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.99,
      "duration_seconds": 3.67,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 11.63,
      "duration_seconds": 3.06,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.01,
      "end_seconds": 16.11,
      "duration_seconds": 4.1,
      "text": "So the thing is, I've got occasional chest tightness."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.46,
      "end_seconds": 19.32,
      "duration_seconds": 1.86,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.85,
      "end_seconds": 27.61,
      "duration_seconds": 6.76,
      "text": "I've had it for two years. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 31.79,
      "duration_seconds": 2.95,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.47,
      "end_seconds": 33.77,
      "duration_seconds": 1.3,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.22,
      "end_seconds": 38.53,
      "duration_seconds": 3.31,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.95,
      "end_seconds": 41.07,
      "duration_seconds": 2.12,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.03,
      "end_seconds": 44.83,
      "duration_seconds": 2.8,
      "text": "Any bruising, palpitations or pain at rest?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.91,
      "end_seconds": 49.92,
      "duration_seconds": 4.01,
      "text": "No bruising, palpitations or pain at rest, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.31,
      "end_seconds": 53.95,
      "duration_seconds": 3.64,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.69,
      "end_seconds": 57.14,
      "duration_seconds": 2.45,
      "text": "So, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.49,
      "end_seconds": 61.64,
      "duration_seconds": 3.15,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.32,
      "end_seconds": 64.9,
      "duration_seconds": 2.58,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.24,
      "end_seconds": 69.18,
      "duration_seconds": 2.94,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.67,
      "end_seconds": 74.15,
      "duration_seconds": 3.48,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.32,
      "end_seconds": 76.49,
      "duration_seconds": 1.17,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.24,
      "end_seconds": 78.63,
      "duration_seconds": 1.39,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.89,
      "end_seconds": 82.15,
      "duration_seconds": 2.26,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.26,
      "end_seconds": 86.56,
      "duration_seconds": 3.3,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 91.63,
      "duration_seconds": 2.16,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.49,
      "end_seconds": 94.44,
      "duration_seconds": 1.95,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.55,
      "end_seconds": 100.13,
      "duration_seconds": 4.58,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.13,
      "end_seconds": 105.88,
      "duration_seconds": 4.75,
      "text": "Okay, so mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.75,
      "end_seconds": 108.62,
      "duration_seconds": 1.87,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.93,
      "end_seconds": 111.15,
      "duration_seconds": 2.22,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.55,
      "end_seconds": 124.17,
      "duration_seconds": 12.62,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.75,
      "end_seconds": 129.28,
      "duration_seconds": 3.53,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.26,
      "end_seconds": 133.35,
      "duration_seconds": 3.09,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.38,
      "end_seconds": 148.02,
      "duration_seconds": 13.64,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.28,
      "end_seconds": 153.15,
      "duration_seconds": 2.87,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.11,
      "end_seconds": 156.7,
      "duration_seconds": 2.59,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.96,
      "end_seconds": 170.51,
      "duration_seconds": 2.55,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.31,
      "end_seconds": 173.17,
      "duration_seconds": 1.86,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.29,
      "end_seconds": 187.07,
      "duration_seconds": 2.78,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.3,
      "end_seconds": 206.19,
      "duration_seconds": 13.89,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.61,
      "end_seconds": 217.84,
      "duration_seconds": 11.23,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.18,
      "end_seconds": 229.07,
      "duration_seconds": 10.89,
      "text": "Okay, so my impression is this: This looks most like stable recovery after the heart event. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.39,
      "end_seconds": 231.84,
      "duration_seconds": 2.45,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.84,
      "end_seconds": 249.4,
      "duration_seconds": 16.56,
      "text": "It's reasonable to be concerned, but right now stable recovery after the heart event is my leading thought, not anything worse. Let me just recap so I've got it right. You've had occasional chest tightness for two years, mild, and no bruising or pain at rest."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.79,
      "end_seconds": 252.06,
      "duration_seconds": 2.27,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.45,
      "end_seconds": 257.28,
      "duration_seconds": 3.83,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.16,
      "end_seconds": 258.86,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.41,
      "end_seconds": 285.53,
      "duration_seconds": 18.12,
      "text": "Okay, here we go. We should do a lipid profile for cardiovascular risk. That will help us see what's going on underneath and decide the next step. I'll start you on atorvastatin, 40 milligrams, at night, long term. You take it by mouth. That should help with cardiovascular risk."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.56,
      "end_seconds": 290.37,
      "duration_seconds": 3.81,
      "text": "Okay, um, and I take that after food?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.57,
      "end_seconds": 305.11,
      "duration_seconds": 13.54,
      "text": "Please don't stop the blood thinner on your own, even if you feel fine. Cut down on salt and fried food for now, it really does make a difference. We'll refer you to cardiac rehabilitation."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.71,
      "end_seconds": 308.71,
      "duration_seconds": 2.0,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.84,
      "end_seconds": 317.42,
      "duration_seconds": 7.58,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.84,
      "end_seconds": 319.69,
      "duration_seconds": 1.85,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.08,
      "end_seconds": 325.03,
      "duration_seconds": 2.95,
      "text": "I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.49,
      "end_seconds": 327.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.29,
      "end_seconds": 334.53,
      "duration_seconds": 6.24,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.54,
      "end_seconds": 345.95,
      "duration_seconds": 7.41,
      "text": "So, I take the atorvastatin, 40 milligrams, at night and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.75,
      "end_seconds": 352.66,
      "duration_seconds": 3.91,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.22,
      "end_seconds": 355.8,
      "duration_seconds": 1.58,
      "text": "No questions. Thank you."
    }
  ]
}