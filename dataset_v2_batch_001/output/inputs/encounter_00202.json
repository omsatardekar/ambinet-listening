{
  "schema_version": "1.0",
  "encounter_id": "00202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 4.7,
      "duration_seconds": 4.1,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 9.85,
      "duration_seconds": 3.59,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.93,
      "end_seconds": 15.15,
      "duration_seconds": 4.22,
      "text": "So the thing is, I've got a fit last month."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.59,
      "end_seconds": 19.51,
      "duration_seconds": 2.92,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.59,
      "end_seconds": 29.85,
      "duration_seconds": 9.26,
      "text": "It's been going on for ten days. I took the morning off to come in today. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.92,
      "end_seconds": 36.71,
      "duration_seconds": 2.79,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.29,
      "end_seconds": 39.6,
      "duration_seconds": 1.31,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.24,
      "end_seconds": 43.64,
      "duration_seconds": 3.4,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.16,
      "end_seconds": 52.48,
      "duration_seconds": 5.32,
      "text": "It happens all the time. There's a bit of confusion afterwards as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.67,
      "end_seconds": 58.68,
      "duration_seconds": 3.01,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.82,
      "end_seconds": 76.58,
      "duration_seconds": 16.76,
      "text": "Hmm, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.32,
      "end_seconds": 80.53,
      "duration_seconds": 3.21,
      "text": "Any fever, head injury or loss of bladder control?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.73,
      "end_seconds": 84.53,
      "duration_seconds": 2.8,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.67,
      "end_seconds": 90.37,
      "duration_seconds": 1.7,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.83,
      "end_seconds": 93.6,
      "duration_seconds": 1.77,
      "text": "No headache, thank goodness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 96.9,
      "duration_seconds": 2.61,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 98.07,
      "duration_seconds": 0.72,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.77,
      "end_seconds": 108.13,
      "duration_seconds": 3.36,
      "text": "Right, thanks for waiting. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.76,
      "end_seconds": 112.49,
      "duration_seconds": 3.73,
      "text": "Yeah, um, no, none that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.95,
      "end_seconds": 118.07,
      "duration_seconds": 4.12,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.9,
      "end_seconds": 119.78,
      "duration_seconds": 0.88,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.32,
      "end_seconds": 139.21,
      "duration_seconds": 4.89,
      "text": "Okay, here we go. Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.53,
      "end_seconds": 144.92,
      "duration_seconds": 5.39,
      "text": "I've had epilepsy for two years now. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.75,
      "end_seconds": 152.59,
      "duration_seconds": 6.84,
      "text": "Right, so that's your known epilepsy. We'll keep that in mind today. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.15,
      "end_seconds": 156.76,
      "duration_seconds": 2.61,
      "text": "Oh, yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.45,
      "end_seconds": 161.6,
      "duration_seconds": 1.15,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.06,
      "end_seconds": 163.25,
      "duration_seconds": 1.19,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.66,
      "end_seconds": 164.78,
      "duration_seconds": 1.12,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.35,
      "end_seconds": 169.45,
      "duration_seconds": 4.1,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.41,
      "end_seconds": 186.11,
      "duration_seconds": 15.7,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.92,
      "end_seconds": 190.01,
      "duration_seconds": 3.09,
      "text": "Thank you, um, that really helps."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.89,
      "end_seconds": 192.78,
      "duration_seconds": 1.89,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.96,
      "end_seconds": 197.74,
      "duration_seconds": 3.78,
      "text": "I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.42,
      "end_seconds": 202.32,
      "duration_seconds": 3.9,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.29,
      "end_seconds": 216.71,
      "duration_seconds": 2.42,
      "text": "Good, where were we. Any regular medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.74,
      "end_seconds": 219.02,
      "duration_seconds": 1.28,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.11,
      "end_seconds": 222.38,
      "duration_seconds": 2.27,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.61,
      "end_seconds": 229.2,
      "duration_seconds": 5.59,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.25,
      "end_seconds": 232.99,
      "duration_seconds": 2.74,
      "text": "Right, I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.34,
      "end_seconds": 241.65,
      "duration_seconds": 1.31,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.05,
      "end_seconds": 261.7,
      "duration_seconds": 5.65,
      "text": "Okay: pressure 112 over 78, temp 36.9 degrees, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.99,
      "end_seconds": 267.19,
      "duration_seconds": 3.2,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.74,
      "end_seconds": 268.44,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.65,
      "end_seconds": 271.31,
      "duration_seconds": 1.66,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.8,
      "end_seconds": 289.77,
      "duration_seconds": 2.97,
      "text": "Reflexes and power are symmetrical on both sides."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.25,
      "end_seconds": 291.95,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.13,
      "end_seconds": 296.58,
      "duration_seconds": 2.45,
      "text": "Okay, you can sit back up."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.8,
      "end_seconds": 302.01,
      "duration_seconds": 4.21,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.91,
      "end_seconds": 303.61,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.33,
      "end_seconds": 324.99,
      "duration_seconds": 7.66,
      "text": "Right, thanks for waiting. Okay, so my impression is this: I think we're dealing with breakthrough seizure on known epilepsy at this stage."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.34,
      "end_seconds": 328.84,
      "duration_seconds": 2.5,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.3,
      "end_seconds": 351.04,
      "duration_seconds": 18.74,
      "text": "Nothing I've seen today points to an emergency. It looks like breakthrough seizure on known epilepsy, but I'd like to confirm. Let me just recap so I've got it right. You've had a fit last month for ten days, moderate, and no loss of bladder control or headache."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.68,
      "end_seconds": 353.14,
      "duration_seconds": 1.46,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.54,
      "end_seconds": 358.16,
      "duration_seconds": 3.62,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.01,
      "end_seconds": 359.73,
      "duration_seconds": 0.72,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.42,
      "end_seconds": 392.55,
      "duration_seconds": 24.13,
      "text": "Alright, I've got it. I'm going to order an MRI of the brain, for seizure. It's a routine test and it'll give us a much clearer picture. No driving until we've reviewed you again, I'm sorry, but that's the rule. Never skip the tablets, and set a phone alarm if it helps. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the epilepsy clinic."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.55,
      "end_seconds": 394.99,
      "duration_seconds": 1.44,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.52,
      "end_seconds": 407.36,
      "duration_seconds": 7.84,
      "text": "Keep an eye out, and if you have another seizure lasting more than five minutes, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.96,
      "end_seconds": 409.52,
      "duration_seconds": 1.56,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.85,
      "end_seconds": 421.21,
      "duration_seconds": 10.36,
      "text": "Please come and see me after the results are back. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.8,
      "end_seconds": 427.07,
      "duration_seconds": 5.27,
      "text": "So, uh, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.0,
      "end_seconds": 433.15,
      "duration_seconds": 5.15,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.91,
      "end_seconds": 435.69,
      "duration_seconds": 1.78,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.0,
      "end_seconds": 436.7,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}