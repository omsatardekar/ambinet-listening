{
  "schema_version": "1.0",
  "encounter_id": "00500",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.67,
      "duration_seconds": 4.28,
      "text": "Sorry I'm a few minutes behind, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.99,
      "end_seconds": 10.78,
      "duration_seconds": 4.79,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.15,
      "end_seconds": 16.51,
      "duration_seconds": 4.36,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.03,
      "end_seconds": 20.63,
      "duration_seconds": 2.6,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.08,
      "end_seconds": 28.22,
      "duration_seconds": 7.14,
      "text": "Mainly pain in my right shoulder. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.65,
      "end_seconds": 30.26,
      "duration_seconds": 1.61,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.67,
      "end_seconds": 37.83,
      "duration_seconds": 6.16,
      "text": "It's been like this since Monday. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.15,
      "end_seconds": 40.59,
      "duration_seconds": 2.44,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.34,
      "end_seconds": 67.16,
      "duration_seconds": 23.82,
      "text": "I notice it more with reaching behind. Hmm, I've also had a click in the shoulder. About click in the shoulder, maybe a six out of ten on a bad day. As for pain at night when I lie on it, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.93,
      "end_seconds": 81.91,
      "duration_seconds": 13.98,
      "text": "As for pain at night when I lie on it, I'd give it a six, out of ten. Lying on it definitely sets it off. And trouble lifting my arm as well, since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.82,
      "end_seconds": 84.9,
      "duration_seconds": 2.08,
      "text": "Any neck pain, fever or fall?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.72,
      "end_seconds": 87.43,
      "duration_seconds": 1.71,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.92,
      "end_seconds": 90.83,
      "duration_seconds": 2.91,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.15,
      "end_seconds": 94.41,
      "duration_seconds": 2.26,
      "text": "Well, no, that's all normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.62,
      "end_seconds": 97.51,
      "duration_seconds": 1.89,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.02,
      "end_seconds": 100.41,
      "duration_seconds": 2.39,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.21,
      "end_seconds": 104.71,
      "duration_seconds": 3.5,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.64,
      "end_seconds": 110.95,
      "duration_seconds": 5.31,
      "text": "I take losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.0,
      "end_seconds": 119.58,
      "duration_seconds": 7.58,
      "text": "Okay, so doctor, I think the last prescription for the losartan was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.36,
      "end_seconds": 123.03,
      "duration_seconds": 2.67,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.49,
      "end_seconds": 137.93,
      "duration_seconds": 13.44,
      "text": "Not with me. I'll bring it next time. It's aspirin, 75 milligrams, once a day. I did try to ignore it for a while. I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.07,
      "end_seconds": 141.23,
      "duration_seconds": 2.16,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.41,
      "end_seconds": 146.16,
      "duration_seconds": 3.75,
      "text": "Yes, I had a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.32,
      "end_seconds": 153.83,
      "duration_seconds": 3.51,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.27,
      "end_seconds": 159.38,
      "duration_seconds": 4.11,
      "text": "My mother has migraines. Oh, my father had kidney stones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 162.93,
      "duration_seconds": 2.02,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.41,
      "end_seconds": 167.57,
      "duration_seconds": 3.16,
      "text": "So, yes, eggs. I get stomach cramps."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.17,
      "end_seconds": 172.41,
      "duration_seconds": 3.24,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.57,
      "end_seconds": 181.29,
      "duration_seconds": 7.72,
      "text": "I've had diabetes for five years now. I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 182.81,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.91,
      "end_seconds": 186.78,
      "duration_seconds": 2.87,
      "text": "I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.3,
      "end_seconds": 193.26,
      "duration_seconds": 5.96,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.83,
      "end_seconds": 204.9,
      "duration_seconds": 2.07,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.31,
      "end_seconds": 232.31,
      "duration_seconds": 8.0,
      "text": "Okay: oxygen saturation is 99 percent, BP is 127 over 69. And temperature is 36.8 degrees, respiratory rate 15, heart rate 82."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.64,
      "end_seconds": 234.48,
      "duration_seconds": 1.84,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.3,
      "end_seconds": 237.85,
      "duration_seconds": 2.55,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.72,
      "end_seconds": 243.63,
      "duration_seconds": 2.91,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.65,
      "end_seconds": 246.01,
      "duration_seconds": 1.36,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.87,
      "end_seconds": 265.31,
      "duration_seconds": 5.44,
      "text": "Lifting the arm to the side is painful between sixty and a hundred twenty degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.37,
      "end_seconds": 268.63,
      "duration_seconds": 2.26,
      "text": "Alright, bear with me a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.93,
      "end_seconds": 284.42,
      "duration_seconds": 2.49,
      "text": "Neck movements are full and don't reproduce it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.67,
      "end_seconds": 303.13,
      "duration_seconds": 14.46,
      "text": "All done, thank you, please sit down. Okay, so my impression is this: I think we're dealing with a rotator cuff problem at this stage. It could also be frozen shoulder, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.2,
      "end_seconds": 306.33,
      "duration_seconds": 2.13,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.01,
      "end_seconds": 323.88,
      "duration_seconds": 16.87,
      "text": "I understand the worry. At the moment I'd say it's a rotator cuff problem, and we'll know more once the an ultrasound of the shoulder is back. I'd like to arrange an ultrasound of the shoulder for shoulder pain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.69,
      "end_seconds": 325.89,
      "duration_seconds": 1.2,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.96,
      "end_seconds": 349.74,
      "duration_seconds": 22.78,
      "text": "I'd like to arrange an X-ray of the shoulder for shoulder pain. The result will help us decide whether anything more is needed. Let's use naproxen, 250 milligrams, twice a day after food, for five days. That's for shoulder pain. It's a commonly used medicine and most people tolerate it well. Gentle pendulum exercises, I'll show you a couple, but nothing overhead for a bit."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.78,
      "end_seconds": 366.2,
      "duration_seconds": 15.42,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Don't skip meals, and try to eat smaller portions more often through the day. We'll refer you to physiotherapy."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.54,
      "end_seconds": 368.24,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.62,
      "end_seconds": 376.15,
      "duration_seconds": 6.53,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.16,
      "end_seconds": 381.36,
      "duration_seconds": 1.2,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.76,
      "end_seconds": 388.94,
      "duration_seconds": 7.18,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.64,
      "end_seconds": 391.3,
      "duration_seconds": 1.66,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.47,
      "end_seconds": 399.63,
      "duration_seconds": 7.16,
      "text": "I'd like to see you again in three weeks. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.18,
      "end_seconds": 403.34,
      "duration_seconds": 3.16,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.85,
      "end_seconds": 405.6,
      "duration_seconds": 0.75,
      "text": "Alright, goodbye."
    }
  ]
}