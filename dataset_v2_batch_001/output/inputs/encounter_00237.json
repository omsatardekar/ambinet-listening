{
  "schema_version": "1.0",
  "encounter_id": "00237",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.79,
      "duration_seconds": 3.93,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 8.43,
      "duration_seconds": 2.99,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.96,
      "end_seconds": 13.11,
      "duration_seconds": 4.15,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 23.47,
      "duration_seconds": 9.1,
      "text": "Honestly, it's blood in my urine, and my family pushed me to come. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.18,
      "end_seconds": 26.19,
      "duration_seconds": 2.01,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.39,
      "end_seconds": 30.06,
      "duration_seconds": 2.67,
      "text": "It's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.69,
      "end_seconds": 34.29,
      "duration_seconds": 3.6,
      "text": "Has there been it was red twice this week too?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.33,
      "end_seconds": 37.76,
      "duration_seconds": 2.43,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.78,
      "end_seconds": 42.44,
      "duration_seconds": 3.66,
      "text": "Alright, I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.03,
      "end_seconds": 46.21,
      "duration_seconds": 2.18,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.0,
      "end_seconds": 51.78,
      "duration_seconds": 4.78,
      "text": "Let me check a few things. Any difficulty passing urine or pain on passing urine?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.84,
      "end_seconds": 55.12,
      "duration_seconds": 2.28,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.42,
      "end_seconds": 58.43,
      "duration_seconds": 2.01,
      "text": "And recent injury, any of that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.67,
      "end_seconds": 62.03,
      "duration_seconds": 2.36,
      "text": "Not at all, no recent injury."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.22,
      "end_seconds": 66.14,
      "duration_seconds": 2.92,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.62,
      "end_seconds": 70.32,
      "duration_seconds": 2.7,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.99,
      "end_seconds": 82.59,
      "duration_seconds": 11.6,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.68,
      "end_seconds": 85.25,
      "duration_seconds": 1.57,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.65,
      "end_seconds": 87.83,
      "duration_seconds": 2.18,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.57,
      "end_seconds": 89.99,
      "duration_seconds": 1.42,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.32,
      "end_seconds": 93.53,
      "duration_seconds": 2.21,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.66,
      "end_seconds": 99.14,
      "duration_seconds": 4.48,
      "text": "Telmisartan. I take it 40 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.73,
      "end_seconds": 104.17,
      "duration_seconds": 3.44,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.72,
      "end_seconds": 107.99,
      "duration_seconds": 3.27,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.52,
      "end_seconds": 112.32,
      "duration_seconds": 3.8,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.31,
      "end_seconds": 124.79,
      "duration_seconds": 11.48,
      "text": "Well, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.76,
      "end_seconds": 130.29,
      "duration_seconds": 4.53,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 133.92,
      "duration_seconds": 2.1,
      "text": "Yes, codeine. I get vomiting."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.92,
      "end_seconds": 142.3,
      "duration_seconds": 4.38,
      "text": "Okay, have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.28,
      "end_seconds": 154.71,
      "duration_seconds": 11.43,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.15,
      "end_seconds": 162.22,
      "duration_seconds": 6.07,
      "text": "Moving on to your background, any past medical history? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.53,
      "end_seconds": 166.28,
      "duration_seconds": 2.75,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.07,
      "end_seconds": 181.88,
      "duration_seconds": 14.81,
      "text": "Alright. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.56,
      "end_seconds": 184.44,
      "duration_seconds": 1.88,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.73,
      "end_seconds": 187.71,
      "duration_seconds": 1.98,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.78,
      "end_seconds": 200.33,
      "duration_seconds": 1.55,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.42,
      "end_seconds": 224.87,
      "duration_seconds": 7.45,
      "text": "Okay: pulse 80, temperature is 36.7 degrees, SpO2 98 percent on room air. And blood pressure 125 over 69."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.93,
      "end_seconds": 230.02,
      "duration_seconds": 3.09,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.94,
      "end_seconds": 233.81,
      "duration_seconds": 1.87,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.03,
      "end_seconds": 250.51,
      "duration_seconds": 4.48,
      "text": "Abdomen is soft, no masses, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.65,
      "end_seconds": 252.35,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.2,
      "end_seconds": 258.6,
      "duration_seconds": 2.4,
      "text": "Right, that's fine, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.83,
      "end_seconds": 262.86,
      "duration_seconds": 3.03,
      "text": "So, I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.55,
      "end_seconds": 264.32,
      "duration_seconds": 0.77,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.55,
      "end_seconds": 291.07,
      "duration_seconds": 13.52,
      "text": "Alright, I've got it. Putting it all together, my working impression is blood in the urine that needs full investigation. The reason I say that is that your story and my examination fit together. A urine infection is also on my list."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.86,
      "end_seconds": 293.98,
      "duration_seconds": 2.12,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.47,
      "end_seconds": 313.49,
      "duration_seconds": 19.02,
      "text": "I understand the worry. At the moment I'd say it's blood in the urine that needs full investigation, and we'll know more once the a cystoscopy is back. Let me just recap so I've got it right. You've had blood in your urine for two months, and no difficulty passing urine or pain on passing urine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.32,
      "end_seconds": 315.62,
      "duration_seconds": 1.3,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.16,
      "end_seconds": 319.64,
      "duration_seconds": 3.48,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.36,
      "end_seconds": 321.26,
      "duration_seconds": 0.9,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.11,
      "end_seconds": 357.17,
      "duration_seconds": 25.06,
      "text": "Okay, here we go. We should do a cystoscopy for haematuria. Keep drinking plenty of water, and let us know quickly if you pass clots or can't pass urine. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Cut down on salt and fried food for now, it really does make a difference. I'd like you to see the urology clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.02,
      "end_seconds": 359.47,
      "duration_seconds": 1.45,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.57,
      "end_seconds": 368.53,
      "duration_seconds": 7.96,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.09,
      "end_seconds": 371.49,
      "duration_seconds": 1.4,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.95,
      "end_seconds": 380.05,
      "duration_seconds": 8.1,
      "text": "Keep an eye out, and if you can't pass urine or pass large clots, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.67,
      "end_seconds": 384.97,
      "duration_seconds": 1.3,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.82,
      "end_seconds": 388.03,
      "duration_seconds": 2.21,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.48,
      "end_seconds": 391.18,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.55,
      "end_seconds": 398.86,
      "duration_seconds": 6.31,
      "text": "Alright, I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.53,
      "end_seconds": 404.62,
      "duration_seconds": 5.09,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.83,
      "end_seconds": 411.05,
      "duration_seconds": 5.22,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.22,
      "end_seconds": 414.65,
      "duration_seconds": 2.43,
      "text": "Thank you. I'll see you then."
    }
  ]
}