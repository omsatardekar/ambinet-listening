{
  "schema_version": "1.0",
  "encounter_id": "00155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 2.5,
      "duration_seconds": 1.38,
      "text": "Hello there. Please, sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.87,
      "end_seconds": 4.57,
      "duration_seconds": 0.7,
      "text": "Morning."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.56,
      "end_seconds": 10.61,
      "duration_seconds": 5.05,
      "text": "Oh, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.46,
      "end_seconds": 15.63,
      "duration_seconds": 4.17,
      "text": "Please do. Extra information is always welcome. How can I help you today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.98,
      "end_seconds": 23.34,
      "duration_seconds": 6.36,
      "text": "It's a throbbing headache on one side, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.81,
      "end_seconds": 26.69,
      "duration_seconds": 2.88,
      "text": "Okay, how long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.3,
      "end_seconds": 32.92,
      "duration_seconds": 5.62,
      "text": "Ever since... since this morning, really. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.8,
      "end_seconds": 36.12,
      "duration_seconds": 2.32,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.33,
      "end_seconds": 49.7,
      "duration_seconds": 12.37,
      "text": "I'd say severe. And sensitivity to light, too. With sensitivity to light, maybe a three out of ten on a bad day. And flashing lights before it starts as well, since Monday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.73,
      "end_seconds": 53.06,
      "duration_seconds": 2.33,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.05,
      "end_seconds": 57.55,
      "duration_seconds": 3.5,
      "text": "Mild, I'd say. I've also had nausea, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.29,
      "end_seconds": 61.86,
      "duration_seconds": 3.57,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.51,
      "end_seconds": 63.39,
      "duration_seconds": 0.88,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 81.37,
      "duration_seconds": 5.03,
      "text": "Right, thanks for waiting. Any double vision or weakness in the arms or legs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.7,
      "end_seconds": 84.44,
      "duration_seconds": 2.74,
      "text": "I mean, no, none of those."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.88,
      "end_seconds": 90.01,
      "duration_seconds": 5.13,
      "text": "Let me check a few things. Any loss of consciousness, slurred speech or neck stiffness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.1,
      "end_seconds": 93.26,
      "duration_seconds": 2.16,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.78,
      "end_seconds": 96.36,
      "duration_seconds": 1.58,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.59,
      "end_seconds": 98.8,
      "duration_seconds": 1.21,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.45,
      "end_seconds": 102.04,
      "duration_seconds": 2.59,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.83,
      "end_seconds": 104.51,
      "duration_seconds": 1.68,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.09,
      "end_seconds": 108.39,
      "duration_seconds": 2.3,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.26,
      "end_seconds": 111.53,
      "duration_seconds": 2.27,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.59,
      "end_seconds": 116.72,
      "duration_seconds": 4.13,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 126.11,
      "duration_seconds": 8.18,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.48,
      "end_seconds": 133.98,
      "duration_seconds": 7.5,
      "text": "So, any medication at the moment, including things from the pharmacy? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.85,
      "end_seconds": 142.65,
      "duration_seconds": 7.8,
      "text": "I'm on escitalopram, 10 milligrams, once a day for the anxiety. Sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.93,
      "end_seconds": 151.24,
      "duration_seconds": 7.31,
      "text": "Right, do you have any medical conditions, anything you've been treated for? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.66,
      "end_seconds": 159.8,
      "duration_seconds": 8.14,
      "text": "I have anxiety, for five years. I kept putting it off, which I know isn't sensible. I've got migraines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.26,
      "end_seconds": 166.56,
      "duration_seconds": 5.3,
      "text": "Okay, migraines, that's already on your record. Good to know. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.6,
      "end_seconds": 170.08,
      "duration_seconds": 2.48,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.32,
      "end_seconds": 188.28,
      "duration_seconds": 16.96,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.77,
      "end_seconds": 191.21,
      "duration_seconds": 2.44,
      "text": "Okay, um, that makes sense."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.22,
      "end_seconds": 196.72,
      "duration_seconds": 1.5,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.05,
      "end_seconds": 200.29,
      "duration_seconds": 3.24,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.63,
      "end_seconds": 201.78,
      "duration_seconds": 1.15,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.92,
      "end_seconds": 205.68,
      "duration_seconds": 2.76,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 209.22,
      "duration_seconds": 2.86,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.87,
      "end_seconds": 220.59,
      "duration_seconds": 1.72,
      "text": "Right, just relax your arm..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.22,
      "end_seconds": 239.62,
      "duration_seconds": 5.4,
      "text": "Okay: blood pressure 117 over 68, temperature 36.4, pulse 76. And saturation 99 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.16,
      "end_seconds": 241.44,
      "duration_seconds": 1.28,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.89,
      "end_seconds": 244.9,
      "duration_seconds": 3.01,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.63,
      "end_seconds": 248.55,
      "duration_seconds": 1.92,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 251.98,
      "duration_seconds": 2.35,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.28,
      "end_seconds": 270.65,
      "duration_seconds": 2.37,
      "text": "Power in all four limbs is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.19,
      "end_seconds": 273.58,
      "duration_seconds": 1.39,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.22,
      "end_seconds": 284.76,
      "duration_seconds": 2.54,
      "text": "Neck is supple, no stiffness at all."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.55,
      "end_seconds": 311.71,
      "duration_seconds": 21.16,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.49,
      "end_seconds": 314.41,
      "duration_seconds": 1.92,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.79,
      "end_seconds": 323.49,
      "duration_seconds": 8.7,
      "text": "Okay, so my impression is this: I think we're dealing with a migraine pattern at this stage. I'd also keep tension-type headache in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.87,
      "end_seconds": 328.71,
      "duration_seconds": 2.84,
      "text": "Doctor, you know, is this dangerous?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.13,
      "end_seconds": 349.33,
      "duration_seconds": 20.2,
      "text": "I understand the worry. At the moment I'd say it's a migraine pattern, and we'll know more once the an MRI of the brain is back. Let me just recap so I've got it right. You've had a throbbing headache on one side, since this morning, severe, and no slurred speech or double vision."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.85,
      "end_seconds": 351.07,
      "duration_seconds": 1.22,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.42,
      "end_seconds": 356.83,
      "duration_seconds": 4.41,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.2,
      "end_seconds": 368.95,
      "duration_seconds": 10.75,
      "text": "Yes, um, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.93,
      "end_seconds": 391.97,
      "duration_seconds": 22.04,
      "text": "Let's get an MRI of the brain, for recurrent headaches. I'll start you on propranolol, 20 milligrams, twice a day, for three months. You take it by mouth. It's for migraine prevention. It's a commonly used medicine and most people tolerate it well. I'll start you on domperidone, 10 milligrams, when nauseous, as needed. That's for migraine nausea."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.87,
      "end_seconds": 394.51,
      "duration_seconds": 1.64,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.41,
      "end_seconds": 425.35,
      "duration_seconds": 29.94,
      "text": "Keep a headache diary, things like skipped meals, poor sleep, certain foods and the weather. Try not to skip meals and keep your sleep regular. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I want you to come back or go to emergency straight away if you have the worst headache of your life or any weakness. Let's review you in a month."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 426.05,
      "end_seconds": 426.75,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 427.77,
      "end_seconds": 434.66,
      "duration_seconds": 6.89,
      "text": "Okay, just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 436.12,
      "end_seconds": 446.94,
      "duration_seconds": 10.82,
      "text": "So, you know, I take the propranolol, 20 milligrams, twice a day and take the domperidone, 10 milligrams, when nauseous. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.51,
      "end_seconds": 452.25,
      "duration_seconds": 3.74,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 452.73,
      "end_seconds": 455.76,
      "duration_seconds": 3.03,
      "text": "Oh, thank you. I'll see you then."
    }
  ]
}