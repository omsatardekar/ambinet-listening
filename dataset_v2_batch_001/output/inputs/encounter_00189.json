{
  "schema_version": "1.0",
  "encounter_id": "00189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 5.08,
      "duration_seconds": 3.8,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 9.54,
      "duration_seconds": 3.36,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.91,
      "end_seconds": 16.35,
      "duration_seconds": 6.44,
      "text": "Doctor, it's a dry cough that won't go away. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 21.69,
      "duration_seconds": 4.06,
      "text": "And when did that start? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.94,
      "end_seconds": 24.58,
      "duration_seconds": 1.64,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.07,
      "end_seconds": 30.59,
      "duration_seconds": 4.52,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.05,
      "end_seconds": 54.52,
      "duration_seconds": 23.47,
      "text": "It's mild, honestly. I notice it more with lying down and after meals. And I've been clearing my throat all the time as well. With clearing my throat all the time, maybe a three out of ten on a bad day. I did have a burning in the chest after meals at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.97,
      "end_seconds": 59.81,
      "duration_seconds": 3.84,
      "text": "Have you had any shortness of breath, night sweats or wheezing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.23,
      "end_seconds": 65.46,
      "duration_seconds": 4.23,
      "text": "No shortness of breath, night sweats or wheezing, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.88,
      "end_seconds": 69.94,
      "duration_seconds": 4.06,
      "text": "Okay, I'm following. Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.3,
      "end_seconds": 82.18,
      "duration_seconds": 11.88,
      "text": "I've had high blood pressure for nearly five years now. It's the not knowing that gets to me. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.97,
      "end_seconds": 84.25,
      "duration_seconds": 1.28,
      "text": "Alright. Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.85,
      "end_seconds": 87.86,
      "duration_seconds": 3.01,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 96.71,
      "duration_seconds": 4.63,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.77,
      "end_seconds": 100.73,
      "duration_seconds": 2.96,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 102.71,
      "duration_seconds": 0.93,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.15,
      "end_seconds": 105.87,
      "duration_seconds": 1.72,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.59,
      "end_seconds": 110.0,
      "duration_seconds": 3.41,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.69,
      "end_seconds": 112.8,
      "duration_seconds": 2.11,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.22,
      "end_seconds": 115.49,
      "duration_seconds": 2.27,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.96,
      "end_seconds": 118.74,
      "duration_seconds": 2.78,
      "text": "I'm on losartan, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.77,
      "end_seconds": 121.55,
      "duration_seconds": 1.78,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.94,
      "end_seconds": 122.73,
      "duration_seconds": 0.79,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.24,
      "end_seconds": 126.37,
      "duration_seconds": 3.13,
      "text": "Right, how long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.42,
      "end_seconds": 130.4,
      "duration_seconds": 2.98,
      "text": "About two months. It's Digene, after meals."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.66,
      "end_seconds": 133.84,
      "duration_seconds": 2.18,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.97,
      "end_seconds": 136.14,
      "duration_seconds": 1.17,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.24,
      "end_seconds": 140.76,
      "duration_seconds": 3.52,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.12,
      "end_seconds": 144.79,
      "duration_seconds": 2.67,
      "text": "My father had a heart attack."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.53,
      "end_seconds": 148.82,
      "duration_seconds": 3.29,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 163.7,
      "duration_seconds": 1.69,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.82,
      "end_seconds": 189.63,
      "duration_seconds": 6.81,
      "text": "Okay: BP is 108 over 75, temperature 36.9, heart rate 84. And saturation 98 percent, respiratory rate 17."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.59,
      "end_seconds": 192.89,
      "duration_seconds": 2.3,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.73,
      "end_seconds": 196.87,
      "duration_seconds": 3.14,
      "text": "Of course, you know, take your time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.93,
      "end_seconds": 209.48,
      "duration_seconds": 1.55,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.06,
      "end_seconds": 215.63,
      "duration_seconds": 3.57,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.63,
      "end_seconds": 217.48,
      "duration_seconds": 0.85,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.83,
      "end_seconds": 221.3,
      "duration_seconds": 2.47,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.42,
      "end_seconds": 236.12,
      "duration_seconds": 4.7,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.69,
      "end_seconds": 238.93,
      "duration_seconds": 1.24,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.05,
      "end_seconds": 265.27,
      "duration_seconds": 24.22,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.66,
      "end_seconds": 268.51,
      "duration_seconds": 1.85,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 291.79,
      "duration_seconds": 22.55,
      "text": "From what you've told me and what I found, I think we're dealing with a cough driven by acid reflux at this stage. It could also be post-nasal drip, so we'll keep that open. Let me just recap so I've got it right. You've had a dry cough that won't go away for two months, mild, and no wheezing or shortness of breath."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.68,
      "end_seconds": 296.93,
      "duration_seconds": 1.25,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.19,
      "end_seconds": 304.9,
      "duration_seconds": 6.71,
      "text": "I'd like to arrange a chest X-ray for chronic cough. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 305.98,
      "end_seconds": 308.67,
      "duration_seconds": 2.69,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.04,
      "end_seconds": 329.98,
      "duration_seconds": 19.94,
      "text": "I'll start you on pantoprazole, 40 milligrams, before breakfast, for four weeks. You take it by mouth. It's for reflux. The pharmacy will go through the details again when you pick it up. Don't eat for two or three hours before lying down, and raise the head of the bed a little."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.54,
      "end_seconds": 344.62,
      "duration_seconds": 14.08,
      "text": "Alright. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.92,
      "end_seconds": 346.48,
      "duration_seconds": 1.56,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.94,
      "end_seconds": 354.86,
      "duration_seconds": 6.92,
      "text": "Come back in four weeks. I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.58,
      "end_seconds": 363.35,
      "duration_seconds": 7.77,
      "text": "So, I take the pantoprazole, 40 milligrams, before breakfast and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.52,
      "end_seconds": 371.26,
      "duration_seconds": 4.74,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.6,
      "end_seconds": 374.15,
      "duration_seconds": 2.55,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.99,
      "end_seconds": 375.99,
      "duration_seconds": 1.0,
      "text": "See you then."
    }
  ]
}