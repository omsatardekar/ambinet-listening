{
  "schema_version": "1.0",
  "encounter_id": "00363",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 5.38,
      "duration_seconds": 4.4,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 8.59,
      "duration_seconds": 2.79,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.23,
      "end_seconds": 11.85,
      "duration_seconds": 2.62,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.15,
      "end_seconds": 15.17,
      "duration_seconds": 3.02,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 16.07,
      "end_seconds": 26.61,
      "duration_seconds": 10.54,
      "text": "I've, I've been dealing with a high fever. I'd rather know what's going on than keep guessing. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 29.59,
      "duration_seconds": 2.34,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.42,
      "end_seconds": 32.89,
      "duration_seconds": 2.47,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.76,
      "end_seconds": 36.52,
      "duration_seconds": 2.76,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.02,
      "end_seconds": 38.32,
      "duration_seconds": 1.3,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.46,
      "end_seconds": 42.19,
      "duration_seconds": 2.73,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.64,
      "end_seconds": 47.91,
      "duration_seconds": 4.27,
      "text": "Severe body pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.52,
      "end_seconds": 53.81,
      "duration_seconds": 5.29,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 53.91,
      "end_seconds": 57.94,
      "duration_seconds": 4.03,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.27,
      "end_seconds": 66.6,
      "duration_seconds": 7.33,
      "text": "I was getting to that! Uh, the severe body pain? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.96,
      "end_seconds": 68.73,
      "duration_seconds": 1.77,
      "text": "And cough, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.13,
      "end_seconds": 71.68,
      "duration_seconds": 2.55,
      "text": "No, I haven't had any cough."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.17,
      "end_seconds": 76.93,
      "duration_seconds": 4.76,
      "text": "Hmm, actually, doctor, I did notice cough. She doesn't always say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.29,
      "end_seconds": 83.92,
      "duration_seconds": 5.63,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.87,
      "end_seconds": 91.59,
      "duration_seconds": 6.72,
      "text": "Alright, I'll note both what you've said and what you've noticed. Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.47,
      "end_seconds": 96.02,
      "duration_seconds": 3.55,
      "text": "No, I haven't had any blood in the stool."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.77,
      "end_seconds": 100.67,
      "duration_seconds": 3.9,
      "text": "Any abdominal pain, breathlessness, bleeding from the gums or vomiting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.99,
      "end_seconds": 112.0,
      "duration_seconds": 11.01,
      "text": "No, no abdominal pain, no breathlessness, no bleeding from the gums. I did have pain behind my eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.49,
      "end_seconds": 115.51,
      "duration_seconds": 3.02,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.76,
      "end_seconds": 118.23,
      "duration_seconds": 1.47,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.64,
      "end_seconds": 121.98,
      "duration_seconds": 3.34,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.9,
      "end_seconds": 136.68,
      "duration_seconds": 13.78,
      "text": "So, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 137.89,
      "end_seconds": 146.48,
      "duration_seconds": 8.59,
      "text": "Doctor, I've got the readings for you. BP is 122 over 73, oxygen saturation is 97 percent, pulse is 90 beats a minute. Temp 38.6 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.45,
      "end_seconds": 155.96,
      "duration_seconds": 6.51,
      "text": "Okay, noted. Let's go through your medication. What are you taking? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.45,
      "end_seconds": 162.99,
      "duration_seconds": 6.54,
      "text": "It's glimepiride, 2 milligrams, before breakfast. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.6,
      "end_seconds": 166.11,
      "duration_seconds": 2.51,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.53,
      "end_seconds": 172.57,
      "duration_seconds": 5.04,
      "text": "About a month now. I'm on ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 173.38,
      "end_seconds": 177.62,
      "duration_seconds": 4.24,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 181.57,
      "duration_seconds": 2.81,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.49,
      "end_seconds": 190.01,
      "duration_seconds": 7.52,
      "text": "Well, not with me. I'll bring it next time. So, uh, I take Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.14,
      "end_seconds": 197.84,
      "duration_seconds": 6.7,
      "text": "Uh, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.78,
      "end_seconds": 201.04,
      "duration_seconds": 2.26,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.95,
      "end_seconds": 215.67,
      "duration_seconds": 13.72,
      "text": "Yeah, for the seizures, I believe. My son sets them out for me, I just take what I'm given. Yeah, I'd been on amlodipine, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 218.05,
      "duration_seconds": 1.89,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.92,
      "end_seconds": 222.85,
      "duration_seconds": 3.93,
      "text": "My sister has epilepsy. My father had a heart attack."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.48,
      "end_seconds": 225.01,
      "duration_seconds": 1.53,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.47,
      "end_seconds": 228.37,
      "duration_seconds": 1.9,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.79,
      "end_seconds": 230.53,
      "duration_seconds": 0.74,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.67,
      "end_seconds": 234.33,
      "duration_seconds": 2.66,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.29,
      "end_seconds": 239.14,
      "duration_seconds": 3.85,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.81,
      "end_seconds": 240.53,
      "duration_seconds": 0.72,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.06,
      "end_seconds": 249.74,
      "duration_seconds": 6.68,
      "text": "What about your general health, any conditions you're being treated for? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.56,
      "end_seconds": 275.37,
      "duration_seconds": 24.81,
      "text": "Oh, I have diabetes, for about a year. I kept putting it off, which I know isn't sensible. I have high blood pressure, for five years. I've had asthma for about a year now. I'm hoping you can tell me something definite. I'd rather not end up on lots of tablets if I can avoid it. I've had epilepsy for five years now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.1,
      "end_seconds": 290.93,
      "duration_seconds": 10.83,
      "text": "Right, yes, I can see the high blood pressure in your file as well. Yes, I can see the asthma in your file as well. So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.43,
      "end_seconds": 297.8,
      "duration_seconds": 6.37,
      "text": "I had my gallbladder removed in 2016. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.68,
      "end_seconds": 304.36,
      "duration_seconds": 3.68,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.91,
      "end_seconds": 308.61,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.48,
      "end_seconds": 313.09,
      "duration_seconds": 2.61,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.62,
      "end_seconds": 330.66,
      "duration_seconds": 4.04,
      "text": "There's a faint rash on your forearms, it blanches when I press."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.62,
      "end_seconds": 334.97,
      "duration_seconds": 2.35,
      "text": "Okay, can you lie back for me?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.78,
      "end_seconds": 358.89,
      "duration_seconds": 5.11,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.45,
      "end_seconds": 362.3,
      "duration_seconds": 1.85,
      "text": "Yes, uh, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.19,
      "end_seconds": 367.65,
      "duration_seconds": 2.46,
      "text": "All done, thank you, please sit down."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.35,
      "end_seconds": 371.33,
      "duration_seconds": 2.98,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 372.12,
      "end_seconds": 372.84,
      "duration_seconds": 0.72,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.61,
      "end_seconds": 409.12,
      "duration_seconds": 23.51,
      "text": "Alright, I've got it. Okay, so my impression is this: This looks most like a viral fever, possibly dengue. That's my thinking for now, and it may change as we learn more. I can't rule out malaria yet. I can't rule out typhoid fever yet. Let me just recap so I've got it right. You've had a high fever for about four days, severe, and no vomiting."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.61,
      "end_seconds": 411.28,
      "duration_seconds": 1.67,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.46,
      "end_seconds": 435.6,
      "duration_seconds": 23.14,
      "text": "I'm going to order a malaria test, for fever. The result will help us decide whether anything more is needed. I'm going to order a full blood count, for platelet count. That will help us see what's going on underneath and decide the next step. I'm going to order a dengue test, for fever. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.96,
      "end_seconds": 440.34,
      "duration_seconds": 3.38,
      "text": "Yeah, sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.61,
      "end_seconds": 463.52,
      "duration_seconds": 21.91,
      "text": "I'm prescribing paracetamol, 500 milligrams, every six hours if needed, for three days. That's for fever and body aches. Drink a lot, coconut water, ORS, whatever you can manage. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.42,
      "end_seconds": 471.94,
      "duration_seconds": 7.52,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 472.46,
      "end_seconds": 473.69,
      "duration_seconds": 1.23,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.12,
      "end_seconds": 489.83,
      "duration_seconds": 11.71,
      "text": "Keep an eye out, and if you notice any bleeding or you can't keep fluids down, call us the same day or go to emergency. Please come and see me in two days."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 493.02,
      "end_seconds": 497.63,
      "duration_seconds": 4.61,
      "text": "Sure, uh, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 498.84,
      "end_seconds": 501.55,
      "duration_seconds": 2.71,
      "text": "Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 501.98,
      "end_seconds": 503.62,
      "duration_seconds": 1.64,
      "text": "Thanks so much, doctor."
    }
  ]
}