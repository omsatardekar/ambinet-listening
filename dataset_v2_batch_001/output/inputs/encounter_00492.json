{
  "schema_version": "1.0",
  "encounter_id": "00492",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.63,
      "end_seconds": 4.71,
      "duration_seconds": 4.08,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.09,
      "end_seconds": 9.4,
      "duration_seconds": 4.31,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.47,
      "end_seconds": 18.86,
      "duration_seconds": 8.39,
      "text": "I'm here because of exhaustion since I had the flu. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.38,
      "end_seconds": 22.32,
      "duration_seconds": 2.94,
      "text": "Alright. Right, is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.05,
      "end_seconds": 25.39,
      "duration_seconds": 2.34,
      "text": "Walking far definitely sets it off."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.88,
      "end_seconds": 28.94,
      "duration_seconds": 2.06,
      "text": "Has there been aching legs too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.59,
      "end_seconds": 33.12,
      "duration_seconds": 3.53,
      "text": "Yeah, I've had that since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.95,
      "end_seconds": 51.09,
      "duration_seconds": 14.14,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.86,
      "end_seconds": 57.61,
      "duration_seconds": 5.75,
      "text": "Hmm, uh, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.34,
      "end_seconds": 61.85,
      "duration_seconds": 3.51,
      "text": "Any fever, swollen legs or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.09,
      "end_seconds": 67.6,
      "duration_seconds": 4.51,
      "text": "No fever, swollen legs or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.27,
      "end_seconds": 72.16,
      "duration_seconds": 3.89,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 79.47,
      "duration_seconds": 6.75,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 80.43,
      "end_seconds": 90.64,
      "duration_seconds": 10.21,
      "text": "Doctor, I've got the readings for you. Pressure 110 over 79, SpO2 97 percent on room air, temp 36.6 degrees, respiratory rate 16, heart rate 73."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.02,
      "end_seconds": 93.54,
      "duration_seconds": 1.52,
      "text": "Right, good, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.7,
      "end_seconds": 97.37,
      "duration_seconds": 2.67,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.23,
      "end_seconds": 99.07,
      "duration_seconds": 0.84,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 112.54,
      "duration_seconds": 2.91,
      "text": "Right, thanks for waiting. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.11,
      "end_seconds": 117.33,
      "duration_seconds": 3.22,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.03,
      "end_seconds": 120.85,
      "duration_seconds": 2.82,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 138.87,
      "duration_seconds": 17.14,
      "text": "Oh, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.15,
      "end_seconds": 142.17,
      "duration_seconds": 2.02,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.81,
      "end_seconds": 143.59,
      "duration_seconds": 0.78,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.85,
      "end_seconds": 158.77,
      "duration_seconds": 13.92,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.28,
      "end_seconds": 163.13,
      "duration_seconds": 2.85,
      "text": "Okay, uh, that makes sense."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.65,
      "end_seconds": 170.03,
      "duration_seconds": 6.38,
      "text": "Do you have any medical conditions, anything you've been treated for? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.33,
      "end_seconds": 178.35,
      "duration_seconds": 8.02,
      "text": "I've got asthma. I've never really been one for hospitals. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.5,
      "end_seconds": 182.0,
      "duration_seconds": 2.5,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.59,
      "end_seconds": 184.78,
      "duration_seconds": 2.19,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.71,
      "end_seconds": 200.53,
      "duration_seconds": 2.82,
      "text": "Alright, I've got it. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.7,
      "end_seconds": 205.23,
      "duration_seconds": 3.53,
      "text": "I had a hysterectomy about twelve years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.83,
      "end_seconds": 210.71,
      "duration_seconds": 3.88,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.09,
      "end_seconds": 214.7,
      "duration_seconds": 2.61,
      "text": "So, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.13,
      "end_seconds": 218.27,
      "duration_seconds": 2.14,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.6,
      "end_seconds": 222.54,
      "duration_seconds": 3.94,
      "text": "I mean, I'm on Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.55,
      "end_seconds": 226.06,
      "duration_seconds": 2.51,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.63,
      "end_seconds": 227.95,
      "duration_seconds": 1.32,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.54,
      "end_seconds": 232.19,
      "duration_seconds": 3.65,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.67,
      "end_seconds": 236.42,
      "duration_seconds": 2.75,
      "text": "Right, thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 241.35,
      "duration_seconds": 3.64,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 242.45,
      "end_seconds": 244.7,
      "duration_seconds": 2.25,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.46,
      "end_seconds": 248.52,
      "duration_seconds": 3.06,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.79,
      "end_seconds": 262.35,
      "duration_seconds": 12.56,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.7,
      "end_seconds": 265.37,
      "duration_seconds": 1.67,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.66,
      "end_seconds": 267.36,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.84,
      "end_seconds": 270.97,
      "duration_seconds": 2.13,
      "text": "So, look straight ahead for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.21,
      "end_seconds": 280.84,
      "duration_seconds": 1.63,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.28,
      "end_seconds": 292.24,
      "duration_seconds": 5.96,
      "text": "Okay, you can sit back up. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.65,
      "end_seconds": 307.15,
      "duration_seconds": 13.5,
      "text": "Yes, um, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.91,
      "end_seconds": 315.32,
      "duration_seconds": 7.41,
      "text": "From what you've told me and what I found, my working impression is post-viral fatigue. I can't rule out a thyroid problem yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.9,
      "end_seconds": 318.54,
      "duration_seconds": 2.64,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.62,
      "end_seconds": 333.92,
      "duration_seconds": 14.3,
      "text": "I understand the worry. At the moment I'd say it's post-viral fatigue, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've had exhaustion since you had the flu, and no fever or swollen legs."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 335.16,
      "end_seconds": 338.21,
      "duration_seconds": 3.05,
      "text": "Yes, you know, you've got it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.52,
      "end_seconds": 340.74,
      "duration_seconds": 2.22,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 341.34,
      "end_seconds": 344.27,
      "duration_seconds": 2.93,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.72,
      "end_seconds": 363.43,
      "duration_seconds": 18.71,
      "text": "Let's get blood tests, for fatigue. Pace yourself, a little more activity each day but stop before you're wiped out. Cut down on salt and fried food for now, it really does make a difference. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.73,
      "end_seconds": 367.58,
      "duration_seconds": 2.85,
      "text": "Yes, you know, I'll do that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.35,
      "end_seconds": 370.14,
      "duration_seconds": 1.79,
      "text": "Come back in a month."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.0,
      "end_seconds": 374.7,
      "duration_seconds": 3.7,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.98,
      "end_seconds": 381.43,
      "duration_seconds": 5.45,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 382.83,
      "end_seconds": 386.93,
      "duration_seconds": 4.1,
      "text": "So, I come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.87,
      "end_seconds": 393.04,
      "duration_seconds": 5.17,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.64,
      "end_seconds": 396.46,
      "duration_seconds": 2.82,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.94,
      "end_seconds": 400.39,
      "duration_seconds": 2.45,
      "text": "Bye for now, look after yourself."
    }
  ]
}