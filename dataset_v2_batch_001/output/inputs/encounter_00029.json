{
  "schema_version": "1.0",
  "encounter_id": "00029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 3.58,
      "duration_seconds": 2.29,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.85,
      "end_seconds": 12.85,
      "duration_seconds": 5.0,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.45,
      "end_seconds": 21.62,
      "duration_seconds": 7.17,
      "text": "Of course, please stay. It's helpful to have you here. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.26,
      "end_seconds": 27.99,
      "duration_seconds": 5.73,
      "text": "Hmm, I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.56,
      "end_seconds": 30.76,
      "duration_seconds": 2.2,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.35,
      "end_seconds": 35.68,
      "duration_seconds": 4.33,
      "text": "She's been having a dry cough that won't go away, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.67,
      "end_seconds": 38.93,
      "duration_seconds": 2.26,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.87,
      "end_seconds": 42.02,
      "duration_seconds": 2.15,
      "text": "Probably nearly five years. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.51,
      "end_seconds": 49.75,
      "duration_seconds": 6.24,
      "text": "Okay, give me more detail on it, whatever comes to mind. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.15,
      "end_seconds": 68.43,
      "duration_seconds": 18.28,
      "text": "It settles a little with sipping water. Severe, I'd say. Honestly, a couple of times a week. I didn't want to make a fuss, you know. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 75.47,
      "duration_seconds": 2.95,
      "text": "Have you had a hoarse voice in the mornings?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 84.38,
      "duration_seconds": 7.53,
      "text": "Yes, um, actually. And I've been clearing my throat all the time as well, for six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.01,
      "end_seconds": 88.02,
      "duration_seconds": 3.01,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.0,
      "end_seconds": 95.03,
      "duration_seconds": 6.03,
      "text": "About a five out of ten. And a sour taste in the mouth, too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.69,
      "end_seconds": 99.18,
      "duration_seconds": 3.49,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.69,
      "end_seconds": 102.82,
      "duration_seconds": 2.13,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.22,
      "end_seconds": 109.36,
      "duration_seconds": 5.14,
      "text": "Let me check a few things. Any night sweats, trouble swallowing or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.49,
      "end_seconds": 115.38,
      "duration_seconds": 4.89,
      "text": "I haven't had night sweats, trouble swallowing or weight loss, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.88,
      "end_seconds": 119.36,
      "duration_seconds": 3.48,
      "text": "Any coughing up blood, shortness of breath or wheezing?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.94,
      "end_seconds": 124.85,
      "duration_seconds": 3.91,
      "text": "No, um, none of that at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.86,
      "end_seconds": 127.62,
      "duration_seconds": 1.76,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.51,
      "end_seconds": 130.33,
      "duration_seconds": 1.82,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.42,
      "end_seconds": 133.83,
      "duration_seconds": 2.41,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.21,
      "end_seconds": 136.96,
      "duration_seconds": 2.75,
      "text": "Okay, so no, joints are fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.65,
      "end_seconds": 138.78,
      "duration_seconds": 1.13,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.83,
      "end_seconds": 141.78,
      "duration_seconds": 1.95,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.06,
      "end_seconds": 149.8,
      "duration_seconds": 6.74,
      "text": "Let's go through your medication. What are you taking? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.14,
      "end_seconds": 157.63,
      "duration_seconds": 6.49,
      "text": "I'm on Seretide inhaler, twice a day. It's, It's pantoprazole, 40 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 162.05,
      "duration_seconds": 3.09,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.74,
      "end_seconds": 170.97,
      "duration_seconds": 8.23,
      "text": "Not with me. I'll bring it next time. Digene, after meals. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 178.94,
      "duration_seconds": 6.74,
      "text": "Okay, do you have any known allergies at all? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.46,
      "end_seconds": 182.79,
      "duration_seconds": 3.33,
      "text": "Well, yes, dust. I get itchy eyes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.78,
      "end_seconds": 185.3,
      "duration_seconds": 1.52,
      "text": "Right, do you smoke?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.79,
      "end_seconds": 189.31,
      "duration_seconds": 3.52,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.93,
      "end_seconds": 191.38,
      "duration_seconds": 1.45,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.46,
      "end_seconds": 195.9,
      "duration_seconds": 3.44,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.1,
      "end_seconds": 200.67,
      "duration_seconds": 3.57,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 201.76,
      "end_seconds": 213.21,
      "duration_seconds": 11.45,
      "text": "Asthma, for about ten years. I'm not great at remembering details, so bear with me. Acid reflux, for two years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.78,
      "end_seconds": 229.26,
      "duration_seconds": 12.48,
      "text": "Right, so that's your known asthma. We'll keep that in mind today. Yes, I can see the acid reflux in your file as well. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.98,
      "end_seconds": 243.59,
      "duration_seconds": 13.61,
      "text": "Yes, um, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 246.22,
      "duration_seconds": 2.01,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.28,
      "end_seconds": 259.55,
      "duration_seconds": 1.27,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.36,
      "end_seconds": 287.59,
      "duration_seconds": 8.23,
      "text": "Okay: saturation 98 percent, respiratory rate 18, temperature 36.8, pressure 113 over 68, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.03,
      "end_seconds": 290.05,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.66,
      "end_seconds": 296.97,
      "duration_seconds": 6.31,
      "text": "Okay, we'll put it in context in a moment. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.01,
      "end_seconds": 316.23,
      "duration_seconds": 18.22,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.41,
      "end_seconds": 321.42,
      "duration_seconds": 3.01,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.32,
      "end_seconds": 324.4,
      "duration_seconds": 2.08,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.24,
      "end_seconds": 346.7,
      "duration_seconds": 4.46,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.69,
      "end_seconds": 369.63,
      "duration_seconds": 18.94,
      "text": "Okay, that's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Right, here's what I'm thinking. It fits best with a cough driven by acid reflux. I can't rule out post-nasal drip yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 370.21,
      "end_seconds": 376.47,
      "duration_seconds": 6.26,
      "text": "So, you know, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.64,
      "end_seconds": 397.23,
      "duration_seconds": 17.59,
      "text": "I can't promise yet, but most people with a cough driven by acid reflux do well once it's treated properly. Let me just recap so I've got it right. You've had a dry cough that won't go away for nearly five years, severe, and no weight loss or night sweats."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 397.86,
      "end_seconds": 399.58,
      "duration_seconds": 1.72,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.13,
      "end_seconds": 406.0,
      "duration_seconds": 5.87,
      "text": "We should do breathing tests for chronic cough. Let's get a chest X-ray, for chronic cough."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 407.2,
      "end_seconds": 409.67,
      "duration_seconds": 2.47,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.14,
      "end_seconds": 435.94,
      "duration_seconds": 24.8,
      "text": "Don't eat for two or three hours before lying down, and raise the head of the bed a little. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 438.67,
      "end_seconds": 440.04,
      "duration_seconds": 1.37,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 440.58,
      "end_seconds": 448.33,
      "duration_seconds": 7.75,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 449.51,
      "end_seconds": 450.21,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 451.41,
      "end_seconds": 457.25,
      "duration_seconds": 5.84,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 458.6,
      "end_seconds": 464.1,
      "duration_seconds": 5.5,
      "text": "So, you know, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 465.39,
      "end_seconds": 469.48,
      "duration_seconds": 4.09,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 469.95,
      "end_seconds": 472.55,
      "duration_seconds": 2.6,
      "text": "Uh, no questions. Thank you."
    }
  ]
}