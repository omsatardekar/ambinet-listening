{
  "schema_version": "1.0",
  "encounter_id": "00474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.78,
      "duration_seconds": 3.96,
      "text": "Sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.1,
      "end_seconds": 9.48,
      "duration_seconds": 4.38,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.02,
      "end_seconds": 23.15,
      "duration_seconds": 12.13,
      "text": "It's swelling in my left calf, mostly. I'm not great at remembering details, so bear with me. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.08,
      "end_seconds": 29.33,
      "duration_seconds": 5.25,
      "text": "How long has this been going on? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.89,
      "end_seconds": 40.19,
      "duration_seconds": 6.3,
      "text": "Right, about... well, ten days. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 48.44,
      "duration_seconds": 7.35,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.11,
      "end_seconds": 74.87,
      "duration_seconds": 21.76,
      "text": "Yes, standing. That makes it worse. I'd give it a three, out of ten. I looked a few things up online, and that probably didn't help. My family kept telling me to get it checked. Oh, and a bit of redness. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 87.37,
      "duration_seconds": 11.38,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.18,
      "end_seconds": 90.26,
      "duration_seconds": 2.08,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.69,
      "end_seconds": 95.44,
      "duration_seconds": 4.75,
      "text": "Any coughing up blood, fever, breathlessness or recent injury to the leg at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.9,
      "end_seconds": 97.68,
      "duration_seconds": 1.78,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.91,
      "end_seconds": 100.92,
      "duration_seconds": 2.01,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.4,
      "end_seconds": 103.1,
      "duration_seconds": 1.7,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.63,
      "end_seconds": 108.52,
      "duration_seconds": 3.89,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.68,
      "end_seconds": 112.89,
      "duration_seconds": 3.21,
      "text": "Okay, so no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.41,
      "end_seconds": 117.64,
      "duration_seconds": 3.23,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 120.64,
      "duration_seconds": 2.57,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.4,
      "end_seconds": 123.29,
      "duration_seconds": 1.89,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.38,
      "end_seconds": 128.57,
      "duration_seconds": 4.19,
      "text": "I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.92,
      "end_seconds": 132.96,
      "duration_seconds": 3.04,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.69,
      "end_seconds": 134.65,
      "duration_seconds": 0.96,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.69,
      "end_seconds": 155.84,
      "duration_seconds": 6.15,
      "text": "Alright, I've got it. What medicines do you take regularly? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.81,
      "end_seconds": 160.47,
      "duration_seconds": 3.66,
      "text": "It's paracetamol, 650 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.23,
      "end_seconds": 164.49,
      "duration_seconds": 3.26,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.29,
      "end_seconds": 167.66,
      "duration_seconds": 2.37,
      "text": "Yeah, no, it's at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.43,
      "end_seconds": 171.76,
      "duration_seconds": 3.33,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 185.25,
      "duration_seconds": 12.82,
      "text": "I mean, I have arthritis in my knees. I told myself I'd wait and see, and here I am. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.99,
      "end_seconds": 194.06,
      "duration_seconds": 8.07,
      "text": "Okay, arthritis in my knees, that's already on your record. Good to know. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.12,
      "end_seconds": 198.65,
      "duration_seconds": 3.53,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.41,
      "end_seconds": 202.75,
      "duration_seconds": 3.34,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.99,
      "end_seconds": 217.32,
      "duration_seconds": 1.33,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.56,
      "end_seconds": 240.11,
      "duration_seconds": 9.55,
      "text": "Okay: respiratory rate 19, heart rate 111, weight 86 kilos. And blood pressure 127 over 72, height 150 centimetres, BMI works out to 38.2, temperature 36.9."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.43,
      "end_seconds": 242.61,
      "duration_seconds": 1.18,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.72,
      "end_seconds": 246.24,
      "duration_seconds": 2.52,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.19,
      "end_seconds": 249.41,
      "duration_seconds": 2.22,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.73,
      "end_seconds": 251.85,
      "duration_seconds": 2.12,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.44,
      "end_seconds": 267.05,
      "duration_seconds": 1.61,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.75,
      "end_seconds": 272.27,
      "duration_seconds": 2.52,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.85,
      "end_seconds": 276.01,
      "duration_seconds": 2.16,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.32,
      "end_seconds": 292.18,
      "duration_seconds": 1.86,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.05,
      "end_seconds": 296.4,
      "duration_seconds": 2.35,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.27,
      "end_seconds": 309.05,
      "duration_seconds": 4.78,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.73,
      "end_seconds": 338.54,
      "duration_seconds": 23.81,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.97,
      "end_seconds": 342.89,
      "duration_seconds": 2.92,
      "text": "Um, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.08,
      "end_seconds": 354.21,
      "duration_seconds": 10.13,
      "text": "Okay, so my impression is this: My working impression is a possible deep vein clot. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.54,
      "end_seconds": 357.88,
      "duration_seconds": 2.34,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.51,
      "end_seconds": 380.66,
      "duration_seconds": 20.15,
      "text": "I understand the worry. At the moment I'd say it's a possible deep vein clot, and we'll know more once the a Doppler scan of the leg is back. Let me just recap so I've got it right. You've had swelling in your left calf for ten days, and no coughing up blood or recent injury to the leg."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.09,
      "end_seconds": 383.94,
      "duration_seconds": 2.85,
      "text": "Right, exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.98,
      "end_seconds": 407.44,
      "duration_seconds": 22.46,
      "text": "I'd like to arrange a Doppler scan of the leg for suspected DVT. Keep walking gently, and don't massage the calf. Don't skip meals, and try to eat smaller portions more often through the day. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.52,
      "end_seconds": 410.0,
      "duration_seconds": 1.48,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.38,
      "end_seconds": 419.82,
      "duration_seconds": 8.44,
      "text": "Keep an eye out, and if you get chest pain or sudden breathlessness, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.58,
      "end_seconds": 422.3,
      "duration_seconds": 1.72,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.06,
      "end_seconds": 427.92,
      "duration_seconds": 1.86,
      "text": "Let's review you in two days."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.28,
      "end_seconds": 432.0,
      "duration_seconds": 2.72,
      "text": "Okay, you know, I'll book that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.54,
      "end_seconds": 438.68,
      "duration_seconds": 6.14,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.26,
      "end_seconds": 445.28,
      "duration_seconds": 5.02,
      "text": "So, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.02,
      "end_seconds": 450.12,
      "duration_seconds": 4.1,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 451.19,
      "end_seconds": 453.73,
      "duration_seconds": 2.54,
      "text": "I appreciate your time, doctor."
    }
  ]
}