{
  "schema_version": "1.0",
  "encounter_id": "00198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.19,
      "duration_seconds": 2.26,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.13,
      "end_seconds": 8.57,
      "duration_seconds": 4.44,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.89,
      "end_seconds": 14.79,
      "duration_seconds": 5.9,
      "text": "Yes, that's no problem at all. Please sit. Right, did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.11,
      "end_seconds": 20.24,
      "duration_seconds": 4.13,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.94,
      "end_seconds": 23.06,
      "duration_seconds": 2.12,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.5,
      "end_seconds": 27.27,
      "duration_seconds": 3.77,
      "text": "She's been having been wanting to stop smoking, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.31,
      "end_seconds": 34.08,
      "duration_seconds": 3.77,
      "text": "Have you been getting out of breath quicker than before?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.83,
      "end_seconds": 36.56,
      "duration_seconds": 1.73,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.89,
      "end_seconds": 45.47,
      "duration_seconds": 7.58,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.95,
      "end_seconds": 53.13,
      "duration_seconds": 5.18,
      "text": "Pretty severe, if I'm being honest. I notice it more with stairs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.28,
      "end_seconds": 57.0,
      "duration_seconds": 2.72,
      "text": "Has there been cravings, mostly after meals too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 66.81,
      "duration_seconds": 7.5,
      "text": "Yeah, that too. About cravings, mostly after meals, it's severe, honestly. Oh, and a smoker's cough in the mornings."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.25,
      "end_seconds": 70.64,
      "duration_seconds": 3.39,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.6,
      "end_seconds": 77.47,
      "duration_seconds": 5.87,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.64,
      "end_seconds": 84.47,
      "duration_seconds": 5.83,
      "text": "Let me check a few things. Any weight loss, coughing up blood, low mood or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.68,
      "end_seconds": 92.0,
      "duration_seconds": 6.32,
      "text": "Right, I haven't had weight loss, coughing up blood, low mood or chest pain, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.5,
      "end_seconds": 95.11,
      "duration_seconds": 2.61,
      "text": "I see. Has there been any alcohol problems?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.14,
      "end_seconds": 97.58,
      "duration_seconds": 1.44,
      "text": "No. No alcohol problems."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.97,
      "end_seconds": 100.3,
      "duration_seconds": 2.33,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.13,
      "end_seconds": 102.92,
      "duration_seconds": 1.79,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.3,
      "end_seconds": 106.97,
      "duration_seconds": 3.67,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.39,
      "end_seconds": 109.4,
      "duration_seconds": 2.01,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.52,
      "end_seconds": 116.48,
      "duration_seconds": 5.96,
      "text": "Let's go through your medication. What are you taking? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.74,
      "end_seconds": 121.01,
      "duration_seconds": 3.27,
      "text": "It's amlodipine, once a day for my pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.79,
      "end_seconds": 123.48,
      "duration_seconds": 1.69,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.07,
      "end_seconds": 125.36,
      "duration_seconds": 1.29,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.45,
      "end_seconds": 129.95,
      "duration_seconds": 3.5,
      "text": "Okay, are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.45,
      "end_seconds": 134.62,
      "duration_seconds": 3.17,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.69,
      "end_seconds": 139.19,
      "duration_seconds": 3.5,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.7,
      "end_seconds": 146.16,
      "duration_seconds": 5.46,
      "text": "Oh, uh, I'm allergic to sulfa drugs, I get itching all over."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.13,
      "end_seconds": 149.29,
      "duration_seconds": 2.16,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 151.53,
      "duration_seconds": 1.71,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.06,
      "end_seconds": 156.2,
      "duration_seconds": 4.14,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.31,
      "end_seconds": 163.85,
      "duration_seconds": 6.54,
      "text": "High blood pressure, for about ten years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 164.9,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.56,
      "end_seconds": 174.31,
      "duration_seconds": 8.75,
      "text": "I have COPD, for two years. I thought it would sort itself out, but it hasn't. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.03,
      "end_seconds": 176.14,
      "duration_seconds": 1.11,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.12,
      "end_seconds": 181.28,
      "duration_seconds": 4.16,
      "text": "Right, so that's your known COPD. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.67,
      "end_seconds": 186.11,
      "duration_seconds": 3.44,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.74,
      "end_seconds": 187.44,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.79,
      "end_seconds": 202.43,
      "duration_seconds": 3.64,
      "text": "Okay, here we go. Let me check your vitals now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.74,
      "end_seconds": 214.05,
      "duration_seconds": 1.31,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.09,
      "end_seconds": 230.9,
      "duration_seconds": 7.81,
      "text": "Okay: pulse 85, BP is 121 over 79. And SpO2 99 percent on room air, temperature 36.8, respiratory rate 17."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.28,
      "end_seconds": 232.39,
      "duration_seconds": 1.11,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.62,
      "end_seconds": 241.2,
      "duration_seconds": 7.58,
      "text": "We'll put it in context in a moment. Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.14,
      "end_seconds": 247.43,
      "duration_seconds": 3.29,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.42,
      "end_seconds": 252.51,
      "duration_seconds": 2.09,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.33,
      "end_seconds": 254.03,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.34,
      "end_seconds": 257.92,
      "duration_seconds": 2.58,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.54,
      "end_seconds": 271.05,
      "duration_seconds": 4.51,
      "text": "Chest sounds clear, a bit of wheeze when you breathe out hard."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.27,
      "end_seconds": 281.85,
      "duration_seconds": 5.58,
      "text": "Okay, you can sit back up. Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.34,
      "end_seconds": 284.7,
      "duration_seconds": 1.36,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 293.63,
      "duration_seconds": 7.66,
      "text": "Okay, so my impression is this: This looks most like nicotine dependence. I'd also keep early chronic bronchitis in mind."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.51,
      "end_seconds": 297.39,
      "duration_seconds": 2.88,
      "text": "Okay, so is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.54,
      "end_seconds": 304.25,
      "duration_seconds": 5.71,
      "text": "It's reasonable to be concerned, but right now nicotine dependence is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.01,
      "end_seconds": 308.51,
      "duration_seconds": 3.5,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.18,
      "end_seconds": 309.9,
      "duration_seconds": 0.72,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.69,
      "end_seconds": 321.85,
      "duration_seconds": 4.16,
      "text": "Alright, I've got it. I'd like to arrange breathing tests for smoker's cough."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.91,
      "end_seconds": 327.41,
      "duration_seconds": 4.5,
      "text": "Uh, uh, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.64,
      "end_seconds": 346.53,
      "duration_seconds": 17.89,
      "text": "I'm prescribing nicotine patches, 14 milligrams, once a day, for six weeks. It's for smoking cessation. Pick a quit date this month, and tell your family so they can back you up. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to the stop-smoking clinic."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 348.05,
      "end_seconds": 348.75,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.26,
      "end_seconds": 355.42,
      "duration_seconds": 6.16,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.38,
      "end_seconds": 357.64,
      "duration_seconds": 1.26,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.95,
      "end_seconds": 360.48,
      "duration_seconds": 2.53,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.52,
      "end_seconds": 362.22,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.91,
      "end_seconds": 367.68,
      "duration_seconds": 4.77,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 369.22,
      "end_seconds": 373.93,
      "duration_seconds": 4.71,
      "text": "So, you know, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.36,
      "end_seconds": 380.69,
      "duration_seconds": 5.33,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 381.72,
      "end_seconds": 384.73,
      "duration_seconds": 3.01,
      "text": "That's all, thank you for your time."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.16,
      "end_seconds": 387.54,
      "duration_seconds": 2.38,
      "text": "Bye for now, look after yourself."
    }
  ]
}