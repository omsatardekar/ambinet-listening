{
  "schema_version": "1.0",
  "encounter_id": "00329",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 2.97,
      "duration_seconds": 2.27,
      "text": "Good afternoon. Take a seat, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.65,
      "end_seconds": 4.66,
      "duration_seconds": 1.01,
      "text": "Hi, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 7.15,
      "duration_seconds": 1.94,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.44,
      "end_seconds": 11.14,
      "duration_seconds": 2.7,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.56,
      "end_seconds": 16.0,
      "duration_seconds": 3.44,
      "text": "What was the main thing you wanted to talk about?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.21,
      "end_seconds": 24.86,
      "duration_seconds": 4.65,
      "text": "Mainly I've been feeling cold all the time. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.37,
      "end_seconds": 28.31,
      "duration_seconds": 1.94,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.76,
      "end_seconds": 31.83,
      "duration_seconds": 2.07,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.38,
      "end_seconds": 34.53,
      "duration_seconds": 2.15,
      "text": "Has there been dry skin too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.81,
      "end_seconds": 36.75,
      "duration_seconds": 0.94,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.8,
      "end_seconds": 41.51,
      "duration_seconds": 3.71,
      "text": "Any palpitations, heavy periods, swelling in the neck or hair loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.38,
      "end_seconds": 47.99,
      "duration_seconds": 5.61,
      "text": "I haven't had palpitations, heavy periods, swelling in the neck or hair loss, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.12,
      "end_seconds": 51.33,
      "duration_seconds": 2.21,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.85,
      "end_seconds": 54.12,
      "duration_seconds": 1.27,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.35,
      "end_seconds": 57.9,
      "duration_seconds": 2.55,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.39,
      "end_seconds": 75.27,
      "duration_seconds": 15.88,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.8,
      "end_seconds": 78.85,
      "duration_seconds": 3.05,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.96,
      "end_seconds": 87.06,
      "duration_seconds": 4.1,
      "text": "I'm on iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.21,
      "end_seconds": 90.61,
      "duration_seconds": 2.4,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.19,
      "end_seconds": 93.32,
      "duration_seconds": 1.13,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.91,
      "end_seconds": 98.46,
      "duration_seconds": 3.55,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.58,
      "end_seconds": 101.67,
      "duration_seconds": 2.09,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 106.59,
      "duration_seconds": 1.07,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.12,
      "end_seconds": 110.86,
      "duration_seconds": 2.74,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.4,
      "end_seconds": 114.8,
      "duration_seconds": 3.4,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 120.19,
      "duration_seconds": 2.12,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.3,
      "end_seconds": 125.14,
      "duration_seconds": 3.84,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 127.81,
      "duration_seconds": 2.1,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.23,
      "end_seconds": 131.88,
      "duration_seconds": 2.65,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.51,
      "end_seconds": 133.37,
      "duration_seconds": 0.86,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.38,
      "end_seconds": 150.43,
      "duration_seconds": 4.05,
      "text": "Okay, here we go. Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.0,
      "end_seconds": 153.04,
      "duration_seconds": 2.04,
      "text": "I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.87,
      "end_seconds": 165.87,
      "duration_seconds": 12.0,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.85,
      "end_seconds": 168.48,
      "duration_seconds": 1.63,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 168.91,
      "end_seconds": 176.72,
      "duration_seconds": 7.81,
      "text": "Okay, so the vitals from earlier. SpO2 98 percent on room air, heart rate 78, temperature is 36.6 degrees. Blood pressure 117 over 80."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.19,
      "end_seconds": 179.25,
      "duration_seconds": 1.06,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.56,
      "end_seconds": 184.96,
      "duration_seconds": 4.4,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.72,
      "end_seconds": 186.56,
      "duration_seconds": 0.84,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.02,
      "end_seconds": 197.51,
      "duration_seconds": 1.49,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.75,
      "end_seconds": 203.19,
      "duration_seconds": 3.44,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.82,
      "end_seconds": 206.76,
      "duration_seconds": 1.94,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.15,
      "end_seconds": 219.78,
      "duration_seconds": 2.63,
      "text": "Reflexes are a bit slow to relax."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.45,
      "end_seconds": 224.37,
      "duration_seconds": 2.92,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.38,
      "end_seconds": 237.47,
      "duration_seconds": 4.09,
      "text": "Your pulse is slow, about fifty-six, and the thyroid isn't enlarged."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.33,
      "end_seconds": 246.81,
      "duration_seconds": 4.48,
      "text": "All done, thank you, please sit down. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.34,
      "end_seconds": 253.68,
      "duration_seconds": 5.34,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 265.64,
      "duration_seconds": 11.07,
      "text": "Okay, so my impression is this: My working impression is an underactive thyroid. That's my thinking for now, and it may change as we learn more. Depression is also on my list."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.39,
      "end_seconds": 268.6,
      "duration_seconds": 2.21,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.97,
      "end_seconds": 289.05,
      "duration_seconds": 19.08,
      "text": "I understand the worry. At the moment I'd say it's an underactive thyroid, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've been feeling cold all the time for six months, and no heavy periods or hair loss."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.14,
      "end_seconds": 291.99,
      "duration_seconds": 1.85,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.66,
      "end_seconds": 305.03,
      "duration_seconds": 12.37,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.34,
      "end_seconds": 309.74,
      "duration_seconds": 3.4,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.51,
      "end_seconds": 312.94,
      "duration_seconds": 2.43,
      "text": "Let's get blood tests, for fatigue."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.28,
      "end_seconds": 318.53,
      "duration_seconds": 1.25,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 329.14,
      "duration_seconds": 9.78,
      "text": "I'm prescribing levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. It's for hypothyroidism. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.1,
      "end_seconds": 330.95,
      "duration_seconds": 0.85,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.79,
      "end_seconds": 353.0,
      "duration_seconds": 21.21,
      "text": "Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Come back after the results are back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.49,
      "end_seconds": 354.19,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.2,
      "end_seconds": 359.45,
      "duration_seconds": 4.25,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.6,
      "end_seconds": 371.02,
      "duration_seconds": 10.42,
      "text": "So, I take the levothyroxine, 50 micrograms, every morning on an empty stomach and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 371.4,
      "end_seconds": 377.31,
      "duration_seconds": 5.91,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.12,
      "end_seconds": 382.11,
      "duration_seconds": 3.99,
      "text": "Okay, thank you. I'll get started on all of that."
    }
  ]
}