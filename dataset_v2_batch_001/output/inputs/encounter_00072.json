{
  "schema_version": "1.0",
  "encounter_id": "00072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.22,
      "end_seconds": 2.63,
      "duration_seconds": 1.41,
      "text": "Hello there. Please, sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.02,
      "end_seconds": 5.65,
      "duration_seconds": 2.63,
      "text": "Hello, doctor. Thanks for seeing me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.24,
      "end_seconds": 11.09,
      "duration_seconds": 4.85,
      "text": "Doctor, um, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.43,
      "end_seconds": 13.7,
      "duration_seconds": 1.27,
      "text": "Did you come far?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.29,
      "end_seconds": 21.06,
      "duration_seconds": 5.77,
      "text": "Um, you know, not too far, about half an hour by bus."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.93,
      "end_seconds": 24.39,
      "duration_seconds": 2.46,
      "text": "Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.2,
      "end_seconds": 29.62,
      "duration_seconds": 4.42,
      "text": "He's been having pain in the lower right tummy, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.16,
      "end_seconds": 35.24,
      "duration_seconds": 4.08,
      "text": "How long have you had it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 47.41,
      "duration_seconds": 11.36,
      "text": "Ever since... since last Tuesday, really. I've never really been one for hospitals. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.86,
      "end_seconds": 54.73,
      "duration_seconds": 6.87,
      "text": "Go on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.91,
      "end_seconds": 71.95,
      "duration_seconds": 16.04,
      "text": "Pretty moderate, if I'm being honest. Moving definitely sets it off. Honestly, once or twice a day. I'm hoping you can tell me something definite. And nausea as well, since Friday. With nausea, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.57,
      "end_seconds": 74.43,
      "duration_seconds": 1.86,
      "text": "Has there been vomiting once too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.15,
      "end_seconds": 81.79,
      "duration_seconds": 6.64,
      "text": "Yes, uh, actually. With vomiting once, honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.71,
      "end_seconds": 84.47,
      "duration_seconds": 1.76,
      "text": "Have you had no appetite?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.3,
      "end_seconds": 88.41,
      "duration_seconds": 3.11,
      "text": "Yes, you know, for about four days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.1,
      "end_seconds": 95.21,
      "duration_seconds": 6.11,
      "text": "Have you had pain in the lower right tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.54,
      "end_seconds": 103.88,
      "duration_seconds": 8.34,
      "text": "Yes, you know, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.3,
      "end_seconds": 106.77,
      "duration_seconds": 2.47,
      "text": "Any hernia bulge, diarrhoea or constipation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.03,
      "end_seconds": 111.63,
      "duration_seconds": 3.6,
      "text": "No hernia bulge, diarrhoea or constipation, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.35,
      "end_seconds": 118.1,
      "duration_seconds": 5.75,
      "text": "Okay, have you had any burning when passing urine, blood in the stool or jaundice?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.17,
      "end_seconds": 120.72,
      "duration_seconds": 1.55,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.19,
      "end_seconds": 125.92,
      "duration_seconds": 1.73,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.53,
      "end_seconds": 128.44,
      "duration_seconds": 1.91,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.18,
      "end_seconds": 131.27,
      "duration_seconds": 2.09,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.68,
      "end_seconds": 134.63,
      "duration_seconds": 1.95,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.0,
      "end_seconds": 149.03,
      "duration_seconds": 14.03,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.87,
      "end_seconds": 152.63,
      "duration_seconds": 2.76,
      "text": "Uh, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 154.12,
      "end_seconds": 166.29,
      "duration_seconds": 12.17,
      "text": "Here are the numbers, doctor. Height 164 centimetres, temperature is 38.6 degrees, saturation 95 percent, weight 95 kilos, pulse 105, BMI works out to 35.3, blood pressure 107 over 75."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.89,
      "end_seconds": 170.79,
      "duration_seconds": 3.9,
      "text": "Thanks. Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.89,
      "end_seconds": 188.62,
      "duration_seconds": 14.73,
      "text": "Uh, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.94,
      "end_seconds": 193.44,
      "duration_seconds": 4.5,
      "text": "So, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.5,
      "end_seconds": 200.15,
      "duration_seconds": 5.65,
      "text": "Depression, for nearly five years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.98,
      "end_seconds": 201.71,
      "duration_seconds": 0.73,
      "text": "I see."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.72,
      "end_seconds": 206.13,
      "duration_seconds": 3.41,
      "text": "I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.1,
      "end_seconds": 229.75,
      "duration_seconds": 22.65,
      "text": "I see. Right, so that's your known depression. We'll keep that in mind today. Right, so that's your known asthma. We'll keep that in mind today. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.27,
      "end_seconds": 232.07,
      "duration_seconds": 1.8,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.13,
      "end_seconds": 235.31,
      "duration_seconds": 2.18,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.22,
      "end_seconds": 240.19,
      "duration_seconds": 3.97,
      "text": "Escitalopram, 10 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 241.65,
      "end_seconds": 245.71,
      "duration_seconds": 4.06,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.45,
      "end_seconds": 249.57,
      "duration_seconds": 3.12,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.53,
      "end_seconds": 259.72,
      "duration_seconds": 9.19,
      "text": "Not with me. I'll bring it next time. It's Asthalin inhaler, when needed. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.7,
      "end_seconds": 263.64,
      "duration_seconds": 2.94,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.4,
      "end_seconds": 283.05,
      "duration_seconds": 2.65,
      "text": "Good, where were we. How about smoking?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.37,
      "end_seconds": 288.56,
      "duration_seconds": 4.19,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.97,
      "end_seconds": 296.3,
      "duration_seconds": 3.33,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.54,
      "end_seconds": 303.37,
      "duration_seconds": 5.83,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.5,
      "end_seconds": 306.61,
      "duration_seconds": 2.11,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.33,
      "end_seconds": 311.64,
      "duration_seconds": 4.31,
      "text": "Yes, penicillin, it gives me swelling of my face."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.58,
      "end_seconds": 317.05,
      "duration_seconds": 2.47,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.75,
      "end_seconds": 318.45,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.12,
      "end_seconds": 321.84,
      "duration_seconds": 1.72,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.16,
      "end_seconds": 338.45,
      "duration_seconds": 1.29,
      "text": "Bowel sounds are present."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.81,
      "end_seconds": 340.51,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.74,
      "end_seconds": 343.04,
      "duration_seconds": 1.3,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.35,
      "end_seconds": 358.16,
      "duration_seconds": 4.81,
      "text": "There's tenderness in the right lower part and it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.68,
      "end_seconds": 362.38,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.84,
      "end_seconds": 380.42,
      "duration_seconds": 13.58,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.77,
      "end_seconds": 393.48,
      "duration_seconds": 12.71,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.95,
      "end_seconds": 406.55,
      "duration_seconds": 11.6,
      "text": "So, based on the history and the examination, my working impression is possible appendicitis. I want to be honest that this is an impression, not a final answer. I can't rule out a gastroenteritis yet."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.88,
      "end_seconds": 410.03,
      "duration_seconds": 2.15,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.87,
      "end_seconds": 429.38,
      "duration_seconds": 18.51,
      "text": "I understand the worry. At the moment I'd say it's possible appendicitis, and we'll know more once the an ultrasound of the abdomen is back. Let me just recap so I've got it right. You've had pain in the lower right tummy, since last Tuesday, moderate, and no burning when passing urine or diarrhoea."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 433.15,
      "end_seconds": 434.51,
      "duration_seconds": 1.36,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.23,
      "end_seconds": 438.86,
      "duration_seconds": 3.63,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.15,
      "end_seconds": 443.24,
      "duration_seconds": 3.09,
      "text": "No problem, you know, take your time."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 444.27,
      "end_seconds": 471.28,
      "duration_seconds": 27.01,
      "text": "We should do an ultrasound of the abdomen for right lower abdominal pain. I'd rather check than guess, and this is the quickest way to know more. I'd like to arrange a urine test for abdominal pain. It's a routine test and it'll give us a much clearer picture. I'd like to arrange blood tests for abdominal pain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 475.44,
      "end_seconds": 478.24,
      "duration_seconds": 2.8,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 481.56,
      "end_seconds": 500.07,
      "duration_seconds": 18.51,
      "text": "Please don't eat or drink anything until the surgeons have seen you. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 500.38,
      "end_seconds": 501.64,
      "duration_seconds": 1.26,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 502.54,
      "end_seconds": 510.11,
      "duration_seconds": 7.57,
      "text": "If the pain gets sharper or spreads across the tummy, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 511.24,
      "end_seconds": 511.94,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 513.09,
      "end_seconds": 520.02,
      "duration_seconds": 6.93,
      "text": "Let's review you after the scan. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 521.18,
      "end_seconds": 525.25,
      "duration_seconds": 4.07,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 526.6,
      "end_seconds": 530.9,
      "duration_seconds": 4.3,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 531.86,
      "end_seconds": 535.89,
      "duration_seconds": 4.03,
      "text": "Well, you know, no, you've explained it well. Thanks."
    }
  ]
}