{
  "schema_version": "1.0",
  "encounter_id": "00190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.3,
      "end_seconds": 4.72,
      "duration_seconds": 3.42,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 9.93,
      "duration_seconds": 3.66,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.45,
      "end_seconds": 13.86,
      "duration_seconds": 3.41,
      "text": "So, I've been forgetting things lately, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.65,
      "end_seconds": 16.62,
      "duration_seconds": 1.97,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.98,
      "end_seconds": 28.24,
      "duration_seconds": 11.26,
      "text": "Probably three weeks. Yeah. I've also been misplacing things, for about three months. Difficulty finding words was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.22,
      "end_seconds": 32.68,
      "duration_seconds": 3.46,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.11,
      "end_seconds": 46.83,
      "duration_seconds": 5.72,
      "text": "Good, where were we. Let me check a few things. Any low mood, falls or headache?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.29,
      "end_seconds": 51.75,
      "duration_seconds": 4.46,
      "text": "I, I haven't had low mood, falls or headache, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.63,
      "end_seconds": 54.3,
      "duration_seconds": 1.67,
      "text": "Has there been any hallucinations?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.19,
      "end_seconds": 57.41,
      "duration_seconds": 2.22,
      "text": "Not at all, no hallucinations."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.0,
      "end_seconds": 60.99,
      "duration_seconds": 2.99,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.74,
      "end_seconds": 66.6,
      "duration_seconds": 1.86,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.06,
      "end_seconds": 71.65,
      "duration_seconds": 3.59,
      "text": "Okay, do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.8,
      "end_seconds": 79.64,
      "duration_seconds": 6.84,
      "text": "Okay, so just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.95,
      "end_seconds": 83.85,
      "duration_seconds": 3.9,
      "text": "So, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.69,
      "end_seconds": 88.55,
      "duration_seconds": 3.86,
      "text": "My mother had high blood pressure. My sister has epilepsy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.91,
      "end_seconds": 103.15,
      "duration_seconds": 13.24,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.55,
      "end_seconds": 106.13,
      "duration_seconds": 1.58,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 111.83,
      "duration_seconds": 2.02,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.89,
      "end_seconds": 115.98,
      "duration_seconds": 3.09,
      "text": "I had a knee arthroscopy three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.19,
      "end_seconds": 120.28,
      "duration_seconds": 3.09,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 137.0,
      "duration_seconds": 16.39,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.53,
      "end_seconds": 144.84,
      "duration_seconds": 7.31,
      "text": "Okay, do you have any medical conditions, anything you've been treated for? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.41,
      "end_seconds": 156.6,
      "duration_seconds": 11.19,
      "text": "I've had high blood pressure for five years now. High cholesterol, for five years. I told myself I'd wait and see, and here I am. I've got diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 171.7,
      "duration_seconds": 14.14,
      "text": "Okay, high blood pressure, that's already on your record. Good to know. Right, so that's your known high cholesterol. We'll keep that in mind today. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.29,
      "end_seconds": 174.26,
      "duration_seconds": 1.97,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.69,
      "end_seconds": 177.66,
      "duration_seconds": 2.97,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.17,
      "end_seconds": 192.01,
      "duration_seconds": 12.84,
      "text": "Rosuvastatin, 10 milligrams, at night for my cholesterol. It's a relief to finally sit down and talk about it. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.61,
      "end_seconds": 193.85,
      "duration_seconds": 1.24,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.73,
      "end_seconds": 199.61,
      "duration_seconds": 4.88,
      "text": "Metformin. I take it 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 200.89,
      "end_seconds": 204.67,
      "duration_seconds": 3.78,
      "text": "Doctor, our chart from the last visit lists it as 250 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.43,
      "end_seconds": 208.57,
      "duration_seconds": 3.14,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.71,
      "end_seconds": 213.22,
      "duration_seconds": 3.51,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.43,
      "end_seconds": 217.87,
      "duration_seconds": 3.44,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.35,
      "end_seconds": 219.21,
      "duration_seconds": 0.86,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.3,
      "end_seconds": 236.06,
      "duration_seconds": 4.76,
      "text": "Right, thanks for waiting. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 236.6,
      "end_seconds": 239.08,
      "duration_seconds": 2.48,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.15,
      "end_seconds": 242.88,
      "duration_seconds": 2.73,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.74,
      "end_seconds": 246.24,
      "duration_seconds": 2.5,
      "text": "I mean, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 246.8,
      "end_seconds": 254.61,
      "duration_seconds": 7.81,
      "text": "Doctor, I've got the readings for you. Temp 36.8 degrees, blood pressure 108 over 78, saturation 99 percent, pulse 68."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.72,
      "end_seconds": 276.59,
      "duration_seconds": 17.87,
      "text": "Thanks. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 278.89,
      "end_seconds": 280.94,
      "duration_seconds": 2.05,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.52,
      "end_seconds": 285.13,
      "duration_seconds": 2.61,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.76,
      "end_seconds": 288.47,
      "duration_seconds": 1.71,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.55,
      "end_seconds": 301.53,
      "duration_seconds": 3.98,
      "text": "Your gait is steady and the tone in your limbs is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.68,
      "end_seconds": 303.38,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.85,
      "end_seconds": 317.61,
      "duration_seconds": 9.76,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.82,
      "end_seconds": 322.9,
      "duration_seconds": 4.08,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.65,
      "end_seconds": 324.42,
      "duration_seconds": 0.77,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.58,
      "end_seconds": 354.45,
      "duration_seconds": 16.87,
      "text": "Okay, here we go. From what you've told me and what I found, it fits best with memory difficulties that need to be worked up. That's my thinking for now, and it may change as we learn more. I can't rule out early dementia yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 355.93,
      "end_seconds": 360.57,
      "duration_seconds": 4.64,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.51,
      "end_seconds": 377.26,
      "duration_seconds": 15.75,
      "text": "It's reasonable to be concerned, but right now memory difficulties that need to be worked up is my leading thought, not anything worse. Let me just recap so I've got it right. You've been forgetting things lately for three weeks, and no hallucinations or headache."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.6,
      "end_seconds": 380.66,
      "duration_seconds": 2.06,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.57,
      "end_seconds": 383.74,
      "duration_seconds": 2.17,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 384.37,
      "end_seconds": 385.25,
      "duration_seconds": 0.88,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.56,
      "end_seconds": 403.15,
      "duration_seconds": 4.59,
      "text": "Alright, I've got it. We should do a thyroid test for memory loss."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.22,
      "end_seconds": 406.39,
      "duration_seconds": 2.17,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.34,
      "end_seconds": 409.76,
      "duration_seconds": 2.42,
      "text": "Let's get blood tests, for memory loss."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 412.48,
      "end_seconds": 414.94,
      "duration_seconds": 2.46,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.73,
      "end_seconds": 419.52,
      "duration_seconds": 3.79,
      "text": "I'd like to arrange a vitamin B12 level for memory loss."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 421.06,
      "end_seconds": 423.28,
      "duration_seconds": 2.22,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.32,
      "end_seconds": 443.65,
      "duration_seconds": 19.33,
      "text": "Keep a daily routine and write things down, a notebook by the door works well. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please take the tablets with food so they don't upset your stomach. We'll refer you to the memory clinic."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 445.13,
      "end_seconds": 447.23,
      "duration_seconds": 2.1,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.23,
      "end_seconds": 455.15,
      "duration_seconds": 6.92,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 458.36,
      "end_seconds": 459.67,
      "duration_seconds": 1.31,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 460.29,
      "end_seconds": 469.86,
      "duration_seconds": 9.57,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 470.82,
      "end_seconds": 475.0,
      "duration_seconds": 4.18,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 475.38,
      "end_seconds": 482.39,
      "duration_seconds": 7.01,
      "text": "Okay, just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 482.71,
      "end_seconds": 486.42,
      "duration_seconds": 3.71,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.43,
      "end_seconds": 491.24,
      "duration_seconds": 3.81,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 491.56,
      "end_seconds": 493.27,
      "duration_seconds": 1.71,
      "text": "No questions. Thank you."
    }
  ]
}