{
  "schema_version": "1.0",
  "encounter_id": "00275",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.11,
      "duration_seconds": 3.06,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.06,
      "end_seconds": 8.8,
      "duration_seconds": 3.74,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.32,
      "end_seconds": 22.64,
      "duration_seconds": 12.32,
      "text": "It's a dry cough that won't go away. I thought I'd wait, you know, but it hasn't gone. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.37,
      "end_seconds": 24.91,
      "duration_seconds": 1.54,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.93,
      "end_seconds": 33.57,
      "duration_seconds": 7.64,
      "text": "It's been going on for six months. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.64,
      "end_seconds": 36.96,
      "duration_seconds": 2.32,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.03,
      "end_seconds": 40.17,
      "duration_seconds": 2.14,
      "text": "It's worse with lying down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.67,
      "end_seconds": 43.91,
      "duration_seconds": 3.24,
      "text": "Have you had a burning in the chest after meals?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.6,
      "end_seconds": 45.67,
      "duration_seconds": 1.07,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.55,
      "end_seconds": 50.18,
      "duration_seconds": 3.63,
      "text": "Any weight loss, night sweats or trouble swallowing at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.61,
      "end_seconds": 54.57,
      "duration_seconds": 2.96,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.35,
      "end_seconds": 58.41,
      "duration_seconds": 3.06,
      "text": "Have you had any wheezing or shortness of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.22,
      "end_seconds": 63.45,
      "duration_seconds": 4.23,
      "text": "I haven't had wheezing or shortness of breath, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.85,
      "end_seconds": 65.88,
      "duration_seconds": 2.03,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.4,
      "end_seconds": 68.47,
      "duration_seconds": 2.07,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.45,
      "end_seconds": 71.71,
      "duration_seconds": 2.26,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.27,
      "end_seconds": 75.28,
      "duration_seconds": 3.01,
      "text": "Right, just my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.59,
      "end_seconds": 82.28,
      "duration_seconds": 5.69,
      "text": "What about your general health, any conditions you're being treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.71,
      "end_seconds": 85.62,
      "duration_seconds": 1.91,
      "text": "I've, I've got asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.11,
      "end_seconds": 91.97,
      "duration_seconds": 4.86,
      "text": "Okay, asthma, that's already on your record. Good to know. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.15,
      "end_seconds": 97.08,
      "duration_seconds": 3.93,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 98.79,
      "duration_seconds": 1.09,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.96,
      "end_seconds": 101.17,
      "duration_seconds": 1.21,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.57,
      "end_seconds": 104.87,
      "duration_seconds": 2.3,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.23,
      "end_seconds": 107.15,
      "duration_seconds": 1.92,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.56,
      "end_seconds": 111.34,
      "duration_seconds": 2.78,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.92,
      "end_seconds": 123.22,
      "duration_seconds": 11.3,
      "text": "So, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.82,
      "end_seconds": 126.66,
      "duration_seconds": 2.84,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.34,
      "end_seconds": 135.36,
      "duration_seconds": 8.02,
      "text": "It's Seretide inhaler, twice a day. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.57,
      "end_seconds": 143.8,
      "duration_seconds": 7.23,
      "text": "Do you have any allergies to medicines, food, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.38,
      "end_seconds": 146.16,
      "duration_seconds": 0.78,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.7,
      "end_seconds": 149.95,
      "duration_seconds": 2.25,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.0,
      "end_seconds": 158.27,
      "duration_seconds": 1.27,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 182.01,
      "duration_seconds": 8.29,
      "text": "Okay: blood pressure 114 over 68, oxygen saturation is 97 percent, pulse 71, respiratory rate 18, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.46,
      "end_seconds": 185.94,
      "duration_seconds": 2.48,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 187.43,
      "duration_seconds": 0.88,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.22,
      "end_seconds": 195.63,
      "duration_seconds": 1.41,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.8,
      "end_seconds": 200.33,
      "duration_seconds": 3.53,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.31,
      "end_seconds": 202.23,
      "duration_seconds": 0.92,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.18,
      "end_seconds": 204.58,
      "duration_seconds": 1.4,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.37,
      "end_seconds": 228.3,
      "duration_seconds": 4.93,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 250.94,
      "duration_seconds": 16.94,
      "text": "That's fine, you can get dressed. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.47,
      "end_seconds": 253.59,
      "duration_seconds": 2.12,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.79,
      "end_seconds": 261.56,
      "duration_seconds": 6.77,
      "text": "From what you've told me and what I found, this looks most like a cough driven by acid reflux."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.09,
      "end_seconds": 264.8,
      "duration_seconds": 2.71,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.97,
      "end_seconds": 285.91,
      "duration_seconds": 19.94,
      "text": "I understand the worry. At the moment I'd say it's a cough driven by acid reflux, and we'll know more once the breathing tests is back. Let me just recap so I've got it right. You've had a dry cough that won't go away for six months, and no weight loss or night sweats."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.81,
      "end_seconds": 289.19,
      "duration_seconds": 2.38,
      "text": "Yes, you know, that's right."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.86,
      "end_seconds": 298.8,
      "duration_seconds": 6.94,
      "text": "I'm going to order breathing tests, for chronic cough. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.51,
      "end_seconds": 301.09,
      "duration_seconds": 1.58,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.94,
      "end_seconds": 315.5,
      "duration_seconds": 13.56,
      "text": "Let's use pantoprazole, 40 milligrams, before breakfast, for four weeks. You take it by mouth. That should help with reflux. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.97,
      "end_seconds": 318.76,
      "duration_seconds": 1.79,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.33,
      "end_seconds": 335.9,
      "duration_seconds": 16.57,
      "text": "Don't eat for two or three hours before lying down, and raise the head of the bed a little. Please take the tablets with food so they don't upset your stomach. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.47,
      "end_seconds": 343.26,
      "duration_seconds": 6.79,
      "text": "Okay. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.89,
      "end_seconds": 345.77,
      "duration_seconds": 1.88,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.65,
      "end_seconds": 348.5,
      "duration_seconds": 1.85,
      "text": "Come back in four weeks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.06,
      "end_seconds": 351.76,
      "duration_seconds": 1.7,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.13,
      "end_seconds": 357.98,
      "duration_seconds": 5.85,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.56,
      "end_seconds": 368.47,
      "duration_seconds": 8.91,
      "text": "So, I take the pantoprazole, 40 milligrams, before breakfast and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.99,
      "end_seconds": 374.37,
      "duration_seconds": 4.38,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.35,
      "end_seconds": 380.75,
      "duration_seconds": 5.4,
      "text": "Uh, okay, thank you. I'll get started on all of that."
    }
  ]
}