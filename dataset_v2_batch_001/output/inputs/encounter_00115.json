{
  "schema_version": "1.0",
  "encounter_id": "00115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.32,
      "end_seconds": 4.19,
      "duration_seconds": 2.87,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.43,
      "end_seconds": 10.3,
      "duration_seconds": 2.87,
      "text": "Hello. Is it okay if I sit here?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.56,
      "end_seconds": 13.82,
      "duration_seconds": 2.26,
      "text": "Right, have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.32,
      "end_seconds": 17.72,
      "duration_seconds": 3.4,
      "text": "Only about ten minutes, uh, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.62,
      "end_seconds": 21.07,
      "duration_seconds": 2.45,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.95,
      "end_seconds": 25.69,
      "duration_seconds": 3.74,
      "text": "So, I've been passing out once last week, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.15,
      "end_seconds": 30.76,
      "duration_seconds": 4.61,
      "text": "How long have you had it? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.23,
      "end_seconds": 38.0,
      "duration_seconds": 6.77,
      "text": "Hmm, it's been going on for about a week. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.46,
      "end_seconds": 41.38,
      "duration_seconds": 2.92,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.83,
      "end_seconds": 44.62,
      "duration_seconds": 1.79,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.42,
      "end_seconds": 48.14,
      "duration_seconds": 2.72,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.68,
      "end_seconds": 52.43,
      "duration_seconds": 3.75,
      "text": "It usually comes with a bit of lightheadedness since then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.55,
      "end_seconds": 56.94,
      "duration_seconds": 3.39,
      "text": "Has there been a bump on your head after too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.51,
      "end_seconds": 59.93,
      "duration_seconds": 2.42,
      "text": "Yeah. About two weeks, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.97,
      "end_seconds": 67.27,
      "duration_seconds": 3.3,
      "text": "Any chest pain, shaking or jerking or tongue biting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.61,
      "end_seconds": 74.25,
      "duration_seconds": 5.64,
      "text": "I haven't had chest pain, shaking or jerking or tongue biting, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.39,
      "end_seconds": 77.09,
      "duration_seconds": 1.7,
      "text": "And palpitations, any of that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.56,
      "end_seconds": 83.23,
      "duration_seconds": 1.67,
      "text": "No palpitations, thank goodness."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.77,
      "end_seconds": 86.44,
      "duration_seconds": 2.67,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.1,
      "end_seconds": 88.74,
      "duration_seconds": 1.64,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.49,
      "end_seconds": 93.51,
      "duration_seconds": 4.02,
      "text": "So, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.53,
      "end_seconds": 97.29,
      "duration_seconds": 2.76,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.03,
      "end_seconds": 103.3,
      "duration_seconds": 5.27,
      "text": "Right. Okay, high blood pressure, that's already on your record. Good to know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.26,
      "end_seconds": 107.97,
      "duration_seconds": 3.71,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.29,
      "end_seconds": 109.01,
      "duration_seconds": 0.72,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.78,
      "end_seconds": 126.22,
      "duration_seconds": 2.44,
      "text": "Okay, here we go. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.22,
      "end_seconds": 131.26,
      "duration_seconds": 4.04,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.14,
      "end_seconds": 135.15,
      "duration_seconds": 3.01,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.67,
      "end_seconds": 139.21,
      "duration_seconds": 3.54,
      "text": "Yes, pollen, it gives me a runny nose."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.84,
      "end_seconds": 144.62,
      "duration_seconds": 4.78,
      "text": "Let's go through your medication. What are you taking? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.9,
      "end_seconds": 151.65,
      "duration_seconds": 5.75,
      "text": "I'm on amlodipine, 5 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.45,
      "end_seconds": 159.1,
      "duration_seconds": 3.65,
      "text": "Okay, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.28,
      "end_seconds": 162.16,
      "duration_seconds": 1.88,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.43,
      "end_seconds": 167.87,
      "duration_seconds": 4.44,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.4,
      "end_seconds": 178.67,
      "duration_seconds": 9.27,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 181.56,
      "duration_seconds": 1.86,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.77,
      "end_seconds": 195.77,
      "duration_seconds": 2.0,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.18,
      "end_seconds": 223.9,
      "duration_seconds": 7.72,
      "text": "Okay: temperature is 36.7 degrees, heart rate 81, SpO2 99 percent on room air. And pressure 128 over 71."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.81,
      "end_seconds": 230.95,
      "duration_seconds": 4.14,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.06,
      "end_seconds": 233.3,
      "duration_seconds": 1.24,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.66,
      "end_seconds": 255.14,
      "duration_seconds": 5.48,
      "text": "Your pulse is regular and there's a small bruise on the right side of the head."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.57,
      "end_seconds": 263.64,
      "duration_seconds": 6.07,
      "text": "That's fine, you can get dressed. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.02,
      "end_seconds": 275.98,
      "duration_seconds": 10.96,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.15,
      "end_seconds": 299.27,
      "duration_seconds": 22.12,
      "text": "So, based on the history and the examination, my working impression is a simple faint, probably reflex-related. The reason I say that is that your story and my examination fit together. Let me just recap so I've got it right. You've been passing out once last week for about a week, and no palpitations or chest pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.5,
      "end_seconds": 303.79,
      "duration_seconds": 3.29,
      "text": "Exactly, you know, that's what's been happening."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.49,
      "end_seconds": 319.24,
      "duration_seconds": 14.75,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.93,
      "end_seconds": 321.6,
      "duration_seconds": 1.67,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.11,
      "end_seconds": 344.03,
      "duration_seconds": 20.92,
      "text": "Let's get blood tests, for syncope. That will help us see what's going on underneath and decide the next step. I'm going to order a Holter monitor, for syncope. That will help us see what's going on underneath and decide the next step. Drink enough water and avoid standing still for long stretches, and sit if you feel it coming."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.61,
      "end_seconds": 358.95,
      "duration_seconds": 14.34,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.48,
      "end_seconds": 367.06,
      "duration_seconds": 7.58,
      "text": "Okay. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.2,
      "end_seconds": 370.46,
      "duration_seconds": 2.26,
      "text": "Okay, um, I will."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.86,
      "end_seconds": 383.35,
      "duration_seconds": 12.49,
      "text": "Keep an eye out, and if you pass out again, especially with chest pain or palpitations, call us the same day or go to emergency. Come back after the results are back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.97,
      "end_seconds": 387.92,
      "duration_seconds": 3.95,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 389.3,
      "end_seconds": 394.95,
      "duration_seconds": 5.65,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.57,
      "end_seconds": 400.09,
      "duration_seconds": 4.52,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.89,
      "end_seconds": 408.85,
      "duration_seconds": 4.96,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 409.35,
      "end_seconds": 413.23,
      "duration_seconds": 3.88,
      "text": "Okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 413.77,
      "end_seconds": 415.78,
      "duration_seconds": 2.01,
      "text": "Bye for now, look after yourself."
    }
  ]
}