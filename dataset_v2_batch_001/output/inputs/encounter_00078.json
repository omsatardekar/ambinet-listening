{
  "schema_version": "1.0",
  "encounter_id": "00078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.99,
      "duration_seconds": 2.75,
      "text": "Good morning, how are you doing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.76,
      "end_seconds": 8.07,
      "duration_seconds": 3.31,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.72,
      "end_seconds": 10.5,
      "duration_seconds": 1.78,
      "text": "Right, weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 15.52,
      "duration_seconds": 4.51,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.36,
      "end_seconds": 18.31,
      "duration_seconds": 1.95,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 18.81,
      "end_seconds": 25.13,
      "duration_seconds": 6.32,
      "text": "Right, it's a weak urine stream, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.26,
      "end_seconds": 28.56,
      "duration_seconds": 2.3,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.89,
      "end_seconds": 38.52,
      "duration_seconds": 9.63,
      "text": "Pretty moderate, if I'm being honest. I was getting up at night to pass urine at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 42.27,
      "duration_seconds": 2.95,
      "text": "Any weight loss or back pain at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.62,
      "end_seconds": 48.22,
      "duration_seconds": 2.6,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.52,
      "end_seconds": 50.17,
      "duration_seconds": 1.65,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.74,
      "end_seconds": 53.32,
      "duration_seconds": 1.58,
      "text": "No fever, thank goodness."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.47,
      "end_seconds": 56.5,
      "duration_seconds": 2.03,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.84,
      "end_seconds": 58.51,
      "duration_seconds": 1.67,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.61,
      "end_seconds": 61.92,
      "duration_seconds": 2.31,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.7,
      "end_seconds": 71.77,
      "duration_seconds": 7.07,
      "text": "I had my gallbladder removed in 2016. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.36,
      "end_seconds": 77.68,
      "duration_seconds": 2.32,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.2,
      "end_seconds": 82.04,
      "duration_seconds": 2.84,
      "text": "I'm allergic to aspirin, I get wheezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.47,
      "end_seconds": 86.01,
      "duration_seconds": 2.54,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 87.61,
      "end_seconds": 90.94,
      "duration_seconds": 3.33,
      "text": "It's glimepiride, 2 milligrams, before breakfast, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.3,
      "end_seconds": 100.11,
      "duration_seconds": 7.81,
      "text": "Do you have any medical conditions, anything you've been treated for? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.61,
      "end_seconds": 101.53,
      "duration_seconds": 0.92,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.58,
      "end_seconds": 108.81,
      "duration_seconds": 6.23,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.36,
      "end_seconds": 116.92,
      "duration_seconds": 1.56,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.17,
      "end_seconds": 139.84,
      "duration_seconds": 7.67,
      "text": "Okay: weight 54 kilos, temperature 36.7, pressure 121 over 81, height 169 centimetres, SpO2 97 percent on room air, pulse 85."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.42,
      "end_seconds": 142.54,
      "duration_seconds": 1.12,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.12,
      "end_seconds": 146.19,
      "duration_seconds": 3.07,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.85,
      "end_seconds": 149.2,
      "duration_seconds": 2.35,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.78,
      "end_seconds": 151.9,
      "duration_seconds": 2.12,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.18,
      "end_seconds": 166.54,
      "duration_seconds": 1.36,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.96,
      "end_seconds": 170.83,
      "duration_seconds": 1.87,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.74,
      "end_seconds": 174.48,
      "duration_seconds": 2.74,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.04,
      "end_seconds": 187.82,
      "duration_seconds": 2.78,
      "text": "Your bladder isn't palpable and the tummy is soft."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.82,
      "end_seconds": 214.85,
      "duration_seconds": 22.03,
      "text": "Okay, all done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. From what you've told me and what I found, my working impression is an enlarged prostate causing urinary symptoms. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.4,
      "end_seconds": 218.32,
      "duration_seconds": 1.92,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.63,
      "end_seconds": 235.96,
      "duration_seconds": 16.33,
      "text": "I understand the worry. At the moment I'd say it's an enlarged prostate causing urinary symptoms, and we'll know more once the kidney function tests is back. Let me just recap so I've got it right. You've had a weak urine stream, moderate, and no weight loss or back pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.67,
      "end_seconds": 240.25,
      "duration_seconds": 1.58,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.63,
      "end_seconds": 259.24,
      "duration_seconds": 16.61,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.41,
      "end_seconds": 262.11,
      "duration_seconds": 1.7,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.65,
      "end_seconds": 271.72,
      "duration_seconds": 9.07,
      "text": "I'm going to order kidney function tests, for urinary symptoms. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.77,
      "end_seconds": 273.65,
      "duration_seconds": 0.88,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.48,
      "end_seconds": 282.45,
      "duration_seconds": 7.97,
      "text": "I'd like you to take tamsulosin, 0.4 milligrams, at night, for four weeks. You take it by mouth. It's for urinary symptoms."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.82,
      "end_seconds": 286.01,
      "duration_seconds": 3.19,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.59,
      "end_seconds": 309.93,
      "duration_seconds": 23.34,
      "text": "Cut back on tea and coffee after the afternoon and go before you sleep. Please take the tablets with food so they don't upset your stomach. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. I'd like to see you again in four weeks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.24,
      "end_seconds": 312.06,
      "duration_seconds": 1.82,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.53,
      "end_seconds": 318.22,
      "duration_seconds": 4.69,
      "text": "Right, good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.73,
      "end_seconds": 327.07,
      "duration_seconds": 4.34,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.02,
      "end_seconds": 330.0,
      "duration_seconds": 1.98,
      "text": "Bye for now, look after yourself."
    }
  ]
}