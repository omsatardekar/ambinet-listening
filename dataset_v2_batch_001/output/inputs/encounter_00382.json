{
  "schema_version": "1.0",
  "encounter_id": "00382",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 3.63,
      "duration_seconds": 2.48,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.21,
      "end_seconds": 8.66,
      "duration_seconds": 3.45,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.51,
      "end_seconds": 11.28,
      "duration_seconds": 1.77,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.35,
      "end_seconds": 16.11,
      "duration_seconds": 3.76,
      "text": "Only about ten minutes, um, no trouble."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.33,
      "end_seconds": 20.95,
      "duration_seconds": 1.62,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.78,
      "end_seconds": 24.36,
      "duration_seconds": 2.58,
      "text": "He's been having shaky spells, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.67,
      "end_seconds": 26.3,
      "duration_seconds": 1.63,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.22,
      "end_seconds": 28.96,
      "duration_seconds": 1.74,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 35.8,
      "duration_seconds": 6.52,
      "text": "Okay, give me more detail on it, whatever comes to mind. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.62,
      "end_seconds": 44.49,
      "duration_seconds": 7.87,
      "text": "I'd give it a six, out of ten. It's on and off. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.44,
      "end_seconds": 47.88,
      "duration_seconds": 2.44,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.87,
      "end_seconds": 63.02,
      "duration_seconds": 14.15,
      "text": "Uh, it usually comes with a headache afterwards. The headache afterwards? That's been since yesterday. As for headache afterwards, pretty mild, if I'm being honest. I've been feeling suddenly very hungry too, for four weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 66.38,
      "duration_seconds": 2.23,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.9,
      "end_seconds": 70.71,
      "duration_seconds": 2.81,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.52,
      "end_seconds": 75.57,
      "duration_seconds": 4.05,
      "text": "Have you had any losing consciousness, weight loss, chest pain or seizure?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.87,
      "end_seconds": 84.31,
      "duration_seconds": 5.44,
      "text": "I, I haven't had losing consciousness, weight loss, chest pain or seizure, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.24,
      "end_seconds": 86.88,
      "duration_seconds": 1.64,
      "text": "Has there been any vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.76,
      "end_seconds": 89.05,
      "duration_seconds": 1.29,
      "text": "No. No vomiting."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 89.58,
      "end_seconds": 93.6,
      "duration_seconds": 4.02,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.18,
      "end_seconds": 101.11,
      "duration_seconds": 5.93,
      "text": "Right, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.74,
      "end_seconds": 107.66,
      "duration_seconds": 5.92,
      "text": "Alright, I'll note both what you've said and what you've noticed. And confusion, any of that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.0,
      "end_seconds": 109.46,
      "duration_seconds": 1.46,
      "text": "No, no confusion."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.31,
      "end_seconds": 111.97,
      "duration_seconds": 1.66,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.49,
      "end_seconds": 114.13,
      "duration_seconds": 1.64,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.53,
      "end_seconds": 118.69,
      "duration_seconds": 3.16,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.34,
      "end_seconds": 120.04,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.22,
      "end_seconds": 136.7,
      "duration_seconds": 2.48,
      "text": "Alright, I've got it. How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.63,
      "end_seconds": 140.28,
      "duration_seconds": 2.65,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 142.8,
      "duration_seconds": 1.57,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.24,
      "end_seconds": 147.6,
      "duration_seconds": 3.36,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.93,
      "end_seconds": 155.02,
      "duration_seconds": 4.09,
      "text": "Any allergies I should know about? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.51,
      "end_seconds": 160.03,
      "duration_seconds": 2.52,
      "text": "Yes, shellfish, it gives me hives."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.15,
      "end_seconds": 164.91,
      "duration_seconds": 3.76,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.31,
      "end_seconds": 170.25,
      "duration_seconds": 3.94,
      "text": "My father was diabetic. So, my brother has asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.72,
      "end_seconds": 175.3,
      "duration_seconds": 3.58,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.74,
      "end_seconds": 176.61,
      "duration_seconds": 0.87,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.96,
      "end_seconds": 191.04,
      "duration_seconds": 4.08,
      "text": "Alright, I've got it. Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.24,
      "end_seconds": 195.64,
      "duration_seconds": 3.4,
      "text": "Glycomet. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 196.88,
      "end_seconds": 205.5,
      "duration_seconds": 8.62,
      "text": "Um, doctor, I think the last prescription for the Glycomet was 1000 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.8,
      "end_seconds": 209.93,
      "duration_seconds": 3.13,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.29,
      "end_seconds": 213.62,
      "duration_seconds": 2.33,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.93,
      "end_seconds": 227.95,
      "duration_seconds": 14.02,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.29,
      "end_seconds": 231.3,
      "duration_seconds": 2.01,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.86,
      "end_seconds": 237.79,
      "duration_seconds": 5.93,
      "text": "Moving on to your background, any past medical history? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.94,
      "end_seconds": 253.47,
      "duration_seconds": 14.53,
      "text": "Right, yes, diabetes. I've never really been one for hospitals. I mean, you know, I've got high blood pressure. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.45,
      "end_seconds": 255.21,
      "duration_seconds": 0.76,
      "text": "I see."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.34,
      "end_seconds": 258.75,
      "duration_seconds": 2.41,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.46,
      "end_seconds": 260.25,
      "duration_seconds": 0.79,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.75,
      "end_seconds": 268.17,
      "duration_seconds": 1.42,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.4,
      "end_seconds": 273.39,
      "duration_seconds": 3.99,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.86,
      "end_seconds": 276.33,
      "duration_seconds": 1.47,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.2,
      "end_seconds": 291.12,
      "duration_seconds": 2.92,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.22,
      "end_seconds": 305.51,
      "duration_seconds": 11.29,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.76,
      "end_seconds": 309.06,
      "duration_seconds": 2.3,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 323.45,
      "duration_seconds": 13.86,
      "text": "Okay, so my impression is this: My working impression is low sugar episodes related to diabetes medication. That's my thinking for now, and it may change as we learn more. I'd also keep a meal-timing issue in mind."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.88,
      "end_seconds": 326.76,
      "duration_seconds": 1.88,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.31,
      "end_seconds": 343.24,
      "duration_seconds": 14.93,
      "text": "I understand the worry. At the moment I'd say it's low sugar episodes related to diabetes medication, and we'll know more once the an HbA1c is back. Let me just recap so I've got it right. You've had shaky spells for five days, and no chest pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 344.12,
      "end_seconds": 345.37,
      "duration_seconds": 1.25,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.72,
      "end_seconds": 361.13,
      "duration_seconds": 14.41,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 361.78,
      "end_seconds": 363.38,
      "duration_seconds": 1.6,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.58,
      "end_seconds": 390.58,
      "duration_seconds": 26.0,
      "text": "We should do an HbA1c for diabetes control. It's a routine test and it'll give us a much clearer picture. Let's get a blood sugar test, for hypoglycaemia. Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Cut down on salt and fried food for now, it really does make a difference. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.05,
      "end_seconds": 399.18,
      "duration_seconds": 7.13,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.38,
      "end_seconds": 401.64,
      "duration_seconds": 1.26,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.15,
      "end_seconds": 410.86,
      "duration_seconds": 7.71,
      "text": "Please don't sit on it if you black out or can't wake up properly after an episode. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 411.99,
      "end_seconds": 414.69,
      "duration_seconds": 2.7,
      "text": "Got it, um, thank you."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.46,
      "end_seconds": 419.15,
      "duration_seconds": 3.69,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 419.55,
      "end_seconds": 423.49,
      "duration_seconds": 3.94,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 428.16,
      "end_seconds": 432.96,
      "duration_seconds": 4.8,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 433.8,
      "end_seconds": 439.17,
      "duration_seconds": 5.37,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 439.65,
      "end_seconds": 444.19,
      "duration_seconds": 4.54,
      "text": "Alright, yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 445.11,
      "end_seconds": 446.59,
      "duration_seconds": 1.48,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 449.37,
      "end_seconds": 450.48,
      "duration_seconds": 1.11,
      "text": "See you then."
    }
  ]
}