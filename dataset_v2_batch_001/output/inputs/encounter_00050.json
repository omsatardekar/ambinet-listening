{
  "schema_version": "1.0",
  "encounter_id": "00050",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 7.37,
      "duration_seconds": 6.6,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.65,
      "end_seconds": 11.57,
      "duration_seconds": 2.92,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.18,
      "end_seconds": 15.15,
      "duration_seconds": 2.97,
      "text": "I wanted to get shaky spells looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.41,
      "end_seconds": 20.33,
      "duration_seconds": 3.92,
      "text": "Okay, is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.24,
      "end_seconds": 24.4,
      "duration_seconds": 3.16,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.37,
      "end_seconds": 28.72,
      "duration_seconds": 3.35,
      "text": "So, how would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.86,
      "end_seconds": 31.09,
      "duration_seconds": 1.23,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.6,
      "end_seconds": 33.53,
      "duration_seconds": 0.93,
      "text": "Anything that helps?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.84,
      "end_seconds": 37.26,
      "duration_seconds": 2.42,
      "text": "Eating something sweet helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.42,
      "end_seconds": 41.32,
      "duration_seconds": 2.9,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.92,
      "end_seconds": 43.99,
      "duration_seconds": 2.07,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.49,
      "end_seconds": 47.78,
      "duration_seconds": 3.29,
      "text": "What about a headache afterwards, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.82,
      "end_seconds": 50.45,
      "duration_seconds": 1.63,
      "text": "Yes, for three days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.99,
      "end_seconds": 53.26,
      "duration_seconds": 2.27,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.65,
      "end_seconds": 59.49,
      "duration_seconds": 5.84,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.87,
      "end_seconds": 62.32,
      "duration_seconds": 1.45,
      "text": "Any confusion or seizure?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.91,
      "end_seconds": 65.73,
      "duration_seconds": 2.82,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.25,
      "end_seconds": 68.42,
      "duration_seconds": 2.17,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.75,
      "end_seconds": 72.59,
      "duration_seconds": 2.84,
      "text": "I'm allergic to peanuts, I get hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.06,
      "end_seconds": 76.35,
      "duration_seconds": 2.29,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.19,
      "end_seconds": 78.88,
      "duration_seconds": 1.69,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.86,
      "end_seconds": 80.93,
      "duration_seconds": 1.07,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.47,
      "end_seconds": 84.51,
      "duration_seconds": 3.04,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.46,
      "end_seconds": 87.0,
      "duration_seconds": 1.54,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.23,
      "end_seconds": 90.4,
      "duration_seconds": 2.17,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.21,
      "end_seconds": 102.27,
      "duration_seconds": 11.06,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 105.22,
      "duration_seconds": 1.67,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.29,
      "end_seconds": 109.71,
      "duration_seconds": 3.42,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.54,
      "end_seconds": 112.24,
      "duration_seconds": 1.7,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.79,
      "end_seconds": 116.86,
      "duration_seconds": 4.07,
      "text": "Right, do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.88,
      "end_seconds": 133.05,
      "duration_seconds": 11.17,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.46,
      "end_seconds": 141.09,
      "duration_seconds": 6.63,
      "text": "Okay, any medical conditions, anything you've been treated for? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.82,
      "end_seconds": 144.59,
      "duration_seconds": 2.77,
      "text": "Well, no, I've never had anything serious."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.75,
      "end_seconds": 147.74,
      "duration_seconds": 1.99,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.96,
      "end_seconds": 152.83,
      "duration_seconds": 0.87,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.04,
      "end_seconds": 156.76,
      "duration_seconds": 2.72,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.96,
      "end_seconds": 161.35,
      "duration_seconds": 1.39,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.09,
      "end_seconds": 169.38,
      "duration_seconds": 4.29,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.48,
      "end_seconds": 174.31,
      "duration_seconds": 3.83,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.33,
      "end_seconds": 190.58,
      "duration_seconds": 15.25,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.67,
      "end_seconds": 193.71,
      "duration_seconds": 2.04,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.2,
      "end_seconds": 200.9,
      "duration_seconds": 5.7,
      "text": "Right, here's what I'm thinking. It fits best with low sugar episodes related to diabetes medication."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.43,
      "end_seconds": 207.03,
      "duration_seconds": 4.6,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.03,
      "end_seconds": 226.76,
      "duration_seconds": 16.73,
      "text": "I can't promise yet, but most people with low sugar episodes related to diabetes medication do well once it's treated properly. Let me just recap so I've got it right. You've had shaky spells for about two weeks, mild, and no confusion or seizure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.48,
      "end_seconds": 229.25,
      "duration_seconds": 1.77,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.05,
      "end_seconds": 232.52,
      "duration_seconds": 2.47,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.33,
      "end_seconds": 234.12,
      "duration_seconds": 0.79,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 256.81,
      "duration_seconds": 9.71,
      "text": "Okay, here we go. I'd like to arrange a blood sugar test for hypoglycaemia. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.71,
      "end_seconds": 260.44,
      "duration_seconds": 2.73,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.27,
      "end_seconds": 287.53,
      "duration_seconds": 23.26,
      "text": "Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Keep an eye out, and if you black out or can't wake up properly after an episode, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.84,
      "end_seconds": 289.54,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.24,
      "end_seconds": 292.42,
      "duration_seconds": 2.18,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.19,
      "end_seconds": 296.71,
      "duration_seconds": 3.52,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.25,
      "end_seconds": 304.48,
      "duration_seconds": 6.23,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.0,
      "end_seconds": 310.49,
      "duration_seconds": 4.49,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.02,
      "end_seconds": 314.85,
      "duration_seconds": 2.83,
      "text": "Yes, exactly right. Alright, good. Look after yourself."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.24,
      "end_seconds": 319.0,
      "duration_seconds": 2.76,
      "text": "I appreciate your time, uh, doctor."
    }
  ]
}