{
  "schema_version": "1.0",
  "encounter_id": "00249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 5.38,
      "duration_seconds": 4.26,
      "text": "Hmm, hello, doctor. It's my turn, I think."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 10.71,
      "duration_seconds": 4.26,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.07,
      "end_seconds": 24.13,
      "duration_seconds": 13.06,
      "text": "Right, hello, doctor. I hope it's alright if I stay in for this. It's, It's been getting breathless walking short distances, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.43,
      "end_seconds": 26.86,
      "duration_seconds": 2.43,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.85,
      "end_seconds": 29.83,
      "duration_seconds": 1.98,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.25,
      "end_seconds": 40.54,
      "duration_seconds": 10.29,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 48.52,
      "duration_seconds": 7.5,
      "text": "It just comes and goes. I get some relief from stopping to rest. Walking uphill definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.48,
      "end_seconds": 52.03,
      "duration_seconds": 2.55,
      "text": "Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.25,
      "end_seconds": 69.49,
      "duration_seconds": 16.24,
      "text": "Well, when it starts I tend to get tiredness as well. Yeah, you know, the tiredness? That's been for about a year. Hmm, uh, there's a feeling that I can't take a deep breath as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.26,
      "end_seconds": 74.75,
      "duration_seconds": 4.49,
      "text": "Let me check a few things. Any chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.33,
      "end_seconds": 80.38,
      "duration_seconds": 4.05,
      "text": "Okay, so no, no chest pain or weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.74,
      "end_seconds": 84.71,
      "duration_seconds": 2.97,
      "text": "Have you had any leg swelling or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.76,
      "end_seconds": 89.16,
      "duration_seconds": 3.4,
      "text": "Well, uh, nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.88,
      "end_seconds": 92.93,
      "duration_seconds": 3.05,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.0,
      "end_seconds": 95.49,
      "duration_seconds": 1.49,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.14,
      "end_seconds": 97.78,
      "duration_seconds": 1.64,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.28,
      "end_seconds": 103.37,
      "duration_seconds": 5.09,
      "text": "Yes, I had my appendix out, about eight years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.81,
      "end_seconds": 110.22,
      "duration_seconds": 5.41,
      "text": "Do you have any known allergies at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.76,
      "end_seconds": 113.5,
      "duration_seconds": 2.74,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.86,
      "end_seconds": 118.98,
      "duration_seconds": 4.12,
      "text": "Okay, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.15,
      "end_seconds": 135.5,
      "duration_seconds": 15.35,
      "text": "I've, I've got asthma. I took the morning off to come in today. I looked a few things up online, uh, and that probably didn't help. I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.91,
      "end_seconds": 146.86,
      "duration_seconds": 10.95,
      "text": "Yes, I can see the asthma in your file as well. Right, so that's your known high blood pressure. We'll keep that in mind today. Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.29,
      "end_seconds": 151.16,
      "duration_seconds": 2.87,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.57,
      "end_seconds": 154.03,
      "duration_seconds": 1.46,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.0,
      "end_seconds": 157.41,
      "duration_seconds": 2.41,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.07,
      "end_seconds": 160.34,
      "duration_seconds": 2.27,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.1,
      "end_seconds": 168.53,
      "duration_seconds": 5.43,
      "text": "I'm on ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 169.93,
      "end_seconds": 178.66,
      "duration_seconds": 8.73,
      "text": "Doctor, I think the last prescription for the ramipril was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 182.76,
      "duration_seconds": 3.17,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 191.5,
      "duration_seconds": 7.8,
      "text": "Not with me. I'll bring it next time. I'd been on Asthalin inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 194.71,
      "duration_seconds": 1.87,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.83,
      "end_seconds": 207.24,
      "duration_seconds": 1.41,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.6,
      "end_seconds": 225.96,
      "duration_seconds": 7.36,
      "text": "Okay: respiratory rate 20, saturation 92 percent. And temp 37.1 degrees, pressure 132 over 83, heart rate 88."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.71,
      "end_seconds": 232.14,
      "duration_seconds": 3.43,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.71,
      "end_seconds": 233.41,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.22,
      "end_seconds": 236.99,
      "duration_seconds": 1.77,
      "text": "Let me check your reflexes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.07,
      "end_seconds": 252.55,
      "duration_seconds": 3.48,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.42,
      "end_seconds": 255.21,
      "duration_seconds": 1.79,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.05,
      "end_seconds": 275.85,
      "duration_seconds": 1.8,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.21,
      "end_seconds": 295.69,
      "duration_seconds": 17.48,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Okay, so my impression is this: My working impression is chronic breathlessness that needs a proper work-up. I can't rule out anaemia yet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.77,
      "end_seconds": 302.37,
      "duration_seconds": 5.6,
      "text": "Um, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.73,
      "end_seconds": 313.94,
      "duration_seconds": 11.21,
      "text": "It's reasonable to be concerned, but right now chronic breathlessness that needs a proper work-up is my leading thought, not anything worse. Let's get a chest X-ray, for chronic breathlessness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.68,
      "end_seconds": 316.23,
      "duration_seconds": 1.55,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.22,
      "end_seconds": 342.52,
      "duration_seconds": 25.3,
      "text": "We should do an echocardiogram for breathlessness. It's a routine test and it'll give us a much clearer picture. I'd like to arrange a CT scan of the chest for chronic breathlessness. The result will help us decide whether anything more is needed. Try a daily walk and note how far you get before you need to stop. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.98,
      "end_seconds": 347.06,
      "duration_seconds": 3.08,
      "text": "I'll also refer you to a chest physician."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.14,
      "end_seconds": 349.59,
      "duration_seconds": 1.45,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.87,
      "end_seconds": 358.07,
      "duration_seconds": 7.2,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.57,
      "end_seconds": 360.97,
      "duration_seconds": 1.4,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.59,
      "end_seconds": 370.64,
      "duration_seconds": 7.05,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.05,
      "end_seconds": 374.09,
      "duration_seconds": 2.04,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.54,
      "end_seconds": 378.61,
      "duration_seconds": 3.07,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.95,
      "end_seconds": 381.47,
      "duration_seconds": 2.52,
      "text": "So, okay, I'll book that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.63,
      "end_seconds": 386.44,
      "duration_seconds": 3.81,
      "text": "I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.63,
      "end_seconds": 391.14,
      "duration_seconds": 3.51,
      "text": "Uh, no, you've explained it well. Thanks."
    }
  ]
}