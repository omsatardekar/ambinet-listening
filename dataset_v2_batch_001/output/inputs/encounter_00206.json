{
  "schema_version": "1.0",
  "encounter_id": "00206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.79,
      "end_seconds": 6.17,
      "duration_seconds": 5.38,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.07,
      "end_seconds": 13.33,
      "duration_seconds": 3.26,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.89,
      "end_seconds": 21.88,
      "duration_seconds": 6.99,
      "text": "I've been dealing with a cough. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.03,
      "end_seconds": 26.29,
      "duration_seconds": 3.26,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.71,
      "end_seconds": 34.76,
      "duration_seconds": 7.05,
      "text": "It's been like this since this morning. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.77,
      "end_seconds": 44.0,
      "duration_seconds": 8.23,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.34,
      "end_seconds": 57.06,
      "duration_seconds": 11.72,
      "text": "Cold air and lying down definitely sets it off. I get some relief from honey and warm water. Severe, I'd say. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.81,
      "end_seconds": 62.92,
      "duration_seconds": 5.11,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 63.02,
      "end_seconds": 68.32,
      "duration_seconds": 5.3,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.84,
      "end_seconds": 71.91,
      "duration_seconds": 2.07,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.37,
      "end_seconds": 80.21,
      "duration_seconds": 6.84,
      "text": "I've also had a low fever, for one week. And I've been coughing up yellow phlegm as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.14,
      "end_seconds": 84.67,
      "duration_seconds": 3.53,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.41,
      "end_seconds": 87.32,
      "duration_seconds": 1.91,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.95,
      "end_seconds": 92.49,
      "duration_seconds": 4.54,
      "text": "Have you had a cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.44,
      "end_seconds": 97.18,
      "duration_seconds": 3.74,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 98.19,
      "end_seconds": 101.65,
      "duration_seconds": 3.46,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.48,
      "end_seconds": 105.33,
      "duration_seconds": 2.85,
      "text": "Any chest pain, leg swelling or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.98,
      "end_seconds": 121.64,
      "duration_seconds": 11.66,
      "text": "No, no chest pain, no leg swelling, no weight loss. I did have a tight chest at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.64,
      "end_seconds": 129.64,
      "duration_seconds": 4.0,
      "text": "Any shortness of breath, coughing up blood or night sweats?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.79,
      "end_seconds": 133.8,
      "duration_seconds": 3.01,
      "text": "Oh, you know, nothing like that, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.76,
      "end_seconds": 137.77,
      "duration_seconds": 3.01,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 139.9,
      "duration_seconds": 1.61,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.81,
      "end_seconds": 144.05,
      "duration_seconds": 3.24,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.12,
      "end_seconds": 149.43,
      "duration_seconds": 2.31,
      "text": "So, no, all normal there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 149.94,
      "end_seconds": 158.95,
      "duration_seconds": 9.01,
      "text": "Okay, so the vitals from earlier. Blood pressure 115 over 66, temp 39.1 degrees, heart rate 90. Respiratory rate 20, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.26,
      "end_seconds": 164.28,
      "duration_seconds": 5.02,
      "text": "Thanks. Any allergies I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.68,
      "end_seconds": 176.01,
      "duration_seconds": 11.33,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.79,
      "end_seconds": 179.0,
      "duration_seconds": 2.21,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.51,
      "end_seconds": 183.4,
      "duration_seconds": 2.89,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.74,
      "end_seconds": 194.03,
      "duration_seconds": 7.29,
      "text": "Right, what about your general health, any conditions you're being treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.59,
      "end_seconds": 209.22,
      "duration_seconds": 14.63,
      "text": "High blood pressure, for nearly five years. I told myself I'd wait and see, and here I am. Asthma, for about a year. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.23,
      "end_seconds": 211.21,
      "duration_seconds": 0.98,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.89,
      "end_seconds": 219.11,
      "duration_seconds": 5.22,
      "text": "Thin bones, for nearly five years. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.72,
      "end_seconds": 220.83,
      "duration_seconds": 1.11,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.86,
      "end_seconds": 229.71,
      "duration_seconds": 7.85,
      "text": "Yeah, uh, I've had epilepsy for about a year now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.09,
      "end_seconds": 242.35,
      "duration_seconds": 9.26,
      "text": "Right. Right, so that's your known high blood pressure. We'll keep that in mind today. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.38,
      "end_seconds": 245.48,
      "duration_seconds": 2.1,
      "text": "It's losartan, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.82,
      "end_seconds": 248.56,
      "duration_seconds": 1.74,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.68,
      "end_seconds": 257.21,
      "duration_seconds": 7.53,
      "text": "50 milligrams, I think that's what's on the box. Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.59,
      "end_seconds": 265.24,
      "duration_seconds": 6.65,
      "text": "It's a... um, you know, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.38,
      "end_seconds": 268.27,
      "duration_seconds": 1.89,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 268.94,
      "end_seconds": 278.87,
      "duration_seconds": 9.93,
      "text": "For my bones, I believe. My husband sets them out for me, I just take what I'm given. Paracetamol. I take it 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.82,
      "end_seconds": 282.46,
      "duration_seconds": 2.64,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.26,
      "end_seconds": 289.42,
      "duration_seconds": 6.16,
      "text": "For nearly five years. I, I was on levetiracetam before. I stopped taking it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.07,
      "end_seconds": 293.55,
      "duration_seconds": 1.48,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 294.22,
      "end_seconds": 297.6,
      "duration_seconds": 3.38,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.69,
      "end_seconds": 299.64,
      "duration_seconds": 0.95,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.82,
      "end_seconds": 302.03,
      "duration_seconds": 1.21,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.79,
      "end_seconds": 307.53,
      "duration_seconds": 2.74,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 307.92,
      "end_seconds": 309.89,
      "duration_seconds": 1.97,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.53,
      "end_seconds": 315.2,
      "duration_seconds": 2.67,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.18,
      "end_seconds": 319.88,
      "duration_seconds": 2.7,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.92,
      "end_seconds": 333.61,
      "duration_seconds": 1.69,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.36,
      "end_seconds": 337.97,
      "duration_seconds": 2.61,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.17,
      "end_seconds": 353.05,
      "duration_seconds": 2.88,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.67,
      "end_seconds": 376.51,
      "duration_seconds": 19.84,
      "text": "Okay, that's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Putting it all together, my working impression is acute bronchitis. The reason I say that is that your story and my examination fit together. I'd also keep pneumonia in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 377.14,
      "end_seconds": 380.44,
      "duration_seconds": 3.3,
      "text": "I mean, is this going to go away?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.6,
      "end_seconds": 390.05,
      "duration_seconds": 6.45,
      "text": "Nothing I've seen today points to an emergency. It looks like acute bronchitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 390.47,
      "end_seconds": 394.19,
      "duration_seconds": 3.72,
      "text": "I've already done a chest X-ray, it's ready for you."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.28,
      "end_seconds": 404.41,
      "duration_seconds": 7.13,
      "text": "Perfect. Let's get blood tests, for cough. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 405.52,
      "end_seconds": 407.86,
      "duration_seconds": 2.34,
      "text": "The earliest is Monday, 3:30 pm."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.45,
      "end_seconds": 434.05,
      "duration_seconds": 25.6,
      "text": "I'll start you on azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. That's for chest infection. The pharmacy will go through the details again when you pick it up. Let's use salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. It's for wheeze. Steam and warm fluids can ease the cough, and try to sleep with your head propped up."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.43,
      "end_seconds": 454.2,
      "duration_seconds": 18.77,
      "text": "Please take the tablets with food so they don't upset your stomach. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't sit on it if you become breathless or cough up blood. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 454.78,
      "end_seconds": 456.6,
      "duration_seconds": 1.82,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.14,
      "end_seconds": 461.46,
      "duration_seconds": 3.32,
      "text": "I'd like to see you again in a week."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 461.77,
      "end_seconds": 465.3,
      "duration_seconds": 3.53,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.18,
      "end_seconds": 469.44,
      "duration_seconds": 3.26,
      "text": "Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 469.8,
      "end_seconds": 471.56,
      "duration_seconds": 1.76,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.97,
      "end_seconds": 473.96,
      "duration_seconds": 0.99,
      "text": "See you then."
    }
  ]
}