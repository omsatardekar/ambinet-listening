{
  "schema_version": "1.0",
  "encounter_id": "00186",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.5,
      "duration_seconds": 2.3,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.91,
      "end_seconds": 4.61,
      "duration_seconds": 0.7,
      "text": "Hi."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.12,
      "end_seconds": 8.52,
      "duration_seconds": 2.4,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.07,
      "end_seconds": 14.03,
      "duration_seconds": 3.96,
      "text": "Yes, that's no problem at all. Please sit. Busy day out there?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.41,
      "end_seconds": 19.16,
      "duration_seconds": 3.75,
      "text": "Uh, always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.56,
      "end_seconds": 22.23,
      "duration_seconds": 1.67,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.62,
      "end_seconds": 34.2,
      "duration_seconds": 10.58,
      "text": "So the thing is, um, I've got a fever for days. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.72,
      "end_seconds": 39.78,
      "duration_seconds": 5.06,
      "text": "When did you first notice it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.6,
      "end_seconds": 43.94,
      "duration_seconds": 3.34,
      "text": "Right, it's been going on for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.19,
      "end_seconds": 47.18,
      "duration_seconds": 2.99,
      "text": "Right. How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.13,
      "end_seconds": 49.35,
      "duration_seconds": 1.22,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.92,
      "end_seconds": 51.16,
      "duration_seconds": 1.24,
      "text": "Okay, I'm following."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.74,
      "end_seconds": 55.87,
      "duration_seconds": 3.13,
      "text": "I've been feeling weak too, for one week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.59,
      "end_seconds": 58.73,
      "duration_seconds": 2.14,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.15,
      "end_seconds": 66.51,
      "duration_seconds": 7.36,
      "text": "About a four out of ten. I did have a bad headache at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.43,
      "end_seconds": 72.59,
      "duration_seconds": 5.16,
      "text": "Any rash, burning when passing urine or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.19,
      "end_seconds": 75.03,
      "duration_seconds": 1.84,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.78,
      "end_seconds": 77.5,
      "duration_seconds": 1.72,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.41,
      "end_seconds": 80.27,
      "duration_seconds": 1.86,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.8,
      "end_seconds": 83.97,
      "duration_seconds": 3.17,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.0,
      "end_seconds": 88.42,
      "duration_seconds": 3.42,
      "text": "I mean, yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.52,
      "end_seconds": 91.55,
      "duration_seconds": 2.03,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.69,
      "end_seconds": 100.71,
      "duration_seconds": 8.02,
      "text": "Okay, so yes, I had cataract surgery on my right eye, last year. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.32,
      "end_seconds": 104.81,
      "duration_seconds": 3.49,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.25,
      "end_seconds": 112.54,
      "duration_seconds": 6.29,
      "text": "Hmm, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.49,
      "end_seconds": 116.85,
      "duration_seconds": 3.36,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 122.72,
      "duration_seconds": 4.49,
      "text": "I'm allergic to penicillin, I get swelling of my face."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.31,
      "end_seconds": 138.01,
      "duration_seconds": 14.7,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.45,
      "end_seconds": 141.52,
      "duration_seconds": 3.07,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 145.84,
      "duration_seconds": 4.01,
      "text": "What medicines do you take regularly? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.5,
      "end_seconds": 152.89,
      "duration_seconds": 6.39,
      "text": "It's metformin, 500 milligrams, twice a day. Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.62,
      "end_seconds": 156.93,
      "duration_seconds": 3.31,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.44,
      "end_seconds": 169.44,
      "duration_seconds": 12.0,
      "text": "Uh, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.44,
      "end_seconds": 173.91,
      "duration_seconds": 3.47,
      "text": "Alright, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.72,
      "end_seconds": 180.71,
      "duration_seconds": 5.99,
      "text": "I've had diabetes, yes. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.28,
      "end_seconds": 185.43,
      "duration_seconds": 4.15,
      "text": "Alright. Yes, I can see the diabetes in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.52,
      "end_seconds": 189.94,
      "duration_seconds": 3.42,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.27,
      "end_seconds": 190.97,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.29,
      "end_seconds": 203.92,
      "duration_seconds": 2.63,
      "text": "Right, thanks for waiting. How about smoking?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.95,
      "end_seconds": 206.24,
      "duration_seconds": 1.29,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.76,
      "end_seconds": 209.25,
      "duration_seconds": 1.49,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.04,
      "end_seconds": 212.09,
      "duration_seconds": 2.05,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.23,
      "end_seconds": 216.34,
      "duration_seconds": 3.11,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.8,
      "end_seconds": 217.66,
      "duration_seconds": 0.86,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.09,
      "end_seconds": 241.68,
      "duration_seconds": 16.59,
      "text": "Okay, here we go. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.82,
      "end_seconds": 245.71,
      "duration_seconds": 2.89,
      "text": "Um, thank you, that really helps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.28,
      "end_seconds": 250.53,
      "duration_seconds": 3.25,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.28,
      "end_seconds": 254.8,
      "duration_seconds": 2.52,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.23,
      "end_seconds": 272.32,
      "duration_seconds": 4.09,
      "text": "Your tummy is a bit full and tender in the lower part."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.09,
      "end_seconds": 298.11,
      "duration_seconds": 23.02,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Okay, so my impression is this: I think we're dealing with typhoid fever, which we need to confirm at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.65,
      "end_seconds": 302.55,
      "duration_seconds": 2.9,
      "text": "So, should I be worried about this?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.06,
      "end_seconds": 323.36,
      "duration_seconds": 20.3,
      "text": "I understand the worry. At the moment I'd say it's typhoid fever, which we need to confirm, and we'll know more once the a malaria test is back. Let me just recap so I've got it right. You've had a fever for days for two weeks, severe, and no rash or burning when passing urine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.23,
      "end_seconds": 326.42,
      "duration_seconds": 2.19,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.5,
      "end_seconds": 354.27,
      "duration_seconds": 26.77,
      "text": "We should do a malaria test for fever. It's a routine test and it'll give us a much clearer picture. Let's get blood cultures, for prolonged fever. The result will help us decide whether anything more is needed. Eat only home-cooked food and drink boiled or bottled water while this is going on. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.14,
      "end_seconds": 371.34,
      "duration_seconds": 16.2,
      "text": "If you smoke, this is a good moment to think about stopping, and we can help you with that. Please don't sit on it if the fever stays high or the tummy pain gets sharp. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.5,
      "end_seconds": 374.41,
      "duration_seconds": 1.91,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.84,
      "end_seconds": 378.18,
      "duration_seconds": 3.34,
      "text": "I'd like to see you again in three days."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.81,
      "end_seconds": 379.51,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.59,
      "end_seconds": 386.35,
      "duration_seconds": 5.76,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.76,
      "end_seconds": 390.48,
      "duration_seconds": 3.72,
      "text": "So, I come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.0,
      "end_seconds": 396.22,
      "duration_seconds": 4.22,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.54,
      "end_seconds": 400.69,
      "duration_seconds": 4.15,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.25,
      "end_seconds": 403.49,
      "duration_seconds": 1.24,
      "text": "Okay, take care."
    }
  ]
}