{
  "schema_version": "1.0",
  "encounter_id": "00109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 4.45,
      "duration_seconds": 3.06,
      "text": "Morning. Nice to finally see you, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.92,
      "end_seconds": 10.31,
      "duration_seconds": 4.39,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.68,
      "end_seconds": 16.07,
      "duration_seconds": 5.39,
      "text": "Okay, uh, so thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.39,
      "end_seconds": 20.16,
      "duration_seconds": 2.77,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.88,
      "end_seconds": 22.77,
      "duration_seconds": 1.89,
      "text": "We came because of wheezing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 26.31,
      "duration_seconds": 2.35,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.84,
      "end_seconds": 38.66,
      "duration_seconds": 10.82,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.12,
      "end_seconds": 42.72,
      "duration_seconds": 3.6,
      "text": "Okay, I'm following. How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.03,
      "end_seconds": 50.23,
      "duration_seconds": 5.2,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.78,
      "end_seconds": 55.36,
      "duration_seconds": 4.58,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.56,
      "end_seconds": 59.18,
      "duration_seconds": 2.62,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.91,
      "end_seconds": 62.34,
      "duration_seconds": 2.43,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.46,
      "end_seconds": 66.33,
      "duration_seconds": 2.87,
      "text": "Yes, cold air. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.22,
      "end_seconds": 74.05,
      "duration_seconds": 6.83,
      "text": "Um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 74.15,
      "end_seconds": 79.52,
      "duration_seconds": 5.37,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 83.22,
      "duration_seconds": 2.11,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.77,
      "end_seconds": 90.03,
      "duration_seconds": 5.26,
      "text": "Oh, and I've been using my blue inhaler more as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 95.21,
      "duration_seconds": 3.98,
      "text": "Alright, have you had wheezing before, or is this the first time?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.72,
      "end_seconds": 103.94,
      "duration_seconds": 8.22,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 107.18,
      "end_seconds": 108.92,
      "duration_seconds": 1.74,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.44,
      "end_seconds": 112.71,
      "duration_seconds": 2.27,
      "text": "Any weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.72,
      "end_seconds": 125.41,
      "duration_seconds": 11.69,
      "text": "No, no weight loss, no chest pain. I did have a night-time cough at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.06,
      "end_seconds": 130.43,
      "duration_seconds": 4.37,
      "text": "Let me check a few things. Any runny nose or leg swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.45,
      "end_seconds": 139.39,
      "duration_seconds": 4.94,
      "text": "I mean, I haven't had runny nose or leg swelling, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.77,
      "end_seconds": 144.46,
      "duration_seconds": 1.69,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.8,
      "end_seconds": 147.25,
      "duration_seconds": 1.45,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 147.82,
      "end_seconds": 153.6,
      "duration_seconds": 5.78,
      "text": "Hmm, actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.94,
      "end_seconds": 162.03,
      "duration_seconds": 7.09,
      "text": "No, uh, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.22,
      "end_seconds": 168.97,
      "duration_seconds": 5.75,
      "text": "Alright, I'll note both what you've said and what you've noticed. And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.87,
      "end_seconds": 172.52,
      "duration_seconds": 2.65,
      "text": "Well, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.05,
      "end_seconds": 175.72,
      "duration_seconds": 2.67,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.1,
      "end_seconds": 180.81,
      "duration_seconds": 3.71,
      "text": "Right, uh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.95,
      "end_seconds": 182.93,
      "duration_seconds": 0.98,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.38,
      "end_seconds": 187.02,
      "duration_seconds": 3.64,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.68,
      "end_seconds": 191.54,
      "duration_seconds": 1.86,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.05,
      "end_seconds": 197.26,
      "duration_seconds": 4.21,
      "text": "Ibuprofen, I'd say. I'm allergic to pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.83,
      "end_seconds": 198.78,
      "duration_seconds": 0.95,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.1,
      "end_seconds": 201.88,
      "duration_seconds": 2.78,
      "text": "No, uh, nothing like that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.28,
      "end_seconds": 206.73,
      "duration_seconds": 3.45,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.16,
      "end_seconds": 211.44,
      "duration_seconds": 4.28,
      "text": "I'm on Asthalin inhaler, when needed for my asthma."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.32,
      "end_seconds": 214.69,
      "duration_seconds": 2.37,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.39,
      "end_seconds": 224.73,
      "duration_seconds": 9.34,
      "text": "Nearly five years now. Hydrocortisone cream. I take it when needed. I'm on spironolactone, 25 milligrams, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 225.19,
      "end_seconds": 232.6,
      "duration_seconds": 7.41,
      "text": "Doctor, I think the last prescription for the spironolactone was 50 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 236.36,
      "duration_seconds": 2.36,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.13,
      "end_seconds": 239.7,
      "duration_seconds": 2.57,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.34,
      "end_seconds": 243.08,
      "duration_seconds": 2.74,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.31,
      "end_seconds": 262.92,
      "duration_seconds": 18.61,
      "text": "I've had asthma for about a year now. I just want to get back to normal, really. I've never really been one for hospitals. Eczema, for five years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.13,
      "end_seconds": 266.91,
      "duration_seconds": 0.78,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.75,
      "end_seconds": 269.33,
      "duration_seconds": 1.58,
      "text": "Yes, heart failure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.85,
      "end_seconds": 272.79,
      "duration_seconds": 1.94,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.06,
      "end_seconds": 278.31,
      "duration_seconds": 4.25,
      "text": "My mother has migraines. Yeah, my uncle had colon cancer."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 279.89,
      "end_seconds": 290.33,
      "duration_seconds": 10.44,
      "text": "Doctor, I've got the readings for you. Respiratory rate 21, temp 37.5 degrees, oxygen saturation is 89 percent, pulse is 101 beats a minute, pressure 126 over 88."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.79,
      "end_seconds": 291.49,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.54,
      "end_seconds": 295.23,
      "duration_seconds": 1.69,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.71,
      "end_seconds": 296.41,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.12,
      "end_seconds": 301.37,
      "duration_seconds": 3.25,
      "text": "Right, tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.47,
      "end_seconds": 318.68,
      "duration_seconds": 4.21,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.07,
      "end_seconds": 323.52,
      "duration_seconds": 3.45,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.91,
      "end_seconds": 335.81,
      "duration_seconds": 2.9,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.45,
      "end_seconds": 369.14,
      "duration_seconds": 30.69,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Right, here's what I'm thinking. It fits best with an asthma flare-up. It could also be an allergic reaction, so we'll keep that open. I can't rule out a chest infection yet. We should do breathing tests for asthma. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.54,
      "end_seconds": 373.78,
      "duration_seconds": 3.24,
      "text": "I'm going to order a chest X-ray, for wheeze."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.41,
      "end_seconds": 375.71,
      "duration_seconds": 1.3,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 378.86,
      "end_seconds": 382.11,
      "duration_seconds": 3.25,
      "text": "We've already done a peak flow reading this morning, doctor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.21,
      "end_seconds": 395.93,
      "duration_seconds": 12.72,
      "text": "Okay, thanks, I'll look at that. Let's use Seretide inhaler, 250 micrograms, two puffs twice a day, long term. It's for asthma control. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.23,
      "end_seconds": 398.93,
      "duration_seconds": 1.7,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.34,
      "end_seconds": 425.65,
      "duration_seconds": 25.31,
      "text": "I'm prescribing prednisolone, 30 milligrams, once a day, for five days. That should help with asthma flare-up. The pharmacy will go through the details again when you pick it up. Rinse your mouth after the steroid inhaler. Let me watch you use the inhaler, a lot of people don't get the full dose. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.12,
      "end_seconds": 427.71,
      "duration_seconds": 1.59,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.16,
      "end_seconds": 440.93,
      "duration_seconds": 11.77,
      "text": "If the inhaler isn't helping or you can't speak in full sentences, or you feel really unwell, please don't wait, come to the emergency department. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.14,
      "end_seconds": 442.84,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.79,
      "end_seconds": 450.01,
      "duration_seconds": 3.22,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.4,
      "end_seconds": 454.36,
      "duration_seconds": 3.96,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}