{
  "schema_version": "1.0",
  "encounter_id": "00331",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 7.08,
      "duration_seconds": 5.83,
      "text": "Hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.45,
      "end_seconds": 10.75,
      "duration_seconds": 3.3,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.6,
      "end_seconds": 21.35,
      "duration_seconds": 6.75,
      "text": "Well, I've been having fever with chills. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.26,
      "end_seconds": 24.27,
      "duration_seconds": 2.01,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.65,
      "end_seconds": 33.01,
      "duration_seconds": 8.36,
      "text": "It's been going on for one week. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.75,
      "end_seconds": 40.73,
      "duration_seconds": 6.98,
      "text": "Okay, give me more detail on it, whatever comes to mind. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.72,
      "end_seconds": 48.15,
      "duration_seconds": 6.43,
      "text": "It's severe, honestly. It settles a little with paracetamol. I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.13,
      "end_seconds": 51.79,
      "duration_seconds": 2.66,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.21,
      "end_seconds": 52.93,
      "duration_seconds": 0.72,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.06,
      "end_seconds": 65.57,
      "duration_seconds": 3.51,
      "text": "Okay, here we go. Have you had any rash or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.89,
      "end_seconds": 68.73,
      "duration_seconds": 2.84,
      "text": "No rash or cough, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.03,
      "end_seconds": 83.87,
      "duration_seconds": 13.84,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.16,
      "end_seconds": 86.85,
      "duration_seconds": 1.69,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.91,
      "end_seconds": 89.82,
      "duration_seconds": 1.91,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.35,
      "end_seconds": 92.55,
      "duration_seconds": 1.2,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.05,
      "end_seconds": 97.39,
      "duration_seconds": 3.34,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 105.83,
      "duration_seconds": 7.13,
      "text": "Hmm, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 109.74,
      "duration_seconds": 2.7,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.85,
      "end_seconds": 113.5,
      "duration_seconds": 2.65,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.23,
      "end_seconds": 117.7,
      "duration_seconds": 3.47,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.01,
      "end_seconds": 135.01,
      "duration_seconds": 2.0,
      "text": "Okay, that's done. Any regular medication?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.35,
      "end_seconds": 138.03,
      "duration_seconds": 2.68,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.84,
      "end_seconds": 142.27,
      "duration_seconds": 3.43,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.82,
      "end_seconds": 148.83,
      "duration_seconds": 2.01,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.71,
      "end_seconds": 152.98,
      "duration_seconds": 3.27,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.2,
      "end_seconds": 157.16,
      "duration_seconds": 2.96,
      "text": "Uh, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.53,
      "end_seconds": 159.52,
      "duration_seconds": 1.99,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.15,
      "end_seconds": 175.03,
      "duration_seconds": 1.88,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.69,
      "end_seconds": 198.03,
      "duration_seconds": 7.34,
      "text": "Okay: blood pressure 109 over 75, weight 70 kilos, temp 38.6 degrees. And pulse 100, height 162 centimetres."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.12,
      "end_seconds": 200.47,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.77,
      "end_seconds": 208.98,
      "duration_seconds": 7.21,
      "text": "We'll put it in context in a moment. Okay, is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.54,
      "end_seconds": 213.25,
      "duration_seconds": 2.71,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.25,
      "end_seconds": 227.04,
      "duration_seconds": 12.79,
      "text": "Okay, so my impression from what you've said is this: I think we're dealing with malaria until proven otherwise at this stage. The reason I say that is that the way you describe it fits together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.98,
      "end_seconds": 230.73,
      "duration_seconds": 2.75,
      "text": "Hmm, is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.25,
      "end_seconds": 247.26,
      "duration_seconds": 15.01,
      "text": "I can't promise yet, but most people with malaria until proven otherwise do well once it's treated properly. Let me just recap so I've got it right. You've had fever with chills for one week, severe, and no rash or cough."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.02,
      "end_seconds": 249.41,
      "duration_seconds": 1.39,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.71,
      "end_seconds": 253.25,
      "duration_seconds": 2.54,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.68,
      "end_seconds": 256.13,
      "duration_seconds": 1.45,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.55,
      "end_seconds": 272.88,
      "duration_seconds": 15.33,
      "text": "We should do blood tests for fever. That will help us see what's going on underneath and decide the next step. I'm prescribing paracetamol, 500 milligrams, every six hours if needed, for three days. You take it by mouth. It's for fever and body aches."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.44,
      "end_seconds": 274.45,
      "duration_seconds": 1.01,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.83,
      "end_seconds": 279.23,
      "duration_seconds": 4.4,
      "text": "Let the lab know you travelled recently, that's important for the tests."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.55,
      "end_seconds": 285.59,
      "duration_seconds": 6.04,
      "text": "Go on. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.04,
      "end_seconds": 294.24,
      "duration_seconds": 8.2,
      "text": "Right. I want you to come back or go to emergency straight away if you get confused, very drowsy, or the shaking returns."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.62,
      "end_seconds": 297.19,
      "duration_seconds": 1.57,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.92,
      "end_seconds": 306.01,
      "duration_seconds": 8.09,
      "text": "Let's review you in two days. Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.3,
      "end_seconds": 315.22,
      "duration_seconds": 7.92,
      "text": "So, I take the paracetamol, 500 milligrams, every six hours if needed and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.45,
      "end_seconds": 323.05,
      "duration_seconds": 4.6,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.85,
      "end_seconds": 327.0,
      "duration_seconds": 3.15,
      "text": "No, I think that's everything. Thank you, doctor."
    }
  ]
}