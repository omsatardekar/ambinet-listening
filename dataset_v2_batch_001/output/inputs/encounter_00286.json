{
  "schema_version": "1.0",
  "encounter_id": "00286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.05,
      "duration_seconds": 2.95,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.73,
      "end_seconds": 8.21,
      "duration_seconds": 3.48,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.29,
      "end_seconds": 13.84,
      "duration_seconds": 4.55,
      "text": "Mainly I've been losing weight without trying. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.56,
      "end_seconds": 16.88,
      "duration_seconds": 2.32,
      "text": "Okay, and when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.93,
      "end_seconds": 34.84,
      "duration_seconds": 16.91,
      "text": "I've had it for about a week. I kept putting it off, which I know isn't sensible. I wasn't sure whether to come in at all, to be honest. There's a low fever in the evenings as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.27,
      "end_seconds": 38.94,
      "duration_seconds": 2.67,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.51,
      "end_seconds": 54.84,
      "duration_seconds": 14.33,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.01,
      "end_seconds": 59.82,
      "duration_seconds": 3.81,
      "text": "Have you had any shortness of breath or blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.79,
      "end_seconds": 64.54,
      "duration_seconds": 1.75,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.88,
      "end_seconds": 67.58,
      "duration_seconds": 2.7,
      "text": "I see. And chest pain, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.06,
      "end_seconds": 70.55,
      "duration_seconds": 1.49,
      "text": "No. No chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.07,
      "end_seconds": 75.48,
      "duration_seconds": 4.41,
      "text": "Mm-hm. Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.4,
      "end_seconds": 79.36,
      "duration_seconds": 2.96,
      "text": "Hmm, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.05,
      "end_seconds": 86.25,
      "duration_seconds": 6.2,
      "text": "What about allergies, to medicines or foods or anything else? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.49,
      "end_seconds": 90.59,
      "duration_seconds": 3.1,
      "text": "Not that I know, uh, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 93.47,
      "duration_seconds": 2.23,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.88,
      "end_seconds": 94.69,
      "duration_seconds": 0.81,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 108.35,
      "duration_seconds": 3.47,
      "text": "Okay, here we go. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.57,
      "end_seconds": 113.03,
      "duration_seconds": 1.46,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.0,
      "end_seconds": 116.31,
      "duration_seconds": 2.31,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.85,
      "end_seconds": 120.38,
      "duration_seconds": 2.53,
      "text": "It's perfect, uh, thank you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.84,
      "end_seconds": 121.94,
      "duration_seconds": 1.1,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.34,
      "end_seconds": 124.22,
      "duration_seconds": 0.88,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.77,
      "end_seconds": 129.31,
      "duration_seconds": 3.54,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.62,
      "end_seconds": 142.95,
      "duration_seconds": 12.33,
      "text": "Oh, yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.84,
      "end_seconds": 147.35,
      "duration_seconds": 3.51,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.0,
      "end_seconds": 150.26,
      "duration_seconds": 2.26,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.56,
      "end_seconds": 152.8,
      "duration_seconds": 2.24,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.43,
      "end_seconds": 158.85,
      "duration_seconds": 5.42,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.88,
      "end_seconds": 164.2,
      "duration_seconds": 3.32,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.55,
      "end_seconds": 167.07,
      "duration_seconds": 2.52,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.28,
      "end_seconds": 170.95,
      "duration_seconds": 2.67,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.22,
      "end_seconds": 173.46,
      "duration_seconds": 1.24,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.05,
      "end_seconds": 186.72,
      "duration_seconds": 11.67,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.09,
      "end_seconds": 188.88,
      "duration_seconds": 1.79,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.02,
      "end_seconds": 194.57,
      "duration_seconds": 3.55,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.34,
      "end_seconds": 196.04,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.77,
      "end_seconds": 199.94,
      "duration_seconds": 2.17,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.33,
      "end_seconds": 212.37,
      "duration_seconds": 4.04,
      "text": "Air entry is a bit reduced at the top of the right lung."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.32,
      "end_seconds": 226.37,
      "duration_seconds": 11.05,
      "text": "Okay, that's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 231.75,
      "duration_seconds": 4.22,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.44,
      "end_seconds": 233.14,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.49,
      "end_seconds": 262.29,
      "duration_seconds": 13.8,
      "text": "Alright, I've got it. Right, here's what I'm thinking. It fits best with an infection or something chronic going on, I can't say what yet. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.37,
      "end_seconds": 265.47,
      "duration_seconds": 2.1,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.64,
      "end_seconds": 286.71,
      "duration_seconds": 20.07,
      "text": "Nothing I've seen today points to an emergency. It looks like an infection or something chronic going on, I can't say what yet, but I'd like to confirm. Let me just recap so I've got it right. You've been losing weight without trying for about a week, and no chest pain or shortness of breath."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.03,
      "end_seconds": 289.25,
      "duration_seconds": 1.22,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.23,
      "end_seconds": 293.95,
      "duration_seconds": 3.72,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.82,
      "end_seconds": 297.15,
      "duration_seconds": 2.33,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.68,
      "end_seconds": 323.96,
      "duration_seconds": 26.28,
      "text": "I'm going to order blood tests, for weight loss. I'd rather check than guess, and this is the quickest way to know more. Weigh yourself once a week at the same time and note it down. Please take the tablets with food so they don't upset your stomach. Please don't sit on it if you cough up blood or get breathless. That's the point to get seen urgently. Come back in a week."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.33,
      "end_seconds": 328.7,
      "duration_seconds": 3.37,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 335.28,
      "duration_seconds": 5.59,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.46,
      "end_seconds": 340.91,
      "duration_seconds": 4.45,
      "text": "So, I come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.74,
      "end_seconds": 346.72,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.17,
      "end_seconds": 352.06,
      "duration_seconds": 4.89,
      "text": "Right, um, I think that's clear. Thank you for being so thorough."
    }
  ]
}