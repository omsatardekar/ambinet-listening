{
  "schema_version": "1.0",
  "encounter_id": "00148",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 3.98,
      "duration_seconds": 2.87,
      "text": "Hello, doctor. Where would you like me?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.13,
      "end_seconds": 8.73,
      "duration_seconds": 3.6,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.08,
      "end_seconds": 14.65,
      "duration_seconds": 4.57,
      "text": "Doctor, you know, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.29,
      "end_seconds": 23.16,
      "duration_seconds": 5.87,
      "text": "Mainly a red eye. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.55,
      "end_seconds": 28.08,
      "duration_seconds": 4.53,
      "text": "When did you first notice it? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.48,
      "end_seconds": 37.13,
      "duration_seconds": 7.65,
      "text": "About... well, about two weeks. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.4,
      "end_seconds": 40.13,
      "duration_seconds": 1.73,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.14,
      "end_seconds": 44.24,
      "duration_seconds": 3.1,
      "text": "Only a cold compress, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.78,
      "end_seconds": 46.33,
      "duration_seconds": 1.55,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.09,
      "end_seconds": 53.49,
      "duration_seconds": 5.4,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.32,
      "end_seconds": 59.15,
      "duration_seconds": 4.83,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.53,
      "end_seconds": 61.74,
      "duration_seconds": 1.21,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.4,
      "end_seconds": 68.55,
      "duration_seconds": 6.15,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 68.65,
      "end_seconds": 75.45,
      "duration_seconds": 6.8,
      "text": "Okay, you know, so tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.67,
      "end_seconds": 85.88,
      "duration_seconds": 9.21,
      "text": "I was getting to that! As for watering, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.43,
      "end_seconds": 92.21,
      "duration_seconds": 5.78,
      "text": "Let me check a few things. Any cold, loss of vision or pain in the eye?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.48,
      "end_seconds": 106.86,
      "duration_seconds": 13.38,
      "text": "No, no cold, no loss of vision, no pain in the eye. I did have a sticky discharge in the morning at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.03,
      "end_seconds": 114.81,
      "duration_seconds": 6.78,
      "text": "Let me check a few things. Any contact lens, sensitivity to light or foreign body in the eye?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 118.46,
      "duration_seconds": 2.85,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.05,
      "end_seconds": 122.22,
      "duration_seconds": 3.17,
      "text": "Okay, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 125.11,
      "duration_seconds": 1.78,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.09,
      "end_seconds": 127.98,
      "duration_seconds": 1.89,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.58,
      "end_seconds": 130.24,
      "duration_seconds": 1.66,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.79,
      "end_seconds": 134.55,
      "duration_seconds": 3.76,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.69,
      "end_seconds": 139.8,
      "duration_seconds": 4.11,
      "text": "I have eczema, for nearly five years. Yes, heart failure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.18,
      "end_seconds": 141.88,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.4,
      "end_seconds": 146.02,
      "duration_seconds": 3.62,
      "text": "I have thin bones. I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.4,
      "end_seconds": 150.79,
      "duration_seconds": 3.39,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.55,
      "end_seconds": 152.37,
      "duration_seconds": 0.82,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.38,
      "end_seconds": 167.59,
      "duration_seconds": 3.21,
      "text": "Okay, here we go. So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.54,
      "end_seconds": 180.08,
      "duration_seconds": 11.54,
      "text": "Just cataract surgery on my right eye, last year. It's a relief to finally sit down and talk about it. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.41,
      "end_seconds": 182.54,
      "duration_seconds": 1.13,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.18,
      "end_seconds": 186.45,
      "duration_seconds": 3.27,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.29,
      "end_seconds": 189.14,
      "duration_seconds": 1.85,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.6,
      "end_seconds": 198.57,
      "duration_seconds": 7.97,
      "text": "Right, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.36,
      "end_seconds": 205.29,
      "duration_seconds": 5.93,
      "text": "Are you on any tablets or medication? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.77,
      "end_seconds": 215.21,
      "duration_seconds": 8.44,
      "text": "Hydrocortisone cream. I take it when needed for the eczema. It's spironolactone, 25 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 216.36,
      "end_seconds": 223.08,
      "duration_seconds": 6.72,
      "text": "Doctor, I think the last prescription for the spironolactone was 50 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.54,
      "end_seconds": 228.26,
      "duration_seconds": 3.72,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.54,
      "end_seconds": 238.61,
      "duration_seconds": 9.07,
      "text": "I don't think I have it with me. I take alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.83,
      "end_seconds": 243.6,
      "duration_seconds": 3.77,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.09,
      "end_seconds": 247.14,
      "duration_seconds": 3.05,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.92,
      "end_seconds": 250.05,
      "duration_seconds": 2.13,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.84,
      "end_seconds": 261.16,
      "duration_seconds": 1.32,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 285.36,
      "duration_seconds": 6.12,
      "text": "Okay: BP is 120 over 78, heart rate 75, respiratory rate 15, saturation 99 percent."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.62,
      "end_seconds": 287.92,
      "duration_seconds": 1.3,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.49,
      "end_seconds": 291.58,
      "duration_seconds": 3.09,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.72,
      "end_seconds": 295.65,
      "duration_seconds": 1.93,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.57,
      "end_seconds": 299.65,
      "duration_seconds": 2.08,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.64,
      "end_seconds": 317.3,
      "duration_seconds": 4.66,
      "text": "Your vision is normal on the chart and the pupil reacts well."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.17,
      "end_seconds": 320.94,
      "duration_seconds": 2.77,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.84,
      "end_seconds": 345.41,
      "duration_seconds": 5.57,
      "text": "The white of the eye is pink all over, and there's some sticky discharge on the lashes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.37,
      "end_seconds": 368.4,
      "duration_seconds": 17.03,
      "text": "That's fine, you can get dressed. So, based on the history and the examination, this looks most like conjunctivitis. That's my thinking for now, and it may change as we learn more. I'd also keep a corneal problem in mind. I can't rule out an allergic eye problem yet."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.76,
      "end_seconds": 371.79,
      "duration_seconds": 2.03,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.12,
      "end_seconds": 386.47,
      "duration_seconds": 13.35,
      "text": "I can't promise yet, but most people with conjunctivitis do well once it's treated properly. Let's get an eye swab, for red eye. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 387.3,
      "end_seconds": 390.37,
      "duration_seconds": 3.07,
      "text": "I can book that for Tuesday at 9 am."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.72,
      "end_seconds": 393.67,
      "duration_seconds": 1.95,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.78,
      "end_seconds": 415.83,
      "duration_seconds": 21.05,
      "text": "Let's use chloramphenicol eye drops, four times a day, for five days. That should help with conjunctivitis. The pharmacy will go through the details again when you pick it up. Wash your hands often, don't share towels, and don't rub the eye. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.26,
      "end_seconds": 423.59,
      "duration_seconds": 7.33,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.45,
      "end_seconds": 425.83,
      "duration_seconds": 1.38,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.86,
      "end_seconds": 434.54,
      "duration_seconds": 7.68,
      "text": "Please don't sit on it if your vision drops or the pain gets severe. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.64,
      "end_seconds": 438.22,
      "duration_seconds": 2.58,
      "text": "I mean, got it, thank you."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.19,
      "end_seconds": 441.84,
      "duration_seconds": 2.65,
      "text": "Please come and see me in a week."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.79,
      "end_seconds": 443.49,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.02,
      "end_seconds": 445.33,
      "duration_seconds": 1.31,
      "text": "Good. Look after yourself."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.06,
      "end_seconds": 454.13,
      "duration_seconds": 4.07,
      "text": "Okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.22,
      "end_seconds": 457.27,
      "duration_seconds": 2.05,
      "text": "Bye for now, look after yourself."
    }
  ]
}