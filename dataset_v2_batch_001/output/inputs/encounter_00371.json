{
  "schema_version": "1.0",
  "encounter_id": "00371",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 5.47,
      "duration_seconds": 4.31,
      "text": "Sorry I'm a few minutes behind, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 9.67,
      "duration_seconds": 3.7,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.55,
      "end_seconds": 17.59,
      "duration_seconds": 7.04,
      "text": "I wanted to get a missed period looked at. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.56,
      "end_seconds": 21.26,
      "duration_seconds": 2.7,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.78,
      "end_seconds": 33.75,
      "duration_seconds": 10.97,
      "text": "Probably about four days. Yeah. I'm not great at remembering details, you know, so bear with me. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.06,
      "end_seconds": 37.66,
      "duration_seconds": 2.6,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.37,
      "end_seconds": 42.31,
      "duration_seconds": 3.94,
      "text": "Um, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 55.03,
      "duration_seconds": 11.87,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.49,
      "end_seconds": 57.41,
      "duration_seconds": 1.92,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.77,
      "end_seconds": 64.09,
      "duration_seconds": 5.32,
      "text": "Right, have you had any burning when passing urine, fever or vomiting everything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.52,
      "end_seconds": 70.57,
      "duration_seconds": 5.05,
      "text": "No burning when passing urine, fever or vomiting everything, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.61,
      "end_seconds": 76.43,
      "duration_seconds": 4.82,
      "text": "Alright, what about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.93,
      "end_seconds": 78.74,
      "duration_seconds": 1.81,
      "text": "My father had kidney stones."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.01,
      "end_seconds": 80.71,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.16,
      "end_seconds": 86.47,
      "duration_seconds": 3.31,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.5,
      "end_seconds": 89.0,
      "duration_seconds": 1.5,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.6,
      "end_seconds": 93.48,
      "duration_seconds": 3.88,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.67,
      "end_seconds": 101.03,
      "duration_seconds": 6.36,
      "text": "Any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 104.17,
      "duration_seconds": 2.29,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.68,
      "end_seconds": 106.64,
      "duration_seconds": 0.96,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.47,
      "end_seconds": 112.5,
      "duration_seconds": 5.03,
      "text": "Yes, I had cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.59,
      "end_seconds": 118.2,
      "duration_seconds": 2.61,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.83,
      "end_seconds": 119.59,
      "duration_seconds": 0.76,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.01,
      "end_seconds": 123.41,
      "duration_seconds": 3.4,
      "text": "Alright, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.0,
      "end_seconds": 129.08,
      "duration_seconds": 4.08,
      "text": "I'm on folic acid, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.51,
      "end_seconds": 133.79,
      "duration_seconds": 3.28,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.97,
      "end_seconds": 146.26,
      "duration_seconds": 1.29,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.8,
      "end_seconds": 172.01,
      "duration_seconds": 8.21,
      "text": "Okay: BP is 121 over 82, respiratory rate 16. And saturation 99 percent, pulse is 76 beats a minute, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.41,
      "end_seconds": 174.2,
      "duration_seconds": 1.79,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.44,
      "end_seconds": 178.02,
      "duration_seconds": 2.58,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.84,
      "end_seconds": 182.07,
      "duration_seconds": 3.23,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.95,
      "end_seconds": 183.71,
      "duration_seconds": 0.76,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 198.91,
      "duration_seconds": 1.65,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.16,
      "end_seconds": 204.48,
      "duration_seconds": 3.32,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.53,
      "end_seconds": 208.52,
      "duration_seconds": 2.99,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.92,
      "end_seconds": 230.34,
      "duration_seconds": 5.42,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.32,
      "end_seconds": 245.26,
      "duration_seconds": 10.94,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.46,
      "end_seconds": 250.29,
      "duration_seconds": 3.83,
      "text": "So, yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.4,
      "end_seconds": 272.11,
      "duration_seconds": 18.71,
      "text": "Putting it all together, it fits best with an early pregnancy. That's my thinking for now, and it may change as we learn more. Let me just recap so I've got it right. You've had a missed period for about four days, and no fever or burning when passing urine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.52,
      "end_seconds": 275.12,
      "duration_seconds": 1.6,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.34,
      "end_seconds": 301.28,
      "duration_seconds": 24.94,
      "text": "I'm going to order an early scan, for early pregnancy. Avoid alcohol and don't take any new tablets without checking with us first. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. Don't skip meals, and try to eat smaller portions more often through the day. If you have bleeding or sharp pain on one side, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.43,
      "end_seconds": 304.51,
      "duration_seconds": 2.08,
      "text": "So, yes, I'll do that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.99,
      "end_seconds": 307.5,
      "duration_seconds": 2.51,
      "text": "Please come and see me after the scan."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.98,
      "end_seconds": 308.68,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.75,
      "end_seconds": 313.95,
      "duration_seconds": 4.2,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.32,
      "end_seconds": 318.4,
      "duration_seconds": 4.08,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.95,
      "end_seconds": 324.29,
      "duration_seconds": 4.34,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.88,
      "end_seconds": 327.81,
      "duration_seconds": 1.93,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.96,
      "end_seconds": 330.98,
      "duration_seconds": 2.02,
      "text": "Bye for now, look after yourself."
    }
  ]
}