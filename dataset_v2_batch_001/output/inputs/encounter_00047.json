{
  "schema_version": "1.0",
  "encounter_id": "00047",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 2.99,
      "duration_seconds": 2.36,
      "text": "Morning! Make yourself comfortable. Was parking alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.44,
      "end_seconds": 6.8,
      "duration_seconds": 3.36,
      "text": "Not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.23,
      "end_seconds": 8.77,
      "duration_seconds": 1.54,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.81,
      "end_seconds": 15.27,
      "duration_seconds": 5.46,
      "text": "I've been feeling overwhelmed at work, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.26,
      "end_seconds": 18.38,
      "duration_seconds": 2.12,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.64,
      "end_seconds": 21.33,
      "duration_seconds": 1.69,
      "text": "About... well, two months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.83,
      "end_seconds": 34.37,
      "duration_seconds": 11.54,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.94,
      "end_seconds": 42.55,
      "duration_seconds": 7.61,
      "text": "I'd give it a seven, out of ten. I get some relief from weekends off. Deadlines definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.21,
      "end_seconds": 46.74,
      "duration_seconds": 3.53,
      "text": "Has there been a knot in your stomach too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.25,
      "end_seconds": 49.06,
      "duration_seconds": 1.81,
      "text": "Yes, for three days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.82,
      "end_seconds": 52.08,
      "duration_seconds": 2.26,
      "text": "Alright, have you been feeling short-tempered?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.46,
      "end_seconds": 55.87,
      "duration_seconds": 2.41,
      "text": "Yes, about the same, two months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.17,
      "end_seconds": 73.01,
      "duration_seconds": 15.84,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 75.38,
      "duration_seconds": 2.03,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.64,
      "end_seconds": 79.68,
      "duration_seconds": 3.04,
      "text": "Any panic attacks, weight loss or alcohol use?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.22,
      "end_seconds": 83.69,
      "duration_seconds": 3.47,
      "text": "No, no panic attacks, weight loss or alcohol use."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.7,
      "end_seconds": 86.89,
      "duration_seconds": 2.19,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.36,
      "end_seconds": 89.11,
      "duration_seconds": 1.75,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.86,
      "end_seconds": 92.52,
      "duration_seconds": 2.66,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.98,
      "end_seconds": 108.94,
      "duration_seconds": 14.96,
      "text": "I take omeprazole, 20 milligrams, once a day for the reflux. I'd rather not end up on lots of tablets if I can avoid it. I'd rather know what's going on than keep guessing. I'm on paracetamol, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.23,
      "end_seconds": 112.02,
      "duration_seconds": 1.79,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.19,
      "end_seconds": 116.42,
      "duration_seconds": 1.23,
      "text": "It's 500 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.71,
      "end_seconds": 120.2,
      "duration_seconds": 3.49,
      "text": "Right. Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.6,
      "end_seconds": 122.39,
      "duration_seconds": 1.79,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.09,
      "end_seconds": 125.6,
      "duration_seconds": 2.51,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.42,
      "end_seconds": 128.76,
      "duration_seconds": 2.34,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.31,
      "end_seconds": 149.62,
      "duration_seconds": 5.31,
      "text": "Right, thanks for waiting. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.4,
      "end_seconds": 151.25,
      "duration_seconds": 0.85,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.26,
      "end_seconds": 155.73,
      "duration_seconds": 3.47,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 159.05,
      "duration_seconds": 2.06,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 164.13,
      "duration_seconds": 3.62,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.63,
      "end_seconds": 174.85,
      "duration_seconds": 9.22,
      "text": "Yes, acid reflux. A neighbour of mine said I should see someone about it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.32,
      "end_seconds": 179.66,
      "duration_seconds": 4.34,
      "text": "Alright. Okay, acid reflux, that's already on your record. Good to know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.63,
      "end_seconds": 183.63,
      "duration_seconds": 3.0,
      "text": "Right, I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.36,
      "end_seconds": 185.19,
      "duration_seconds": 0.83,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.42,
      "end_seconds": 202.27,
      "duration_seconds": 2.85,
      "text": "Alright, I've got it. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.94,
      "end_seconds": 206.69,
      "duration_seconds": 3.75,
      "text": "I had a hernia repair about five years back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.27,
      "end_seconds": 219.99,
      "duration_seconds": 12.72,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.42,
      "end_seconds": 222.02,
      "duration_seconds": 1.6,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.34,
      "end_seconds": 225.14,
      "duration_seconds": 2.8,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.96,
      "end_seconds": 233.47,
      "duration_seconds": 1.51,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.53,
      "end_seconds": 257.88,
      "duration_seconds": 6.35,
      "text": "Okay: BP is 116 over 80, pulse 75. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.38,
      "end_seconds": 274.56,
      "duration_seconds": 16.18,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.95,
      "end_seconds": 277.86,
      "duration_seconds": 2.91,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.18,
      "end_seconds": 281.57,
      "duration_seconds": 3.39,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.05,
      "end_seconds": 289.28,
      "duration_seconds": 6.23,
      "text": "Okay, so my impression from what you've said is this: My working impression is stress-related symptoms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.87,
      "end_seconds": 293.59,
      "duration_seconds": 2.72,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.24,
      "end_seconds": 308.47,
      "duration_seconds": 14.23,
      "text": "Nothing I've seen today points to an emergency. It looks like stress-related symptoms, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling overwhelmed at work for two months, and no panic attacks or weight loss."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.17,
      "end_seconds": 310.76,
      "duration_seconds": 1.59,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.18,
      "end_seconds": 318.43,
      "duration_seconds": 7.25,
      "text": "Let's get blood tests, for stress-related symptoms. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.2,
      "end_seconds": 321.58,
      "duration_seconds": 2.38,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.63,
      "end_seconds": 343.46,
      "duration_seconds": 17.83,
      "text": "Talking to someone, even a counsellor, helps more than people expect. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. We'll refer you to a counsellor. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.31,
      "end_seconds": 346.24,
      "duration_seconds": 1.93,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.65,
      "end_seconds": 350.36,
      "duration_seconds": 2.71,
      "text": "Please come and see me in a month."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.96,
      "end_seconds": 356.89,
      "duration_seconds": 3.93,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.33,
      "end_seconds": 362.96,
      "duration_seconds": 5.63,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.52,
      "end_seconds": 370.13,
      "duration_seconds": 4.61,
      "text": "So, I come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.68,
      "end_seconds": 375.98,
      "duration_seconds": 5.3,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.3,
      "end_seconds": 378.52,
      "duration_seconds": 2.22,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.72,
      "end_seconds": 380.57,
      "duration_seconds": 0.85,
      "text": "Alright, goodbye."
    }
  ]
}