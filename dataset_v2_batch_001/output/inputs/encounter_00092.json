{
  "schema_version": "1.0",
  "encounter_id": "00092",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 4.03,
      "duration_seconds": 3.33,
      "text": "Doctor? Hi. I hope I've got the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.5,
      "end_seconds": 8.45,
      "duration_seconds": 3.95,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.66,
      "end_seconds": 20.59,
      "duration_seconds": 10.93,
      "text": "I, I wanted to get shaky spells looked at. It's the not knowing that gets to me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.88,
      "end_seconds": 29.68,
      "duration_seconds": 5.8,
      "text": "When did you first notice it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.15,
      "end_seconds": 34.12,
      "duration_seconds": 2.97,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.99,
      "end_seconds": 37.91,
      "duration_seconds": 2.92,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.91,
      "end_seconds": 40.53,
      "duration_seconds": 1.62,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.81,
      "end_seconds": 45.3,
      "duration_seconds": 4.49,
      "text": "Mm-hm. What about a pounding heart with it, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.86,
      "end_seconds": 47.12,
      "duration_seconds": 1.26,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 51.93,
      "duration_seconds": 3.98,
      "text": "Have you had shaky spells before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 56.88,
      "duration_seconds": 3.83,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.94,
      "end_seconds": 61.38,
      "duration_seconds": 3.44,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.78,
      "end_seconds": 64.89,
      "duration_seconds": 2.11,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.45,
      "end_seconds": 71.02,
      "duration_seconds": 4.57,
      "text": "Let me check a few things. Any vomiting, chest pain or seizure?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.99,
      "end_seconds": 78.03,
      "duration_seconds": 4.04,
      "text": "I haven't had vomiting, chest pain or seizure, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.13,
      "end_seconds": 81.57,
      "duration_seconds": 2.44,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.36,
      "end_seconds": 83.12,
      "duration_seconds": 0.76,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.36,
      "end_seconds": 97.14,
      "duration_seconds": 5.78,
      "text": "Alright, I've got it. Alright, moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.58,
      "end_seconds": 109.03,
      "duration_seconds": 10.45,
      "text": "I have high blood pressure. I didn't want to make a fuss, you know. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.78,
      "end_seconds": 113.48,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.48,
      "end_seconds": 117.92,
      "duration_seconds": 3.44,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.42,
      "end_seconds": 119.12,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.71,
      "end_seconds": 133.7,
      "duration_seconds": 4.99,
      "text": "Okay, here we go. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.63,
      "end_seconds": 138.0,
      "duration_seconds": 3.37,
      "text": "Yes, codeine, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 144.17,
      "duration_seconds": 2.87,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.54,
      "end_seconds": 149.03,
      "duration_seconds": 3.49,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.57,
      "end_seconds": 153.05,
      "duration_seconds": 2.48,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.94,
      "end_seconds": 155.23,
      "duration_seconds": 1.29,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.17,
      "end_seconds": 160.19,
      "duration_seconds": 4.02,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.59,
      "end_seconds": 161.42,
      "duration_seconds": 0.83,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.14,
      "end_seconds": 176.68,
      "duration_seconds": 3.54,
      "text": "Alright, I've got it. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.38,
      "end_seconds": 181.01,
      "duration_seconds": 3.63,
      "text": "Okay, so I'm on ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.58,
      "end_seconds": 184.14,
      "duration_seconds": 2.56,
      "text": "Right. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.4,
      "end_seconds": 189.99,
      "duration_seconds": 1.59,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.01,
      "end_seconds": 204.31,
      "duration_seconds": 13.3,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.83,
      "end_seconds": 207.09,
      "duration_seconds": 2.26,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.62,
      "end_seconds": 210.48,
      "duration_seconds": 2.86,
      "text": "I'm just saving what we've covered so far."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.34,
      "end_seconds": 226.23,
      "duration_seconds": 0.89,
      "text": "Okay, continuing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 229.78,
      "duration_seconds": 2.25,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.81,
      "end_seconds": 231.82,
      "duration_seconds": 1.01,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 234.71,
      "duration_seconds": 1.53,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.4,
      "end_seconds": 248.38,
      "duration_seconds": 2.98,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.21,
      "end_seconds": 266.35,
      "duration_seconds": 15.14,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.94,
      "end_seconds": 278.13,
      "duration_seconds": 10.19,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.86,
      "end_seconds": 291.61,
      "duration_seconds": 12.75,
      "text": "From what you've told me and what I found, it fits best with low sugar episodes related to diabetes medication. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.21,
      "end_seconds": 295.37,
      "duration_seconds": 2.16,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.39,
      "end_seconds": 312.07,
      "duration_seconds": 15.68,
      "text": "It's reasonable to be concerned, but right now low sugar episodes related to diabetes medication is my leading thought, not anything worse. Let me just recap so I've got it right. You've had shaky spells for ten days, and no chest pain or seizure."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.7,
      "end_seconds": 314.12,
      "duration_seconds": 1.42,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.01,
      "end_seconds": 317.6,
      "duration_seconds": 2.59,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.58,
      "end_seconds": 332.54,
      "duration_seconds": 13.96,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.06,
      "end_seconds": 337.1,
      "duration_seconds": 3.04,
      "text": "We should do an HbA1c for diabetes control."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.34,
      "end_seconds": 339.82,
      "duration_seconds": 1.48,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.76,
      "end_seconds": 353.06,
      "duration_seconds": 12.3,
      "text": "Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.38,
      "end_seconds": 361.21,
      "duration_seconds": 7.83,
      "text": "Mm-hm. I want you to come back or go to emergency straight away if you black out or can't wake up properly after an episode."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.93,
      "end_seconds": 363.18,
      "duration_seconds": 1.25,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.44,
      "end_seconds": 367.39,
      "duration_seconds": 1.95,
      "text": "Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.77,
      "end_seconds": 369.47,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.31,
      "end_seconds": 374.59,
      "duration_seconds": 4.28,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.78,
      "end_seconds": 380.18,
      "duration_seconds": 4.4,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.71,
      "end_seconds": 386.31,
      "duration_seconds": 5.6,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.78,
      "end_seconds": 389.17,
      "duration_seconds": 2.39,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.4,
      "end_seconds": 392.84,
      "duration_seconds": 2.44,
      "text": "Bye for now, look after yourself."
    }
  ]
}