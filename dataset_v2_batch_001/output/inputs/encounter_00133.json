{
  "schema_version": "1.0",
  "encounter_id": "00133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.59,
      "duration_seconds": 2.62,
      "text": "Good afternoon. Have a seat and we'll begin."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.75,
      "end_seconds": 9.6,
      "duration_seconds": 4.85,
      "text": "Oh, uh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.0,
      "end_seconds": 13.28,
      "duration_seconds": 3.28,
      "text": "Absolutely, come and sit beside them. Was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.87,
      "end_seconds": 20.75,
      "duration_seconds": 4.88,
      "text": "Not great, uh, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.04,
      "end_seconds": 26.63,
      "duration_seconds": 1.59,
      "text": "Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 27.73,
      "end_seconds": 32.99,
      "duration_seconds": 5.26,
      "text": "Yeah, he's been having a burning pain in the upper tummy, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.22,
      "end_seconds": 42.14,
      "duration_seconds": 4.92,
      "text": "And when did that start? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 51.05,
      "duration_seconds": 7.64,
      "text": "It's been five days, I'm fairly sure. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.91,
      "end_seconds": 61.58,
      "duration_seconds": 9.67,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.58,
      "end_seconds": 87.92,
      "duration_seconds": 25.34,
      "text": "Um, it's on and off. It's worse with spicy food and an empty stomach. I thought it would sort itself out, but it hasn't. I mean, as for sour taste in the mouth, I honestly can't say when that began. It might have been last month or the month before. As for sour taste in the mouth, I'd say mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.49,
      "end_seconds": 92.08,
      "duration_seconds": 2.59,
      "text": "Alright, has there been bloating after meals too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.63,
      "end_seconds": 94.7,
      "duration_seconds": 1.07,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.52,
      "end_seconds": 98.42,
      "duration_seconds": 2.9,
      "text": "Any weight loss, jaundice or vomiting blood at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.14,
      "end_seconds": 102.21,
      "duration_seconds": 3.07,
      "text": "Um, no. None of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.95,
      "end_seconds": 103.88,
      "duration_seconds": 0.93,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 104.51,
      "end_seconds": 107.06,
      "duration_seconds": 2.55,
      "text": "No, um, no fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.45,
      "end_seconds": 110.12,
      "duration_seconds": 1.67,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.25,
      "end_seconds": 112.93,
      "duration_seconds": 1.68,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.51,
      "end_seconds": 120.9,
      "duration_seconds": 3.39,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.19,
      "end_seconds": 125.55,
      "duration_seconds": 3.36,
      "text": "Thank you, you know, I appreciate it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.87,
      "end_seconds": 127.95,
      "duration_seconds": 1.08,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.91,
      "end_seconds": 131.29,
      "duration_seconds": 1.38,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.52,
      "end_seconds": 134.97,
      "duration_seconds": 2.45,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.3,
      "end_seconds": 138.24,
      "duration_seconds": 2.94,
      "text": "Uh, it's perfect, thank you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.8,
      "end_seconds": 141.99,
      "duration_seconds": 3.19,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.92,
      "end_seconds": 148.31,
      "duration_seconds": 5.39,
      "text": "My sister has thyroid problems. Okay, um, so my father was diabetic."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.49,
      "end_seconds": 153.93,
      "duration_seconds": 4.44,
      "text": "Right, what about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 154.6,
      "end_seconds": 158.05,
      "duration_seconds": 3.45,
      "text": "Arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.65,
      "end_seconds": 160.65,
      "duration_seconds": 1.0,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.83,
      "end_seconds": 164.13,
      "duration_seconds": 2.3,
      "text": "I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.41,
      "end_seconds": 166.11,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.2,
      "end_seconds": 180.67,
      "duration_seconds": 13.47,
      "text": "I've had heart failure, yes. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.91,
      "end_seconds": 195.1,
      "duration_seconds": 13.19,
      "text": "Okay. Right, so that's your known arthritis in my knees. We'll keep that in mind today. Okay, heart failure, that's already on your record. Good to know. Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.09,
      "end_seconds": 198.43,
      "duration_seconds": 2.34,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.77,
      "end_seconds": 201.93,
      "duration_seconds": 3.16,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.87,
      "end_seconds": 211.26,
      "duration_seconds": 8.39,
      "text": "Paracetamol. I take it 650 milligrams, when needed. I take omeprazole, 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 212.66,
      "end_seconds": 219.96,
      "duration_seconds": 7.3,
      "text": "Doctor, I think the last prescription for the omeprazole was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.41,
      "end_seconds": 224.69,
      "duration_seconds": 3.28,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.08,
      "end_seconds": 232.47,
      "duration_seconds": 6.39,
      "text": "Okay, uh, so no, I left it at home. It's Gelusil, after meals."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 236.78,
      "duration_seconds": 3.3,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.11,
      "end_seconds": 248.99,
      "duration_seconds": 7.88,
      "text": "Just tell me in plain language, um, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.31,
      "end_seconds": 252.3,
      "duration_seconds": 1.99,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.65,
      "end_seconds": 256.44,
      "duration_seconds": 3.79,
      "text": "Yeah, you know, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.84,
      "end_seconds": 270.3,
      "duration_seconds": 12.46,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 270.85,
      "end_seconds": 274.08,
      "duration_seconds": 3.23,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.41,
      "end_seconds": 277.51,
      "duration_seconds": 3.1,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.55,
      "end_seconds": 287.94,
      "duration_seconds": 1.39,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.61,
      "end_seconds": 312.26,
      "duration_seconds": 10.65,
      "text": "Okay: blood pressure 118 over 70, respiratory rate 17. And temperature is 37.0 degrees, SpO2 99 percent on room air, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.73,
      "end_seconds": 313.92,
      "duration_seconds": 1.19,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.57,
      "end_seconds": 317.04,
      "duration_seconds": 2.47,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.4,
      "end_seconds": 322.55,
      "duration_seconds": 3.15,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.31,
      "end_seconds": 327.11,
      "duration_seconds": 2.8,
      "text": "So, stay still while I have a look."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.01,
      "end_seconds": 338.59,
      "duration_seconds": 1.58,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.39,
      "end_seconds": 340.89,
      "duration_seconds": 1.5,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.11,
      "end_seconds": 357.54,
      "duration_seconds": 4.43,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.75,
      "end_seconds": 374.47,
      "duration_seconds": 13.72,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Putting it all together, this looks most like gastritis. Acid reflux is also on my list."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 375.2,
      "end_seconds": 377.53,
      "duration_seconds": 2.33,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.86,
      "end_seconds": 394.28,
      "duration_seconds": 15.42,
      "text": "Nothing I've seen today points to an emergency. It looks like gastritis, but I'd like to confirm. Let me just recap so I've got it right. You've had a burning pain in the upper tummy for five days, and no weight loss or fever."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 395.63,
      "end_seconds": 397.06,
      "duration_seconds": 1.43,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.85,
      "end_seconds": 400.93,
      "duration_seconds": 3.08,
      "text": "Let's get an upper endoscopy, for persistent dyspepsia."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 402.48,
      "end_seconds": 405.39,
      "duration_seconds": 2.91,
      "text": "Oh, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.95,
      "end_seconds": 417.1,
      "duration_seconds": 11.15,
      "text": "I'm going to order blood tests, for dyspepsia. It's a routine test and it'll give us a much clearer picture. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 417.3,
      "end_seconds": 431.2,
      "duration_seconds": 13.9,
      "text": "Mm-hm. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 432.32,
      "end_seconds": 434.98,
      "duration_seconds": 2.66,
      "text": "Okay, you know, I will."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 436.03,
      "end_seconds": 444.34,
      "duration_seconds": 8.31,
      "text": "If you vomit blood or pass black stools, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 445.39,
      "end_seconds": 446.92,
      "duration_seconds": 1.53,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 447.86,
      "end_seconds": 451.19,
      "duration_seconds": 3.33,
      "text": "Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 452.59,
      "end_seconds": 454.5,
      "duration_seconds": 1.91,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 455.16,
      "end_seconds": 460.85,
      "duration_seconds": 5.69,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 461.23,
      "end_seconds": 467.0,
      "duration_seconds": 5.77,
      "text": "So, uh, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 468.56,
      "end_seconds": 474.18,
      "duration_seconds": 5.62,
      "text": "Right, yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 475.19,
      "end_seconds": 477.91,
      "duration_seconds": 2.72,
      "text": "Right, I appreciate your time, doctor."
    }
  ]
}