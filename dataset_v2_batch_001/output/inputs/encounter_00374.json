{
  "schema_version": "1.0",
  "encounter_id": "00374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 3.81,
      "duration_seconds": 2.6,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.28,
      "end_seconds": 8.45,
      "duration_seconds": 3.17,
      "text": "Hmm, thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.1,
      "end_seconds": 11.38,
      "duration_seconds": 2.28,
      "text": "What made you decide to come in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 20.94,
      "duration_seconds": 9.05,
      "text": "Yeah, it's tingling in my fingers. I don't know what's causing it. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.92,
      "end_seconds": 25.2,
      "duration_seconds": 3.28,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 27.66,
      "duration_seconds": 1.29,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.22,
      "end_seconds": 30.18,
      "duration_seconds": 1.96,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.79,
      "end_seconds": 32.08,
      "duration_seconds": 1.29,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.44,
      "end_seconds": 36.81,
      "duration_seconds": 4.37,
      "text": "Okay, I'm following. Alright, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.0,
      "end_seconds": 49.7,
      "duration_seconds": 11.7,
      "text": "An ache in the wrist goes along with it, most of the time. With ache in the wrist, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.7,
      "end_seconds": 53.23,
      "duration_seconds": 2.53,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.59,
      "end_seconds": 54.33,
      "duration_seconds": 0.74,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.95,
      "end_seconds": 72.15,
      "duration_seconds": 5.2,
      "text": "Alright, I've got it. Let me check a few things. Any headache or trouble walking?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.58,
      "end_seconds": 74.16,
      "duration_seconds": 1.58,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.88,
      "end_seconds": 78.53,
      "duration_seconds": 3.65,
      "text": "Right, I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.8,
      "end_seconds": 81.77,
      "duration_seconds": 1.97,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 83.58,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.19,
      "end_seconds": 85.88,
      "duration_seconds": 1.69,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.05,
      "end_seconds": 89.7,
      "duration_seconds": 2.65,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.42,
      "end_seconds": 91.29,
      "duration_seconds": 0.87,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.13,
      "end_seconds": 103.47,
      "duration_seconds": 3.34,
      "text": "Okay, here we go. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.83,
      "end_seconds": 108.02,
      "duration_seconds": 3.19,
      "text": "I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.26,
      "end_seconds": 111.43,
      "duration_seconds": 2.17,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.97,
      "end_seconds": 113.99,
      "duration_seconds": 2.02,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 127.24,
      "duration_seconds": 5.51,
      "text": "Alright, I've got it. So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.4,
      "end_seconds": 131.07,
      "duration_seconds": 2.67,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.16,
      "end_seconds": 135.34,
      "duration_seconds": 3.18,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.92,
      "end_seconds": 156.5,
      "duration_seconds": 3.58,
      "text": "Right, carry on. Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.83,
      "end_seconds": 161.45,
      "duration_seconds": 3.62,
      "text": "Um, uh, not that I know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.44,
      "end_seconds": 167.39,
      "duration_seconds": 4.95,
      "text": "Just to be sure I've got this right, the paracetamol, what dose was that again?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.79,
      "end_seconds": 169.98,
      "duration_seconds": 1.19,
      "text": "500 milligrams. Yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.29,
      "end_seconds": 175.49,
      "duration_seconds": 4.2,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.0,
      "end_seconds": 179.73,
      "duration_seconds": 3.73,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.11,
      "end_seconds": 183.64,
      "duration_seconds": 2.53,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.88,
      "end_seconds": 185.78,
      "duration_seconds": 0.9,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.34,
      "end_seconds": 189.21,
      "duration_seconds": 1.87,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.82,
      "end_seconds": 205.43,
      "duration_seconds": 3.61,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.5,
      "end_seconds": 215.63,
      "duration_seconds": 6.13,
      "text": "Okay, you can sit back up. Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.11,
      "end_seconds": 220.98,
      "duration_seconds": 3.87,
      "text": "I'd rather not, um, if you don't mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 232.12,
      "duration_seconds": 10.5,
      "text": "So, based on the history and the examination, it fits best with carpal tunnel syndrome. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.81,
      "end_seconds": 235.33,
      "duration_seconds": 2.52,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.29,
      "end_seconds": 251.51,
      "duration_seconds": 15.22,
      "text": "It's reasonable to be concerned, but right now carpal tunnel syndrome is my leading thought, not anything worse. Let me just recap so I've got it right. You've had tingling in your fingers, yesterday, severe, and no headache or trouble walking."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.01,
      "end_seconds": 255.27,
      "duration_seconds": 2.26,
      "text": "So, yes, you've got it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.71,
      "end_seconds": 270.29,
      "duration_seconds": 12.58,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.66,
      "end_seconds": 273.38,
      "duration_seconds": 1.72,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.34,
      "end_seconds": 278.76,
      "duration_seconds": 4.42,
      "text": "I'm going to order a nerve conduction study, for hand numbness."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.77,
      "end_seconds": 283.59,
      "duration_seconds": 3.82,
      "text": "Sure, you know, where do I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.97,
      "end_seconds": 292.99,
      "duration_seconds": 8.02,
      "text": "A night wrist splint, kept neutral, usually helps a lot. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.29,
      "end_seconds": 299.49,
      "duration_seconds": 6.2,
      "text": "Right. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.9,
      "end_seconds": 301.92,
      "duration_seconds": 2.02,
      "text": "Okay, um, I understand."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.36,
      "end_seconds": 305.67,
      "duration_seconds": 2.31,
      "text": "Come back after the results are back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.9,
      "end_seconds": 308.47,
      "duration_seconds": 1.57,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.23,
      "end_seconds": 316.98,
      "duration_seconds": 5.75,
      "text": "Alright, I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.56,
      "end_seconds": 322.88,
      "duration_seconds": 5.32,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.96,
      "end_seconds": 328.54,
      "duration_seconds": 4.58,
      "text": "Yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.13,
      "end_seconds": 333.15,
      "duration_seconds": 3.02,
      "text": "That's all, thank you for your time."
    }
  ]
}