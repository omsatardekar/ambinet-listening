{
  "schema_version": "1.0",
  "encounter_id": "00421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 3.69,
      "duration_seconds": 2.91,
      "text": "Good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.64,
      "end_seconds": 7.86,
      "duration_seconds": 3.22,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.3,
      "end_seconds": 13.14,
      "duration_seconds": 3.84,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 16.7,
      "duration_seconds": 2.32,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.92,
      "end_seconds": 22.85,
      "duration_seconds": 4.93,
      "text": "It's loose motions, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.24,
      "end_seconds": 25.83,
      "duration_seconds": 1.59,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.88,
      "end_seconds": 32.72,
      "duration_seconds": 5.84,
      "text": "I've had it for two weeks. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.07,
      "end_seconds": 37.34,
      "duration_seconds": 4.27,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.7,
      "end_seconds": 54.09,
      "duration_seconds": 15.39,
      "text": "It's worse with drinking milk and eating. Only fasting, and it's not much. Pretty severe, if I'm being honest. I took the morning off to come in today. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.29,
      "end_seconds": 57.12,
      "duration_seconds": 1.83,
      "text": "Have you had stomach cramps?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.56,
      "end_seconds": 69.03,
      "duration_seconds": 11.47,
      "text": "Yeah, um, I've had that since last Tuesday. As for stomach cramps, about a three out of ten. I get some relief from passing stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.44,
      "end_seconds": 72.33,
      "duration_seconds": 1.89,
      "text": "Have you been feeling weak?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.66,
      "end_seconds": 74.67,
      "duration_seconds": 1.01,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.02,
      "end_seconds": 77.92,
      "duration_seconds": 2.9,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.13,
      "end_seconds": 81.07,
      "duration_seconds": 1.94,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.45,
      "end_seconds": 84.26,
      "duration_seconds": 2.81,
      "text": "Okay, what about nausea, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.15,
      "end_seconds": 89.65,
      "duration_seconds": 4.5,
      "text": "Yeah. Two weeks, I'd say. With nausea, mild, I'd say."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 95.14,
      "duration_seconds": 4.16,
      "text": "Let me check a few things. Any weight loss, rash or recent antibiotics?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.26,
      "end_seconds": 99.42,
      "duration_seconds": 3.16,
      "text": "Right, no, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.84,
      "end_seconds": 104.6,
      "duration_seconds": 3.76,
      "text": "Any vomiting, blood in the stool or black stools at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.63,
      "end_seconds": 110.32,
      "duration_seconds": 4.69,
      "text": "I haven't had vomiting, blood in the stool or black stools, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.2,
      "end_seconds": 113.83,
      "duration_seconds": 2.63,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.59,
      "end_seconds": 117.37,
      "duration_seconds": 2.78,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.02,
      "end_seconds": 121.47,
      "duration_seconds": 3.45,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.65,
      "end_seconds": 133.04,
      "duration_seconds": 10.39,
      "text": "Uh, uh, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.7,
      "end_seconds": 138.77,
      "duration_seconds": 5.07,
      "text": "Any long-term health problems I should know about? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.25,
      "end_seconds": 157.64,
      "duration_seconds": 17.39,
      "text": "Okay, so I have diabetes, for nearly five years. I thought it would sort itself out, but it hasn't. I have heart failure. I've had high cholesterol, yes. It's the not knowing that gets to me. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.16,
      "end_seconds": 166.41,
      "duration_seconds": 7.25,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.61,
      "end_seconds": 170.57,
      "duration_seconds": 2.96,
      "text": "I had a C-section about ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.05,
      "end_seconds": 175.17,
      "duration_seconds": 3.12,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.58,
      "end_seconds": 186.89,
      "duration_seconds": 11.31,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.68,
      "end_seconds": 189.34,
      "duration_seconds": 1.66,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.66,
      "end_seconds": 191.56,
      "duration_seconds": 1.9,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.86,
      "end_seconds": 193.59,
      "duration_seconds": 0.73,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.49,
      "end_seconds": 197.7,
      "duration_seconds": 3.21,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.76,
      "end_seconds": 202.92,
      "duration_seconds": 4.16,
      "text": "So, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.46,
      "end_seconds": 206.75,
      "duration_seconds": 3.29,
      "text": "My sister has thyroid problems. My father was diabetic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.76,
      "end_seconds": 209.85,
      "duration_seconds": 2.09,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.69,
      "end_seconds": 223.63,
      "duration_seconds": 12.94,
      "text": "I, I take furosemide, 40 milligrams, every morning for the fluid. My family kept telling me to get it checked. Atorvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 224.07,
      "end_seconds": 231.8,
      "duration_seconds": 7.73,
      "text": "Doctor, I think the last prescription for the atorvastatin was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.67,
      "end_seconds": 235.64,
      "duration_seconds": 2.97,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.03,
      "end_seconds": 240.8,
      "duration_seconds": 3.77,
      "text": "Yeah, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.49,
      "end_seconds": 245.11,
      "duration_seconds": 3.62,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.79,
      "end_seconds": 248.0,
      "duration_seconds": 2.21,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.03,
      "end_seconds": 251.84,
      "duration_seconds": 2.81,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.62,
      "end_seconds": 262.32,
      "duration_seconds": 1.7,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.11,
      "end_seconds": 286.61,
      "duration_seconds": 6.5,
      "text": "Okay: oxygen saturation is 97 percent, respiratory rate 18. And BP is 126 over 75, heart rate 93."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.18,
      "end_seconds": 293.19,
      "duration_seconds": 4.01,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.87,
      "end_seconds": 294.57,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.7,
      "end_seconds": 297.46,
      "duration_seconds": 1.76,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.42,
      "end_seconds": 315.37,
      "duration_seconds": 0.95,
      "text": "You're mildly dehydrated."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.17,
      "end_seconds": 319.39,
      "duration_seconds": 2.22,
      "text": "Now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.59,
      "end_seconds": 335.04,
      "duration_seconds": 4.45,
      "text": "Bowel sounds are active, tummy is soft with mild tenderness all around."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.5,
      "end_seconds": 356.2,
      "duration_seconds": 16.7,
      "text": "Okay, you can sit back up. So, based on the history and the examination, this looks most like acute gastroenteritis. I want to be honest that this is an impression, not a final answer. An infective colitis is also on my list."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.47,
      "end_seconds": 359.48,
      "duration_seconds": 2.01,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.65,
      "end_seconds": 375.52,
      "duration_seconds": 14.87,
      "text": "I understand the worry. At the moment I'd say it's acute gastroenteritis, and we'll know more once the blood salts is back. Let me just recap so I've got it right. You've had loose motions for two weeks, severe, and no vomiting or rash."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.02,
      "end_seconds": 377.29,
      "duration_seconds": 1.27,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.7,
      "end_seconds": 387.24,
      "duration_seconds": 9.54,
      "text": "Let's get blood salts, for dehydration. That will help us see what's going on underneath and decide the next step. I'm going to order a stool test, for diarrhoea."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.77,
      "end_seconds": 389.74,
      "duration_seconds": 0.97,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.64,
      "end_seconds": 395.76,
      "duration_seconds": 5.12,
      "text": "I'm prescribing zinc, 20 milligrams, once a day, for ten days. It's for diarrhoea."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.35,
      "end_seconds": 397.21,
      "duration_seconds": 0.86,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.61,
      "end_seconds": 408.56,
      "duration_seconds": 10.95,
      "text": "I'll start you on ORS, 1 sachet, after each loose stool, for three days. It's for dehydration. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.93,
      "end_seconds": 412.08,
      "duration_seconds": 3.15,
      "text": "Alright, uh, I'll pick it up today."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.08,
      "end_seconds": 436.4,
      "duration_seconds": 23.32,
      "text": "Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 437.98,
      "end_seconds": 440.24,
      "duration_seconds": 2.26,
      "text": "Okay, um, I will."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.84,
      "end_seconds": 450.04,
      "duration_seconds": 8.2,
      "text": "Please don't sit on it if you pass blood or can't keep anything down. That's the point to get seen urgently. Come back in three days."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 450.48,
      "end_seconds": 454.68,
      "duration_seconds": 4.2,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.56,
      "end_seconds": 458.52,
      "duration_seconds": 2.96,
      "text": "Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 459.57,
      "end_seconds": 464.1,
      "duration_seconds": 4.53,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.61,
      "end_seconds": 466.65,
      "duration_seconds": 2.04,
      "text": "Bye for now, look after yourself."
    }
  ]
}