{
  "schema_version": "1.0",
  "encounter_id": "00251",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 7.76,
      "duration_seconds": 6.39,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.16,
      "end_seconds": 12.6,
      "duration_seconds": 3.44,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.98,
      "end_seconds": 18.0,
      "duration_seconds": 4.02,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 21.59,
      "duration_seconds": 2.62,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.1,
      "end_seconds": 26.35,
      "duration_seconds": 4.25,
      "text": "He's been having been feeling dizzy when I stand, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.55,
      "end_seconds": 30.88,
      "duration_seconds": 3.33,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.49,
      "end_seconds": 37.35,
      "duration_seconds": 5.86,
      "text": "It's been one week, I'm fairly sure. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.34,
      "end_seconds": 41.51,
      "duration_seconds": 3.17,
      "text": "Does anything bring it on or make it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.94,
      "end_seconds": 49.62,
      "duration_seconds": 3.68,
      "text": "Yes, standing up quickly. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.05,
      "end_seconds": 56.16,
      "duration_seconds": 6.11,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 56.26,
      "end_seconds": 60.36,
      "duration_seconds": 4.1,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.79,
      "end_seconds": 74.11,
      "duration_seconds": 13.32,
      "text": "Uh, I was getting to that! As for muscle cramps, I honestly can't say when that began. It might have been last month or the month before. I've also had diarrhoea."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.08,
      "end_seconds": 78.22,
      "duration_seconds": 3.14,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.9,
      "end_seconds": 79.6,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.32,
      "end_seconds": 95.23,
      "duration_seconds": 5.91,
      "text": "Alright, I've got it. Have you had any vomiting, confusion or blood in the stool?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 107.58,
      "duration_seconds": 11.52,
      "text": "No, no vomiting, no confusion, no blood in the stool. I did have dark urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.04,
      "end_seconds": 111.25,
      "duration_seconds": 2.21,
      "text": "Any fever or fainting at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.7,
      "end_seconds": 115.48,
      "duration_seconds": 2.78,
      "text": "No fever or fainting, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.6,
      "end_seconds": 119.83,
      "duration_seconds": 3.23,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.86,
      "end_seconds": 122.91,
      "duration_seconds": 2.05,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 127.06,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 134.08,
      "duration_seconds": 2.86,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.46,
      "end_seconds": 136.85,
      "duration_seconds": 1.39,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.19,
      "end_seconds": 142.73,
      "duration_seconds": 3.54,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.06,
      "end_seconds": 158.5,
      "duration_seconds": 15.44,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.11,
      "end_seconds": 161.31,
      "duration_seconds": 2.2,
      "text": "Well, okay, that makes sense."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.74,
      "end_seconds": 165.42,
      "duration_seconds": 2.68,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.61,
      "end_seconds": 170.54,
      "duration_seconds": 3.93,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 171.99,
      "end_seconds": 176.18,
      "duration_seconds": 4.19,
      "text": "Doctor, our chart from the last visit lists it as 1000 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.11,
      "end_seconds": 181.19,
      "duration_seconds": 4.08,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 199.97,
      "duration_seconds": 18.42,
      "text": "I don't think I have it with me. Ramipril. I take it 5 milligrams, every morning for my blood pressure. I just want to get back to normal, really. It's ORS, whenever I remember. I used to take losartan, but I stopped it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.42,
      "end_seconds": 202.85,
      "duration_seconds": 2.43,
      "text": "Okay, have you had any surgery before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.37,
      "end_seconds": 210.31,
      "duration_seconds": 6.94,
      "text": "I had my thyroid operated on a long time ago. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.85,
      "end_seconds": 214.26,
      "duration_seconds": 3.41,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.54,
      "end_seconds": 217.51,
      "duration_seconds": 1.97,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.02,
      "end_seconds": 222.79,
      "duration_seconds": 3.77,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.78,
      "end_seconds": 229.95,
      "duration_seconds": 6.17,
      "text": "Peanuts. I come out in... well, my lips swelling. Yes, dust, it gives me sneezing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.51,
      "end_seconds": 235.16,
      "duration_seconds": 3.65,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.05,
      "end_seconds": 246.93,
      "duration_seconds": 10.88,
      "text": "I have diabetes, for about a year. It's a relief to finally sit down and talk about it. High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.57,
      "end_seconds": 248.66,
      "duration_seconds": 1.09,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.65,
      "end_seconds": 253.32,
      "duration_seconds": 3.67,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.29,
      "end_seconds": 260.04,
      "duration_seconds": 5.75,
      "text": "Yeah, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 260.87,
      "end_seconds": 269.23,
      "duration_seconds": 8.36,
      "text": "Here are the numbers, doctor. Temperature is 36.6 degrees, pressure 99 over 63, saturation 98 percent, respiratory rate 17, pulse 97."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.66,
      "end_seconds": 275.34,
      "duration_seconds": 4.68,
      "text": "Good, thank you. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.42,
      "end_seconds": 279.32,
      "duration_seconds": 2.9,
      "text": "Uh, no problem, take your time."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.49,
      "end_seconds": 284.45,
      "duration_seconds": 2.96,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.93,
      "end_seconds": 285.63,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.37,
      "end_seconds": 289.14,
      "duration_seconds": 1.77,
      "text": "Right, open wide for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.07,
      "end_seconds": 310.05,
      "duration_seconds": 4.98,
      "text": "Your mouth is quite dry and the skin is a little slow to spring back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.99,
      "end_seconds": 340.59,
      "duration_seconds": 27.6,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, my working impression is dehydration from a stomach bug. The reason I say that is that your story and my examination fit together. It could also be an electrolyte imbalance, so we'll keep that open."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.67,
      "end_seconds": 343.95,
      "duration_seconds": 2.28,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.42,
      "end_seconds": 361.89,
      "duration_seconds": 16.47,
      "text": "I can't promise yet, but most people with dehydration from a stomach bug do well once it's treated properly. Let me just recap so I've got it right. You've been feeling dizzy when you stand for one week, and no vomiting or confusion."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.44,
      "end_seconds": 364.75,
      "duration_seconds": 1.31,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.87,
      "end_seconds": 369.71,
      "duration_seconds": 3.84,
      "text": "I'm going to order a kidney function test, for dehydration."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.73,
      "end_seconds": 372.08,
      "duration_seconds": 1.35,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.63,
      "end_seconds": 380.55,
      "duration_seconds": 6.92,
      "text": "Let's get blood salts, for dehydration. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.9,
      "end_seconds": 383.33,
      "duration_seconds": 2.43,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.81,
      "end_seconds": 404.7,
      "duration_seconds": 19.89,
      "text": "Small, frequent sips are better than a big glass at once, and keep going even if you don't feel thirsty. If you smoke, this is a good moment to think about stopping, and we can help you with that. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 406.08,
      "end_seconds": 407.38,
      "duration_seconds": 1.3,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.21,
      "end_seconds": 417.44,
      "duration_seconds": 9.23,
      "text": "Keep an eye out, and if you faint or can't keep any fluids down, call us the same day or go to emergency. Come back in three days."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.35,
      "end_seconds": 422.21,
      "duration_seconds": 3.86,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.86,
      "end_seconds": 430.98,
      "duration_seconds": 5.12,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 432.07,
      "end_seconds": 437.53,
      "duration_seconds": 5.46,
      "text": "So, uh, I come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.58,
      "end_seconds": 442.77,
      "duration_seconds": 4.19,
      "text": "Yes, exactly right. We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 443.85,
      "end_seconds": 448.92,
      "duration_seconds": 5.07,
      "text": "Okay, you know, so no, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.11,
      "end_seconds": 452.33,
      "duration_seconds": 2.22,
      "text": "Bye for now, look after yourself."
    }
  ]
}