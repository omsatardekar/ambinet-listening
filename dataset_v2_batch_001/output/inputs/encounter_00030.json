{
  "schema_version": "1.0",
  "encounter_id": "00030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 5.17,
      "duration_seconds": 4.27,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.36,
      "end_seconds": 10.0,
      "duration_seconds": 3.64,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.34,
      "end_seconds": 17.4,
      "duration_seconds": 7.06,
      "text": "Um, it's a mole that has changed. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.05,
      "end_seconds": 22.75,
      "duration_seconds": 4.7,
      "text": "And when did that start? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.34,
      "end_seconds": 34.08,
      "duration_seconds": 10.74,
      "text": "About... well, two days. I didn't want to make a fuss, you know. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.38,
      "end_seconds": 35.14,
      "duration_seconds": 0.76,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.87,
      "end_seconds": 38.07,
      "duration_seconds": 2.2,
      "text": "There's it bled once as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.66,
      "end_seconds": 39.36,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.07,
      "end_seconds": 42.59,
      "duration_seconds": 2.52,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.11,
      "end_seconds": 45.15,
      "duration_seconds": 2.04,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.15,
      "end_seconds": 54.45,
      "duration_seconds": 3.3,
      "text": "Alright, I've got it. And fever, any of that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.08,
      "end_seconds": 56.36,
      "duration_seconds": 1.28,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.48,
      "end_seconds": 65.03,
      "duration_seconds": 5.55,
      "text": "Let me check a few things. Any pain, lumps in the armpit or history of skin cancer?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.82,
      "end_seconds": 67.41,
      "duration_seconds": 1.59,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.9,
      "end_seconds": 72.18,
      "duration_seconds": 3.28,
      "text": "Okay, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.64,
      "end_seconds": 75.95,
      "duration_seconds": 2.31,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.76,
      "end_seconds": 80.18,
      "duration_seconds": 3.42,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.96,
      "end_seconds": 81.66,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 98.97,
      "duration_seconds": 4.7,
      "text": "Alright, I've got it. Right, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 108.2,
      "duration_seconds": 6.91,
      "text": "Allopurinol. I take it 100 milligrams, once a day for the gout. It's sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.23,
      "end_seconds": 116.48,
      "duration_seconds": 7.25,
      "text": "Do you have any allergies to medicines, food, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.27,
      "end_seconds": 119.58,
      "duration_seconds": 2.31,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.01,
      "end_seconds": 123.17,
      "duration_seconds": 2.16,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.76,
      "end_seconds": 126.52,
      "duration_seconds": 1.76,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.74,
      "end_seconds": 131.83,
      "duration_seconds": 4.09,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.2,
      "end_seconds": 135.0,
      "duration_seconds": 1.8,
      "text": "My grandmother had breast cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 139.08,
      "duration_seconds": 2.65,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.43,
      "end_seconds": 140.27,
      "duration_seconds": 0.84,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.31,
      "end_seconds": 154.09,
      "duration_seconds": 6.78,
      "text": "Alright, I've got it. Moving on to your background, any past medical history? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.55,
      "end_seconds": 165.5,
      "duration_seconds": 9.95,
      "text": "I have gout, for two years. I thought it would sort itself out, but it hasn't. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.23,
      "end_seconds": 170.4,
      "duration_seconds": 1.17,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.28,
      "end_seconds": 177.87,
      "duration_seconds": 6.59,
      "text": "I have migraines, for about a year. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.05,
      "end_seconds": 187.19,
      "duration_seconds": 8.14,
      "text": "Right, so that's your known migraines. We'll keep that in mind today. Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.33,
      "end_seconds": 193.93,
      "duration_seconds": 5.6,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.75,
      "end_seconds": 195.7,
      "duration_seconds": 0.95,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.76,
      "end_seconds": 199.88,
      "duration_seconds": 3.12,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.78,
      "end_seconds": 203.84,
      "duration_seconds": 3.06,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.23,
      "end_seconds": 218.79,
      "duration_seconds": 1.56,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.27,
      "end_seconds": 248.45,
      "duration_seconds": 20.18,
      "text": "Okay: respiratory rate 16, temperature 36.6, SpO2 99 percent on room air, heart rate 69, BP is 128 over 72. Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.88,
      "end_seconds": 253.65,
      "duration_seconds": 3.77,
      "text": "Oh, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.4,
      "end_seconds": 259.55,
      "duration_seconds": 4.15,
      "text": "Okay, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.78,
      "end_seconds": 261.48,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.66,
      "end_seconds": 264.75,
      "duration_seconds": 2.09,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.81,
      "end_seconds": 284.52,
      "duration_seconds": 2.71,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.97,
      "end_seconds": 287.85,
      "duration_seconds": 1.88,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.1,
      "end_seconds": 306.08,
      "duration_seconds": 4.98,
      "text": "It's about eight millimetres, with an uneven border and two shades of brown."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.68,
      "end_seconds": 320.85,
      "duration_seconds": 12.17,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.23,
      "end_seconds": 324.14,
      "duration_seconds": 1.91,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.5,
      "end_seconds": 336.53,
      "duration_seconds": 11.03,
      "text": "Right, here's what I'm thinking. This looks most like a pigmented lesion that needs to be looked at more closely. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.17,
      "end_seconds": 339.04,
      "duration_seconds": 1.87,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.22,
      "end_seconds": 360.05,
      "duration_seconds": 18.83,
      "text": "Nothing I've seen today points to an emergency. It looks like a pigmented lesion that needs to be looked at more closely, but I'd like to confirm. Let me just recap so I've got it right. You've had a mole that has changed for two days, and no lumps in the armpit or fever."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.67,
      "end_seconds": 363.01,
      "duration_seconds": 2.34,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.39,
      "end_seconds": 379.66,
      "duration_seconds": 13.27,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.2,
      "end_seconds": 383.51,
      "duration_seconds": 2.31,
      "text": "Right, that's reassuring to hear."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.56,
      "end_seconds": 387.39,
      "duration_seconds": 2.83,
      "text": "Let's get a dermoscopy, for changing mole."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.72,
      "end_seconds": 388.93,
      "duration_seconds": 1.21,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.36,
      "end_seconds": 418.15,
      "duration_seconds": 28.79,
      "text": "Please use sunscreen and cover up in the midday sun, and check your skin once a month. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. Come back after the biopsy results. So, I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.87,
      "end_seconds": 423.09,
      "duration_seconds": 4.22,
      "text": "So, I come back after the biopsy results. Is that right?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.98,
      "end_seconds": 428.79,
      "duration_seconds": 4.81,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 430.17,
      "end_seconds": 432.33,
      "duration_seconds": 2.16,
      "text": "Thank you. I'll see you then."
    }
  ]
}