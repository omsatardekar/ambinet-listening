{
  "schema_version": "1.0",
  "encounter_id": "00106",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 4.43,
      "duration_seconds": 3.45,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 8.3,
      "duration_seconds": 2.76,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.5,
      "end_seconds": 14.31,
      "duration_seconds": 4.81,
      "text": "Doctor, uh, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.69,
      "end_seconds": 17.35,
      "duration_seconds": 2.66,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.68,
      "end_seconds": 23.61,
      "duration_seconds": 4.93,
      "text": "Doctor, it's a very painful, swollen big toe. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.87,
      "end_seconds": 26.97,
      "duration_seconds": 2.1,
      "text": "Okay, and when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.73,
      "end_seconds": 30.63,
      "duration_seconds": 2.9,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.43,
      "end_seconds": 33.08,
      "duration_seconds": 1.65,
      "text": "How often does it happen?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 36.18,
      "duration_seconds": 1.97,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.82,
      "end_seconds": 43.47,
      "duration_seconds": 6.65,
      "text": "Oh, um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 43.57,
      "end_seconds": 49.85,
      "duration_seconds": 6.28,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.16,
      "end_seconds": 52.61,
      "duration_seconds": 2.45,
      "text": "So, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.07,
      "end_seconds": 57.8,
      "duration_seconds": 3.73,
      "text": "I've also had a low fever, for five days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.03,
      "end_seconds": 62.3,
      "duration_seconds": 3.27,
      "text": "What about warmth in the toe, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.19,
      "end_seconds": 64.11,
      "duration_seconds": 0.92,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.71,
      "end_seconds": 68.16,
      "duration_seconds": 3.45,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.65,
      "end_seconds": 82.94,
      "duration_seconds": 13.29,
      "text": "Hmm, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.01,
      "end_seconds": 86.06,
      "duration_seconds": 2.05,
      "text": "Have you had any recent illness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.86,
      "end_seconds": 89.11,
      "duration_seconds": 2.25,
      "text": "No recent illness, thank goodness."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 94.32,
      "duration_seconds": 0.95,
      "text": "What about rash?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 96.53,
      "duration_seconds": 1.28,
      "text": "No, no rash."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 97.09,
      "end_seconds": 102.54,
      "duration_seconds": 5.45,
      "text": "Actually, um, doctor, I did notice rash. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.53,
      "end_seconds": 108.63,
      "duration_seconds": 5.1,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.37,
      "end_seconds": 117.11,
      "duration_seconds": 7.74,
      "text": "Alright, I'll note both what you've said and what you've noticed. Alright, any trauma to the toe or chills at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.72,
      "end_seconds": 126.77,
      "duration_seconds": 9.05,
      "text": "No, no trauma to the toe, no chills. I did have trouble walking at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.78,
      "end_seconds": 132.54,
      "duration_seconds": 1.76,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 132.95,
      "end_seconds": 134.6,
      "duration_seconds": 1.65,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 135.14,
      "end_seconds": 141.4,
      "duration_seconds": 6.26,
      "text": "Doctor, I've got the readings for you. Temperature 36.8, heart rate 85, BP is 127 over 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.75,
      "end_seconds": 146.05,
      "duration_seconds": 4.3,
      "text": "Thanks. Right, what about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.46,
      "end_seconds": 155.28,
      "duration_seconds": 8.82,
      "text": "I've got kidney disease. Yes, high blood pressure. Gout, for nearly five years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.18,
      "end_seconds": 157.31,
      "duration_seconds": 1.13,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.87,
      "end_seconds": 160.49,
      "duration_seconds": 1.62,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.8,
      "end_seconds": 174.46,
      "duration_seconds": 13.66,
      "text": "Mm-hm. Yes, I can see the kidney disease in your file as well. Right, so that's your known depression. We'll keep that in mind today. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.8,
      "end_seconds": 185.74,
      "duration_seconds": 9.94,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.06,
      "end_seconds": 191.68,
      "duration_seconds": 4.62,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.13,
      "end_seconds": 202.09,
      "duration_seconds": 8.96,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.49,
      "end_seconds": 205.83,
      "duration_seconds": 2.34,
      "text": "Right, does anything run in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.42,
      "end_seconds": 209.89,
      "duration_seconds": 3.47,
      "text": "My sister has epilepsy. My brother has asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.29,
      "end_seconds": 226.66,
      "duration_seconds": 13.37,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.07,
      "end_seconds": 231.76,
      "duration_seconds": 3.69,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.2,
      "end_seconds": 234.2,
      "duration_seconds": 1.0,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.12,
      "end_seconds": 244.65,
      "duration_seconds": 9.53,
      "text": "I had a hernia repair about five years back. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.81,
      "end_seconds": 248.13,
      "duration_seconds": 2.32,
      "text": "Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.46,
      "end_seconds": 250.23,
      "duration_seconds": 1.77,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.21,
      "end_seconds": 254.91,
      "duration_seconds": 3.7,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.7,
      "end_seconds": 261.87,
      "duration_seconds": 4.17,
      "text": "Yeah, I take telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 263.31,
      "end_seconds": 267.25,
      "duration_seconds": 3.94,
      "text": "Doctor, our chart from the last visit lists it as 20 milligrams."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.71,
      "end_seconds": 273.4,
      "duration_seconds": 4.69,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.53,
      "end_seconds": 281.31,
      "duration_seconds": 6.78,
      "text": "No, I left it at home. I'm on allopurinol, once a day for the gout."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.64,
      "end_seconds": 284.34,
      "duration_seconds": 1.7,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.72,
      "end_seconds": 290.92,
      "duration_seconds": 5.2,
      "text": "100 milligrams. Sertraline. I take it 50 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.51,
      "end_seconds": 294.45,
      "duration_seconds": 2.94,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.09,
      "end_seconds": 295.83,
      "duration_seconds": 0.74,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.36,
      "end_seconds": 312.9,
      "duration_seconds": 2.54,
      "text": "Okay, here we go. What about alcohol?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 314.46,
      "end_seconds": 318.45,
      "duration_seconds": 3.99,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.06,
      "end_seconds": 322.11,
      "duration_seconds": 3.05,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.59,
      "end_seconds": 340.77,
      "duration_seconds": 14.18,
      "text": "Right, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.78,
      "end_seconds": 345.36,
      "duration_seconds": 3.58,
      "text": "Okay, I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.29,
      "end_seconds": 349.03,
      "duration_seconds": 2.74,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.42,
      "end_seconds": 370.7,
      "duration_seconds": 4.28,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.92,
      "end_seconds": 399.45,
      "duration_seconds": 26.53,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. From what you've told me and what I found, I think we're dealing with an acute gout flare at this stage. That's my thinking for now, and it may change as we learn more. I'd also keep pseudogout in mind. I can't rule out septic arthritis yet."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.55,
      "end_seconds": 402.86,
      "duration_seconds": 2.31,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.73,
      "end_seconds": 423.63,
      "duration_seconds": 19.9,
      "text": "I understand the worry. At the moment I'd say it's an acute gout flare, and we'll know more once the a uric acid level is back. Let me just recap so I've got it right. You've had a very painful, swollen big toe for about four days, and no chills or recent illness."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.93,
      "end_seconds": 426.23,
      "duration_seconds": 1.3,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.4,
      "end_seconds": 429.68,
      "duration_seconds": 2.28,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 430.29,
      "end_seconds": 436.35,
      "duration_seconds": 6.06,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.86,
      "end_seconds": 445.54,
      "duration_seconds": 8.68,
      "text": "Let's get a uric acid level, for suspected gout. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 449.82,
      "end_seconds": 452.86,
      "duration_seconds": 3.04,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.82,
      "end_seconds": 475.86,
      "duration_seconds": 19.04,
      "text": "Let's get kidney function tests, for gout. The result will help us decide whether anything more is needed. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 477.42,
      "end_seconds": 478.79,
      "duration_seconds": 1.37,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 479.76,
      "end_seconds": 492.44,
      "duration_seconds": 12.68,
      "text": "I want you to come back or go to emergency straight away if the joint gets hotter or you develop a fever. Let's review you in two weeks. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 492.81,
      "end_seconds": 496.95,
      "duration_seconds": 4.14,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.35,
      "end_seconds": 502.44,
      "duration_seconds": 5.09,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 503.12,
      "end_seconds": 505.46,
      "duration_seconds": 2.34,
      "text": "I appreciate your time, doctor."
    }
  ]
}