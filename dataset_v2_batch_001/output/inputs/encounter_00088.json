{
  "schema_version": "1.0",
  "encounter_id": "00088",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.77,
      "duration_seconds": 2.5,
      "text": "Good evening. Sorry to keep you waiting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.68,
      "end_seconds": 6.77,
      "duration_seconds": 2.09,
      "text": "Hello, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.65,
      "end_seconds": 10.39,
      "duration_seconds": 2.74,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.45,
      "end_seconds": 13.11,
      "duration_seconds": 1.66,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.48,
      "end_seconds": 18.85,
      "duration_seconds": 3.37,
      "text": "Yeah, only about ten minutes, no trouble."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.77,
      "end_seconds": 21.43,
      "duration_seconds": 1.66,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.36,
      "end_seconds": 36.28,
      "duration_seconds": 13.92,
      "text": "Hmm, doctor, it's a very sore throat. It's getting on my nerves now. I didn't want to make a fuss, you know. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.4,
      "end_seconds": 39.1,
      "duration_seconds": 1.7,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.93,
      "end_seconds": 48.14,
      "duration_seconds": 8.21,
      "text": "I've had it for one week. I told myself I'd wait and see, you know, and here I am."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.1,
      "end_seconds": 56.83,
      "duration_seconds": 7.73,
      "text": "Okay, so and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 56.93,
      "end_seconds": 62.7,
      "duration_seconds": 5.77,
      "text": "Uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.33,
      "end_seconds": 70.95,
      "duration_seconds": 7.62,
      "text": "I was getting to that! Hmm, I've also had swollen glands in the neck, for about a week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.65,
      "end_seconds": 74.11,
      "duration_seconds": 2.46,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.8,
      "end_seconds": 75.66,
      "duration_seconds": 0.86,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.62,
      "end_seconds": 85.78,
      "duration_seconds": 3.16,
      "text": "Right, thanks for waiting. Any runny nose or drooling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.57,
      "end_seconds": 97.15,
      "duration_seconds": 10.58,
      "text": "No, no runny nose, no drooling. I did have a hoarse voice at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.1,
      "end_seconds": 98.8,
      "duration_seconds": 0.7,
      "text": "Any rash?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.97,
      "end_seconds": 101.21,
      "duration_seconds": 1.24,
      "text": "No. No rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 101.84,
      "end_seconds": 107.09,
      "duration_seconds": 5.25,
      "text": "Actually, uh, doctor, I did notice rash. She doesn't always say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.71,
      "end_seconds": 113.7,
      "duration_seconds": 5.99,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.11,
      "end_seconds": 123.21,
      "duration_seconds": 8.1,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any ear pain, cough or difficulty breathing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.37,
      "end_seconds": 128.52,
      "duration_seconds": 4.15,
      "text": "No ear pain, cough or difficulty breathing, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 134.67,
      "duration_seconds": 2.62,
      "text": "Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.13,
      "end_seconds": 138.66,
      "duration_seconds": 2.53,
      "text": "Right, no, joints are fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.23,
      "end_seconds": 141.9,
      "duration_seconds": 1.67,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.44,
      "end_seconds": 144.17,
      "duration_seconds": 1.73,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 148.95,
      "duration_seconds": 3.26,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.34,
      "end_seconds": 154.99,
      "duration_seconds": 4.65,
      "text": "Seretide inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.18,
      "end_seconds": 163.11,
      "duration_seconds": 5.93,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.5,
      "end_seconds": 165.41,
      "duration_seconds": 1.91,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.82,
      "end_seconds": 179.03,
      "duration_seconds": 13.21,
      "text": "For my sugar, I believe. My son sets them out for me, I just take what I'm given. Sodium valproate. I take it 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 179.65,
      "end_seconds": 189.47,
      "duration_seconds": 9.82,
      "text": "So, you know, doctor, I think the last prescription for the sodium valproate was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.63,
      "end_seconds": 193.85,
      "duration_seconds": 3.22,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.98,
      "end_seconds": 202.27,
      "duration_seconds": 7.29,
      "text": "Um, I don't think I have it with me. Alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.49,
      "end_seconds": 205.77,
      "duration_seconds": 2.28,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.67,
      "end_seconds": 212.74,
      "duration_seconds": 6.07,
      "text": "For six months. Hmm, I used to take levetiracetam, but I stopped it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.44,
      "end_seconds": 217.22,
      "duration_seconds": 3.78,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.22,
      "end_seconds": 225.22,
      "duration_seconds": 7.0,
      "text": "Okay, uh, so my sister has thyroid problems. My father had kidney stones."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.54,
      "end_seconds": 231.44,
      "duration_seconds": 5.9,
      "text": "Do you have any known allergies at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.02,
      "end_seconds": 243.95,
      "duration_seconds": 10.93,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.02,
      "end_seconds": 246.1,
      "duration_seconds": 1.08,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.26,
      "end_seconds": 250.28,
      "duration_seconds": 3.02,
      "text": "Yeah, no, never had any surgery."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.63,
      "end_seconds": 254.18,
      "duration_seconds": 3.55,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.88,
      "end_seconds": 279.96,
      "duration_seconds": 25.08,
      "text": "Well, I've got asthma. It's the not knowing that gets to me. I'd rather know what's going on than keep guessing. I have diabetes, for nearly five years. I've never really been one for hospitals. I thought it would sort itself out, but it hasn't. Hmm, I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.76,
      "end_seconds": 293.3,
      "duration_seconds": 12.54,
      "text": "I've had thin bones for five years now. I wasn't sure whether to come in at all, to be honest. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.45,
      "end_seconds": 306.43,
      "duration_seconds": 8.98,
      "text": "Right, so that's your known asthma. We'll keep that in mind today. Right, yes, I can see the diabetes in your file as well."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 307.15,
      "end_seconds": 315.45,
      "duration_seconds": 8.3,
      "text": "Doctor, I've got the readings for you. Saturation 97 percent, respiratory rate 17. Temperature is 39.0 degrees, heart rate 97, pressure 113 over 76."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.85,
      "end_seconds": 316.55,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.11,
      "end_seconds": 319.83,
      "duration_seconds": 1.72,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.63,
      "end_seconds": 322.99,
      "duration_seconds": 1.36,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.57,
      "end_seconds": 340.07,
      "duration_seconds": 2.5,
      "text": "The glands under the jaw are tender."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.07,
      "end_seconds": 341.77,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.82,
      "end_seconds": 345.47,
      "duration_seconds": 2.65,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.78,
      "end_seconds": 360.68,
      "duration_seconds": 5.9,
      "text": "Both tonsils are red and swollen, and there are white patches on the left one."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.33,
      "end_seconds": 362.03,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.08,
      "end_seconds": 388.28,
      "duration_seconds": 23.2,
      "text": "Okay, you can sit back up. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. So, based on the history and the examination, it fits best with tonsillitis, probably bacterial. That's my thinking for now, and it may change as we learn more. I'd also keep a viral throat infection in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.57,
      "end_seconds": 410.88,
      "duration_seconds": 18.31,
      "text": "We should do a throat swab for sore throat. That will help us see what's going on underneath and decide the next step. I'm prescribing paracetamol, 500 milligrams, every six hours if needed, for three days. It's for fever and body aches. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 412.23,
      "end_seconds": 437.04,
      "duration_seconds": 24.81,
      "text": "I'd like you to take amoxicillin, 500 milligrams, three times a day, for five days. You take it by mouth. That should help with throat infection. Finish the whole course of antibiotics even if you feel better after two days. Gargle with warm salt water a few times a day, it does soothe it. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 438.04,
      "end_seconds": 444.42,
      "duration_seconds": 6.38,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 445.91,
      "end_seconds": 447.33,
      "duration_seconds": 1.42,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.0,
      "end_seconds": 455.96,
      "duration_seconds": 7.96,
      "text": "Keep an eye out, and if you can't swallow your saliva or you have trouble breathing, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 457.11,
      "end_seconds": 459.3,
      "duration_seconds": 2.19,
      "text": "Okay, um, I understand."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 460.55,
      "end_seconds": 463.16,
      "duration_seconds": 2.61,
      "text": "Please come and see me in a week."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 463.84,
      "end_seconds": 469.05,
      "duration_seconds": 5.21,
      "text": "Right, um, sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 469.74,
      "end_seconds": 473.38,
      "duration_seconds": 3.64,
      "text": "All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 474.9,
      "end_seconds": 479.36,
      "duration_seconds": 4.46,
      "text": "Yeah, I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 480.12,
      "end_seconds": 482.51,
      "duration_seconds": 2.39,
      "text": "Bye for now, look after yourself."
    }
  ]
}