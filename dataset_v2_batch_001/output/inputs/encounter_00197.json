{
  "schema_version": "1.0",
  "encounter_id": "00197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 2.51,
      "duration_seconds": 1.58,
      "text": "Hello there. Please, sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 3.48,
      "end_seconds": 8.02,
      "duration_seconds": 4.54,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 16.62,
      "duration_seconds": 7.1,
      "text": "Good, that'll be useful. Pull up a chair. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.09,
      "end_seconds": 22.66,
      "duration_seconds": 4.57,
      "text": "I mean, I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.19,
      "end_seconds": 26.04,
      "duration_seconds": 1.85,
      "text": "So, what's been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 26.77,
      "end_seconds": 29.59,
      "duration_seconds": 2.82,
      "text": "We came because of a fit last month."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.7,
      "end_seconds": 32.72,
      "duration_seconds": 2.02,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.51,
      "end_seconds": 35.58,
      "duration_seconds": 2.07,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.2,
      "end_seconds": 39.22,
      "duration_seconds": 3.02,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.15,
      "end_seconds": 43.1,
      "duration_seconds": 2.95,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.46,
      "end_seconds": 46.89,
      "duration_seconds": 3.43,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 51.59,
      "duration_seconds": 3.86,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.53,
      "end_seconds": 57.26,
      "duration_seconds": 4.73,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 57.36,
      "end_seconds": 62.69,
      "duration_seconds": 5.33,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.03,
      "end_seconds": 66.08,
      "duration_seconds": 2.05,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.58,
      "end_seconds": 71.69,
      "duration_seconds": 4.11,
      "text": "Okay, so and I've been feeling drowsy as well."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.24,
      "end_seconds": 78.44,
      "duration_seconds": 5.2,
      "text": "Have you had a fit last month before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.97,
      "end_seconds": 84.4,
      "duration_seconds": 4.43,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.18,
      "end_seconds": 92.44,
      "duration_seconds": 7.26,
      "text": "Let me check a few things. Any weakness on one side, headache, loss of bladder control or head injury?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.09,
      "end_seconds": 103.94,
      "duration_seconds": 10.85,
      "text": "No, no weakness on one side, no headache, no loss of bladder control. I was biting my tongue at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.16,
      "end_seconds": 106.16,
      "duration_seconds": 1.0,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.46,
      "end_seconds": 109.19,
      "duration_seconds": 2.73,
      "text": "Yeah, not at all, no fever."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 110.25,
      "end_seconds": 114.06,
      "duration_seconds": 3.81,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.54,
      "end_seconds": 120.81,
      "duration_seconds": 5.27,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.15,
      "end_seconds": 129.04,
      "duration_seconds": 7.89,
      "text": "Alright, I'll note both what you've said and what you've noticed. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.94,
      "end_seconds": 131.21,
      "duration_seconds": 1.27,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.91,
      "end_seconds": 134.87,
      "duration_seconds": 2.96,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.22,
      "end_seconds": 136.77,
      "duration_seconds": 1.55,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.43,
      "end_seconds": 141.88,
      "duration_seconds": 4.45,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.38,
      "end_seconds": 152.49,
      "duration_seconds": 10.11,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.81,
      "end_seconds": 155.66,
      "duration_seconds": 2.85,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.13,
      "end_seconds": 158.69,
      "duration_seconds": 1.56,
      "text": "I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.21,
      "end_seconds": 160.91,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.45,
      "end_seconds": 166.75,
      "duration_seconds": 4.3,
      "text": "Yes, anxiety. I, I have high blood pressure. I've got diabetes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.8,
      "end_seconds": 173.56,
      "duration_seconds": 5.76,
      "text": "Yes, I can see the diabetes in your file as well. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.12,
      "end_seconds": 175.93,
      "duration_seconds": 1.81,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.71,
      "end_seconds": 179.46,
      "duration_seconds": 2.75,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.5,
      "end_seconds": 188.86,
      "duration_seconds": 8.36,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.67,
      "end_seconds": 201.44,
      "duration_seconds": 11.77,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.34,
      "end_seconds": 204.19,
      "duration_seconds": 1.85,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 207.19,
      "duration_seconds": 2.08,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.28,
      "end_seconds": 210.16,
      "duration_seconds": 1.88,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.49,
      "end_seconds": 215.46,
      "duration_seconds": 3.97,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 215.85,
      "end_seconds": 221.2,
      "duration_seconds": 5.35,
      "text": "Sodium valproate. I take it 500 milligrams, maybe, twice a day for the fits."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 225.99,
      "duration_seconds": 3.84,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.37,
      "end_seconds": 236.19,
      "duration_seconds": 6.82,
      "text": "I mean, not with me. I'll bring it next time. Escitalopram. I take it once a day."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.74,
      "end_seconds": 239.17,
      "duration_seconds": 2.43,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.75,
      "end_seconds": 243.12,
      "duration_seconds": 3.37,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.82,
      "end_seconds": 246.25,
      "duration_seconds": 2.43,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.23,
      "end_seconds": 252.14,
      "duration_seconds": 4.91,
      "text": "About about three months. It's Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 253.45,
      "end_seconds": 261.68,
      "duration_seconds": 8.23,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, pulse is 82 beats a minute, pressure 128 over 78, temperature 36.4."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.89,
      "end_seconds": 267.41,
      "duration_seconds": 4.52,
      "text": "Thanks. Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 267.79,
      "end_seconds": 271.6,
      "duration_seconds": 3.81,
      "text": "Right, mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.46,
      "end_seconds": 298.18,
      "duration_seconds": 25.72,
      "text": "From what you've told me, I think we're dealing with breakthrough seizure on known epilepsy at this stage. That's my thinking for now, and it may change as we learn more. I can't rule out a provoked seizure from missed medication yet. Let me just recap so I've got it right. You've had a fit last month for about a week, and no weakness on one side."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.45,
      "end_seconds": 301.36,
      "duration_seconds": 1.91,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.03,
      "end_seconds": 310.37,
      "duration_seconds": 8.34,
      "text": "Let's get an MRI of the brain, for seizure. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 310.91,
      "end_seconds": 313.17,
      "duration_seconds": 2.26,
      "text": "The earliest is Wednesday, 11:30 am."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.58,
      "end_seconds": 315.3,
      "duration_seconds": 0.72,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.52,
      "end_seconds": 340.77,
      "duration_seconds": 24.25,
      "text": "I'd like to arrange a blood level of the tablet for adherence check. Never skip the tablets, and set a phone alarm if it helps. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please take the tablets with food so they don't upset your stomach. I'll also refer you to the epilepsy clinic."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 341.72,
      "end_seconds": 344.0,
      "duration_seconds": 2.28,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.47,
      "end_seconds": 352.82,
      "duration_seconds": 7.35,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 353.96,
      "end_seconds": 355.25,
      "duration_seconds": 1.29,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.8,
      "end_seconds": 364.14,
      "duration_seconds": 8.34,
      "text": "Please don't sit on it if you have another seizure lasting more than five minutes. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.46,
      "end_seconds": 366.4,
      "duration_seconds": 1.94,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.64,
      "end_seconds": 373.91,
      "duration_seconds": 6.27,
      "text": "Come back in four weeks. Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 377.5,
      "end_seconds": 381.69,
      "duration_seconds": 4.19,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.28,
      "end_seconds": 386.64,
      "duration_seconds": 3.36,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.74,
      "end_seconds": 390.85,
      "duration_seconds": 3.11,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.64,
      "end_seconds": 392.77,
      "duration_seconds": 1.13,
      "text": "See you then."
    }
  ]
}