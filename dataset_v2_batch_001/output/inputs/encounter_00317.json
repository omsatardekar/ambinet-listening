{
  "schema_version": "1.0",
  "encounter_id": "00317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.23,
      "duration_seconds": 3.59,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.35,
      "end_seconds": 10.82,
      "duration_seconds": 3.47,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.91,
      "end_seconds": 18.52,
      "duration_seconds": 6.61,
      "text": "I mean, uh, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.68,
      "end_seconds": 23.18,
      "duration_seconds": 3.5,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.48,
      "end_seconds": 29.31,
      "duration_seconds": 4.83,
      "text": "It's been feeling lightheaded, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.67,
      "end_seconds": 36.13,
      "duration_seconds": 5.46,
      "text": "How long has this been going on? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.51,
      "end_seconds": 39.31,
      "duration_seconds": 1.8,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.04,
      "end_seconds": 46.81,
      "duration_seconds": 6.77,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.46,
      "end_seconds": 53.02,
      "duration_seconds": 5.56,
      "text": "Right, I notice it more with standing up and hot weather. I'd say severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.27,
      "end_seconds": 57.35,
      "duration_seconds": 3.08,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.39,
      "end_seconds": 70.46,
      "duration_seconds": 12.07,
      "text": "When it starts I tend to get blurred vision for a few seconds as well. I've also been sweating. And there's a pounding in the head as well, ten days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.15,
      "end_seconds": 74.62,
      "duration_seconds": 3.47,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.23,
      "end_seconds": 78.32,
      "duration_seconds": 3.09,
      "text": "Uh, about a six out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.69,
      "end_seconds": 85.03,
      "duration_seconds": 5.34,
      "text": "Let me check a few things. Any slurred speech, fainting completely, chest pain or weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.52,
      "end_seconds": 91.58,
      "duration_seconds": 5.06,
      "text": "No slurred speech, fainting completely, chest pain or weakness, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.76,
      "end_seconds": 94.86,
      "duration_seconds": 2.1,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.39,
      "end_seconds": 101.06,
      "duration_seconds": 1.67,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.58,
      "end_seconds": 105.41,
      "duration_seconds": 2.83,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.16,
      "end_seconds": 110.96,
      "duration_seconds": 4.8,
      "text": "Amlodipine. I take it 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 111.87,
      "end_seconds": 120.6,
      "duration_seconds": 8.73,
      "text": "Doctor, I think the last prescription for the amlodipine was 2.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.2,
      "end_seconds": 125.3,
      "duration_seconds": 3.1,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.57,
      "end_seconds": 139.52,
      "duration_seconds": 9.95,
      "text": "I don't think I have it with me. I take metformin, 500 milligrams, twice a day. I used to take glimepiride, but I stopped it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 147.38,
      "duration_seconds": 7.51,
      "text": "What about allergies, to medicines or foods or anything else? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.27,
      "end_seconds": 156.42,
      "duration_seconds": 8.15,
      "text": "Sulfa drugs. I come out in... well, a rash. I'm allergic to latex, I get a rash on my hands."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.8,
      "end_seconds": 160.26,
      "duration_seconds": 2.46,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.77,
      "end_seconds": 163.46,
      "duration_seconds": 2.69,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 171.14,
      "duration_seconds": 7.3,
      "text": "What about your general health, any conditions you're being treated for? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.64,
      "end_seconds": 174.81,
      "duration_seconds": 3.17,
      "text": "I, I have high blood pressure. Yes, diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.12,
      "end_seconds": 185.97,
      "duration_seconds": 10.85,
      "text": "Right, so that's your known high blood pressure. We'll keep that in mind today. Yes, I can see the diabetes in your file as well. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.01,
      "end_seconds": 190.58,
      "duration_seconds": 1.57,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.53,
      "end_seconds": 194.89,
      "duration_seconds": 3.36,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.31,
      "end_seconds": 196.01,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.94,
      "end_seconds": 209.6,
      "duration_seconds": 4.66,
      "text": "Alright, I've got it. Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.52,
      "end_seconds": 225.59,
      "duration_seconds": 2.07,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.67,
      "end_seconds": 252.17,
      "duration_seconds": 9.5,
      "text": "Okay: pressure 101 over 59, pulse is 110 beats a minute, temperature 36.6. And SpO2 97 percent on room air, respiratory rate 16."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.37,
      "end_seconds": 257.7,
      "duration_seconds": 3.33,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.64,
      "end_seconds": 261.55,
      "duration_seconds": 1.91,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.57,
      "end_seconds": 281.03,
      "duration_seconds": 1.46,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.79,
      "end_seconds": 284.5,
      "duration_seconds": 1.71,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.43,
      "end_seconds": 304.13,
      "duration_seconds": 3.7,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 330.28,
      "duration_seconds": 20.36,
      "text": "All done, thank you, please sit down. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.66,
      "end_seconds": 334.96,
      "duration_seconds": 3.3,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.83,
      "end_seconds": 346.06,
      "duration_seconds": 10.23,
      "text": "Putting it all together, my working impression is postural low blood pressure. I want to be honest that this is an impression, not a final answer. I'd also keep dehydration in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.72,
      "end_seconds": 348.97,
      "duration_seconds": 2.25,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.11,
      "end_seconds": 363.94,
      "duration_seconds": 13.83,
      "text": "It's reasonable to be concerned, but right now postural low blood pressure is my leading thought, not anything worse. Let me just recap so I've got it right. You've been feeling lightheaded for two days, severe, and no chest pain or fainting completely."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.89,
      "end_seconds": 366.21,
      "duration_seconds": 1.32,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.2,
      "end_seconds": 376.98,
      "duration_seconds": 9.78,
      "text": "We should do a blood sugar test for dizziness. Let's get an ECG, for dizziness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.52,
      "end_seconds": 379.84,
      "duration_seconds": 1.32,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.45,
      "end_seconds": 404.8,
      "duration_seconds": 21.35,
      "text": "Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.23,
      "end_seconds": 406.45,
      "duration_seconds": 1.22,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.92,
      "end_seconds": 412.29,
      "duration_seconds": 5.37,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.93,
      "end_seconds": 414.72,
      "duration_seconds": 1.79,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.9,
      "end_seconds": 419.19,
      "duration_seconds": 3.29,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.61,
      "end_seconds": 424.41,
      "duration_seconds": 3.8,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.7,
      "end_seconds": 431.74,
      "duration_seconds": 6.04,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 433.29,
      "end_seconds": 437.66,
      "duration_seconds": 4.37,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.09,
      "end_seconds": 442.91,
      "duration_seconds": 3.82,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.69,
      "end_seconds": 446.44,
      "duration_seconds": 2.75,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.45,
      "end_seconds": 448.15,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}