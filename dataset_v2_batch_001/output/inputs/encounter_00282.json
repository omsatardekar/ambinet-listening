{
  "schema_version": "1.0",
  "encounter_id": "00282",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.88,
      "end_seconds": 5.76,
      "duration_seconds": 4.88,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.29,
      "end_seconds": 10.05,
      "duration_seconds": 2.76,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.81,
      "end_seconds": 16.06,
      "duration_seconds": 5.25,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.11,
      "end_seconds": 20.81,
      "duration_seconds": 3.7,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.73,
      "end_seconds": 29.72,
      "duration_seconds": 5.99,
      "text": "Uh, he's been having pain in my left wrist after a fall, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.4,
      "end_seconds": 32.45,
      "duration_seconds": 2.05,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 36.85,
      "duration_seconds": 2.93,
      "text": "Gripping and moving it definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.53,
      "end_seconds": 43.86,
      "duration_seconds": 6.33,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 43.96,
      "end_seconds": 48.47,
      "duration_seconds": 4.51,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.53,
      "end_seconds": 51.56,
      "duration_seconds": 2.03,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.14,
      "end_seconds": 54.82,
      "duration_seconds": 2.68,
      "text": "Has there been a weak grip too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 55.83,
      "end_seconds": 56.68,
      "duration_seconds": 0.85,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.07,
      "end_seconds": 59.61,
      "duration_seconds": 2.54,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.63,
      "end_seconds": 63.85,
      "duration_seconds": 3.22,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.56,
      "end_seconds": 66.87,
      "duration_seconds": 2.31,
      "text": "Any pain in the shoulder or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.23,
      "end_seconds": 77.23,
      "duration_seconds": 9.0,
      "text": "No, no pain in the shoulder, no numbness. I did have swelling at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.8,
      "end_seconds": 84.12,
      "duration_seconds": 5.32,
      "text": "Any pain in the elbow, bump to the head, deformity or loss of consciousness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.07,
      "end_seconds": 93.06,
      "duration_seconds": 7.99,
      "text": "I haven't had pain in the elbow, bump to the head, deformity or loss of consciousness, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.96,
      "end_seconds": 95.7,
      "duration_seconds": 1.74,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.57,
      "end_seconds": 98.23,
      "duration_seconds": 1.66,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.67,
      "end_seconds": 105.62,
      "duration_seconds": 5.95,
      "text": "Any allergies I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.55,
      "end_seconds": 113.82,
      "duration_seconds": 7.27,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 128.58,
      "duration_seconds": 13.25,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.23,
      "end_seconds": 130.95,
      "duration_seconds": 1.72,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 135.03,
      "duration_seconds": 2.95,
      "text": "Alright, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.12,
      "end_seconds": 141.89,
      "duration_seconds": 5.77,
      "text": "Thin bones, for two years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.65,
      "end_seconds": 143.7,
      "duration_seconds": 1.05,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 164.27,
      "duration_seconds": 19.28,
      "text": "I've had acid reflux for about a year now. Hmm, I've had eczema for nearly five years now. Sorry, I know I'm rambling a bit. I've had heart failure, yes. I wasn't sure whether to come in at all, to be honest. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.92,
      "end_seconds": 166.07,
      "duration_seconds": 1.15,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.39,
      "end_seconds": 170.27,
      "duration_seconds": 2.88,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.59,
      "end_seconds": 177.79,
      "duration_seconds": 6.2,
      "text": "What medicines are you taking at the moment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.69,
      "end_seconds": 182.9,
      "duration_seconds": 4.21,
      "text": "I'm on alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 184.27,
      "end_seconds": 188.32,
      "duration_seconds": 4.05,
      "text": "Doctor, our chart from the last visit lists it as 140 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.84,
      "end_seconds": 194.05,
      "duration_seconds": 4.21,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.46,
      "end_seconds": 208.71,
      "duration_seconds": 14.25,
      "text": "Not with me. I'll bring it next time. Omeprazole. I take it 20 milligrams, once a day. Spironolactone. I take it 25 milligrams, once a day. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 209.78,
      "end_seconds": 222.73,
      "duration_seconds": 12.95,
      "text": "Okay, so the vitals from earlier. Respiratory rate 18, pulse 68. Height 178 centimetres, BP is 114 over 76, BMI works out to 25.6, weight 81 kilos, SpO2 97 percent on room air, temperature 37.0."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.46,
      "end_seconds": 227.78,
      "duration_seconds": 4.32,
      "text": "Good, thank you. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.46,
      "end_seconds": 230.85,
      "duration_seconds": 2.39,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.23,
      "end_seconds": 234.64,
      "duration_seconds": 2.41,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 235.89,
      "end_seconds": 236.59,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.43,
      "end_seconds": 241.56,
      "duration_seconds": 3.13,
      "text": "Okay, now I'm going to check this part."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.11,
      "end_seconds": 259.51,
      "duration_seconds": 5.4,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 262.39,
      "duration_seconds": 1.59,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.92,
      "end_seconds": 282.77,
      "duration_seconds": 2.85,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.48,
      "end_seconds": 284.18,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.5,
      "end_seconds": 320.42,
      "duration_seconds": 30.92,
      "text": "All done, thank you, please sit down. From what you've told me and what I found, I think we're dealing with a wrist sprain, but a small fracture is possible at this stage. It could also be a scaphoid fracture, so we'll keep that open. I can't rule out a distal radius fracture yet. Let me just recap so I've got it right. You've had pain in your left wrist after a fall, and no deformity or numbness."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 320.92,
      "end_seconds": 322.29,
      "duration_seconds": 1.37,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.64,
      "end_seconds": 327.38,
      "duration_seconds": 3.74,
      "text": "I'd like to arrange an X-ray of the wrist for wrist injury."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.25,
      "end_seconds": 329.1,
      "duration_seconds": 0.85,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.67,
      "end_seconds": 337.84,
      "duration_seconds": 8.17,
      "text": "I'd like you to take paracetamol, 650 milligrams, three times a day, for five days. That should help with wrist pain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.61,
      "end_seconds": 341.38,
      "duration_seconds": 2.77,
      "text": "Okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.4,
      "end_seconds": 370.31,
      "duration_seconds": 27.91,
      "text": "I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.69,
      "end_seconds": 372.96,
      "duration_seconds": 1.27,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.55,
      "end_seconds": 379.07,
      "duration_seconds": 5.52,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.22,
      "end_seconds": 380.92,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.27,
      "end_seconds": 388.31,
      "duration_seconds": 3.04,
      "text": "I'd like to see you again after the X-ray."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.85,
      "end_seconds": 393.61,
      "duration_seconds": 3.76,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.67,
      "end_seconds": 402.2,
      "duration_seconds": 7.53,
      "text": "Just so I know I've explained it clearly, can you tell me the plan back in your own words?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.01,
      "end_seconds": 411.32,
      "duration_seconds": 8.31,
      "text": "So, I take the paracetamol, 650 milligrams, three times a day and come back after the X-ray. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.55,
      "end_seconds": 420.43,
      "duration_seconds": 5.88,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 423.47,
      "end_seconds": 426.67,
      "duration_seconds": 3.2,
      "text": "That's all, thank you for your time."
    }
  ]
}