{
  "schema_version": "1.0",
  "encounter_id": "00130",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 3.63,
      "duration_seconds": 2.86,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 8.69,
      "duration_seconds": 3.71,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.35,
      "end_seconds": 16.75,
      "duration_seconds": 7.4,
      "text": "Um, so... my heart racing. That's why I came. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.17,
      "end_seconds": 19.27,
      "duration_seconds": 2.1,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.96,
      "end_seconds": 21.72,
      "duration_seconds": 1.76,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.08,
      "end_seconds": 25.03,
      "duration_seconds": 1.95,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.67,
      "end_seconds": 29.28,
      "duration_seconds": 3.61,
      "text": "A seven out of ten, um, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.13,
      "end_seconds": 32.93,
      "duration_seconds": 2.8,
      "text": "Okay, have you been feeling hot and sweaty?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.61,
      "end_seconds": 43.65,
      "duration_seconds": 10.04,
      "text": "Yes, about the same, two weeks. As for feeling hot and sweaty, I'd say on and off. I've also been feeling anxious and jittery."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.88,
      "end_seconds": 49.28,
      "duration_seconds": 5.4,
      "text": "Alright. Let me check a few things. Any chest pain, shortness of breath or eye bulging?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.78,
      "end_seconds": 52.07,
      "duration_seconds": 2.29,
      "text": "So, no, none of those."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.26,
      "end_seconds": 54.84,
      "duration_seconds": 1.58,
      "text": "Have you had any diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.36,
      "end_seconds": 57.63,
      "duration_seconds": 1.27,
      "text": "No, no diarrhoea."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.18,
      "end_seconds": 60.75,
      "duration_seconds": 2.57,
      "text": "Go on. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.59,
      "end_seconds": 63.49,
      "duration_seconds": 1.9,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.96,
      "end_seconds": 65.97,
      "duration_seconds": 1.01,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.63,
      "end_seconds": 69.13,
      "duration_seconds": 2.5,
      "text": "Okay, so no, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 72.9,
      "duration_seconds": 3.24,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.02,
      "end_seconds": 74.98,
      "duration_seconds": 0.96,
      "text": "Yes, penicillin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.26,
      "end_seconds": 78.55,
      "duration_seconds": 2.29,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.59,
      "end_seconds": 84.85,
      "duration_seconds": 5.26,
      "text": "Right, um, I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.9,
      "end_seconds": 90.6,
      "duration_seconds": 2.7,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.14,
      "end_seconds": 96.56,
      "duration_seconds": 4.42,
      "text": "Yes, acid reflux. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.04,
      "end_seconds": 100.14,
      "duration_seconds": 2.1,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.36,
      "end_seconds": 113.76,
      "duration_seconds": 1.4,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.39,
      "end_seconds": 137.72,
      "duration_seconds": 5.33,
      "text": "Okay: respiratory rate 19, pressure 123 over 85. And heart rate 117, temperature 37.0."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.37,
      "end_seconds": 142.28,
      "duration_seconds": 3.91,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.68,
      "end_seconds": 143.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 160.05,
      "duration_seconds": 1.59,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.33,
      "end_seconds": 164.86,
      "duration_seconds": 3.53,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.07,
      "end_seconds": 167.03,
      "duration_seconds": 0.96,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.12,
      "end_seconds": 170.77,
      "duration_seconds": 2.65,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.24,
      "end_seconds": 184.75,
      "duration_seconds": 2.51,
      "text": "Your thyroid feels a little enlarged and smooth."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.57,
      "end_seconds": 189.13,
      "duration_seconds": 2.56,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.98,
      "end_seconds": 208.69,
      "duration_seconds": 5.71,
      "text": "There's a fine tremor in the outstretched hands, and your palms are warm and moist."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.07,
      "end_seconds": 209.77,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.69,
      "end_seconds": 231.76,
      "duration_seconds": 16.07,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. From what you've told me and what I found, it fits best with an overactive thyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 235.22,
      "duration_seconds": 2.4,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.34,
      "end_seconds": 251.01,
      "duration_seconds": 14.67,
      "text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. Let me just recap so I've got it right. You've had your heart racing for one week, and no chest pain or shortness of breath."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.56,
      "end_seconds": 252.83,
      "duration_seconds": 1.27,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.77,
      "end_seconds": 260.18,
      "duration_seconds": 6.41,
      "text": "I'd like to arrange a thyroid scan for hyperthyroidism. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.25,
      "end_seconds": 263.61,
      "duration_seconds": 2.36,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.88,
      "end_seconds": 278.83,
      "duration_seconds": 13.95,
      "text": "I'm going to order an ECG, for palpitations. I'd rather check than guess, and this is the quickest way to know more. I'm prescribing propranolol, 20 milligrams, twice a day, until we review. It's for palpitations and tremor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.2,
      "end_seconds": 282.57,
      "duration_seconds": 3.37,
      "text": "Alright, you know, I'll pick it up today."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.96,
      "end_seconds": 309.06,
      "duration_seconds": 26.1,
      "text": "Limit tea, coffee and anything that speeds up the heart for now. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please take the tablets with food so they don't upset your stomach. I'll also refer you to an endocrinologist. I want you to come back or go to emergency straight away if the symptoms get worse. Come back in two weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.05,
      "end_seconds": 312.83,
      "duration_seconds": 2.78,
      "text": "Uh, okay, I'll book that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.16,
      "end_seconds": 316.77,
      "duration_seconds": 3.61,
      "text": "Right, we're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.29,
      "end_seconds": 320.32,
      "duration_seconds": 2.03,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.7,
      "end_seconds": 322.44,
      "duration_seconds": 0.74,
      "text": "Take care."
    }
  ]
}