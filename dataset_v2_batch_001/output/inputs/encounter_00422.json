{
  "schema_version": "1.0",
  "encounter_id": "00422",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 7.22,
      "duration_seconds": 6.32,
      "text": "Yeah, hi, doctor, I brought my bag, is it fine to leave it here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 10.8,
      "duration_seconds": 3.2,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.64,
      "end_seconds": 18.79,
      "duration_seconds": 7.15,
      "text": "Um, so... hot flushes. That's why I came. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.22,
      "end_seconds": 20.77,
      "duration_seconds": 1.55,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.81,
      "end_seconds": 33.34,
      "duration_seconds": 8.53,
      "text": "Right, it's been about four days now. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.69,
      "end_seconds": 38.68,
      "duration_seconds": 4.99,
      "text": "I see. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.4,
      "end_seconds": 47.45,
      "duration_seconds": 8.05,
      "text": "About a five out of ten. It settles a little with a fan. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.3,
      "end_seconds": 50.67,
      "duration_seconds": 2.37,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.45,
      "end_seconds": 52.26,
      "duration_seconds": 0.81,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.57,
      "end_seconds": 68.51,
      "duration_seconds": 3.94,
      "text": "Right, thanks for waiting. Any weight loss or chest pain at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.04,
      "end_seconds": 74.1,
      "duration_seconds": 5.06,
      "text": "Um, you know, no, no weight loss or chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.15,
      "end_seconds": 76.17,
      "duration_seconds": 1.02,
      "text": "What about palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.82,
      "end_seconds": 80.18,
      "duration_seconds": 1.36,
      "text": "No. No palpitations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.63,
      "end_seconds": 82.63,
      "duration_seconds": 2.0,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.97,
      "end_seconds": 85.1,
      "duration_seconds": 2.13,
      "text": "No, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.95,
      "end_seconds": 100.73,
      "duration_seconds": 14.78,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.48,
      "end_seconds": 103.66,
      "duration_seconds": 2.18,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 107.54,
      "duration_seconds": 2.61,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.15,
      "end_seconds": 110.81,
      "duration_seconds": 2.66,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.19,
      "end_seconds": 116.14,
      "duration_seconds": 3.95,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.68,
      "end_seconds": 120.59,
      "duration_seconds": 2.91,
      "text": "No problem, you know, take your time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.98,
      "end_seconds": 122.92,
      "duration_seconds": 0.94,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.17,
      "end_seconds": 127.65,
      "duration_seconds": 1.48,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.07,
      "end_seconds": 131.11,
      "duration_seconds": 2.04,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.42,
      "end_seconds": 135.84,
      "duration_seconds": 3.42,
      "text": "Yes, I had my gallbladder removed, in 2016."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.68,
      "end_seconds": 138.56,
      "duration_seconds": 1.88,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.26,
      "end_seconds": 148.55,
      "duration_seconds": 1.29,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.93,
      "end_seconds": 165.92,
      "duration_seconds": 7.99,
      "text": "Okay: respiratory rate 18, blood pressure 117 over 82, pulse 79, temperature is 36.6 degrees, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.95,
      "end_seconds": 170.28,
      "duration_seconds": 1.33,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.86,
      "end_seconds": 174.44,
      "duration_seconds": 2.58,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.49,
      "end_seconds": 178.43,
      "duration_seconds": 1.94,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.44,
      "end_seconds": 181.59,
      "duration_seconds": 2.15,
      "text": "Right, look straight ahead for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.92,
      "end_seconds": 201.07,
      "duration_seconds": 5.15,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.1,
      "end_seconds": 202.8,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.26,
      "end_seconds": 225.05,
      "duration_seconds": 16.79,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Okay, so my impression is this: It fits best with perimenopausal symptoms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.37,
      "end_seconds": 231.84,
      "duration_seconds": 6.47,
      "text": "Oh, uh, I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.29,
      "end_seconds": 250.31,
      "duration_seconds": 17.02,
      "text": "I understand the worry. At the moment I'd say it's perimenopausal symptoms, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've had hot flushes for about four days, and no weight loss or chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.37,
      "end_seconds": 252.69,
      "duration_seconds": 1.32,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.14,
      "end_seconds": 278.74,
      "duration_seconds": 24.6,
      "text": "We should do blood tests for irregular periods. It's a routine test and it'll give us a much clearer picture. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. A short walk every day, even twenty minutes, will help more than you'd think. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.76,
      "end_seconds": 280.46,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.07,
      "end_seconds": 283.59,
      "duration_seconds": 2.52,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.07,
      "end_seconds": 287.13,
      "duration_seconds": 2.06,
      "text": "Right, okay, I'll book that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.87,
      "end_seconds": 293.43,
      "duration_seconds": 5.56,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.2,
      "end_seconds": 298.74,
      "duration_seconds": 4.54,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.35,
      "end_seconds": 304.59,
      "duration_seconds": 5.24,
      "text": "Yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.43,
      "end_seconds": 307.82,
      "duration_seconds": 2.39,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.88,
      "end_seconds": 309.58,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}