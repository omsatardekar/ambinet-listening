{
  "schema_version": "1.0",
  "encounter_id": "00407",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.45,
      "duration_seconds": 2.47,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.96,
      "end_seconds": 6.23,
      "duration_seconds": 2.27,
      "text": "Hello, doctor. Thanks for seeing me."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.27,
      "end_seconds": 9.42,
      "duration_seconds": 2.15,
      "text": "How can I help you today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.73,
      "end_seconds": 19.55,
      "duration_seconds": 8.82,
      "text": "So, um, I've been feeling a bit dizzy after taking all my tablets, doctor. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.07,
      "end_seconds": 22.01,
      "duration_seconds": 1.94,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.52,
      "end_seconds": 30.57,
      "duration_seconds": 8.05,
      "text": "For two days, I'd say. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.13,
      "end_seconds": 34.99,
      "duration_seconds": 3.86,
      "text": "Right, is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.1,
      "end_seconds": 38.43,
      "duration_seconds": 2.33,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.82,
      "end_seconds": 39.52,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.44,
      "end_seconds": 47.09,
      "duration_seconds": 6.65,
      "text": "I've been feeling drowsy in the afternoon too. I had an upset stomach before. That's settled now, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.51,
      "end_seconds": 52.41,
      "duration_seconds": 3.9,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.37,
      "end_seconds": 67.47,
      "duration_seconds": 11.1,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.95,
      "end_seconds": 73.08,
      "duration_seconds": 4.13,
      "text": "Let me check a few things. Any falls, low mood or black stools?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.06,
      "end_seconds": 75.97,
      "duration_seconds": 1.91,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.37,
      "end_seconds": 79.7,
      "duration_seconds": 2.33,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.47,
      "end_seconds": 81.69,
      "duration_seconds": 1.22,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.91,
      "end_seconds": 90.08,
      "duration_seconds": 7.17,
      "text": "Okay, what about your general health, any conditions you're being treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.5,
      "end_seconds": 91.74,
      "duration_seconds": 1.24,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.77,
      "end_seconds": 95.39,
      "duration_seconds": 2.62,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.0,
      "end_seconds": 96.78,
      "duration_seconds": 0.78,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.29,
      "end_seconds": 115.44,
      "duration_seconds": 6.15,
      "text": "Alright, I've got it. What medicines do you take regularly? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.59,
      "end_seconds": 124.98,
      "duration_seconds": 8.39,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.23,
      "end_seconds": 128.68,
      "duration_seconds": 2.45,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.25,
      "end_seconds": 131.56,
      "duration_seconds": 2.31,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.45,
      "end_seconds": 148.18,
      "duration_seconds": 2.73,
      "text": "Right, thanks for waiting. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.14,
      "end_seconds": 160.11,
      "duration_seconds": 10.97,
      "text": "Yes, I had my gallbladder removed, in 2016. I'd rather know what's going on than keep guessing. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 164.69,
      "duration_seconds": 4.02,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.52,
      "end_seconds": 169.0,
      "duration_seconds": 3.48,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.51,
      "end_seconds": 171.36,
      "duration_seconds": 1.85,
      "text": "Alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.82,
      "end_seconds": 177.01,
      "duration_seconds": 4.19,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.97,
      "end_seconds": 182.22,
      "duration_seconds": 4.25,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.49,
      "end_seconds": 186.34,
      "duration_seconds": 2.85,
      "text": "So, not that I know, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.9,
      "end_seconds": 189.16,
      "duration_seconds": 2.26,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.86,
      "end_seconds": 196.8,
      "duration_seconds": 6.94,
      "text": "Busy. Everyone's running in different directions at the moment, you know, you know how it is."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.98,
      "end_seconds": 203.03,
      "duration_seconds": 5.05,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.0,
      "end_seconds": 212.98,
      "duration_seconds": 8.98,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.02,
      "end_seconds": 219.26,
      "duration_seconds": 4.24,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.25,
      "end_seconds": 220.95,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.89,
      "end_seconds": 225.2,
      "duration_seconds": 3.31,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.24,
      "end_seconds": 239.19,
      "duration_seconds": 2.95,
      "text": "Your blood pressure falls a little when you stand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.48,
      "end_seconds": 258.65,
      "duration_seconds": 16.17,
      "text": "Okay, you can sit back up. So, based on the history and the examination, this looks most like possible side effects from too many medicines. The reason I say that is that your story and my examination fit together. Dehydration is also on my list."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.12,
      "end_seconds": 261.81,
      "duration_seconds": 1.69,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.58,
      "end_seconds": 279.47,
      "duration_seconds": 16.89,
      "text": "It's reasonable to be concerned, but right now possible side effects from too many medicines is my leading thought, not anything worse. Let me just recap so I've got it right. You've been feeling a bit dizzy after taking all your tablets for two days, and no low mood or falls."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.86,
      "end_seconds": 281.42,
      "duration_seconds": 1.56,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 285.76,
      "duration_seconds": 2.89,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.62,
      "end_seconds": 288.92,
      "duration_seconds": 2.3,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.91,
      "end_seconds": 318.12,
      "duration_seconds": 28.21,
      "text": "We should do an ECG for dizziness. Use a weekly pill organiser so the doses don't get mixed. A short walk every day, even twenty minutes, will help more than you'd think. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.16,
      "end_seconds": 322.0,
      "duration_seconds": 2.84,
      "text": "Yes, um, I'll do that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.55,
      "end_seconds": 331.95,
      "duration_seconds": 8.4,
      "text": "Please come and see me in two weeks. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.43,
      "end_seconds": 336.71,
      "duration_seconds": 4.28,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.67,
      "end_seconds": 342.75,
      "duration_seconds": 5.08,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.08,
      "end_seconds": 345.27,
      "duration_seconds": 2.19,
      "text": "Thank you. I'll see you then."
    }
  ]
}