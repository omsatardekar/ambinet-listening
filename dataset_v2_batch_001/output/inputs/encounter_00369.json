{
  "schema_version": "1.0",
  "encounter_id": "00369",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 5.35,
      "duration_seconds": 4.13,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 9.83,
      "duration_seconds": 3.5,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.5,
      "end_seconds": 15.3,
      "duration_seconds": 4.8,
      "text": "I've been wanting to stop smoking, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.74,
      "end_seconds": 20.0,
      "duration_seconds": 4.26,
      "text": "Okay, what about a smoker's cough in the mornings, have you noticed that?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 22.96,
      "duration_seconds": 1.95,
      "text": "Yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.3,
      "end_seconds": 27.48,
      "duration_seconds": 3.18,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 30.01,
      "duration_seconds": 1.11,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.06,
      "end_seconds": 34.91,
      "duration_seconds": 3.85,
      "text": "Have you been getting out of breath quicker than before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.65,
      "end_seconds": 44.51,
      "duration_seconds": 8.86,
      "text": "Yes, actually. I mean, about getting out of breath quicker than before, a eight out of ten, I suppose. Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.92,
      "end_seconds": 50.17,
      "duration_seconds": 4.25,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.54,
      "end_seconds": 51.37,
      "duration_seconds": 0.83,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.7,
      "end_seconds": 69.33,
      "duration_seconds": 7.63,
      "text": "Right, thanks for waiting. Let me check a few things. Any weight loss, chest pain, low mood or coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 74.34,
      "duration_seconds": 4.09,
      "text": "So, you know, no, none of that at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.14,
      "end_seconds": 79.76,
      "duration_seconds": 2.62,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.16,
      "end_seconds": 83.87,
      "duration_seconds": 2.71,
      "text": "Oh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 86.59,
      "duration_seconds": 2.19,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.39,
      "end_seconds": 88.82,
      "duration_seconds": 1.43,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 93.33,
      "duration_seconds": 3.93,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.84,
      "end_seconds": 97.84,
      "duration_seconds": 4.0,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 99.41,
      "end_seconds": 107.43,
      "duration_seconds": 8.02,
      "text": "Doctor, I've got the readings for you. Temperature 36.7, pressure 108 over 79. Oxygen saturation is 98 percent, pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.01,
      "end_seconds": 110.3,
      "duration_seconds": 1.29,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.8,
      "end_seconds": 114.17,
      "duration_seconds": 2.37,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.81,
      "end_seconds": 115.68,
      "duration_seconds": 0.87,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.22,
      "end_seconds": 127.0,
      "duration_seconds": 4.78,
      "text": "Okay, here we go. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.5,
      "end_seconds": 129.76,
      "duration_seconds": 2.26,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.38,
      "end_seconds": 133.31,
      "duration_seconds": 2.93,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.91,
      "end_seconds": 151.55,
      "duration_seconds": 5.64,
      "text": "Right, good, where were we. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.47,
      "end_seconds": 154.85,
      "duration_seconds": 2.38,
      "text": "Well, my brother has asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.28,
      "end_seconds": 158.37,
      "duration_seconds": 3.09,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.44,
      "end_seconds": 164.82,
      "duration_seconds": 2.38,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.55,
      "end_seconds": 171.26,
      "duration_seconds": 5.71,
      "text": "Do you have any medical conditions, anything you've been treated for? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.15,
      "end_seconds": 183.67,
      "duration_seconds": 9.52,
      "text": "High blood pressure, for nearly five years. I'm hoping you can tell me something definite. I have COPD. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.28,
      "end_seconds": 184.98,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 197.07,
      "duration_seconds": 10.52,
      "text": "Okay, so I've had acid reflux for about a year now. Sorry, I know I'm rambling a bit. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.6,
      "end_seconds": 199.75,
      "duration_seconds": 1.15,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.28,
      "end_seconds": 213.91,
      "duration_seconds": 12.63,
      "text": "So, yes, I can see the high blood pressure in your file as well. Yes, I can see the COPD in your file as well. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.9,
      "end_seconds": 228.19,
      "duration_seconds": 13.29,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.07,
      "end_seconds": 231.35,
      "duration_seconds": 2.28,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.39,
      "end_seconds": 237.94,
      "duration_seconds": 5.55,
      "text": "I mean, I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.75,
      "end_seconds": 240.94,
      "duration_seconds": 2.19,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.99,
      "end_seconds": 247.74,
      "duration_seconds": 5.75,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.12,
      "end_seconds": 253.06,
      "duration_seconds": 3.94,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.38,
      "end_seconds": 261.18,
      "duration_seconds": 7.8,
      "text": "I, I take ramipril, 5 milligrams, every morning for my blood pressure. It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 262.12,
      "duration_seconds": 0.7,
      "text": "Mm-hm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 263.54,
      "end_seconds": 269.03,
      "duration_seconds": 5.49,
      "text": "Omeprazole. I take it 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 269.74,
      "end_seconds": 273.89,
      "duration_seconds": 4.15,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.13,
      "end_seconds": 279.14,
      "duration_seconds": 4.01,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 279.57,
      "end_seconds": 281.84,
      "duration_seconds": 2.27,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.25,
      "end_seconds": 284.79,
      "duration_seconds": 2.54,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 285.52,
      "end_seconds": 300.49,
      "duration_seconds": 14.97,
      "text": "Right, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.39,
      "end_seconds": 305.15,
      "duration_seconds": 1.76,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.6,
      "end_seconds": 307.3,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.16,
      "end_seconds": 310.4,
      "duration_seconds": 1.24,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.07,
      "end_seconds": 329.35,
      "duration_seconds": 4.28,
      "text": "Chest sounds clear, a bit of wheeze when you breathe out hard."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.55,
      "end_seconds": 333.25,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.73,
      "end_seconds": 354.83,
      "duration_seconds": 16.1,
      "text": "Okay, you can sit back up. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 356.13,
      "end_seconds": 357.97,
      "duration_seconds": 1.84,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.05,
      "end_seconds": 370.48,
      "duration_seconds": 11.43,
      "text": "Okay, so my impression is this: My working impression is nicotine dependence. That's my thinking for now, and it may change as we learn more. Early chronic bronchitis is also on my list."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.04,
      "end_seconds": 374.39,
      "duration_seconds": 2.35,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.42,
      "end_seconds": 399.7,
      "duration_seconds": 24.28,
      "text": "Nothing I've seen today points to an emergency. It looks like nicotine dependence, but I'd like to confirm. Let's get breathing tests, for smoker's cough. It's a routine test and it'll give us a much clearer picture. I'll start you on nicotine patches, 14 milligrams, once a day, for six weeks. That should help with smoking cessation. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 401.07,
      "end_seconds": 403.49,
      "duration_seconds": 2.42,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.34,
      "end_seconds": 428.18,
      "duration_seconds": 23.84,
      "text": "Pick a quit date this month, and tell your family so they can back you up. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Don't skip meals, and try to eat smaller portions more often through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 429.27,
      "end_seconds": 431.62,
      "duration_seconds": 2.35,
      "text": "Okay, uh, I will."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.05,
      "end_seconds": 437.42,
      "duration_seconds": 5.37,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 437.94,
      "end_seconds": 440.49,
      "duration_seconds": 2.55,
      "text": "Hmm, got it, thank you."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.97,
      "end_seconds": 444.85,
      "duration_seconds": 2.88,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 445.94,
      "end_seconds": 449.97,
      "duration_seconds": 4.03,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.55,
      "end_seconds": 457.5,
      "duration_seconds": 6.95,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 458.95,
      "end_seconds": 463.11,
      "duration_seconds": 4.16,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.28,
      "end_seconds": 469.99,
      "duration_seconds": 5.71,
      "text": "Yes, exactly right. Okay, I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 470.68,
      "end_seconds": 474.67,
      "duration_seconds": 3.99,
      "text": "Nothing more from me, you know, doctor, thanks."
    }
  ]
}