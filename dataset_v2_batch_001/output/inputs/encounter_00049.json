{
  "schema_version": "1.0",
  "encounter_id": "00049",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 5.66,
      "duration_seconds": 4.89,
      "text": "Good afternoon, uh, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.14,
      "duration_seconds": 3.71,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.29,
      "end_seconds": 18.27,
      "duration_seconds": 6.98,
      "text": "It's pain low in the pelvis. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.14,
      "end_seconds": 21.35,
      "duration_seconds": 2.21,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.42,
      "end_seconds": 31.49,
      "duration_seconds": 9.07,
      "text": "Probably about three months. Yeah. I just want to get back to normal, really. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.79,
      "end_seconds": 35.1,
      "duration_seconds": 2.31,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.64,
      "end_seconds": 37.09,
      "duration_seconds": 1.45,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.7,
      "end_seconds": 41.21,
      "duration_seconds": 3.51,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.61,
      "end_seconds": 58.26,
      "duration_seconds": 5.65,
      "text": "Right, carry on. Let me check a few things. Any vomiting, fever or burning when passing urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 62.06,
      "duration_seconds": 2.59,
      "text": "No, you know, none of those."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.55,
      "end_seconds": 65.15,
      "duration_seconds": 2.6,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.53,
      "end_seconds": 67.95,
      "duration_seconds": 1.42,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.95,
      "end_seconds": 70.03,
      "duration_seconds": 1.08,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 72.93,
      "duration_seconds": 1.59,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 87.47,
      "duration_seconds": 13.16,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.55,
      "end_seconds": 90.19,
      "duration_seconds": 1.64,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.57,
      "end_seconds": 92.57,
      "duration_seconds": 2.0,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.53,
      "end_seconds": 98.61,
      "duration_seconds": 3.08,
      "text": "Um, no, nothing I'm aware of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.38,
      "end_seconds": 102.35,
      "duration_seconds": 2.97,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.55,
      "end_seconds": 105.64,
      "duration_seconds": 2.09,
      "text": "Epilepsy, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.5,
      "end_seconds": 110.21,
      "duration_seconds": 3.71,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.93,
      "end_seconds": 114.51,
      "duration_seconds": 3.58,
      "text": "I'd rather not, uh, if you don't mind."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.59,
      "end_seconds": 121.15,
      "duration_seconds": 5.56,
      "text": "Let's go through your medication. What are you taking? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.06,
      "end_seconds": 128.7,
      "duration_seconds": 3.64,
      "text": "I'm on levetiracetam, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.23,
      "end_seconds": 131.99,
      "duration_seconds": 1.76,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.71,
      "end_seconds": 141.55,
      "duration_seconds": 8.84,
      "text": "500 milligrams, I think that's what's on the box. Mefenamic acid. I take it 500 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.88,
      "end_seconds": 154.15,
      "duration_seconds": 12.27,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.11,
      "end_seconds": 156.68,
      "duration_seconds": 1.57,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.72,
      "end_seconds": 161.98,
      "duration_seconds": 2.26,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.73,
      "end_seconds": 177.08,
      "duration_seconds": 1.35,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.94,
      "end_seconds": 200.34,
      "duration_seconds": 4.4,
      "text": "Okay: blood pressure 122 over 74, saturation 97 percent, heart rate 86."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.46,
      "end_seconds": 202.65,
      "duration_seconds": 1.19,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.67,
      "end_seconds": 206.63,
      "duration_seconds": 2.96,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.42,
      "end_seconds": 210.07,
      "duration_seconds": 2.65,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.55,
      "end_seconds": 211.39,
      "duration_seconds": 0.84,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.07,
      "end_seconds": 233.98,
      "duration_seconds": 6.91,
      "text": "Right, thanks for waiting. Okay, is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.41,
      "end_seconds": 243.44,
      "duration_seconds": 9.03,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.98,
      "end_seconds": 251.09,
      "duration_seconds": 6.11,
      "text": "Okay, so my impression from what you've said is this: My working impression is chronic pelvic pain, possibly endometriosis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.73,
      "end_seconds": 254.06,
      "duration_seconds": 2.33,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.76,
      "end_seconds": 272.09,
      "duration_seconds": 17.33,
      "text": "I understand the worry. At the moment I'd say it's chronic pelvic pain, possibly endometriosis, and we'll know more once the a pelvic ultrasound is back. Let me just recap so I've got it right. You've had pain low in the pelvis for about three months, moderate, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.46,
      "end_seconds": 274.66,
      "duration_seconds": 1.2,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 279.34,
      "duration_seconds": 3.94,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.83,
      "end_seconds": 283.82,
      "duration_seconds": 2.99,
      "text": "Hmm, I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.18,
      "end_seconds": 309.08,
      "duration_seconds": 23.9,
      "text": "Let's get a pelvic ultrasound, for pelvic pain. That will help us see what's going on underneath and decide the next step. A heat pad and some gentle movement help many people, and a pain diary helps me see a pattern. Please take the tablets with food so they don't upset your stomach. I want you to come back or go to emergency straight away if the pain becomes sudden and severe or you faint."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.06,
      "end_seconds": 318.51,
      "duration_seconds": 8.45,
      "text": "Please come and see me in four weeks. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.77,
      "end_seconds": 323.5,
      "duration_seconds": 3.73,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.44,
      "end_seconds": 328.94,
      "duration_seconds": 4.5,
      "text": "Yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.45,
      "end_seconds": 332.5,
      "duration_seconds": 2.05,
      "text": "Alright, thanks. Bye for now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.84,
      "end_seconds": 333.54,
      "duration_seconds": 0.7,
      "text": "Take care."
    }
  ]
}