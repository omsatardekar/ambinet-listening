{
  "schema_version": "1.0",
  "encounter_id": "00380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 5.36,
      "duration_seconds": 4.85,
      "text": "Well, um, excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.39,
      "end_seconds": 13.63,
      "duration_seconds": 4.24,
      "text": "Of course, put it down anywhere. So, how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 24.88,
      "duration_seconds": 9.86,
      "text": "Oh, mainly I've been feeling very thirsty. That's why I came. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.25,
      "end_seconds": 28.31,
      "duration_seconds": 2.06,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.99,
      "end_seconds": 48.38,
      "duration_seconds": 19.39,
      "text": "I've had it since Monday. Um, uh, I've also had itching around the private area, since last Tuesday. Well, as for tiredness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.64,
      "end_seconds": 52.36,
      "duration_seconds": 2.72,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.0,
      "end_seconds": 57.47,
      "duration_seconds": 4.47,
      "text": "I mean, yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.5,
      "end_seconds": 61.26,
      "duration_seconds": 2.76,
      "text": "Any breathlessness, vomiting or blurred vision at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.76,
      "end_seconds": 66.88,
      "duration_seconds": 4.12,
      "text": "Uh, no, no breathlessness, vomiting or blurred vision."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.31,
      "end_seconds": 71.98,
      "duration_seconds": 3.67,
      "text": "Have you had any fruity smell on the breath or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.39,
      "end_seconds": 78.9,
      "duration_seconds": 5.51,
      "text": "Okay, so no fruity smell on the breath or fever, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 82.73,
      "duration_seconds": 2.45,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.1,
      "end_seconds": 86.04,
      "duration_seconds": 2.94,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.3,
      "end_seconds": 89.08,
      "duration_seconds": 1.78,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.52,
      "end_seconds": 93.18,
      "duration_seconds": 2.66,
      "text": "Well, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 96.85,
      "duration_seconds": 3.04,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.35,
      "end_seconds": 105.36,
      "duration_seconds": 5.01,
      "text": "Right, um, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.94,
      "end_seconds": 108.5,
      "duration_seconds": 2.56,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.46,
      "end_seconds": 112.65,
      "duration_seconds": 3.19,
      "text": "Yes, codeine, it gives me vomiting."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.66,
      "end_seconds": 116.56,
      "duration_seconds": 2.9,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.71,
      "end_seconds": 135.86,
      "duration_seconds": 18.15,
      "text": "Not really, um, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.16,
      "end_seconds": 139.15,
      "duration_seconds": 1.99,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 152.51,
      "duration_seconds": 10.05,
      "text": "I'm on sodium valproate, 500 milligrams, twice a day for the fits. I'd been on levetiracetam, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.32,
      "end_seconds": 155.82,
      "duration_seconds": 2.5,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.67,
      "end_seconds": 157.49,
      "duration_seconds": 0.82,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.11,
      "end_seconds": 176.19,
      "duration_seconds": 4.08,
      "text": "Okay, here we go. So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.99,
      "end_seconds": 180.54,
      "duration_seconds": 1.55,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.63,
      "end_seconds": 193.99,
      "duration_seconds": 12.36,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.37,
      "end_seconds": 203.6,
      "duration_seconds": 5.23,
      "text": "Well, you know, good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.25,
      "end_seconds": 209.51,
      "duration_seconds": 5.26,
      "text": "Moving on to your background, any past medical history? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.69,
      "end_seconds": 220.03,
      "duration_seconds": 9.34,
      "text": "High cholesterol, for about ten years. Hmm, I've had epilepsy, yes. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.61,
      "end_seconds": 226.12,
      "duration_seconds": 4.51,
      "text": "Alright. Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.44,
      "end_seconds": 228.64,
      "duration_seconds": 2.2,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.18,
      "end_seconds": 231.42,
      "duration_seconds": 2.24,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.65,
      "end_seconds": 241.32,
      "duration_seconds": 1.67,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.03,
      "end_seconds": 266.3,
      "duration_seconds": 5.27,
      "text": "Okay: pulse 69, pressure 109 over 71. And saturation 99 percent, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.18,
      "end_seconds": 268.63,
      "duration_seconds": 1.45,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.13,
      "end_seconds": 272.96,
      "duration_seconds": 2.83,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.21,
      "end_seconds": 277.87,
      "duration_seconds": 3.66,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.49,
      "end_seconds": 279.19,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.34,
      "end_seconds": 294.96,
      "duration_seconds": 1.62,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.79,
      "end_seconds": 299.35,
      "duration_seconds": 1.56,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.76,
      "end_seconds": 300.46,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 305.37,
      "duration_seconds": 2.99,
      "text": "Right, tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.35,
      "end_seconds": 321.09,
      "duration_seconds": 3.74,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.0,
      "end_seconds": 325.34,
      "duration_seconds": 2.34,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.94,
      "end_seconds": 341.15,
      "duration_seconds": 2.21,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.02,
      "end_seconds": 350.0,
      "duration_seconds": 2.98,
      "text": "All done, thank you, please sit down."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.49,
      "end_seconds": 354.54,
      "duration_seconds": 3.05,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.03,
      "end_seconds": 355.85,
      "duration_seconds": 0.82,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.56,
      "end_seconds": 383.16,
      "duration_seconds": 12.6,
      "text": "Okay, here we go. Putting it all together, it fits best with possible new-onset diabetes. The reason I say that is that your story and my examination fit together. I'd also keep diabetes insipidus in mind."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.55,
      "end_seconds": 387.04,
      "duration_seconds": 2.49,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.46,
      "end_seconds": 401.92,
      "duration_seconds": 14.46,
      "text": "It's reasonable to be concerned, but right now possible new-onset diabetes is my leading thought, not anything worse. Let me just recap so I've got it right. You've been feeling very thirsty, since Monday, and no fever or vomiting."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.46,
      "end_seconds": 404.65,
      "duration_seconds": 2.19,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.13,
      "end_seconds": 410.15,
      "duration_seconds": 4.02,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.38,
      "end_seconds": 424.71,
      "duration_seconds": 13.33,
      "text": "Well, um, for the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.44,
      "end_seconds": 432.35,
      "duration_seconds": 6.91,
      "text": "I'm going to order an HbA1c, for possible diabetes. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 432.96,
      "end_seconds": 437.1,
      "duration_seconds": 4.14,
      "text": "We have a slot Friday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.82,
      "end_seconds": 466.9,
      "duration_seconds": 29.08,
      "text": "I'd like to arrange a urine test for polyuria. I'd rather check than guess, and this is the quickest way to know more. I'm going to order a blood sugar test, for polydipsia and polyuria. The result will help us decide whether anything more is needed. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 468.21,
      "end_seconds": 474.22,
      "duration_seconds": 6.01,
      "text": "Please don't sit on it if you start vomiting or become drowsy. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 475.38,
      "end_seconds": 477.23,
      "duration_seconds": 1.85,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 478.55,
      "end_seconds": 481.32,
      "duration_seconds": 2.77,
      "text": "Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 482.38,
      "end_seconds": 484.14,
      "duration_seconds": 1.76,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 484.77,
      "end_seconds": 488.79,
      "duration_seconds": 4.02,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 491.19,
      "end_seconds": 497.54,
      "duration_seconds": 6.35,
      "text": "So, um, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 497.96,
      "end_seconds": 502.23,
      "duration_seconds": 4.27,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 503.47,
      "end_seconds": 509.48,
      "duration_seconds": 6.01,
      "text": "Hmm, um, I think that's clear. Thank you for being so thorough."
    }
  ]
}