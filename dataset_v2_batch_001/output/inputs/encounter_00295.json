{
  "schema_version": "1.0",
  "encounter_id": "00295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 7.14,
      "duration_seconds": 6.24,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.08,
      "end_seconds": 14.87,
      "duration_seconds": 3.79,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.89,
      "end_seconds": 21.24,
      "duration_seconds": 5.35,
      "text": "Oh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.1,
      "end_seconds": 24.52,
      "duration_seconds": 2.42,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.45,
      "end_seconds": 32.74,
      "duration_seconds": 7.29,
      "text": "I've been feeling low most days. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.88,
      "end_seconds": 36.22,
      "duration_seconds": 2.34,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.92,
      "end_seconds": 39.65,
      "duration_seconds": 2.73,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.84,
      "end_seconds": 43.43,
      "duration_seconds": 2.59,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.91,
      "end_seconds": 49.32,
      "duration_seconds": 4.41,
      "text": "No energy goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.73,
      "end_seconds": 51.42,
      "duration_seconds": 1.69,
      "text": "Have you had trouble sleeping?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.0,
      "end_seconds": 58.88,
      "duration_seconds": 6.88,
      "text": "Yes, about the same, two years. As for trouble sleeping, about a seven out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.19,
      "end_seconds": 62.99,
      "duration_seconds": 3.8,
      "text": "Have you been losing interest in things you used to enjoy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.56,
      "end_seconds": 71.69,
      "duration_seconds": 8.13,
      "text": "Mm, yes. About losing interest in things I used to enjoy, a five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.08,
      "end_seconds": 75.03,
      "duration_seconds": 2.95,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.26,
      "end_seconds": 77.6,
      "duration_seconds": 1.34,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.79,
      "end_seconds": 84.06,
      "duration_seconds": 5.27,
      "text": "Have you had any periods of unusually high energy or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.84,
      "end_seconds": 86.61,
      "duration_seconds": 1.77,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.34,
      "end_seconds": 91.25,
      "duration_seconds": 3.91,
      "text": "Okay, have you had any hearing voices or panic attacks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.59,
      "end_seconds": 95.58,
      "duration_seconds": 3.99,
      "text": "Okay, so no, none of that at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.05,
      "end_seconds": 97.71,
      "duration_seconds": 1.66,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 100.43,
      "duration_seconds": 1.78,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.76,
      "end_seconds": 103.98,
      "duration_seconds": 3.22,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.42,
      "end_seconds": 107.51,
      "duration_seconds": 2.09,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 109.09,
      "end_seconds": 120.43,
      "duration_seconds": 11.34,
      "text": "Okay, so the vitals from earlier. Temp 36.6 degrees, SpO2 99 percent on room air. Pulse 66, respiratory rate 18, weight 74 kilos, blood pressure 127 over 70, height 171 centimetres."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.86,
      "end_seconds": 124.38,
      "duration_seconds": 2.52,
      "text": "Good, thank you. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.96,
      "end_seconds": 127.05,
      "duration_seconds": 2.09,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.99,
      "end_seconds": 130.69,
      "duration_seconds": 2.7,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.26,
      "end_seconds": 138.03,
      "duration_seconds": 6.77,
      "text": "I take thyroxine, 75 micrograms, every morning. Yeah, it's sertraline, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.35,
      "end_seconds": 145.93,
      "duration_seconds": 7.58,
      "text": "Doctor, I think the last prescription for the sertraline was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.94,
      "end_seconds": 152.85,
      "duration_seconds": 3.91,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.15,
      "end_seconds": 161.62,
      "duration_seconds": 5.47,
      "text": "Okay, you know, so I don't think I have it with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.12,
      "end_seconds": 167.42,
      "duration_seconds": 5.3,
      "text": "Any allergies I should know about? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.97,
      "end_seconds": 171.26,
      "duration_seconds": 2.29,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.01,
      "end_seconds": 174.88,
      "duration_seconds": 2.87,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.77,
      "end_seconds": 179.67,
      "duration_seconds": 3.9,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.98,
      "end_seconds": 182.07,
      "duration_seconds": 1.09,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.77,
      "end_seconds": 189.66,
      "duration_seconds": 6.89,
      "text": "I had my gallbladder removed in 2016. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.61,
      "end_seconds": 194.12,
      "duration_seconds": 3.51,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.94,
      "end_seconds": 200.69,
      "duration_seconds": 5.75,
      "text": "I've had an underactive thyroid, yes. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.08,
      "end_seconds": 201.78,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 203.02,
      "end_seconds": 209.36,
      "duration_seconds": 6.34,
      "text": "Depression, for about a year. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.53,
      "end_seconds": 214.56,
      "duration_seconds": 4.03,
      "text": "Right, so that's your known depression. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.49,
      "end_seconds": 220.67,
      "duration_seconds": 4.18,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.93,
      "end_seconds": 222.89,
      "duration_seconds": 0.96,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.88,
      "end_seconds": 227.44,
      "duration_seconds": 2.56,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.92,
      "end_seconds": 248.53,
      "duration_seconds": 4.61,
      "text": "You're well kempt and speaking clearly, and you maintain good eye contact."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.82,
      "end_seconds": 271.67,
      "duration_seconds": 20.85,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Right, here's what I'm thinking. This looks most like a depressive episode. I want to be honest that this is an impression, not a final answer. I'd also keep a reaction to recent stress in mind."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.26,
      "end_seconds": 277.41,
      "duration_seconds": 5.15,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.4,
      "end_seconds": 293.81,
      "duration_seconds": 15.41,
      "text": "It's reasonable to be concerned, but right now a depressive episode is my leading thought, not anything worse. Let me just recap so I've got it right. You've been feeling low most days, moderate, and no thoughts of harming myself or hearing voices."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.91,
      "end_seconds": 297.46,
      "duration_seconds": 2.55,
      "text": "Yes, um, that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.54,
      "end_seconds": 311.76,
      "duration_seconds": 13.22,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.1,
      "end_seconds": 314.81,
      "duration_seconds": 1.71,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.25,
      "end_seconds": 324.26,
      "duration_seconds": 8.01,
      "text": "I'm going to order blood tests, for low mood. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.04,
      "end_seconds": 326.62,
      "duration_seconds": 1.58,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.0,
      "end_seconds": 350.05,
      "duration_seconds": 22.05,
      "text": "Let's get a thyroid test, for low mood. It's a routine test and it'll give us a much clearer picture. It usually takes a few weeks for the tablet to start helping, so give it time and stay in touch. Try to keep some routine, a bit of daylight and a short walk each day. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.03,
      "end_seconds": 369.32,
      "duration_seconds": 18.29,
      "text": "Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'd like you to see a counsellor as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.91,
      "end_seconds": 372.22,
      "duration_seconds": 1.31,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.3,
      "end_seconds": 380.08,
      "duration_seconds": 6.78,
      "text": "Please don't sit on it if you have thoughts of harming yourself. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 381.63,
      "end_seconds": 384.63,
      "duration_seconds": 3.0,
      "text": "Yes, uh, I'll do that."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.97,
      "end_seconds": 387.09,
      "duration_seconds": 2.12,
      "text": "Let's review you in four weeks."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.6,
      "end_seconds": 392.46,
      "duration_seconds": 3.86,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.35,
      "end_seconds": 399.21,
      "duration_seconds": 5.86,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.23,
      "end_seconds": 405.21,
      "duration_seconds": 4.98,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.32,
      "end_seconds": 411.44,
      "duration_seconds": 5.12,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 412.8,
      "end_seconds": 415.35,
      "duration_seconds": 2.55,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.82,
      "end_seconds": 417.84,
      "duration_seconds": 1.02,
      "text": "See you then."
    }
  ]
}