{
  "schema_version": "1.0",
  "encounter_id": "00453",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 2.22,
      "duration_seconds": 1.67,
      "text": "Hello. Right, let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.72,
      "end_seconds": 5.02,
      "duration_seconds": 1.3,
      "text": "Good morning, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 7.68,
      "duration_seconds": 2.32,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.75,
      "end_seconds": 14.03,
      "duration_seconds": 5.28,
      "text": "I'm here because of severe pain in my right side that comes in waves."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.84,
      "end_seconds": 16.51,
      "duration_seconds": 1.67,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.78,
      "end_seconds": 25.64,
      "duration_seconds": 6.86,
      "text": "Okay, so ever since... since Friday, really. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.13,
      "end_seconds": 28.24,
      "duration_seconds": 2.11,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.82,
      "end_seconds": 31.07,
      "duration_seconds": 1.25,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.93,
      "end_seconds": 34.85,
      "duration_seconds": 2.92,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.17,
      "end_seconds": 39.67,
      "duration_seconds": 3.5,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.49,
      "end_seconds": 41.83,
      "duration_seconds": 1.34,
      "text": "Any previous kidney stones?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 46.44,
      "duration_seconds": 3.34,
      "text": "No, I haven't had any previous kidney stones."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.58,
      "end_seconds": 51.08,
      "duration_seconds": 3.5,
      "text": "Have you had any burning when passing urine or testicular pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.03,
      "end_seconds": 57.23,
      "duration_seconds": 5.2,
      "text": "I mean, no, no burning when passing urine or testicular pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.6,
      "end_seconds": 60.97,
      "duration_seconds": 3.37,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.03,
      "end_seconds": 65.37,
      "duration_seconds": 3.34,
      "text": "No problem, you know, take your time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.15,
      "end_seconds": 68.34,
      "duration_seconds": 2.19,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.76,
      "end_seconds": 71.05,
      "duration_seconds": 1.29,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.25,
      "end_seconds": 75.49,
      "duration_seconds": 2.24,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.23,
      "end_seconds": 79.05,
      "duration_seconds": 2.82,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.83,
      "end_seconds": 84.88,
      "duration_seconds": 5.05,
      "text": "Do you have any medical conditions I should know about? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.41,
      "end_seconds": 88.83,
      "duration_seconds": 2.42,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.06,
      "end_seconds": 94.04,
      "duration_seconds": 3.98,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 98.52,
      "duration_seconds": 2.93,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.02,
      "end_seconds": 101.25,
      "duration_seconds": 2.23,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.57,
      "end_seconds": 104.68,
      "duration_seconds": 2.11,
      "text": "My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.12,
      "end_seconds": 107.98,
      "duration_seconds": 2.86,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.11,
      "end_seconds": 111.24,
      "duration_seconds": 2.13,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.62,
      "end_seconds": 115.73,
      "duration_seconds": 3.11,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.65,
      "end_seconds": 117.66,
      "duration_seconds": 1.01,
      "text": "Yes, ibuprofen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.83,
      "end_seconds": 119.76,
      "duration_seconds": 0.93,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 123.44,
      "duration_seconds": 2.77,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.76,
      "end_seconds": 125.24,
      "duration_seconds": 1.48,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.71,
      "end_seconds": 129.58,
      "duration_seconds": 3.87,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.63,
      "end_seconds": 147.57,
      "duration_seconds": 13.94,
      "text": "Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.22,
      "end_seconds": 151.5,
      "duration_seconds": 3.28,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.52,
      "end_seconds": 155.82,
      "duration_seconds": 3.3,
      "text": "Give me a second, I'm just typing this up."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.0,
      "end_seconds": 190.27,
      "duration_seconds": 17.27,
      "text": "Good, where were we. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.57,
      "end_seconds": 193.33,
      "duration_seconds": 1.76,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.11,
      "end_seconds": 202.9,
      "duration_seconds": 8.79,
      "text": "From what you've told me, my working impression is a kidney stone. The reason I say that is that the way you describe it fits together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.09,
      "end_seconds": 206.71,
      "duration_seconds": 2.62,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.77,
      "end_seconds": 227.75,
      "duration_seconds": 19.98,
      "text": "It's reasonable to be concerned, but right now a kidney stone is my leading thought, not anything worse. Let me just recap so I've got it right. You've had severe pain in your right side that comes in waves, since Friday, severe, and no burning when passing urine or previous kidney stones."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.99,
      "end_seconds": 230.96,
      "duration_seconds": 1.97,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.44,
      "end_seconds": 235.19,
      "duration_seconds": 2.75,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.98,
      "end_seconds": 236.87,
      "duration_seconds": 0.89,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.55,
      "end_seconds": 266.41,
      "duration_seconds": 19.86,
      "text": "Okay, here we go. Let's get an ultrasound of the kidneys, for flank pain. I'll start you on tamsulosin, 0.4 milligrams, at night, for two weeks. You take it by mouth. It's for stone passage. Drink three litres of water a day and try to strain your urine so we can catch the stone if it passes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.36,
      "end_seconds": 283.57,
      "duration_seconds": 16.21,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I want you to come back or go to emergency straight away if you get a fever or can't pass urine at all. Come back after the scan."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.68,
      "end_seconds": 288.89,
      "duration_seconds": 4.21,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.33,
      "end_seconds": 296.16,
      "duration_seconds": 5.83,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.09,
      "end_seconds": 304.49,
      "duration_seconds": 7.4,
      "text": "So, I take the tamsulosin, 0.4 milligrams, at night and come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.11,
      "end_seconds": 310.16,
      "duration_seconds": 5.05,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.78,
      "end_seconds": 313.17,
      "duration_seconds": 2.39,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}