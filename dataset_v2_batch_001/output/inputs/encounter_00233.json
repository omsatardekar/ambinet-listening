{
  "schema_version": "1.0",
  "encounter_id": "00233",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 3.89,
      "duration_seconds": 3.23,
      "text": "Well, hi, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.88,
      "end_seconds": 7.79,
      "duration_seconds": 2.91,
      "text": "Not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.96,
      "end_seconds": 25.53,
      "duration_seconds": 16.57,
      "text": "Honestly, it's pain in the lower right tummy, and my family pushed me to come. I told myself I'd wait and see, and here I am. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.95,
      "end_seconds": 28.88,
      "duration_seconds": 1.93,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.31,
      "end_seconds": 39.4,
      "duration_seconds": 10.09,
      "text": "It's been ten days now. I thought it would sort itself out, um, but it hasn't. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.68,
      "end_seconds": 48.57,
      "duration_seconds": 7.89,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.99,
      "end_seconds": 60.75,
      "duration_seconds": 11.76,
      "text": "About a three out of ten. It happens all the time. Only lying still, and it's not much. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.2,
      "end_seconds": 66.42,
      "duration_seconds": 4.22,
      "text": "Let me check a few things. Any blood in the stool or diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.61,
      "end_seconds": 69.94,
      "duration_seconds": 2.33,
      "text": "Right, nothing like that, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.48,
      "end_seconds": 71.18,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.87,
      "end_seconds": 74.07,
      "duration_seconds": 2.2,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.53,
      "end_seconds": 76.6,
      "duration_seconds": 2.07,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.22,
      "end_seconds": 97.75,
      "duration_seconds": 8.53,
      "text": "Alright, I've got it. Do you have any allergies to medicines, food, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 101.43,
      "duration_seconds": 2.78,
      "text": "Yes, penicillin, it gives me a rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.15,
      "end_seconds": 104.96,
      "duration_seconds": 2.81,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.18,
      "end_seconds": 111.61,
      "duration_seconds": 2.43,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.91,
      "end_seconds": 112.61,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.77,
      "end_seconds": 116.74,
      "duration_seconds": 2.97,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.31,
      "end_seconds": 119.83,
      "duration_seconds": 1.52,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.82,
      "end_seconds": 123.83,
      "duration_seconds": 3.01,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.12,
      "end_seconds": 126.19,
      "duration_seconds": 1.07,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.51,
      "end_seconds": 128.9,
      "duration_seconds": 1.39,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.68,
      "end_seconds": 132.38,
      "duration_seconds": 2.7,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.91,
      "end_seconds": 133.66,
      "duration_seconds": 0.75,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.06,
      "end_seconds": 150.0,
      "duration_seconds": 3.94,
      "text": "Right, thanks for waiting. Okay, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.34,
      "end_seconds": 154.27,
      "duration_seconds": 2.93,
      "text": "I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.76,
      "end_seconds": 159.53,
      "duration_seconds": 3.77,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.56,
      "end_seconds": 163.18,
      "duration_seconds": 2.62,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 166.84,
      "duration_seconds": 3.0,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.98,
      "end_seconds": 182.69,
      "duration_seconds": 14.71,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.59,
      "end_seconds": 187.67,
      "duration_seconds": 3.08,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.29,
      "end_seconds": 190.64,
      "duration_seconds": 1.35,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.17,
      "end_seconds": 204.72,
      "duration_seconds": 1.55,
      "text": "Bowel sounds are present."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.29,
      "end_seconds": 209.8,
      "duration_seconds": 3.51,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.07,
      "end_seconds": 225.87,
      "duration_seconds": 5.8,
      "text": "There's tenderness in the right lower part and it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.82,
      "end_seconds": 228.26,
      "duration_seconds": 1.44,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.32,
      "end_seconds": 250.69,
      "duration_seconds": 17.37,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. So, based on the history and the examination, my working impression is possible appendicitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.58,
      "end_seconds": 259.51,
      "duration_seconds": 4.93,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.74,
      "end_seconds": 277.47,
      "duration_seconds": 16.73,
      "text": "I can't promise yet, but most people with possible appendicitis do well once it's treated properly. Let me just recap so I've got it right. You've had pain in the lower right tummy for ten days, and no diarrhoea or blood in the stool."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.76,
      "end_seconds": 281.47,
      "duration_seconds": 1.71,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.48,
      "end_seconds": 289.91,
      "duration_seconds": 7.43,
      "text": "We should do blood tests for abdominal pain. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.24,
      "end_seconds": 291.11,
      "duration_seconds": 0.87,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.73,
      "end_seconds": 312.81,
      "duration_seconds": 21.08,
      "text": "Please don't eat or drink anything until the surgeons have seen you. If you smoke, this is a good moment to think about stopping, and we can help you with that. If the pain gets sharper or spreads across the tummy, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.46,
      "end_seconds": 319.39,
      "duration_seconds": 1.93,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.8,
      "end_seconds": 322.15,
      "duration_seconds": 2.35,
      "text": "Come back today after the results."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.71,
      "end_seconds": 325.54,
      "duration_seconds": 1.83,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.06,
      "end_seconds": 331.8,
      "duration_seconds": 4.74,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.97,
      "end_seconds": 339.15,
      "duration_seconds": 4.18,
      "text": "So, I come back today after the results. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.25,
      "end_seconds": 345.36,
      "duration_seconds": 5.11,
      "text": "Okay, yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.11,
      "end_seconds": 349.86,
      "duration_seconds": 3.75,
      "text": "Okay, thank you. I'll get started on all of that."
    }
  ]
}