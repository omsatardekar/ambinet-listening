{
  "schema_version": "1.0",
  "encounter_id": "00262",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.72,
      "duration_seconds": 4.07,
      "text": "Good evening, uh, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 9.94,
      "duration_seconds": 3.81,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.5,
      "end_seconds": 14.25,
      "duration_seconds": 3.75,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.83,
      "end_seconds": 20.09,
      "duration_seconds": 2.26,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 21.63,
      "end_seconds": 26.98,
      "duration_seconds": 5.35,
      "text": "Doctor, it's a mole that has changed. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.47,
      "end_seconds": 32.94,
      "duration_seconds": 4.47,
      "text": "When did you first notice it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.79,
      "end_seconds": 53.17,
      "duration_seconds": 17.38,
      "text": "It's been about four days, I'm fairly sure. I looked a few things up online, and that probably didn't help. I told myself I'd wait and see, and here I am. I've had a bit of itching on it too, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.15,
      "end_seconds": 57.31,
      "duration_seconds": 3.16,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.75,
      "end_seconds": 63.66,
      "duration_seconds": 1.91,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.24,
      "end_seconds": 66.99,
      "duration_seconds": 2.75,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.39,
      "end_seconds": 68.1,
      "duration_seconds": 0.71,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.7,
      "end_seconds": 90.01,
      "duration_seconds": 6.31,
      "text": "Okay, here we go. Let me check a few things. Any lumps in the armpit or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.14,
      "end_seconds": 95.61,
      "duration_seconds": 4.47,
      "text": "I haven't had lumps in the armpit or fever, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.26,
      "end_seconds": 101.17,
      "duration_seconds": 4.91,
      "text": "Have you had any history of skin cancer, history of sunburn or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.35,
      "end_seconds": 107.63,
      "duration_seconds": 5.28,
      "text": "I haven't had history of skin cancer, history of sunburn or weight loss, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.05,
      "end_seconds": 112.04,
      "duration_seconds": 3.99,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.22,
      "end_seconds": 117.52,
      "duration_seconds": 4.3,
      "text": "Um, mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.95,
      "end_seconds": 119.8,
      "duration_seconds": 1.85,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.93,
      "end_seconds": 122.77,
      "duration_seconds": 1.84,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.93,
      "end_seconds": 127.51,
      "duration_seconds": 3.58,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.27,
      "end_seconds": 129.1,
      "duration_seconds": 0.83,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.44,
      "end_seconds": 144.97,
      "duration_seconds": 7.53,
      "text": "Okay, here we go. Let's go through your medication. What are you taking? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.19,
      "end_seconds": 156.49,
      "duration_seconds": 10.3,
      "text": "Yeah, I take aspirin, 75 milligrams, once a day for my heart. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.37,
      "end_seconds": 171.2,
      "duration_seconds": 13.83,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.29,
      "end_seconds": 176.87,
      "duration_seconds": 1.58,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.9,
      "end_seconds": 183.13,
      "duration_seconds": 2.23,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.7,
      "end_seconds": 188.87,
      "duration_seconds": 4.17,
      "text": "I had cataract surgery on my right eye last year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.74,
      "end_seconds": 193.09,
      "duration_seconds": 3.35,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.9,
      "end_seconds": 197.03,
      "duration_seconds": 3.13,
      "text": "No problem, um, take your time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.65,
      "end_seconds": 204.98,
      "duration_seconds": 4.33,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.2,
      "end_seconds": 217.57,
      "duration_seconds": 11.37,
      "text": "I've had heart disease for about ten years now. I'd rather know what's going on than keep guessing. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.14,
      "end_seconds": 239.11,
      "duration_seconds": 20.97,
      "text": "Go on. Right, so that's your known heart disease. We'll keep that in mind today. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.0,
      "end_seconds": 243.36,
      "duration_seconds": 3.36,
      "text": "Thank you, you know, that really helps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.27,
      "end_seconds": 248.83,
      "duration_seconds": 1.56,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.01,
      "end_seconds": 253.01,
      "duration_seconds": 3.0,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.87,
      "end_seconds": 254.99,
      "duration_seconds": 1.12,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.31,
      "end_seconds": 258.9,
      "duration_seconds": 3.59,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.62,
      "end_seconds": 263.79,
      "duration_seconds": 4.17,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.86,
      "end_seconds": 267.65,
      "duration_seconds": 2.79,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.13,
      "end_seconds": 275.47,
      "duration_seconds": 6.34,
      "text": "Do you have any allergies to medicines, food, anything at all? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.03,
      "end_seconds": 277.3,
      "duration_seconds": 1.27,
      "text": "Shellfish, I'd say."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.81,
      "end_seconds": 280.74,
      "duration_seconds": 2.93,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.29,
      "end_seconds": 282.05,
      "duration_seconds": 0.76,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.05,
      "end_seconds": 301.15,
      "duration_seconds": 5.1,
      "text": "Okay, here we go. Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.24,
      "end_seconds": 304.37,
      "duration_seconds": 2.13,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.71,
      "end_seconds": 307.99,
      "duration_seconds": 2.28,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.31,
      "end_seconds": 309.03,
      "duration_seconds": 0.72,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.35,
      "end_seconds": 334.21,
      "duration_seconds": 17.86,
      "text": "Okay, here we go. From what you've told me, it fits best with a pigmented lesion that needs to be looked at more closely. That's my thinking for now, and it may change as we learn more. A seborrhoeic keratosis is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.81,
      "end_seconds": 338.94,
      "duration_seconds": 3.13,
      "text": "Um, should I be worried about this?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.54,
      "end_seconds": 358.12,
      "duration_seconds": 17.58,
      "text": "It's reasonable to be concerned, but right now a pigmented lesion that needs to be looked at more closely is my leading thought, not anything worse. Let me just recap so I've got it right. You've had a mole that has changed for about four days, and no history of skin cancer or weight loss."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.65,
      "end_seconds": 359.98,
      "duration_seconds": 1.33,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.93,
      "end_seconds": 377.05,
      "duration_seconds": 14.12,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.35,
      "end_seconds": 380.3,
      "duration_seconds": 1.95,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.48,
      "end_seconds": 396.84,
      "duration_seconds": 15.36,
      "text": "We should do a skin biopsy for changing mole. It's a routine test and it'll give us a much clearer picture. Let's get a dermoscopy, for changing mole. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.54,
      "end_seconds": 401.33,
      "duration_seconds": 3.79,
      "text": "Hmm, sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.16,
      "end_seconds": 417.63,
      "duration_seconds": 15.47,
      "text": "Please use sunscreen and cover up in the midday sun, and check your skin once a month. Please take the tablets with food so they don't upset your stomach. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.92,
      "end_seconds": 426.79,
      "duration_seconds": 8.87,
      "text": "Alright. We'll refer you to a dermatologist. I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.42,
      "end_seconds": 428.12,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.87,
      "end_seconds": 439.02,
      "duration_seconds": 7.15,
      "text": "Let's review you in two weeks. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 440.36,
      "end_seconds": 444.59,
      "duration_seconds": 4.23,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.85,
      "end_seconds": 449.76,
      "duration_seconds": 3.91,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 451.18,
      "end_seconds": 455.25,
      "duration_seconds": 4.07,
      "text": "Okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 455.8,
      "end_seconds": 456.76,
      "duration_seconds": 0.96,
      "text": "See you then."
    }
  ]
}