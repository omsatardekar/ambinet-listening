{
  "schema_version": "1.0",
  "encounter_id": "00037",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.25,
      "duration_seconds": 3.99,
      "text": "So, good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 9.6,
      "duration_seconds": 3.46,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.1,
      "end_seconds": 16.24,
      "duration_seconds": 6.14,
      "text": "Thank you for fitting us in, doctor. Doctor, it's been feeling faint. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.82,
      "end_seconds": 20.16,
      "duration_seconds": 3.34,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.77,
      "end_seconds": 23.65,
      "duration_seconds": 2.88,
      "text": "Since last night, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.42,
      "end_seconds": 31.34,
      "duration_seconds": 6.92,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.05,
      "end_seconds": 36.9,
      "duration_seconds": 4.85,
      "text": "It's moderate, honestly. Standing in the sun definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.4,
      "end_seconds": 43.03,
      "duration_seconds": 3.63,
      "text": "Okay, what about a pounding headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.23,
      "end_seconds": 45.09,
      "duration_seconds": 0.86,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.69,
      "end_seconds": 48.84,
      "duration_seconds": 3.15,
      "text": "What about heavy sweating, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.23,
      "end_seconds": 58.3,
      "duration_seconds": 9.07,
      "text": "Yeah. One week, I'd say. With heavy sweating, it happens all the time. I've also had muscle cramps, for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.07,
      "end_seconds": 61.65,
      "duration_seconds": 2.58,
      "text": "Any passing no urine or confusion at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.66,
      "end_seconds": 64.39,
      "duration_seconds": 1.73,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.62,
      "end_seconds": 69.33,
      "duration_seconds": 1.71,
      "text": "Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.98,
      "end_seconds": 72.65,
      "duration_seconds": 2.67,
      "text": "No, I haven't had any vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 73.56,
      "end_seconds": 77.27,
      "duration_seconds": 3.71,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.72,
      "end_seconds": 83.39,
      "duration_seconds": 4.67,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.02,
      "end_seconds": 88.81,
      "duration_seconds": 4.79,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.41,
      "end_seconds": 90.76,
      "duration_seconds": 1.35,
      "text": "No, no fainting."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.79,
      "end_seconds": 93.36,
      "duration_seconds": 1.57,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.7,
      "end_seconds": 96.02,
      "duration_seconds": 1.32,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.17,
      "end_seconds": 101.3,
      "duration_seconds": 4.13,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.45,
      "end_seconds": 114.35,
      "duration_seconds": 4.9,
      "text": "Okay, that's done. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.82,
      "end_seconds": 120.41,
      "duration_seconds": 5.59,
      "text": "Yes, sulfa drugs. I get a rash. Yes, penicillin. I get a rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 122.69,
      "duration_seconds": 1.9,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.63,
      "end_seconds": 124.97,
      "duration_seconds": 1.34,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.46,
      "end_seconds": 128.95,
      "duration_seconds": 2.49,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.39,
      "end_seconds": 132.65,
      "duration_seconds": 3.26,
      "text": "Hmm, of course, take your time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.36,
      "end_seconds": 149.91,
      "duration_seconds": 2.55,
      "text": "Right, thanks for waiting. How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.13,
      "end_seconds": 154.15,
      "duration_seconds": 3.02,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.14,
      "end_seconds": 156.23,
      "duration_seconds": 1.09,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.08,
      "end_seconds": 161.99,
      "duration_seconds": 1.91,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.5,
      "end_seconds": 166.07,
      "duration_seconds": 2.57,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.94,
      "end_seconds": 172.8,
      "duration_seconds": 3.86,
      "text": "It's bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 173.77,
      "end_seconds": 177.73,
      "duration_seconds": 3.96,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.87,
      "end_seconds": 182.15,
      "duration_seconds": 3.28,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.55,
      "end_seconds": 184.85,
      "duration_seconds": 2.3,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.39,
      "end_seconds": 190.81,
      "duration_seconds": 4.42,
      "text": "Alright, do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.81,
      "end_seconds": 200.4,
      "duration_seconds": 8.59,
      "text": "High blood pressure, for about a year. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.64,
      "end_seconds": 202.71,
      "duration_seconds": 1.07,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.26,
      "end_seconds": 214.01,
      "duration_seconds": 9.75,
      "text": "An irregular heartbeat, for two years. I took the morning off to come in today. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.33,
      "end_seconds": 221.82,
      "duration_seconds": 7.49,
      "text": "Right, so that's your known high blood pressure. We'll keep that in mind today. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.6,
      "end_seconds": 226.57,
      "duration_seconds": 3.97,
      "text": "My sister has thyroid problems. My mother has migraines."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 227.47,
      "end_seconds": 238.08,
      "duration_seconds": 10.61,
      "text": "Doctor, I've got the readings for you. Pulse is 110 beats a minute, BP is 100 over 59, saturation 99 percent, temp 36.9 degrees, respiratory rate 17."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 239.52,
      "duration_seconds": 1.1,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.76,
      "end_seconds": 243.82,
      "duration_seconds": 3.06,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.34,
      "end_seconds": 245.04,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.87,
      "end_seconds": 247.45,
      "duration_seconds": 1.58,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.34,
      "end_seconds": 268.85,
      "duration_seconds": 2.51,
      "text": "Your skin is warm and a bit clammy."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.94,
      "end_seconds": 271.5,
      "duration_seconds": 1.56,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.54,
      "end_seconds": 279.8,
      "duration_seconds": 1.26,
      "text": "Capillary refill is normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.12,
      "end_seconds": 293.34,
      "duration_seconds": 11.22,
      "text": "All done, thank you, please sit down. Putting it all together, my working impression is heat exhaustion with some dehydration. I can't rule out an electrolyte imbalance yet."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.66,
      "end_seconds": 295.83,
      "duration_seconds": 2.17,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.95,
      "end_seconds": 312.9,
      "duration_seconds": 14.95,
      "text": "Nothing I've seen today points to an emergency. It looks like heat exhaustion with some dehydration, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling faint, since last night, moderate, and no fainting."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.79,
      "end_seconds": 314.99,
      "duration_seconds": 1.2,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.44,
      "end_seconds": 323.13,
      "duration_seconds": 6.69,
      "text": "We should do blood salts for dehydration. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.73,
      "end_seconds": 327.58,
      "duration_seconds": 0.85,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.11,
      "end_seconds": 340.67,
      "duration_seconds": 11.56,
      "text": "I'd like you to take ORS, 1 sachet, three times a day, for two days. That's for dehydration. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.55,
      "end_seconds": 342.43,
      "duration_seconds": 0.88,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.87,
      "end_seconds": 368.62,
      "duration_seconds": 24.75,
      "text": "Avoid the midday sun for a few days and keep a water bottle with you. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Don't skip meals, and try to eat smaller portions more often through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.08,
      "end_seconds": 371.31,
      "duration_seconds": 1.23,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.62,
      "end_seconds": 380.91,
      "duration_seconds": 9.29,
      "text": "Keep an eye out, and if you become confused or stop sweating, call us the same day or go to emergency. Please come and see me in three days."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.94,
      "end_seconds": 385.88,
      "duration_seconds": 3.94,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.42,
      "end_seconds": 390.63,
      "duration_seconds": 3.21,
      "text": "We're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.6,
      "end_seconds": 394.84,
      "duration_seconds": 3.24,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.18,
      "end_seconds": 397.01,
      "duration_seconds": 0.83,
      "text": "Alright, goodbye."
    }
  ]
}