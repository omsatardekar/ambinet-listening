{
  "schema_version": "1.0",
  "encounter_id": "00335",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.81,
      "end_seconds": 5.89,
      "duration_seconds": 5.08,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 10.2,
      "duration_seconds": 3.28,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.72,
      "end_seconds": 15.64,
      "duration_seconds": 4.92,
      "text": "Yeah, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.41,
      "end_seconds": 19.32,
      "duration_seconds": 2.91,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.3,
      "end_seconds": 22.88,
      "duration_seconds": 2.58,
      "text": "We came because of trouble sleeping."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.13,
      "end_seconds": 27.24,
      "duration_seconds": 3.11,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.82,
      "end_seconds": 35.03,
      "duration_seconds": 6.21,
      "text": "For two years, I'd say. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.79,
      "end_seconds": 38.59,
      "duration_seconds": 2.8,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.84,
      "end_seconds": 44.32,
      "duration_seconds": 4.48,
      "text": "Trouble concentrating goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.3,
      "end_seconds": 51.49,
      "duration_seconds": 6.19,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.59,
      "end_seconds": 56.61,
      "duration_seconds": 5.02,
      "text": "Tell the doctor about the other thing, you know, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.73,
      "end_seconds": 63.47,
      "duration_seconds": 2.74,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.88,
      "end_seconds": 65.62,
      "duration_seconds": 1.74,
      "text": "Have you been feeling irritable?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.94,
      "end_seconds": 72.29,
      "duration_seconds": 5.35,
      "text": "Yes, about the same, two months. The trouble concentrating? That's been for four weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 75.92,
      "duration_seconds": 3.09,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.74,
      "end_seconds": 77.58,
      "duration_seconds": 0.84,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.62,
      "end_seconds": 95.27,
      "duration_seconds": 4.65,
      "text": "Alright, I've got it. Any heavy caffeine, low mood or snoring at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.38,
      "end_seconds": 107.29,
      "duration_seconds": 10.91,
      "text": "No, no heavy caffeine, no low mood, no snoring. I was waking up at three in the morning at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.1,
      "end_seconds": 111.53,
      "duration_seconds": 3.43,
      "text": "Have you had any chest pain or restless legs?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.78,
      "end_seconds": 117.37,
      "duration_seconds": 4.59,
      "text": "So, you know, no, no chest pain or restless legs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.76,
      "end_seconds": 123.19,
      "duration_seconds": 2.43,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.43,
      "end_seconds": 126.82,
      "duration_seconds": 2.39,
      "text": "Yeah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.33,
      "end_seconds": 131.04,
      "duration_seconds": 2.71,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.91,
      "end_seconds": 136.15,
      "duration_seconds": 4.24,
      "text": "Right, yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 137.3,
      "end_seconds": 146.85,
      "duration_seconds": 9.55,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, BP is 108 over 76, pulse is 80 beats a minute, height 150 centimetres, weight 91 kilos."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.06,
      "end_seconds": 153.23,
      "duration_seconds": 5.17,
      "text": "Good, thank you. What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.71,
      "end_seconds": 157.23,
      "duration_seconds": 2.52,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.69,
      "end_seconds": 158.67,
      "duration_seconds": 0.98,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.98,
      "end_seconds": 163.84,
      "duration_seconds": 3.86,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.49,
      "end_seconds": 167.71,
      "duration_seconds": 3.22,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.9,
      "end_seconds": 171.19,
      "duration_seconds": 2.29,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 176.11,
      "duration_seconds": 3.52,
      "text": "Okay, any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.95,
      "end_seconds": 201.43,
      "duration_seconds": 24.48,
      "text": "Uh, I've had high blood pressure, yes. I did try to ignore it for a while. I've had anxiety, yes. I have arthritis in my knees. I'm hoping you can tell me something definite. I've had an underactive thyroid, yes. I didn't want to make a fuss, you know. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.48,
      "end_seconds": 214.09,
      "duration_seconds": 11.61,
      "text": "Okay, anxiety, that's already on your record. Good to know. Okay, arthritis in my knees, that's already on your record. Good to know. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.11,
      "end_seconds": 229.62,
      "duration_seconds": 14.51,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.9,
      "end_seconds": 234.63,
      "duration_seconds": 3.73,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.96,
      "end_seconds": 237.56,
      "duration_seconds": 2.6,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.3,
      "end_seconds": 254.53,
      "duration_seconds": 16.23,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.99,
      "end_seconds": 259.44,
      "duration_seconds": 3.45,
      "text": "Uh, um, okay, that makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.82,
      "end_seconds": 262.91,
      "duration_seconds": 2.09,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 263.57,
      "end_seconds": 266.78,
      "duration_seconds": 3.21,
      "text": "Just a hysterectomy, about twelve years ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.72,
      "end_seconds": 269.78,
      "duration_seconds": 2.06,
      "text": "One moment, I'm updating your notes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.18,
      "end_seconds": 281.81,
      "duration_seconds": 3.63,
      "text": "Alright, back to you. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.89,
      "end_seconds": 290.11,
      "duration_seconds": 6.22,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.92,
      "end_seconds": 292.97,
      "duration_seconds": 2.05,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.91,
      "end_seconds": 303.59,
      "duration_seconds": 9.68,
      "text": "For my blood pressure, I believe. My daughter sets them out for me, I just take what I'm given. Paracetamol, 650 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.93,
      "end_seconds": 308.42,
      "duration_seconds": 3.49,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.75,
      "end_seconds": 316.99,
      "duration_seconds": 7.24,
      "text": "Um, not with me. I'll bring it next time. Okay, so it's thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 317.73,
      "end_seconds": 326.19,
      "duration_seconds": 8.46,
      "text": "Doctor, I think the last prescription for the thyroxine was 37.5 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.5,
      "end_seconds": 331.34,
      "duration_seconds": 3.84,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 332.19,
      "end_seconds": 335.05,
      "duration_seconds": 2.86,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.24,
      "end_seconds": 340.24,
      "duration_seconds": 4.0,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 340.85,
      "end_seconds": 341.68,
      "duration_seconds": 0.83,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.23,
      "end_seconds": 358.86,
      "duration_seconds": 3.63,
      "text": "Alright, I've got it. How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.26,
      "end_seconds": 365.01,
      "duration_seconds": 5.75,
      "text": "Busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.61,
      "end_seconds": 379.45,
      "duration_seconds": 13.84,
      "text": "Okay, so my impression from what you've said is this: It fits best with insomnia, probably stress-related. That's my thinking for now, and it may change as we learn more. Sleep apnoea is also on my list."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.41,
      "end_seconds": 382.34,
      "duration_seconds": 1.93,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.11,
      "end_seconds": 399.0,
      "duration_seconds": 15.89,
      "text": "I can't promise yet, but most people with insomnia, probably stress-related do well once it's treated properly. Let me just recap so I've got it right. You've had trouble sleeping for two years, and no restless legs or heavy caffeine."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.4,
      "end_seconds": 401.61,
      "duration_seconds": 1.21,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.26,
      "end_seconds": 405.72,
      "duration_seconds": 3.46,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.09,
      "end_seconds": 409.03,
      "duration_seconds": 1.94,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.59,
      "end_seconds": 440.25,
      "duration_seconds": 27.66,
      "text": "We should do a sleep study for insomnia. I'd rather check than guess, and this is the quickest way to know more. Let's get a thyroid test, for insomnia. I'd rather check than guess, and this is the quickest way to know more. Same wake-up time every day, no screens in the hour before bed, and no coffee after lunch. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.62,
      "end_seconds": 453.81,
      "duration_seconds": 13.19,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 454.73,
      "end_seconds": 456.11,
      "duration_seconds": 1.38,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 457.29,
      "end_seconds": 463.32,
      "duration_seconds": 6.03,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 464.18,
      "end_seconds": 465.86,
      "duration_seconds": 1.68,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.18,
      "end_seconds": 473.21,
      "duration_seconds": 7.03,
      "text": "Please come and see me in four weeks. Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 475.16,
      "end_seconds": 480.11,
      "duration_seconds": 4.95,
      "text": "So, you know, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 480.45,
      "end_seconds": 485.23,
      "duration_seconds": 4.78,
      "text": "So, yes, exactly right. Take care, and don't hesitate to call if anything changes."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 485.72,
      "end_seconds": 490.27,
      "duration_seconds": 4.55,
      "text": "Okay, thank you. I'll get started on all of that."
    }
  ]
}