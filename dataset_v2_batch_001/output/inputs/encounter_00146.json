{
  "schema_version": "1.0",
  "encounter_id": "00146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.95,
      "duration_seconds": 4.1,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 9.73,
      "duration_seconds": 3.28,
      "text": "Right, not at all, please sit. What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.7,
      "end_seconds": 13.06,
      "duration_seconds": 2.36,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.95,
      "end_seconds": 16.95,
      "duration_seconds": 3.0,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.51,
      "end_seconds": 21.89,
      "duration_seconds": 3.38,
      "text": "I've been feeling anxious most of the day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.86,
      "end_seconds": 27.7,
      "duration_seconds": 4.84,
      "text": "How long has this been going on? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.57,
      "end_seconds": 36.23,
      "duration_seconds": 7.66,
      "text": "I mean, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.8,
      "end_seconds": 40.62,
      "duration_seconds": 2.82,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.8,
      "end_seconds": 48.19,
      "duration_seconds": 5.39,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.59,
      "end_seconds": 53.64,
      "duration_seconds": 5.05,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.18,
      "end_seconds": 56.51,
      "duration_seconds": 1.33,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.83,
      "end_seconds": 58.91,
      "duration_seconds": 2.08,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.59,
      "end_seconds": 62.51,
      "duration_seconds": 2.92,
      "text": "It's worse with crowded places and work."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.25,
      "end_seconds": 68.79,
      "duration_seconds": 5.54,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 68.89,
      "end_seconds": 73.04,
      "duration_seconds": 4.15,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.17,
      "end_seconds": 76.98,
      "duration_seconds": 2.81,
      "text": "Uh, I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.64,
      "end_seconds": 81.78,
      "duration_seconds": 4.14,
      "text": "Right, that's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.74,
      "end_seconds": 85.41,
      "duration_seconds": 2.67,
      "text": "And my heart pounding suddenly, too."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.18,
      "end_seconds": 89.42,
      "duration_seconds": 3.24,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.3,
      "end_seconds": 92.09,
      "duration_seconds": 1.79,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 92.59,
      "end_seconds": 95.07,
      "duration_seconds": 2.48,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.0,
      "end_seconds": 98.98,
      "duration_seconds": 2.98,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 101.4,
      "duration_seconds": 1.2,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.5,
      "end_seconds": 107.26,
      "duration_seconds": 4.76,
      "text": "Any alcohol use, weight loss or chest pain on exertion at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.81,
      "end_seconds": 120.49,
      "duration_seconds": 11.68,
      "text": "No, no alcohol use, no weight loss, no chest pain on exertion. I did have trouble falling asleep at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.98,
      "end_seconds": 125.1,
      "duration_seconds": 3.12,
      "text": "So, any low mood or fainting at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.36,
      "end_seconds": 130.08,
      "duration_seconds": 3.72,
      "text": "Well, I haven't had low mood or fainting, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.58,
      "end_seconds": 136.81,
      "duration_seconds": 3.23,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.29,
      "end_seconds": 140.02,
      "duration_seconds": 1.73,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.43,
      "end_seconds": 143.42,
      "duration_seconds": 1.99,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.39,
      "end_seconds": 146.19,
      "duration_seconds": 1.8,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 147.18,
      "end_seconds": 153.6,
      "duration_seconds": 6.42,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, pulse 78, blood pressure 115 over 74."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.42,
      "end_seconds": 161.22,
      "duration_seconds": 6.8,
      "text": "Thanks. Any medication at the moment, including things from the pharmacy? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.34,
      "end_seconds": 166.65,
      "duration_seconds": 4.31,
      "text": "It's paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 167.6,
      "end_seconds": 171.74,
      "duration_seconds": 4.14,
      "text": "Doctor, our chart from the last visit lists it as 1300 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 175.85,
      "duration_seconds": 2.92,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.1,
      "end_seconds": 183.46,
      "duration_seconds": 3.36,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.83,
      "end_seconds": 192.46,
      "duration_seconds": 7.63,
      "text": "Right, you know, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.98,
      "end_seconds": 195.9,
      "duration_seconds": 1.92,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.49,
      "end_seconds": 204.64,
      "duration_seconds": 7.15,
      "text": "For the gout, I believe. My husband sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.05,
      "end_seconds": 208.89,
      "duration_seconds": 2.84,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.64,
      "end_seconds": 218.87,
      "duration_seconds": 9.23,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.07,
      "end_seconds": 221.31,
      "duration_seconds": 1.24,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.62,
      "end_seconds": 225.28,
      "duration_seconds": 3.66,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.15,
      "end_seconds": 228.01,
      "duration_seconds": 1.86,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.6,
      "end_seconds": 236.69,
      "duration_seconds": 7.09,
      "text": "Just a hysterectomy, about twelve years ago. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.06,
      "end_seconds": 240.08,
      "duration_seconds": 3.02,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.72,
      "end_seconds": 249.0,
      "duration_seconds": 8.28,
      "text": "I've had anxiety for about ten years now. Um, I have arthritis in my knees, for nearly five years. Yes, gout."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.56,
      "end_seconds": 254.82,
      "duration_seconds": 4.26,
      "text": "Right, so that's your known anxiety. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.36,
      "end_seconds": 259.64,
      "duration_seconds": 2.28,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.37,
      "end_seconds": 261.07,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.0,
      "end_seconds": 264.6,
      "duration_seconds": 1.6,
      "text": "Take a breath for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.5,
      "end_seconds": 285.01,
      "duration_seconds": 3.51,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.67,
      "end_seconds": 289.37,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.21,
      "end_seconds": 312.83,
      "duration_seconds": 19.62,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Right, here's what I'm thinking. I think we're dealing with an anxiety disorder at this stage. I can't rule out a heart rhythm cause yet. I'd also keep a thyroid problem in mind."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.64,
      "end_seconds": 315.23,
      "duration_seconds": 1.59,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.18,
      "end_seconds": 328.65,
      "duration_seconds": 12.47,
      "text": "I can't promise yet, but most people with an anxiety disorder do well once it's treated properly. I'd like to arrange an ECG for palpitations. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.41,
      "end_seconds": 331.87,
      "duration_seconds": 2.46,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.51,
      "end_seconds": 340.46,
      "duration_seconds": 7.95,
      "text": "I'm going to order a thyroid test, for anxiety. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.61,
      "end_seconds": 342.55,
      "duration_seconds": 0.94,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.92,
      "end_seconds": 350.95,
      "duration_seconds": 7.03,
      "text": "Let's use escitalopram, 5 milligrams, once a day, for two weeks then review. You take it by mouth. It's for anxiety."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.66,
      "end_seconds": 353.44,
      "duration_seconds": 1.78,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.93,
      "end_seconds": 376.21,
      "duration_seconds": 22.28,
      "text": "Regular exercise and less caffeine make a real difference. Slow breathing, in for four and out for six, for a few minutes whenever it builds up. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to a counsellor."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.73,
      "end_seconds": 385.61,
      "duration_seconds": 7.88,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.39,
      "end_seconds": 387.58,
      "duration_seconds": 1.19,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.89,
      "end_seconds": 401.9,
      "duration_seconds": 14.01,
      "text": "Please don't sit on it if you have thoughts of harming yourself. That's the point to get seen urgently. Let's review you in two weeks. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.32,
      "end_seconds": 407.28,
      "duration_seconds": 3.96,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.76,
      "end_seconds": 409.78,
      "duration_seconds": 1.02,
      "text": "See you then."
    }
  ]
}