{
  "schema_version": "1.0",
  "encounter_id": "00300",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.16,
      "duration_seconds": 4.08,
      "text": "Sorry, doctor, I couldn't find the door at first."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 9.14,
      "duration_seconds": 3.34,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.47,
      "end_seconds": 26.15,
      "duration_seconds": 16.68,
      "text": "So, doctor, it's a routine check-up. It's getting on my nerves now. Right, there's a few skipped meals as well. And a bit of back stiffness, too. As for bit of back stiffness, moderate, I'd say."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.48,
      "end_seconds": 44.17,
      "duration_seconds": 16.69,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.22,
      "end_seconds": 47.7,
      "duration_seconds": 2.48,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.29,
      "end_seconds": 55.97,
      "duration_seconds": 4.68,
      "text": "Let me check a few things. Any low mood, chest pain or persistent cough?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.22,
      "end_seconds": 64.76,
      "duration_seconds": 4.54,
      "text": "No low mood, chest pain or persistent cough, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.55,
      "end_seconds": 72.07,
      "duration_seconds": 3.52,
      "text": "Have you had any weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.44,
      "end_seconds": 76.12,
      "duration_seconds": 3.68,
      "text": "Okay, uh, so nothing like that, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.62,
      "end_seconds": 77.54,
      "duration_seconds": 0.92,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.98,
      "end_seconds": 79.44,
      "duration_seconds": 1.46,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.29,
      "end_seconds": 84.56,
      "duration_seconds": 4.27,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.41,
      "end_seconds": 86.11,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 105.61,
      "duration_seconds": 5.61,
      "text": "Alright, I've got it. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.96,
      "end_seconds": 108.09,
      "duration_seconds": 2.13,
      "text": "Yes, codeine. I get vomiting."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.07,
      "end_seconds": 122.55,
      "duration_seconds": 13.48,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.06,
      "end_seconds": 125.85,
      "duration_seconds": 1.79,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.25,
      "end_seconds": 128.77,
      "duration_seconds": 2.52,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.01,
      "end_seconds": 143.9,
      "duration_seconds": 13.89,
      "text": "Glycomet. I take it 500 milligrams, twice a day for my sugar. A neighbour of mine said I should see someone about it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.63,
      "end_seconds": 148.43,
      "duration_seconds": 3.8,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.12,
      "end_seconds": 149.97,
      "duration_seconds": 0.85,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.69,
      "end_seconds": 165.53,
      "duration_seconds": 3.84,
      "text": "Okay, here we go. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.69,
      "end_seconds": 168.69,
      "duration_seconds": 2.0,
      "text": "My father had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.19,
      "end_seconds": 173.03,
      "duration_seconds": 3.84,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.64,
      "end_seconds": 186.44,
      "duration_seconds": 12.8,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.8,
      "end_seconds": 190.68,
      "duration_seconds": 3.88,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.97,
      "end_seconds": 199.47,
      "duration_seconds": 7.5,
      "text": "I've, I've got diabetes. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.04,
      "end_seconds": 202.24,
      "duration_seconds": 2.2,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.54,
      "end_seconds": 203.49,
      "duration_seconds": 0.95,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.5,
      "end_seconds": 222.64,
      "duration_seconds": 5.14,
      "text": "Alright, I've got it. Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.36,
      "end_seconds": 237.87,
      "duration_seconds": 1.51,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.28,
      "end_seconds": 267.02,
      "duration_seconds": 16.74,
      "text": "Okay: respiratory rate 17, temp 36.8 degrees, pulse 81, weight 80 kilos, oxygen saturation is 99 percent, height 166 centimetres, BMI works out to 29.0, BP is 125 over 73. Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.55,
      "end_seconds": 272.36,
      "duration_seconds": 3.81,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.37,
      "end_seconds": 276.41,
      "duration_seconds": 3.04,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.66,
      "end_seconds": 278.36,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.16,
      "end_seconds": 282.35,
      "duration_seconds": 2.19,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.31,
      "end_seconds": 301.83,
      "duration_seconds": 2.52,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.63,
      "end_seconds": 306.16,
      "duration_seconds": 2.53,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.75,
      "end_seconds": 317.74,
      "duration_seconds": 1.99,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.12,
      "end_seconds": 330.08,
      "duration_seconds": 8.96,
      "text": "Right, all done, thank you, please sit down. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.34,
      "end_seconds": 342.68,
      "duration_seconds": 11.34,
      "text": "Um, uh, yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.24,
      "end_seconds": 356.19,
      "duration_seconds": 8.95,
      "text": "Putting it all together, my working impression is generally well, nothing worrying today. A tendency towards high cholesterol is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.08,
      "end_seconds": 361.53,
      "duration_seconds": 2.45,
      "text": "Should I be worried about this?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.1,
      "end_seconds": 369.62,
      "duration_seconds": 6.52,
      "text": "It's reasonable to be concerned, but right now generally well, nothing worrying today is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.15,
      "end_seconds": 372.62,
      "duration_seconds": 2.47,
      "text": "Let me just write this down properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.83,
      "end_seconds": 404.86,
      "duration_seconds": 16.03,
      "text": "Right, carry on. Let's get blood tests, for health screening. That will help us see what's going on underneath and decide the next step. We should do a lipid profile for health screening. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.6,
      "end_seconds": 406.91,
      "duration_seconds": 1.31,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.58,
      "end_seconds": 428.43,
      "duration_seconds": 20.85,
      "text": "Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.25,
      "end_seconds": 433.49,
      "duration_seconds": 2.24,
      "text": "Right, got it, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.12,
      "end_seconds": 437.16,
      "duration_seconds": 3.04,
      "text": "Please come and see me in a year."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 437.56,
      "end_seconds": 438.26,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.53,
      "end_seconds": 444.43,
      "duration_seconds": 4.9,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.03,
      "end_seconds": 450.85,
      "duration_seconds": 5.82,
      "text": "So, um, I come back in a year. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.77,
      "end_seconds": 455.76,
      "duration_seconds": 3.99,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.34,
      "end_seconds": 460.51,
      "duration_seconds": 3.17,
      "text": "Nothing more from me, doctor, thanks."
    }
  ]
}