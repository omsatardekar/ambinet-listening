{
  "schema_version": "1.0",
  "encounter_id": "00403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 7.58,
      "duration_seconds": 6.19,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.01,
      "end_seconds": 12.82,
      "duration_seconds": 3.81,
      "text": "Right, perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 19.46,
      "duration_seconds": 6.14,
      "text": "Um, uh, so... swelling in my left calf. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.18,
      "end_seconds": 22.83,
      "duration_seconds": 2.65,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.73,
      "end_seconds": 36.86,
      "duration_seconds": 13.13,
      "text": "I've had it for two days. I'd rather know what's going on than keep guessing. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.68,
      "end_seconds": 46.89,
      "duration_seconds": 7.21,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.14,
      "end_seconds": 57.1,
      "duration_seconds": 8.96,
      "text": "Raising the leg helps a bit. Yes, standing. That makes it worse. A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.63,
      "end_seconds": 61.28,
      "duration_seconds": 3.65,
      "text": "What about pain in that calf, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.44,
      "end_seconds": 65.36,
      "duration_seconds": 2.92,
      "text": "I mean, yes, for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.08,
      "end_seconds": 70.44,
      "duration_seconds": 4.36,
      "text": "So, any breathlessness, chest pain or recent injury to the leg?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.84,
      "end_seconds": 78.07,
      "duration_seconds": 6.23,
      "text": "Okay, so no, no breathlessness, chest pain or recent injury to the leg."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.01,
      "end_seconds": 84.23,
      "duration_seconds": 3.22,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 85.09,
      "end_seconds": 86.48,
      "duration_seconds": 1.39,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.51,
      "end_seconds": 88.68,
      "duration_seconds": 1.17,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 92.33,
      "duration_seconds": 3.02,
      "text": "I stopped smoking about two years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.81,
      "end_seconds": 95.07,
      "duration_seconds": 1.26,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.54,
      "end_seconds": 97.77,
      "duration_seconds": 2.23,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.12,
      "end_seconds": 101.82,
      "duration_seconds": 2.7,
      "text": "Okay, what medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.19,
      "end_seconds": 106.07,
      "duration_seconds": 2.88,
      "text": "Ramipril, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.57,
      "end_seconds": 109.26,
      "duration_seconds": 1.69,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.82,
      "end_seconds": 112.08,
      "duration_seconds": 1.26,
      "text": "It's 5 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 114.57,
      "duration_seconds": 1.64,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.88,
      "end_seconds": 118.1,
      "duration_seconds": 3.22,
      "text": "I had a C-section about ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.98,
      "end_seconds": 121.73,
      "duration_seconds": 2.75,
      "text": "Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.54,
      "end_seconds": 125.58,
      "duration_seconds": 3.04,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.91,
      "end_seconds": 132.05,
      "duration_seconds": 5.14,
      "text": "Any long-term health problems I should know about? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.22,
      "end_seconds": 140.72,
      "duration_seconds": 7.5,
      "text": "I have arthritis in my knees. Yes, high blood pressure. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.12,
      "end_seconds": 145.44,
      "duration_seconds": 3.32,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.93,
      "end_seconds": 146.71,
      "duration_seconds": 0.78,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.12,
      "end_seconds": 160.58,
      "duration_seconds": 1.46,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 161.63,
      "end_seconds": 170.38,
      "duration_seconds": 8.75,
      "text": "Okay, so the vitals from earlier. Temp 37.0 degrees, respiratory rate 16, saturation 96 percent, BP is 133 over 79, heart rate 109."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.54,
      "end_seconds": 172.29,
      "duration_seconds": 0.75,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.93,
      "end_seconds": 177.03,
      "duration_seconds": 4.1,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.68,
      "end_seconds": 178.38,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.49,
      "end_seconds": 189.03,
      "duration_seconds": 1.54,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.67,
      "end_seconds": 195.21,
      "duration_seconds": 3.54,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.11,
      "end_seconds": 199.65,
      "duration_seconds": 2.54,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.38,
      "end_seconds": 212.0,
      "duration_seconds": 1.62,
      "text": "The right leg looks normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.74,
      "end_seconds": 236.03,
      "duration_seconds": 18.29,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. So, based on the history and the examination, this looks most like a possible deep vein clot. Cellulitis is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.48,
      "end_seconds": 242.4,
      "duration_seconds": 4.92,
      "text": "I've been thinking the worst, to be honest. Is it bad?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.24,
      "end_seconds": 258.07,
      "duration_seconds": 14.83,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible deep vein clot, but I'd like to confirm. Let me just recap so I've got it right. You've had swelling in your left calf for two days, and no breathlessness or chest pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.18,
      "end_seconds": 260.49,
      "duration_seconds": 1.31,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.4,
      "end_seconds": 264.37,
      "duration_seconds": 2.97,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.7,
      "end_seconds": 265.67,
      "duration_seconds": 0.97,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.87,
      "end_seconds": 305.52,
      "duration_seconds": 25.65,
      "text": "Right, thanks for waiting. Let's get a Doppler scan of the leg, for suspected DVT. Keep walking gently, and don't massage the calf. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If you smoke, this is a good moment to think about stopping, and we can help you with that."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.36,
      "end_seconds": 316.31,
      "duration_seconds": 9.95,
      "text": "Keep an eye out, and if you get chest pain or sudden breathlessness, call us the same day or go to emergency. Let's review you in two days."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.33,
      "end_seconds": 318.03,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.51,
      "end_seconds": 323.49,
      "duration_seconds": 4.98,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.65,
      "end_seconds": 329.51,
      "duration_seconds": 4.86,
      "text": "So, I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.67,
      "end_seconds": 335.65,
      "duration_seconds": 4.98,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.14,
      "end_seconds": 339.46,
      "duration_seconds": 2.32,
      "text": "I appreciate your time, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.95,
      "end_seconds": 341.75,
      "duration_seconds": 0.8,
      "text": "Alright, goodbye."
    }
  ]
}