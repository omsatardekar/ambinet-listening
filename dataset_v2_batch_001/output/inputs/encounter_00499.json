{
  "schema_version": "1.0",
  "encounter_id": "00499",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 6.22,
      "duration_seconds": 5.65,
      "text": "Doctor, uh, hello, I've got my papers here, where should I put them?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 11.38,
      "duration_seconds": 3.84,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.79,
      "end_seconds": 15.82,
      "duration_seconds": 4.03,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.35,
      "end_seconds": 19.23,
      "duration_seconds": 2.88,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.52,
      "end_seconds": 27.28,
      "duration_seconds": 6.76,
      "text": "It's puffiness around the eyes in the morning, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.5,
      "end_seconds": 30.65,
      "duration_seconds": 2.15,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.69,
      "end_seconds": 40.39,
      "duration_seconds": 8.7,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.35,
      "end_seconds": 48.94,
      "duration_seconds": 7.59,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.93,
      "end_seconds": 61.78,
      "duration_seconds": 11.85,
      "text": "It's a couple of times a week. It's moderate, honestly. Hmm, I've also had itching. With itching, maybe a eight out of ten on a bad day. It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.52,
      "end_seconds": 66.29,
      "duration_seconds": 3.77,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.64,
      "end_seconds": 69.58,
      "duration_seconds": 1.94,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 72.76,
      "duration_seconds": 2.64,
      "text": "Any fever or reduced urine output at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.23,
      "end_seconds": 76.52,
      "duration_seconds": 3.29,
      "text": "No, no fever or reduced urine output."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.07,
      "end_seconds": 82.98,
      "duration_seconds": 5.91,
      "text": "Let me check a few things. Any blood in the urine, nausea or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.51,
      "end_seconds": 90.97,
      "duration_seconds": 6.46,
      "text": "Um, I haven't had blood in the urine, nausea or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.7,
      "end_seconds": 95.17,
      "duration_seconds": 3.47,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.65,
      "end_seconds": 96.35,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.84,
      "end_seconds": 119.82,
      "duration_seconds": 7.98,
      "text": "Alright, I've got it. Do you have any known allergies at all? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 120.95,
      "duration_seconds": 0.73,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 123.82,
      "duration_seconds": 2.31,
      "text": "Alright, how's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.18,
      "end_seconds": 132.3,
      "duration_seconds": 7.12,
      "text": "Right, um, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.3,
      "end_seconds": 138.84,
      "duration_seconds": 2.54,
      "text": "So, does anything run in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.3,
      "end_seconds": 142.24,
      "duration_seconds": 1.94,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.06,
      "end_seconds": 155.89,
      "duration_seconds": 12.83,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.62,
      "end_seconds": 158.31,
      "duration_seconds": 1.69,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.86,
      "end_seconds": 162.5,
      "duration_seconds": 3.64,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 165.3,
      "duration_seconds": 1.59,
      "text": "I have kidney disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.82,
      "end_seconds": 174.81,
      "duration_seconds": 7.99,
      "text": "Yes, I can see the kidney disease in your file as well. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.46,
      "end_seconds": 187.47,
      "duration_seconds": 12.01,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.04,
      "end_seconds": 190.78,
      "duration_seconds": 1.74,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.31,
      "end_seconds": 195.78,
      "duration_seconds": 3.47,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.44,
      "end_seconds": 209.65,
      "duration_seconds": 13.21,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.22,
      "end_seconds": 211.81,
      "duration_seconds": 1.59,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.21,
      "end_seconds": 214.14,
      "duration_seconds": 0.93,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.93,
      "end_seconds": 215.77,
      "duration_seconds": 0.84,
      "text": "Nothing, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.92,
      "end_seconds": 219.48,
      "duration_seconds": 2.56,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.78,
      "end_seconds": 220.51,
      "duration_seconds": 0.73,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.98,
      "end_seconds": 240.74,
      "duration_seconds": 4.76,
      "text": "Okay, here we go. Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.91,
      "end_seconds": 254.3,
      "duration_seconds": 1.39,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.96,
      "end_seconds": 280.75,
      "duration_seconds": 8.79,
      "text": "Okay: height 165 centimetres, pressure 153 over 104, heart rate 91, temperature is 36.6 degrees, respiratory rate 17, saturation 96 percent, weight 58 kilos."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.13,
      "end_seconds": 282.69,
      "duration_seconds": 1.56,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.0,
      "end_seconds": 288.39,
      "duration_seconds": 5.39,
      "text": "We'll put it in context in a moment. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.76,
      "end_seconds": 290.51,
      "duration_seconds": 1.75,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.48,
      "end_seconds": 295.3,
      "duration_seconds": 1.82,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.49,
      "end_seconds": 297.75,
      "duration_seconds": 1.26,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.52,
      "end_seconds": 319.04,
      "duration_seconds": 5.52,
      "text": "There's pitting swelling at both ankles, and your blood pressure is on the high side."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.88,
      "end_seconds": 320.58,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.54,
      "end_seconds": 326.83,
      "duration_seconds": 2.29,
      "text": "That's fine, you can get dressed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.34,
      "end_seconds": 330.36,
      "duration_seconds": 3.02,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.9,
      "end_seconds": 331.62,
      "duration_seconds": 0.72,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.27,
      "end_seconds": 349.27,
      "duration_seconds": 10.0,
      "text": "Okay, here we go. From what you've told me and what I found, I think we're dealing with progression of the kidney problem at this stage."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.7,
      "end_seconds": 352.52,
      "duration_seconds": 1.82,
      "text": "Doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.13,
      "end_seconds": 371.03,
      "duration_seconds": 17.9,
      "text": "Nothing I've seen today points to an emergency. It looks like progression of the kidney problem, but I'd like to confirm. Let me just recap so I've got it right. You've had puffiness around the eyes in the morning, moderate, and no reduced urine output or nausea."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.58,
      "end_seconds": 374.08,
      "duration_seconds": 2.5,
      "text": "Uh, yes, you've got it."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.51,
      "end_seconds": 382.66,
      "duration_seconds": 4.15,
      "text": "So, do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.08,
      "end_seconds": 389.33,
      "duration_seconds": 5.25,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.21,
      "end_seconds": 398.25,
      "duration_seconds": 8.04,
      "text": "Let's get a urine protein test, for chronic kidney disease. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.58,
      "end_seconds": 399.52,
      "duration_seconds": 0.94,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.93,
      "end_seconds": 407.94,
      "duration_seconds": 8.01,
      "text": "Let's get kidney function tests, for chronic kidney disease. Stay off anti-inflammatory painkillers like diclofenac or ibuprofen, they're hard on the kidneys."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.42,
      "end_seconds": 414.52,
      "duration_seconds": 6.1,
      "text": "I see. Keep an eye on salt and protein portions, a dietitian can help with the specifics."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.75,
      "end_seconds": 421.09,
      "duration_seconds": 6.34,
      "text": "Alright. I'd like you to see a kidney specialist as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.7,
      "end_seconds": 424.07,
      "duration_seconds": 2.37,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.56,
      "end_seconds": 431.24,
      "duration_seconds": 5.68,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.69,
      "end_seconds": 433.47,
      "duration_seconds": 1.78,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.75,
      "end_seconds": 443.8,
      "duration_seconds": 9.05,
      "text": "Please come and see me in four weeks. Okay, before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.4,
      "end_seconds": 449.17,
      "duration_seconds": 3.77,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.8,
      "end_seconds": 455.3,
      "duration_seconds": 5.5,
      "text": "Yes, exactly right. So, we're all set. Don't leave without asking if something's unclear."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 456.78,
      "end_seconds": 458.29,
      "duration_seconds": 1.51,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.03,
      "end_seconds": 461.42,
      "duration_seconds": 2.39,
      "text": "Bye for now, look after yourself."
    }
  ]
}