{
  "schema_version": "1.0",
  "encounter_id": "00081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.12,
      "end_seconds": 4.97,
      "duration_seconds": 3.85,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 9.45,
      "duration_seconds": 3.03,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.83,
      "end_seconds": 18.07,
      "duration_seconds": 5.24,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.1,
      "end_seconds": 21.57,
      "duration_seconds": 2.47,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.84,
      "end_seconds": 25.29,
      "duration_seconds": 2.45,
      "text": "We came because of a routine check-up."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 25.8,
      "end_seconds": 32.32,
      "duration_seconds": 6.52,
      "text": "So, uh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 32.42,
      "end_seconds": 37.14,
      "duration_seconds": 4.72,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.35,
      "end_seconds": 52.23,
      "duration_seconds": 13.88,
      "text": "I was getting to that! Okay, you know, so as for occasional tiredness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.82,
      "end_seconds": 55.64,
      "duration_seconds": 2.82,
      "text": "Have you had mild headaches now and then?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.14,
      "end_seconds": 57.53,
      "duration_seconds": 1.39,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.66,
      "end_seconds": 60.94,
      "duration_seconds": 2.28,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.11,
      "end_seconds": 69.5,
      "duration_seconds": 6.39,
      "text": "Well, uh, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.72,
      "end_seconds": 74.94,
      "duration_seconds": 4.22,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.83,
      "end_seconds": 79.48,
      "duration_seconds": 3.65,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 80.49,
      "end_seconds": 82.27,
      "duration_seconds": 1.78,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.87,
      "end_seconds": 86.33,
      "duration_seconds": 3.46,
      "text": "Any weight loss or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.21,
      "end_seconds": 98.31,
      "duration_seconds": 11.1,
      "text": "Yeah, no, no weight loss, no shortness of breath. I did have a few skipped meals at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.75,
      "end_seconds": 103.15,
      "duration_seconds": 3.4,
      "text": "Any persistent cough, chest pain or blood in the stool?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 105.79,
      "duration_seconds": 1.84,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.51,
      "end_seconds": 108.22,
      "duration_seconds": 1.71,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.05,
      "end_seconds": 111.63,
      "duration_seconds": 2.58,
      "text": "Well, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 115.03,
      "duration_seconds": 2.81,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.21,
      "end_seconds": 119.49,
      "duration_seconds": 3.28,
      "text": "Uh, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 120.02,
      "end_seconds": 129.56,
      "duration_seconds": 9.54,
      "text": "Okay, so the vitals from earlier. Respiratory rate 14, pulse 72, saturation 97 percent, BP is 120 over 72, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.0,
      "end_seconds": 134.98,
      "duration_seconds": 3.98,
      "text": "Good, thank you. Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 161.12,
      "duration_seconds": 25.56,
      "text": "I, I have high cholesterol, for nearly five years. I did try to ignore it for a while. I took the morning off to come in today. I've got diabetes. I wasn't sure whether to come in at all, to be honest. I've had high blood pressure for five years now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.64,
      "end_seconds": 165.34,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.59,
      "end_seconds": 176.23,
      "duration_seconds": 9.64,
      "text": "I've got heart disease. I'd rather know what's going on than keep guessing. I'm not great at remembering details, um, so bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.37,
      "end_seconds": 182.01,
      "duration_seconds": 4.64,
      "text": "Right. Right, so that's your known high cholesterol. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.86,
      "end_seconds": 185.12,
      "duration_seconds": 2.26,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.54,
      "end_seconds": 186.28,
      "duration_seconds": 0.74,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.85,
      "end_seconds": 197.57,
      "duration_seconds": 4.72,
      "text": "Alright, I've got it. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.36,
      "end_seconds": 203.18,
      "duration_seconds": 4.82,
      "text": "Rosuvastatin. I take it 10 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.46,
      "end_seconds": 207.19,
      "duration_seconds": 2.73,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.59,
      "end_seconds": 211.12,
      "duration_seconds": 3.53,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.73,
      "end_seconds": 219.32,
      "duration_seconds": 6.59,
      "text": "So, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 222.88,
      "duration_seconds": 2.34,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.93,
      "end_seconds": 234.92,
      "duration_seconds": 10.99,
      "text": "For my sugar, I believe. My son sets them out for me, I just take what I'm given. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 236.39,
      "end_seconds": 243.51,
      "duration_seconds": 7.12,
      "text": "Doctor, I think the last prescription for the clopidogrel was 37.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.52,
      "end_seconds": 247.81,
      "duration_seconds": 3.29,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.74,
      "end_seconds": 251.86,
      "duration_seconds": 3.12,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 254.22,
      "duration_seconds": 2.06,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.64,
      "end_seconds": 262.45,
      "duration_seconds": 7.81,
      "text": "I'm allergic to shellfish, I get vomiting. Um, I'm allergic to peanuts, I get my lips swelling."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.02,
      "end_seconds": 266.38,
      "duration_seconds": 3.36,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.87,
      "end_seconds": 269.51,
      "duration_seconds": 1.64,
      "text": "My brother has asthma."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.74,
      "end_seconds": 272.78,
      "duration_seconds": 2.04,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.11,
      "end_seconds": 278.92,
      "duration_seconds": 4.81,
      "text": "I had a stent put in my heart two years ago."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.27,
      "end_seconds": 284.56,
      "duration_seconds": 4.29,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.48,
      "end_seconds": 286.18,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.27,
      "end_seconds": 289.44,
      "duration_seconds": 2.17,
      "text": "Okay, breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.12,
      "end_seconds": 304.06,
      "duration_seconds": 1.94,
      "text": "Heart and lung sounds are normal."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.58,
      "end_seconds": 309.05,
      "duration_seconds": 3.47,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.06,
      "end_seconds": 324.65,
      "duration_seconds": 2.59,
      "text": "Your tummy is soft with no tenderness."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.56,
      "end_seconds": 342.36,
      "duration_seconds": 11.8,
      "text": "Okay, you can sit back up. Right, here's what I'm thinking. My working impression is generally well, nothing worrying today. It could also be a tendency towards high cholesterol, so we'll keep that open."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.88,
      "end_seconds": 345.94,
      "duration_seconds": 2.06,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.51,
      "end_seconds": 361.7,
      "duration_seconds": 15.19,
      "text": "It's reasonable to be concerned, but right now generally well, nothing worrying today is my leading thought, not anything worse. I'm going to order blood tests, for health screening. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 362.27,
      "end_seconds": 364.8,
      "duration_seconds": 2.53,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.87,
      "end_seconds": 374.29,
      "duration_seconds": 8.42,
      "text": "I'd like to arrange an HbA1c for health screening. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 374.62,
      "end_seconds": 376.77,
      "duration_seconds": 2.15,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.99,
      "end_seconds": 381.33,
      "duration_seconds": 3.34,
      "text": "I'd like to arrange a lipid profile for health screening."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.03,
      "end_seconds": 384.76,
      "duration_seconds": 2.73,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.85,
      "end_seconds": 401.09,
      "duration_seconds": 15.24,
      "text": "Keep up regular exercise, around a hundred and fifty minutes a week, and go easy on processed food. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.55,
      "end_seconds": 403.9,
      "duration_seconds": 1.35,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.06,
      "end_seconds": 412.29,
      "duration_seconds": 7.23,
      "text": "If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.4,
      "end_seconds": 414.1,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.05,
      "end_seconds": 418.5,
      "duration_seconds": 3.45,
      "text": "I'd like to see you again in a year."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 419.84,
      "end_seconds": 422.51,
      "duration_seconds": 2.67,
      "text": "I mean, okay, I'll book that."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.57,
      "end_seconds": 427.9,
      "duration_seconds": 4.33,
      "text": "Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.32,
      "end_seconds": 432.08,
      "duration_seconds": 3.76,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}