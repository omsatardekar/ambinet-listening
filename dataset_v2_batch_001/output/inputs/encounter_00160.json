{
  "schema_version": "1.0",
  "encounter_id": "00160",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.54,
      "end_seconds": 4.39,
      "duration_seconds": 3.85,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 8.09,
      "duration_seconds": 3.11,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.93,
      "end_seconds": 12.23,
      "duration_seconds": 3.3,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.19,
      "end_seconds": 16.08,
      "duration_seconds": 2.89,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.13,
      "end_seconds": 19.99,
      "duration_seconds": 2.86,
      "text": "She's been having a high fever, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.97,
      "end_seconds": 23.17,
      "duration_seconds": 2.2,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 24.35,
      "end_seconds": 26.14,
      "duration_seconds": 1.79,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 29.89,
      "duration_seconds": 2.7,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.44,
      "end_seconds": 37.16,
      "duration_seconds": 6.72,
      "text": "About a six out of ten. And there's a skin rash as well, about two weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.71,
      "end_seconds": 40.81,
      "duration_seconds": 3.1,
      "text": "What about severe body pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.82,
      "end_seconds": 44.15,
      "duration_seconds": 2.33,
      "text": "Yes, for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.55,
      "end_seconds": 50.1,
      "duration_seconds": 4.55,
      "text": "Have you had a high fever before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.36,
      "end_seconds": 56.25,
      "duration_seconds": 4.89,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.68,
      "end_seconds": 60.8,
      "duration_seconds": 3.12,
      "text": "Have you had any abdominal pain, vomiting or breathlessness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.83,
      "end_seconds": 64.26,
      "duration_seconds": 2.43,
      "text": "Hmm, nothing like that, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.85,
      "end_seconds": 70.74,
      "duration_seconds": 5.89,
      "text": "Mm. Let me check a few things. Any bleeding from the gums or blood in the stool?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.14,
      "end_seconds": 77.17,
      "duration_seconds": 5.03,
      "text": "No bleeding from the gums or blood in the stool, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.76,
      "end_seconds": 80.36,
      "duration_seconds": 1.6,
      "text": "Have you had any cough?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.71,
      "end_seconds": 81.83,
      "duration_seconds": 1.12,
      "text": "No. No cough."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.43,
      "end_seconds": 87.27,
      "duration_seconds": 4.84,
      "text": "Okay, I'm following. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.56,
      "end_seconds": 90.14,
      "duration_seconds": 1.58,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.8,
      "end_seconds": 94.08,
      "duration_seconds": 3.28,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 94.47,
      "end_seconds": 95.24,
      "duration_seconds": 0.77,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.61,
      "end_seconds": 98.44,
      "duration_seconds": 2.83,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.96,
      "end_seconds": 100.8,
      "duration_seconds": 1.84,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.48,
      "end_seconds": 102.18,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.3,
      "end_seconds": 118.42,
      "duration_seconds": 15.12,
      "text": "Diabetes, for nearly five years. I did try to ignore it for a while. Yes, COPD. A neighbour of mine said I should see someone about it. I didn't want to make a fuss, you know. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 124.7,
      "duration_seconds": 5.9,
      "text": "Any medication at the moment, including things from the pharmacy? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 125.75,
      "end_seconds": 129.72,
      "duration_seconds": 3.97,
      "text": "I take amlodipine, once a day for my pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.13,
      "end_seconds": 132.85,
      "duration_seconds": 1.72,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.78,
      "end_seconds": 148.38,
      "duration_seconds": 14.6,
      "text": "5 milligrams. Glimepiride. I take it 2 milligrams, before breakfast. My family kept telling me to get it checked. Tiotropium inhaler, once a day for my chest. I'm on clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 149.61,
      "end_seconds": 153.56,
      "duration_seconds": 3.95,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.93,
      "end_seconds": 158.87,
      "duration_seconds": 3.94,
      "text": "Okay, hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 163.77,
      "duration_seconds": 3.37,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.26,
      "end_seconds": 165.93,
      "duration_seconds": 1.67,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.61,
      "end_seconds": 177.42,
      "duration_seconds": 10.81,
      "text": "I had a stent put in my heart two years ago. I've never really been one for hospitals. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.11,
      "end_seconds": 179.28,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.62,
      "end_seconds": 186.43,
      "duration_seconds": 3.81,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.97,
      "end_seconds": 189.04,
      "duration_seconds": 1.07,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.29,
      "end_seconds": 194.65,
      "duration_seconds": 4.36,
      "text": "I used to smoke but I quit five years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 196.07,
      "end_seconds": 202.7,
      "duration_seconds": 6.63,
      "text": "Here are the numbers, doctor. Oxygen saturation is 95 percent, blood pressure 107 over 79, heart rate 108."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.34,
      "end_seconds": 204.62,
      "duration_seconds": 1.28,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.01,
      "end_seconds": 208.01,
      "duration_seconds": 2.0,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.17,
      "end_seconds": 212.29,
      "duration_seconds": 3.12,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.64,
      "end_seconds": 232.05,
      "duration_seconds": 4.41,
      "text": "Your tummy is soft, a little tender under the ribs on the right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.23,
      "end_seconds": 235.95,
      "duration_seconds": 2.72,
      "text": "So, now bend it for me, slowly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.07,
      "end_seconds": 258.21,
      "duration_seconds": 4.14,
      "text": "There's a faint rash on your forearms, it blanches when I press."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.62,
      "end_seconds": 259.32,
      "duration_seconds": 0.7,
      "text": "Hm."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.13,
      "end_seconds": 281.67,
      "duration_seconds": 19.54,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. So, based on the history and the examination, I think we're dealing with a viral fever, possibly dengue at this stage. I'd also keep typhoid fever in mind."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.24,
      "end_seconds": 286.2,
      "duration_seconds": 2.96,
      "text": "Okay, so doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.84,
      "end_seconds": 310.93,
      "duration_seconds": 24.09,
      "text": "I understand the worry. At the moment I'd say it's a viral fever, possibly dengue, and we'll know more once the a full blood count is back. I'd like to arrange a full blood count for platelet count. It's a routine test and it'll give us a much clearer picture. I'd like to arrange a malaria test for fever. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.46,
      "end_seconds": 326.61,
      "duration_seconds": 15.15,
      "text": "We should do a dengue test for fever. The result will help us decide whether anything more is needed. I'm prescribing paracetamol, 500 milligrams, every six hours if needed, for three days. That should help with fever and body aches."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 327.55,
      "end_seconds": 330.98,
      "duration_seconds": 3.43,
      "text": "Oh, okay, and I take that after food?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.29,
      "end_seconds": 350.35,
      "duration_seconds": 18.06,
      "text": "Drink a lot, coconut water, ORS, whatever you can manage. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 351.7,
      "end_seconds": 352.91,
      "duration_seconds": 1.21,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.02,
      "end_seconds": 362.93,
      "duration_seconds": 8.91,
      "text": "I want you to come back or go to emergency straight away if you notice any bleeding or you can't keep fluids down."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.38,
      "end_seconds": 365.08,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.59,
      "end_seconds": 369.32,
      "duration_seconds": 3.73,
      "text": "I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.83,
      "end_seconds": 370.53,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.9,
      "end_seconds": 374.88,
      "duration_seconds": 3.98,
      "text": "Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.43,
      "end_seconds": 378.7,
      "duration_seconds": 2.27,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}