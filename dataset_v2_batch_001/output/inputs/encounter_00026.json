{
  "schema_version": "1.0",
  "encounter_id": "00026",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 6.0,
      "duration_seconds": 4.65,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 10.24,
      "duration_seconds": 3.35,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.36,
      "end_seconds": 17.22,
      "duration_seconds": 5.86,
      "text": "Okay, you know, so morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.24,
      "end_seconds": 21.36,
      "duration_seconds": 3.12,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.77,
      "end_seconds": 28.2,
      "duration_seconds": 5.43,
      "text": "Well, doctor, it's been feeling overwhelmed at work. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.2,
      "end_seconds": 31.45,
      "duration_seconds": 2.25,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.88,
      "end_seconds": 36.79,
      "duration_seconds": 3.91,
      "text": "It's, It's been going on for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.99,
      "end_seconds": 41.98,
      "duration_seconds": 3.99,
      "text": "Okay, how would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.35,
      "end_seconds": 50.19,
      "duration_seconds": 5.84,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.47,
      "end_seconds": 55.95,
      "duration_seconds": 4.48,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.25,
      "end_seconds": 58.96,
      "duration_seconds": 2.71,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.96,
      "end_seconds": 60.89,
      "duration_seconds": 0.93,
      "text": "Anything that helps?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.11,
      "end_seconds": 65.21,
      "duration_seconds": 3.1,
      "text": "It settles a little with weekends off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.83,
      "end_seconds": 72.79,
      "duration_seconds": 6.96,
      "text": "Hmm, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 72.89,
      "end_seconds": 77.12,
      "duration_seconds": 4.23,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.61,
      "end_seconds": 80.83,
      "duration_seconds": 2.22,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.34,
      "end_seconds": 85.07,
      "duration_seconds": 2.73,
      "text": "Any trouble switching off at night as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.37,
      "end_seconds": 89.38,
      "duration_seconds": 3.01,
      "text": "Yes, uh, for six months."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.32,
      "end_seconds": 93.09,
      "duration_seconds": 2.77,
      "text": "What's the pattern, is it there all day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 94.27,
      "end_seconds": 96.01,
      "duration_seconds": 1.74,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 97.55,
      "end_seconds": 99.69,
      "duration_seconds": 2.14,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.28,
      "end_seconds": 102.7,
      "duration_seconds": 2.42,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.11,
      "end_seconds": 107.59,
      "duration_seconds": 3.48,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.05,
      "end_seconds": 110.11,
      "duration_seconds": 2.06,
      "text": "Any alcohol use or panic attacks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 110.98,
      "end_seconds": 122.65,
      "duration_seconds": 11.67,
      "text": "No, uh, no alcohol use, no panic attacks. I did have headaches in the evening at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.74,
      "end_seconds": 127.06,
      "duration_seconds": 3.32,
      "text": "Any chest pain, thoughts of harming myself or weight loss?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.49,
      "end_seconds": 129.38,
      "duration_seconds": 1.89,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.73,
      "end_seconds": 132.39,
      "duration_seconds": 1.66,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.61,
      "end_seconds": 136.29,
      "duration_seconds": 2.68,
      "text": "No, you know, that's all fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.76,
      "end_seconds": 139.72,
      "duration_seconds": 1.96,
      "text": "How's everything else at home otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 147.19,
      "duration_seconds": 6.28,
      "text": "Right, busy. Everyone's running in different directions at the moment, you know how it is."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.71,
      "end_seconds": 153.29,
      "duration_seconds": 5.58,
      "text": "Do you have any known allergies at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 153.82,
      "end_seconds": 161.12,
      "duration_seconds": 7.3,
      "text": "Yes, sulfa drugs, it gives me a rash. I'm, I'm allergic to penicillin, I get hives."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 165.01,
      "duration_seconds": 3.36,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.35,
      "end_seconds": 170.26,
      "duration_seconds": 4.91,
      "text": "Oh, I take omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.94,
      "end_seconds": 174.38,
      "duration_seconds": 3.44,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.03,
      "end_seconds": 186.7,
      "duration_seconds": 11.67,
      "text": "Not with me. I'll bring it next time. It's escitalopram, 10 milligrams, once a day. Clopidogrel. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.68,
      "end_seconds": 190.05,
      "duration_seconds": 2.37,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.06,
      "end_seconds": 200.6,
      "duration_seconds": 7.54,
      "text": "For six months. Well, um, I'd been on aspirin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.41,
      "end_seconds": 205.91,
      "duration_seconds": 4.5,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.24,
      "end_seconds": 230.52,
      "duration_seconds": 8.28,
      "text": "Alright, that's saved, thanks for waiting. What about your general health, any conditions you're being treated for? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.93,
      "end_seconds": 242.48,
      "duration_seconds": 10.55,
      "text": "Acid reflux, for two years. I'd rather not end up on lots of tablets if I can avoid it. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.83,
      "end_seconds": 244.53,
      "duration_seconds": 0.7,
      "text": "Mm-hm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.11,
      "end_seconds": 251.95,
      "duration_seconds": 5.84,
      "text": "I've got anxiety. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.51,
      "end_seconds": 254.49,
      "duration_seconds": 0.98,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.54,
      "end_seconds": 263.87,
      "duration_seconds": 8.33,
      "text": "Heart disease, for about ten years. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.39,
      "end_seconds": 285.59,
      "duration_seconds": 20.2,
      "text": "Mm-hm. Right, so that's your known anxiety. We'll keep that in mind today. I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.63,
      "end_seconds": 288.87,
      "duration_seconds": 2.24,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.78,
      "end_seconds": 293.95,
      "duration_seconds": 4.17,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.35,
      "end_seconds": 297.98,
      "duration_seconds": 3.63,
      "text": "Okay, um, so my brother has asthma."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.3,
      "end_seconds": 303.11,
      "duration_seconds": 3.81,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.72,
      "end_seconds": 304.58,
      "duration_seconds": 0.86,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.1,
      "end_seconds": 318.71,
      "duration_seconds": 1.61,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 319.43,
      "end_seconds": 324.49,
      "duration_seconds": 5.06,
      "text": "Here are the numbers, doctor. Blood pressure 122 over 74, heart rate 83."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.67,
      "end_seconds": 327.32,
      "duration_seconds": 1.65,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.57,
      "end_seconds": 332.47,
      "duration_seconds": 3.9,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 333.36,
      "end_seconds": 334.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.67,
      "end_seconds": 350.1,
      "duration_seconds": 1.43,
      "text": "Alright, I've got it."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.83,
      "end_seconds": 353.0,
      "duration_seconds": 2.17,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 353.35,
      "end_seconds": 354.29,
      "duration_seconds": 0.94,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.15,
      "end_seconds": 382.48,
      "duration_seconds": 16.33,
      "text": "Okay, here we go. Putting together what you've described, it fits best with stress-related symptoms. I want to be honest that this is an impression, not a final answer. I can't rule out an anxiety disorder yet. I can't rule out a depressive episode yet."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.89,
      "end_seconds": 385.08,
      "duration_seconds": 2.19,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.55,
      "end_seconds": 403.09,
      "duration_seconds": 16.54,
      "text": "Nothing I've seen today points to an emergency. It looks like stress-related symptoms, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling overwhelmed at work for six months, moderate, and no thoughts of harming myself or panic attacks."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 404.55,
      "end_seconds": 406.12,
      "duration_seconds": 1.57,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.16,
      "end_seconds": 419.8,
      "duration_seconds": 12.64,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 420.63,
      "end_seconds": 422.53,
      "duration_seconds": 1.9,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.45,
      "end_seconds": 431.83,
      "duration_seconds": 8.38,
      "text": "Let's get blood tests, for stress-related symptoms. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 432.73,
      "end_seconds": 436.2,
      "duration_seconds": 3.47,
      "text": "Um, alright. When can I do that?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.75,
      "end_seconds": 458.45,
      "duration_seconds": 21.7,
      "text": "Block out proper breaks in the day, and one evening a week that's yours. A short walk every day, even twenty minutes, will help more than you'd think. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 458.98,
      "end_seconds": 460.36,
      "duration_seconds": 1.38,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 461.34,
      "end_seconds": 469.2,
      "duration_seconds": 7.86,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse. Come back in four weeks."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 469.55,
      "end_seconds": 471.6,
      "duration_seconds": 2.05,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.29,
      "end_seconds": 476.96,
      "duration_seconds": 4.67,
      "text": "Okay, can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 477.63,
      "end_seconds": 482.67,
      "duration_seconds": 5.04,
      "text": "So, uh, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 484.18,
      "end_seconds": 488.69,
      "duration_seconds": 4.51,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 490.15,
      "end_seconds": 493.17,
      "duration_seconds": 3.02,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0077",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 494.27,
      "end_seconds": 495.01,
      "duration_seconds": 0.74,
      "text": "Alright, goodbye."
    }
  ]
}