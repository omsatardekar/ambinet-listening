{
  "schema_version": "1.0",
  "encounter_id": "00350",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 5.13,
      "duration_seconds": 4.29,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.11,
      "end_seconds": 9.33,
      "duration_seconds": 3.22,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.03,
      "end_seconds": 19.19,
      "duration_seconds": 9.16,
      "text": "Honestly, it's aching in my thighs, and my family pushed me to come. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 22.69,
      "duration_seconds": 2.24,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.32,
      "end_seconds": 25.89,
      "duration_seconds": 2.57,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.45,
      "end_seconds": 29.0,
      "duration_seconds": 1.55,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.09,
      "end_seconds": 34.22,
      "duration_seconds": 4.13,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.17,
      "end_seconds": 37.06,
      "duration_seconds": 1.89,
      "text": "Has there been cramps too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.48,
      "end_seconds": 42.04,
      "duration_seconds": 3.56,
      "text": "Yeah, you know, I've had that since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 48.93,
      "duration_seconds": 3.71,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.11,
      "end_seconds": 56.31,
      "duration_seconds": 6.2,
      "text": "Just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.18,
      "end_seconds": 59.74,
      "duration_seconds": 2.56,
      "text": "Any joint swelling or trouble swallowing at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.21,
      "end_seconds": 63.71,
      "duration_seconds": 3.5,
      "text": "No, you know, no joint swelling or trouble swallowing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.98,
      "end_seconds": 67.65,
      "duration_seconds": 2.67,
      "text": "Any rash, fever or recent heavy exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.02,
      "end_seconds": 70.4,
      "duration_seconds": 2.38,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.69,
      "end_seconds": 74.47,
      "duration_seconds": 2.78,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.0,
      "end_seconds": 77.56,
      "duration_seconds": 1.56,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.91,
      "end_seconds": 81.86,
      "duration_seconds": 2.95,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.73,
      "end_seconds": 84.88,
      "duration_seconds": 2.15,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.76,
      "end_seconds": 89.44,
      "duration_seconds": 3.68,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.51,
      "end_seconds": 91.25,
      "duration_seconds": 0.74,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.04,
      "end_seconds": 107.13,
      "duration_seconds": 15.09,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.5,
      "end_seconds": 110.69,
      "duration_seconds": 2.19,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 116.37,
      "duration_seconds": 2.47,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.75,
      "end_seconds": 118.22,
      "duration_seconds": 1.47,
      "text": "Rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.03,
      "end_seconds": 121.47,
      "duration_seconds": 2.44,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.08,
      "end_seconds": 122.86,
      "duration_seconds": 0.78,
      "text": "10 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.07,
      "end_seconds": 126.65,
      "duration_seconds": 2.58,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.96,
      "end_seconds": 128.16,
      "duration_seconds": 1.2,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.25,
      "end_seconds": 131.53,
      "duration_seconds": 2.28,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.65,
      "end_seconds": 134.67,
      "duration_seconds": 2.02,
      "text": "No, never had any surgery."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 139.51,
      "duration_seconds": 3.59,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.24,
      "end_seconds": 140.94,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.58,
      "end_seconds": 157.24,
      "duration_seconds": 4.66,
      "text": "Alright, I've got it. Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.65,
      "end_seconds": 159.87,
      "duration_seconds": 1.22,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.9,
      "end_seconds": 164.73,
      "duration_seconds": 3.83,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.7,
      "end_seconds": 167.87,
      "duration_seconds": 2.17,
      "text": "No problem, take your time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 169.32,
      "end_seconds": 177.79,
      "duration_seconds": 8.47,
      "text": "Okay, so the vitals from earlier. BP is 127 over 70, pulse 81, temperature 36.6, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.51,
      "end_seconds": 179.21,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.65,
      "end_seconds": 183.8,
      "duration_seconds": 3.15,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.23,
      "end_seconds": 184.93,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.76,
      "end_seconds": 193.44,
      "duration_seconds": 1.68,
      "text": "Okay, here we go."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.37,
      "end_seconds": 199.3,
      "duration_seconds": 2.93,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.6,
      "end_seconds": 200.87,
      "duration_seconds": 1.27,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.88,
      "end_seconds": 203.38,
      "duration_seconds": 1.5,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.97,
      "end_seconds": 221.49,
      "duration_seconds": 2.52,
      "text": "The muscles are mildly tender when I squeeze."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.45,
      "end_seconds": 223.71,
      "duration_seconds": 1.26,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.14,
      "end_seconds": 240.98,
      "duration_seconds": 3.84,
      "text": "Power in the thighs is slightly reduced, four out of five."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.49,
      "end_seconds": 258.72,
      "duration_seconds": 12.23,
      "text": "Okay, you can sit back up. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.52,
      "end_seconds": 274.39,
      "duration_seconds": 14.87,
      "text": "Not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.24,
      "end_seconds": 292.69,
      "duration_seconds": 17.45,
      "text": "Okay, so my impression is this: I think we're dealing with muscle symptoms that may be related to the cholesterol tablet at this stage. I want to be honest that this is an impression, not a final answer. A vitamin D deficiency is also on my list."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 293.27,
      "end_seconds": 296.07,
      "duration_seconds": 2.8,
      "text": "Is it something serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.24,
      "end_seconds": 319.4,
      "duration_seconds": 19.16,
      "text": "It's reasonable to be concerned, but right now muscle symptoms that may be related to the cholesterol tablet is my leading thought, not anything worse. Let me just recap so I've got it right. You've had aching in your thighs for one week, and no joint swelling or recent heavy exercise."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.88,
      "end_seconds": 322.12,
      "duration_seconds": 1.24,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.57,
      "end_seconds": 326.83,
      "duration_seconds": 3.26,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 327.29,
      "end_seconds": 329.33,
      "duration_seconds": 2.04,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.07,
      "end_seconds": 338.19,
      "duration_seconds": 8.12,
      "text": "We should do a creatine kinase level for muscle pain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 338.98,
      "end_seconds": 342.14,
      "duration_seconds": 3.16,
      "text": "Sure, where do I go for that?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.88,
      "end_seconds": 367.34,
      "duration_seconds": 22.46,
      "text": "Don't stop any of your tablets on your own, we'll decide after the blood test. Please take the tablets with food so they don't upset your stomach. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. If the symptoms get worse, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 368.35,
      "end_seconds": 369.05,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.84,
      "end_seconds": 377.71,
      "duration_seconds": 7.87,
      "text": "Please come and see me after the results are back. Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.81,
      "end_seconds": 384.23,
      "duration_seconds": 5.42,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.01,
      "end_seconds": 389.58,
      "duration_seconds": 4.57,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 390.31,
      "end_seconds": 392.59,
      "duration_seconds": 2.28,
      "text": "Thank you. I'll see you then."
    }
  ]
}