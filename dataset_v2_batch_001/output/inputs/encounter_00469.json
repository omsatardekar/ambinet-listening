{
  "schema_version": "1.0",
  "encounter_id": "00469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.28,
      "end_seconds": 3.29,
      "duration_seconds": 2.01,
      "text": "Right, come in and get settled."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.45,
      "end_seconds": 7.55,
      "duration_seconds": 3.1,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.13,
      "end_seconds": 15.93,
      "duration_seconds": 4.8,
      "text": "Yes, that's no problem at all. Please sit. Go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.37,
      "end_seconds": 21.37,
      "duration_seconds": 4.0,
      "text": "Oh, he's been feeling anxious most of the day, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.92,
      "end_seconds": 26.83,
      "duration_seconds": 4.91,
      "text": "Is this recent, or has it been a while? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.71,
      "end_seconds": 34.66,
      "duration_seconds": 6.95,
      "text": "It's been going on for about a month. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.0,
      "end_seconds": 38.72,
      "duration_seconds": 2.72,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 41.21,
      "duration_seconds": 1.41,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.25,
      "end_seconds": 45.81,
      "duration_seconds": 3.56,
      "text": "What about your heart pounding suddenly, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.52,
      "end_seconds": 62.43,
      "duration_seconds": 15.91,
      "text": "Okay, so yeah. One week, I'd say. About my heart pounding suddenly, I'd say every other day. I mean, I've also had trouble falling asleep, for four weeks. About trouble falling asleep, severe, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.51,
      "end_seconds": 64.97,
      "duration_seconds": 1.46,
      "text": "What about weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.5,
      "end_seconds": 67.08,
      "duration_seconds": 1.58,
      "text": "No, no weight loss."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.4,
      "end_seconds": 74.41,
      "duration_seconds": 3.01,
      "text": "Any thoughts of harming myself, fainting or alcohol use?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.85,
      "end_seconds": 78.97,
      "duration_seconds": 3.12,
      "text": "Right, no, none of that at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.1,
      "end_seconds": 83.08,
      "duration_seconds": 2.98,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.46,
      "end_seconds": 86.88,
      "duration_seconds": 2.42,
      "text": "Yeah, no, that's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.84,
      "end_seconds": 90.1,
      "duration_seconds": 2.26,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 93.82,
      "duration_seconds": 3.0,
      "text": "Uh, of course, take your time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.2,
      "end_seconds": 105.83,
      "duration_seconds": 3.63,
      "text": "Right, thanks for waiting. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.94,
      "end_seconds": 110.94,
      "duration_seconds": 4.0,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.07,
      "end_seconds": 116.6,
      "duration_seconds": 2.53,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.17,
      "end_seconds": 124.33,
      "duration_seconds": 7.16,
      "text": "So, not with me. I'll bring it next time. I take Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.77,
      "end_seconds": 128.7,
      "duration_seconds": 2.93,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.06,
      "end_seconds": 140.98,
      "duration_seconds": 10.92,
      "text": "I've had anxiety for five years now. It's the not knowing that gets to me. Yeah, I've got COPD. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.47,
      "end_seconds": 164.49,
      "duration_seconds": 22.02,
      "text": "Okay, anxiety, that's already on your record. Good to know. Okay, COPD, that's already on your record. Good to know. Just so you know how the rest of the visit will go: I'll finish my notes, we'll agree on the plan, and the front desk will help with anything that needs booking. You shouldn't need to chase anything yourself."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 164.9,
      "end_seconds": 167.98,
      "duration_seconds": 3.08,
      "text": "Good, I was wondering how this would go."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.37,
      "end_seconds": 170.42,
      "duration_seconds": 2.05,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.33,
      "end_seconds": 175.37,
      "duration_seconds": 4.04,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.54,
      "end_seconds": 177.64,
      "duration_seconds": 1.1,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.09,
      "end_seconds": 182.03,
      "duration_seconds": 2.94,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.5,
      "end_seconds": 189.06,
      "duration_seconds": 5.56,
      "text": "Any allergies I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.58,
      "end_seconds": 194.2,
      "duration_seconds": 3.62,
      "text": "Oh, I'm allergic to codeine, I get vomiting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.67,
      "end_seconds": 196.91,
      "duration_seconds": 2.24,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.8,
      "end_seconds": 212.36,
      "duration_seconds": 1.56,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.76,
      "end_seconds": 239.51,
      "duration_seconds": 6.75,
      "text": "Okay: temperature is 36.8 degrees, saturation 98 percent, heart rate 74. And BP is 122 over 68."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.02,
      "end_seconds": 242.61,
      "duration_seconds": 2.59,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 246.71,
      "duration_seconds": 3.36,
      "text": "Alright, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 250.51,
      "duration_seconds": 2.54,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.27,
      "end_seconds": 252.26,
      "duration_seconds": 0.99,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.99,
      "end_seconds": 257.54,
      "duration_seconds": 3.55,
      "text": "A little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.31,
      "end_seconds": 272.29,
      "duration_seconds": 2.98,
      "text": "Pulse is regular and you're breathing comfortably right now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.08,
      "end_seconds": 290.04,
      "duration_seconds": 14.96,
      "text": "Okay, you can sit back up. Right, here's what I'm thinking. It fits best with an anxiety disorder. The reason I say that is that your story and my examination fit together. A heart rhythm cause is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.09,
      "end_seconds": 293.05,
      "duration_seconds": 1.96,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.19,
      "end_seconds": 309.62,
      "duration_seconds": 15.43,
      "text": "Nothing I've seen today points to an emergency. It looks like an anxiety disorder, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling anxious most of the day for about a month, mild, and no fainting or weight loss."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.1,
      "end_seconds": 312.55,
      "duration_seconds": 2.45,
      "text": "So, exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.6,
      "end_seconds": 319.96,
      "duration_seconds": 3.36,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.53,
      "end_seconds": 322.45,
      "duration_seconds": 1.92,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.08,
      "end_seconds": 348.47,
      "duration_seconds": 25.39,
      "text": "Let's get a thyroid test, for anxiety. I'd rather check than guess, and this is the quickest way to know more. I'm going to order an ECG, for palpitations. Regular exercise and less caffeine make a real difference. Slow breathing, in for four and out for six, for a few minutes whenever it builds up. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.92,
      "end_seconds": 361.88,
      "duration_seconds": 11.96,
      "text": "A short walk every day, even twenty minutes, will help more than you'd think. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 362.35,
      "end_seconds": 363.8,
      "duration_seconds": 1.45,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 364.84,
      "end_seconds": 371.26,
      "duration_seconds": 6.42,
      "text": "I want you to come back or go to emergency straight away if you have thoughts of harming yourself."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 372.48,
      "end_seconds": 374.89,
      "duration_seconds": 2.41,
      "text": "Hmm, yes, I'll do that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.7,
      "end_seconds": 378.87,
      "duration_seconds": 3.17,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 380.35,
      "end_seconds": 383.99,
      "duration_seconds": 3.64,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.34,
      "end_seconds": 388.79,
      "duration_seconds": 4.45,
      "text": "Just to confirm, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 389.14,
      "end_seconds": 393.01,
      "duration_seconds": 3.87,
      "text": "So, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.39,
      "end_seconds": 399.78,
      "duration_seconds": 5.39,
      "text": "Yes, exactly right. Right, that's all I have. Is there anything you wanted to ask?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.66,
      "end_seconds": 403.1,
      "duration_seconds": 2.44,
      "text": "Nothing more from me, doctor, thanks."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.45,
      "end_seconds": 405.21,
      "duration_seconds": 0.76,
      "text": "Alright, goodbye."
    }
  ]
}