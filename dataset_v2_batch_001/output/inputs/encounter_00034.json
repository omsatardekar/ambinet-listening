{
  "schema_version": "1.0",
  "encounter_id": "00034",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 1.46,
      "duration_seconds": 0.92,
      "text": "Afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 2.96,
      "end_seconds": 6.63,
      "duration_seconds": 3.67,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.76,
      "end_seconds": 12.4,
      "duration_seconds": 4.64,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.96,
      "end_seconds": 16.1,
      "duration_seconds": 3.14,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.23,
      "end_seconds": 20.52,
      "duration_seconds": 2.29,
      "text": "She's been having yellow eyes, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.77,
      "end_seconds": 24.96,
      "duration_seconds": 3.19,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.05,
      "end_seconds": 28.24,
      "duration_seconds": 2.19,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.83,
      "end_seconds": 31.54,
      "duration_seconds": 2.71,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.35,
      "end_seconds": 53.38,
      "duration_seconds": 18.03,
      "text": "Pale stools goes along with it, most of the time. I've also had a dull ache on the right side of the tummy, for about two weeks. I've also had itching all over. About itching all over, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 58.34,
      "duration_seconds": 4.09,
      "text": "Okay, any black stools or swelling of the tummy at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.84,
      "end_seconds": 61.72,
      "duration_seconds": 1.88,
      "text": "No, none of those."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.19,
      "end_seconds": 66.43,
      "duration_seconds": 4.24,
      "text": "Let me check a few things. Any weight loss, confusion or vomiting blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.94,
      "end_seconds": 69.79,
      "duration_seconds": 1.85,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.84,
      "end_seconds": 72.54,
      "duration_seconds": 1.7,
      "text": "And fever, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.14,
      "end_seconds": 75.5,
      "duration_seconds": 1.36,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 76.03,
      "end_seconds": 79.86,
      "duration_seconds": 3.83,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.11,
      "end_seconds": 86.22,
      "duration_seconds": 5.11,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.24,
      "end_seconds": 94.17,
      "duration_seconds": 6.93,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.89,
      "end_seconds": 96.19,
      "duration_seconds": 1.3,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.54,
      "end_seconds": 99.33,
      "duration_seconds": 2.79,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.3,
      "end_seconds": 102.35,
      "duration_seconds": 2.05,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.81,
      "end_seconds": 106.14,
      "duration_seconds": 2.33,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.69,
      "end_seconds": 109.63,
      "duration_seconds": 2.94,
      "text": "No, you know, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.1,
      "end_seconds": 114.51,
      "duration_seconds": 3.41,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.24,
      "end_seconds": 121.68,
      "duration_seconds": 3.44,
      "text": "I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 122.1,
      "end_seconds": 128.94,
      "duration_seconds": 6.84,
      "text": "Doctor, I think the last prescription for the Glycomet was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.56,
      "end_seconds": 134.11,
      "duration_seconds": 4.55,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.7,
      "end_seconds": 141.95,
      "duration_seconds": 6.25,
      "text": "I don't think I have it with me. I'm on diclofenac, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.83,
      "end_seconds": 145.0,
      "duration_seconds": 2.17,
      "text": "Alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.37,
      "end_seconds": 146.16,
      "duration_seconds": 0.79,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.56,
      "end_seconds": 150.15,
      "duration_seconds": 3.59,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.19,
      "end_seconds": 163.74,
      "duration_seconds": 12.55,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.39,
      "end_seconds": 168.08,
      "duration_seconds": 3.69,
      "text": "Right, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.66,
      "end_seconds": 171.31,
      "duration_seconds": 2.65,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.36,
      "end_seconds": 175.93,
      "duration_seconds": 3.57,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.07,
      "end_seconds": 180.3,
      "duration_seconds": 3.23,
      "text": "I have high cholesterol. Diabetes, for two years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.89,
      "end_seconds": 183.04,
      "duration_seconds": 1.15,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.3,
      "end_seconds": 196.24,
      "duration_seconds": 11.94,
      "text": "I've had arthritis in my knees for five years now. I'd rather not end up on lots of tablets if I can avoid it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.7,
      "end_seconds": 203.21,
      "duration_seconds": 6.51,
      "text": "Right, so that's your known diabetes. We'll keep that in mind today. I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.09,
      "end_seconds": 213.52,
      "duration_seconds": 1.43,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.41,
      "end_seconds": 237.77,
      "duration_seconds": 7.36,
      "text": "Okay: temp 36.8 degrees, heart rate 64, blood pressure 120 over 71, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.41,
      "end_seconds": 239.53,
      "duration_seconds": 1.12,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.77,
      "end_seconds": 243.51,
      "duration_seconds": 2.74,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 247.32,
      "duration_seconds": 1.85,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.08,
      "end_seconds": 251.41,
      "duration_seconds": 2.33,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.42,
      "end_seconds": 270.12,
      "duration_seconds": 2.7,
      "text": "The whites of your eyes are yellow."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.3,
      "end_seconds": 273.51,
      "duration_seconds": 2.21,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.07,
      "end_seconds": 295.06,
      "duration_seconds": 2.99,
      "text": "Liver edge is just palpable and mildly tender."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.68,
      "end_seconds": 317.13,
      "duration_seconds": 19.45,
      "text": "All done, thank you, please sit down. Putting it all together, my working impression is jaundice with a cause we still need to find. The reason I say that is that your story and my examination fit together. I'd also keep hepatitis in mind. I'd like to arrange an ultrasound of the abdomen for jaundice."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.84,
      "end_seconds": 321.78,
      "duration_seconds": 3.94,
      "text": "Sure, um, where do I go for that?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.46,
      "end_seconds": 333.2,
      "duration_seconds": 10.74,
      "text": "Let's get liver function tests, for jaundice. I'm going to order a hepatitis screen, for jaundice. Please avoid alcohol completely and don't take any painkillers except paracetamol, and not much of that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.41,
      "end_seconds": 345.61,
      "duration_seconds": 12.2,
      "text": "Mm-hm. A short walk every day, even twenty minutes, will help more than you'd think. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.58,
      "end_seconds": 347.84,
      "duration_seconds": 1.26,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.43,
      "end_seconds": 357.31,
      "duration_seconds": 7.88,
      "text": "Please don't sit on it if you vomit blood or become drowsy or confused. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.39,
      "end_seconds": 360.06,
      "duration_seconds": 1.67,
      "text": "Yes, I'll do that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.94,
      "end_seconds": 367.17,
      "duration_seconds": 6.23,
      "text": "I'd like to see you again in three days. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.5,
      "end_seconds": 371.26,
      "duration_seconds": 3.76,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.16,
      "end_seconds": 374.26,
      "duration_seconds": 2.1,
      "text": "Bye for now, look after yourself."
    }
  ]
}