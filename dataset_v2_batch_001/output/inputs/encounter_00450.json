{
  "schema_version": "1.0",
  "encounter_id": "00450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 6.11,
      "duration_seconds": 4.77,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.38,
      "end_seconds": 10.63,
      "duration_seconds": 3.25,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 20.65,
      "duration_seconds": 6.66,
      "text": "Um, mainly a missed period. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.3,
      "end_seconds": 25.9,
      "duration_seconds": 4.6,
      "text": "How long have you had it? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.26,
      "end_seconds": 33.4,
      "duration_seconds": 6.14,
      "text": "For about four days, I'd say. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.56,
      "end_seconds": 36.47,
      "duration_seconds": 1.91,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.87,
      "end_seconds": 41.09,
      "duration_seconds": 3.22,
      "text": "Uh, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.46,
      "end_seconds": 44.38,
      "duration_seconds": 2.92,
      "text": "Have you been needing to pass urine more?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.66,
      "end_seconds": 54.86,
      "duration_seconds": 9.2,
      "text": "Yes, um, I have. Uh, as for needing to pass urine more, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 72.47,
      "duration_seconds": 16.49,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.1,
      "end_seconds": 75.78,
      "duration_seconds": 2.68,
      "text": "Um, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.35,
      "end_seconds": 78.91,
      "duration_seconds": 1.56,
      "text": "Any dizziness or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.1,
      "end_seconds": 82.69,
      "duration_seconds": 2.59,
      "text": "No, uh, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 86.88,
      "duration_seconds": 2.77,
      "text": "Right, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.44,
      "end_seconds": 88.21,
      "duration_seconds": 0.77,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.37,
      "end_seconds": 95.86,
      "duration_seconds": 1.49,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 97.4,
      "end_seconds": 103.38,
      "duration_seconds": 5.98,
      "text": "Okay, so the vitals from earlier. Pressure 124 over 80, pulse 72, saturation 99 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.93,
      "end_seconds": 108.05,
      "duration_seconds": 3.12,
      "text": "Okay, noted. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.95,
      "end_seconds": 111.44,
      "duration_seconds": 2.49,
      "text": "I'm, I'm on thyroxine, every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.92,
      "end_seconds": 113.51,
      "duration_seconds": 1.59,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.59,
      "end_seconds": 126.5,
      "duration_seconds": 11.91,
      "text": "75 micrograms, I think that's what's on the box. It's folic acid, 5 milligrams, once a day. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.76,
      "end_seconds": 132.6,
      "duration_seconds": 2.84,
      "text": "Are you comfortable? Do you want some water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.99,
      "end_seconds": 136.53,
      "duration_seconds": 3.54,
      "text": "Yes, some water would be nice, thank you."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.92,
      "end_seconds": 143.07,
      "duration_seconds": 5.15,
      "text": "Do you have any known allergies at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.49,
      "end_seconds": 147.15,
      "duration_seconds": 2.66,
      "text": "I'm allergic to codeine, I get vomiting."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.78,
      "end_seconds": 150.15,
      "duration_seconds": 2.37,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.03,
      "end_seconds": 151.87,
      "duration_seconds": 0.84,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.58,
      "end_seconds": 164.03,
      "duration_seconds": 2.45,
      "text": "Okay, here we go. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.19,
      "end_seconds": 167.74,
      "duration_seconds": 2.55,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.17,
      "end_seconds": 171.76,
      "duration_seconds": 3.59,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.73,
      "end_seconds": 183.84,
      "duration_seconds": 11.11,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.77,
      "end_seconds": 188.73,
      "duration_seconds": 3.96,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.06,
      "end_seconds": 190.82,
      "duration_seconds": 1.76,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.3,
      "end_seconds": 196.16,
      "duration_seconds": 3.86,
      "text": "Right, do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.82,
      "end_seconds": 209.0,
      "duration_seconds": 12.18,
      "text": "Oh, you know, not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.71,
      "end_seconds": 213.5,
      "duration_seconds": 3.79,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.96,
      "end_seconds": 221.99,
      "duration_seconds": 8.03,
      "text": "I've had an underactive thyroid for five years now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.44,
      "end_seconds": 229.94,
      "duration_seconds": 7.5,
      "text": "Yes, I can see the an underactive thyroid in your file as well. Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.74,
      "end_seconds": 236.96,
      "duration_seconds": 3.22,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 243.17,
      "duration_seconds": 3.84,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 245.79,
      "duration_seconds": 1.38,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.44,
      "end_seconds": 261.46,
      "duration_seconds": 5.02,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.01,
      "end_seconds": 263.71,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.55,
      "end_seconds": 276.95,
      "duration_seconds": 9.4,
      "text": "That's fine, you can get dressed. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.44,
      "end_seconds": 281.38,
      "duration_seconds": 2.94,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.05,
      "end_seconds": 282.81,
      "duration_seconds": 0.76,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.27,
      "end_seconds": 307.04,
      "duration_seconds": 14.77,
      "text": "Right, thanks for waiting. Putting it all together, this looks most like an early pregnancy. Let me just recap so I've got it right. You've had a missed period for about four days, moderate, and no fever or dizziness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.03,
      "end_seconds": 309.88,
      "duration_seconds": 1.85,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 311.12,
      "end_seconds": 314.51,
      "duration_seconds": 3.39,
      "text": "We've already done a pregnancy test this morning, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.9,
      "end_seconds": 337.94,
      "duration_seconds": 22.04,
      "text": "Okay, thanks, I'll look at that. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. A short walk every day, even twenty minutes, will help more than you'd think. Please don't sit on it if you have bleeding or sharp pain on one side. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.39,
      "end_seconds": 339.09,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.12,
      "end_seconds": 346.87,
      "duration_seconds": 6.75,
      "text": "Come back after the scan. Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.46,
      "end_seconds": 352.64,
      "duration_seconds": 4.18,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.96,
      "end_seconds": 357.39,
      "duration_seconds": 4.43,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.76,
      "end_seconds": 361.89,
      "duration_seconds": 3.13,
      "text": "Alright, um, thanks. Bye for now."
    }
  ]
}