{
  "schema_version": "1.0",
  "encounter_id": "00385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 3.76,
      "duration_seconds": 2.77,
      "text": "Good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.85,
      "end_seconds": 5.66,
      "duration_seconds": 0.81,
      "text": "Hi. Thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.82,
      "end_seconds": 11.22,
      "duration_seconds": 4.4,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.88,
      "end_seconds": 15.86,
      "duration_seconds": 3.98,
      "text": "Please do. Extra information is always welcome. Right, what's the trouble?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.82,
      "end_seconds": 20.06,
      "duration_seconds": 3.24,
      "text": "I mean, he's been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.53,
      "end_seconds": 27.13,
      "duration_seconds": 5.6,
      "text": "When did you first notice it? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.46,
      "end_seconds": 29.6,
      "duration_seconds": 1.14,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 40.21,
      "duration_seconds": 9.03,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.61,
      "end_seconds": 54.49,
      "duration_seconds": 13.88,
      "text": "Pretty moderate, if I'm being honest. I notice it more with standing in the sun. I kept putting it off, which I know isn't sensible. I did have muscle cramps at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.95,
      "end_seconds": 59.14,
      "duration_seconds": 3.19,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.7,
      "end_seconds": 60.4,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.26,
      "end_seconds": 71.11,
      "duration_seconds": 3.85,
      "text": "Right, thanks for waiting. Any fever, passing no urine or confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.99,
      "end_seconds": 74.47,
      "duration_seconds": 2.48,
      "text": "No, um, none of those."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.57,
      "end_seconds": 79.36,
      "duration_seconds": 3.79,
      "text": "Let me check a few things. Any chest pain or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.84,
      "end_seconds": 82.26,
      "duration_seconds": 2.42,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.42,
      "end_seconds": 86.57,
      "duration_seconds": 3.15,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.94,
      "end_seconds": 89.52,
      "duration_seconds": 1.58,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 94.08,
      "duration_seconds": 3.4,
      "text": "Okay, what medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 97.54,
      "duration_seconds": 2.12,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.91,
      "end_seconds": 102.6,
      "duration_seconds": 3.69,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.9,
      "end_seconds": 106.9,
      "duration_seconds": 4.0,
      "text": "I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.14,
      "end_seconds": 108.89,
      "duration_seconds": 0.75,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.21,
      "end_seconds": 112.19,
      "duration_seconds": 2.98,
      "text": "I've had COPD for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.96,
      "end_seconds": 114.05,
      "duration_seconds": 1.09,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.67,
      "end_seconds": 116.49,
      "duration_seconds": 1.82,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.15,
      "end_seconds": 120.97,
      "duration_seconds": 3.82,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.56,
      "end_seconds": 125.19,
      "duration_seconds": 2.63,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.19,
      "end_seconds": 130.2,
      "duration_seconds": 4.01,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.46,
      "end_seconds": 134.28,
      "duration_seconds": 2.82,
      "text": "No problem, uh, take your time."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.59,
      "end_seconds": 137.46,
      "duration_seconds": 1.87,
      "text": "Right, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.05,
      "end_seconds": 145.29,
      "duration_seconds": 3.24,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.65,
      "end_seconds": 147.62,
      "duration_seconds": 0.97,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.43,
      "end_seconds": 151.19,
      "duration_seconds": 2.76,
      "text": "I smoke about ten cigarettes a day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.57,
      "end_seconds": 153.91,
      "duration_seconds": 2.34,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.83,
      "end_seconds": 169.89,
      "duration_seconds": 2.06,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.68,
      "end_seconds": 184.56,
      "duration_seconds": 4.88,
      "text": "Okay: pulse 105, BP is 104 over 61, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.89,
      "end_seconds": 190.45,
      "duration_seconds": 3.56,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.46,
      "end_seconds": 192.16,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.8,
      "end_seconds": 196.24,
      "duration_seconds": 2.44,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.02,
      "end_seconds": 211.96,
      "duration_seconds": 2.94,
      "text": "Your skin is warm and a bit clammy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.13,
      "end_seconds": 214.76,
      "duration_seconds": 1.63,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.74,
      "end_seconds": 232.24,
      "duration_seconds": 1.5,
      "text": "Capillary refill is normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.78,
      "end_seconds": 245.24,
      "duration_seconds": 8.46,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.28,
      "end_seconds": 249.26,
      "duration_seconds": 2.98,
      "text": "Sorry, the computer needs a moment to load this."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.61,
      "end_seconds": 250.38,
      "duration_seconds": 0.77,
      "text": "No rush."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.48,
      "end_seconds": 274.8,
      "duration_seconds": 13.32,
      "text": "Okay, here we go. Putting it all together, I think we're dealing with heat exhaustion with some dehydration at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.28,
      "end_seconds": 277.58,
      "duration_seconds": 2.3,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 292.22,
      "duration_seconds": 14.14,
      "text": "Nothing I've seen today points to an emergency. It looks like heat exhaustion with some dehydration, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling faint, yesterday, moderate, and no chest pain or fainting."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.56,
      "end_seconds": 295.68,
      "duration_seconds": 2.12,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.57,
      "end_seconds": 321.65,
      "duration_seconds": 25.08,
      "text": "I'm going to order blood salts, for dehydration. I'd like you to take ORS, 1 sachet, three times a day, for two days. You take it by mouth. That's for dehydration. It's a commonly used medicine and most people tolerate it well. Avoid the midday sun for a few days and keep a water bottle with you. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.91,
      "end_seconds": 337.83,
      "duration_seconds": 14.92,
      "text": "Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. If you become confused or stop sweating, or you feel really unwell, please don't wait, come to the emergency department."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.28,
      "end_seconds": 340.52,
      "duration_seconds": 1.24,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.36,
      "end_seconds": 344.71,
      "duration_seconds": 3.35,
      "text": "I'd like to see you again in three days."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.93,
      "end_seconds": 347.54,
      "duration_seconds": 1.61,
      "text": "Okay, I'll book that."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.79,
      "end_seconds": 354.63,
      "duration_seconds": 5.84,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.61,
      "end_seconds": 359.38,
      "duration_seconds": 3.77,
      "text": "So, I come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.58,
      "end_seconds": 365.07,
      "duration_seconds": 4.49,
      "text": "Okay, yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.59,
      "end_seconds": 368.95,
      "duration_seconds": 3.36,
      "text": "That's everything I wanted to ask. Thank you."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.92,
      "end_seconds": 372.3,
      "duration_seconds": 2.38,
      "text": "Bye for now, look after yourself."
    }
  ]
}