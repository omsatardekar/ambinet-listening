{
  "schema_version": "1.0",
  "encounter_id": "00393",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 6.33,
      "duration_seconds": 5.44,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.98,
      "end_seconds": 10.33,
      "duration_seconds": 3.35,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.43,
      "end_seconds": 16.89,
      "duration_seconds": 5.46,
      "text": "Yeah, it's a weak urine stream. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.34,
      "end_seconds": 21.02,
      "duration_seconds": 1.68,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.42,
      "end_seconds": 29.05,
      "duration_seconds": 7.63,
      "text": "It's been about a year, I'm fairly sure. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.39,
      "end_seconds": 32.6,
      "duration_seconds": 3.21,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.19,
      "end_seconds": 45.26,
      "duration_seconds": 11.07,
      "text": "Pretty mild, if I'm being honest. Oh, and dribbling at the end. That's been about the same, four weeks. As for dribbling at the end, I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.71,
      "end_seconds": 49.87,
      "duration_seconds": 4.16,
      "text": "Has there been a feeling that the bladder doesn't empty too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.59,
      "end_seconds": 53.31,
      "duration_seconds": 2.72,
      "text": "Yes, about the same, two years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.91,
      "end_seconds": 56.63,
      "duration_seconds": 2.72,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.08,
      "end_seconds": 60.51,
      "duration_seconds": 1.43,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.98,
      "end_seconds": 65.44,
      "duration_seconds": 4.46,
      "text": "Let me check a few things. Any fever, back pain or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.01,
      "end_seconds": 68.12,
      "duration_seconds": 2.11,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.79,
      "end_seconds": 74.52,
      "duration_seconds": 2.73,
      "text": "Have you had any blood in the urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 79.52,
      "duration_seconds": 3.51,
      "text": "No, I haven't had any blood in the urine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.48,
      "end_seconds": 82.29,
      "duration_seconds": 1.81,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.5,
      "end_seconds": 87.14,
      "duration_seconds": 2.64,
      "text": "Um, no problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.11,
      "end_seconds": 92.37,
      "duration_seconds": 4.26,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.72,
      "end_seconds": 93.46,
      "duration_seconds": 0.74,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.5,
      "end_seconds": 111.97,
      "duration_seconds": 5.47,
      "text": "Alright, I've got it. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.27,
      "end_seconds": 112.99,
      "duration_seconds": 0.72,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.29,
      "end_seconds": 116.63,
      "duration_seconds": 2.34,
      "text": "Did you manage to eat before coming?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.55,
      "end_seconds": 120.43,
      "duration_seconds": 2.88,
      "text": "Yes, I had something small this morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.7,
      "end_seconds": 123.87,
      "duration_seconds": 2.17,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.86,
      "end_seconds": 129.4,
      "duration_seconds": 1.54,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.28,
      "end_seconds": 135.56,
      "duration_seconds": 5.28,
      "text": "Moving on to your background, any past medical history? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.23,
      "end_seconds": 143.9,
      "duration_seconds": 7.67,
      "text": "I have high blood pressure. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.48,
      "end_seconds": 154.75,
      "duration_seconds": 10.27,
      "text": "Right, so that's your known high blood pressure. We'll keep that in mind today. Let's go through your medication. What are you taking? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.3,
      "end_seconds": 160.23,
      "duration_seconds": 4.93,
      "text": "I take ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.46,
      "end_seconds": 173.7,
      "duration_seconds": 13.24,
      "text": "Alright. It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.34,
      "end_seconds": 175.88,
      "duration_seconds": 1.54,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.21,
      "end_seconds": 179.11,
      "duration_seconds": 1.9,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.95,
      "end_seconds": 192.99,
      "duration_seconds": 13.04,
      "text": "I had a hernia repair about five years back. I told myself I'd wait and see, and here I am. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.7,
      "end_seconds": 197.46,
      "duration_seconds": 3.76,
      "text": "Is it all right if a trainee sits in later? No? Fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.93,
      "end_seconds": 200.57,
      "duration_seconds": 2.64,
      "text": "I'd rather not, if you don't mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 207.2,
      "duration_seconds": 2.09,
      "text": "Right, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.57,
      "end_seconds": 211.24,
      "duration_seconds": 3.67,
      "text": "I have a couple of drinks on the weekend."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.05,
      "end_seconds": 214.08,
      "duration_seconds": 2.03,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.42,
      "end_seconds": 229.45,
      "duration_seconds": 2.03,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.18,
      "end_seconds": 256.79,
      "duration_seconds": 8.61,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 37.0 degrees, blood pressure 108 over 77. And pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.4,
      "end_seconds": 260.9,
      "duration_seconds": 2.5,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.48,
      "end_seconds": 265.04,
      "duration_seconds": 2.56,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.91,
      "end_seconds": 285.42,
      "duration_seconds": 3.51,
      "text": "Your bladder isn't palpable and the tummy is soft."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.14,
      "end_seconds": 299.02,
      "duration_seconds": 9.88,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.55,
      "end_seconds": 302.53,
      "duration_seconds": 2.98,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.42,
      "end_seconds": 304.14,
      "duration_seconds": 0.72,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.32,
      "end_seconds": 321.24,
      "duration_seconds": 7.92,
      "text": "Right, thanks for waiting. Okay, so my impression is this: It fits best with an enlarged prostate causing urinary symptoms."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.92,
      "end_seconds": 324.63,
      "duration_seconds": 2.71,
      "text": "Is this going to go away?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.69,
      "end_seconds": 344.7,
      "duration_seconds": 19.01,
      "text": "I can't promise yet, but most people with an enlarged prostate causing urinary symptoms do well once it's treated properly. Let me just recap so I've got it right. You've had a weak urine stream for about a year, mild, and no blood in the urine or weight loss."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.51,
      "end_seconds": 347.78,
      "duration_seconds": 2.27,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.04,
      "end_seconds": 357.39,
      "duration_seconds": 8.35,
      "text": "We should do an ultrasound of the bladder and prostate for urinary symptoms. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.69,
      "end_seconds": 359.03,
      "duration_seconds": 1.34,
      "text": "Okay, that's fine."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.95,
      "end_seconds": 368.5,
      "duration_seconds": 8.55,
      "text": "Let's get kidney function tests, for urinary symptoms. Let's use tamsulosin, 0.4 milligrams, at night, for four weeks. That should help with urinary symptoms."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.98,
      "end_seconds": 371.81,
      "duration_seconds": 2.83,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.62,
      "end_seconds": 377.56,
      "duration_seconds": 4.94,
      "text": "Cut back on tea and coffee after the afternoon and go before you sleep."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.11,
      "end_seconds": 381.52,
      "duration_seconds": 3.41,
      "text": "Go on. I'll also refer you to the urology clinic."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.24,
      "end_seconds": 384.2,
      "duration_seconds": 1.96,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.91,
      "end_seconds": 394.64,
      "duration_seconds": 9.73,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse. Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.82,
      "end_seconds": 396.52,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.87,
      "end_seconds": 400.97,
      "duration_seconds": 4.1,
      "text": "Okay, summarise it for me, what's the plan from your side?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.43,
      "end_seconds": 411.36,
      "duration_seconds": 8.93,
      "text": "So, I take the tamsulosin, 0.4 milligrams, at night and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.21,
      "end_seconds": 417.03,
      "duration_seconds": 4.82,
      "text": "Yes, exactly right. Wonderful, I think that's it. Ask me anything before you go."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.09,
      "end_seconds": 421.02,
      "duration_seconds": 2.93,
      "text": "That's all, thank you for your time."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.97,
      "end_seconds": 425.12,
      "duration_seconds": 1.15,
      "text": "See you then."
    }
  ]
}