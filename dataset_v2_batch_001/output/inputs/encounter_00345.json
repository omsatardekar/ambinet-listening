{
  "schema_version": "1.0",
  "encounter_id": "00345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 3.03,
      "duration_seconds": 2.12,
      "text": "So, hello. Right, let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.53,
      "end_seconds": 4.41,
      "duration_seconds": 0.88,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.78,
      "end_seconds": 10.86,
      "duration_seconds": 5.08,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.39,
      "end_seconds": 16.86,
      "duration_seconds": 5.47,
      "text": "Please do. Extra information is always welcome. Did the receptionist sort you out quickly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.8,
      "end_seconds": 21.79,
      "duration_seconds": 3.99,
      "text": "Oh, uh, yes, she was lovely about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.13,
      "end_seconds": 24.76,
      "duration_seconds": 2.63,
      "text": "Alright, tell me what's been troubling you."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.12,
      "end_seconds": 29.83,
      "duration_seconds": 4.71,
      "text": "He's been having puffiness around the eyes in the morning, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.86,
      "end_seconds": 34.03,
      "duration_seconds": 3.17,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.32,
      "end_seconds": 44.59,
      "duration_seconds": 9.27,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.9,
      "end_seconds": 46.58,
      "duration_seconds": 1.68,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.84,
      "end_seconds": 49.09,
      "duration_seconds": 1.25,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.68,
      "end_seconds": 54.84,
      "duration_seconds": 5.16,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 54.94,
      "end_seconds": 59.9,
      "duration_seconds": 4.96,
      "text": "Yeah, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.82,
      "end_seconds": 67.16,
      "duration_seconds": 6.34,
      "text": "I was getting to that! Oh, and tiredness. That's been about the same, about a year."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.7,
      "end_seconds": 75.32,
      "duration_seconds": 7.62,
      "text": "Right. Alright, have you had puffiness around the eyes in the morning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.63,
      "end_seconds": 80.33,
      "duration_seconds": 4.7,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 81.35,
      "end_seconds": 83.32,
      "duration_seconds": 1.97,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.69,
      "end_seconds": 88.4,
      "duration_seconds": 3.71,
      "text": "Okay, have you had any nausea, breathlessness or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.77,
      "end_seconds": 100.3,
      "duration_seconds": 11.53,
      "text": "No, no nausea, no breathlessness, no chest pain. I did have swelling in the ankles at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.75,
      "end_seconds": 104.92,
      "duration_seconds": 3.17,
      "text": "Have you had any fever or reduced urine output?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.14,
      "end_seconds": 108.57,
      "duration_seconds": 2.43,
      "text": "No, none of that at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 112.56,
      "duration_seconds": 2.5,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.1,
      "end_seconds": 114.79,
      "duration_seconds": 1.69,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.6,
      "end_seconds": 117.8,
      "duration_seconds": 2.2,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.68,
      "end_seconds": 123.21,
      "duration_seconds": 2.53,
      "text": "No, uh, skin's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.94,
      "end_seconds": 141.02,
      "duration_seconds": 17.08,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.41,
      "end_seconds": 144.84,
      "duration_seconds": 2.43,
      "text": "I, I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.51,
      "end_seconds": 149.04,
      "duration_seconds": 3.53,
      "text": "What about family history, any illnesses that run in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 153.84,
      "duration_seconds": 3.71,
      "text": "My uncle had colon cancer. So, my mother has migraines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.7,
      "end_seconds": 158.45,
      "duration_seconds": 3.75,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.67,
      "end_seconds": 162.15,
      "duration_seconds": 2.48,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.72,
      "end_seconds": 165.45,
      "duration_seconds": 2.73,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.92,
      "end_seconds": 166.78,
      "duration_seconds": 0.86,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.95,
      "end_seconds": 183.03,
      "duration_seconds": 3.08,
      "text": "Right, thanks for waiting. Any operations in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.62,
      "end_seconds": 193.88,
      "duration_seconds": 9.26,
      "text": "Yes, I had a stent put in my heart, two years ago. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.26,
      "end_seconds": 197.73,
      "duration_seconds": 3.47,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.68,
      "end_seconds": 208.15,
      "duration_seconds": 8.47,
      "text": "Hmm, uh, it's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 210.8,
      "duration_seconds": 2.34,
      "text": "Okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.82,
      "end_seconds": 222.34,
      "duration_seconds": 10.52,
      "text": "For my blood pressure, I believe. My wife sets them out for me, I just take what I'm given. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 223.21,
      "end_seconds": 230.81,
      "duration_seconds": 7.6,
      "text": "Doctor, I think the last prescription for the clopidogrel was 150 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.73,
      "end_seconds": 234.45,
      "duration_seconds": 2.72,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.9,
      "end_seconds": 239.26,
      "duration_seconds": 3.36,
      "text": "No, uh, I left it at home."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.76,
      "end_seconds": 244.67,
      "duration_seconds": 3.91,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.18,
      "end_seconds": 254.85,
      "duration_seconds": 8.67,
      "text": "Kidney disease, for five years. High blood pressure, for five years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.91,
      "end_seconds": 256.69,
      "duration_seconds": 0.78,
      "text": "I see."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.46,
      "end_seconds": 259.14,
      "duration_seconds": 1.68,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.64,
      "end_seconds": 272.24,
      "duration_seconds": 11.6,
      "text": "Right, so that's your known kidney disease. We'll keep that in mind today. Okay, high blood pressure, that's already on your record. Good to know. Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.96,
      "end_seconds": 275.1,
      "duration_seconds": 2.14,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.23,
      "end_seconds": 280.43,
      "duration_seconds": 2.2,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.0,
      "end_seconds": 294.25,
      "duration_seconds": 1.25,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.8,
      "end_seconds": 319.12,
      "duration_seconds": 8.32,
      "text": "Okay: respiratory rate 17, temperature 36.5, oxygen saturation is 99 percent. And pressure 168 over 95, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.67,
      "end_seconds": 320.79,
      "duration_seconds": 1.12,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.06,
      "end_seconds": 324.58,
      "duration_seconds": 2.52,
      "text": "We'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.05,
      "end_seconds": 330.18,
      "duration_seconds": 4.13,
      "text": "Alright, I'd like to examine you now. Please come over here."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.44,
      "end_seconds": 333.22,
      "duration_seconds": 1.78,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.4,
      "end_seconds": 347.34,
      "duration_seconds": 5.94,
      "text": "There's pitting swelling at both ankles, and your blood pressure is on the high side."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.59,
      "end_seconds": 378.93,
      "duration_seconds": 28.34,
      "text": "All done, thank you, please sit down. Right, here's what I'm thinking. I think we're dealing with progression of the kidney problem at this stage. I want to be honest that this is an impression, not a final answer. A medication effect on the kidneys is also on my list. Let me just recap so I've got it right. You've had puffiness around the eyes in the morning, mild, and no breathlessness or chest pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.49,
      "end_seconds": 382.72,
      "duration_seconds": 2.23,
      "text": "Exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.84,
      "end_seconds": 388.49,
      "duration_seconds": 4.65,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.07,
      "end_seconds": 401.9,
      "duration_seconds": 9.83,
      "text": "Okay, so yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.49,
      "end_seconds": 412.99,
      "duration_seconds": 8.5,
      "text": "I'm going to order a urine protein test, for chronic kidney disease. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 414.57,
      "end_seconds": 416.57,
      "duration_seconds": 2.0,
      "text": "The earliest is Tuesday, 9 am."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 417.9,
      "end_seconds": 420.66,
      "duration_seconds": 2.76,
      "text": "Okay, um, I'll be there."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 421.59,
      "end_seconds": 433.16,
      "duration_seconds": 11.57,
      "text": "I'd like to arrange an ultrasound of the kidneys for chronic kidney disease. The result will help us decide whether anything more is needed. Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 433.77,
      "end_seconds": 440.13,
      "duration_seconds": 6.36,
      "text": "Hmm, I did have kidney function tests done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 440.93,
      "end_seconds": 458.11,
      "duration_seconds": 17.18,
      "text": "Stay off anti-inflammatory painkillers like diclofenac or ibuprofen, they're hard on the kidneys. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 463.06,
      "end_seconds": 464.33,
      "duration_seconds": 1.27,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 465.29,
      "end_seconds": 472.65,
      "duration_seconds": 7.36,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 473.24,
      "end_seconds": 474.92,
      "duration_seconds": 1.68,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 475.74,
      "end_seconds": 478.84,
      "duration_seconds": 3.1,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 482.14,
      "end_seconds": 484.86,
      "duration_seconds": 2.72,
      "text": "Okay, uh, I'll book that."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 485.21,
      "end_seconds": 490.0,
      "duration_seconds": 4.79,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 491.5,
      "end_seconds": 495.22,
      "duration_seconds": 3.72,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 496.39,
      "end_seconds": 501.42,
      "duration_seconds": 5.03,
      "text": "Yes, exactly right. I think we've covered it. Do you have any questions?"
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 502.99,
      "end_seconds": 505.46,
      "duration_seconds": 2.47,
      "text": "Uh, no questions. Thank you."
    }
  ]
}