{
  "schema_version": "1.0",
  "encounter_id": "00120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.54,
      "duration_seconds": 3.86,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.9,
      "end_seconds": 9.52,
      "duration_seconds": 4.62,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.5,
      "end_seconds": 14.42,
      "duration_seconds": 3.92,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.9,
      "end_seconds": 18.21,
      "duration_seconds": 2.31,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.17,
      "end_seconds": 22.61,
      "duration_seconds": 3.44,
      "text": "We came because of pressure in the face."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.67,
      "end_seconds": 25.84,
      "duration_seconds": 2.17,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.35,
      "end_seconds": 29.38,
      "duration_seconds": 3.03,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.86,
      "end_seconds": 32.76,
      "duration_seconds": 2.9,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.41,
      "end_seconds": 41.45,
      "duration_seconds": 5.04,
      "text": "Yeah, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.99,
      "end_seconds": 44.49,
      "duration_seconds": 2.5,
      "text": "Have you found anything that eases it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.85,
      "end_seconds": 47.57,
      "duration_seconds": 2.72,
      "text": "Only steam, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.91,
      "end_seconds": 50.47,
      "duration_seconds": 2.56,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.07,
      "end_seconds": 54.14,
      "duration_seconds": 3.07,
      "text": "Yes, bending forward. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.36,
      "end_seconds": 58.57,
      "duration_seconds": 3.21,
      "text": "Okay, anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.08,
      "end_seconds": 65.37,
      "duration_seconds": 5.29,
      "text": "When it starts I tend to get reduced sense of smell as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.18,
      "end_seconds": 69.78,
      "duration_seconds": 3.6,
      "text": "What about a blocked nose, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.04,
      "end_seconds": 76.5,
      "duration_seconds": 5.46,
      "text": "Yeah, that too. The reduced sense of smell? That's been for two days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.28,
      "end_seconds": 82.13,
      "duration_seconds": 4.85,
      "text": "Let me check a few things. Any swelling around the eyes or ear pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.55,
      "end_seconds": 85.6,
      "duration_seconds": 2.05,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.73,
      "end_seconds": 87.83,
      "duration_seconds": 1.1,
      "text": "What about fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.2,
      "end_seconds": 89.76,
      "duration_seconds": 1.56,
      "text": "No fever, thank goodness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 90.74,
      "end_seconds": 94.73,
      "duration_seconds": 3.99,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.11,
      "end_seconds": 100.32,
      "duration_seconds": 5.21,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.79,
      "end_seconds": 108.59,
      "duration_seconds": 6.8,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you had any vision changes or stiff neck?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.19,
      "end_seconds": 111.83,
      "duration_seconds": 1.64,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.82,
      "end_seconds": 113.59,
      "duration_seconds": 0.77,
      "text": "Any nosebleeds?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.72,
      "end_seconds": 116.67,
      "duration_seconds": 1.95,
      "text": "Not at all, no nosebleeds."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.26,
      "end_seconds": 120.52,
      "duration_seconds": 2.26,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.91,
      "end_seconds": 122.28,
      "duration_seconds": 1.37,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.14,
      "end_seconds": 131.92,
      "duration_seconds": 6.78,
      "text": "Okay, what medicines are you taking at the moment? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.59,
      "end_seconds": 139.12,
      "duration_seconds": 6.53,
      "text": "Seretide inhaler. I take it twice a day. Hydrocortisone cream, when needed. Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.06,
      "end_seconds": 148.27,
      "duration_seconds": 8.21,
      "text": "Doctor, I think the last prescription for the paracetamol was 250 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.26,
      "end_seconds": 152.45,
      "duration_seconds": 3.19,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.99,
      "end_seconds": 157.21,
      "duration_seconds": 3.22,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.92,
      "end_seconds": 160.28,
      "duration_seconds": 2.36,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.6,
      "end_seconds": 161.34,
      "duration_seconds": 0.74,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.44,
      "end_seconds": 173.92,
      "duration_seconds": 2.48,
      "text": "Right, thanks for waiting. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.26,
      "end_seconds": 175.89,
      "duration_seconds": 1.63,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.39,
      "end_seconds": 180.27,
      "duration_seconds": 3.88,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.86,
      "end_seconds": 184.87,
      "duration_seconds": 3.01,
      "text": "Ibuprofen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.36,
      "end_seconds": 188.57,
      "duration_seconds": 2.21,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.03,
      "end_seconds": 189.84,
      "duration_seconds": 0.81,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.5,
      "end_seconds": 203.13,
      "duration_seconds": 5.63,
      "text": "Right, thanks for waiting. Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.62,
      "end_seconds": 212.75,
      "duration_seconds": 9.13,
      "text": "I've had asthma, yes. I have eczema. It's the not knowing that gets to me. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.88,
      "end_seconds": 215.0,
      "duration_seconds": 1.12,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.43,
      "end_seconds": 222.53,
      "duration_seconds": 5.1,
      "text": "Okay, eczema, that's already on your record. Good to know. What about alcohol?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.68,
      "end_seconds": 227.14,
      "duration_seconds": 3.46,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.11,
      "end_seconds": 233.98,
      "duration_seconds": 2.87,
      "text": "Let's get your blood pressure and the other basics."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.52,
      "end_seconds": 248.07,
      "duration_seconds": 1.55,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.87,
      "end_seconds": 273.93,
      "duration_seconds": 7.06,
      "text": "Okay: pulse 85, BP is 121 over 79, temp 36.4 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.32,
      "end_seconds": 276.53,
      "duration_seconds": 1.21,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.76,
      "end_seconds": 283.72,
      "duration_seconds": 5.96,
      "text": "We'll put it in context in a moment. So, is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.02,
      "end_seconds": 288.47,
      "duration_seconds": 2.45,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.15,
      "end_seconds": 294.17,
      "duration_seconds": 3.02,
      "text": "I'll examine you now, so please bear with me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.47,
      "end_seconds": 298.91,
      "duration_seconds": 3.44,
      "text": "Okay, a little pressure here, tell me if it's tender."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.52,
      "end_seconds": 313.43,
      "duration_seconds": 3.91,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.87,
      "end_seconds": 317.34,
      "duration_seconds": 2.47,
      "text": "I'll just listen to your chest now."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.09,
      "end_seconds": 331.45,
      "duration_seconds": 2.36,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.38,
      "end_seconds": 355.96,
      "duration_seconds": 21.58,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Putting it all together, I think we're dealing with sinusitis at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep allergic rhinitis in mind."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.76,
      "end_seconds": 370.01,
      "duration_seconds": 9.25,
      "text": "Let me just recap so I've got it right. You've had pressure in the face, since last weekend, and no swelling around the eyes or vision changes."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.07,
      "end_seconds": 372.39,
      "duration_seconds": 1.32,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.34,
      "end_seconds": 390.22,
      "duration_seconds": 16.88,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.22,
      "end_seconds": 393.07,
      "duration_seconds": 1.85,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.95,
      "end_seconds": 419.74,
      "duration_seconds": 25.79,
      "text": "We should do an X-ray of the sinuses for sinusitis. Let's use saline nasal spray, three times a day, for one week. It's for nasal congestion. The pharmacy will go through the details again when you pick it up. Steam a couple of times a day and saline rinses will help clear things. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.48,
      "end_seconds": 434.75,
      "duration_seconds": 12.27,
      "text": "Don't skip meals, and try to eat smaller portions more often through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 435.8,
      "end_seconds": 437.19,
      "duration_seconds": 1.39,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.14,
      "end_seconds": 444.17,
      "duration_seconds": 6.03,
      "text": "I want you to come back or go to emergency straight away if the symptoms get worse."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.89,
      "end_seconds": 446.18,
      "duration_seconds": 1.29,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 446.72,
      "end_seconds": 456.25,
      "duration_seconds": 9.53,
      "text": "Please come and see me if it's not better in a week. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.82,
      "end_seconds": 463.71,
      "duration_seconds": 5.89,
      "text": "So, I come back if it's not better in a week. Is that right?"
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.68,
      "end_seconds": 469.11,
      "duration_seconds": 4.43,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 469.54,
      "end_seconds": 473.48,
      "duration_seconds": 3.94,
      "text": "I think that's clear. Thank you for being so thorough."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 477.16,
      "end_seconds": 478.11,
      "duration_seconds": 0.95,
      "text": "See you then."
    }
  ]
}