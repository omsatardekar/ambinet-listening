{
  "schema_version": "1.0",
  "encounter_id": "00458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.75,
      "duration_seconds": 3.45,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.02,
      "end_seconds": 9.38,
      "duration_seconds": 3.36,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.76,
      "end_seconds": 15.56,
      "duration_seconds": 5.8,
      "text": "Hmm, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.89,
      "end_seconds": 22.28,
      "duration_seconds": 5.39,
      "text": "I've been feeling cold all the time, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.66,
      "end_seconds": 24.53,
      "duration_seconds": 1.87,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.26,
      "end_seconds": 43.77,
      "duration_seconds": 15.51,
      "text": "It's been two months now. There's tiredness as well. I've also had dry skin, for three weeks. As for dry skin, moisturiser helps a bit. Oh, and constipation. That's been about the same, four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.06,
      "end_seconds": 48.01,
      "duration_seconds": 2.95,
      "text": "Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.48,
      "end_seconds": 60.47,
      "duration_seconds": 10.99,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.96,
      "end_seconds": 65.61,
      "duration_seconds": 3.65,
      "text": "Have you had any low mood, palpitations or heavy periods?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.08,
      "end_seconds": 68.09,
      "duration_seconds": 2.01,
      "text": "No. None of those, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 75.94,
      "duration_seconds": 6.28,
      "text": "Let me check a few things. Any hair loss, swelling in the neck or trouble swallowing?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.35,
      "end_seconds": 84.58,
      "duration_seconds": 5.23,
      "text": "No, no hair loss, swelling in the neck or trouble swallowing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 86.91,
      "duration_seconds": 1.98,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.55,
      "end_seconds": 89.58,
      "duration_seconds": 2.03,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.09,
      "end_seconds": 93.81,
      "duration_seconds": 2.72,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.01,
      "end_seconds": 96.56,
      "duration_seconds": 1.55,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.18,
      "end_seconds": 102.9,
      "duration_seconds": 5.72,
      "text": "Let's go through your medication. What are you taking? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 103.53,
      "end_seconds": 112.38,
      "duration_seconds": 8.85,
      "text": "She is on iron tablets, once a day, I give it to her. Okay, so it's Asthalin inhaler, when needed, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.97,
      "end_seconds": 119.22,
      "duration_seconds": 2.25,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.3,
      "end_seconds": 124.34,
      "duration_seconds": 4.04,
      "text": "I had my appendix out about eight years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.69,
      "end_seconds": 128.96,
      "duration_seconds": 3.27,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.78,
      "end_seconds": 133.28,
      "duration_seconds": 3.5,
      "text": "My uncle had colon cancer. My mother has diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.32,
      "end_seconds": 136.92,
      "duration_seconds": 2.6,
      "text": "Let me know if I'm going too fast."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.2,
      "end_seconds": 139.55,
      "duration_seconds": 1.35,
      "text": "No, you're fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.78,
      "end_seconds": 144.53,
      "duration_seconds": 3.75,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.0,
      "end_seconds": 147.69,
      "duration_seconds": 2.69,
      "text": "Low haemoglobin, for about ten years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.52,
      "end_seconds": 149.51,
      "duration_seconds": 0.99,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.82,
      "end_seconds": 152.52,
      "duration_seconds": 1.7,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.35,
      "end_seconds": 161.58,
      "duration_seconds": 8.23,
      "text": "Yes, I can see the low haemoglobin in your file as well. Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.83,
      "end_seconds": 166.69,
      "duration_seconds": 3.86,
      "text": "Right, mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.83,
      "end_seconds": 171.65,
      "duration_seconds": 3.82,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.38,
      "end_seconds": 183.7,
      "duration_seconds": 11.32,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.06,
      "end_seconds": 188.66,
      "duration_seconds": 3.6,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.52,
      "end_seconds": 190.22,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.99,
      "end_seconds": 205.64,
      "duration_seconds": 1.65,
      "text": "Right, thanks for waiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.04,
      "end_seconds": 209.72,
      "duration_seconds": 2.68,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.7,
      "end_seconds": 212.39,
      "duration_seconds": 1.69,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.24,
      "end_seconds": 224.66,
      "duration_seconds": 2.42,
      "text": "Reflexes are a bit slow to relax."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.28,
      "end_seconds": 228.52,
      "duration_seconds": 2.24,
      "text": "Can you lie back for me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.09,
      "end_seconds": 251.58,
      "duration_seconds": 4.49,
      "text": "Your pulse is slow, about fifty-six, and the thyroid isn't enlarged."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.35,
      "end_seconds": 281.74,
      "duration_seconds": 27.39,
      "text": "That's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.25,
      "end_seconds": 283.95,
      "duration_seconds": 1.7,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.65,
      "end_seconds": 299.17,
      "duration_seconds": 14.52,
      "text": "Right, here's what I'm thinking. My working impression is an underactive thyroid. I'd also keep depression in mind. Let me just recap so I've got it right. You've been feeling cold all the time for two months, and no heavy periods or swelling in the neck."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.52,
      "end_seconds": 302.36,
      "duration_seconds": 1.84,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.17,
      "end_seconds": 307.4,
      "duration_seconds": 4.23,
      "text": "Bear with me, I need to finish this line in the notes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.34,
      "end_seconds": 337.2,
      "duration_seconds": 15.86,
      "text": "That's saved, thanks for waiting. We should do blood tests for fatigue. That will help us see what's going on underneath and decide the next step. Let's get a thyroid test, for hypothyroid symptoms. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.79,
      "end_seconds": 339.76,
      "duration_seconds": 0.97,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.73,
      "end_seconds": 347.29,
      "duration_seconds": 6.56,
      "text": "I'm prescribing levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. That should help with hypothyroidism."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.98,
      "end_seconds": 349.56,
      "duration_seconds": 1.58,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.84,
      "end_seconds": 371.92,
      "duration_seconds": 19.08,
      "text": "Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.48,
      "end_seconds": 375.96,
      "duration_seconds": 2.48,
      "text": "Uh, got it, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.87,
      "end_seconds": 385.28,
      "duration_seconds": 8.41,
      "text": "Please come and see me in six weeks. Alright, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.84,
      "end_seconds": 395.51,
      "duration_seconds": 9.67,
      "text": "So, I take the levothyroxine, 50 micrograms, every morning on an empty stomach and come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.53,
      "end_seconds": 401.71,
      "duration_seconds": 5.18,
      "text": "Yes, exactly right. Good. Call the clinic if you need us in the meantime."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.97,
      "end_seconds": 407.69,
      "duration_seconds": 4.72,
      "text": "Okay, so okay, thank you. I'll get started on all of that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.27,
      "end_seconds": 410.29,
      "duration_seconds": 2.02,
      "text": "Bye for now, look after yourself."
    }
  ]
}