{
  "schema_version": "1.0",
  "encounter_id": "00098",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 3.57,
      "duration_seconds": 2.97,
      "text": "Sorry I'm a few minutes behind, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.44,
      "end_seconds": 8.22,
      "duration_seconds": 3.78,
      "text": "No trouble at all, come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 8.58,
      "end_seconds": 10.98,
      "duration_seconds": 2.4,
      "text": "I've been feeling low most days."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.15,
      "end_seconds": 16.93,
      "duration_seconds": 4.78,
      "text": "How long have you had it? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.69,
      "end_seconds": 19.95,
      "duration_seconds": 2.26,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.62,
      "end_seconds": 23.48,
      "duration_seconds": 2.86,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.75,
      "end_seconds": 32.99,
      "duration_seconds": 8.24,
      "text": "Hmm, pretty mild, if I'm being honest. Oh, and trouble sleeping. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.76,
      "end_seconds": 37.64,
      "duration_seconds": 3.88,
      "text": "Have you had any periods of unusually high energy or panic attacks?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 39.82,
      "duration_seconds": 1.86,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.91,
      "end_seconds": 41.9,
      "duration_seconds": 0.99,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.88,
      "end_seconds": 47.17,
      "duration_seconds": 1.29,
      "text": "No, nothing regular."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.6,
      "end_seconds": 50.88,
      "duration_seconds": 3.28,
      "text": "Sorry about the noise outside, the building work never stops."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.02,
      "end_seconds": 54.04,
      "duration_seconds": 2.02,
      "text": "I hadn't even noticed, honestly."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.15,
      "end_seconds": 57.25,
      "duration_seconds": 2.1,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.57,
      "end_seconds": 61.75,
      "duration_seconds": 3.18,
      "text": "Just a knee arthroscopy, three years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.69,
      "end_seconds": 65.67,
      "duration_seconds": 2.98,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.36,
      "end_seconds": 67.08,
      "duration_seconds": 0.72,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.8,
      "end_seconds": 84.71,
      "duration_seconds": 2.91,
      "text": "Alright, I've got it. So, how about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.05,
      "end_seconds": 88.15,
      "duration_seconds": 3.1,
      "text": "I smoke, yes, around five a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.12,
      "end_seconds": 93.21,
      "duration_seconds": 4.09,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.55,
      "end_seconds": 97.9,
      "duration_seconds": 3.35,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.32,
      "end_seconds": 104.76,
      "duration_seconds": 6.44,
      "text": "Do you have any medical conditions I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.14,
      "end_seconds": 107.83,
      "duration_seconds": 2.69,
      "text": "No, nothing, I've generally been healthy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.52,
      "end_seconds": 112.07,
      "duration_seconds": 3.55,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.59,
      "end_seconds": 113.34,
      "duration_seconds": 0.75,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.71,
      "end_seconds": 131.87,
      "duration_seconds": 4.16,
      "text": "Okay, here we go. Do you have any known allergies at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.23,
      "end_seconds": 134.69,
      "duration_seconds": 2.46,
      "text": "No, none that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.08,
      "end_seconds": 151.75,
      "duration_seconds": 15.67,
      "text": "Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.39,
      "end_seconds": 156.18,
      "duration_seconds": 1.79,
      "text": "Okay, that makes sense."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.71,
      "end_seconds": 159.8,
      "duration_seconds": 2.09,
      "text": "Okay, let's do a quick examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.48,
      "end_seconds": 161.18,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 165.27,
      "duration_seconds": 3.11,
      "text": "Tell me if anything hurts as I press."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.92,
      "end_seconds": 187.74,
      "duration_seconds": 3.82,
      "text": "You're well kempt and speaking clearly, and you maintain good eye contact."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 204.14,
      "duration_seconds": 10.91,
      "text": "That's fine, you can get dressed. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.7,
      "end_seconds": 208.06,
      "duration_seconds": 2.36,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.25,
      "end_seconds": 213.6,
      "duration_seconds": 4.35,
      "text": "Putting it all together, my working impression is a depressive episode."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.06,
      "end_seconds": 219.68,
      "duration_seconds": 2.62,
      "text": "Doctor, you know, is this dangerous?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.13,
      "end_seconds": 237.04,
      "duration_seconds": 15.91,
      "text": "Nothing I've seen today points to an emergency. It looks like a depressive episode, but I'd like to confirm. Let me just recap so I've got it right. You've been feeling low most days for about three months, mild, and no panic attacks or periods of unusually high energy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.72,
      "end_seconds": 243.45,
      "duration_seconds": 2.73,
      "text": "I mean, yes, you've got it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.47,
      "end_seconds": 256.85,
      "duration_seconds": 12.38,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.71,
      "end_seconds": 259.92,
      "duration_seconds": 2.21,
      "text": "Yeah, that's reassuring to hear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.95,
      "end_seconds": 268.36,
      "duration_seconds": 7.41,
      "text": "Let's get a thyroid test, for low mood. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 269.4,
      "end_seconds": 273.66,
      "duration_seconds": 4.26,
      "text": "We have a slot Thursday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.54,
      "end_seconds": 286.12,
      "duration_seconds": 11.58,
      "text": "I'm prescribing sertraline, 25 milligrams, once a day, for one week then review. You take it by mouth. That's for depression. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.9,
      "end_seconds": 289.42,
      "duration_seconds": 2.52,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.33,
      "end_seconds": 319.48,
      "duration_seconds": 29.15,
      "text": "It usually takes a few weeks for the tablet to start helping, so give it time and stay in touch. Try to keep some routine, a bit of daylight and a short walk each day. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I want you to come back or go to emergency straight away if you have thoughts of harming yourself."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.65,
      "end_seconds": 321.93,
      "duration_seconds": 1.28,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.26,
      "end_seconds": 329.58,
      "duration_seconds": 7.32,
      "text": "Please come and see me in four weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.76,
      "end_seconds": 339.19,
      "duration_seconds": 8.43,
      "text": "So, I take the sertraline, 25 milligrams, once a day and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.55,
      "end_seconds": 345.84,
      "duration_seconds": 5.29,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.27,
      "end_seconds": 348.83,
      "duration_seconds": 2.56,
      "text": "Thank you. I'll see you then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.24,
      "end_seconds": 351.71,
      "duration_seconds": 1.47,
      "text": "Alright, see you then."
    }
  ]
}