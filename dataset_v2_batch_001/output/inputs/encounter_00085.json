{
  "schema_version": "1.0",
  "encounter_id": "00085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.69,
      "end_seconds": 3.32,
      "duration_seconds": 2.63,
      "text": "Good morning. Come in, have a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.22,
      "end_seconds": 7.81,
      "duration_seconds": 3.59,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 16.95,
      "duration_seconds": 7.55,
      "text": "That's fine, sit down. We'll go through it together. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.53,
      "end_seconds": 22.38,
      "duration_seconds": 4.85,
      "text": "Okay, so I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.94,
      "end_seconds": 24.85,
      "duration_seconds": 1.91,
      "text": "What seems to be the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 29.61,
      "duration_seconds": 3.73,
      "text": "I mean, I'm here because of pressure in the face."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.82,
      "end_seconds": 32.79,
      "duration_seconds": 1.97,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.09,
      "end_seconds": 36.78,
      "duration_seconds": 2.69,
      "text": "Uh, it's been two days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.74,
      "end_seconds": 40.29,
      "duration_seconds": 2.55,
      "text": "Do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.62,
      "end_seconds": 43.77,
      "duration_seconds": 3.15,
      "text": "Right, yes, bending forward. That makes it worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.27,
      "end_seconds": 49.8,
      "duration_seconds": 5.53,
      "text": "Right, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 49.9,
      "end_seconds": 56.05,
      "duration_seconds": 6.15,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.49,
      "end_seconds": 59.63,
      "duration_seconds": 2.14,
      "text": "So, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.05,
      "end_seconds": 67.41,
      "duration_seconds": 7.36,
      "text": "Oh, uh, and a headache over my forehead. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.41,
      "end_seconds": 73.0,
      "duration_seconds": 4.59,
      "text": "Have you had pressure in the face before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.46,
      "end_seconds": 79.0,
      "duration_seconds": 4.54,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.34,
      "end_seconds": 82.28,
      "duration_seconds": 1.94,
      "text": "Have you had any stiff neck?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 82.72,
      "end_seconds": 85.19,
      "duration_seconds": 2.47,
      "text": "Not at all, no stiff neck."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.07,
      "end_seconds": 90.8,
      "duration_seconds": 4.73,
      "text": "Have you had any ear pain, swelling around the eyes, nosebleeds or vision changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.8,
      "end_seconds": 102.96,
      "duration_seconds": 11.16,
      "text": "Yeah, no, no ear pain, no swelling around the eyes, no nosebleeds. I did have a blocked nose at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.17,
      "end_seconds": 107.86,
      "duration_seconds": 1.69,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.88,
      "end_seconds": 110.49,
      "duration_seconds": 1.61,
      "text": "No fever, thank goodness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 111.88,
      "end_seconds": 116.77,
      "duration_seconds": 4.89,
      "text": "I mean, actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.31,
      "end_seconds": 123.47,
      "duration_seconds": 5.16,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.83,
      "end_seconds": 132.51,
      "duration_seconds": 7.68,
      "text": "Alright, I'll note both what you've said and what you've noticed. How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.92,
      "end_seconds": 136.22,
      "duration_seconds": 2.3,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.78,
      "end_seconds": 141.17,
      "duration_seconds": 3.39,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.43,
      "end_seconds": 143.78,
      "duration_seconds": 1.35,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.36,
      "end_seconds": 145.06,
      "duration_seconds": 0.7,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.91,
      "end_seconds": 148.62,
      "duration_seconds": 2.71,
      "text": "No, I don't smoke and never have."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.14,
      "end_seconds": 152.95,
      "duration_seconds": 2.81,
      "text": "Right, any allergies I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.97,
      "end_seconds": 162.52,
      "duration_seconds": 8.55,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.11,
      "end_seconds": 166.22,
      "duration_seconds": 3.11,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.68,
      "end_seconds": 170.85,
      "duration_seconds": 3.17,
      "text": "I have asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.12,
      "end_seconds": 173.13,
      "duration_seconds": 1.01,
      "text": "Okay. Anything else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.87,
      "end_seconds": 180.08,
      "duration_seconds": 6.21,
      "text": "So, I have eczema, for five years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.27,
      "end_seconds": 181.97,
      "duration_seconds": 0.7,
      "text": "Mm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.47,
      "end_seconds": 188.25,
      "duration_seconds": 5.78,
      "text": "I've had high blood pressure, yes. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.02,
      "end_seconds": 189.72,
      "duration_seconds": 0.7,
      "text": "I see."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.17,
      "end_seconds": 198.07,
      "duration_seconds": 6.9,
      "text": "I have high cholesterol. Yes, heart disease. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.19,
      "end_seconds": 211.91,
      "duration_seconds": 12.72,
      "text": "Okay, eczema, that's already on your record. Good to know. Right, so that's your known high blood pressure. We'll keep that in mind today. Do you have any questions before we carry on?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.08,
      "end_seconds": 223.78,
      "duration_seconds": 10.7,
      "text": "Not at the moment, I think you've covered most of what I was wondering. If something comes to mind later, I'll ask you before I leave."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.55,
      "end_seconds": 227.94,
      "duration_seconds": 3.39,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 229.28,
      "end_seconds": 232.63,
      "duration_seconds": 3.35,
      "text": "My mother has diabetes. My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.85,
      "end_seconds": 236.35,
      "duration_seconds": 2.5,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.87,
      "end_seconds": 240.43,
      "duration_seconds": 2.56,
      "text": "I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.99,
      "end_seconds": 243.75,
      "duration_seconds": 2.76,
      "text": "Okay, how long have you been on it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.93,
      "end_seconds": 249.95,
      "duration_seconds": 5.02,
      "text": "About about a year. Losartan. I take it 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 250.99,
      "end_seconds": 258.79,
      "duration_seconds": 7.8,
      "text": "Yeah, doctor, I think the last prescription for the losartan was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.14,
      "end_seconds": 263.69,
      "duration_seconds": 3.55,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.75,
      "end_seconds": 279.2,
      "duration_seconds": 14.45,
      "text": "Uh, no, I left it at home. I'm on atorvastatin, 20 milligrams, at night. Oh, I take aspirin, 75 milligrams, once a day. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.78,
      "end_seconds": 283.16,
      "duration_seconds": 2.38,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.8,
      "end_seconds": 288.78,
      "duration_seconds": 4.98,
      "text": "Okay, so yes, I had a bypass operation, six years ago."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 289.85,
      "end_seconds": 297.52,
      "duration_seconds": 7.67,
      "text": "Here are the numbers, doctor. Temperature is 36.9 degrees, heart rate 73, blood pressure 117 over 82, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.99,
      "end_seconds": 299.59,
      "duration_seconds": 1.6,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.59,
      "end_seconds": 304.68,
      "duration_seconds": 3.09,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.22,
      "end_seconds": 308.34,
      "duration_seconds": 2.12,
      "text": "Okay, uh, go ahead."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.76,
      "end_seconds": 311.56,
      "duration_seconds": 1.8,
      "text": "Breathe in deeply... and out."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.1,
      "end_seconds": 332.37,
      "duration_seconds": 4.27,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.32,
      "end_seconds": 336.25,
      "duration_seconds": 2.93,
      "text": "Turn your head to the side for me."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.59,
      "end_seconds": 352.03,
      "duration_seconds": 2.44,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.19,
      "end_seconds": 375.28,
      "duration_seconds": 18.09,
      "text": "Okay, you can sit back up. From what you've told me and what I found, I think we're dealing with sinusitis at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep a viral cold in mind. Allergic rhinitis is also on my list."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 375.78,
      "end_seconds": 378.6,
      "duration_seconds": 2.82,
      "text": "Right, should I be worried about this?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.97,
      "end_seconds": 393.27,
      "duration_seconds": 13.3,
      "text": "It's reasonable to be concerned, but right now sinusitis is my leading thought, not anything worse. I'd like to arrange an X-ray of the sinuses for sinusitis. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 394.61,
      "end_seconds": 395.47,
      "duration_seconds": 0.86,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.49,
      "end_seconds": 403.52,
      "duration_seconds": 7.03,
      "text": "I'm prescribing saline nasal spray, three times a day, for one week. That should help with nasal congestion."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.12,
      "end_seconds": 407.62,
      "duration_seconds": 3.5,
      "text": "Alright, um, I'll pick it up today."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.42,
      "end_seconds": 434.34,
      "duration_seconds": 25.92,
      "text": "I'm prescribing amoxicillin-clavulanate, 625 milligrams, twice a day, for five days. That's for sinusitis. Steam a couple of times a day and saline rinses will help clear things. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 434.87,
      "end_seconds": 442.14,
      "duration_seconds": 7.27,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 443.71,
      "end_seconds": 445.16,
      "duration_seconds": 1.45,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.13,
      "end_seconds": 453.16,
      "duration_seconds": 7.03,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 454.1,
      "end_seconds": 455.48,
      "duration_seconds": 1.38,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 456.13,
      "end_seconds": 459.07,
      "duration_seconds": 2.94,
      "text": "I'd like to see you again in ten days."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 460.35,
      "end_seconds": 464.27,
      "duration_seconds": 3.92,
      "text": "Sure, I'll make the appointment on the way out."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 469.16,
      "end_seconds": 471.72,
      "duration_seconds": 2.56,
      "text": "Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 473.04,
      "end_seconds": 475.72,
      "duration_seconds": 2.68,
      "text": "Nothing more from me, doctor, thanks."
    }
  ]
}