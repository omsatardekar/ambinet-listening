{
  "schema_version": "1.0",
  "encounter_id": "00229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 3.48,
      "duration_seconds": 2.86,
      "text": "Good morning, how are you doing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.32,
      "end_seconds": 5.02,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 7.32,
      "duration_seconds": 1.37,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.01,
      "end_seconds": 13.35,
      "duration_seconds": 3.34,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.01,
      "end_seconds": 16.44,
      "duration_seconds": 2.43,
      "text": "Alright, in your own words, what's happened?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.64,
      "end_seconds": 23.0,
      "duration_seconds": 5.36,
      "text": "Um, so... breathlessness when I lie flat. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.85,
      "end_seconds": 25.71,
      "duration_seconds": 1.86,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.29,
      "end_seconds": 28.87,
      "duration_seconds": 2.58,
      "text": "It's been about three months now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.37,
      "end_seconds": 33.04,
      "duration_seconds": 3.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.14,
      "end_seconds": 42.01,
      "duration_seconds": 7.87,
      "text": "It's once or twice a day. Yes, lying flat. That makes it worse. I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.94,
      "end_seconds": 46.49,
      "duration_seconds": 3.55,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.44,
      "end_seconds": 59.34,
      "duration_seconds": 11.9,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.05,
      "end_seconds": 63.6,
      "duration_seconds": 3.55,
      "text": "Let me check a few things. Any fainting or calf pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.05,
      "end_seconds": 65.85,
      "duration_seconds": 1.8,
      "text": "Nothing like that, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.74,
      "end_seconds": 70.61,
      "duration_seconds": 3.87,
      "text": "Do you need me to explain anything as we go?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.33,
      "end_seconds": 77.8,
      "duration_seconds": 6.47,
      "text": "Hmm, just tell me in plain language, please. I'm not good with the medical terms."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.24,
      "end_seconds": 79.29,
      "duration_seconds": 1.05,
      "text": "Any regular medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.62,
      "end_seconds": 82.26,
      "duration_seconds": 2.64,
      "text": "No, I don't take anything regularly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.04,
      "end_seconds": 88.17,
      "duration_seconds": 5.13,
      "text": "Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.3,
      "end_seconds": 98.43,
      "duration_seconds": 9.13,
      "text": "So, yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.14,
      "end_seconds": 101.02,
      "duration_seconds": 1.88,
      "text": "Does anything run in the family?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.5,
      "end_seconds": 104.04,
      "duration_seconds": 1.54,
      "text": "My mother has diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.95,
      "end_seconds": 108.23,
      "duration_seconds": 3.28,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.11,
      "end_seconds": 109.81,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.62,
      "end_seconds": 124.57,
      "duration_seconds": 4.95,
      "text": "Right, thanks for waiting. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 127.9,
      "duration_seconds": 1.93,
      "text": "Not that I know, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.31,
      "end_seconds": 133.77,
      "duration_seconds": 3.46,
      "text": "Sorry, I'm just writing a few notes, bear with me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.32,
      "end_seconds": 138.08,
      "duration_seconds": 2.76,
      "text": "No problem, you know, take your time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.8,
      "end_seconds": 142.52,
      "duration_seconds": 3.72,
      "text": "Okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.1,
      "end_seconds": 146.48,
      "duration_seconds": 2.38,
      "text": "No, I've never had anything serious."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 149.98,
      "duration_seconds": 2.16,
      "text": "I'll just check what's already recorded here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.6,
      "end_seconds": 151.37,
      "duration_seconds": 0.77,
      "text": "Please do."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.18,
      "end_seconds": 181.41,
      "duration_seconds": 18.23,
      "text": "Alright, I've got it. What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.15,
      "end_seconds": 183.95,
      "duration_seconds": 1.8,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.82,
      "end_seconds": 195.94,
      "duration_seconds": 11.12,
      "text": "So, based on your history, this looks most like fluid overload related to the heart. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.61,
      "end_seconds": 198.98,
      "duration_seconds": 2.37,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.02,
      "end_seconds": 217.56,
      "duration_seconds": 17.54,
      "text": "I understand the worry. At the moment I'd say it's fluid overload related to the heart, and we'll know more once the an echocardiogram is back. Let me just recap so I've got it right. You've had breathlessness when you lie flat for about three months, and no fainting or calf pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.33,
      "end_seconds": 220.79,
      "duration_seconds": 2.46,
      "text": "Yeah, exactly, that's what's been happening."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.37,
      "end_seconds": 237.68,
      "duration_seconds": 16.31,
      "text": "I'll be straight with you about how this works. Most of what we see in clinic turns out to be manageable, and the history you give me is often more useful than any single test, so thank you for being so detailed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.26,
      "end_seconds": 241.41,
      "duration_seconds": 2.15,
      "text": "Thank you, that really helps."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.82,
      "end_seconds": 251.84,
      "duration_seconds": 9.02,
      "text": "I'm going to order an echocardiogram, for breathlessness and swelling. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.36,
      "end_seconds": 254.61,
      "duration_seconds": 2.25,
      "text": "Alright. When can I do that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.15,
      "end_seconds": 266.71,
      "duration_seconds": 10.56,
      "text": "Let's use furosemide, 40 milligrams, every morning, until we review. It's for fluid overload. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.02,
      "end_seconds": 269.78,
      "duration_seconds": 1.76,
      "text": "Right, I'll remember that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.72,
      "end_seconds": 294.92,
      "duration_seconds": 21.2,
      "text": "Weigh yourself every morning, and tell us if you put on more than two kilos in a few days. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I want you to come back or go to emergency straight away if the breathlessness gets worse or you can't lie down at all."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.67,
      "end_seconds": 297.02,
      "duration_seconds": 1.35,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.25,
      "end_seconds": 301.66,
      "duration_seconds": 3.41,
      "text": "Please come and see me after the results are back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.44,
      "end_seconds": 303.14,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 309.5,
      "duration_seconds": 5.89,
      "text": "I want to be sure we're on the same page. How would you describe the plan?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.85,
      "end_seconds": 317.68,
      "duration_seconds": 7.83,
      "text": "So, I take the furosemide, 40 milligrams, every morning and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.19,
      "end_seconds": 323.42,
      "duration_seconds": 5.23,
      "text": "Okay, yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.92,
      "end_seconds": 328.88,
      "duration_seconds": 3.96,
      "text": "I think that's clear. Thank you for being so thorough."
    }
  ]
}