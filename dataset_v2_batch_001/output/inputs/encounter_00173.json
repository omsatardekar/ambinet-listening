{
  "schema_version": "1.0",
  "encounter_id": "00173",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 6.35,
      "duration_seconds": 5.73,
      "text": "Hi doctor, sorry, the lift was out and I had to take the stairs."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.78,
      "end_seconds": 10.45,
      "duration_seconds": 2.67,
      "text": "Yes, do sit. Tell me what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.67,
      "end_seconds": 16.59,
      "duration_seconds": 4.92,
      "text": "Right, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.38,
      "end_seconds": 19.98,
      "duration_seconds": 2.6,
      "text": "Okay, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.65,
      "end_seconds": 24.01,
      "duration_seconds": 3.36,
      "text": "Yeah, it's heartburn. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 29.07,
      "duration_seconds": 2.27,
      "text": "When did you first notice it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.29,
      "end_seconds": 32.18,
      "duration_seconds": 1.89,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.71,
      "end_seconds": 35.54,
      "duration_seconds": 2.83,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.12,
      "end_seconds": 38.78,
      "duration_seconds": 2.66,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.36,
      "end_seconds": 44.31,
      "duration_seconds": 3.95,
      "text": "Okay, is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.5,
      "end_seconds": 48.12,
      "duration_seconds": 2.62,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.85,
      "end_seconds": 50.52,
      "duration_seconds": 1.67,
      "text": "So, anything that helps?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.07,
      "end_seconds": 65.71,
      "duration_seconds": 13.64,
      "text": "Only antacids, and it's not much. I've also had food coming back up. About food coming back up, I'd say severe. I've also had a lump feeling in the throat."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.99,
      "end_seconds": 80.46,
      "duration_seconds": 13.47,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.73,
      "end_seconds": 83.45,
      "duration_seconds": 1.72,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.11,
      "end_seconds": 88.8,
      "duration_seconds": 4.69,
      "text": "Let me check a few things. Any black stools or pain on exertion?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.2,
      "end_seconds": 93.62,
      "duration_seconds": 4.42,
      "text": "Right, no black stools or pain on exertion, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.07,
      "end_seconds": 99.65,
      "duration_seconds": 1.58,
      "text": "Have you had any anaemia?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.73,
      "end_seconds": 101.97,
      "duration_seconds": 1.24,
      "text": "No, no anaemia."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.65,
      "end_seconds": 104.73,
      "duration_seconds": 2.08,
      "text": "Any weight loss or trouble swallowing?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.56,
      "end_seconds": 109.6,
      "duration_seconds": 4.04,
      "text": "No weight loss or trouble swallowing, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 112.51,
      "duration_seconds": 2.44,
      "text": "So, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.84,
      "end_seconds": 114.45,
      "duration_seconds": 1.61,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.92,
      "end_seconds": 117.13,
      "duration_seconds": 2.21,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.38,
      "end_seconds": 119.74,
      "duration_seconds": 1.36,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.97,
      "end_seconds": 125.18,
      "duration_seconds": 4.21,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.62,
      "end_seconds": 126.32,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.83,
      "end_seconds": 139.72,
      "duration_seconds": 3.89,
      "text": "Alright, I've got it. What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.43,
      "end_seconds": 149.29,
      "duration_seconds": 8.86,
      "text": "I'm on Seretide inhaler, twice a day. Oh, I take pantoprazole, 40 milligrams, before breakfast. Amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 150.08,
      "end_seconds": 154.1,
      "duration_seconds": 4.02,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.4,
      "end_seconds": 160.03,
      "duration_seconds": 4.63,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.62,
      "end_seconds": 166.26,
      "duration_seconds": 4.64,
      "text": "No, I left it at home. Digene, when it burns."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.48,
      "end_seconds": 171.41,
      "duration_seconds": 3.93,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.24,
      "end_seconds": 172.98,
      "duration_seconds": 0.74,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.56,
      "end_seconds": 186.44,
      "duration_seconds": 2.88,
      "text": "Alright, I've got it. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.03,
      "end_seconds": 190.07,
      "duration_seconds": 3.04,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.64,
      "end_seconds": 196.29,
      "duration_seconds": 4.65,
      "text": "Is there anything you were hoping to get out of today's visit?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.56,
      "end_seconds": 201.36,
      "duration_seconds": 3.8,
      "text": "Mostly I just want to understand what's going on."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.98,
      "end_seconds": 205.24,
      "duration_seconds": 3.26,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.96,
      "end_seconds": 210.11,
      "duration_seconds": 4.15,
      "text": "My mother had high blood pressure. My uncle had colon cancer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.36,
      "end_seconds": 215.11,
      "duration_seconds": 3.75,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.15,
      "end_seconds": 217.35,
      "duration_seconds": 1.2,
      "text": "I have asthma."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.84,
      "end_seconds": 218.54,
      "duration_seconds": 0.7,
      "text": "Mm-hm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.81,
      "end_seconds": 222.32,
      "duration_seconds": 2.51,
      "text": "Acid reflux, for about ten years."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.93,
      "end_seconds": 223.63,
      "duration_seconds": 0.7,
      "text": "Go on."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.15,
      "end_seconds": 227.87,
      "duration_seconds": 2.72,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.36,
      "end_seconds": 235.97,
      "duration_seconds": 7.61,
      "text": "Yes, I can see the asthma in your file as well. Okay, acid reflux, that's already on your record. Good to know."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 239.43,
      "duration_seconds": 2.74,
      "text": "One moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.07,
      "end_seconds": 240.89,
      "duration_seconds": 0.82,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.7,
      "end_seconds": 258.27,
      "duration_seconds": 4.57,
      "text": "Right, thanks for waiting. What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.36,
      "end_seconds": 263.58,
      "duration_seconds": 4.22,
      "text": "Sulfa drugs, I'd say. Yes, codeine. I get vomiting."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.65,
      "end_seconds": 267.73,
      "duration_seconds": 3.08,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.07,
      "end_seconds": 270.27,
      "duration_seconds": 2.2,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 270.87,
      "end_seconds": 277.37,
      "duration_seconds": 6.5,
      "text": "Here are the numbers, doctor. Temp 36.4 degrees, saturation 98 percent, pulse 66. BP is 110 over 81."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.66,
      "end_seconds": 282.64,
      "duration_seconds": 3.98,
      "text": "Thanks. Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.77,
      "end_seconds": 296.6,
      "duration_seconds": 12.83,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.89,
      "end_seconds": 299.55,
      "duration_seconds": 1.66,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.94,
      "end_seconds": 303.94,
      "duration_seconds": 1.0,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.49,
      "end_seconds": 307.05,
      "duration_seconds": 1.56,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.94,
      "end_seconds": 317.66,
      "duration_seconds": 1.72,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.23,
      "end_seconds": 333.43,
      "duration_seconds": 12.2,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Is the room warm enough for you?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.93,
      "end_seconds": 335.7,
      "duration_seconds": 1.77,
      "text": "It's perfect, thank you."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.67,
      "end_seconds": 351.15,
      "duration_seconds": 14.48,
      "text": "So, based on the history and the examination, I think we're dealing with gastro-oesophageal reflux at this stage. The reason I say that is that your story and my examination fit together. I can't rule out gastritis yet."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.66,
      "end_seconds": 353.93,
      "duration_seconds": 2.27,
      "text": "Is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.78,
      "end_seconds": 371.97,
      "duration_seconds": 17.19,
      "text": "I understand the worry. At the moment I'd say it's gastro-oesophageal reflux, and we'll know more once the an ECG is back. Let me just recap so I've got it right. You've had heartburn for two days, and no trouble swallowing or pain on exertion."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.28,
      "end_seconds": 375.21,
      "duration_seconds": 1.93,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.31,
      "end_seconds": 378.78,
      "duration_seconds": 2.47,
      "text": "Has anything about your daily routine changed lately?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.03,
      "end_seconds": 395.8,
      "duration_seconds": 15.77,
      "text": "Uh, not really, the days are pretty much the same, work and home, and I've been trying to fit appointments in around my schedule, which isn't always easy, so I'm glad we could find a time today."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 396.39,
      "end_seconds": 399.35,
      "duration_seconds": 2.96,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.66,
      "end_seconds": 420.81,
      "duration_seconds": 21.15,
      "text": "Good, thank you. Let's get an upper endoscopy, for persistent reflux. The result will help us decide whether anything more is needed. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.94,
      "end_seconds": 423.14,
      "duration_seconds": 1.2,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.24,
      "end_seconds": 432.24,
      "duration_seconds": 6.0,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 432.9,
      "end_seconds": 434.37,
      "duration_seconds": 1.47,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0074",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 435.05,
      "end_seconds": 437.13,
      "duration_seconds": 2.08,
      "text": "Let's review you in eight weeks."
    },
    {
      "segment_id": "SEG0075",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.09,
      "end_seconds": 438.79,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0076",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.65,
      "end_seconds": 446.27,
      "duration_seconds": 6.62,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0077",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 447.32,
      "end_seconds": 451.77,
      "duration_seconds": 4.45,
      "text": "So, I come back in eight weeks. Is that right?"
    },
    {
      "segment_id": "SEG0078",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 453.23,
      "end_seconds": 456.89,
      "duration_seconds": 3.66,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0079",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 458.27,
