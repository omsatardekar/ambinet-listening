{
  "schema_version": "1.0",
  "encounter_id": "00263",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.59,
      "duration_seconds": 3.62,
      "text": "Uh, good morning, doctor. Can I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.9,
      "duration_seconds": 4.78,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.65,
      "end_seconds": 15.04,
      "duration_seconds": 3.39,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.87,
      "end_seconds": 19.19,
      "duration_seconds": 3.32,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.57,
      "end_seconds": 25.49,
      "duration_seconds": 4.92,
      "text": "It's yellow eyes. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.86,
      "end_seconds": 27.41,
      "duration_seconds": 1.55,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.6,
      "end_seconds": 43.68,
      "duration_seconds": 15.08,
      "text": "It's been about two weeks now. Okay, so and there's a dull ache on the right side of the tummy as well, three weeks now. Oh, and there's dark urine as well, about three months now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.63,
      "end_seconds": 49.14,
      "duration_seconds": 4.51,
      "text": "Have you had yellow eyes before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.34,
      "end_seconds": 56.75,
      "duration_seconds": 6.41,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.88,
      "end_seconds": 61.15,
      "duration_seconds": 3.27,
      "text": "Let me just pull up your file for a second."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.55,
      "end_seconds": 62.25,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.52,
      "end_seconds": 82.28,
      "duration_seconds": 6.76,
      "text": "Right, thanks for waiting. Let me check a few things. Any swelling of the tummy, confusion, black stools or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.59,
      "end_seconds": 85.19,
      "duration_seconds": 2.6,
      "text": "Nothing like that, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.44,
      "end_seconds": 88.6,
      "duration_seconds": 2.16,
      "text": "Okay, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.98,
      "end_seconds": 91.98,
      "duration_seconds": 2.0,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.92,
      "end_seconds": 95.81,
      "duration_seconds": 2.89,
      "text": "Alright, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.57,
      "end_seconds": 97.32,
      "duration_seconds": 0.75,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.8,
      "end_seconds": 119.1,
      "duration_seconds": 7.3,
      "text": "Okay, here we go. Do you have any allergies to medicines, food, anything at all? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.68,
      "end_seconds": 125.52,
      "duration_seconds": 5.84,
      "text": "I'm allergic to shellfish, I get hives. Aspirin. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.33,
      "end_seconds": 137.93,
      "duration_seconds": 11.6,
      "text": "I like to make sure you understand what's happening, so please stop me at any point. There are no silly questions, and I'd much rather you ask now than go home still wondering about something."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.99,
      "end_seconds": 140.81,
      "duration_seconds": 1.82,
      "text": "Right, I understand now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 145.89,
      "duration_seconds": 4.06,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.61,
      "end_seconds": 158.13,
      "duration_seconds": 11.52,
      "text": "I've got high cholesterol. I'm not great at remembering details, uh, so bear with me. I told myself I'd wait and see, and here I am. I've got diabetes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.63,
      "end_seconds": 174.24,
      "duration_seconds": 14.61,
      "text": "I see. Let me explain how I'm thinking about this. When someone has symptoms like these, we first look for the common and treatable causes, and only then for the rarer ones. That's why I'm going step by step rather than ordering everything at once."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.28,
      "end_seconds": 178.14,
      "duration_seconds": 2.86,
      "text": "Hmm, okay, that makes sense."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.92,
      "end_seconds": 185.64,
      "duration_seconds": 6.72,
      "text": "Any medication at the moment, including things from the pharmacy? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.48,
      "end_seconds": 190.88,
      "duration_seconds": 4.4,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 191.84,
      "end_seconds": 199.19,
      "duration_seconds": 7.35,
      "text": "Doctor, I think the last prescription for the rosuvastatin was 5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.45,
      "end_seconds": 203.65,
      "duration_seconds": 3.2,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.7,
      "end_seconds": 210.67,
      "duration_seconds": 5.97,
      "text": "I mean, no, I left it at home. Glimepiride, 2 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.11,
      "end_seconds": 214.47,
      "duration_seconds": 2.36,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.79,
      "end_seconds": 216.79,
      "duration_seconds": 2.0,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.36,
      "end_seconds": 237.61,
      "duration_seconds": 6.25,
      "text": "Alright, I've got it. Is there anyone at home who can help you out if you need it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.03,
      "end_seconds": 246.84,
      "duration_seconds": 8.81,
      "text": "Yes, there's family around most evenings, and they've been very good about checking in, although they do worry more than they need to."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.01,
      "end_seconds": 250.92,
      "duration_seconds": 1.91,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.2,
      "end_seconds": 253.61,
      "duration_seconds": 1.41,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.41,
      "end_seconds": 257.83,
      "duration_seconds": 2.42,
      "text": "Now I'm going to check this part."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.35,
      "end_seconds": 267.75,
      "duration_seconds": 2.4,
      "text": "The whites of your eyes are yellow."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.78,
      "end_seconds": 272.48,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.64,
      "end_seconds": 274.91,
      "duration_seconds": 1.27,
      "text": "Open wide for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.7,
      "end_seconds": 288.68,
      "duration_seconds": 2.98,
      "text": "Liver edge is just palpable and mildly tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.45,
      "end_seconds": 307.81,
      "duration_seconds": 14.36,
      "text": "All done, thank you, please sit down. Good, that's all I need to examine. Let me gather my thoughts and then we'll talk it through together. Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.17,
      "end_seconds": 322.05,
      "duration_seconds": 12.88,
      "text": "Yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.26,
      "end_seconds": 342.98,
      "duration_seconds": 19.72,
      "text": "Right, here's what I'm thinking. My working impression is jaundice with a cause we still need to find. A gallstone blocking the bile duct is also on my list. Let me just recap so I've got it right. You've had yellow eyes for about two weeks, and no swelling of the tummy or fever."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.29,
      "end_seconds": 344.51,
      "duration_seconds": 1.22,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.84,
      "end_seconds": 349.31,
      "duration_seconds": 3.47,
      "text": "Let me make a quick note of that before I forget."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.63,
      "end_seconds": 350.33,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.74,
      "end_seconds": 392.91,
      "duration_seconds": 28.17,
      "text": "Alright, I've got it. I'm going to order an ultrasound of the abdomen, for jaundice. It's a routine test and it'll give us a much clearer picture. Let's get liver function tests, for jaundice. Please avoid alcohol completely and don't take any painkillers except paracetamol, and not much of that. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll refer you to a liver specialist."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.05,
      "end_seconds": 401.4,
      "duration_seconds": 7.35,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.5,
      "end_seconds": 403.74,
      "duration_seconds": 1.24,
      "text": "Okay, I will."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.85,
      "end_seconds": 412.0,
      "duration_seconds": 7.15,
      "text": "Please don't sit on it if you vomit blood or become drowsy or confused. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.77,
      "end_seconds": 413.47,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.04,
      "end_seconds": 426.68,
      "duration_seconds": 9.64,
      "text": "Let's review you after the results are back. Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.36,
      "end_seconds": 431.86,
      "duration_seconds": 4.5,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.27,
      "end_seconds": 437.82,
      "duration_seconds": 4.55,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 438.86,
      "end_seconds": 442.13,
      "duration_seconds": 3.27,
      "text": "That's everything I wanted to ask. Thank you."
    }
  ]
}