{
  "schema_version": "1.0",
  "encounter_id": "00399",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 2.32,
      "duration_seconds": 1.61,
      "text": "Hello again. Come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.89,
      "end_seconds": 6.38,
      "duration_seconds": 2.49,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.81,
      "end_seconds": 11.32,
      "duration_seconds": 4.51,
      "text": "Good morning, um, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.09,
      "end_seconds": 14.42,
      "duration_seconds": 2.33,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 18.76,
      "duration_seconds": 3.74,
      "text": "Okay, so yes, I managed on my own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 20.93,
      "duration_seconds": 1.3,
      "text": "What's been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.32,
      "end_seconds": 28.63,
      "duration_seconds": 6.31,
      "text": "It's, It's exhaustion since I had the flu, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.47,
      "end_seconds": 34.1,
      "duration_seconds": 4.63,
      "text": "When did you first notice it? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.76,
      "end_seconds": 41.05,
      "duration_seconds": 6.29,
      "text": "About... well, two weeks. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.54,
      "end_seconds": 44.86,
      "duration_seconds": 2.32,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.52,
      "end_seconds": 49.9,
      "duration_seconds": 4.38,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.03,
      "end_seconds": 53.3,
      "duration_seconds": 2.27,
      "text": "What makes it worse, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.24,
      "end_seconds": 71.22,
      "duration_seconds": 16.98,
      "text": "It's worse with walking far. Oh, and poor sleep. That's been about the same, about four days. As for lingering cough, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.71,
      "end_seconds": 75.82,
      "duration_seconds": 3.11,
      "text": "Have you had any chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.12,
      "end_seconds": 79.28,
      "duration_seconds": 3.16,
      "text": "No, uh, none of that at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.72,
      "end_seconds": 82.78,
      "duration_seconds": 3.06,
      "text": "Mm. Any shortness of breath, swollen legs or rash?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.85,
      "end_seconds": 88.21,
      "duration_seconds": 4.36,
      "text": "I haven't had shortness of breath, swollen legs or rash, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.37,
      "end_seconds": 91.42,
      "duration_seconds": 2.05,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.68,
      "end_seconds": 96.32,
      "duration_seconds": 3.64,
      "text": "Just a lump removed from my back, years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.66,
      "end_seconds": 99.9,
      "duration_seconds": 2.24,
      "text": "Let me double-check something in your record."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.31,
      "end_seconds": 102.38,
      "duration_seconds": 2.07,
      "text": "Of course, take your time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.3,
      "end_seconds": 112.77,
      "duration_seconds": 3.47,
      "text": "Alright, I've got it. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.36,
      "end_seconds": 115.29,
      "duration_seconds": 1.93,
      "text": "My sister has thyroid problems."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.74,
      "end_seconds": 119.92,
      "duration_seconds": 3.18,
      "text": "Alright, one moment, the system's being slow today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.35,
      "end_seconds": 121.13,
      "duration_seconds": 0.78,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.55,
      "end_seconds": 137.42,
      "duration_seconds": 4.87,
      "text": "Right, thanks for waiting. Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.65,
      "end_seconds": 141.0,
      "duration_seconds": 2.35,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.3,
      "end_seconds": 147.24,
      "duration_seconds": 4.94,
      "text": "Okay, I'm following. Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.82,
      "end_seconds": 151.93,
      "duration_seconds": 3.11,
      "text": "I'm allergic to pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.61,
      "end_seconds": 165.08,
      "duration_seconds": 12.47,
      "text": "It's quite normal to feel unsure at this point. People often expect an instant answer, but a good assessment usually has a few stages, and today is mainly about narrowing things down and making a sensible plan together."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.07,
      "end_seconds": 167.87,
      "duration_seconds": 1.8,
      "text": "That's reassuring to hear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.33,
      "end_seconds": 172.14,
      "duration_seconds": 2.81,
      "text": "What medicines are you taking at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.65,
      "end_seconds": 185.46,
      "duration_seconds": 12.81,
      "text": "Well, I take Seretide inhaler, twice a day for my asthma. It's paracetamol, 500 milligrams, when needed. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.4,
      "end_seconds": 189.04,
      "duration_seconds": 2.64,
      "text": "I want to open your previous notes quickly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.8,
      "end_seconds": 190.53,
      "duration_seconds": 0.73,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.54,
      "end_seconds": 199.35,
      "duration_seconds": 2.81,
      "text": "Right, thanks for waiting. Right, any smoking?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.29,
      "end_seconds": 201.55,
      "duration_seconds": 1.26,
      "text": "I've never smoked."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.29,
      "end_seconds": 203.63,
      "duration_seconds": 1.34,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.66,
      "end_seconds": 208.26,
      "duration_seconds": 3.6,
      "text": "I gave up drinking about three years ago."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.47,
      "end_seconds": 223.7,
      "duration_seconds": 14.23,
      "text": "What I'm doing here is putting together three things: what you tell me, what I find when I examine you, and what the tests show. None of those alone is enough, which is why we sometimes need to wait for results before being certain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.86,
      "end_seconds": 226.92,
      "duration_seconds": 2.06,
      "text": "I appreciate you explaining that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.48,
      "end_seconds": 229.62,
      "duration_seconds": 2.14,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 243.44,
      "duration_seconds": 1.24,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.95,
      "end_seconds": 271.32,
      "duration_seconds": 9.37,
      "text": "Okay: height 182 centimetres, BMI works out to 23.2, oxygen saturation is 99 percent, temperature 37.0, pressure 120 over 68, weight 77 kilos, heart rate 75."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 272.77,
      "end_seconds": 274.08,
      "duration_seconds": 1.31,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.46,
      "end_seconds": 278.03,
      "duration_seconds": 3.57,
      "text": "Okay, we'll put it in context in a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.61,
      "end_seconds": 282.1,
      "duration_seconds": 2.49,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.26,
      "end_seconds": 284.94,
      "duration_seconds": 1.68,
      "text": "Look straight ahead for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.2,
      "end_seconds": 298.97,
      "duration_seconds": 1.77,
      "text": "Chest sounds clear all over."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.67,
      "end_seconds": 317.11,
      "duration_seconds": 13.44,
      "text": "Okay, that's fine, you can get dressed. Thank you for that. I'll write up what I found in a moment, and then I'll tell you what I think is going on. Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.54,
      "end_seconds": 319.81,
      "duration_seconds": 2.27,
      "text": "Yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.62,
      "end_seconds": 329.17,
      "duration_seconds": 8.55,
      "text": "Putting it all together, my working impression is post-viral fatigue. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.55,
      "end_seconds": 332.62,
      "duration_seconds": 3.07,
      "text": "Is it something serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.97,
      "end_seconds": 348.91,
      "duration_seconds": 15.94,
      "text": "I understand the worry. At the moment I'd say it's post-viral fatigue, and we'll know more once the blood tests is back. Let me just recap so I've got it right. You've had exhaustion since you had the flu for two weeks, and no weight loss or rash."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.97,
      "end_seconds": 352.41,
      "duration_seconds": 2.44,
      "text": "Yeah, yes, you've got it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.18,
      "end_seconds": 375.53,
      "duration_seconds": 22.35,
      "text": "We should do blood tests for fatigue. I'd rather check than guess, and this is the quickest way to know more. Pace yourself, a little more activity each day but stop before you're wiped out. If you smoke, this is a good moment to think about stopping, and we can help you with that. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.12,
      "end_seconds": 385.29,
      "duration_seconds": 8.17,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently. Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 387.73,
      "end_seconds": 388.43,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.81,
      "end_seconds": 393.6,
      "duration_seconds": 4.79,
      "text": "Let me check that I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.7,
      "end_seconds": 400.25,
      "duration_seconds": 5.55,
      "text": "So, you know, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.33,
      "end_seconds": 406.44,
      "duration_seconds": 5.11,
      "text": "Yes, exactly right. All right, I'll let you go. Any final questions first?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 410.71,
      "end_seconds": 412.31,
      "duration_seconds": 1.6,
      "text": "Thanks so much, doctor."
    }
  ]
}