{
  "schema_version": "1.0",
  "encounter_id": "00489",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 1.87,
      "duration_seconds": 1.27,
      "text": "Hello, come through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 2.48,
      "end_seconds": 3.18,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 3.53,
      "end_seconds": 5.88,
      "duration_seconds": 2.35,
      "text": "Did you take the bus in?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.3,
      "end_seconds": 10.66,
      "duration_seconds": 3.36,
      "text": "Yeah, I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.07,
      "end_seconds": 13.54,
      "duration_seconds": 2.47,
      "text": "Right, how can I help you today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.11,
      "end_seconds": 24.4,
      "duration_seconds": 10.29,
      "text": "Honestly, you know, it's burning in both feet, and my family pushed me to come. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.5,
      "end_seconds": 27.36,
      "duration_seconds": 1.86,
      "text": "And when did that start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.54,
      "end_seconds": 33.87,
      "duration_seconds": 5.33,
      "text": "It's been three weeks now. Sorry, uh, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.66,
      "end_seconds": 36.65,
      "duration_seconds": 1.99,
      "text": "Is there anything that triggers it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.26,
      "end_seconds": 40.02,
      "duration_seconds": 2.76,
      "text": "Bedsheets touching them definitely sets it off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.48,
      "end_seconds": 43.05,
      "duration_seconds": 2.57,
      "text": "Go on. Does anything make it better?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.8,
      "end_seconds": 46.32,
      "duration_seconds": 2.52,
      "text": "It settles a little with walking around."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.67,
      "end_seconds": 50.68,
      "duration_seconds": 3.01,
      "text": "Does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.52,
      "end_seconds": 53.31,
      "duration_seconds": 1.79,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.43,
      "end_seconds": 57.4,
      "duration_seconds": 2.97,
      "text": "How would you describe it, mild, moderate, severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.22,
      "end_seconds": 61.0,
      "duration_seconds": 2.78,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.59,
      "end_seconds": 64.86,
      "duration_seconds": 3.27,
      "text": "Have you had pins and needles in the legs?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.18,
      "end_seconds": 70.8,
      "duration_seconds": 5.62,
      "text": "Yes, actually. As for pins and needles in the legs, it's worse with at night."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.75,
      "end_seconds": 75.64,
      "duration_seconds": 3.89,
      "text": "Have you been able to keep up with your usual activities?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.87,
      "end_seconds": 88.3,
      "duration_seconds": 11.43,
      "text": "For the most part, yes. I just carry on and try not to dwell on things too much, though I won't pretend it hasn't crossed my mind a few times."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.57,
      "end_seconds": 93.05,
      "duration_seconds": 3.48,
      "text": "Any weakness in the legs or foot ulcers at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.64,
      "end_seconds": 97.59,
      "duration_seconds": 3.95,
      "text": "No, no weakness in the legs or foot ulcers."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.12,
      "end_seconds": 100.7,
      "duration_seconds": 2.58,
      "text": "Any fever or back pain at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.71,
      "end_seconds": 105.46,
      "duration_seconds": 3.75,
      "text": "No, you know, none of that at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.06,
      "end_seconds": 107.12,
      "duration_seconds": 1.06,
      "text": "Any bladder problems?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.51,
      "end_seconds": 113.12,
      "duration_seconds": 1.61,
      "text": "No. No bladder problems."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.42,
      "end_seconds": 115.22,
      "duration_seconds": 1.8,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.65,
      "end_seconds": 117.32,
      "duration_seconds": 1.67,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.75,
      "end_seconds": 125.3,
      "duration_seconds": 3.55,
      "text": "Do you have everything you need to get home alright?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.25,
      "end_seconds": 140.75,
      "duration_seconds": 14.5,
      "text": "Okay, you know, so yes, I've got my transport sorted. It's a bit of a trek, but I'm used to the journey by now, and I brought something to read for the wait."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.12,
      "end_seconds": 146.41,
      "duration_seconds": 5.29,
      "text": "What medicines are you taking at the moment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.76,
      "end_seconds": 155.19,
      "duration_seconds": 7.43,
      "text": "It's glimepiride, 2 milligrams, before breakfast. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.75,
      "end_seconds": 159.7,
      "duration_seconds": 3.95,
      "text": "Give me a second, I'm just scrolling back through your chart."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.06,
      "end_seconds": 160.88,
      "duration_seconds": 0.82,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.31,
      "end_seconds": 173.28,
      "duration_seconds": 4.97,
      "text": "Right, thanks for waiting. What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.57,
      "end_seconds": 181.47,
      "duration_seconds": 6.9,
      "text": "I've had diabetes, yes. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.07,
      "end_seconds": 185.35,
      "duration_seconds": 3.28,
      "text": "I'll try to keep this as efficient as I can."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.36,
      "end_seconds": 188.75,
      "duration_seconds": 2.39,
      "text": "Thank you, I appreciate it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.65,
      "end_seconds": 193.29,
      "duration_seconds": 3.64,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.08,
      "end_seconds": 194.86,
      "duration_seconds": 0.78,
      "text": "No allergies."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.93,
      "end_seconds": 198.98,
      "duration_seconds": 3.05,
      "text": "Is it okay if I type while we talk?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.8,
      "end_seconds": 203.67,
      "duration_seconds": 3.87,
      "text": "Uh, um, yes, of course, go ahead."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.22,
      "end_seconds": 209.04,
      "duration_seconds": 2.82,
      "text": "Let me have a look at you now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.08,
      "end_seconds": 212.7,
      "duration_seconds": 2.62,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.34,
      "end_seconds": 224.9,
      "duration_seconds": 1.56,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.87,
      "end_seconds": 229.21,
      "duration_seconds": 2.34,
      "text": "Hold your arm out like this."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.69,
      "end_seconds": 241.94,
      "duration_seconds": 3.25,
      "text": "Feeling of light touch is reduced in both feet."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.84,
      "end_seconds": 244.11,
      "duration_seconds": 1.27,
      "text": "Okay, go ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.22,
      "end_seconds": 262.32,
      "duration_seconds": 14.1,
      "text": "Okay, you can sit back up. Thanks for bearing with me. Now that I've had a look, I can put the whole picture together. Putting it all together, this looks most like peripheral neuropathy, possibly related to sugar."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.84,
      "end_seconds": 267.49,
      "duration_seconds": 3.65,
      "text": "Um, is this going to go away?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.01,
      "end_seconds": 287.36,
      "duration_seconds": 18.35,
      "text": "I can't promise yet, but most people with peripheral neuropathy, possibly related to sugar do well once it's treated properly. Let me just recap so I've got it right. You've had burning in both feet for three weeks, and no weakness in the legs or foot ulcers."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.66,
      "end_seconds": 290.12,
      "duration_seconds": 1.46,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.61,
      "end_seconds": 317.26,
      "duration_seconds": 25.65,
      "text": "I'd like to arrange a nerve conduction study for neuropathy. I'd rather check than guess, and this is the quickest way to know more. Let's use pregabalin, 75 milligrams, at night, for four weeks. It's for nerve pain. Check your feet every evening for cuts or blisters, you may not feel them. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.74,
      "end_seconds": 323.67,
      "duration_seconds": 5.93,
      "text": "Please don't sit on it if the symptoms get worse. That's the point to get seen urgently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.32,
      "end_seconds": 327.54,
      "duration_seconds": 3.22,
      "text": "Um, uh, yes, I'll do that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.85,
      "end_seconds": 330.65,
      "duration_seconds": 2.8,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.72,
      "end_seconds": 334.26,
      "duration_seconds": 2.54,
      "text": "Okay, uh, I'll book that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.61,
      "end_seconds": 340.29,
      "duration_seconds": 5.68,
      "text": "Before we finish, can you repeat the plan back to me so I know I haven't been confusing?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.81,
      "end_seconds": 349.64,
      "duration_seconds": 7.83,
      "text": "So, I take the pregabalin, 75 milligrams, at night and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.22,
      "end_seconds": 355.09,
      "duration_seconds": 3.87,
      "text": "Yes, exactly right. Alright, that's everything from me. Any other questions?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.24,
      "end_seconds": 357.89,
      "duration_seconds": 1.65,
      "text": "No questions. Thank you."
    }
  ]
}