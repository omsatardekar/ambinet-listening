  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's, It's morning shakiness, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And when did that that start?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "about... well, about four days",
      "start_timestamp": "00:36",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It happens on and off. I'd give it a seven, out of ten.",
      "start_timestamp": "00:51",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "anything that tends to go along with it?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "An upset stomach in the mornings goes along with it, most of the time",
      "start_timestamp": "01:07",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yeah, the upset stomach in the mornings? That's been since yesterday.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Would you call it mild or bad?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:52",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:06",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "it's severe, honestly. And I've been feeling guilty about it as well, for about a week",
      "start_timestamp": "02:08",
      "end_timestamp": "02:17",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "and what about vomiting blood or blackouts?",
      "start_timestamp": "02:27",
      "end_timestamp": "02:30",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "No, no vomiting blood, no blackouts. I was wanting to cut down on drinking at one point, but that went away on its own.",
      "start_timestamp": "02:35",
