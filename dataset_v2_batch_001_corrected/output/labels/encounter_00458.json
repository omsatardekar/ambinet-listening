      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, thinking it through, it points towards an underactive thyroid. Another possibility is anaemia.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:18",
      "supports": [
        "clinical_assessment[0]",
        "clinical_assessment[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's reasonable to be concerned, but right now an underactive thyroid is my leading thought, not anything worse.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:33",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We should do blood tests for fatigue. Let's get a thyroid test, for hypothyroid symptoms. We'll begin with levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. You take it by mouth. It's for hypothyroidism.",
      "start_timestamp": "04:48",
      "end_timestamp": "05:05",
      "supports": [
        "medications[3]",
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency.",
      "start_timestamp": "05:10",
      "end_timestamp": "05:26",
      "supports": [
        "clinical_actions[3]",
        "clinical_actions[4]"
      ]
    },
