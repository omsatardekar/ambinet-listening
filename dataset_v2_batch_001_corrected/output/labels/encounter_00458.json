      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright, low haemoglobin, that matches what I have here. Now some background about your lifestyle.",
      "start_timestamp": "02:47",
