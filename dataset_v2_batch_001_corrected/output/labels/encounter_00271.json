      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps.",
