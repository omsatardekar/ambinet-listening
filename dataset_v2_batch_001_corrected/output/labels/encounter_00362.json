    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, noted. When did it begin?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Probably three days. Yeah.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there anything that triggers it?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, swallowing. That makes it worse.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has there been a very sore throat too?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, that too. As for very sore throat, I'd call it mild.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a fever?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, for about a week. With fever, I'd say severe. There's swollen glands in the neck as well.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How bad is it, would you say?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Maybe a three out of ten on a bad day.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
