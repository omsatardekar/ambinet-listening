    {
      "evidence_id": "EV_002",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I've got the readings for you. BP is 110 over 77, respiratory rate 21. Temp 38.1 degrees, BMI works out to 27.8, height 175 centimetres, pulse 104, weight 85 kilos, saturation 96 percent.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:44",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
