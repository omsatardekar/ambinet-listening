      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Oh, um, pretty severe, if I'm being honest.",
