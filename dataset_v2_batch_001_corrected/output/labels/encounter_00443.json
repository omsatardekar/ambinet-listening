      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I mean, I did have a dry cough at night at one point, but that's gone now.",
