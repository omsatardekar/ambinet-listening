  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I've been getting out of puff on the stairs. I kept putting it off, which I know isn't sensible. I thought it would sort itself out, but it hasn't.",
