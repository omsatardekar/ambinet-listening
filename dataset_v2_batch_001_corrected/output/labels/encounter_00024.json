      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had pain in that area?",
