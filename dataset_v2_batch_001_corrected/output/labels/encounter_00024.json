        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a red swollen area on your leg before, or is this the first time?",
