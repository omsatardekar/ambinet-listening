      "end_timestamp": "02:00",
      "supports": [
        "symptoms[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit, last year. It settled by itself back then.",
