      "end_timestamp": "01:26",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, for two days.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it constant, or does it come and go?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "it's a few times a day as for fever, moderate, really oh, and chills that's been about the same, three days as for chills, it's all the time",
