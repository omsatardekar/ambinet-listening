      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, one at a time. I'll ask about everything. Have you had an upset stomach in the mornings?",
