  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's been clearing my throat all the time, doctor. She didn't want to come, but I insisted.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is this recent, or has it been a while?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, uh, it's been three weeks, I'm fairly sure.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How would you describe it, mild, moderate, severe?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Pretty severe, if I'm being honest.",
      "start_timestamp": "00:53",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has there been a hoarse voice in the mornings too?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mm, yes.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any a dry cough that won't go away as well?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, actually. A burning in the chest after meals was there, but it's gone away on its own.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me what you take day to day.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:33",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She is on amlodipine, 5 milligrams, once a day, I give it to her. She takes pantoprazole, before breakfast for my acidity.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:46",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you know the dose?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:49",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's 40 milligrams.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:53",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has that been going on?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "About two months. It's Seretide inhaler, twice a day, doctor. She takes Digene, after meals.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:07",
      "supports": [
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Before this I was on Asthalin inhaler; that's been stopped.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:14",
      "supports": [
        "medications[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about your health in general, any ongoing conditions?",
      "start_timestamp": "02:15",
      "end_timestamp": "02:19",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, for nearly five years. I just want to get back to normal, really. I told myself I'd wait and see, and here I am.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:37",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything more?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:40",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Acid reflux, for five years. My family kept telling me to get it checked.",
      "start_timestamp": "02:42",
      "end_timestamp": "02:50",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And then?",
      "start_timestamp": "02:51",
      "end_timestamp": "02:52",
      "supports": [
        "medical_history.past_medical_history[2]"
      ]
