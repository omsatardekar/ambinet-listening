      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, give me more detail on it, whatever comes to mind.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a seven out of ten, I suppose. Only holding it further away, and it's not much. Oh, and glare from headlights at night. That's been about the same, about a month.",
