      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "does it come along with anything else?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "A runny nose goes along with it, most of the time. The runny nose? That's been for three weeks. As for runny nose, about a seven out of ten. Oh, you know, and a dry cough. That's been about the same, three days. With dry cough, I'd say on and off.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:45",
