      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "So, I've had it for three weeks. I'm hoping you can tell me something definite. I wasn't sure whether to come in at all, to be honest.",
