      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's worse with fatty food. I get some relief from lying still. I thought it would sort itself out, but it hasn't. I took the morning off to come in today.",
