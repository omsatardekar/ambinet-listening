    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have high cholesterol, for about ten years. It's a relief to finally sit down and talk about it.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:52",
      "supports": [
        "medical_history.past_medical_history[0]",
        "clinical_conditions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, so. Right, so high cholesterol is already on your record. We'll keep that in mind today. So, a few measurements, then we'll continue.",
      "start_timestamp": "02:53",
      "end_timestamp": "03:03",
      "supports": [
