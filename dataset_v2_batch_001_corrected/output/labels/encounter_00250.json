  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's been having trouble hearing in my left ear, doctor.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:26",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm-hm. Alright, would you call it mild or bad?",
      "start_timestamp": "00:27",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I'd give it a three, out of ten.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Have you had a feeling of fullness in the ear?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, about a month.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Would you call it mild or bad?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Pretty moderate, if I'm being honest. And there's a ringing noise as well, four weeks now.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's the pattern, is it there all day?",
      "start_timestamp": "01:18",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "01:23",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I'd say a few times a day.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few quick ones: discharge or ear pain?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:50",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "No, uh, none of that at all.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
