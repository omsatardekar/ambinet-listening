  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Honestly, it's stomach cramps, and my family pushed me to come. It's a relief to finally sit down and talk about it.",
