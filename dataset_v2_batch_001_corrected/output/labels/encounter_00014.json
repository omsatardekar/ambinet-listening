      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand the worry. At the moment I'd say it's a cough driven by acid reflux, and we'll know more once the a chest X-ray is back.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:44",
      "supports": [
        "clinical_assessment[0]"
      ]
