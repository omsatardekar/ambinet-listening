    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me tell you where I've got to. This looks most like a cough driven by acid reflux. I want to be honest that this is an impression, not a final answer.",
