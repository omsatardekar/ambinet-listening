      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "We came because of swollen ankles in the evening.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:26",
