      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "For two months, I'd say.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:36",
