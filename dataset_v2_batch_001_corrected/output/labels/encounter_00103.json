        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Is there anything that takes the edge off?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It settles a little with raising the legs.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Is it mild, moderate or severe?",
      "start_timestamp": "00:49",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Does anything bring it on or make it worse?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Standing all day definitely sets it off.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Anything that tends to go along with it?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "When it starts I tend to get a heavy feeling in the legs as well. I've also had a flushed face sometimes. As for flushed face sometimes, a seven out of ten, I suppose.",
