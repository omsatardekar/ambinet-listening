      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had pain in your right ear before, or is this the first time?",
      "start_timestamp": "01:22",
