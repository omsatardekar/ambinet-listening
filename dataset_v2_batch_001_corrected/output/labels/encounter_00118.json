      "end_timestamp": "01:42",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had to have anything operated on?",
