      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, um, that too.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps.",
