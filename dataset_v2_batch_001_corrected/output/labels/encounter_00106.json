  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "So, mainly a very painful, swollen big toe. There's a couple of other things, but that's the main one.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:39",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did it begin? I ask because it helps me narrow things down.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I mean, it's been two weeks now.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How would you describe it, mild, moderate, severe?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:00",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Severe, really.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's the pattern, is it there all day?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's on and off.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a low fever?",
      "start_timestamp": "02:00",
