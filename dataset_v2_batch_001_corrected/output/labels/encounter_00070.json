      "transcript_text": "Do you have the packet or the prescription with you?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:59",
      "supports": [
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Hmm, no, it's at home.",
