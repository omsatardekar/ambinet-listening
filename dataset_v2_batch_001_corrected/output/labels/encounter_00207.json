        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been feeling faint at any time before this?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
