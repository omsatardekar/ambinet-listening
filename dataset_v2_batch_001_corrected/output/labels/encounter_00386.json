      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it mild, moderate or severe?",
      "start_timestamp": "00:46",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Maybe a three out of ten on a bad day.",
