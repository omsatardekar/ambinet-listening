  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's, It's hives. I thought I'd wait, but it hasn't gone.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:35",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Roughly when did it start?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Okay, so it's been ten days now.",
      "start_timestamp": "00:41",
