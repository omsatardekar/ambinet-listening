      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How intense does it get?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, you know, I'd give it a four, out of ten. There was stiffness, yes, but that went away.",
