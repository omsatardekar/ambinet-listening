      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yeah, that too. I did have a runny nose in the mornings at one point, but that's gone now.",
