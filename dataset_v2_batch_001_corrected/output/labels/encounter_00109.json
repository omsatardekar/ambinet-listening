      "speaker_role": "patient",
      "transcript_text": "Mostly severe.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about a tickle in the chest, have you noticed that?",
      "start_timestamp": "02:03",
