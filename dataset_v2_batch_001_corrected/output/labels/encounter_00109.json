  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, I've been having a dry cough at night. I've never really been one for hospitals. A neighbour of mine said I should see someone about it.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:44",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I'd say a week, maybe.",
      "start_timestamp": "00:54",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I think it's been nearer two weeks, actually.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, so roughly one to two weeks. Is that right?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I suppose so, yes.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's once or twice a day. Yes, cold air. That makes it worse.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. What about a mild wheeze at times, have you noticed that?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:51",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yeah, that too.",
      "start_timestamp": "01:51",
      "end_timestamp": "01:53",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How would you describe it, mild, moderate, severe?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
