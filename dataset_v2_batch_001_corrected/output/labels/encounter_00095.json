    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, years back I got wheezing from aspirin, so I stay away from it now.",
      "start_timestamp": "02:43",
