        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Metformin, 500 milligrams, twice a day for my sugar. It's losartan, 50 milligrams, once a day. Um, I take Vertin, 16 milligrams, when it comes. Right, before this I was on ramipril; that's been stopped.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:19",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
