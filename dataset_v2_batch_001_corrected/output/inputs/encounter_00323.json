  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 4.12,
      "duration_seconds": 2.76,
      "text": "Afternoon. Take the chair by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.19,
      "end_seconds": 9.89,
      "duration_seconds": 0.7,
      "text": "Hello."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.29,
      "end_seconds": 21.04,
      "duration_seconds": 6.75,
      "text": "Uh, um, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.32,
      "end_seconds": 28.75,
      "duration_seconds": 3.43,
      "text": "Tell me from the beginning, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 29.79,
      "end_seconds": 33.07,
      "duration_seconds": 3.28,
      "text": "Uh, we came because of swelling."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.85,
      "end_seconds": 36.29,
      "duration_seconds": 2.44,
      "text": "How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.97,
      "end_seconds": 53.15,
      "duration_seconds": 15.18,
      "text": "Right, I've had it for five days. I'd rather not end up on lots of tablets if I can avoid it. I had tingling in the fingers before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.14,
      "end_seconds": 55.96,
      "duration_seconds": 1.82,
      "text": "Any loss of consciousness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.2,
      "end_seconds": 59.86,
      "duration_seconds": 2.66,
      "text": "No. No loss of consciousness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.93,
      "end_seconds": 66.14,
      "duration_seconds": 5.21,
      "text": "Any pain in the shoulder, numbness or pain in the elbow?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.8,
      "end_seconds": 74.73,
      "duration_seconds": 6.93,
      "text": "No, no pain in the shoulder, numbness or pain in the elbow."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.24,
      "end_seconds": 78.25,
      "duration_seconds": 3.01,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.17,
      "end_seconds": 84.11,
      "duration_seconds": 0.94,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.97,
      "end_seconds": 91.28,
      "duration_seconds": 5.31,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.25,
      "end_seconds": 94.85,
      "duration_seconds": 1.6,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.65,
      "end_seconds": 99.09,
      "duration_seconds": 3.44,
      "text": "Alright, are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.47,
      "end_seconds": 103.96,
      "duration_seconds": 3.49,
      "text": "Alendronate. I take it once a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.04,
      "end_seconds": 108.05,
      "duration_seconds": 2.01,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.02,
      "end_seconds": 111.67,
      "duration_seconds": 1.65,
      "text": "It's 70 milligrams."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.69,
      "end_seconds": 118.02,
      "duration_seconds": 4.33,
      "text": "Moving on to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 132.13,
      "duration_seconds": 12.51,
      "text": "I've got thin bones. Um, I've had high cholesterol for about a year now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.84,
      "end_seconds": 139.33,
      "duration_seconds": 6.49,
      "text": "Mm. Yes, thin bones is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.95,
      "end_seconds": 148.54,
      "duration_seconds": 1.59,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.61,
      "end_seconds": 154.35,
      "duration_seconds": 4.74,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.88,
      "end_seconds": 158.11,
      "duration_seconds": 2.23,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.1,
      "end_seconds": 164.85,
      "duration_seconds": 4.75,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.15,
      "end_seconds": 168.57,
      "duration_seconds": 2.42,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.23,
      "end_seconds": 171.96,
      "duration_seconds": 2.73,
      "text": "Well, no, nothing like that."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 174.46,
      "duration_seconds": 1.95,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.51,
      "end_seconds": 184.1,
      "duration_seconds": 2.59,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.12,
      "end_seconds": 208.62,
      "duration_seconds": 15.5,
      "text": "Okay: oxygen saturation is 97 percent, pulse is 69 beats a minute. And weight 78 kilos, respiratory rate 15, temperature is 36.9 degrees, BMI works out to 23.5, pressure 121 over 68, height 182 centimetres."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.19,
      "end_seconds": 214.16,
      "duration_seconds": 2.97,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.54,
      "end_seconds": 217.62,
      "duration_seconds": 2.08,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.31,
      "end_seconds": 230.26,
      "duration_seconds": 3.95,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.35,
      "end_seconds": 233.53,
      "duration_seconds": 2.18,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 256.54,
      "duration_seconds": 6.79,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.69,
      "end_seconds": 261.36,
      "duration_seconds": 2.67,
      "text": "Thanks, please take a seat again."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.52,
      "end_seconds": 290.87,
      "duration_seconds": 16.35,
      "text": "Right, here's what I'm thinking. It fits best with a wrist sprain, but a small fracture is possible. The reason I say that is that your story and my examination fit together. A scaphoid fracture is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.78,
      "end_seconds": 296.09,
      "duration_seconds": 2.31,
      "text": "Do you think it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.38,
      "end_seconds": 311.21,
      "duration_seconds": 10.83,
      "text": "I can't promise yet, but most people with a wrist sprain, but a small fracture is possible do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.09,
      "end_seconds": 325.06,
      "duration_seconds": 5.97,
      "text": "I'm going to order an X-ray of the wrist, for wrist injury."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.68,
      "end_seconds": 328.35,
      "duration_seconds": 2.67,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.1,
      "end_seconds": 339.39,
      "duration_seconds": 9.29,
      "text": "I'd like you to take paracetamol, 650 milligrams, three times a day, for five days. That's for wrist pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.47,
      "end_seconds": 346.14,
      "duration_seconds": 4.67,
      "text": "Okay, um, and I take that after food?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.39,
      "end_seconds": 369.35,
      "duration_seconds": 21.96,
      "text": "I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. Let's get you seen by the orthopaedic clinic, I'll arrange the letter. Come back or go to emergency straight away if the symptoms get worse. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.52,
      "end_seconds": 374.67,
      "duration_seconds": 2.15,
      "text": "No questions. Thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.74,
      "end_seconds": 378.02,
      "duration_seconds": 1.28,
      "text": "Bye for now."
    }
  ]
}