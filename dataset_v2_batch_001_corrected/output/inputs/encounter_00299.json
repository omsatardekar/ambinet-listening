      "role": "PATIENT",
      "start_seconds": 17.91,
      "end_seconds": 27.64,
      "duration_seconds": 9.73,
      "text": "honestly, it's aching legs, and and my family pushed me to come i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 30.78,
      "duration_seconds": 2.38,
      "text": "How long have you had it?"
