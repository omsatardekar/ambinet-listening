    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.92,
      "end_seconds": 184.68,
      "duration_seconds": 3.76,
      "text": "What about your tummy and bowels anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.69,
      "end_seconds": 187.68,
      "duration_seconds": 1.99,
      "text": "No, all normal there."
