      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.16,
      "end_seconds": 80.06,
      "duration_seconds": 1.9,
      "text": "rest your hand here.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.65,
      "end_seconds": 115.33,
      "duration_seconds": 14.68,
      "text": "Okay: temp 36.6 degrees, height 164 centimetres, respiratory rate 15. And pressure 116 over 78, weight 68 kilos, SpO2 98 percent on room air, pulse is 71 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.75,
      "end_seconds": 119.56,
      "duration_seconds": 2.81,
      "text": "Well, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.35,
      "end_seconds": 124.23,
      "duration_seconds": 2.88,
      "text": "I'll interpret it once I've examined you"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.02,
      "end_seconds": 128.96,
