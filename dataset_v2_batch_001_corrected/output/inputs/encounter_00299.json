      "start_seconds": 170.29,
      "end_seconds": 172.24,
      "duration_seconds": 1.95,
      "text": "no no chest pain"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.64,
      "end_seconds": 176.51,
      "duration_seconds": 2.87,
      "text": "Any shortness of breath, rash or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.72,
      "end_seconds": 179.64,
      "duration_seconds": 1.92,
      "text": "no none of those"
