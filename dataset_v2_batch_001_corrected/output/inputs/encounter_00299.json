    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 64.82,
      "duration_seconds": 11.21,
      "text": "When it starts I tend to to get poor sleep as well. Um the poor sleep? That's been since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.9,
      "end_seconds": 69.71,
      "duration_seconds": 3.81,
      "text": "okay, first the numbers, if you don't mind"
    },
