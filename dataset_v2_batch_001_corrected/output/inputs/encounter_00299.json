      "text": "I'd like to examine you now"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 131.46,
      "duration_seconds": 1.66,
