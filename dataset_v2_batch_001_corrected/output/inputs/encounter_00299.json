    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.48,
      "end_seconds": 168.27,
      "duration_seconds": 1.79,
      "text": "how about chest pain?"
