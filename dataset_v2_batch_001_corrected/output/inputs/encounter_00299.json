    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.34,
      "end_seconds": 40.04,
      "duration_seconds": 7.7,
      "text": "right, I'd say three days actually, no, closer to to about four days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.61,
      "end_seconds": 43.88,
      "duration_seconds": 2.27,
      "text": "How intense does it get?"
