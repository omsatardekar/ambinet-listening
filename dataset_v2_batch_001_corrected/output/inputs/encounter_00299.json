      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.06,
      "end_seconds": 338.56,
      "duration_seconds": 2.5,
      "text": "Yes I can do that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.23,
      "end_seconds": 343.68,
      "duration_seconds": 3.45,
      "text": "good let us know how you get on"
    },
    {
      "segment_id": "SEG0048",
