    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.53,
      "end_seconds": 190.93,
      "duration_seconds": 2.4,
      "text": "Anything unusual with passing urine?"
