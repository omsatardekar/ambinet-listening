    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 196.43,
      "duration_seconds": 3.82,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 217.64,
      "duration_seconds": 3.32,
      "text": "Okay, have you ever been under the knife?"
