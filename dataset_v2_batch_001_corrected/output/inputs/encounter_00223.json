{
  "schema_version": "1.0",
  "encounter_id": "00223",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.79,
      "duration_seconds": 4.41,
      "text": "Hi, doctor. Long queue outside, but here I am."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.38,
      "end_seconds": 10.18,
      "duration_seconds": 3.8,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.08,
      "end_seconds": 23.36,
      "duration_seconds": 11.28,
      "text": "Yeah, it's a rattling chest. I don't know what's causing it. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.13,
      "end_seconds": 27.89,
      "duration_seconds": 3.76,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.63,
      "end_seconds": 31.52,
      "duration_seconds": 2.89,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.99,
      "end_seconds": 36.08,
      "duration_seconds": 3.09,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.27,
      "end_seconds": 38.77,
      "duration_seconds": 1.5,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.99,
      "end_seconds": 42.17,
      "duration_seconds": 3.18,
      "text": "Go on. How intense does it get?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.15,
      "end_seconds": 54.75,
      "duration_seconds": 11.6,
      "text": "A seven out of ten, I suppose. Hmm, I've also had poor sleep because of the cough, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.25,
      "end_seconds": 74.1,
      "duration_seconds": 4.85,
      "text": "Any weight loss, fever, coughing up blood or swollen ankles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.89,
      "end_seconds": 80.63,
      "duration_seconds": 2.74,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.17,
      "end_seconds": 85.81,
      "duration_seconds": 3.64,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.26,
      "end_seconds": 89.66,
      "duration_seconds": 2.4,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.11,
      "end_seconds": 93.06,
      "duration_seconds": 1.95,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.73,
      "end_seconds": 97.06,
      "duration_seconds": 3.33,
      "text": "Uh, no, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.53,
      "end_seconds": 101.37,
      "duration_seconds": 2.84,
      "text": "Alright, have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.66,
      "end_seconds": 110.74,
      "duration_seconds": 8.08,
      "text": "I have COPD, for five years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.37,
      "end_seconds": 113.31,
      "duration_seconds": 0.94,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.87,
      "end_seconds": 124.08,
      "duration_seconds": 7.21,
      "text": "Uh, yes, high blood pressure. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.84,
      "end_seconds": 127.62,
      "duration_seconds": 1.78,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.01,
      "end_seconds": 134.37,
      "duration_seconds": 5.36,
      "text": "Okay, I can see COPD in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.34,
      "end_seconds": 139.08,
      "duration_seconds": 1.74,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.83,
      "end_seconds": 142.47,
      "duration_seconds": 1.64,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.71,
      "end_seconds": 146.3,
      "duration_seconds": 2.59,
      "text": "I don't drink at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.58,
      "end_seconds": 149.62,
      "duration_seconds": 2.04,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.23,
      "end_seconds": 153.82,
      "duration_seconds": 3.59,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.34,
      "end_seconds": 156.35,
      "duration_seconds": 2.01,
      "text": "Tell me about your work."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.2,
      "end_seconds": 163.28,
      "duration_seconds": 6.08,
      "text": "I'm a software engineer, so I'm at a screen all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.26,
      "end_seconds": 166.73,
      "duration_seconds": 2.47,
      "text": "Are you active at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.64,
      "end_seconds": 170.51,
      "duration_seconds": 2.87,
      "text": "Barely, I'm mostly sedentary these days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.5,
      "end_seconds": 178.33,
      "duration_seconds": 6.83,
      "text": "Any drug or food allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.3,
      "end_seconds": 182.74,
      "duration_seconds": 3.44,
      "text": "Oh, yes, ibuprofen. I get stomach pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.86,
      "end_seconds": 201.63,
      "duration_seconds": 2.77,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.41,
      "end_seconds": 215.78,
      "duration_seconds": 2.37,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.24,
      "end_seconds": 248.39,
      "duration_seconds": 12.15,
      "text": "Okay: temperature is 37.5 degrees, heart rate 98. And respiratory rate 20, blood pressure 119 over 75, SpO2 90 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.02,
      "end_seconds": 253.3,
      "duration_seconds": 3.28,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.82,
      "end_seconds": 256.94,
      "duration_seconds": 2.12,
      "text": "Hold that position for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 277.68,
      "duration_seconds": 6.14,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.94,
      "end_seconds": 280.19,
      "duration_seconds": 1.25,
      "text": "Yes, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.94,
      "end_seconds": 298.03,
      "duration_seconds": 15.09,
      "text": "Thanks, please take a seat again. Let me tell you where I've got to. I don't have a clear answer today: a flare-up of COPD is possible, and so is pneumonia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.21,
      "end_seconds": 314.54,
      "duration_seconds": 7.33,
      "text": "I'm going to order blood tests, for infective exacerbation. I'm going to order a chest X-ray, for breathlessness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.2,
      "end_seconds": 318.74,
      "duration_seconds": 2.54,
      "text": "Alright, when would that be?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 325.65,
      "duration_seconds": 6.29,
      "text": "Let's use doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.18,
      "end_seconds": 331.03,
      "duration_seconds": 4.85,
      "text": "Should I keep taking it if I feel better?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.45,
      "end_seconds": 356.36,
      "duration_seconds": 23.91,
      "text": "I'll start you on prednisolone, 30 milligrams, once a day, for five days. That should help with COPD flare-up. I'll put all of this in writing so you don't have to remember it. If you become more breathless or your lips turn blue, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.96,
      "end_seconds": 359.64,
      "duration_seconds": 1.68,
      "text": "Okay, I'll remember."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.33,
      "end_seconds": 364.9,
      "duration_seconds": 3.57,
      "text": "I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.5,
      "end_seconds": 369.2,
      "duration_seconds": 0.7,
      "text": "Fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.87,
      "end_seconds": 372.32,
      "duration_seconds": 1.45,
      "text": "Any last questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.32,
      "end_seconds": 376.39,
      "duration_seconds": 3.07,
      "text": "I, I appreciate it, doctor."
    }
  ]
}