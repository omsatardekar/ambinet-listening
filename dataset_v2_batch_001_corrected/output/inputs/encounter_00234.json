{
  "schema_version": "1.0",
  "encounter_id": "00234",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 3.98,
      "duration_seconds": 3.4,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.92,
      "end_seconds": 9.48,
      "duration_seconds": 4.56,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 14.59,
      "duration_seconds": 3.22,
      "text": "I wanted to get nausea looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.28,
      "end_seconds": 18.74,
      "duration_seconds": 3.46,
      "text": "Okay, since when have you had this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.65,
      "end_seconds": 29.31,
      "duration_seconds": 4.66,
      "text": "So, it's been like this since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.4,
      "end_seconds": 34.37,
      "duration_seconds": 3.97,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.46,
      "end_seconds": 39.19,
      "duration_seconds": 2.73,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.93,
      "end_seconds": 41.89,
      "duration_seconds": 1.96,
      "text": "Any operations in the past?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.97,
      "end_seconds": 47.98,
      "duration_seconds": 5.01,
      "text": "Just cataract surgery on my right eye, last year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.48,
      "end_seconds": 53.32,
      "duration_seconds": 3.84,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.37,
      "end_seconds": 62.03,
      "duration_seconds": 7.66,
      "text": "I'm on amlodipine, 5 milligrams, once a day. Vertin. I take it when it comes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.57,
      "end_seconds": 70.19,
      "duration_seconds": 2.62,
      "text": "Right, and what strength is that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.92,
      "end_seconds": 73.01,
      "duration_seconds": 1.09,
      "text": "16 milligrams."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.91,
      "end_seconds": 77.83,
      "duration_seconds": 2.92,
      "text": "Alright, what do you do for work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.46,
      "end_seconds": 83.46,
      "duration_seconds": 5.0,
      "text": "I work in an office, mostly sitting at a desk."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.5,
      "end_seconds": 86.09,
      "duration_seconds": 1.59,
      "text": "What's your diet like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.71,
      "end_seconds": 91.09,
      "duration_seconds": 4.38,
      "text": "I eat out quite a lot, to be honest."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.92,
      "end_seconds": 98.09,
      "duration_seconds": 6.17,
      "text": "Alright, any diagnoses you've been given before? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.01,
      "end_seconds": 101.99,
      "duration_seconds": 1.98,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.09,
      "end_seconds": 104.05,
      "duration_seconds": 0.96,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.79,
      "end_seconds": 123.51,
      "duration_seconds": 9.72,
      "text": "Have you ever reacted badly to a medicine or food? Any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.49,
      "end_seconds": 133.31,
      "duration_seconds": 7.82,
      "text": "I was told I'm allergic to pollen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.13,
      "end_seconds": 150.7,
      "duration_seconds": 4.57,
      "text": "Have you noticed numbness in the face, headache or double vision?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.01,
      "end_seconds": 153.8,
      "duration_seconds": 1.79,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.17,
      "end_seconds": 157.83,
      "duration_seconds": 3.66,
      "text": "Mm-hm. Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.38,
      "end_seconds": 162.42,
      "duration_seconds": 3.04,
      "text": "Hmm, no, that's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.07,
      "end_seconds": 180.88,
      "duration_seconds": 1.81,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.73,
      "end_seconds": 193.16,
      "duration_seconds": 2.43,
      "text": "Okay, give me a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.62,
      "end_seconds": 212.41,
      "duration_seconds": 7.79,
      "text": "Okay: saturation 97 percent, temperature is 36.7 degrees, blood pressure 112 over 75, pulse 67."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.25,
      "end_seconds": 217.45,
      "duration_seconds": 3.2,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.53,
      "end_seconds": 220.35,
      "duration_seconds": 1.82,
      "text": "Let me press here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.06,
      "end_seconds": 239.04,
      "duration_seconds": 3.98,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.86,
      "end_seconds": 242.85,
      "duration_seconds": 2.99,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.44,
      "end_seconds": 260.52,
      "duration_seconds": 7.08,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.3,
      "end_seconds": 278.92,
      "duration_seconds": 13.62,
      "text": "Okay, you can sit up. Putting it all together, my working impression is benign positional vertigo. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.61,
      "end_seconds": 292.41,
      "duration_seconds": 4.8,
      "text": "I'll request a hearing test, it'll help with tinnitus and vertigo."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.12,
      "end_seconds": 294.27,
      "duration_seconds": 1.15,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.14,
      "end_seconds": 306.75,
      "duration_seconds": 10.61,
      "text": "Get up slowly from lying down and sit for a moment first. Let's plan a check in two weeks. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.72,
      "end_seconds": 310.33,
      "duration_seconds": 2.61,
      "text": "Alright, thanks. Bye for now."
    }
  ]
}