{
  "schema_version": "1.0",
  "encounter_id": "00303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.09,
      "end_seconds": 6.17,
      "duration_seconds": 5.08,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 11.79,
      "duration_seconds": 3.74,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.55,
      "end_seconds": 19.3,
      "duration_seconds": 5.75,
      "text": "hello, doctor. I hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.09,
      "end_seconds": 23.62,
      "duration_seconds": 3.53,
      "text": "yes, that's no problem at all. Please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.19,
      "end_seconds": 27.44,
      "duration_seconds": 3.25,
      "text": "he's been having a cough, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.81,
      "end_seconds": 33.35,
      "duration_seconds": 4.54,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 34.37,
      "end_seconds": 37.03,
      "duration_seconds": 2.66,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.69,
      "end_seconds": 40.86,
      "duration_seconds": 3.17,
      "text": "do you notice anything setting it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 42.31,
      "end_seconds": 47.81,
      "duration_seconds": 5.5,
      "text": "Yes, um, cold air. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 51.59,
      "duration_seconds": 2.38,
      "text": "any a low fever as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 52.6,
      "end_seconds": 55.72,
      "duration_seconds": 3.12,
      "text": "yeah. About a week, I'd say"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.53,
      "end_seconds": 60.61,
      "duration_seconds": 3.08,
      "text": "Is it it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 65.56,
      "end_seconds": 69.21,
      "duration_seconds": 3.65,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.75,
      "end_seconds": 76.15,
      "duration_seconds": 6.4,
      "text": "and and what about leg swelling, chest pain, weight loss or night sweats?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 79.35,
      "end_seconds": 95.45,
      "duration_seconds": 16.1,
      "text": "well, no, no leg swelling, no chest pain, no weight loss. I did have a sore throat at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.91,
      "end_seconds": 99.59,
      "duration_seconds": 2.68,
      "text": "any sign of coughing up blood?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 105.66,
      "duration_seconds": 4.08,
      "text": "Not that I've noticed, no coughing up blood."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.42,
      "end_seconds": 109.9,
      "duration_seconds": 3.48,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 111.32,
      "end_seconds": 116.99,
      "duration_seconds": 5.67,
      "text": "my heart's been fine, uh, as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.85,
      "end_seconds": 120.46,
      "duration_seconds": 1.61,
      "text": "any procedures or operations?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 121.87,
      "end_seconds": 127.91,
      "duration_seconds": 6.04,
      "text": "Right, I had a hernia repair about five years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.3,
      "end_seconds": 131.58,
      "duration_seconds": 2.28,
      "text": "Who do you live with?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 136.17,
      "end_seconds": 141.3,
      "duration_seconds": 5.13,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.66,
      "end_seconds": 145.48,
      "duration_seconds": 2.82,
      "text": "Before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 146.04,
      "end_seconds": 150.25,
      "duration_seconds": 4.21,
      "text": "I'm allergic to penicillin, I get a rash"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.87,
      "end_seconds": 155.11,
      "duration_seconds": 4.24,
      "text": "Moving on to to your background, any past medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 161.1,
      "end_seconds": 164.63,
      "duration_seconds": 3.53,
      "text": "I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.67,
      "end_seconds": 167.06,
      "duration_seconds": 1.39,
      "text": "Okay, keep going."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 171.54,
      "end_seconds": 195.18,
      "duration_seconds": 23.64,
      "text": "yes, high blood pressure i wasn't sure whether to come in at all, to be honest my sister suggested writing things down, but I forgot yes, migraines a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.91,
      "end_seconds": 198.17,
      "duration_seconds": 1.26,
      "text": "Is there more?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.24,
      "end_seconds": 212.73,
      "duration_seconds": 12.49,
      "text": "Yes, asthma and high blood pressure are known to us, good to have that clear. Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 213.39,
      "end_seconds": 215.55,
      "duration_seconds": 2.16,
      "text": "Asthalin inhaler, when needed"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.15,
      "end_seconds": 224.64,
      "duration_seconds": 7.49,
      "text": "Yeah, that's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 226.23,
      "end_seconds": 233.23,
      "duration_seconds": 7.0,
      "text": "Telmisartan. I take it 40 milligrams, maybe, once a day for my pressure."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.79,
      "end_seconds": 241.4,
      "duration_seconds": 4.61,
      "text": "Okay, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 242.36,
      "end_seconds": 264.73,
      "duration_seconds": 22.37,
      "text": "No, it's at home. I'm on sumatriptan, 50 milligrams, when needed for my migraines. Oh, I take paracetamol, 500 milligrams, when needed. Um, I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 277.27,
      "end_seconds": 286.6,
      "duration_seconds": 9.33,
      "text": "Here are the numbers, doctor. Pulse 90, BP is 119 over 75, respiratory rate 20. Temp 38.3 degrees, saturation 96 percent."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.6,
      "end_seconds": 306.34,
      "duration_seconds": 18.74,
      "text": "Thanks. Okay, so my impression from what you've said is this: My working impression is a chest infection, probably viral. The reason I say that is that the way you describe it fits together. I'd also keep pneumonia in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 307.36,
      "end_seconds": 312.05,
      "duration_seconds": 4.69,
      "text": "I mean, what are the chances it's something bad?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.1,
      "end_seconds": 320.72,
      "duration_seconds": 7.62,
      "text": "I can't promise yet, but most people with a chest infection, probably viral do well once it's treated properly"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.18,
      "end_seconds": 339.91,
      "duration_seconds": 3.73,
      "text": "I think blood tests makes sense here, for cough"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 340.96,
      "end_seconds": 344.36,
      "duration_seconds": 3.4,
      "text": "we've already done a chest X-ray this morning, doctor"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.07,
      "end_seconds": 370.86,
      "duration_seconds": 24.79,
      "text": "Thanks, I'll look at that. The treatment will be azithromycin, 500 milligrams, once a day, for three days. It's for chest infection. Steam and warm fluids can ease the cough, and try to sleep with your head propped up. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 371.46,
      "end_seconds": 372.55,
      "duration_seconds": 1.09,
      "text": "that's clear"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.52,
      "end_seconds": 385.58,
      "duration_seconds": 12.06,
      "text": "If you become breathless or cough up blood, that's the point to come in urgently. See me again in a week. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 386.29,
      "end_seconds": 390.09,
      "duration_seconds": 3.8,
      "text": "One thing: no, actually that's all. Thanks."
    }
  ]
}