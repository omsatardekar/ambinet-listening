{
  "schema_version": "1.0",
  "encounter_id": "00107",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.07,
      "end_seconds": 5.7,
      "duration_seconds": 4.63,
      "text": "ready for you, doctor i'll stay in case you need anything"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 9.97,
      "duration_seconds": 3.19,
      "text": "thank you right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.64,
      "end_seconds": 21.72,
      "duration_seconds": 6.08,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.9,
      "end_seconds": 26.21,
      "duration_seconds": 3.31,
      "text": "Well, I've been having trouble concentrating."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.75,
      "end_seconds": 31.8,
      "duration_seconds": 5.05,
      "text": "When did it begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.47,
      "end_seconds": 36.15,
      "duration_seconds": 2.68,
      "text": "I've had it since last weekend"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.97,
      "end_seconds": 40.87,
      "duration_seconds": 2.9,
      "text": "Is it mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.54,
      "end_seconds": 60.11,
      "duration_seconds": 18.57,
      "text": "it feels severe to me. I've also been feeling cold, for about two weeks. Oh, and hair falling out. And constant tiredness, too. As for constant tiredness, a good night's sleep helps a bit"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.36,
      "end_seconds": 64.31,
      "duration_seconds": 2.95,
      "text": "are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.89,
      "end_seconds": 69.19,
      "duration_seconds": 3.3,
      "text": "Glycomet, 500 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.22,
      "end_seconds": 79.38,
      "duration_seconds": 8.16,
      "text": "She is supposed to take it twice a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.33,
      "end_seconds": 86.64,
      "duration_seconds": 5.31,
      "text": "Spironolactone. I take it 25 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.42,
      "end_seconds": 96.11,
      "duration_seconds": 4.69,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.89,
      "end_seconds": 102.54,
      "duration_seconds": 4.65,
      "text": "Not with me. I'll bring it it next time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.8,
      "end_seconds": 114.02,
      "duration_seconds": 1.22,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.55,
      "end_seconds": 117.07,
      "duration_seconds": 1.52,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.81,
      "end_seconds": 123.29,
      "duration_seconds": 5.48,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.38,
      "end_seconds": 132.51,
      "duration_seconds": 8.13,
      "text": "I have diabetes, for two years. Hmm, I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.1,
      "end_seconds": 147.94,
      "duration_seconds": 9.84,
      "text": "right, so heart failure is already on your record we'll keep that in mind today any allergies I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.09,
      "end_seconds": 152.57,
      "duration_seconds": 3.48,
      "text": "Yes, ibuprofen. I get stomach pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.47,
      "end_seconds": 167.31,
      "duration_seconds": 4.84,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.35,
      "end_seconds": 183.55,
      "duration_seconds": 12.2,
      "text": "A beer or two most evenings, to be honest. I skip breakfast most days. I go to the gym a couple of times a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.66,
      "end_seconds": 205.15,
      "duration_seconds": 4.49,
      "text": "And what about blood in the stool or low mood?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.73,
      "end_seconds": 211.03,
      "duration_seconds": 4.3,
      "text": "No, no blood in the stool or low mood."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.99,
      "end_seconds": 215.28,
      "duration_seconds": 2.29,
      "text": "did you notice any fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.35,
      "end_seconds": 218.99,
      "duration_seconds": 1.64,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 220.47,
      "end_seconds": 225.39,
      "duration_seconds": 4.92,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.96,
      "end_seconds": 232.76,
      "duration_seconds": 6.8,
      "text": "no, I don't think I did. Maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.43,
      "end_seconds": 244.12,
      "duration_seconds": 10.69,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about shortness of breath, chest pain or night sweats?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.72,
      "end_seconds": 247.53,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.21,
      "end_seconds": 254.14,
      "duration_seconds": 4.93,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.2,
      "end_seconds": 256.97,
      "duration_seconds": 1.77,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.09,
      "end_seconds": 263.48,
      "duration_seconds": 2.39,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.01,
      "end_seconds": 267.0,
      "duration_seconds": 1.99,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 268.15,
      "end_seconds": 275.81,
      "duration_seconds": 7.66,
      "text": "Here are the numbers, doctor. Heart rate 77, temperature 36.8, BP is 115 over 80, saturation 99 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.49,
      "end_seconds": 278.05,
      "duration_seconds": 1.56,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.65,
      "end_seconds": 283.81,
      "duration_seconds": 3.16,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.47,
      "end_seconds": 288.5,
      "duration_seconds": 3.03,
      "text": "Alright, almost done with this part."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.0,
      "end_seconds": 304.52,
      "duration_seconds": 3.52,
      "text": "You look a little pale in the eyelids."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 305.75,
      "end_seconds": 306.69,
      "duration_seconds": 0.94,
      "text": "that's fine"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.29,
      "end_seconds": 311.06,
      "duration_seconds": 2.77,
      "text": "let me look at this properly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.79,
      "end_seconds": 328.4,
      "duration_seconds": 5.61,
      "text": "your thyroid isn't enlarged, I can't feel any lumps in your neck"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.5,
      "end_seconds": 360.01,
      "duration_seconds": 27.51,
      "text": "Okay, you can sit up. Okay, so my impression is this: This looks most like persistent tiredness, possibly from low iron. Vitamin deficiency is still possible. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Today I'm not changing anything. Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.84,
      "end_seconds": 364.64,
      "duration_seconds": 2.8,
      "text": "Oh, no questions. Thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.1,
      "end_seconds": 367.55,
      "duration_seconds": 1.45,
      "text": "Bye for now."
    }
  ]
}