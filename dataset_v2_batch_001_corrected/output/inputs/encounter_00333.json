{
  "schema_version": "1.0",
  "encounter_id": "00333",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.72,
      "end_seconds": 7.85,
      "duration_seconds": 7.13,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.68,
      "end_seconds": 14.53,
      "duration_seconds": 4.85,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.68,
      "end_seconds": 19.05,
      "duration_seconds": 3.37,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.03,
      "end_seconds": 28.28,
      "duration_seconds": 7.25,
      "text": "Hmm, it's a bad cough. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.15,
      "end_seconds": 33.35,
      "duration_seconds": 4.2,
      "text": "Is this recent, or has it been a while?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.61,
      "end_seconds": 36.78,
      "duration_seconds": 2.17,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.95,
      "end_seconds": 40.8,
      "duration_seconds": 2.85,
      "text": "How bad is it, would you say?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.53,
      "end_seconds": 43.63,
      "duration_seconds": 1.1,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 48.04,
      "duration_seconds": 3.89,
      "text": "Is it constant, or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.09,
      "end_seconds": 55.26,
      "duration_seconds": 6.17,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.47,
      "end_seconds": 63.47,
      "duration_seconds": 7.0,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.78,
      "end_seconds": 67.42,
      "duration_seconds": 2.64,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.04,
      "end_seconds": 74.35,
      "duration_seconds": 6.31,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 74.45,
      "end_seconds": 79.66,
      "duration_seconds": 5.21,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.3,
      "end_seconds": 87.14,
      "duration_seconds": 6.84,
      "text": "I was getting to that! I've also had a sore throat, for two days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.75,
      "end_seconds": 91.68,
      "duration_seconds": 2.93,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.58,
      "end_seconds": 102.75,
      "duration_seconds": 9.17,
      "text": "I mean, I'd give it a six, out of ten. There's a low fever as well."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.56,
      "end_seconds": 105.59,
      "duration_seconds": 2.03,
      "text": "How intense does it get?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.25,
      "end_seconds": 109.01,
      "duration_seconds": 1.76,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.5,
      "end_seconds": 114.97,
      "duration_seconds": 5.47,
      "text": "I see. And what about leg swelling, chest pain or night sweats?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.74,
      "end_seconds": 128.95,
      "duration_seconds": 13.21,
      "text": "No, no leg swelling, no chest pain, no night sweats. I was coughing up yellow phlegm at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.23,
      "end_seconds": 135.13,
      "duration_seconds": 4.9,
      "text": "Have you noticed shortness of breath, weight loss or coughing up blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.57,
      "end_seconds": 143.3,
      "duration_seconds": 6.73,
      "text": "No shortness of breath, weight loss or coughing up blood, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.21,
      "end_seconds": 148.49,
      "duration_seconds": 3.28,
      "text": "Alright, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.24,
      "end_seconds": 151.59,
      "duration_seconds": 2.35,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.67,
      "end_seconds": 167.42,
      "duration_seconds": 2.75,
      "text": "Any allergies I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.45,
      "end_seconds": 178.49,
      "duration_seconds": 10.04,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.78,
      "end_seconds": 188.55,
      "duration_seconds": 2.77,
      "text": "What about operations, anything like that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.38,
      "end_seconds": 195.37,
      "duration_seconds": 4.99,
      "text": "I had my tonsils out when I was a child."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.03,
      "end_seconds": 199.26,
      "duration_seconds": 3.23,
      "text": "Any long-term health problems I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.31,
      "end_seconds": 216.82,
      "duration_seconds": 15.51,
      "text": "Yeah, I've had asthma, yes. I have high blood pressure. It's a relief to finally sit down and talk about it. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.64,
      "end_seconds": 222.76,
      "duration_seconds": 4.12,
      "text": "Go on. Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.5,
      "end_seconds": 225.79,
      "duration_seconds": 2.29,
      "text": "Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.09,
      "end_seconds": 226.79,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.88,
      "end_seconds": 244.2,
      "duration_seconds": 15.32,
      "text": "I take ramipril, 5 milligrams, every morning for my blood pressure. Paracetamol, 500 milligrams, when needed. I had Seretide inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.86,
      "end_seconds": 248.47,
      "duration_seconds": 2.61,
      "text": "Are you working at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.25,
      "end_seconds": 254.42,
      "duration_seconds": 4.17,
      "text": "Yes, I'm a nurse on a busy ward."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.47,
      "end_seconds": 258.94,
      "duration_seconds": 2.47,
      "text": "Are you living with family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.0,
      "end_seconds": 264.84,
      "duration_seconds": 3.84,
      "text": "I stay with my daughter and her family."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.37,
      "end_seconds": 270.96,
      "duration_seconds": 4.59,
      "text": "Right, any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.52,
      "end_seconds": 277.45,
      "duration_seconds": 4.93,
      "text": "My mother had high blood pressure. My brother has asthma."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 277.99,
      "end_seconds": 291.76,
      "duration_seconds": 13.77,
      "text": "Doctor, I've got the readings for you. Respiratory rate 19, pressure 104 over 73, pulse is 95 beats a minute. Temp 38.9 degrees, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.59,
      "end_seconds": 294.51,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.08,
      "end_seconds": 299.42,
      "duration_seconds": 2.34,
      "text": "Let's do the physical part now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.23,
      "end_seconds": 302.78,
      "duration_seconds": 2.55,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.64,
      "end_seconds": 315.5,
      "duration_seconds": 3.86,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.4,
      "end_seconds": 318.74,
      "duration_seconds": 2.34,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.04,
      "end_seconds": 338.44,
      "duration_seconds": 2.4,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.41,
      "end_seconds": 358.26,
      "duration_seconds": 13.85,
      "text": "Thanks for that. Let me just check I've got this right. You've had a bad cough for one week, severe, and no leg swelling or coughing up blood."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.15,
      "end_seconds": 361.86,
      "duration_seconds": 2.71,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 363.9,
      "end_seconds": 367.35,
      "duration_seconds": 3.45,
      "text": "We've already done a chest X-ray this morning, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.54,
      "end_seconds": 382.1,
      "duration_seconds": 13.56,
      "text": "Thanks, I'll check it. I'll request blood tests, it'll help with cough. You'll be taking azithromycin, 500 milligrams, once a day, for three days. It's for chest infection."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 383.81,
      "end_seconds": 386.29,
      "duration_seconds": 2.48,
      "text": "How long until it works?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.72,
      "end_seconds": 406.57,
      "duration_seconds": 15.85,
      "text": "Steam and warm fluids can ease the cough, and try to sleep with your head propped up. The thing that would worry me is if you become breathless or cough up blood. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 408.08,
      "end_seconds": 408.78,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.78,
      "end_seconds": 413.15,
      "duration_seconds": 3.37,
      "text": "Let's plan a check in a week."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.14,
      "end_seconds": 418.73,
      "duration_seconds": 3.59,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.27,
      "end_seconds": 423.08,
      "duration_seconds": 2.81,
      "text": "That's it on my side. Anything unclear?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.23,
      "end_seconds": 426.15,
      "duration_seconds": 1.92,
      "text": "I appreciate it, doctor."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.78,
      "end_seconds": 428.96,
      "duration_seconds": 1.18,
      "text": "Safe journey home."
    }
  ]
}