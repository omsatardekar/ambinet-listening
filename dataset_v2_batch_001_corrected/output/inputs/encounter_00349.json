{
  "schema_version": "1.0",
  "encounter_id": "00349",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 4.73,
      "duration_seconds": 3.84,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 11.37,
      "duration_seconds": 4.71,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 14.68,
      "duration_seconds": 2.48,
      "text": "It's pain during sex, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.78,
      "end_seconds": 19.08,
      "duration_seconds": 2.3,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.79,
      "end_seconds": 24.88,
      "duration_seconds": 4.09,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.63,
      "end_seconds": 29.56,
      "duration_seconds": 2.93,
      "text": "Would you call it mild or bad?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.11,
      "end_seconds": 33.01,
      "duration_seconds": 2.9,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.37,
      "end_seconds": 37.07,
      "duration_seconds": 3.7,
      "text": "Right, right. Does it come along with anything else?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.73,
      "end_seconds": 55.26,
      "duration_seconds": 17.53,
      "text": "When it starts I tend to get a lot of tiredness as well. Oh, and pain around my period. That's been about the same, five days. Um, with pain around my period, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.64,
      "end_seconds": 56.46,
      "duration_seconds": 0.82,
      "text": "I see."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.47,
      "end_seconds": 64.3,
      "duration_seconds": 4.83,
      "text": "The lot of tiredness? That's been for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.9,
      "end_seconds": 70.16,
      "duration_seconds": 5.26,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.78,
      "end_seconds": 76.22,
      "duration_seconds": 4.44,
      "text": "I mean, I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.1,
      "end_seconds": 88.01,
      "duration_seconds": 2.91,
      "text": "Have you got any chronic problems?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.25,
      "end_seconds": 93.42,
      "duration_seconds": 4.17,
      "text": "I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.11,
      "end_seconds": 102.71,
      "duration_seconds": 8.6,
      "text": "Uh-huh. Alright, heart failure, that matches what I have here. Tell me what you take day to day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.35,
      "end_seconds": 107.93,
      "duration_seconds": 3.58,
      "text": "Spironolactone, 25 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.74,
      "end_seconds": 113.73,
      "duration_seconds": 3.99,
      "text": "So, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.3,
      "end_seconds": 117.34,
      "duration_seconds": 2.04,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.99,
      "end_seconds": 124.63,
      "duration_seconds": 2.64,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.29,
      "end_seconds": 126.89,
      "duration_seconds": 1.6,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.52,
      "end_seconds": 132.6,
      "duration_seconds": 5.08,
      "text": "Alright, anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.45,
      "end_seconds": 135.46,
      "duration_seconds": 2.01,
      "text": "My father was diabetic."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.39,
      "end_seconds": 138.28,
      "duration_seconds": 1.89,
      "text": "So, how's your diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.6,
      "end_seconds": 143.03,
      "duration_seconds": 1.43,
      "text": "I'm mostly vegetarian."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.67,
      "end_seconds": 146.63,
      "duration_seconds": 1.96,
      "text": "Who's at home with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.52,
      "end_seconds": 153.58,
      "duration_seconds": 5.06,
      "text": "It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 159.0,
      "duration_seconds": 4.42,
      "text": "Any fever, vaginal discharge or burning when passing urine?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.61,
      "end_seconds": 165.65,
      "duration_seconds": 5.04,
      "text": "No, no fever, vaginal discharge or burning when passing urine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.12,
      "end_seconds": 169.56,
      "duration_seconds": 3.44,
      "text": "Right, right. Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.96,
      "end_seconds": 174.48,
      "duration_seconds": 3.52,
      "text": "Oh, not that I've noticed, no vomiting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.51,
      "end_seconds": 180.57,
      "duration_seconds": 4.06,
      "text": "So, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.16,
      "end_seconds": 182.6,
      "duration_seconds": 1.44,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 193.58,
      "duration_seconds": 1.73,
      "text": "Let's do your observations."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.22,
      "end_seconds": 206.03,
      "duration_seconds": 1.81,
      "text": "Hold still for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.38,
      "end_seconds": 223.82,
      "duration_seconds": 8.44,
      "text": "Okay: heart rate 66, temperature is 36.4 degrees, BP is 126 over 75, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.75,
      "end_seconds": 230.4,
      "duration_seconds": 2.65,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.12,
      "end_seconds": 234.69,
      "duration_seconds": 2.57,
      "text": "I'll explain what that means shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.92,
      "end_seconds": 238.31,
      "duration_seconds": 2.39,
      "text": "Can I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.93,
      "end_seconds": 240.63,
      "duration_seconds": 0.7,
      "text": "Alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.04,
      "end_seconds": 244.26,
      "duration_seconds": 2.22,
      "text": "Let me just check something."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.07,
      "end_seconds": 267.38,
      "duration_seconds": 5.31,
      "text": "There's tenderness in the lower tummy on the left, and no guarding."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.27,
      "end_seconds": 281.66,
      "duration_seconds": 8.39,
      "text": "Okay, finished. Taking everything into account, this is probably chronic pelvic pain, possibly endometriosis. Another possibility is an ovarian cyst."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.87,
      "end_seconds": 302.44,
      "duration_seconds": 4.57,
      "text": "Let's book a pregnancy test to look into pelvic pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.32,
      "end_seconds": 306.91,
      "duration_seconds": 2.59,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.6,
      "end_seconds": 311.09,
      "duration_seconds": 2.49,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.17,
      "end_seconds": 344.51,
      "duration_seconds": 32.34,
      "text": "I want a pelvic ultrasound done, that's for pelvic pain. What I'm giving you is mefenamic acid, 500 milligrams, three times a day with food, for five days. That's for period pain. A heat pad and some gentle movement help many people, and a pain diary helps me see a pattern. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.96,
      "end_seconds": 369.75,
      "duration_seconds": 20.79,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's hold off on a swab test for now, and if there's no change in a month we can revisit it. Let's review you after the scan. Any last questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.39,
      "end_seconds": 374.18,
      "duration_seconds": 2.79,
      "text": "Oh, thanks, that was helpful."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.91,
      "end_seconds": 376.61,
      "duration_seconds": 0.7,
      "text": "Goodbye."
    }
  ]
}