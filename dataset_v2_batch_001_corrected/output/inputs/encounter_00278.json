      "start_seconds": 0.87,
      "end_seconds": 4.22,
      "duration_seconds": 3.35,
      "text": "Okay, welcome. Let's see what's going on."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.39,
      "end_seconds": 6.61,
      "duration_seconds": 1.22,
      "text": "Hi, doctor."
