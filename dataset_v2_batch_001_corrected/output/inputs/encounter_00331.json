  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 8.17,
      "duration_seconds": 6.96,
      "text": "okay welcome let's see what's going on is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.46,
      "end_seconds": 14.56,
      "duration_seconds": 5.1,
      "text": "I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.58,
      "end_seconds": 21.63,
      "duration_seconds": 2.05,
      "text": "Right what's the the trouble?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.37,
      "end_seconds": 26.86,
      "duration_seconds": 3.49,
      "text": "I've been dealing with fever with chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.71,
      "end_seconds": 30.94,
      "duration_seconds": 3.23,
      "text": "are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.49,
      "end_seconds": 41.79,
      "duration_seconds": 9.3,
      "text": "I mean I take pantoprazole 40 milligrams before breakfast. Paracetamol. I take it 500 milligrams when needed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 45.53,
      "duration_seconds": 2.08,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.02,
      "end_seconds": 55.14,
      "duration_seconds": 5.12,
      "text": "I'd say two weeks actually no closer to about a week"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.28,
      "end_seconds": 65.56,
      "duration_seconds": 9.28,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.63,
      "end_seconds": 78.47,
      "duration_seconds": 8.84,
      "text": "It's a couple of times a week. It settles a little with paracetamol. I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.57,
      "end_seconds": 95.02,
      "duration_seconds": 3.45,
      "text": "did you get rash stiff neck or vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.8,
      "end_seconds": 98.62,
      "duration_seconds": 1.82,
      "text": "no none of those"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 102.25,
      "duration_seconds": 2.25,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.3,
      "end_seconds": 105.89,
      "duration_seconds": 2.59,
      "text": "bowels are regular nothing odd"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.62,
      "end_seconds": 107.96,
      "duration_seconds": 1.34,
      "text": "do you work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.52,
      "end_seconds": 115.05,
      "duration_seconds": 6.53,
      "text": "I run a small shop, so I'm on my feet a lot"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.1,
      "end_seconds": 119.33,
      "duration_seconds": 2.23,
      "text": "do you exercise at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.88,
      "end_seconds": 126.83,
      "duration_seconds": 5.95,
      "text": "I go to the gym a couple of times a week"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 131.21,
      "duration_seconds": 2.95,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.3,
      "end_seconds": 133.92,
      "duration_seconds": 1.62,
      "text": "No operations, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.71,
      "end_seconds": 154.38,
      "duration_seconds": 2.67,
      "text": "before I prescribe anything, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.08,
      "end_seconds": 159.93,
      "duration_seconds": 3.85,
      "text": "Penicillin. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.44,
      "end_seconds": 165.28,
      "duration_seconds": 4.84,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.97,
      "end_seconds": 169.7,
      "duration_seconds": 3.73,
      "text": "I have acid reflux, for five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.47,
      "end_seconds": 176.17,
      "duration_seconds": 0.7,
      "text": "mhm"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 179.9,
      "end_seconds": 189.02,
      "duration_seconds": 9.12,
      "text": "Here are the numbers, doctor. BP is 114 over 72, pulse 106. Temperature is 38.4 degrees, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.32,
      "end_seconds": 191.02,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 195.53,
      "duration_seconds": 3.44,
      "text": "Right, let me check a few things physically."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.44,
      "end_seconds": 198.06,
      "duration_seconds": 1.62,
      "text": "let me press here"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.88,
      "end_seconds": 219.71,
      "duration_seconds": 3.83,
      "text": "your spleen tip is just palpable under the ribs"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.48,
      "end_seconds": 223.88,
      "duration_seconds": 2.4,
      "text": "almost done with this part"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.38,
      "end_seconds": 239.38,
      "duration_seconds": 4.0,
      "text": "No rash anywhere on your body that I can see"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.54,
      "end_seconds": 244.98,
      "duration_seconds": 2.44,
      "text": "okay you can sit up"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.04,
      "end_seconds": 264.52,
      "duration_seconds": 7.48,
      "text": "taking everything into account I think we're dealing with malaria until proven otherwise at this stage"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.69,
      "end_seconds": 268.87,
      "duration_seconds": 3.18,
      "text": "Well, do you think it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.81,
      "end_seconds": 295.15,
      "duration_seconds": 24.34,
      "text": "I understand the worry at the moment I'd say it's malaria until proven otherwise, and we'll know more once the a dengue test is back let me just check I've got this right you've had fever with chills for about a week, mild, and and no stiff neck or rash"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.91,
      "end_seconds": 298.91,
      "duration_seconds": 2.0,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.59,
      "end_seconds": 320.33,
      "duration_seconds": 10.74,
      "text": "I'm gonna order a dengue test, for fever. I'd rather check than guess, and this is the quickest way to know more"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.27,
      "end_seconds": 323.96,
      "duration_seconds": 2.69,
      "text": "how long does that take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.33,
      "end_seconds": 347.04,
      "duration_seconds": 21.71,
      "text": "Let the lab know you travelled recently that's important for the tests. Please take the tablets with food so they don't upset your stomach. Keep an eye out and if you get confused very drowsy or the shaking returns call us the same day or go to emergency. Come back in two days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.45,
      "end_seconds": 349.15,
      "duration_seconds": 0.7,
      "text": "fine"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.97,
      "end_seconds": 355.49,
      "duration_seconds": 5.52,
      "text": "let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.81,
      "end_seconds": 364.41,
      "duration_seconds": 4.6,
      "text": "So I come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.76,
      "end_seconds": 376.17,
      "duration_seconds": 5.41,
      "text": "Yes, exactly right. Okay, I think we're finished. Is everything clear?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.7,
      "end_seconds": 379.4,
      "duration_seconds": 2.7,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.79,
      "end_seconds": 385.06,
      "duration_seconds": 1.27,
      "text": "all the best"
    }
  ]
