{
  "schema_version": "1.0",
  "encounter_id": "00213",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.99,
      "duration_seconds": 3.99,
      "text": "Good evening, doctor, thank you for staying late."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.78,
      "end_seconds": 11.01,
      "duration_seconds": 4.23,
      "text": "That's alright, take a seat. Tell me why you've come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.94,
      "end_seconds": 19.32,
      "duration_seconds": 7.38,
      "text": "Doctor, it's blood on the toilet paper. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.97,
      "end_seconds": 25.52,
      "duration_seconds": 5.55,
      "text": "How far back does it go? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.69,
      "end_seconds": 28.81,
      "duration_seconds": 2.12,
      "text": "About... well, six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.9,
      "end_seconds": 38.75,
      "duration_seconds": 4.85,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.39,
      "end_seconds": 43.7,
      "duration_seconds": 4.31,
      "text": "Yes, hard stools. That makes it worse. Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.66,
      "end_seconds": 55.13,
      "duration_seconds": 2.47,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.1,
      "end_seconds": 75.02,
      "duration_seconds": 18.92,
      "text": "A beer or two most evenings, to be honest. I smoke, yes, around five a day. Not really, I don't get much exercise. I share a flat with two friends. I'm a self-employed electrician."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.21,
      "end_seconds": 94.85,
      "duration_seconds": 4.64,
      "text": "Do you have any allergies to medicines, food, anything at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.86,
      "end_seconds": 100.31,
      "duration_seconds": 3.45,
      "text": "I don't have any known medication allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.81,
      "end_seconds": 119.52,
      "duration_seconds": 4.71,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.56,
      "end_seconds": 126.13,
      "duration_seconds": 4.57,
      "text": "I have low haemoglobin, for nearly five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.73,
      "end_seconds": 133.72,
      "duration_seconds": 5.99,
      "text": "Yes, low haemoglobin is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.25,
      "end_seconds": 149.96,
      "duration_seconds": 4.71,
      "text": "Any medication at the moment, including things from the pharmacy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.4,
      "end_seconds": 160.02,
      "duration_seconds": 8.62,
      "text": "Iron tablets. I take it once a day for my blood count. It's Anovate cream, twice a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.55,
      "end_seconds": 161.96,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.74,
      "end_seconds": 168.21,
      "duration_seconds": 4.47,
      "text": "I had a lump removed from my back years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.08,
      "end_seconds": 177.34,
      "duration_seconds": 4.26,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.28,
      "end_seconds": 181.29,
      "duration_seconds": 3.01,
      "text": "My mother had high blood pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.49,
      "end_seconds": 188.05,
      "duration_seconds": 5.56,
      "text": "Have you had any abdominal pain, change in bowel habit or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.85,
      "end_seconds": 192.79,
      "duration_seconds": 1.94,
      "text": "No. None of those."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.45,
      "end_seconds": 197.45,
      "duration_seconds": 4.0,
      "text": "Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.15,
      "end_seconds": 200.72,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.06,
      "end_seconds": 205.07,
      "duration_seconds": 3.01,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.93,
      "end_seconds": 207.06,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.74,
      "end_seconds": 211.15,
      "duration_seconds": 3.41,
      "text": "First the numbers, if you don't mind."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.09,
      "end_seconds": 220.89,
      "duration_seconds": 0.8,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.92,
      "end_seconds": 240.03,
      "duration_seconds": 8.11,
      "text": "Okay: respiratory rate 16, blood pressure 111 over 73, saturation 97 percent, pulse 80, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.59,
      "end_seconds": 242.56,
      "duration_seconds": 1.97,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 246.68,
      "duration_seconds": 2.92,
      "text": "Right, I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.43,
      "end_seconds": 251.53,
      "duration_seconds": 3.1,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.1,
      "end_seconds": 255.8,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.78,
      "end_seconds": 259.49,
      "duration_seconds": 2.71,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.85,
      "end_seconds": 274.92,
      "duration_seconds": 2.07,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.87,
      "end_seconds": 279.43,
      "duration_seconds": 2.56,
      "text": "Let me look at this properly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.36,
      "end_seconds": 299.56,
      "duration_seconds": 6.2,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 335.42,
      "duration_seconds": 30.73,
      "text": "Thanks, please take a seat again. Let me tell you where I've got to. My working impression is haemorrhoids. The reason I say that is that your story and my examination fit together. Let's get blood tests, for rectal bleeding. For this, a soothing cream, twice a day, for one week. It's for haemorrhoids. Soak in a warm bath for ten minutes after you pass stool, and don't strain. Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.44,
      "end_seconds": 338.81,
      "duration_seconds": 2.37,
      "text": "Alright, I'll see you out."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.87,
      "end_seconds": 342.92,
      "duration_seconds": 3.05,
      "text": "Yeah, nothing more from me, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.6,
      "end_seconds": 346.04,
      "duration_seconds": 1.44,
      "text": "All the best."
    }
  ]
}