{
  "schema_version": "1.0",
  "encounter_id": "00089",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 6.31,
      "duration_seconds": 5.04,
      "text": "Good afternoon, doctor, the receptionist said you'd see me now."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 12.83,
      "duration_seconds": 4.5,
      "text": "Right on time. Sit, please. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.35,
      "end_seconds": 20.0,
      "duration_seconds": 5.65,
      "text": "Well, I've been having a red swollen area on my leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.97,
      "end_seconds": 25.06,
      "duration_seconds": 4.09,
      "text": "Which tablets or creams or inhalers do you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.74,
      "end_seconds": 31.74,
      "duration_seconds": 5.0,
      "text": "I'm on Glycomet, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.41,
      "end_seconds": 37.65,
      "duration_seconds": 2.24,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.99,
      "end_seconds": 44.92,
      "duration_seconds": 5.93,
      "text": "It's 500 milligrams. Oh, I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.7,
      "end_seconds": 49.07,
      "duration_seconds": 3.37,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.51,
      "end_seconds": 62.12,
      "duration_seconds": 11.61,
      "text": "Six months now. Furosemide. I take it 40 milligrams, every morning for the fluid. I had spironolactone at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.2,
      "end_seconds": 65.97,
      "duration_seconds": 2.77,
      "text": "How long have you had it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.59,
      "end_seconds": 74.24,
      "duration_seconds": 4.65,
      "text": "Around five days... no wait, it's more like three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.56,
      "end_seconds": 77.61,
      "duration_seconds": 2.05,
      "text": "Does anything make it better?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.97,
      "end_seconds": 82.61,
      "duration_seconds": 3.64,
      "text": "I get some relief from elevating the leg."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.45,
      "end_seconds": 86.56,
      "duration_seconds": 3.11,
      "text": "Anything that tends to go along with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.55,
      "end_seconds": 90.12,
      "duration_seconds": 2.57,
      "text": "It usually comes with chills."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.97,
      "end_seconds": 94.66,
      "duration_seconds": 3.69,
      "text": "Any a small cut that wasn't healing as well?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.67,
      "end_seconds": 97.72,
      "duration_seconds": 1.05,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.74,
      "end_seconds": 102.13,
      "duration_seconds": 2.39,
      "text": "And how severe is it?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.31,
      "end_seconds": 104.96,
      "duration_seconds": 1.65,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 112.1,
      "duration_seconds": 5.63,
      "text": "Did you get calf pain, numbness around it, vomiting or shortness of breath?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.26,
      "end_seconds": 120.05,
      "duration_seconds": 6.79,
      "text": "No calf pain, numbness around it, vomiting or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.78,
      "end_seconds": 124.41,
      "duration_seconds": 2.63,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.53,
      "end_seconds": 127.99,
      "duration_seconds": 2.46,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.81,
      "end_seconds": 143.91,
      "duration_seconds": 2.1,
      "text": "Any drug or food allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 149.24,
      "duration_seconds": 3.4,
      "text": "Aspirin. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.6,
      "end_seconds": 160.08,
      "duration_seconds": 1.48,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.56,
      "end_seconds": 165.95,
      "duration_seconds": 4.39,
      "text": "A beer or two most evenings, to be honest."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.82,
      "end_seconds": 168.13,
      "duration_seconds": 1.31,
      "text": "How about exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.28,
      "end_seconds": 172.62,
      "duration_seconds": 3.34,
      "text": "Not really, I don't get much exercise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.36,
      "end_seconds": 175.32,
      "duration_seconds": 1.96,
      "text": "Are you still working?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.02,
      "end_seconds": 182.08,
      "duration_seconds": 5.06,
      "text": "I'm retired now, I was a clerk for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.69,
      "end_seconds": 187.8,
      "duration_seconds": 4.11,
      "text": "Any relatives with health problems I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.42,
      "end_seconds": 191.58,
      "duration_seconds": 2.16,
      "text": "My sister has epilepsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.62,
      "end_seconds": 205.54,
      "duration_seconds": 2.92,
      "text": "Any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.92,
      "end_seconds": 212.46,
      "duration_seconds": 5.54,
      "text": "I have diabetes. I've had low haemoglobin for about ten years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.11,
      "end_seconds": 214.96,
      "duration_seconds": 1.85,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.84,
      "end_seconds": 222.74,
      "duration_seconds": 1.9,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.69,
      "end_seconds": 226.71,
      "duration_seconds": 2.02,
      "text": "Okay, and what else?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.14,
      "end_seconds": 232.44,
      "duration_seconds": 4.3,
      "text": "Alright, heart failure, that matches what I have here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.06,
      "end_seconds": 236.56,
      "duration_seconds": 2.5,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.64,
      "end_seconds": 238.94,
      "duration_seconds": 1.3,
      "text": "I'll go gently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.71,
      "end_seconds": 258.76,
      "duration_seconds": 5.05,
      "text": "There's a small scab where the cut was, no pus coming out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.11,
      "end_seconds": 281.13,
      "duration_seconds": 18.02,
      "text": "That's fine, sit up. From what you've told me and what I found, I'm honestly not certain yet. It could be cellulitis, or it might be an abscess forming. I'm going to order blood tests, for infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.68,
      "end_seconds": 284.55,
      "duration_seconds": 1.87,
      "text": "Is that done here?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.3,
      "end_seconds": 290.07,
      "duration_seconds": 4.77,
      "text": "I'm going to order a wound swab, for infected wound."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.59,
      "end_seconds": 294.33,
      "duration_seconds": 2.74,
      "text": "Where do I go for that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.9,
      "end_seconds": 323.88,
      "duration_seconds": 28.98,
      "text": "What I'm giving you is clindamycin, 300 milligrams, three times a day, for seven days. You take it by mouth. That should help with skin infection. Mark the edge of the redness with a pen so we can see whether it spreads. Keep an eye out, and if the redness spreads or the fever gets higher, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.54,
      "end_seconds": 326.24,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.04,
      "end_seconds": 336.73,
      "duration_seconds": 9.69,
      "text": "Let's review you in two days. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.71,
      "end_seconds": 349.3,
      "duration_seconds": 10.59,
      "text": "So, I take the clindamycin, 300 milligrams, three times a day and come back in two days. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.0,
      "end_seconds": 355.18,
      "duration_seconds": 5.18,
      "text": "Yes, exactly right. Okay, we're done for today. Take care."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.87,
      "end_seconds": 359.21,
      "duration_seconds": 2.34,
      "text": "All good here. Thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.96,
      "end_seconds": 361.23,
      "duration_seconds": 1.27,
      "text": "Safe journey home."
    }
  ]
}