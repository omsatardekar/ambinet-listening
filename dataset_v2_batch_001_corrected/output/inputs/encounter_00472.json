{
  "schema_version": "1.0",
  "encounter_id": "00472",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.16,
      "duration_seconds": 3.64,
      "text": "Morning, doctor, I hope I'm not interrupting."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.52,
      "end_seconds": 11.61,
      "duration_seconds": 6.09,
      "text": "Yes, come in, take a seat. What can I do for you today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.98,
      "end_seconds": 18.03,
      "duration_seconds": 5.05,
      "text": "Um, so... periods lasting longer. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.04,
      "end_seconds": 21.95,
      "duration_seconds": 2.91,
      "text": "How long are we talking about?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.11,
      "end_seconds": 25.93,
      "duration_seconds": 2.82,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.2,
      "end_seconds": 31.85,
      "duration_seconds": 3.65,
      "text": "On a normal day, how strong is it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 38.24,
      "duration_seconds": 2.2,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.71,
      "end_seconds": 44.29,
      "duration_seconds": 4.58,
      "text": "Has there been cramping pain in the lower tummy too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.57,
      "end_seconds": 53.41,
      "duration_seconds": 7.84,
      "text": "Yes, I have. Oh, and tiredness. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.12,
      "end_seconds": 57.48,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.01,
      "end_seconds": 60.36,
      "duration_seconds": 2.35,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.92,
      "end_seconds": 65.82,
      "duration_seconds": 3.9,
      "text": "Do your parents or siblings have any long-term illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.19,
      "end_seconds": 70.46,
      "duration_seconds": 3.27,
      "text": "Right, my sister has thyroid problems."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.48,
      "end_seconds": 80.51,
      "duration_seconds": 2.03,
      "text": "What's your current medication list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.07,
      "end_seconds": 86.95,
      "duration_seconds": 4.88,
      "text": "Thyroxine. I take it every morning for my thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.88,
      "end_seconds": 90.3,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.99,
      "end_seconds": 102.45,
      "duration_seconds": 10.46,
      "text": "75 micrograms, I think that's what's on the box. Yeah, it's mefenamic acid, 500 milligrams, when the pain is bad."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.02,
      "end_seconds": 121.75,
      "duration_seconds": 4.73,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.85,
      "end_seconds": 136.05,
      "duration_seconds": 12.2,
      "text": "I skip breakfast most days. I go to the gym a couple of times a week. Yes, I live on my own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 141.91,
      "duration_seconds": 4.52,
      "text": "Are there any allergies on your record that I should check?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.41,
      "end_seconds": 148.46,
      "duration_seconds": 5.05,
      "text": "Um, no allergies that I know of, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.33,
      "end_seconds": 152.41,
      "duration_seconds": 3.08,
      "text": "Right, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.28,
      "end_seconds": 164.36,
      "duration_seconds": 10.08,
      "text": "I have an underactive thyroid. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.24,
      "end_seconds": 167.49,
      "duration_seconds": 2.25,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.38,
      "end_seconds": 170.86,
      "duration_seconds": 1.48,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.3,
      "end_seconds": 178.12,
      "duration_seconds": 5.82,
      "text": "Any pain during sex, vaginal discharge or bleeding after sex at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.78,
      "end_seconds": 185.75,
      "duration_seconds": 6.97,
      "text": "No pain during sex, vaginal discharge or bleeding after sex, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.28,
      "end_seconds": 189.07,
      "duration_seconds": 2.79,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.09,
      "end_seconds": 191.25,
      "duration_seconds": 1.16,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.7,
      "end_seconds": 195.85,
      "duration_seconds": 3.15,
      "text": "Come over here and I'll have a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 199.35,
      "duration_seconds": 2.09,
      "text": "Just relax, I'll be quick."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.28,
      "end_seconds": 211.48,
      "duration_seconds": 2.2,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.35,
      "end_seconds": 216.53,
      "duration_seconds": 3.18,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.2,
      "end_seconds": 232.01,
      "duration_seconds": 6.81,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.87,
      "end_seconds": 247.39,
      "duration_seconds": 9.52,
      "text": "Thanks for that. From what you've told me and what I found, my working impression is heavy periods with a cause still to find."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.94,
      "end_seconds": 252.84,
      "duration_seconds": 3.9,
      "text": "I mean, doctor, is this dangerous?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.86,
      "end_seconds": 267.0,
      "duration_seconds": 12.14,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with a cause still to find, and we'll know more once the a pelvic ultrasound is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.77,
      "end_seconds": 294.58,
      "duration_seconds": 10.81,
      "text": "A pelvic ultrasound is what I'd like next, for heavy periods. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 295.89,
      "end_seconds": 299.63,
      "duration_seconds": 3.74,
      "text": "I can book that for Thursday at 11:30 am."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.37,
      "end_seconds": 333.78,
      "duration_seconds": 32.41,
      "text": "I'll request blood tests, it'll help with heavy periods. That will help us see what's going on underneath and decide the next step. We'll begin with ferrous sulfate, 200 milligrams, once a day, for three months. You take it by mouth. That should help with possible iron deficiency. I'm going to put you on tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. You take it by mouth. That's for heavy bleeding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.3,
      "end_seconds": 357.41,
      "duration_seconds": 21.11,
      "text": "Keep a note of how many pads you use each day and the dates, it helps us a lot. Keep an eye out, and if you soak through a pad every hour or feel faint, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.17,
      "end_seconds": 361.91,
      "duration_seconds": 2.74,
      "text": "Yes, I'll watch for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.69,
      "end_seconds": 366.82,
      "duration_seconds": 3.13,
      "text": "Book a review after the results are back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.61,
      "end_seconds": 373.19,
      "duration_seconds": 5.58,
      "text": "Oh, I'll make the appointment on my way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.07,
      "end_seconds": 382.42,
      "duration_seconds": 3.35,
      "text": "Take care, and call us if anything changes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.17,
      "end_seconds": 387.46,
      "duration_seconds": 3.29,
      "text": "Well, all good here. Thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.23,
      "end_seconds": 390.05,
      "duration_seconds": 1.82,
      "text": "Alright, bye for now."
    }
  ]
}