{
  "schema_version": "1.0",
  "encounter_id": "00068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 6.12,
      "duration_seconds": 5.58,
      "text": "Come in, come in. Pull the door closed behind you, please."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.33,
      "end_seconds": 10.71,
      "duration_seconds": 3.38,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.07,
      "end_seconds": 15.35,
      "duration_seconds": 3.28,
      "text": "Alright, go ahead, tell me what's happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.34,
      "end_seconds": 18.42,
      "duration_seconds": 2.08,
      "text": "I've been looking pale."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.84,
      "end_seconds": 23.21,
      "duration_seconds": 3.37,
      "text": "How long has this been going on?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.0,
      "end_seconds": 50.94,
      "duration_seconds": 25.94,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many. I've had breathlessness on the stairs too, for two weeks. As for breathlessness on the stairs, I'd give it a eight, out of ten. I get some relief from resting."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.78,
      "end_seconds": 56.0,
      "duration_seconds": 4.22,
      "text": "Have you been looking pale at any time before this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 64.0,
      "duration_seconds": 6.75,
      "text": "So, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.93,
      "end_seconds": 68.34,
      "duration_seconds": 2.41,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 76.96,
      "duration_seconds": 1.75,
      "text": "Rest your hand here..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.22,
      "end_seconds": 96.92,
      "duration_seconds": 6.7,
      "text": "Okay: temperature is 36.5 degrees, heart rate 112, blood pressure 123 over 70."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.83,
      "end_seconds": 100.29,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.67,
      "end_seconds": 104.41,
      "duration_seconds": 2.74,
      "text": "I'll come back to those numbers."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.96,
      "end_seconds": 110.53,
      "duration_seconds": 3.57,
      "text": "I'll examine you now, bear with me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.58,
      "end_seconds": 115.28,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.93,
      "end_seconds": 119.1,
      "duration_seconds": 2.17,
      "text": "Take your time, no rush."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.05,
      "end_seconds": 141.39,
      "duration_seconds": 4.34,
      "text": "Heart sounds are normal, I don't hear any murmur."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.83,
      "end_seconds": 149.37,
      "duration_seconds": 2.54,
      "text": "All done, you can get dressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.49,
      "end_seconds": 170.87,
      "duration_seconds": 5.38,
      "text": "Right, a few quick ones: weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.41,
      "end_seconds": 173.18,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.25,
      "end_seconds": 181.3,
      "duration_seconds": 6.05,
      "text": "So, a few quick ones: chest pain, heavy periods or black stools?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.42,
      "end_seconds": 185.29,
      "duration_seconds": 2.87,
      "text": "No, not any of them."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.19,
      "end_seconds": 188.52,
      "duration_seconds": 1.33,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.64,
      "end_seconds": 196.56,
      "duration_seconds": 1.92,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.63,
      "end_seconds": 200.48,
      "duration_seconds": 2.85,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.75,
      "end_seconds": 203.34,
      "duration_seconds": 1.59,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.55,
      "end_seconds": 209.08,
      "duration_seconds": 4.53,
      "text": "Do you have any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.48,
      "end_seconds": 215.33,
      "duration_seconds": 4.85,
      "text": "I've had acid reflux for about ten years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.77,
      "end_seconds": 219.22,
      "duration_seconds": 2.45,
      "text": "Right. Who do you live with?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.43,
      "end_seconds": 226.17,
      "duration_seconds": 5.74,
      "text": "I live with my family, my husband and two kids."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.57,
      "end_seconds": 229.9,
      "duration_seconds": 2.33,
      "text": "Do you get any exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.63,
      "end_seconds": 234.7,
      "duration_seconds": 4.07,
      "text": "I walk for about half an hour most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.45,
      "end_seconds": 240.43,
      "duration_seconds": 4.98,
      "text": "What about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.72,
      "end_seconds": 246.55,
      "duration_seconds": 3.83,
      "text": "I've never been told I have allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 251.53,
      "duration_seconds": 4.07,
      "text": "Let's go through your medication. What are you taking?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.68,
      "end_seconds": 257.92,
      "duration_seconds": 5.24,
      "text": "It's pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.76,
      "end_seconds": 275.14,
      "duration_seconds": 5.38,
      "text": "Having listened and examined, the most likely explanation is anaemia of some kind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.06,
      "end_seconds": 316.2,
      "duration_seconds": 31.14,
      "text": "I'll request a vitamin B12 level, it'll help with possible deficiency. Let's book a ferritin level to look into possible iron deficiency. The result will help us decide whether anything more is needed. You'll be taking ferrous sulfate, 200 milligrams, once a day, for three months. You take it by mouth. It's for possible iron deficiency. Iron can darken the stools and bother the stomach, so take it after food."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.7,
      "end_seconds": 334.88,
      "duration_seconds": 18.18,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. A full blood count is something we might do if this doesn't improve in two weeks. Book a review after the results are back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.47,
      "end_seconds": 340.26,
      "duration_seconds": 3.79,
      "text": "Alright, I'll put it in my diary."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.97,
      "end_seconds": 343.17,
      "duration_seconds": 2.2,
      "text": "Right, that's all. Go gently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.76,
      "end_seconds": 346.59,
      "duration_seconds": 2.83,
      "text": "No, you've explained it well. Thanks."
    }
  ]
}