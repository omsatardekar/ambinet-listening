  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 4.59,
      "duration_seconds": 3.19,
      "text": "Hi doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 9.46,
      "duration_seconds": 3.99,
      "text": "No trouble at all come in. What's been bothering you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.41,
      "end_seconds": 22.3,
      "duration_seconds": 10.89,
      "text": "um, so... breathlessness when I lie flat that's why I came it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.31,
      "end_seconds": 27.19,
      "duration_seconds": 2.88,
      "text": "right how far back does it go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 31.21,
      "duration_seconds": 2.31,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.55,
      "end_seconds": 36.17,
      "duration_seconds": 3.62,
      "text": "does it happen all the time or in spells?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.22,
      "end_seconds": 41.57,
      "duration_seconds": 3.35,
      "text": "honestly, a couple of times a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.96,
      "end_seconds": 46.08,
      "duration_seconds": 4.12,
      "text": "Okay, keep going. Anything you do that brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.06,
      "end_seconds": 50.86,
      "duration_seconds": 3.8,
      "text": "Yes, lying flat. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 54.51,
      "duration_seconds": 2.62,
      "text": "How much is it bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.19,
      "end_seconds": 59.69,
      "duration_seconds": 4.5,
      "text": "I'd give it a three, out of ten"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.32,
      "end_seconds": 64.92,
      "duration_seconds": 3.6,
      "text": "Does it it come along with anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.84,
      "end_seconds": 72.51,
      "duration_seconds": 5.67,
      "text": "so, when it starts I tend to get tiredness as well"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.54,
      "end_seconds": 76.55,
      "duration_seconds": 3.01,
      "text": "I'll check your pressure and and pulse."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.42,
      "end_seconds": 91.35,
      "duration_seconds": 1.93,
      "text": "hold still for me.."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.91,
      "end_seconds": 110.12,
      "duration_seconds": 8.21,
      "text": "okay: pressure 135 over 87, heart rate 89, saturation 92 percent, temperature is 36.9 degrees"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.87,
      "end_seconds": 115.3,
      "duration_seconds": 3.43,
      "text": "Okay, I need to examine you for this."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.18,
      "end_seconds": 118.1,
      "duration_seconds": 0.92,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.41,
      "end_seconds": 121.67,
      "duration_seconds": 2.26,
      "text": "bear with me a second"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.87,
      "end_seconds": 141.72,
      "duration_seconds": 1.85,
      "text": "Neck veins are raised"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 150.76,
      "duration_seconds": 5.07,
      "text": "Good, that's the examination. Did you get palpitations or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.71,
      "end_seconds": 155.46,
      "duration_seconds": 3.75,
      "text": "no palpitations or chest pain none of it"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.71,
      "end_seconds": 159.21,
      "duration_seconds": 3.5,
      "text": "okay keep going. Did you notice any fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.13,
      "end_seconds": 165.65,
      "duration_seconds": 4.52,
      "text": "Um, uh, not at all, no fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.18,
      "end_seconds": 171.22,
      "duration_seconds": 5.04,
      "text": "Okay, keep going. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.27,
      "end_seconds": 180.17,
      "duration_seconds": 2.9,
      "text": "no, that side's been fine"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.87,
      "end_seconds": 192.73,
      "duration_seconds": 1.86,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.57,
      "end_seconds": 195.83,
      "duration_seconds": 2.26,
      "text": "I don't drink at all"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.02,
      "end_seconds": 197.93,
      "duration_seconds": 0.91,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.64,
      "end_seconds": 201.25,
      "duration_seconds": 1.61,
      "text": "I've never smoked"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 204.83,
      "duration_seconds": 2.23,
      "text": "do you have a job?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.8,
      "end_seconds": 207.84,
      "duration_seconds": 2.04,
      "text": "I'm a self-employed electrician"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.83,
      "end_seconds": 211.41,
      "duration_seconds": 1.58,
      "text": "do you live alone?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.68,
      "end_seconds": 215.77,
      "duration_seconds": 3.09,
      "text": "Yes, I live on my own."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.85,
      "end_seconds": 220.0,
      "duration_seconds": 2.15,
      "text": "so, any sport or activity?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.05,
      "end_seconds": 223.57,
      "duration_seconds": 2.52,
      "text": "I play badminton on Sundays"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.96,
      "end_seconds": 228.01,
      "duration_seconds": 3.05,
      "text": "okay, any diagnoses you've been given before?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.0,
      "end_seconds": 232.83,
      "duration_seconds": 2.83,
      "text": "I've had heart failure, yes"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.79,
      "end_seconds": 234.61,
      "duration_seconds": 0.82,
      "text": "hm okay"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.39,
      "end_seconds": 248.07,
      "duration_seconds": 2.68,
      "text": "Have you had any surgery before?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.4,
      "end_seconds": 254.84,
      "duration_seconds": 5.44,
      "text": "I had a lump removed from my back years ago"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.16,
      "end_seconds": 271.02,
      "duration_seconds": 3.86,
      "text": "Alright, tell me what you take day to day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.58,
      "end_seconds": 276.57,
      "duration_seconds": 3.99,
      "text": "Furosemide. I take it 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.8,
      "end_seconds": 280.26,
      "duration_seconds": 3.46,
      "text": "Okay, so. Does anything run in the family?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.58,
      "end_seconds": 283.85,
      "duration_seconds": 2.27,
      "text": "my sister has epilepsy"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.49,
      "end_seconds": 288.71,
      "duration_seconds": 4.22,
      "text": "What about allergies to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.95,
      "end_seconds": 292.37,
      "duration_seconds": 2.42,
      "text": "not that I know, no"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.82,
      "end_seconds": 315.6,
      "duration_seconds": 7.78,
      "text": "so, based on the history and the examination, this is probably fluid overload related to the heart"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.76,
      "end_seconds": 319.81,
      "duration_seconds": 3.05,
      "text": "Well, do you think it's serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.72,
      "end_seconds": 354.11,
      "duration_seconds": 32.39,
      "text": "I can't promise yet, but most people with fluid overload related to the heart do well once it's treated properly. I'll request blood tests, it'll help with heart failure review. We should do a chest X-ray for breathlessness. Keep the salt and the fluids moderate, no more than about one and a half litres a day. Weigh yourself every morning, and tell us if you put on more than two kilos in a few days"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.69,
      "end_seconds": 372.94,
      "duration_seconds": 17.25,
      "text": "I'm not ordering an ECG today if things carry on in a month we'll consider it book a review in one week can you run through the plan with me quickly just to be certain?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.49,
      "end_seconds": 380.28,
      "duration_seconds": 5.79,
      "text": "so, I come back in one week is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.77,
      "end_seconds": 385.41,
      "duration_seconds": 3.64,
      "text": "yes, exactly right. Ask me anything before you go"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.85,
      "end_seconds": 389.02,
      "duration_seconds": 2.17,
      "text": "okay thank you. Bye"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.43,
      "end_seconds": 393.78,
      "duration_seconds": 1.35,
      "text": "Bye for now."
    }
  ]
