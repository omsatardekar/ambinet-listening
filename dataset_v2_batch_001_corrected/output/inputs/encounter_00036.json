{
  "schema_version": "1.0",
  "encounter_id": "00036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 3.24,
      "duration_seconds": 1.99,
      "text": "Okay, hello, come through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.4,
      "end_seconds": 7.43,
      "duration_seconds": 3.03,
      "text": "Thanks. Sorry, I'm a little early."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.67,
      "end_seconds": 11.84,
      "duration_seconds": 3.17,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.75,
      "end_seconds": 16.65,
      "duration_seconds": 2.9,
      "text": "Tell me what's been troubling you."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.42,
      "end_seconds": 21.71,
      "duration_seconds": 4.29,
      "text": "He's been having burning when I pass urine, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.0,
      "end_seconds": 25.14,
      "duration_seconds": 2.14,
      "text": "Roughly when did it start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.49,
      "end_seconds": 29.39,
      "duration_seconds": 2.9,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.84,
      "end_seconds": 37.97,
      "duration_seconds": 3.13,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.5,
      "end_seconds": 46.07,
      "duration_seconds": 4.57,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.09,
      "end_seconds": 49.32,
      "duration_seconds": 1.23,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.23,
      "end_seconds": 58.06,
      "duration_seconds": 4.83,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.72,
      "end_seconds": 66.11,
      "duration_seconds": 7.39,
      "text": "Pretty moderate, if I'm being honest. It happens once or twice a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.81,
      "end_seconds": 74.0,
      "duration_seconds": 7.19,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 74.1,
      "end_seconds": 79.6,
      "duration_seconds": 5.5,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.57,
      "end_seconds": 93.83,
      "duration_seconds": 13.26,
      "text": "I was getting to that! As for cloudy, smelly urine, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 99.06,
      "end_seconds": 102.59,
      "duration_seconds": 3.53,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.09,
      "end_seconds": 106.99,
      "duration_seconds": 2.9,
      "text": "What medicines do you take regularly?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.97,
      "end_seconds": 111.56,
      "duration_seconds": 3.59,
      "text": "I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.09,
      "end_seconds": 120.92,
      "duration_seconds": 7.83,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.76,
      "end_seconds": 125.41,
      "duration_seconds": 2.65,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 136.68,
      "duration_seconds": 10.71,
      "text": "For my acidity, I believe. My wife sets them out for me, I just take what I'm given. It's Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 137.97,
      "end_seconds": 143.27,
      "duration_seconds": 5.3,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.28,
      "end_seconds": 148.28,
      "duration_seconds": 3.0,
      "text": "I'm on cranberry juice, every day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.96,
      "end_seconds": 163.24,
      "duration_seconds": 3.28,
      "text": "Have you ever been under the knife?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.29,
      "end_seconds": 170.1,
      "duration_seconds": 4.81,
      "text": "I had my thyroid operated on a long time ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.07,
      "end_seconds": 175.57,
      "duration_seconds": 4.5,
      "text": "What about your general health, any conditions you're being treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.29,
      "end_seconds": 179.56,
      "duration_seconds": 3.27,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.47,
      "end_seconds": 181.3,
      "duration_seconds": 0.83,
      "text": "Uh-huh."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.69,
      "end_seconds": 188.88,
      "duration_seconds": 6.19,
      "text": "I've had low haemoglobin for five years now. I have acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.78,
      "end_seconds": 191.57,
      "duration_seconds": 0.79,
      "text": "Uh-huh."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.43,
      "end_seconds": 197.26,
      "duration_seconds": 4.83,
      "text": "Um, I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 209.38,
      "duration_seconds": 10.66,
      "text": "Uh-huh. Alright, low haemoglobin and asthma, that matches what I have here. Alright, what about allergies, to medicines or foods or anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.64,
      "end_seconds": 214.37,
      "duration_seconds": 3.73,
      "text": "Yes, codeine. I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.02,
      "end_seconds": 232.84,
      "duration_seconds": 4.82,
      "text": "Anyone in the family with similar problems or other conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.65,
      "end_seconds": 239.24,
      "duration_seconds": 4.59,
      "text": "My grandmother had breast cancer. My father was diabetic."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.24,
      "end_seconds": 244.49,
      "duration_seconds": 3.25,
      "text": "What kind of work do you do?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.21,
      "end_seconds": 248.92,
      "duration_seconds": 3.71,
      "text": "I work on a farm, it's quite physical."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.03,
      "end_seconds": 256.34,
      "duration_seconds": 1.31,
      "text": "Nothing like vomiting?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.87,
      "end_seconds": 259.59,
      "duration_seconds": 1.72,
      "text": "Nope, no vomiting."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 260.92,
      "end_seconds": 266.13,
      "duration_seconds": 5.21,
      "text": "Actually, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.2,
      "end_seconds": 274.81,
      "duration_seconds": 6.61,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.77,
      "end_seconds": 285.27,
      "duration_seconds": 9.5,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any vaginal discharge or blood in the urine?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.79,
      "end_seconds": 299.59,
      "duration_seconds": 12.8,
      "text": "No, no vaginal discharge, no blood in the urine. I did have pain low in the tummy at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.39,
      "end_seconds": 304.41,
      "duration_seconds": 4.02,
      "text": "Right, and what about back pain or similar episode recently?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.68,
      "end_seconds": 310.29,
      "duration_seconds": 4.61,
      "text": "No back pain or similar episode recently, none of it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.37,
      "end_seconds": 313.04,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.32,
      "end_seconds": 315.3,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.82,
      "end_seconds": 319.6,
      "duration_seconds": 2.78,
      "text": "I'll take a few measurements first."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.04,
      "end_seconds": 329.96,
      "duration_seconds": 1.92,
      "text": "Just relax your arm..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.79,
      "end_seconds": 361.51,
      "duration_seconds": 9.72,
      "text": "Okay: SpO2 99 percent on room air, temperature is 36.8 degrees, heart rate 71, BP is 126 over 79."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.83,
      "end_seconds": 364.52,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.0,
      "end_seconds": 373.81,
      "duration_seconds": 3.81,
      "text": "Let's look at it together in a minute."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.92,
      "end_seconds": 378.13,
      "duration_seconds": 3.21,
      "text": "Let me examine, it won't take long."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.57,
      "end_seconds": 381.56,
      "duration_seconds": 1.99,
      "text": "Tell me if anything hurts."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.95,
      "end_seconds": 396.42,
      "duration_seconds": 5.47,
      "text": "There's mild tenderness above the pubic bone, and no tenderness in the loins."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 397.76,
      "end_seconds": 398.76,
      "duration_seconds": 1.0,
      "text": "Go ahead."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.21,
      "end_seconds": 412.57,
      "duration_seconds": 10.36,
      "text": "Okay, you can sit up. Stop me if I've got anything wrong. You've had burning when you pass urine, moderate, and no back pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.44,
      "end_seconds": 414.14,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 414.81,
      "end_seconds": 441.12,
      "duration_seconds": 26.31,
      "text": "I'm sending you for a urine culture because of urinary symptoms. Let's get a urine test, for urinary symptoms. It's a routine test and it'll give us a much clearer picture. For this, trimethoprim, 200 milligrams, twice a day, for three days. It's for urine infection. Drink plenty of water and don't hold it in when you need to go."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 441.61,
      "end_seconds": 453.85,
      "duration_seconds": 12.24,
      "text": "Mhm. Don't skip meals, and try to eat smaller portions more often through the day. Do get help quickly if you get a fever, back pain or vomiting."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 454.41,
      "end_seconds": 456.12,
      "duration_seconds": 1.71,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.49,
      "end_seconds": 462.0,
      "duration_seconds": 4.51,
      "text": "Let's review you if it's not better in three days."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 462.72,
      "end_seconds": 464.67,
      "duration_seconds": 1.95,
      "text": "That works for me."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 466.17,
      "end_seconds": 468.01,
      "duration_seconds": 1.84,
      "text": "Thanks for coming in."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 468.74,
      "end_seconds": 471.27,
      "duration_seconds": 2.53,
      "text": "Nothing more from me, thanks."
    }
  ]
}