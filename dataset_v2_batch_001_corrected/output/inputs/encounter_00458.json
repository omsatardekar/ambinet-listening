{
  "schema_version": "1.0",
  "encounter_id": "00458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 4.65,
      "duration_seconds": 3.84,
      "text": "Excuse me, doctor, should I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.04,
      "duration_seconds": 4.14,
      "text": "You're fine, sit down. So, what brings you in?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.17,
      "end_seconds": 16.95,
      "duration_seconds": 5.78,
      "text": "Mainly I've been feeling cold all the time. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.97,
      "end_seconds": 20.75,
      "duration_seconds": 2.78,
      "text": "Let me check your vitals now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.71,
      "end_seconds": 35.51,
      "duration_seconds": 0.8,
      "text": "One second..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.19,
      "end_seconds": 61.87,
      "duration_seconds": 9.68,
      "text": "Okay: pulse 73, temperature 36.5, pressure 116 over 71, oxygen saturation is 98 percent. How far back does it go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.45,
      "end_seconds": 70.59,
      "duration_seconds": 8.14,
      "text": "Around about a week... no wait, it's more like four weeks. I've also had tiredness."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.05,
      "end_seconds": 71.75,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.06,
      "end_seconds": 88.55,
      "duration_seconds": 15.49,
      "text": "Oh, and dry skin. That's been about the same, four weeks. About dry skin, moisturiser helps a bit. And I've been putting on weight as well, for about a year."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.89,
      "end_seconds": 96.61,
      "duration_seconds": 6.72,
      "text": "Right, did you get heavy periods, low mood, trouble swallowing or swelling in the neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.54,
      "end_seconds": 106.39,
      "duration_seconds": 7.85,
      "text": "I haven't had heavy periods, low mood, trouble swallowing or swelling in the neck, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.13,
      "end_seconds": 111.01,
      "duration_seconds": 3.88,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.63,
      "end_seconds": 113.08,
      "duration_seconds": 1.45,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.24,
      "end_seconds": 117.41,
      "duration_seconds": 3.17,
      "text": "Are you on any tablets or medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.15,
      "end_seconds": 138.3,
      "duration_seconds": 20.15,
      "text": "I mean, I take iron tablets, once a day for my blood count. I'm on omeprazole, 20 milligrams, once a day. Though honestly, some days I forget to take it. Pantoprazole I don't take anymore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.32,
      "end_seconds": 154.33,
      "duration_seconds": 4.01,
      "text": "Tell me about your health in general, any ongoing conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.44,
      "end_seconds": 159.49,
      "duration_seconds": 4.05,
      "text": "I've had low haemoglobin, yes. I've got depression."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.34,
      "end_seconds": 162.04,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.34,
      "end_seconds": 166.11,
      "duration_seconds": 2.77,
      "text": "I, I have acid reflux."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.25,
      "end_seconds": 174.21,
      "duration_seconds": 6.96,
      "text": "Alright, low haemoglobin, that matches what I have here. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.1,
      "end_seconds": 187.61,
      "duration_seconds": 12.51,
      "text": "I walk for about half an hour most days. I teach at a primary school. It's just me and my wife at home now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.61,
      "end_seconds": 191.87,
      "duration_seconds": 2.26,
      "text": "Okay, a quick examination now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.24,
      "end_seconds": 195.23,
      "duration_seconds": 1.99,
      "text": "Bear with me a second."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 209.09,
      "duration_seconds": 2.89,
      "text": "Reflexes are a bit slow to relax."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.27,
      "end_seconds": 213.39,
      "duration_seconds": 3.12,
      "text": "Stay still while I have a look."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.22,
      "end_seconds": 234.79,
      "duration_seconds": 5.57,
      "text": "Your pulse is slow, about fifty-six, and the thyroid isn't enlarged."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 239.72,
      "duration_seconds": 1.46,
      "text": "Thanks for that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.72,
      "end_seconds": 258.85,
      "duration_seconds": 6.13,
      "text": "Okay, thinking it through, it points towards an underactive thyroid. Another possibility is anaemia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.41,
      "end_seconds": 264.27,
      "duration_seconds": 3.86,
      "text": "Um, is it something serious, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.03,
      "end_seconds": 273.83,
      "duration_seconds": 7.8,
      "text": "It's reasonable to be concerned, but right now an underactive thyroid is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 305.18,
      "duration_seconds": 16.29,
      "text": "We should do blood tests for fatigue. Let's get a thyroid test, for hypothyroid symptoms. We'll begin with levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. You take it by mouth. It's for hypothyroidism."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.56,
      "end_seconds": 309.11,
      "duration_seconds": 2.55,
      "text": "How long until it works?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.94,
      "end_seconds": 326.95,
      "duration_seconds": 16.01,
      "text": "Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.81,
      "end_seconds": 330.88,
      "duration_seconds": 2.07,
      "text": "Got it, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.91,
      "end_seconds": 336.02,
      "duration_seconds": 3.11,
      "text": "Let's plan a check in six weeks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.7,
      "end_seconds": 340.46,
      "duration_seconds": 2.76,
      "text": "Good, I'll come back then."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.99,
      "end_seconds": 344.8,
      "duration_seconds": 2.81,
      "text": "Ask me anything before you go."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.28,
      "end_seconds": 350.17,
      "duration_seconds": 3.89,
      "text": "No, I think that's everything. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.09,
      "end_seconds": 351.88,
      "duration_seconds": 0.79,
      "text": "Take care."
    }
  ]
}